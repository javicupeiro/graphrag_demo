itional status.", "PANBRONQUIOLITIS:Panbronquiolitis is a chronic inflammatory lung disease that can lead to respiratory complications and nutritional issues."], "parameters": {"model": "text-embedding-3-small", "temperature": 0.0, "frequency_penalty": null, "presence_penalty": null, "top_p": 1.0, "max_tokens": 4000, "n": 1}, "history": null}