    </node>
    <node id="HOSPITAL DISCHARGE RECORDS">
      <data key="d0">EVENT</data>
      <data key="d1">Hospital discharge records are documents that summarize a patient's hospital stay and are mentioned in the context of under-reporting diabetes prevalence.</data>
