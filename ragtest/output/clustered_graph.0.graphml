    <node id="GENETIC MUTATION">
      <data key="d0">EVENT</data>
      <data key="d1">Genetic mutations are alterations in the DNA sequence that can lead to various disorders, including those affecting mitochondrial function, such as MELAS syndrome.</data>
      <data key="d2">e3370b71146ad5063d6b1e9c3d8a3bd2</data>
