      <data key="d6">420</data>
      <data key="d7">1085a6aa26f44b84ae51d0a08202ea77</data>
    </node>
    <node id="KUMPF">
      <data key="d0">PERSON</data>
      <data key="d1">Kumpf is a researcher whose work reflects the outcomes of patients after metabolic surgery, particularly regarding dietary changes and complications.</data>
      <data key="d2">445e6aeaae0e8edb3faf2d36be2073ce</data>
      <data key="d3">0</data>
      <data key="d4">0</data>
