    <edge source="MNGIE" target="TYMP">
      <data key="d8">1.0</data>
      <data key="d9">MNGIE is caused by mutations in the TYMP gene, which leads to the disease's symptoms</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">1c37a1b38acd40849212215568c7f16c</data>
