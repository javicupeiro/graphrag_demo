      <data key="d13">0</data>
    </edge>
    <edge source="MNGIE" target="DEOXIURIDINA">
      <data key="d8">8.0</data>
      <data key="d9">Deoxyuridine accumulates in patients with MNGIE, indicating a metabolic disturbance</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">f5e73c4c4d9b45b0a1a732f9659d5cb7</data>
