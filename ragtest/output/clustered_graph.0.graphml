    </node>
    <node id="TRATAMIENTO">
      <data key="d0">EVENT</data>
      <data key="d1">El tratamiento en pacientes oncol&#243;gicos puede incluir radioterapia, quimioterapia y cirug&#237;a, que pueden afectar el estado nutricional.</data>
      <data key="d2">5549895a3a7f54651e6c54f5a5d7d833</data>
