    </edge>
    <edge source="NUTRICI&#211;N ENTERAL" target="DESNUTRICI&#211;N MODERADA">
      <data key="d8">1.0</data>
      <data key="d9">Enteral nutrition is being implemented to address the patient's moderate malnutrition</data>
      <data key="d10">c92ceeeeae88c8288176cbfd00c75e17</data>
      <data key="d11">1e48490f92704e529fc0dc2fee1f5ee3</data>
