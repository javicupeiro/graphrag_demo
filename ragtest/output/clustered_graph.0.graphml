    </node>
    <node id="SOCIEDAD ESPA&#209;OLA DE DIABETES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Spanish Diabetes Society is an organization that focuses on diabetes research and education, hosting the XXIX National Congress to discuss diabetes prevalence and management.</data>
      <data key="d2">fc8df7c3d7a0d2286c55493077ed3937</data>
