      <data key="d0">EVENT</data>
      <data key="d1">La f&#237;stula g&#225;strica es una complicaci&#243;n postoperatoria que se sospech&#243; en la paciente tras la cirug&#237;a bari&#225;trica.</data>
      <data key="d2">67f96f3e5c366f82de31f1bf189aa71f</data>
