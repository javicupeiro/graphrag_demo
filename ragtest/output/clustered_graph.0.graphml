      <data key="d8">5.0</data>
      <data key="d9">Dr. Daniel A. de Luis Rom&#225;n participated in clinical case conferences sponsored by PERSAN FARMA</data>
      <data key="d10">7949b821c1ca2e4adc524e7775626396</data>
      <data key="d11">26db53cabcfa4c5fa9cb891001dd5d29</data>
