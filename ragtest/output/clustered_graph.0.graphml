    </node>
    <node id="CHRISTIAN SALOM VENDRELL">
      <data key="d0">PERSON</data>
      <data key="d1">Dr. Christian Salom Vendrell is a specialist in endocrinology and nutrition at Hospital Universitario Doctor Peset.</data>
