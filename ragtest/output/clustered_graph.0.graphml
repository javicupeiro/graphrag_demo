      <data key="d13">0</data>
    </edge>
    <edge source="DIABETES MELLITUS" target="MELAS">
      <data key="d8">13.0</data>
      <data key="d9">Diabetes Mellitus is a prevalent endocrine manifestation that is associated with MELAS (Mitochondrial Encephalomyopathy, Lactic Acidosis, and Stroke-like episodes). It affects a significant portion of patients diagnosed with MELAS and can be considered a metabolic complication in these individuals.</data>
      <data key="d10">6bcc5beeb4b20475f24131743313fb30,c6d3d43de4b87527989dd0a7d9bda8e0</data>
      <data key="d11">26c3205aa3dc47b0ab854c9898e5c077</data>
