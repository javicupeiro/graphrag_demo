    <node id="DRENAJE">
      <data key="d0">EVENT</data>
      <data key="d1">El drenaje es un procedimiento que se realiz&#243; en la paciente para manejar el d&#233;bito sucio postoperatorio tras la cirug&#237;a bari&#225;trica.</data>
      <data key="d2">67f96f3e5c366f82de31f1bf189aa71f</data>
      <data key="d3">0</data>
      <data key="d4">0</data>
      <data key="d5">1</data>
