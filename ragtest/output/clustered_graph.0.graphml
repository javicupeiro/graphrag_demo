    <edge source="PERSAN FARMA" target="SOCIEDAD ESPA&#209;OLA DE NUTRICI&#211;N CL&#205;NICA Y METABOLISMO">
      <data key="d8">5.0</data>
      <data key="d9">Persan Farma sponsors the Sociedad Espa&#241;ola de Nutrici&#243;n Cl&#237;nica y Metabolismo (SENPE) to improve training in nutritional therapy.</data>
      <data key="d10">a5ee3f91f8571820c338a8db4d3db09d</data>
      <data key="d11">81c2f2a31681474ab0a1a524f7b0a9b4</data>
