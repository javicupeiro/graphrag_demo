    <node id="NE ESPEC&#205;FICA PARA DIABETES">
      <data key="d0">EVENT</data>
      <data key="d1">La nutrici&#243;n enteral espec&#237;fica para diabetes es un tipo de soporte nutricional dise&#241;ado para mejorar el control gluc&#233;mico en pacientes diab&#233;ticos.</data>
      <data key="d2">5549895a3a7f54651e6c54f5a5d7d833</data>
