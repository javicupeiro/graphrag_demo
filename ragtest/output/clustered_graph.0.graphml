      <data key="d6">113</data>
      <data key="d7">dd85119214d64c9bb74e85f30a33841a</data>
    </node>
    <node id="RIESGO DE ENFERMEDAD CARDIOVASCULAR EN CASTILLA Y LE&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">The Risk of Cardiovascular Disease in Castilla y Le&#243;n study examines the relationship between diabetes and cardiovascular health over a decade.</data>
      <data key="d2">fc8df7c3d7a0d2286c55493077ed3937</data>
      <data key="d3">4</data>
