      <data key="d13">0</data>
    </edge>
    <edge source="MNGIE" target="GENETIC SEQUENCING">
      <data key="d8">1.0</data>
      <data key="d9">Genetic sequencing is essential for confirming the diagnosis of MNGIE by identifying mutations in the TYMP gene</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">435b7d7c48a6412580b91307a3c9b782</data>
      <data key="d12">892</data>
      <data key="d13">0</data>
    </edge>
    <edge source="MNGIE" target="THYMIDINE PHOSPHORYLASE">
      <data key="d8">10.0</data>
      <data key="d9">MNGIE is caused by a deficiency in thymidine phosphorylase, leading to its metabolic complications</data>
      <data key="d10">b8db8cc3349b8ac0cce45497da6244fc</data>
