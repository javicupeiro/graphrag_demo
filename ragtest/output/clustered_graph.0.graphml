    <node id="DIETA POLIM&#201;RICA">
      <data key="d0">EVENT</data>
      <data key="d1">A polymeric diet is a type of enteral nutrition that contains whole proteins and is used for patients who can digest food normally.</data>
      <data key="d2">aeb399b3f90c6a50eed8adfa8a140451</data>
