    <node id="HOSPITALARIO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Hospitalario refers to the hospital setting where the prevalence of malnutrition is assessed among patients.)&lt;|COMPLETE|&gt;</data>
      <data key="d2">3ed179f6e734d9fe4921fb0be0b018e4</data>
      <data key="d5">0</data>
      <data key="d6">1202</data>
