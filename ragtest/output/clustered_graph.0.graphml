    </node>
    <node id="HOSPITAL DE D&#205;A UTCA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Hospital where the patient was admitted for psychiatric recovery and stabilization of eating behaviors from May 2015 to July 2015</data>
