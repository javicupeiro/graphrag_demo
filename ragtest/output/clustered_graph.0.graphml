      <data key="d13">0</data>
    </edge>
    <edge source="MNGIE" target="CAQUEXIA">
      <data key="d8">6.0</data>
      <data key="d9">Cachexia is a consequence of the severe digestive symptoms experienced by MNGIE patients</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">1a53ce97fb6b48a384a9f4892f7139c1</data>
