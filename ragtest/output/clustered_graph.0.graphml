    <edge source="PACIENTE" target="NUTRICI&#211;N ENTERAL TOTAL">
      <data key="d8">7.0</data>
      <data key="d9">The patient received total enteral nutrition due to complications following surgery, specifically as a result of suture dehiscence. This nutritional support was necessary to address the patient's needs during the recovery process.</data>
      <data key="d10">67f96f3e5c366f82de31f1bf189aa71f,e70fa2e099766154321f13c0112d436a</data>
      <data key="d11">aefd70b5ce5b4dd3812c84daf86eb898</data>
