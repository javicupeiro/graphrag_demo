      <data key="d9">The 60-year-old male patient had a history of acute pancreatitis prior to his surgery.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">11c63b38356c43009d4d85845b5bbb8a</data>
      <data key="d12">937</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="DUODENOPANCREATECTOM&#205;A SUBTOTAL">
      <data key="d8">6.0</data>
      <data key="d9">The subtotal duodenopancreatectomy was performed following the patient's acute pancreatitis episode.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">b1a2a032c4df4ac9baa0786049b80d1d</data>
      <data key="d12">938</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HEMODI&#193;LISIS">
      <data key="d8">6.0</data>
      <data key="d9">The patient required hemodialysis as a result of acute pancreatitis complications.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">4cb9d7449e9f446f92847dc8523fe57a</data>
      <data key="d12">939</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="RANSON CRITERIA">
      <data key="d8">7.0</data>
      <data key="d9">The Ranson criteria are used to evaluate the severity of acute pancreatitis</data>
      <data key="d10">57d361381e6ea4ddbc948891f9645009</data>
      <data key="d11">7cf4035dbca14904a44cb0f964a0c63a</data>
      <data key="d12">940</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="APACHE SCORE">
      <data key="d8">7.0</data>
      <data key="d9">The APACHE score is utilized to assess the severity of acute pancreatitis in patients</data>
      <data key="d10">57d361381e6ea4ddbc948891f9645009</data>
      <data key="d11">af03929d7b46477782e8d05570e761b5</data>
      <data key="d12">941</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="DESNUTRICI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">La pancreatitis aguda grave puede llevar a la desnutrici&#243;n debido a un catabolismo elevado y una respuesta inflamatoria sist&#233;mica</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">cfbfc05fa46e4ddc8996a271a5c126ed</data>
      <data key="d12">942</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HIPERGLUCEMIA">
      <data key="d8">7.0</data>
      <data key="d9">La hiperglucemia es una complicaci&#243;n com&#250;n en pacientes con pancreatitis aguda, afectando su tratamiento</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">ff8e8c1bd36d4e84b2e4eaefa82c17fe</data>
      <data key="d12">943</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="REPOSO PANCRE&#193;TICO">
      <data key="d8">5.0</data>
      <data key="d9">El reposo pancre&#225;tico ha sido considerado como una estrategia en el tratamiento de la pancreatitis aguda, aunque su eficacia es debatida</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">ffdbaf141e06481a8224eefb92c87b7b</data>
      <data key="d12">944</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="NUTRICI&#211;N ORAL">
      <data key="d8">1.0</data>
      <data key="d9">La nutrici&#243;n oral puede ser dif&#237;cil de implementar en pacientes con pancreatitis aguda, especialmente en casos graves</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">8cb9349e8f074a66a8e4b4c16fb60e32</data>
      <data key="d12">945</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="LITIASIS BILIAR">
      <data key="d8">8.0</data>
      <data key="d9">La litiasis biliar es una de las causas m&#225;s comunes de pancreatitis aguda, contribuyendo al desarrollo de la enfermedad</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">4a00ae234c1b45a7b4063a92daea0944</data>
      <data key="d12">946</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CONSUMO EXCESIVO DE ALCOHOL">
      <data key="d8">8.0</data>
      <data key="d9">El consumo excesivo de alcohol es una de las principales etiolog&#237;as de la pancreatitis aguda</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">c4be35f2e2514779ad9e488ba70f4beb</data>
      <data key="d12">947</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="FALLO ORG&#193;NICO">
      <data key="d8">9.0</data>
      <data key="d9">El fallo org&#225;nico puede ser una complicaci&#243;n grave en pacientes con pancreatitis aguda, aumentando la mortalidad</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">a2daea3b485f4124aa7c72efc7b2f411</data>
      <data key="d12">948</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="SEPSIS">
      <data key="d8">9.0</data>
      <data key="d9">La sepsis puede desarrollarse como una complicaci&#243;n en pacientes con pancreatitis aguda, relacionada con la inflamaci&#243;n sist&#233;mica</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">0c8ebf82cd894629a46ba80bd74baab5</data>
      <data key="d12">949</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CITOCINAS">
      <data key="d8">7.0</data>
      <data key="d9">Las citocinas se liberan durante la pancreatitis aguda y contribuyen al da&#241;o tisular y a la respuesta inflamatoria</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">1c45b0939a31441bbfeb9deb33d3765b</data>
      <data key="d12">950</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CATABOLISMO">
      <data key="d8">8.0</data>
      <data key="d9">El catabolismo se ve incrementado en pacientes con pancreatitis aguda, afectando su estado nutricional</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">ccd2670e2e6642b2a7c2d78069ecb93a</data>
      <data key="d12">951</data>
      <data key="d13">0</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HIDROELECTROL&#205;TICOS">
      <data key="d8">7.0</data>
      <data key="d9">Los desequilibrios hidroelectrol&#237;ticos son comunes en pacientes con pancreatitis aguda, complicando su tratamiento</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">4be599308e6e4ddd983ab37f9edf992c</data>
      <data key="d12">952</data>
      <data key="d13">0</data>
    </edge>
