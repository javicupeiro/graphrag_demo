    <node id="ENZYMES PANCRE&#193;TICAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Enzymes pancre&#225;ticas are supplements used to aid digestion in patients with pancreatic insufficiency, particularly in those with diabetes.</data>
      <data key="d2">3dfc700a2eaec232c05b0a53f2089229</data>
