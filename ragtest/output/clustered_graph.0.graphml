    </node>
    <node id="ONCOL&#211;GICO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Oncol&#243;gico refers to the field of oncology, particularly in relation to patient care and nutritional needs.</data>
      <data key="d2">3ed179f6e734d9fe4921fb0be0b018e4</data>
