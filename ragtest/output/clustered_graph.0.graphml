    </node>
    <node id="DEXA">
      <data key="d0">EVENT</data>
      <data key="d1">Dual-Energy X-ray Absorptiometry (DEXA) is a technique used to measure bone density and body composition.</data>
      <data key="d2">1033f1626ca6ac2b3bab298805a17aec</data>
