      <data key="d6">107</data>
      <data key="d7">deb1bc44f9a84da59e4b0f65d585d19c</data>
    </node>
    <node id="DIABETES ATLAS">
      <data key="d0">EVENT</data>
      <data key="d1">The Diabetes Atlas is a publication by the IDF that provides comprehensive data on the global prevalence of diabetes.</data>
      <data key="d2">dec6b3fc008edd47758cfc00106d077b</data>
