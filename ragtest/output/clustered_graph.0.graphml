    <node id="MAR&#205;A D. BALLESTEROS POMAR">
      <data key="d0">PERSON</data>
      <data key="d1">Mar&#237;a D. Ballesteros Pomar is a medical specialist in Endocrinology and Nutrition, and the coordinator of the Nutrition Area of the SEEN at the Complejo Asistencial Universitario de Le&#243;n.</data>
