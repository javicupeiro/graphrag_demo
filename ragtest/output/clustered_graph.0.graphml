    </edge>
    <edge source="MNGIE" target="DIGESTIVE SYMPTOMS">
      <data key="d8">7.0</data>
      <data key="d9">Digestive symptoms are a major clinical manifestation of MNGIE, impacting the gastrointestinal tract</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">89e96fe412f74ce087a7dc268e00143e</data>
