    <node id="F&#211;RMULAS SEMIELEMENTALES">
      <data key="d0">EVENT</data>
      <data key="d1">Semi-elemental formulas are specialized nutritional products used for patients with extensive disease affecting absorption.</data>
      <data key="d2">896ddfd9f06dc3ec8b1cfb986fae97fe</data>
