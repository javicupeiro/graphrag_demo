    <node id="SOCIEDAD CASTELLANO LEONESA ENDOCRINOLOG&#205;A, DIABETES Y NUTRICI&#211;N">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Sociedad Castellano Leonesa de Endocrinolog&#237;a, Diabetes y Nutrici&#243;n is an organization that supports clinical nutrition and diabetes education and research in the region of Castilla y Le&#243;n.</data>
