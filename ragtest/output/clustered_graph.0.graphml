    <edge source="HOSPITAL UNIVERSITARIO Y POLIT&#201;CNICO DE LA FE, VALENCIA" target="HOSPITAL CL&#205;NICO UNIVERSITARIO LOZANO BLESAS, ZARAGOZA">
