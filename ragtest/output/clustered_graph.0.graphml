      <data key="d6">1162</data>
      <data key="d7">76e263b82c4647f5b656920b9bec07a2</data>
    </node>
    <node id="CA 19.9">
      <data key="d0">EVENT</data>
      <data key="d1">CA 19.9 is a tumor marker that plays a crucial role in the diagnosis and monitoring of treatment for pancreatic cancer. It has a sensitivity and specificity of up to 92%, making it a valuable tool in the clinical assessment of this type of cancer.</data>
      <data key="d2">a960ccbf15a28151d1461c4203408408,acd36e6dbcd98757c4cf33ff090764ee</data>
