    </node>
    <node id="DM1">
      <data key="d0" />
      <data key="d1">DM1 refers to Type 1 Diabetes, which is a chronic condition that the patient is managing in conjunction with an eating disorder.</data>
      <data key="d2">3f685a05a9682db6dcde958d1918cc77,933d6526b2d313c95c9f4aaa950a62a3</data>
