    </node>
    <node id="FRANCISCO VILLAZ&#211;N GONZ&#193;LEZ">
      <data key="d0">PERSON</data>
      <data key="d1">Dr. Francisco Villaz&#243;n Gonz&#225;lez is a medical specialist in endocrinology and nutrition, contributing to the understanding of diabetes mellitus in Spain.</data>
      <data key="d2">3defb74705676a025b15398e300eb230</data>
      <data key="d3">1</data>
      <data key="d4">0</data>
      <data key="d5">2</data>
      <data key="d6">237</data>
