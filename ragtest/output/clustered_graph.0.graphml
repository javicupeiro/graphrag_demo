    </node>
    <node id="DIABETES TIPO 1">
      <data key="d0">EVENT</data>
      <data key="d1">Type 1 diabetes is a form of diabetes characterized by the body's inability to produce insulin. This condition necessitates lifelong management and treatment to maintain blood glucose levels within a healthy range.</data>
      <data key="d2">a549bdc3929c5dd7a613c6900a0fe90e,ce4c057e0a625bc9e64301a0cca1e206,f2846d08229fda837153207946e29831</data>
