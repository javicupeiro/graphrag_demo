      <data key="d6">419</data>
      <data key="d7">4dbfe93547d140fc89c346e89b198dc2</data>
    </node>
    <node id="SOCIEDAD ESPA&#209;OLA DE LA CIRUG&#205;A DE LA ENFERMEDAD M&#211;RBIDA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Sociedad Espa&#241;ola de la Cirug&#237;a de la Enfermedad M&#243;rbida is a society that collaborates with SEEDO to establish guidelines for metabolic surgery.</data>
      <data key="d2">445e6aeaae0e8edb3faf2d36be2073ce</data>
