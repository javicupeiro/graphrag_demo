      <data key="d6">611</data>
      <data key="d7">23d0fe2d1afe4c1c801587a78b85fcd7</data>
    </node>
    <node id="TENSION ARTERIAL">
      <data key="d0">EVENT</data>
      <data key="d1">Blood pressure measurement is taken to assess the cardiovascular health of the patient.</data>
      <data key="d2">1033f1626ca6ac2b3bab298805a17aec</data>
      <data key="d3">0</data>
      <data key="d4">0</data>
      <data key="d5">1</data>
      <data key="d6">612</data>
      <data key="d7">50da9f2435ea4483a3c1c403c61fb943</data>
    </node>
    <node id="FRECUENCIA CARDIACA">
      <data key="d0">EVENT</data>
      <data key="d1">Heart rate measurement is conducted to monitor the patient's heart function and overall health.</data>
      <data key="d2">1033f1626ca6ac2b3bab298805a17aec</data>
