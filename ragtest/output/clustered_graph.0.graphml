    <node id="CIRUG&#205;A DIGESTIVA">
      <data key="d0">EVENT</data>
      <data key="d1">CIRUG&#205;A DIGESTIVA refers to surgical procedures involving the digestive tract, which require careful nutritional management postoperatively.</data>
      <data key="d2">3dfc700a2eaec232c05b0a53f2089229</data>
