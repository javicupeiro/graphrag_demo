    </node>
    <node id="ANTIDIAB&#201;TICOS ORALES">
      <data key="d0">EVENT</data>
      <data key="d1">Oral antidiabetic medications are prescribed to manage the patient's diabetes, which is complicated by mitochondrial dysfunction.</data>
