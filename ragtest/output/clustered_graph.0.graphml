    <node id="NUTRICIONAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Nutritional refers to the dietary interventions and management strategies for patients, especially in oncology.</data>
      <data key="d2">3ed179f6e734d9fe4921fb0be0b018e4</data>
      <data key="d5">0</data>
      <data key="d6">1200</data>
