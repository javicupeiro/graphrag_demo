      <data key="d0">ORGANIZATION</data>
      <data key="d1">The GARIN Group is an organization focused on nutrition research and recommendations for managing patients with diabetes or stress hyperglycemia and artificial nutrition.</data>
      <data key="d2">3defb74705676a025b15398e300eb230</data>
