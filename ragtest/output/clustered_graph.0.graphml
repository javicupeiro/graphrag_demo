    <node id="DEHISCENCIA DE SUTURA">
      <data key="d0">EVENT</data>
      <data key="d1">Suture dehiscence is a complication that occurs when a surgical wound reopens, which can happen postoperatively.</data>
      <data key="d2">e70fa2e099766154321f13c0112d436a</data>
