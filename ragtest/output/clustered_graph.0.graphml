    </node>
    <node id="VACIAMIENTO FUNCIONAL DERECHO">
      <data key="d0">EVENT</data>
      <data key="d1">Vaciamiento funcional derecho is a surgical procedure related to the patient's cancer treatment.</data>
      <data key="d2">3a1d1c4eb34995d440bd72c4b64e3c8d</data>
      <data key="d3">10</data>
      <data key="d4">0</data>
      <data key="d5">1</data>
      <data key="d6">971</data>
      <data key="d7">620c458344b741b2a67b9cd78bbcdf1f</data>
    </node>
    <node id="RADIOTERAPIA">
      <data key="d0">EVENT</data>
      <data key="d1">Radioterapia, or radiotherapy, is a treatment method that utilizes radiation to eliminate cancerous cells and is frequently employed in the treatment of neoplasms. It is considered a potential treatment option for patients following surgery, and it plays a significant role in the overall cancer treatment plan for patients.</data>
      <data key="d2">0b901814a09392d24880be465dcbce6f,3a1d1c4eb34995d440bd72c4b64e3c8d,e474ebdcd3e5392e4b2bed8434293849</data>
      <data key="d3">10</data>
