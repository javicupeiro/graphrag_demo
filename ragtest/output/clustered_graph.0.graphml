    </node>
    <node id="MULTIDISCIPLINAR">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Multidisciplinar refers to the collaborative approach involving various healthcare professionals to manage complex medical conditions like diabetes.</data>
      <data key="d2">3dfc700a2eaec232c05b0a53f2089229</data>
