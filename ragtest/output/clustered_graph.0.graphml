      <data key="d0">EVENT</data>
      <data key="d1">S&#237;ndrome paraneopl&#225;sico refers to a set of symptoms that occur in patients with cancer, which are not directly related to the local presence of the tumor.</data>
      <data key="d2">a960ccbf15a28151d1461c4203408408</data>
      <data key="d3">10</data>
      <data key="d4">0</data>
      <data key="d5">1</data>
