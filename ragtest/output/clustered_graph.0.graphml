    </node>
    <node id="ENDOCRINE DISORDERS">
      <data key="d0">EVENT</data>
      <data key="d1">Endocrine disorders are conditions that affect the endocrine system, which can be associated with mitochondrial diseases like MELAS syndrome.</data>
