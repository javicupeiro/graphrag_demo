    <node id="HARRIS-BENEDICT">
      <data key="d0">EVENT</data>
      <data key="d1">La ecuaci&#243;n de Harris-Benedict es una f&#243;rmula utilizada para estimar los requerimientos cal&#243;ricos en pacientes, incluyendo aquellos con c&#225;ncer.</data>
      <data key="d2">5549895a3a7f54651e6c54f5a5d7d833</data>
