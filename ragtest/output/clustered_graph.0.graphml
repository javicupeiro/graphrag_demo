      <data key="d8">7.0</data>
      <data key="d9">Persan Farma collaborates with the Sociedad Castellano Leonesa de Endocrinolog&#237;a, Diabetes y Nutrici&#243;n to support clinical nutrition education and research</data>
      <data key="d10">2eff7eb5e1b3c24a5650d80b185fbd96</data>
      <data key="d11">a53a2305976c4e21af2d500c246f45e4</data>
