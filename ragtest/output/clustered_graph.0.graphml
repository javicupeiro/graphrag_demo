    </node>
    <node id="CREATINE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Creatine is a substance that has been studied for its potential benefits in improving muscle strength in patients with mitochondrial diseases.</data>
      <data key="d2">b8db8cc3349b8ac0cce45497da6244fc</data>
