      <data key="d13">0</data>
    </edge>
    <edge source="MNGIE" target="ANALYTICAL FINDINGS">
      <data key="d8">8.0</data>
      <data key="d9">Analytical findings are used to diagnose MNGIE, showing elevated levels of thymidine and deoxyuridine</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">6f5ab523467d40aebea750bb4526a1fb</data>
      <data key="d12">890</data>
      <data key="d13">0</data>
    </edge>
    <edge source="MNGIE" target="NEUROIMAGING FINDINGS">
      <data key="d8">7.0</data>
      <data key="d9">Neuroimaging findings are characteristic of MNGIE, showing changes in white matter</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">9199fc2af302483a8d82361569147e52</data>
