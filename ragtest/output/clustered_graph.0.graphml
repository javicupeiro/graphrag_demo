    <node id="ASTURIAS">
      <data key="d0">GEO</data>
      <data key="d1">Asturias is an autonomous community in Spain, recognized as the most aged community, influencing diabetes statistics in neighboring regions.</data>
      <data key="d2">fc8df7c3d7a0d2286c55493077ed3937</data>
