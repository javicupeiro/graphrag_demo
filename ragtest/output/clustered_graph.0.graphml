      <data key="d1">Hematopoietic stem cell transplant is a treatment option being explored to correct the enzymatic deficiency in MNGIE.</data>
      <data key="d2">b8db8cc3349b8ac0cce45497da6244fc</data>
      <data key="d3">2</data>
      <data key="d4">0</data>
      <data key="d5">1</data>
      <data key="d6">481</data>
