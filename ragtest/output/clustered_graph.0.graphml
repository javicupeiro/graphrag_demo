      <data key="d0">EVENT</data>
      <data key="d1">La f&#243;rmula polim&#233;rica normocal&#243;rica es un suplemento nutricional que se prescribe al paciente para ayudar a cubrir sus requerimientos energ&#233;ticos.</data>
      <data key="d2">17b7995dcf275c50629c7e3d4723882e</data>
      <data key="d3">0</data>
      <data key="d4">0</data>
      <data key="d5">1</data>
      <data key="d6">526</data>
      <data key="d7">6e976f989f28463b895af0db209c29fc</data>
    </node>
    <node id="F&#211;RMULA HIPERCAL&#211;RICA ESPEC&#205;FICA DE DIABETES">
      <data key="d0">EVENT</data>
      <data key="d1">La f&#243;rmula hipercal&#243;rica espec&#237;fica de diabetes es un tipo de suplemento que se utiliza para ayudar al paciente a aumentar de peso mientras controla su glucemia.</data>
      <data key="d2">17b7995dcf275c50629c7e3d4723882e</data>
