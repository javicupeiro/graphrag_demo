    <node id="MELAS SYNDROME">
      <data key="d0">EVENT</data>
      <data key="d1">MELAS syndrome is a mitochondrial disorder characterized by mitochondrial encephalopathy, lactic acidosis, and stroke-like episodes, often leading to complications such as diabetes and other health issues.</data>
      <data key="d2">e3370b71146ad5063d6b1e9c3d8a3bd2</data>
      <data key="d3">3</data>
      <data key="d4">0</data>
