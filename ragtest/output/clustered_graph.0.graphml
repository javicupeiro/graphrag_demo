    </edge>
    <edge source="MNGIE" target="CHROMOSOME 22Q13.33">
      <data key="d8">8.0</data>
      <data key="d9">MNGIE is associated with mutations in the TYMP gene located on chromosome 22q13.33</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">54fe95545b1649d8aeaa6f2636599c89</data>
      <data key="d12">884</data>
      <data key="d13">0</data>
    </edge>
    <edge source="MNGIE" target="TIMIDINA">
      <data key="d8">8.0</data>
      <data key="d9">Timidine accumulates in patients with MNGIE due to the deficiency of thymidine phosphorylase</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">ec98f982cb144180b0419e1683a398fb</data>
