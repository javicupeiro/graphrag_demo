    <node id="EMERGING RISK FACTORS COLLABORATION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Emerging Risk Factors Collaboration is a research group that studies the impact of various health factors, including diabetes, on mortality rates.</data>
      <data key="d2">fc8df7c3d7a0d2286c55493077ed3937</data>
      <data key="d3">4</data>
      <data key="d4">0</data>
      <data key="d5">1</data>
