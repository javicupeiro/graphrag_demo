      <data key="d0">ORGANIZATION</data>
      <data key="d1">F&#243;rmulas nutricionales espec&#237;ficas are specialized dietary formulas designed to meet the nutritional needs of diabetic patients.</data>
      <data key="d2">3dfc700a2eaec232c05b0a53f2089229</data>
