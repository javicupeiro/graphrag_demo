    <node id="INPATIENT GLYCEMIC CONTROL">
      <data key="d0">EVENT</data>
      <data key="d1">Inpatient glycemic control refers to the management of blood sugar levels in hospitalized patients, a topic covered in the studies.</data>
      <data key="d2">d52ef4e5955918a8a47b697fcdb4096f</data>
