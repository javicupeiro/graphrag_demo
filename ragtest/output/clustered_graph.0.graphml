      <data key="d13">0</data>
    </edge>
    <edge source="MNGIE" target="NEUROLOGICAL SYMPTOMS">
      <data key="d8">7.0</data>
      <data key="d9">Neurological symptoms are a significant aspect of MNGIE, affecting the nervous system</data>
      <data key="d10">cb3d17a78ad2d9342ebe0fd2aac8e9d1</data>
      <data key="d11">77164e7fbf4845e6a1195312950a6312</data>
