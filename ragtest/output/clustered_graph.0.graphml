      <data key="d6">843</data>
      <data key="d7">56329936343c43cc845e70e0f4707e0b</data>
    </node>
    <node id="ICTUS VERTEBRO-BASILAR">
      <data key="d0">EVENT</data>
      <data key="d1">A vertebrobasilar stroke is a type of stroke that affects the brainstem and can lead to various complications, including dysphagia.</data>
