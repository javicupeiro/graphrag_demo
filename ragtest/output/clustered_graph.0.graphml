      <data key="d6">844</data>
      <data key="d7">a693b7b60ab94f41837f2112c46a323e</data>
    </node>
    <node id="DIETA HIPERCAL&#211;RICA">
      <data key="d0">EVENT</data>
      <data key="d1">A hypercaloric diet is a nutritional plan designed to provide high energy intake, often used for patients with malnutrition.</data>
      <data key="d2">aeb399b3f90c6a50eed8adfa8a140451</data>
