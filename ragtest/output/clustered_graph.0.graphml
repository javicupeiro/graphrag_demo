    <node id="HORMONAS REGULADORAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Hormonas reguladoras are hormones that regulate carbohydrate metabolism, including insulin and glucagon, which are affected by pancreatic surgery.</data>
      <data key="d2">3dfc700a2eaec232c05b0a53f2089229</data>
      <data key="d3">4</data>
