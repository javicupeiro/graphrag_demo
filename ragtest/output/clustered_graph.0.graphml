      <data key="d8">1.0</data>
      <data key="d9">La necrosis del par&#233;nquima pancre&#225;tico puede ocurrir en casos severos de pancreatitis aguda, complicando el tratamiento</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">e6a172090034473da18c81b05860c0c7</data>
      <data key="d12">953</data>
      <data key="d13">0</data>
    </edge>
