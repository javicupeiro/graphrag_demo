      <data key="d6">442</data>
      <data key="d7">38922f4326a64967babceff897cf9064</data>
    </node>
    <node id="YAMINA SULEIMAN MARTOS">
      <data key="d0">PERSON</data>
      <data key="d1">Dra. Yamina Suleiman Martos is a specialist in endocrinology and nutrition, involved in the clinical management of diabetes and related conditions.</data>
      <data key="d2">58db9fa69ca87ec24d7117fea6f2fe88</data>
      <data key="d3">20</data>
      <data key="d4">0</data>
      <data key="d5">10</data>
