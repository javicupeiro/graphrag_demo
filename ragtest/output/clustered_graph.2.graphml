      <data key="d6">8014</data>
      <data key="d7">5907b80593514fae85746dcdfc264801</data>
    </node>
    <node id="HEIMBURGER DC">
      <data key="d0">PERSON</data>
      <data key="d1">Heimburger DC is an author who contributed to the understanding of malnutrition syndromes in clinical practice.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">733</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8015</data>
      <data key="d7">c43d8c234070425c8cded01cd5dac2df</data>
    </node>
    <node id="MALNUTRITION SYNDROMES">
      <data key="d0">EVENT</data>
      <data key="d1">Malnutrition syndromes refer to a range of conditions that arise from inadequate nutrition, impacting clinical outcomes and healthcare costs.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">733</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">8016</data>
      <data key="d7">c42a20f049ee4bc7ac3102a54f48babe</data>
    </node>
    <node id="BRITISH ASSOCIATION OF PARENTERAL AND ENTERAL NUTRITION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The British Association of Parenteral and Enteral Nutrition (BAPEN) is an organization that developed the MUST screening tool for malnutrition.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">728</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8017</data>
      <data key="d7">c8a656879dbb40fc87950cf2a9e8f4ca</data>
    </node>
    <node id="NUTRITIONAL SCREENING METHODS">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional screening methods are tools used to identify individuals at risk of malnutrition, allowing for early intervention.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">693</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8018</data>
      <data key="d7">daed2d8f20684760b78d17786dc4c2ad</data>
    </node>
    <node id="ANTHROPOMETRIC PARAMETERS">
      <data key="d0">EVENT</data>
      <data key="d1">Anthropometric parameters are measurements of the human body used in nutritional assessment to evaluate body composition and nutritional status.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">693</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8019</data>
      <data key="d7">a381782aea2e445fadf5db1037ea68b0</data>
    </node>
    <node id="BIOCHEMICAL PARAMETERS">
      <data key="d0">EVENT</data>
      <data key="d1">Biochemical parameters involve laboratory tests that assess nutritional status through the analysis of blood and other bodily fluids.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">693</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8020</data>
      <data key="d7">97282214014745b89d2094d9971a7b18</data>
    </node>
    <node id="FUNCTIONAL PARAMETERS">
      <data key="d0">EVENT</data>
      <data key="d1">Functional parameters assess the physical capabilities of individuals, which can be affected by nutritional status.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">693</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8021</data>
      <data key="d7">640cf0cf651d4fbd98ae0c82217a4dab</data>
    </node>
    <node id="COSTS OF CARE">
      <data key="d0">EVENT</data>
      <data key="d1">Costs of care refer to the financial implications associated with treating patients, which can be influenced by their nutritional status.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">1241</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8022</data>
      <data key="d7">803770de21424e07951a5fb817f35c94</data>
    </node>
    <node id="MINI NUTRITIONAL ASSESSMENT SHORT FORM">
      <data key="d0">EVENT</data>
      <data key="d1">Mini Nutritional Assessment Short Form is a validated independent screening tool based on the long version of the MNA, designed to reduce assessment time and can be used regularly in various patient settings.</data>
      <data key="d2">687a74f539aea483b8c6611f3b062931</data>
      <data key="d3">729</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8023</data>
      <data key="d7">abfe642048ff43ff815e1618fe40e783</data>
    </node>
    <node id="COMMUNITY">
      <data key="d0">GEO</data>
      <data key="d1">The community refers to a group of individuals living in a common area, where nutritional assessments can also be applied.</data>
      <data key="d2">687a74f539aea483b8c6611f3b062931</data>
      <data key="d3">729</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8024</data>
      <data key="d7">222bae1aca5b4852a9ec77884ccc241e</data>
    </node>
    <node id="VGS-GP">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The VGS-GP is a variation of the original VGS method, designed for use in oncology patients to assess nutritional status with patient involvement.</data>
      <data key="d2">e596bbb9231cc72bade554b3d67804b8</data>
      <data key="d3">705</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8025</data>
      <data key="d7">25e84c2d64d54538989912944dec700d</data>
    </node>
    <node id="BAKER">
      <data key="d0">PERSON</data>
      <data key="d1">Baker is a prominent researcher known for significant contributions to the field of nutrition. He co-authored a study focused on sucrose digestion in patients, enhancing the understanding of carbohydrate metabolism. Additionally, Baker played a key role in the development of the Global Subjective Assessment method, which is utilized for nutritional evaluation, providing a comprehensive approach to assessing an individual's nutritional status. Furthermore, he is recognized for developing the classic VGS method in the 1980s, which has been instrumental in evaluating nutritional status. Through these contributions, Baker has made a lasting impact on nutritional research and assessment methodologies.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68,e596bbb9231cc72bade554b3d67804b8,f7b74dc42fea9d33e4675a41e15975ab</data>
      <data key="d3">705</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">8026</data>
      <data key="d7">60414c0c54ae408d8d3e60b0c8b0eba5</data>
    </node>
    <node id="DUTCH MALNUTRITION STEERING GROUP">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Dutch Malnutrition Steering Group is an organization dedicated to addressing malnutrition issues within the Netherlands. It plays a crucial role in developing the SNAQ (Screening Nutritional Assessment Questionnaire) and its various validated versions tailored for different patient populations. Through its initiatives, the group aims to improve nutritional care and outcomes for individuals at risk of malnutrition.</data>
      <data key="d2">2ebe12524f7750215eee73b328b601ee,8d04735d72211a4d6f619b72cbce48b6</data>
      <data key="d3">726</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">8027</data>
      <data key="d7">a8d78ee8fe95494b983a066466c58e95</data>
    </node>
    <node id="M&#201;TODO DE CARDONA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Cardona method is a nutritional screening tool for hospitalized patients that evaluates recent weight changes and other clinical factors.</data>
      <data key="d2">2ebe12524f7750215eee73b328b601ee</data>
      <data key="d3">1163</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8028</data>
      <data key="d7">b90955311bf34c9ab27e9b78b5bb2167</data>
    </node>
    <node id="M&#201;TODO DE ELMORE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Elmore method is a numerical scale for assessing nutritional risk based on multivariate equations related to serum albumin and weight loss.</data>
      <data key="d2">2ebe12524f7750215eee73b328b601ee</data>
      <data key="d3">1163</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8029</data>
      <data key="d7">c10d04cc598a4200939bf51b3a950492</data>
    </node>
    <node id="M&#201;TODO CONUT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The CONUT method is an automated nutritional screening tool developed in Spain that alerts healthcare providers about potential malnutrition risks.</data>
      <data key="d2">2ebe12524f7750215eee73b328b601ee</data>
      <data key="d3">1163</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8030</data>
      <data key="d7">05d2ffc105734c94845d4e7642cd76e8</data>
    </node>
    <node id="PAR&#193;METROS DE LABORATORIO">
      <data key="d0">EVENT</data>
      <data key="d1">Los par&#225;metros de laboratorio son datos bioqu&#237;micos que se utilizan en la valoraci&#243;n nutricional para establecer un diagn&#243;stico.</data>
      <data key="d2">fbbb8c2530f7ac5635ecf5110ea186b2</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
