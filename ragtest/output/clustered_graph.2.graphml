      <data key="d6">12093</data>
      <data key="d7">defec844724c4f459e57533bc654984f</data>
    </node>
    <node id="INFECCI&#211;N POR CLOSTRIDIUM DIFFICILE">
      <data key="d0">EVENT</data>
      <data key="d1">INFECCI&#211;N POR CLOSTRIDIUM DIFFICILE (Clostridium difficile infection) is a serious condition that probiotics may help manage, according to research.</data>
      <data key="d2">5a1ea1a4dfb1b591756a8dc60f504da2</data>
      <data key="d3">1025</data>
      <data key="d4">2</data>
