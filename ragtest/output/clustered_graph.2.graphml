    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="OMEGA-3 FATTY ACID">
      <data key="d8">6.0</data>
      <data key="d9">Omega-3 fatty acid is utilized in the context of parenteral nutrition for managing specific medical conditions.</data>
      <data key="d10">488affd4bfc1b1b4b9f5b6a054c97d80</data>
      <data key="d11">e38a7159825d4940845db2b023a30744</data>
