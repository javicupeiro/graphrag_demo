    <edge source="PROP-1" target="HIPOPITUITARISMO">
      <data key="d8">7.0</data>
      <data key="d9">PROP-1 is a common cause of combined pituitary deficits, which can lead to hypopituitarism.</data>
      <data key="d10">9ea2863d43f4c93ae3681a0faf1a0a3d</data>
      <data key="d11">a7a36a306a984e34b42956f7082cf3c3</data>
