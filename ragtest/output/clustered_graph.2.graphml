    </edge>
    <edge source="HIPOXALURIA" target="HIPOXALURIA RELATIVA">
      <data key="d8">4.0</data>
      <data key="d9">Relative hypoxaluria indicates low oxalate levels compared to other urinary substances, which may influence kidney stone risk.</data>
      <data key="d10">634b74df7b9403e4c578f3fc84fe3335</data>
      <data key="d11">b7017567cb9b49a493f01184bc4c6f04</data>
      <data key="d12">18925</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOXALURIA" target="HIPOXALURIA CR&#211;NICA">
      <data key="d8">5.0</data>
      <data key="d9">Chronic hypoxaluria is characterized by persistently low oxalate levels in the urine, which can have various health implications.</data>
      <data key="d10">634b74df7b9403e4c578f3fc84fe3335</data>
      <data key="d11">1be627c0e1da401194cd13fc4bc2b211</data>
      <data key="d12">18926</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOXALURIA" target="HIPOXALURIA AGUDA">
      <data key="d8">5.0</data>
      <data key="d9">Acute hypoxaluria refers to a sudden drop in oxalate levels in the urine, which may be triggered by dietary changes or medical conditions.</data>
      <data key="d10">634b74df7b9403e4c578f3fc84fe3335</data>
      <data key="d11">fdfe9c57bf0e4541adf1dc802da74a48</data>
      <data key="d12">18927</data>
      <data key="d13">2</data>
    </edge>
