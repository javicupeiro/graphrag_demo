    <node id="YEYUNOSTOM&#205;A DE ALIMENTACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Yeyunostom&#237;a de alimentaci&#243;n is a surgical procedure that creates an opening in the jejunum for feeding, often used in patients with gastrointestinal issues.</data>
      <data key="d2">f7ca532ae3a834fd6643ad694d3e850c</data>
