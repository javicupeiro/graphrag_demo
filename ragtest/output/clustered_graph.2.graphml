      <data key="d11">555339b8a7e245d588e9caa4d14115f5</data>
      <data key="d12">16757</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GEB" target="GER">
      <data key="d8">8.0</data>
      <data key="d9">GEB and GER are both measures of energy expenditure used in nutritional assessments</data>
      <data key="d10">dea64d5eb807430bc52e8bed6e30c393</data>
      <data key="d11">ff087f47541548478448cdfef1d8e1e9</data>
