    </node>
    <node id="ENFERMEDADES AUTOINMUNES&lt;|DIFF_MARKER|&gt;EVENT">
      <data key="d0">LAS ENFERMEDADES AUTOINMUNES PUEDEN SER TRATADAS CON TRASPLANTE DE C&#201;LULAS HEMATOPOY&#201;TICAS AUT&#211;LOGAS.</data>
