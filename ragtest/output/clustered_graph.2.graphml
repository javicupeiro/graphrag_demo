    <edge source="GLICEROL" target="GLICEROL-3-FOSFATO">
      <data key="d8">7.0</data>
      <data key="d9">Glycerol is phosphorylated to form glycerol-3-phosphate, which can enter gluconeogenesis.</data>
      <data key="d10">449046c83c1432d2b8cc6cacb5eadf51</data>
      <data key="d11">b7398276cf84440dae2e76e196ff8587</data>
      <data key="d12">8010</data>
