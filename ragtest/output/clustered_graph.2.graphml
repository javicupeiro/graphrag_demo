      <data key="d6">10902</data>
      <data key="d7">ee4fc2c7c88b46078047ecb51dc85a85</data>
    </node>
    <node id="SIRI-TARINO PW">
      <data key="d0">PERSON</data>
      <data key="d1">Siri-Tarino PW is an author known for conducting meta-analyses on the association of saturated fat with cardiovascular disease.</data>
