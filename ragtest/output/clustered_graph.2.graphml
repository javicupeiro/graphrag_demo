    </node>
    <node id="RECOMENDACIONES DIETARIAS">
      <data key="d0">EVENT</data>
      <data key="d1">Dietary recommendations are guidelines provided by organizations to help individuals meet their nutritional needs.</data>
      <data key="d2">60577bdc0f4979d10ba7385bf483c344</data>
