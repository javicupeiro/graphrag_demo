      <data key="d6">14230</data>
      <data key="d7">dce95ea7b7ef49fbad9b3fb34a161bb6</data>
    </node>
    <node id="ONIONS">
      <data key="d0">GEO</data>
      <data key="d1">Onions are rich in flavonoids and can potentiate the effects of anticoagulants due to their fibrinolytic activity.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d3">1605</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14231</data>
      <data key="d7">a2dfdf5a32364dac863b4f5daa3655d4</data>
    </node>
    <node id="LICORICE">
      <data key="d0">GEO</data>
      <data key="d1">Licorice can antagonize the effects of antihypertensives and increase the risk of toxicity with digitalis due to sodium retention and hypokalemia.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">1</data>
      <data key="d6">14232</data>
      <data key="d7">5796472dd1904c708ffcdbce22c9f5af</data>
    </node>
    <node id="SOY">
      <data key="d0">GEO</data>
      <data key="d1">Soy contains phytoestrogens that can antagonize the antiestrogenic action of tamoxifen.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">1</data>
      <data key="d6">14233</data>
      <data key="d7">c99a74ddab8a44a5875c41d6129cada8</data>
    </node>
    <node id="PHENYTOIN">
      <data key="d0">PERSON</data>
      <data key="d1">Phenytoin is a medication whose metabolism can be reduced by acute alcohol consumption.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d3">1387</data>
      <data key="d4">2</data>
