      <data key="d8">1.0</data>
      <data key="d9">Las modificaciones en el bolo son parte de las t&#233;cnicas compensadoras para ayudar a los pacientes con disfagia</data>
      <data key="d10">8bf23d86ceb6dc396acc52c92878463d</data>
      <data key="d11">9f9e5eb8bf1c460ca58c84d1de0c5f25</data>
      <data key="d12">5439</data>
