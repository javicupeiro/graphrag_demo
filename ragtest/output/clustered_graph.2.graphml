    <node id="SYNDROME OF INAPPROPRIATE ANTIDIURETIC HORMONE SECRETION">
      <data key="d0">EVENT</data>
      <data key="d1">The syndrome of inappropriate antidiuretic hormone secretion is a medical condition that can lead to hyponatremia.</data>
      <data key="d2">d7880a3661021454f32e78a000064055</data>
      <data key="d3">1851</data>
      <data key="d4">2</data>
