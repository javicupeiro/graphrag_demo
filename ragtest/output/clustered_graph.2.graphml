    <node id="RASEMARY WYATT">
      <data key="d0">PERSON</data>
      <data key="d1">Rasemary Wyatt is a professional who co-designed the Standardized Bedside Swallowing Assessment (SSA) for detecting dysphagia.</data>
      <data key="d2">4befdcd21a98898cec30bbac7b402d4b</data>
      <data key="d3">157</data>
