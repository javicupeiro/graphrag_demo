      <data key="d5">19</data>
      <data key="d6">1970</data>
      <data key="d7">bac2f81af93d4374874b6b8eb126ac75</data>
    </node>
    <node id="HISTIDINE">
      <data key="d0">EVENT</data>
      <data key="d1">Histidine is an amino acid that may be essential in certain medical conditions, particularly in renal insufficiency.</data>
      <data key="d2">cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d3">1230</data>
      <data key="d4">2</data>
