    <node id="RESECCI&#211;N INTESTINAL">
      <data key="d0">EVENT</data>
      <data key="d1">Intestinal resection is a surgical procedure that removes a portion of the intestine, which can lead to malabsorption issues.</data>
      <data key="d2">d147df5b06fa62d87b7edd3f20dcd246</data>
