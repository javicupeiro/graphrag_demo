    </node>
    <node id="DIGITAL TECHNOLOGY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Digital technology encompasses various tools and systems that enhance communication, information access, and health services, significantly impacting society.</data>
      <data key="d2">3d64634b55389cb5d01f78b185bada8d</data>
