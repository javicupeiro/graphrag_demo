      <data key="d10">7f3e164582a504c9fe6bdbc56e1a8e97</data>
      <data key="d11">da35dc0201e44f1ca8cc2d0337f8baba</data>
      <data key="d12">9117</data>
      <data key="d13">2</data>
    </edge>
    <edge source="P. JUSTO PAV&#205;A" target="INSUFICIENCIA RENAL AGUDA">
      <data key="d8">6.0</data>
      <data key="d9">P. Justo Pav&#237;a discusses the nutritional needs of patients with acute renal failure in the chapter on nutrition in renal insufficiency.</data>
      <data key="d10">cd16cc82ca1357af8c9c1ab73ea55c5a</data>
      <data key="d11">2a15ea3f12804eb2a4dfad6c29bf946e</data>
      <data key="d12">9118</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="NUTRICI&#211;N EN LA UCI">
      <data key="d8">8.0</data>
      <data key="d9">Nutrition in the ICU is crucial for managing patients with acute renal failure, addressing their specific nutritional needs.</data>
      <data key="d10">cd16cc82ca1357af8c9c1ab73ea55c5a</data>
      <data key="d11">160298aa67f1459da58ffc7a60b09680</data>
      <data key="d12">9119</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="HEMODI&#193;LISIS">
      <data key="d8">30.0</data>
      <data key="d9">Hemodialysis is a common and effective treatment for patients suffering from acute renal failure (insuficiencia renal aguda). This procedure is essential for managing the condition, as it helps filter waste products from the blood when the kidneys are unable to perform this function. Patients undergoing hemodialysis often require specific dietary adjustments to support their health during treatment. Overall, hemodialysis serves as a vital option for individuals facing the challenges of acute renal failure, providing necessary support for their bodily functions.</data>
      <data key="d10">2c60ced31055ac58d76da9c1e90c8e9d,532561f62a972376f3f898b265623fc0,64417661dbb019f8f4ceb9fcc2fbdaa6,9f77fc213da2123b013166c181a60323</data>
      <data key="d11">15355cab8dd84f11b54e665d52cafe8d</data>
      <data key="d12">9120</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="HEMOFILTRACI&#211;N CONTINUA">
      <data key="d8">8.0</data>
      <data key="d9">Continuous hemofiltration is another treatment option for acute renal failure, requiring higher protein intake due to increased losses.</data>
      <data key="d10">64417661dbb019f8f4ceb9fcc2fbdaa6</data>
      <data key="d11">e497d5ee693448a2847cceae15685599</data>
      <data key="d12">9121</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="DI&#193;LISIS">
      <data key="d8">9.0</data>
      <data key="d9">Dialysis is a critical treatment for patients experiencing acute renal failure, helping to manage their condition.</data>
      <data key="d10">64417661dbb019f8f4ceb9fcc2fbdaa6</data>
      <data key="d11">42c304c05ad7441bab8c881d0c034e09</data>
      <data key="d12">9122</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="RABDOMI&#211;LISIS">
      <data key="d8">8.0</data>
      <data key="d9">Rhabdomyolysis can lead to acute renal failure due to muscle breakdown products damaging the kidneys</data>
      <data key="d10">9312fdfba5d3f79b95c5e6af38ced009</data>
      <data key="d11">edec084c60f84d9aa95b0730b9d2b06c</data>
      <data key="d12">9123</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="INSUFICIENCIA RENAL CR&#211;NICA">
      <data key="d8">8.0</data>
      <data key="d9">Insuficiencia renal aguda is a condition that can lead to serious complications, potentially resulting in chronic kidney disease if not managed properly. This acute renal insufficiency can progress to insuficiencia renal cr&#243;nica, adversely affecting long-term kidney function. Proper management is crucial to prevent the transition from acute to chronic renal insufficiency.</data>
      <data key="d10">2c60ced31055ac58d76da9c1e90c8e9d,7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d11">a19309bd64b143059a4a6f2c6905638e</data>
      <data key="d12">9124</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="BICARBONATOS">
      <data key="d8">6.0</data>
      <data key="d9">The inability to reabsorb bicarbonates is a consequence of acute kidney failure, affecting acid-base balance</data>
      <data key="d10">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d11">4630f2bf0e8d4dc3bc0823d2adc087ff</data>
      <data key="d12">9125</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="SOCIEDAD ESPA&#209;OLA DE NUTRICI&#211;N ENTERAL Y PARENTERAL">
      <data key="d8">8.0</data>
      <data key="d9">ESPEN provides nutritional guidelines for managing acute renal failure</data>
      <data key="d10">532561f62a972376f3f898b265623fc0</data>
      <data key="d11">aaee9b4b993e4d128952033ad01212dc</data>
      <data key="d12">9126</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="DI&#193;LISIS PERITONEAL">
      <data key="d8">14.0</data>
      <data key="d9">Insuficiencia renal aguda, tambi&#233;n conocida como falla renal aguda, es una condici&#243;n m&#233;dica que requiere atenci&#243;n inmediata para la eliminaci&#243;n de desechos del cuerpo. La di&#225;lisis peritoneal es un tratamiento utilizado para manejar esta condici&#243;n en pacientes que necesitan un m&#233;todo eficaz para eliminar los desechos acumulados. Este enfoque terap&#233;utico permite a los pacientes con insuficiencia renal aguda recibir el tratamiento necesario para estabilizar su salud y mejorar su calidad de vida.</data>
      <data key="d10">532561f62a972376f3f898b265623fc0,9f77fc213da2123b013166c181a60323</data>
      <data key="d11">2f2b78790c35425295d44a8d86a15043</data>
      <data key="d12">9127</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="UCI">
      <data key="d8">8.0</data>
      <data key="d9">Los pacientes con insuficiencia renal aguda a menudo son ingresados en la UCI para recibir tratamiento intensivo</data>
      <data key="d10">9f77fc213da2123b013166c181a60323</data>
      <data key="d11">911e53f23da9451b9be2e9ea83a2d5d5</data>
      <data key="d12">9128</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="DIETA BAJA EN PROTE&#205;NAS">
      <data key="d8">9.0</data>
      <data key="d9">A low-protein diet is essential for managing acute renal failure</data>
      <data key="d10">c947e3441a061fe1807f7aaf29becdce</data>
      <data key="d11">66816d6f2c9f4420b232f782f36ac2a3</data>
      <data key="d12">9129</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="HEMODIALYSIS">
      <data key="d8">8.0</data>
      <data key="d9">Acute renal failure may require hemodialysis for treatment</data>
      <data key="d10">9da930839072b524410f2345ab1df8b1</data>
      <data key="d11">5d19a5b87ad54ba2b8a899eaff5d6829</data>
      <data key="d12">9130</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="DIALYSIS PERITONEAL">
      <data key="d8">8.0</data>
      <data key="d9">Acute renal failure may require peritoneal dialysis for treatment</data>
      <data key="d10">9da930839072b524410f2345ab1df8b1</data>
      <data key="d11">16a8d22362124b8280895aedb289564e</data>
      <data key="d12">9131</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="DI&#193;LISIS PERITONEAL CONTINUA">
      <data key="d8">1.0</data>
      <data key="d9">Continuous peritoneal dialysis is a treatment option for patients with acute renal failure, helping to manage potassium levels.</data>
      <data key="d10">31b61ae47905168ef430433c9eb5237a</data>
      <data key="d11">404e17bd09b545f5ba8ca26c5df4bb3b</data>
      <data key="d12">9132</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL AGUDA" target="HYPERKALIEMIA">
      <data key="d8">8.0</data>
      <data key="d9">Acute renal failure can lead to hyperkalemia due to impaired potassium excretion.</data>
      <data key="d10">31b61ae47905168ef430433c9eb5237a</data>
      <data key="d11">b81f0f92953e41c1a4070b87185e3a7e</data>
      <data key="d12">9133</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRA" target="DI&#193;LISIS">
      <data key="d8">8.0</data>
      <data key="d9">Dialysis is a treatment for patients with acute renal failure, affecting their nutritional management and requirements.</data>
      <data key="d10">cd16cc82ca1357af8c9c1ab73ea55c5a</data>
      <data key="d11">a122d4e94e2c47008dcda2709673697c</data>
      <data key="d12">9134</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRA" target="HIPERTIGLICERIDEMIA">
      <data key="d8">6.0</data>
      <data key="d9">Hypertriglyceridemia is a concern in the nutritional management of patients with acute renal failure, necessitating dietary adjustments.</data>
      <data key="d10">cd16cc82ca1357af8c9c1ab73ea55c5a</data>
      <data key="d11">4688d382ea054ae1a0ec3a4c70cac21c</data>
      <data key="d12">9135</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRA" target="VITAMINAS HIDROSOLUBLES">
      <data key="d8">7.0</data>
      <data key="d9">Water-soluble vitamins are critical in the nutritional care of patients with acute renal failure, especially during renal replacement therapies.</data>
      <data key="d10">cd16cc82ca1357af8c9c1ab73ea55c5a</data>
      <data key="d11">0b341c28ff0d49d790cffd80e281e80d</data>
      <data key="d12">9136</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRA" target="CATABOLISMO PROTEICO">
      <data key="d8">7.0</data>
      <data key="d9">Increased protein catabolism in patients with acute renal failure necessitates careful nutritional planning to meet their needs.</data>
      <data key="d10">cd16cc82ca1357af8c9c1ab73ea55c5a</data>
      <data key="d11">2dc164a4530840f88141bbe5f436a5f3</data>
      <data key="d12">9137</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRA" target="ALTERACIONES ELECTROL&#205;TICAS">
      <data key="d8">1.0</data>
      <data key="d9">Electrolyte imbalances in patients with acute renal failure require specific nutritional interventions to restore balance.</data>
      <data key="d10">cd16cc82ca1357af8c9c1ab73ea55c5a</data>
      <data key="d11">b37535a9d0d0481a8025fad0edda39ec</data>
      <data key="d12">9138</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DI&#193;LISIS" target="INSUFICIENCIA RENAL CR&#211;NICA">
      <data key="d8">9.0</data>
      <data key="d9">La di&#225;lisis es un tratamiento utilizado en pacientes con insuficiencia renal cr&#243;nica para reemplazar la funci&#243;n renal</data>
      <data key="d10">61564a330848cb173088bd08e1a9a181</data>
      <data key="d11">4f6c45049c9448a189ef5f1b380ea968</data>
      <data key="d12">9139</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DI&#193;LISIS" target="NUTRICI&#211;N NUTRICIONAL">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional management is essential for patients undergoing dialysis to ensure adequate nutrient intake</data>
      <data key="d10">665d7ba0d30bda94b0d549dc1822d7f7</data>
      <data key="d11">261f5bf09e774ae9af107f1470ac2d86</data>
      <data key="d12">9140</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DI&#193;LISIS" target="HEMODIALYSIS">
      <data key="d8">8.0</data>
      <data key="d9">Hemodialysis is a type of dialysis used to treat patients with kidney failure</data>
      <data key="d10">9da930839072b524410f2345ab1df8b1</data>
      <data key="d11">1faa3e2ad6c54b28bccb1ce15fe435a1</data>
      <data key="d12">9141</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DI&#193;LISIS" target="DIALYSIS PERITONEAL">
      <data key="d8">8.0</data>
      <data key="d9">Peritoneal dialysis is another type of dialysis used to treat patients with kidney failure</data>
      <data key="d10">9da930839072b524410f2345ab1df8b1</data>
      <data key="d11">e2f2c210f46744b797d1eec306b6a35d</data>
      <data key="d12">9142</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DI&#193;LISIS" target="PACIENTES EN DI&#193;LISIS">
      <data key="d8">8.0</data>
      <data key="d9">Patients in dialysis require dietary management to support their treatment and health</data>
      <data key="d10">d87b6185e9826c5338c079056e2019a9</data>
      <data key="d11">8dbf3a2743884ec382d8567c8395cce1</data>
      <data key="d12">9143</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMODI&#193;LISIS" target="INSUFICIENCIA RENAL CR&#211;NICA">
      <data key="d8">15.0</data>
      <data key="d9">Hemodialysis is a common treatment for patients with chronic renal failure (insuficiencia renal cr&#243;nica), specifically designed to manage the condition by addressing critical needs such as potassium control. This treatment not only helps in regulating electrolyte levels but also significantly impacts the nutritional requirements of patients suffering from chronic renal failure.</data>
      <data key="d10">31b61ae47905168ef430433c9eb5237a,64417661dbb019f8f4ceb9fcc2fbdaa6</data>
      <data key="d11">3e99792539b04eb6b63a1045d7d1ea09</data>
      <data key="d12">9144</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMODI&#193;LISIS" target="UCI">
      <data key="d8">7.0</data>
      <data key="d9">The patient underwent hemodialysis while being treated in the UCI.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">32adabc8e69444e1928493a9a4b964a9</data>
      <data key="d12">9145</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMODI&#193;LISIS" target="DUODENOPANCREATECTOM&#205;A SUBTOTAL">
      <data key="d8">6.0</data>
      <data key="d9">The patient required hemodialysis due to complications arising from the subtotal duodenopancreatectomy.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">f37f75efe3234cde95e2dcd5d3c9bd20</data>
      <data key="d12">9146</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMODI&#193;LISIS" target="FALLO RENAL AGUDO">
      <data key="d8">9.0</data>
      <data key="d9">Hemodialysis is a treatment option for patients suffering from acute renal failure</data>
      <data key="d10">665d7ba0d30bda94b0d549dc1822d7f7</data>
      <data key="d11">fd0d4b0a79054950a1044e64af52a2d0</data>
      <data key="d12">9147</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMODI&#193;LISIS" target="AMINO&#193;CIDOS">
      <data key="d8">7.0</data>
      <data key="d9">Amino acids are often supplemented in patients undergoing hemodialysis to maintain nutritional balance</data>
      <data key="d10">665d7ba0d30bda94b0d549dc1822d7f7</data>
      <data key="d11">af679612bae840caa1f9415067f17063</data>
      <data key="d12">9148</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMODI&#193;LISIS" target="ESTUDIO FINE">
      <data key="d8">8.0</data>
      <data key="d9">The Estudio FINE focuses on the nutritional support during hemodialysis, making the two entities directly related</data>
      <data key="d10">d1e7cd9fdc3093bc5902030d654d0763</data>
      <data key="d11">9eb3a2ae1316480da2149e7ce433042e</data>
      <data key="d12">9149</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMODI&#193;LISIS" target="ENFERMEDAD RENAL CR&#211;NICA">
      <data key="d8">16.0</data>
      <data key="d9">Hemodialysis is a treatment option for patients suffering from chronic kidney disease (ENFERMEDAD RENAL CR&#211;NICA), particularly in its advanced stages. This procedure is utilized to manage the complications associated with chronic kidney disease, providing essential support for patients whose kidneys are no longer able to effectively filter waste and excess fluids from the blood.</data>
      <data key="d10">169eceabd2bd24183f24faccb2c00088,d59a9ea18d433acb64d60dbe17f5ae9b</data>
      <data key="d11">44713f0dfeb34acea8729821080d2123</data>
      <data key="d12">9150</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMODI&#193;LISIS" target="CAT&#201;TER CENTRAL">
      <data key="d8">1.0</data>
      <data key="d9">Central catheters are often used for hemodialysis in patients with renal failure</data>
      <data key="d10">67344d72dff60fcb903b258fbca95de5</data>
      <data key="d11">3c96d1853f4c455ab30caae8e41e4d57</data>
      <data key="d12">9151</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEMOFILTRACI&#211;N CONTINUA" target="INSUFICIENCIA RENAL CR&#211;NICA">
      <data key="d8">8.0</data>
      <data key="d9">Continuous hemofiltration is a treatment for chronic renal failure that requires careful dietary management.</data>
      <data key="d10">64417661dbb019f8f4ceb9fcc2fbdaa6</data>
      <data key="d11">19cd5397a1b844bcbe38430845923f70</data>
      <data key="d12">9152</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL CR&#211;NICA" target="TRATAMIENTO CON GH">
      <data key="d8">7.0</data>
      <data key="d9">El tratamiento con GH est&#225; aprobado para la insuficiencia renal cr&#243;nica en ni&#241;os, lo que indica su relevancia en el crecimiento</data>
      <data key="d10">b11e575be155e186717a992a9d641577</data>
      <data key="d11">43dcf6a40e08429dbd5b98ff914845fb</data>
      <data key="d12">9153</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL CR&#211;NICA" target="RIESGO MUY ALTO">
      <data key="d8">1.0</data>
      <data key="d9">Patients with severe chronic kidney disease are classified in the very high-risk group</data>
      <data key="d10">ce43a9a4cdf2497b2f984547a2787fff</data>
      <data key="d11">a4bdb5ed68b544629d4903bed48b8138</data>
      <data key="d12">9154</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL CR&#211;NICA" target="GSDIB">
      <data key="d8">7.0</data>
      <data key="d9">Chronic kidney failure can be a severe complication of GSDIb, necessitating advanced medical interventions.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">7db1f90dbb0f4125a2a231837ebb95d3</data>
      <data key="d12">9155</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL CR&#211;NICA" target="DI&#193;LISIS PERITONEAL">
      <data key="d8">8.0</data>
      <data key="d9">La di&#225;lisis peritoneal es una opci&#243;n de tratamiento para pacientes con insuficiencia renal cr&#243;nica, permitiendo la eliminaci&#243;n de desechos del cuerpo.</data>
      <data key="d10">2c60ced31055ac58d76da9c1e90c8e9d</data>
      <data key="d11">71816c0e84c84e95bad128fb4e594616</data>
      <data key="d12">9156</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL CR&#211;NICA" target="PEW">
      <data key="d8">1.0</data>
      <data key="d9">Insuficiencia renal cr&#243;nica is associated with protein-energy wasting due to the imbalance between protein degradation and synthesis</data>
      <data key="d10">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d11">ce1fde660a554e4781ababace860bf3c</data>
      <data key="d12">9157</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL CR&#211;NICA" target="HIPERFOSFATEMIA">
      <data key="d8">7.0</data>
      <data key="d9">Chronic kidney disease often leads to hyperphosphatemia due to impaired phosphate excretion</data>
      <data key="d10">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d11">e681b542fe3a4387882da6c71dbb53f7</data>
      <data key="d12">9158</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL CR&#211;NICA" target="HIPERPARATIROIDISMO SECUNDARIO">
      <data key="d8">8.0</data>
      <data key="d9">Secondary hyperparathyroidism is a common complication of chronic kidney disease due to imbalances in calcium and phosphate</data>
      <data key="d10">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d11">c1654567f8d544f49cedc783a1aa1390</data>
      <data key="d12">9159</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL CR&#211;NICA" target="OSTEODISTROFIA RENAL">
      <data key="d8">8.0</data>
      <data key="d9">Renal osteodystrophy is a direct consequence of chronic kidney disease affecting bone health</data>
      <data key="d10">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d11">a65c1a34b650466c833e415dc6305def</data>
      <data key="d12">9160</data>
      <data key="d13">2</data>
    </edge>
