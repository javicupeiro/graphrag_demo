      <data key="d7">2ea98c8983904276a38f54aa2903b606</data>
    </node>
    <node id="YOGUR BATIDO">
      <data key="d0">EVENT</data>
      <data key="d1">Whipped yogurt is a nectar-thick liquid with a viscosity of 51-350 cP, appropriate for patients with dysphagia.</data>
