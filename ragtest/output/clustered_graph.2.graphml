      <data key="d11">59c307ccf18f40899852a0c566b782bc</data>
      <data key="d12">5045</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA KARAYA" target="GOMA TRAGACANTO">
      <data key="d8">7.0</data>
      <data key="d9">Ambas gomas son utilizadas como emulsionantes y estabilizantes en la industria alimentaria</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">5e5404c1b1fb4aa0af6da8861df50862</data>
      <data key="d12">5046</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA TRAGACANTO" target="ASTRAGALUS">
      <data key="d8">9.0</data>
      <data key="d9">La goma tragacanto se obtiene del exudado producido por algunas especies del arbusto del g&#233;nero Astragalus</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">302cdbc0a339436ca5abbd53beeefb24</data>
      <data key="d12">5047</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALMID&#211;N MODIFICADO" target="MALTODEXITRINAS">
      <data key="d8">5.0</data>
      <data key="d9">Ambos son derivados del almid&#243;n y se utilizan en la industria alimentaria por sus propiedades funcionales</data>
      <data key="d10">306c653730f336c5553a6d1acf1f0932</data>
      <data key="d11">2937fa337ed9400fa8c29224e572c531</data>
      <data key="d12">5048</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALMID&#211;N MODIFICADO" target="CARBOXIMETILCELULOSA">
      <data key="d8">5.0</data>
      <data key="d9">La carboximetilcelulosa y el almid&#243;n modificado son utilizados en la industria alimentaria para mejorar la textura y la retenci&#243;n de humedad</data>
      <data key="d10">306c653730f336c5553a6d1acf1f0932</data>
      <data key="d11">59c3e497426f416b8931ed8206df6055</data>
      <data key="d12">5049</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CARBOXIMETILCELULOSA" target="HELADOS">
      <data key="d8">1.0</data>
      <data key="d9">La carboximetilcelulosa se utiliza en la elaboraci&#243;n de helados como estabilizante para mejorar la textura</data>
      <data key="d10">306c653730f336c5553a6d1acf1f0932</data>
      <data key="d11">a907510eef8c40de99c9770cb0187dd9</data>
      <data key="d12">5050</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REOLOG&#205;A" target="ESPESANTES">
      <data key="d8">1.0</data>
      <data key="d9">La reolog&#237;a es fundamental en el desarrollo de espesantes, ya que estudia c&#243;mo los l&#237;quidos fluyen y se comportan, lo que es esencial para su formulaci&#243;n</data>
      <data key="d10">a3444da30e339275da1056c3e13bcae5</data>
      <data key="d11">de627a87d1ac43ca9bf8340facf0f036</data>
      <data key="d12">5051</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIFICANTE" target="HELADOS">
      <data key="d8">6.0</data>
      <data key="d9">El emulsificante se utiliza en la producci&#243;n de helados para mezclar ingredientes y mejorar la textura</data>
      <data key="d10">306c653730f336c5553a6d1acf1f0932</data>
      <data key="d11">856cfe4f7f684d9abf4ab1f14769818f</data>
      <data key="d12">5052</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESTABILIZANTE" target="SORBETES">
      <data key="d8">6.0</data>
      <data key="d9">El estabilizante se utiliza en sorbetes para mantener la textura y evitar la formaci&#243;n de cristales de hielo</data>
      <data key="d10">306c653730f336c5553a6d1acf1f0932</data>
      <data key="d11">46e72fa605ab4a8daa2d7e40276c800d</data>
      <data key="d12">5053</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MERMELEDAS" target="AGENTE ESPESANTE">
      <data key="d8">6.0</data>
      <data key="d9">El agente espesante se utiliza en la elaboraci&#243;n de mermeladas para mejorar su consistencia</data>
      <data key="d10">306c653730f336c5553a6d1acf1f0932</data>
      <data key="d11">ff70214594854410b55f55cb67759a05</data>
      <data key="d12">5054</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GELATINAS DE FRUTAS" target="AGENTE ESPESANTE">
      <data key="d8">5.0</data>
      <data key="d9">Las gelatinas de frutas a menudo utilizan agentes espesantes para lograr la textura deseada</data>
      <data key="d10">306c653730f336c5553a6d1acf1f0932</data>
      <data key="d11">b072b4f6a64f48b1adb6fee3dd7571b6</data>
      <data key="d12">5055</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HELADOS" target="ENFERMEDAD CELIACA">
      <data key="d8">7.0</data>
      <data key="d9">Los helados pueden contener gluten y deben ser consumidos con precauci&#243;n por personas con enfermedad celiaca.</data>
      <data key="d10">7d2050a2481adc105bdebbcf2af1a173</data>
      <data key="d11">4f2585794c7f48caa70ce0617369b0e4</data>
      <data key="d12">5056</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRUPO NACIONAL DE TRABAJO SOBRE LA DIETA PARA LA DISFAGIA" target="GALLEGOS ET AL">
      <data key="d8">6.0</data>
      <data key="d9">Gallegos et al. has questioned the recommendations set by the National Working Group on Diet for Dysphagia</data>
      <data key="d10">085d1e3702bc42fa47418095d541867f</data>
      <data key="d11">69dc5145b9b34f3dabbc68c9807646a2</data>
      <data key="d12">5057</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPESANTES" target="INDUSTRIA ALIMENTARIA">
      <data key="d8">7.0</data>
      <data key="d9">The food industry employs thickeners to improve the texture and stability of food products for consumers, including those with swallowing difficulties.</data>
      <data key="d10">c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">c4d3725ae70941b293e9e2415a2e4240</data>
      <data key="d12">5058</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPESANTES" target="SALIVA">
      <data key="d8">6.0</data>
      <data key="d9">Saliva interacts with thickeners, affecting the viscosity of thickened liquids, which is critical for individuals with dysphagia.</data>
      <data key="d10">c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">f47ddbf43a484cf59a10e33cb9e30624</data>
      <data key="d12">5059</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPESANTES" target="ALMID&#211;N">
      <data key="d8">15.0</data>
      <data key="d9">ESPESANTES, commonly known as thickeners, often utilize ALMID&#211;N, or starch, as a primary component. Starch plays a crucial role in food preparation, helping to achieve the desired viscosity in various dishes. Additionally, it is frequently employed as a thickening agent in products specifically designed for individuals with dysphagia, ensuring that these foods are safe and easier to consume.</data>
      <data key="d10">4aeca0ee5f2663f449cfd017d3e3bbfb,c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">e23461940e4c45ffaf5af2b9767a2c2f</data>
      <data key="d12">5060</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPESANTES" target="MACROMOL&#201;CULAS">
      <data key="d8">8.0</data>
      <data key="d9">Macromolecules are the primary components that allow thickeners to modify the viscosity of liquids and stabilize food products.</data>
      <data key="d10">c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">fa51d34751074c4bab9fdb5385838006</data>
      <data key="d12">5061</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPESANTES" target="LIQUIDOS">
      <data key="d8">8.0</data>
      <data key="d9">Liquids can be thickened using thickeners to aid individuals with swallowing difficulties, making them safer to consume.</data>
      <data key="d10">c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">8d10bb9e55ad4a688855f7f736a2a2a5</data>
      <data key="d12">5062</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPESANTES" target="BEBIDAS">
      <data key="d8">8.0</data>
      <data key="d9">Beverages can be modified in viscosity using thickeners to ensure safe consumption for individuals with dysphagia.</data>
      <data key="d10">c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">5e38f73a7a2949e49ede2d9531166363</data>
      <data key="d12">5063</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPESANTES" target="PROPIEDADES INTR&#205;NSECAS">
      <data key="d8">6.0</data>
      <data key="d9">The intrinsic properties of thickeners can significantly affect the consistency and effectiveness of thickened liquids.</data>
      <data key="d10">c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">071532e7261f4c9b8c78f13637f43591</data>
      <data key="d12">5064</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPESANTES" target="RE&#211;METROS">
      <data key="d8">7.0</data>
      <data key="d9">Rheometers are used to measure the viscosity of thickeners, ensuring they are suitable for individuals with dysphagia.</data>
