      <data key="d6">11088</data>
      <data key="d7">0e83b46047e6487d816c73ece393aedd</data>
    </node>
    <node id="LINFANGIOLEIOMATOSIS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Lymphangioleiomyomatosis is a rare lung disease that can cause chylothorax and may be associated with ascitic conditions.</data>
      <data key="d2">c77caafffd9b5d42c51cb2359ad9cc6d</data>
