      <data key="d8">8.0</data>
      <data key="d9">Nutritional support is critical for newborns who cannot feed normally, especially in the first days of life</data>
      <data key="d10">103ae80b955f35401aca706444999b29</data>
      <data key="d11">60c294bad5064eb48147391a2351724c</data>
      <data key="d12">4701</data>
