    <node id="NUTRICI&#211;N CL&#205;NICA Y DIETOTERAPIA">
      <data key="d0">EVENT</data>
      <data key="d1">Nutrition Clinical and Dietotherapy refers to the practices and protocols developed for nutritional care in clinical settings at Hospital La Fe.</data>
      <data key="d2">ee3a1b87e74846f0f84c404a07717ebc</data>
