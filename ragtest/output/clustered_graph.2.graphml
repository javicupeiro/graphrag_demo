    <node id="ALIMENTACI&#211;N G&#193;STRICA INTERMITENTE">
      <data key="d0">EVENT</data>
      <data key="d1">La alimentaci&#243;n g&#225;strica intermitente es una t&#233;cnica de administraci&#243;n de f&#243;rmulas enterales en forma de bolo, facilitando la transici&#243;n a la ingesta oral.</data>
      <data key="d2">e569eda9506ef1e77080a8120e388963</data>
