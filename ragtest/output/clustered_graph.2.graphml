      <data key="d7">f45389dccf6d4746989a89bb333b66e9</data>
    </node>
    <node id="S&#205;NDROME DE DOWN">
      <data key="d0">PERSON</data>
      <data key="d1">Trastorno gen&#233;tico que puede estar asociado a un mayor riesgo de enfermedad cel&#237;aca.</data>
