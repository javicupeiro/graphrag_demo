    <edge source="NUTRICI&#211;N ARTIFICIAL" target="ESPEN GUIDELINES">
      <data key="d8">1.0</data>
      <data key="d9">The ESPEN Guidelines provide recommendations for the use of artificial nutrition in clinical settings, including short bowel syndrome.</data>
      <data key="d10">6dfb109dac53e054fd015f6d8adf48ac</data>
      <data key="d11">0daada11212849909569cef54369242a</data>
