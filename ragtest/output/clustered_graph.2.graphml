    </node>
    <node id="WHO/ECOG SCALE">
      <data key="d0">EVENT</data>
      <data key="d1">The WHO/ECOG scale is a tool used to measure physical activity levels in patients, ranging from normal activity to being bedridden.</data>
      <data key="d2">11cbdce47eee11a80ab609f3b786bcc1</data>
