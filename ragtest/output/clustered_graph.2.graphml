    </edge>
    <edge source="F&#211;RMULAS POLIM&#201;RICAS" target="DENSIDAD CAL&#211;RICA">
      <data key="d8">5.0</data>
      <data key="d9">Las f&#243;rmulas polim&#233;ricas pueden clasificarse seg&#250;n su densidad cal&#243;rica</data>
      <data key="d10">0a844e2dc679c0578ba4bdeda742c2eb</data>
      <data key="d11">c37c26b313a94f338ea3f703cda0f11f</data>
      <data key="d12">10035</data>
      <data key="d13">2</data>
    </edge>
    <edge source="F&#211;RMULAS POLIM&#201;RICAS" target="OSMOLALIDAD">
      <data key="d8">7.0</data>
      <data key="d9">La osmolalidad de las f&#243;rmulas polim&#233;ricas se encuentra en torno a 350 mOsm/kg</data>
