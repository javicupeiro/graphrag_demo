    </edge>
    <edge source="PROTE&#205;NAS" target="DIABETES MELLITUS TYPE 1">
      <data key="d8">6.0</data>
      <data key="d9">Protein intake recommendations are relevant for athletes with Diabetes Mellitus Type 1 to support their physical performance.</data>
      <data key="d10">043ed163c427b880fe39884076cae7ea</data>
      <data key="d11">cede597f8c4246dcac6ef77872048fda</data>
      <data key="d12">7439</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NAS" target="DIABETES MELLITUS TYPE 2">
      <data key="d8">6.0</data>
      <data key="d9">Protein intake is important for athletes with Diabetes Mellitus Type 2 to enhance their performance and manage their condition.</data>
      <data key="d10">043ed163c427b880fe39884076cae7ea</data>
      <data key="d11">c0283204a5e14dbb9bb8c94b7dd34f98</data>
      <data key="d12">7440</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NAS" target="INSUFICIENCIA RENAL AGUDA">
      <data key="d8">8.0</data>
      <data key="d9">Protein intake must be carefully managed in patients with acute renal failure to prevent malnutrition</data>
      <data key="d10">532561f62a972376f3f898b265623fc0</data>
      <data key="d11">323f21c28c6744deb328f84656854ff4</data>
      <data key="d12">7441</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NAS" target="AMINO&#193;CIDOS ESENCIALES">
      <data key="d8">1.0</data>
      <data key="d9">Essential amino acids may be used to supplement low protein diets in renal patients</data>
      <data key="d10">532561f62a972376f3f898b265623fc0</data>
      <data key="d11">1ddda0f694ce45f3acb88ec57f0c38e4</data>
      <data key="d12">7442</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NAS" target="PACIENTES CIRR&#211;TICOS">
      <data key="d8">1.0</data>
      <data key="d9">Protein intake must be carefully managed in patients with cirrhosis to prevent worsening their condition</data>
      <data key="d10">3437d6cdf014282ec447fc7f4de92cab</data>
      <data key="d11">39a56c0aa4e44b23a3ec948c6534253d</data>
      <data key="d12">7443</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NAS" target="CEREAL">
      <data key="d8">7.0</data>
      <data key="d9">Cereals contain proteins that are essential for bodily functions and growth.</data>
      <data key="d10">281c46dd2bcde6e6fbb1505ed667b0e9</data>
      <data key="d11">cbc8c483ec4c417c8e23b58df48d2540</data>
