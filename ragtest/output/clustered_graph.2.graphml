    <node id="ENFERMOS GERI&#193;TRICOS">
      <data key="d0">PERSON</data>
      <data key="d1">Los enfermos geri&#225;tricos son pacientes de edad avanzada que requieren atenci&#243;n m&#233;dica especializada debido a m&#250;ltiples condiciones de salud y a menudo enfrentan problemas de nutrici&#243;n.</data>
      <data key="d2">54f3b76c0240696aa63ae60ad52b82b6</data>
