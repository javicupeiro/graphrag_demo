    <node id="FLATULENCIA">
      <data key="d0">EVENT</data>
      <data key="d1">Flatulencia is another gastrointestinal symptom that can occur due to malabsorci&#243;n de fructosa, leading to discomfort.</data>
      <data key="d2">033a22e7215395479d0775d6a1a2563e</data>
      <data key="d3">862</data>
      <data key="d4">2</data>
