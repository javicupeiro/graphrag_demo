      <data key="d5">1</data>
      <data key="d6">16073</data>
      <data key="d7">acbd7768c9ce42fa925001fecf54c616</data>
    </node>
    <node id="SISTEMA APPCC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">El Sistema APPCC (An&#225;lisis de Peligros y Puntos de Control Cr&#237;ticos) es un enfoque sistem&#225;tico para la seguridad alimentaria que identifica y controla peligros en la producci&#243;n de alimentos.)&lt;|COMPLETE|&gt;</data>
      <data key="d2">5bda98c244ed300cfc07192e54c7eb88</data>
      <data key="d5">0</data>
      <data key="d6">16074</data>
      <data key="d7">1e3ded097fdc4dcebe57ada58eb49177</data>
    </node>
    <node id="ISO 9001">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">ISO 9001 is a certification that ensures a product, process, or service meets specified requirements.</data>
      <data key="d2">440978f75b135fa97eb7b99ca379e9a4</data>
      <data key="d3">1247</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16075</data>
      <data key="d7">4bd0e853e41144b296eb114e13550eab</data>
    </node>
    <node id="ISO 14001">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">ISO 14001 is a certification that specifies requirements for an effective environmental management system.</data>
      <data key="d2">440978f75b135fa97eb7b99ca379e9a4</data>
      <data key="d3">1247</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16076</data>
      <data key="d7">dff5c30f28c14ab3823a3f48e20d716f</data>
    </node>
    <node id="BRC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">BRC (British Retail Consortium) is a certification that ensures the safety, quality, and operational criteria of food manufacturers.</data>
      <data key="d2">440978f75b135fa97eb7b99ca379e9a4</data>
      <data key="d3">1247</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16077</data>
      <data key="d7">4c985420deec42d98ad4c5cc9fd4a232</data>
    </node>
    <node id="IFS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">IFS (International Featured Standards) is a certification that ensures the safety and quality of products in the food industry.</data>
      <data key="d2">440978f75b135fa97eb7b99ca379e9a4</data>
      <data key="d3">1247</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16078</data>
      <data key="d7">0e0fb6503e6b4ee385d3d38ec40c6160</data>
    </node>
    <node id="HALAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Halal certification ensures that products meet Islamic dietary laws.</data>
      <data key="d2">440978f75b135fa97eb7b99ca379e9a4</data>
      <data key="d3">1247</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16079</data>
      <data key="d7">34872616457f49689959fdcdc7bf84d3</data>
    </node>
    <node id="KOSHER">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Kosher certification ensures that food products comply with Jewish dietary laws.</data>
      <data key="d2">440978f75b135fa97eb7b99ca379e9a4</data>
      <data key="d3">1247</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16080</data>
      <data key="d7">ac89e8b74a564363826ce763ccb2ce9a</data>
    </node>
    <node id="NUTRITIONAL PRODUCTS">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional products are specifically developed to ensure the quality and adequacy of their ingredients for clinical nutrition. They encompass a diverse range of items aimed at supporting health and meeting dietary requirements. Notably, these products include offerings from well-known manufacturers such as Abbott and Fresenius Kabi, highlighting the industry's commitment to providing effective nutritional solutions.</data>
      <data key="d2">440978f75b135fa97eb7b99ca379e9a4,77c2b5963fab84c30e6eb596b49336bf</data>
      <data key="d3">1247</data>
      <data key="d4">2</data>
      <data key="d5">19</data>
      <data key="d6">16081</data>
      <data key="d7">590c44b97d1244ea8241928fc0666341</data>
    </node>
    <node id="MINERALS AND VITAMINS">
      <data key="d0">EVENT</data>
      <data key="d1">Minerals and vitamins are regulated and their amounts may vary based on the intended use of the nutritional product.</data>
      <data key="d2">440978f75b135fa97eb7b99ca379e9a4</data>
      <data key="d3">1247</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
