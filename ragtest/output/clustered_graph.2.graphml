    </node>
    <node id="MODIFIED MANN ASSESSMENT OF SWALLOWING">
      <data key="d0">EVENT</data>
      <data key="d1">The Modified Mann Assessment of Swallowing is a screening tool used to identify patients with dysphagia and refer them for further evaluation.</data>
      <data key="d2">6716f78f148d9f4f2a622919eee02554</data>
