    </node>
    <node id="ATB">
      <data key="d0">EVENT</data>
      <data key="d1">ATB refers to antibiotics, which may be administered to patients with acute pancreatitis to prevent or treat infections.</data>
      <data key="d2">6a12bee5b54e4c1706548bca972516e3</data>
