      <data key="d5">1</data>
      <data key="d6">6172</data>
      <data key="d7">b80ae43cb7934b90b80edabca612fb10</data>
    </node>
    <node id="H&#193;BITOS DE VIDA">
      <data key="d0">EVENT</data>
      <data key="d1">Lifestyle habits refer to the daily behaviors and practices that can affect health, including diet and exercise.</data>
      <data key="d2">3f46d79bcfab2143f045659e11be171b</data>
