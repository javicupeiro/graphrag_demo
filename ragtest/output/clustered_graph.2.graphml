    </node>
    <node id="SARCOMAS">
      <data key="d0">EVENT</data>
      <data key="d1">Sarcomas are a group of cancers that arise in connective tissues and can cause weight loss.</data>
      <data key="d2">b26b998479da515c234ce46b1bfa73db</data>
      <data key="d3">1316</data>
