      <data key="d6">1971</data>
      <data key="d7">46f75ce40fa7412b96c6d572ee53641e</data>
    </node>
    <node id="ALANINE">
      <data key="d0">EVENT</data>
      <data key="d1">Alanine is an amino acid that plays a significant role in glucose metabolism and energy production. It can accumulate in metabolic disorders, indicating its importance in various physiological processes. Additionally, alanine is often enriched in formulations designed for specific clinical situations, highlighting its utility in medical and nutritional applications.</data>
      <data key="d2">7754f367b453475179218cac4bc24de1,cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d3">1230</data>
