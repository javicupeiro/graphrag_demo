    <edge source="VON HIPPEL-LINDAU" target="VHL">
      <data key="d8">8.0</data>
      <data key="d9">The VHL gene is associated with Von Hippel-Lindau syndrome, which includes pheochromocytomas as a common manifestation</data>
      <data key="d10">c3d752ff301355241e1420e398f0e6a4</data>
