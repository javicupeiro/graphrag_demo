    <node id="CABOZANTINIB">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Cabozantinib is a tyrosine kinase inhibitor that has shown benefits in patients with progressive medullary thyroid carcinoma.</data>
      <data key="d2">53eefebd95b547fa56967d97b31beec1</data>
