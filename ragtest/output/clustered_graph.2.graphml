    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="C&#193;NCER DE ES&#211;FAGO">
      <data key="d8">9.0</data>
      <data key="d9">La p&#233;rdida de peso es un s&#237;ntoma frecuente en pacientes diagnosticados con c&#225;ncer de es&#243;fago.</data>
