    </edge>
    <edge source="NUTRICI&#211;N ARTIFICIAL" target="CAQUEXIA TUMORAL">
      <data key="d8">5.0</data>
      <data key="d9">La caquexia tumoral presenta desaf&#237;os en la efectividad de la nutrici&#243;n artificial en pacientes oncol&#243;gicos</data>
