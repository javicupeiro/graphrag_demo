    <node id="NUTRITIONAL STATE">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional state refers to the condition of the body in relation to the intake and utilization of nutrients, which can be affected by various health conditions, including liver diseases.</data>
      <data key="d2">e2f9ec03a9b71e608bdd14455b0595a6</data>
