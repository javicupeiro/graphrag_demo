      <data key="d11">f5cbb4b734774056bf2907ef0282fede</data>
      <data key="d12">18872</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AASLD" target="WILSON'S DISEASE">
      <data key="d8">1.0</data>
