    <edge source="TYPE 1 DIABETES GENETICS CONSORTIUM" target="AIRE GENE">
      <data key="d8">7.0</data>
      <data key="d9">The AIRE gene is studied by the Type 1 Diabetes Genetics Consortium for its role in autoimmune diabetes</data>
