    </edge>
    <edge source="QUIMIOTERAPIA" target="PACIENTE">
      <data key="d8">8.0</data>
      <data key="d9">The patient underwent chemotherapy as part of their cancer treatment, which led to various side effects</data>
      <data key="d10">da58ef987e74d508eb95395230f21cdc</data>
      <data key="d11">77b4bcebc37a4b88bfbf6675b05f146f</data>
