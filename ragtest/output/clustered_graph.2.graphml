    <node id="SENPE-SEDOM">
      <data key="d0" />
      <data key="d1">SENPE-SEDOM is an organization that provides criteria for coding hospital malnutrition.</data>
      <data key="d2">14039baea6555ffc156768e503ff0b90,17444b83ec19bdcc65ff0722869e7b4b</data>
      <data key="d3">684</data>
