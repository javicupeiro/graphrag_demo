    <node id="ALIMENTOS SEGUROS">
      <data key="d0">EVENT</data>
      <data key="d1">The safe foods provided by the Servicio de Cocina Hospitalaria for the evaluation of dysphagia include yogurt and custard.</data>
      <data key="d2">1fad843d053b1ec4805a4e7c6be9ceb3</data>
      <data key="d3">1131</data>
