    </node>
    <node id="PROTE&#205;NA GS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">La prote&#237;na GS es una prote&#237;na que puede mutar en algunos tumores hipofisarios, afectando su comportamiento y secreci&#243;n hormonal.</data>
      <data key="d2">b18ef5c018c100e1582224fe82f03626</data>
      <data key="d3">1321</data>
      <data key="d4">2</data>
