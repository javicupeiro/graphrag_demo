    </edge>
    <edge source="DIABETES MELLITUS TIPO 2" target="ESTILO DE VIDA">
      <data key="d8">9.0</data>
      <data key="d9">Lifestyle changes are essential for the management of diabetes mellitus tipo 2</data>
      <data key="d10">1f2b31f5a0bba00ecee5e3a8fb2c83ea</data>
      <data key="d11">1239751372a74a28862b61127776ec74</data>
      <data key="d12">13255</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TIPO 2" target="HIPERURICEMIA">
      <data key="d8">5.0</data>
      <data key="d9">La diabetes mellitus tipo 2 puede estar relacionada con la hiperuricemia, ya que ambas condiciones pueden coexistir en pacientes con alto riesgo cardiovascular.</data>
      <data key="d10">12c1878563254283012703d4f20ff4a9</data>
      <data key="d11">27a004bd046f4b44b0dc1eb12ab51ecd</data>
      <data key="d12">13256</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSULIN RESISTANCE" target="KLINEFELTER SYNDROME">
      <data key="d8">6.0</data>
      <data key="d9">Insulin resistance is a common condition in patients with Klinefelter syndrome</data>
      <data key="d10">5509bb6959e4faa5989289c1ddbcc96b</data>
      <data key="d11">2a431c7153a644b280fb8b67dd812aab</data>
      <data key="d12">13257</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSULIN RESISTANCE" target="POLYCYSTIC OVARY SYNDROME">
      <data key="d8">7.0</data>
      <data key="d9">Patients with Polycystic Ovary Syndrome often exhibit insulin resistance, linking the two conditions closely.</data>
      <data key="d10">dda58e50ce4bb9fa40e3c61e40e1b9c7</data>
      <data key="d11">71c21c8bdbbf4f829d913a5a28640de1</data>
      <data key="d12">13258</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSULIN RESISTANCE" target="METABOLIC SYNDROME">
      <data key="d8">8.0</data>
      <data key="d9">Insulin resistance is a key component of metabolic syndrome</data>
      <data key="d10">ea920d08266b329db73fb7b804bbb9ce</data>
      <data key="d11">ce2099518ac642c68d888c588d02bbf0</data>
      <data key="d12">13259</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSULIN RESISTANCE" target="CRITICAL PATIENT">
      <data key="d8">7.0</data>
      <data key="d9">Insulin resistance is commonly observed in critical patients, complicating their metabolic management</data>
      <data key="d10">723cbca2d5cfbf8cf05a923c52569641</data>
      <data key="d11">685523a0c33c4106aba549bc37f62a5c</data>
      <data key="d12">13260</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="GLYCOGEN STORAGE DISEASE TYPE I">
      <data key="d8">8.0</data>
      <data key="d9">Glycogen Storage Disease Type I affects gluconeogenesis due to enzyme deficiencies that disrupt glucose release</data>
      <data key="d10">704cfd179507a977ecc0691a5bd2861e</data>
      <data key="d11">8d906be3c23048deb0b646688b831b63</data>
      <data key="d12">13261</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="GSDIII">
      <data key="d8">8.0</data>
      <data key="d9">Gluconeogenesis helps to compensate for the decreased glucose release due to impaired glycogenolysis in GSDIII</data>
      <data key="d10">b5e899a3def3da339630eb0d2bfe4af8</data>
      <data key="d11">5d88b501ffad405d804d8a376c433640</data>
      <data key="d12">13262</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="LIVER">
      <data key="d8">9.0</data>
      <data key="d9">Gluconeogenesis primarily occurs in the liver, making it the main organ responsible for this metabolic pathway.</data>
      <data key="d10">fb8d31ef68f83e6b01f6fc8548f36d0c</data>
      <data key="d11">a784add1e05c4794bdacf7d41322c13c</data>
      <data key="d12">13263</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="KREBS CYCLE">
      <data key="d8">7.0</data>
      <data key="d9">Gluconeogenesis utilizes intermediates from the Krebs cycle to synthesize glucose, linking these two metabolic processes.</data>
      <data key="d10">fb8d31ef68f83e6b01f6fc8548f36d0c</data>
      <data key="d11">1d77bf314d514c09b6a196c683ec61bb</data>
      <data key="d12">13264</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="KIDNEYS">
      <data key="d8">5.0</data>
      <data key="d9">The kidneys contribute to gluconeogenesis, although to a lesser extent than the liver, indicating a supportive role in glucose production.</data>
      <data key="d10">fb8d31ef68f83e6b01f6fc8548f36d0c</data>
      <data key="d11">4a901201fc0f4ee9a68d3aeddb5dc85a</data>
      <data key="d12">13265</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="INTESTINE">
      <data key="d8">1.0</data>
      <data key="d9">The intestine plays a role in gluconeogenesis, contributing to the overall glucose production in the body.</data>
      <data key="d10">fb8d31ef68f83e6b01f6fc8548f36d0c</data>
      <data key="d11">d3cedd50210b4e039063155a81910afa</data>
      <data key="d12">13266</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="FRUCTOSE-1,6-BISPHOSPHATASE">
      <data key="d8">8.0</data>
      <data key="d9">Fructose-1,6-bisphosphatase is a key enzyme in the gluconeogenesis pathway, directly influencing glucose synthesis.</data>
      <data key="d10">fb8d31ef68f83e6b01f6fc8548f36d0c</data>
      <data key="d11">3925aa954443453488349fda981cd7bb</data>
      <data key="d12">13267</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="PYRUVATE CARBOXYLASE">
      <data key="d8">8.0</data>
      <data key="d9">Pyruvate carboxylase is crucial for gluconeogenesis as it converts pyruvate to oxaloacetate, a necessary step in glucose production.</data>
      <data key="d10">fb8d31ef68f83e6b01f6fc8548f36d0c</data>
      <data key="d11">cad0bc08508744d5bcfecc8c555657ca</data>
      <data key="d12">13268</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="GLYCERALDEHYDE-3-PHOSPHATE">
      <data key="d8">7.0</data>
      <data key="d9">Glyceraldehyde-3-phosphate is an intermediate in gluconeogenesis, linking it to the overall glucose synthesis process.</data>
      <data key="d10">fb8d31ef68f83e6b01f6fc8548f36d0c</data>
      <data key="d11">083fb02e51be40649eb686af91ab076c</data>
      <data key="d12">13269</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="LACTATE">
      <data key="d8">1.0</data>
      <data key="d9">Lactate can be converted back to glucose through gluconeogenesis, demonstrating its role in glucose metabolism.</data>
      <data key="d10">fb8d31ef68f83e6b01f6fc8548f36d0c</data>
      <data key="d11">cac4aab11032423e91af7e66869d241d</data>
      <data key="d12">13270</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOGENESIS" target="FRUCTOSA-1,6-BIFOSFATASA">
      <data key="d8">9.0</data>
      <data key="d9">Fructosa-1,6-bifosfatas is a key enzyme in the gluconeogenesis pathway, and its deficiency directly impacts this metabolic process.</data>
      <data key="d10">449046c83c1432d2b8cc6cacb5eadf51</data>
      <data key="d11">d4f5451efc794aae8c975245de250ff4</data>
      <data key="d12">13271</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#218;SCULO" target="GLUC&#211;GENO">
      <data key="d8">8.0</data>
