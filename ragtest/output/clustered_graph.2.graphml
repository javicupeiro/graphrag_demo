    <node id="STAPHILOCOCO COAGULASA NEGATIVO">
      <data key="d0">PERSON</data>
      <data key="d1">Staphylococcus coagulase-negative is a type of bacteria frequently associated with infections in patients with CVC.</data>
      <data key="d2">5ad53a3f16964261ae37b64f7c3cb688</data>
      <data key="d3">767</data>
