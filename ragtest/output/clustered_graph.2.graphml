    <edge source="PREDIMED STUDY" target="DIETARY FAT INTAKE STUDY">
      <data key="d8">1.0</data>
      <data key="d9">The study on dietary fat intake is relevant to the findings of the PREDIMED Study regarding cardiovascular health</data>
      <data key="d10">8778654a17a48b8ea7b1cec378d52346</data>
      <data key="d11">01423b9c611f47f9be9872b95025f0bd</data>
      <data key="d12">16823</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PREDIMED STUDY" target="MART&#205;NEZ-GONZ&#193;LEZ MA">
      <data key="d8">8.0</data>
      <data key="d9">Mart&#237;nez-Gonz&#225;lez MA is a key researcher in the PREDIMED Study, which investigates the Mediterranean Diet</data>
      <data key="d10">ea8be3e3b3d7195ddc85512be460b6f8</data>
      <data key="d11">53a6f0762ceb4c678a4c44fe5018ef4d</data>
      <data key="d12">16824</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BEYOND AGEING PROJECT" target="COMPLEJO HOSPITALARIO UNIVERSITARIO DE FERROL">
      <data key="d8">1.0</data>
      <data key="d9">The Beyond Ageing Project is a clinical trial that may involve professionals from Complejo Hospitalario Universitario de Ferrol</data>
      <data key="d10">70e4538100be270d06e7a3cdc254ba28</data>
      <data key="d11">1cef5a1796804ecabc5174bcb50eeca2</data>
      <data key="d12">16825</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL LABELING" target="GLUTEN">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional labeling includes information about gluten content, which is essential for consumers with gluten sensitivities</data>
      <data key="d10">dfb6e1826ded0b8ca7cf3304d1b75d1a</data>
      <data key="d11">261cf8d9dc4a49038bf95517e6a86bfe</data>
      <data key="d12">16826</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ETIQUETADO NUTRICIONAL" target="REGLAMENTO (UE) N&#186; 1169/2011">
      <data key="d8">9.0</data>
      <data key="d9">Nutritional labeling is governed by Regulation (EU) No 1169/2011, which outlines mandatory information</data>
      <data key="d10">b003f8a156374bb4430475f4ffe8e074</data>
      <data key="d11">d10dc9323a564ba8bc0e0ec2490e5753</data>
      <data key="d12">16827</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ETIQUETADO NUTRICIONAL" target="ALIMENTOS ENVASADOS">
      <data key="d8">8.0</data>
      <data key="d9">Packaged foods must comply with nutritional labeling requirements to inform consumers</data>
      <data key="d10">b003f8a156374bb4430475f4ffe8e074</data>
      <data key="d11">e4595dfd4ad64f98b3d666c4638c8435</data>
      <data key="d12">16828</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ETIQUETADO NUTRICIONAL" target="NUEVA NORMATIVA">
      <data key="d8">7.0</data>
      <data key="d9">The new regulation has improved nutritional labeling practices to enhance consumer understanding</data>
      <data key="d10">e0102bb655b6476ce3296726e3aceb4a</data>
      <data key="d11">6ed49c4d51764d2d9faa9eb42083708d</data>
      <data key="d12">16829</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLAMENTO (UE) N&#186; 1169/2011" target="REGLAMENTO (UE) N&#186; 1924/2006">
      <data key="d8">6.0</data>
      <data key="d9">El Reglamento (UE) N&#186; 1169/2011 complementa el Reglamento (UE) N&#186; 1924/2006 al regular la informaci&#243;n que se debe proporcionar al consumidor sobre los alimentos.</data>
      <data key="d10">5bda98c244ed300cfc07192e54c7eb88</data>
      <data key="d11">f71cba9a2154466ea97d41c0080edd31</data>
      <data key="d12">16830</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRODUCTOS ALIMENTARIOS" target="ETIQUETADO">
      <data key="d8">1.0</data>
      <data key="d9">Food products must have labeling to provide consumers with necessary information about their nutritional content</data>
      <data key="d10">b003f8a156374bb4430475f4ffe8e074</data>
      <data key="d11">8a0c905fdbb5403e9d6f4cfea51c9db6</data>
      <data key="d12">16831</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ETIQUETADO" target="PRODUCTOS COMERCIALES">
      <data key="d8">7.0</data>
      <data key="d9">El etiquetado de los productos comerciales debe incluir informaci&#243;n sobre su composici&#243;n y duraci&#243;n de uso</data>
      <data key="d10">3926ed628d3d5919b8a65e44fffbc3b9</data>
      <data key="d11">bbcc838e6cdc4de2874b6f5cfb99c9f6</data>
      <data key="d12">16832</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ETIQUETADO" target="REGLAMENTO (UE) 1169/2011">
      <data key="d8">9.0</data>
      <data key="d9">Reglamento (UE) 1169/2011 governs the labeling requirements for food products, including the necessity to display the minimum durability date</data>
      <data key="d10">4196233cbb95a9ab194177cc11875e7a</data>
      <data key="d11">fc833ee75ba24e95a3c56393ae55b2d3</data>
      <data key="d12">16833</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ETIQUETADO" target="PRODUCTO">
      <data key="d8">7.0</data>
      <data key="d9">The product must have an appropriate label that includes essential information such as the minimum durability date</data>
      <data key="d10">4196233cbb95a9ab194177cc11875e7a</data>
      <data key="d11">ffe43c02e380481fa63b1f01535c2795</data>
      <data key="d12">16834</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMPRESA ALIMENTARIA" target="PRODUCTOS ALIMENTICIOS">
      <data key="d8">8.0</data>
      <data key="d9">La empresa alimentaria es responsable de la producci&#243;n y etiquetado de productos alimenticios, asegurando que cumplan con las regulaciones.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">838dab9ae6004d869378160c1037f883</data>
      <data key="d12">16835</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CONSUMIDORES" target="PRODUCTOS ALIMENTICIOS">
      <data key="d8">9.0</data>
      <data key="d9">Los consumidores tienen derecho a recibir informaci&#243;n sobre los productos alimenticios que compran, incluyendo ingredientes y al&#233;rgenos.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">b2aa651e512c4f49b64960674d9fa00a</data>
      <data key="d12">16836</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRODUCTOS ALIMENTICIOS" target="VINAGRES DE FERMENTACI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">Los vinagres de fermentaci&#243;n son un tipo de producto alimenticio que debe ser etiquetado seg&#250;n las regulaciones de la UE.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">c8929d0622e645febd571b127ae6ce5b</data>
      <data key="d12">16837</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRODUCTOS ALIMENTICIOS" target="MANTEQUILLA">
      <data key="d8">8.0</data>
      <data key="d9">La mantequilla es un producto alimenticio que requiere etiquetado claro sobre sus ingredientes y posibles al&#233;rgenos.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">4820022cdd4d4555bef6e4d59b020531</data>
      <data key="d12">16838</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRODUCTOS ALIMENTICIOS" target="NATA FERMENTADA">
      <data key="d8">6.0</data>
      <data key="d9">La nata fermentada es un producto alimenticio que debe cumplir con las regulaciones de etiquetado de la Uni&#243;n Europea.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">841e8e68f99c444d87d31beb820d751f</data>
      <data key="d12">16839</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRODUCTOS ALIMENTICIOS" target="ORGANISMOS MODIFICADOS GEN&#201;TICAMENTE">
      <data key="d8">9.0</data>
      <data key="d9">Los OMG deben ser claramente indicados en las etiquetas de los productos alimenticios si su presencia supera el 0,5%.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">6cddeaad81db49c4bafbdfdd98477e5f</data>
      <data key="d12">16840</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRODUCTOS ALIMENTICIOS" target="FECHAS DE DURACI&#211;N/CADUCIDAD">
      <data key="d8">9.0</data>
      <data key="d9">Las fechas de duraci&#243;n y caducidad son informaci&#243;n cr&#237;tica que debe aparecer en el etiquetado de productos alimenticios.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">c49e1ff99e0147dd8d018813c5ba9b11</data>
      <data key="d12">16841</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRODUCTOS ALIMENTICIOS" target="CANTIDAD NETA">
      <data key="d8">8.0</data>
      <data key="d9">La cantidad neta es la medida del contenido de un producto alimenticio que debe ser claramente indicada en su etiquetado.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">b03d784215644a4984530ddd394cd22f</data>
      <data key="d12">16842</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRODUCTOS ALIMENTICIOS" target="INFORMACI&#211;N NUTRICIONAL">
      <data key="d8">9.0</data>
      <data key="d9">La informaci&#243;n nutricional es un requisito de etiquetado que proporciona datos sobre el valor energ&#233;tico y la composici&#243;n de los productos alimenticios.</data>
      <data key="d10">8255943be503f6709a8e63d7d33b79d1</data>
      <data key="d11">e5da3e2e75174304bb57228ee2f51970</data>
      <data key="d12">16843</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANTEQUILLA" target="DESAYUNO">
      <data key="d8">7.0</data>
      <data key="d9">Mantequilla is often used as a spread on pan during desayuno</data>
      <data key="d10">4b19145e0977ee48b7132c9915d8c284</data>
      <data key="d11">da5d15f5202f41fe938b204dd1798d61</data>
      <data key="d12">16844</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANTEQUILLA" target="LACTOSA">
      <data key="d8">7.0</data>
      <data key="d9">MANTEQUILLA, commonly known as butter, is often associated with lactose content. However, there is a notable distinction regarding its suitability for individuals with lactose intolerance. While it is true that butter contains lactose, the process of making MANTEQUILLA involves the separation of its components, which results in a product that typically contains very low levels of lactose. This makes MANTEQUILLA generally acceptable for many people with lactose intolerance. In contrast, LACTOSA, or lactose, is a sugar found in milk and dairy products that can cause discomfort for those who are intolerant. Therefore, while MANTEQUILLA may contain trace amounts of LACTOSA, it is often considered safe for consumption by individuals who are lactose intolerant due to the minimal lactose content resulting from its production process.</data>
      <data key="d10">527c3c962d22018377b32c52e984d4e1,a562e90891c11da0293bc7de511acc8f</data>
      <data key="d11">7080bf68141348fdad8abe69a01d21ea</data>
      <data key="d12">16845</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANTEQUILLA" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">6.0</data>
      <data key="d9">Butter should be consumed occasionally and in moderation according to dietary guidelines</data>
      <data key="d10">61b84039de5ac2d9e25890c3b8f4f87a</data>
      <data key="d11">3ebbacb140ea431f9dca9ee5e168642e</data>
      <data key="d12">16846</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="GALLETAS MARIA">
      <data key="d8">7.0</data>
      <data key="d9">Las Galletas Maria deben cumplir con las normas establecidas en el Reglamento 1169/2011 sobre etiquetado y presentaci&#243;n de informaci&#243;n nutricional.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">b3a4370f306d44c08fd29858f5787e3d</data>
      <data key="d12">16847</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="BARES">
      <data key="d8">6.0</data>
      <data key="d9">Los bares deben seguir las regulaciones del Reglamento 1169/2011 para informar sobre los alimentos que sirven.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">6a2350f5fed94624a1e97cab260843ad</data>
      <data key="d12">16848</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="RESTAURANTES">
      <data key="d8">6.0</data>
      <data key="d9">Los restaurantes est&#225;n obligados a cumplir con el Reglamento 1169/2011 en cuanto a la informaci&#243;n alimentaria.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">76c13590273440a6853cf32766ddb3d3</data>
      <data key="d12">16849</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="COLEGIOS">
      <data key="d8">6.0</data>
      <data key="d9">Los colegios deben cumplir con el Reglamento 1169/2011 al informar sobre los alimentos ofrecidos a los estudiantes.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">8cfcdf8e25ab4c83985cd8f416778eb7</data>
      <data key="d12">16850</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="HORTALIZAS">
      <data key="d8">5.0</data>
      <data key="d9">Las hortalizas deben ser etiquetadas de acuerdo con el Reglamento 1169/2011 para informar sobre al&#233;rgenos.</data>
