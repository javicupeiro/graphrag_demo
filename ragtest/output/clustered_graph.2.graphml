      <data key="d12">4847</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="PARAMETROS CL&#205;NICOS">
      <data key="d8">8.0</data>
      <data key="d9">Clinical parameters are vital for assessing the health of patients on parenteral nutrition</data>
      <data key="d10">2bd5549759c6a0d8393bb93fdccb747b</data>
      <data key="d11">73afa020a34647168484b65c029a18e7</data>
      <data key="d12">4848</data>
