    <node id="ATRIAL FIBRILLATION">
      <data key="d0">EVENT</data>
      <data key="d1">Atrial fibrillation (AF) is a common heart condition that can lead to serious complications, including stroke.</data>
      <data key="d2">ea79efb65695c260a301f5c42237e2cb</data>
