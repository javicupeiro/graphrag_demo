      <data key="d5">1</data>
      <data key="d6">13265</data>
      <data key="d7">bed179c1c18848d1a6b555a530bfc846</data>
    </node>
    <node id="OMEGA-3">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Omega-3 refers to a group of polyunsaturated fatty acids that are important for human health, particularly in relation to cognitive function and inflammation.</data>
      <data key="d2">b3760fcb9c0421b66d37c20b1dc68577,eadd983c9f28c11a1c279e4b923351cd</data>
      <data key="d3">1658</data>
