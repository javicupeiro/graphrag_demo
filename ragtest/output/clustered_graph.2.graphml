    <node id="MINISTERIO DE SANIDAD, POL&#205;TICA SOCIAL E IGUALDAD">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Ministry of Health, Social Policy and Equality is a governmental organization in Spain responsible for public health and social policies.</data>
      <data key="d2">89ca65c4bdc30027c9c9ed1e1b442939</data>
