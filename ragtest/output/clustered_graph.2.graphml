    <node id="BURNED PATIENTS">
      <data key="d0">PERSON</data>
      <data key="d1">BURNED PATIENTS are individuals who have suffered burns and require specialized nutritional support due to their unique metabolic needs. This specialized care is essential to aid in their recovery and to address the specific challenges posed by their injuries.</data>
      <data key="d2">3534154ea7562c7d4abe51bf29546109,396dda5c9597828f0749f963f42142b4</data>
      <data key="d3">259</data>
