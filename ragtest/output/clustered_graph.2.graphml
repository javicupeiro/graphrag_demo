      <data key="d7">7d0e0989f78a440e8f75df40c98c73b7</data>
    </node>
    <node id="OBESITY PARADOX">
      <data key="d0">EVENT</data>
      <data key="d1">The obesity paradox refers to the phenomenon where obesity may be associated with better outcomes in certain diseases, including EPOC, despite the general health risks of being overweight.</data>
      <data key="d2">cc406ffdbe4f62a6f2d9763ee4888fdf</data>
      <data key="d3">1037</data>
      <data key="d4">2</data>
