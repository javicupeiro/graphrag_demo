      <data key="d7">8c9d248d66cf48f2ba80da0c7752ee3d</data>
    </node>
    <node id="MET&#193;STASIS A DISTANCIA">
      <data key="d0">EVENT</data>
      <data key="d1">Distant metastasis refers to the spread of cancer cells from the original tumor site to other parts of the body, which can complicate treatment in patients with CVC.</data>
