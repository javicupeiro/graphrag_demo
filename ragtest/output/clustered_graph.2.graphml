    </node>
    <node id="SOBRECARGA ORAL DE GLUCOSA">
      <data key="d0">EVENT</data>
      <data key="d1">SOBRECARGA ORAL DE GLUCOSA (SOG) is a test used to diagnose diabetes, including gestational diabetes, by measuring blood glucose levels after consuming glucose.</data>
      <data key="d2">6a2d5ced0ad16871fec539845797e0ac</data>
