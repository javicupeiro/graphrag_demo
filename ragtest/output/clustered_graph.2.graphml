    <node id="C&#193;NCER DE PIEL">
      <data key="d0">EVENT</data>
      <data key="d1">C&#225;ncer de piel is a type of skin cancer that may be influenced by the intake of omega-3 fatty acids.</data>
      <data key="d2">11c3cb37b1a2c111ceb227aefa8d9e1a</data>
