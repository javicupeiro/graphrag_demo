    <node id="ACROMEGALY">
      <data key="d0">EVENT</data>
      <data key="d1">Acromegaly is a hormonal disorder that results from excess growth hormone, leading to enlarged bones and tissues.</data>
      <data key="d2">2261671ccad439da1ed9ea5a27857dc8,afb4fa63fc94607d1545407e79240295</data>
      <data key="d3">886</data>
      <data key="d4">2</data>
      <data key="d5">15</data>
      <data key="d6">3980</data>
      <data key="d7">36d3fea88e904f8cb0ee9df2ed06fd2c</data>
    </node>
    <node id="TRANSSEFENOIDAL SURGERY">
      <data key="d0">EVENT</data>
      <data key="d1">Transsphenoidal surgery is a common treatment option for acromegaly, particularly for microadenomas.</data>
      <data key="d2">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d3">886</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">3981</data>
      <data key="d7">469a3140926c4f948cf1a4a482ced17d</data>
    </node>
    <node id="TUMORS">
      <data key="d0">EVENT</data>
      <data key="d1">Tumors, such as microadenomas and macroadenomas, are often involved in the development of acromegaly.</data>
      <data key="d2">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d3">886</data>
      <data key="d4">2</data>
