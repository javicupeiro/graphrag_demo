      <data key="d10">dc38a37c30b175667931b84a9c9103bb</data>
      <data key="d11">1394994934fc42e9a9b3d49a257ec867</data>
      <data key="d12">2591</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N CL&#205;NICA" target="PRODUCTO">
      <data key="d8">16.0</data>
      <data key="d9">NUTRICI&#211;N CL&#205;NICA is dedicated to the design and development of clinical nutrition products. These products are rigorously tested and validated prior to their market launch to ensure their effectiveness and safety. The primary aim of these nutritional clinical products is to provide essential nutrients to patients, addressing their specific dietary needs in a clinical setting.</data>
      <data key="d10">4196233cbb95a9ab194177cc11875e7a,62f527b38024e8807d3e63a0cf488046</data>
      <data key="d11">354f51060f1e48a58f4cd8842ed05bbf</data>
      <data key="d12">2592</data>
      <data key="d13">2</data>
    </edge>
