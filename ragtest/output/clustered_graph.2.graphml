    <node id="LIPODISTROFIA CONG&#201;NITA GENERALIZADA">
      <data key="d0">EVENT</data>
      <data key="d1">Lipodistrofia cong&#233;nita generalizada is a rare hereditary disorder characterized by the near-total absence of adipose tissue from birth, leading to metabolic anomalies such as hypertriglyceridemia and insulin resistance.</data>
      <data key="d2">4885c129837f58f091d24d2cbc8aae66</data>
      <data key="d3">1522</data>
      <data key="d4">2</data>
