      <data key="d7">861037d1fa3245e9bbe522daff8f4a47</data>
    </node>
    <node id="BENZODIACEPINAS">
      <data key="d0">EVENT</data>
      <data key="d1">A class of medications that can contribute to constipation in patients, particularly the elderly.</data>
      <data key="d2">09e9623b3facc5045e80541b1cd2cada</data>
      <data key="d3">1404</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14498</data>
      <data key="d7">b46651254cf94a7e905ab1f2c4e693e0</data>
    </node>
    <node id="OPI&#193;CEOS">
      <data key="d0">EVENT</data>
      <data key="d1">Opioid medications that are commonly associated with causing constipation in patients.</data>
      <data key="d2">09e9623b3facc5045e80541b1cd2cada</data>
      <data key="d3">1404</data>
      <data key="d4">2</data>
