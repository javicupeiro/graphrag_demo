      <data key="d7">bd11458a7d33474a9639f05953497e4f</data>
    </node>
    <node id="FOOD AND NUTRITION BOARD">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Food and Nutrition Board is a component of the National Academy of Sciences in the United States. It is tasked with the important responsibility of establishing dietary reference intakes, which serve as guidelines for nutritional needs and help inform public health policies and dietary recommendations.</data>
      <data key="d2">4198768cfbdf9c226ffba9074adf628f,561247e03fd2c7b8ca61c7f8ee874d38</data>
      <data key="d3">1567</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">7773</data>
      <data key="d7">9169ee8a83294f139fb85c78846f5f67</data>
    </node>
    <node id="INSTITUTO DE MEDICINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Instituto de Medicina, also known as the Institute of Medicine (IOM), is a nonprofit organization dedicated to providing expert advice on health and medicine. It is recognized for its role in publishing dietary reference intakes, which include recommendations on daily nutrient intake, such as copper. The organization aims to guide individuals and policymakers in making informed decisions regarding nutrition and health.</data>
      <data key="d2">4198768cfbdf9c226ffba9074adf628f,d6bd9fbceb166872651dd2deade92849</data>
      <data key="d3">1567</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">7774</data>
      <data key="d7">054b3707e75549169cab2ff1aeaf7265</data>
    </node>
    <node id="FEDERACI&#211;N ESPA&#209;OLA DE SOCIEDADES DE NUTRICI&#211;N, ALIMENTACI&#211;N Y DIET&#201;TICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Spanish Federation of Societies of Nutrition, Food, and Dietetics is an organization that has developed dietary reference intakes for Spain.</data>
      <data key="d2">4198768cfbdf9c226ffba9074adf628f</data>
      <data key="d3">1369</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">7775</data>
      <data key="d7">75692d1b664b4169b962221b0092e7e7</data>
    </node>
    <node id="RECOMMENDED DIETARY ALLOWANCE">
      <data key="d0">EVENT</data>
      <data key="d1">The Recommended Dietary Allowance (RDA) is a daily dietary nutrient intake level that is sufficient to meet the requirements of nearly all (97-98%) healthy individuals in a particular life stage and gender group.</data>
      <data key="d2">4198768cfbdf9c226ffba9074adf628f</data>
      <data key="d3">1563</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">7776</data>
      <data key="d7">c1ece36891294ebe8837cb684818d461</data>
    </node>
    <node id="DIETARY REFERENCE INTAKES">
      <data key="d0" />
      <data key="d1">Dietary Reference Intakes (DRI) are a set of reference values designed to plan and assess nutrient intakes for healthy individuals and populations. These guidelines serve to help individuals understand the recommended levels of nutrient intake necessary for maintaining health. The DRI provides a framework for evaluating dietary intake and ensuring that nutritional needs are met, thereby promoting overall well-being.</data>
      <data key="d2">4198768cfbdf9c226ffba9074adf628f,4e8b65ec9939ccf2152e68fa7f8b12c4,561247e03fd2c7b8ca61c7f8ee874d38,88d6f98c356e5a49db38ab5aa960bb95,9303a85464d02f1cc012aaca21edf9bb,a4b56b993221a7065a59bca622c02953,b46fefa9f55d92c74acad101fc4f812e,b65e3955444a7fb402ab92a8ae46311b,d26aec24f3f8c930c1c4b1d464bacd6b</data>
      <data key="d3">1563</data>
      <data key="d4">2</data>
      <data key="d5">33</data>
      <data key="d6">7777</data>
      <data key="d7">1ecfc0f7094743b19da239e9e3f4648a</data>
    </node>
    <node id="INSTITUTO AMERICANO DE MEDICINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The American Institute of Medicine provides definitions and guidelines for dietary reference intakes and nutritional requirements.</data>
      <data key="d2">d091ddf14a273c8981b300afdea77912</data>
      <data key="d3">1556</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">7778</data>
      <data key="d7">10f6d12bf883490891063a9d005c39ea</data>
    </node>
