      <data key="d11">0237a829fcb44479824a50f36c301b49</data>
      <data key="d12">17077</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUESO FRESCO" target="QUESO BLANCO DESNATADO">
      <data key="d8">8.0</data>
