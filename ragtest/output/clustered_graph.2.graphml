    </node>
    <node id="ASTEMIZOL">
      <data key="d0">PERSON</data>
      <data key="d1">Astemizol is a medication that can have its metabolism affected by grapefruit juice, increasing its levels.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">0</data>
      <data key="d6">14246</data>
