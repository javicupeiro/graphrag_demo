    <node id="UNIDAD DE NUTRICI&#211;N CL&#205;NICA Y DIET&#201;TICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The "UNIDAD DE NUTRICI&#211;N CL&#205;NICA Y DIET&#201;TICA" (Clinical Nutrition and Dietetics Unit) at HUPA is dedicated to providing dietary management and nutritional support for patients, with a particular emphasis on those experiencing swallowing disorders. This unit works closely with the hospital kitchen to ensure that patients receive appropriate dietary care tailored to their specific needs.</data>
      <data key="d2">544f7d3afd9f7def46c357525e55cabf,66c092d222e72c03a1f36507ce355cd4,eb2f276d3dc4e4a9e53923d9d80fec1a</data>
