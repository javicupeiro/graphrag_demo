      <data key="d6">1753</data>
      <data key="d7">074e00baf9dc41ab9d76cd61980a121e</data>
    </node>
    <node id="ENFERMEDADES HEMATOL&#211;GICAS">
      <data key="d0">EVENT</data>
      <data key="d1">Enfermedades hematol&#243;gicas are blood disorders that affect the blood and the organs responsible for blood production. These conditions can lead to excessive production of &#225;cido &#250;rico due to high cellular turnover and can influence lymphocyte counts and overall nutritional status. Treatment for hematological diseases may involve hematopoietic cell transplantation, which is a procedure used to replace damaged or diseased blood-forming cells.</data>
      <data key="d2">30d5c2ac31f39f8177bec50f6b5e631b,4015c8a1a16c5c93f3b853d9cac57bf4,ab93481c5db482b6da2462b4687e4313,db0a4fc296a2fd5ecfbc4afcda444738</data>
