      <data key="d6">11866</data>
      <data key="d7">fa5c3b6f61234ea5a75f504a5d0d8cc2</data>
    </node>
    <node id="ACANTOSIS NIGRICANS">
      <data key="d0">EVENT</data>
      <data key="d1">Acanthosis nigricans is a skin condition that may be associated with Wilson's disease, characterized by dark, velvety patches.</data>
      <data key="d2">3898563966943dbfc8a0f6e84bc627b1</data>
      <data key="d3">1793</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
