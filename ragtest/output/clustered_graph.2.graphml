    <edge source="PACIENTE" target="INTERVENCI&#211;N QUIR&#218;RGICA MAYOR">
      <data key="d8">1.0</data>
      <data key="d9">Patients may require nutritional planning before major surgical interventions</data>
      <data key="d10">ebfa3e3e6e6101b4d607871e17276705</data>
      <data key="d11">1cfddc9e61bd43a38e485f58eb330953</data>
      <data key="d12">3034</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="RIESGO NUTRICIONAL">
      <data key="d8">10.0</data>
      <data key="d9">The entity "PACIENTE" is evaluated for "RIESGO NUTRICIONAL" to assess nutritional risk, which helps determine the potential need for intervention. This assessment is crucial in identifying patients who may require additional nutritional support or intervention based on their risk levels.</data>
      <data key="d10">2ebe12524f7750215eee73b328b601ee,ebfa3e3e6e6101b4d607871e17276705</data>
      <data key="d11">fe0b26e238c1474096f0266e09080ebb</data>
      <data key="d12">3035</data>
