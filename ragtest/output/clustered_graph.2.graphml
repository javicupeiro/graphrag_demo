      <data key="d0">EVENT</data>
      <data key="d1">Hemorragia subaracnoidea (Subarachnoid Hemorrhage) is a condition that can lead to SIADH and has a specific treatment duration.</data>
      <data key="d2">69844236241841a2f03d6419e0916966</data>
