    <node id="PACIENTE ANCIANO">
      <data key="d0">PERSON</data>
      <data key="d1">El paciente anciano es un individuo que puede presentar alteraciones en la masticaci&#243;n y degluci&#243;n, lo que requiere modificaciones en su dieta y atenci&#243;n especial.</data>
      <data key="d2">2f548ddee569586dbe82ca124f2695e9</data>
      <data key="d3">586</data>
      <data key="d4">2</data>
      <data key="d5">14</data>
