      <data key="d12">10391</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RCIU" target="CARRASCOSA">
      <data key="d8">6.0</data>
      <data key="d9">Carrascosa's growth charts are used to assess infants with RCIU for proper growth tracking.</data>
