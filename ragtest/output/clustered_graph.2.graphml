    <edge source="DIABETES MELLITUS" target="ELDERLY">
      <data key="d8">9.0</data>
      <data key="d9">Elderly individuals have a higher prevalence of diabetes and require individualized dietary recommendations to manage their condition</data>
      <data key="d10">27f06efb5e9ac8bbc3f8bd31ee5a2777</data>
      <data key="d11">f9ec8acbf2c54087b41590cfec51ad6a</data>
