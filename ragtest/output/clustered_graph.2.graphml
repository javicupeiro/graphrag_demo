    <node id="EATING-ASSESSMENT TOOL-10">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Eating-Assessment Tool-10 (EAT-10) is a tool designed to detect individuals who may suffer from dysphagia and identify those who need further evaluation.</data>
      <data key="d2">42cc35e2edb450d48bb31f7c51b7a02f</data>
