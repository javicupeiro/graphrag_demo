      <data key="d13">2</data>
    </edge>
    <edge source="BARIATRIC SURGERY" target="GALLSTONES">
      <data key="d8">1.0</data>
      <data key="d9">Bariatric surgery can lead to the formation of gallstones as a complication, establishing a relationship between the two</data>
      <data key="d10">b0a60df651e774a77b1969babdf3b21a</data>
      <data key="d11">5908cac79b7e425dbc079e2230e321ea</data>
      <data key="d12">15343</data>
