    <node id="SURGICAL PROCEDURE">
      <data key="d0">EVENT</data>
      <data key="d1">A surgical procedure is a medical operation performed to treat a health issue, which may involve the placement of a catheter for venous access.</data>
      <data key="d2">3d5e0a3ef45c7ba15063791545dc4826</data>
      <data key="d3">763</data>
