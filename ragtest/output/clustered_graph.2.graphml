    </node>
    <node id="RESTAURANTES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los restaurantes son lugares que ofrecen comidas y deben cumplir con la normativa de informaci&#243;n alimentaria.</data>
      <data key="d2">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d3">635</data>
      <data key="d4">2</data>
