    <edge source="POTASIO" target="NUTRICION">
      <data key="d8">8.0</data>
      <data key="d9">Potassium levels are critical to monitor in the nutritional management of patients with respiratory failure</data>
      <data key="d10">3bfd2ce2b4408f718fd35e43c03965c7</data>
      <data key="d11">2c7511ecc10541079862fc26739deef5</data>
