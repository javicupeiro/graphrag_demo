    </node>
    <node id="L-ISOLEUCINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">L-Isoleucina es un amino&#225;cido esencial que se encuentra en las soluciones de amino&#225;cidos pedi&#225;tricos y es importante para la s&#237;ntesis de prote&#237;nas.</data>
      <data key="d2">ee3d3ae4eef4cfe540602ad04ef172dc</data>
      <data key="d3">634</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">15553</data>
      <data key="d7">320e620013604de7859949b2af18ce7d</data>
    </node>
    <node id="L-LEUCINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">L-Leucina es un amino&#225;cido esencial que juega un papel crucial en la regulaci&#243;n del crecimiento y la recuperaci&#243;n muscular.</data>
      <data key="d2">ee3d3ae4eef4cfe540602ad04ef172dc</data>
      <data key="d3">634</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">15554</data>
      <data key="d7">7ae921f7c102483f8bbe85990be9f7d9</data>
    </node>
