    </edge>
    <edge source="GSDIB" target="HEMODIALYSIS">
      <data key="d8">7.0</data>
      <data key="d9">Patients with GSDIb may require hemodialysis due to kidney failure resulting from the disease.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">1f7626f57cbb4529860174c21fbe1646</data>
      <data key="d12">17650</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GSDIB" target="ADENOMAS HEP&#193;TICOS">
      <data key="d8">6.0</data>
      <data key="d9">Patients with GSDIb are at risk of developing hepatic adenomas, particularly from the second to third decade of life.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">6894e88d1b60453a8e24c6002d8c28e0</data>
      <data key="d12">17651</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GSDIB" target="INFANTILE HYPOGLYCEMIA">
      <data key="d8">8.0</data>
      <data key="d9">Infantile hypoglycemia is a significant risk in patients with GSDIb, affecting cognitive development.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">ba80928569754024b0a16b5968b8b565</data>
      <data key="d12">17652</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GSDIB" target="GOUT">
      <data key="d8">5.0</data>
      <data key="d9">Gout can occur in patients with GSDIb due to hyperuricemia resulting from metabolic disturbances.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">1c4fa53b4db74dcdae928402f43362c0</data>
      <data key="d12">17653</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GSDIB" target="COGNITIVE DETERIORATION">
      <data key="d8">6.0</data>
      <data key="d9">Cognitive deterioration can result from frequent severe hypoglycemia in children with GSDIb.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">ea9ff5b119af4665aee45937404649ff</data>
      <data key="d12">17654</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GSDIB" target="KIDNEY FAILURE">
      <data key="d8">1.0</data>
      <data key="d9">Kidney failure is a severe complication of GSDIb, potentially requiring hemodialysis or transplant.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">5d86ad72e52e47cba05080b014adeb16</data>
      <data key="d12">17655</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GSDIB" target="DISLIPEMIA MIXTA">
      <data key="d8">5.0</data>
      <data key="d9">Mixed dyslipidemia is often observed in patients with GSDIb, increasing cardiovascular risk.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">20ada58e3179492e8bd861eeb4d15a19</data>
      <data key="d12">17656</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GSDIB" target="FENOTIPO PECULIAR">
      <data key="d8">6.0</data>
      <data key="d9">The peculiar phenotype is often associated with GSDIb, characterized by specific physical traits.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">267630255ce246d48b56107a550d0fc6</data>
