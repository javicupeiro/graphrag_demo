      <data key="d6">15491</data>
      <data key="d7">983cd7728e05400faa540f6e30ab213d</data>
    </node>
    <node id="SOY FORMULAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Soy formulas are dietary products that are contraindicated for premature newborns due to health risks associated with their use.</data>
      <data key="d2">08d66dc8414668a3ec627a1e164cfa6c</data>
      <data key="d3">454</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">15492</data>
      <data key="d7">75d697bcf3b04eac9faae807420794fd</data>
    </node>
    <node id="HYDROLYZED FORMULAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Hydrolyzed formulas are developed for infants with severe allergies to cow's milk proteins and are recommended for children with such allergies or malabsorption issues.</data>
      <data key="d2">08d66dc8414668a3ec627a1e164cfa6c</data>
      <data key="d3">454</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">15493</data>
      <data key="d7">092758c8bb8849f3be37fa210f2a0d37</data>
    </node>
    <node id="ELEMENTAL FORMULAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Elemental formulas are specialized dietary products designed for children aged 1 to 10 years with specific nutritional needs.</data>
      <data key="d2">08d66dc8414668a3ec627a1e164cfa6c</data>
