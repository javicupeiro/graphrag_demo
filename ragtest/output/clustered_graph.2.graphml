    <node id="SECRETINA">
      <data key="d0">PERSON</data>
      <data key="d1">La secretina es una hormona que regula la producci&#243;n de jugos digestivos y el flujo biliar, y su producci&#243;n puede verse alterada en ausencia de est&#237;mulo enteral.</data>
