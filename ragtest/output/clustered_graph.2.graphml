    </edge>
    <edge source="RASEMARY WYATT" target="SSA">
      <data key="d8">8.0</data>
      <data key="d9">Rasemary Wyatt co-designed the SSA, a tool for detecting dysphagia</data>
      <data key="d10">4befdcd21a98898cec30bbac7b402d4b</data>
      <data key="d11">811401b1b59e4f29bfe19fa8cdf24259</data>
