      <data key="d6">2410</data>
      <data key="d7">dc0833b97d494ec6af5b8a992a595025</data>
    </node>
    <node id="HIPOTENSI&#211;N POSTURAL">
      <data key="d0">EVENT</data>
      <data key="d1">Postural hypotension is a condition where blood pressure drops significantly upon standing, often affecting the elderly.</data>
      <data key="d2">b6180d67d6fdf45ff73aa2a63a8e3f74</data>
      <data key="d3">1084</data>
