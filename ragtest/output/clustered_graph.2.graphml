    </edge>
    <edge source="CALCIO" target="CALCITRIOL">
      <data key="d8">8.0</data>
      <data key="d9">Calcitriol is used to aid calcium absorption in patients, particularly those with osteoporosis</data>
      <data key="d10">94afd4bf40b661992e66cf7963ef236c</data>
      <data key="d11">5a2c7a7395a04524b681604d15936ab5</data>
      <data key="d12">8285</data>
