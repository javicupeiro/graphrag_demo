    <edge source="LACTANTES" target="AMINOSTERIL-N HEPA&#174;">
      <data key="d8">4.0</data>
      <data key="d9">Aminosteril-N Hepa&#174; is indicated for patients with hepatic issues, which may include older children</data>
      <data key="d10">a6e7937ce59bfc2b38e9ed2acf3e991c</data>
      <data key="d11">87c8d6c6c5e044249d408b57f6a2409c</data>
      <data key="d12">9997</data>
