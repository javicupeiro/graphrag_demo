    <node id="S&#205;NDROME GERI&#193;TRICO">
      <data key="d0">EVENT</data>
      <data key="d1">Geriatric syndrome refers to a group of conditions that commonly affect older adults, including dysphagia, stroke, and dementia.</data>
      <data key="d2">0bff3417518c19ae80d20de8150be58b</data>
