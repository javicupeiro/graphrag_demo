      <data key="d6">13645</data>
      <data key="d7">082518eaab4049759d7d97b8efdba96f</data>
    </node>
    <node id="TRAUMATISMO">
      <data key="d0">EVENT</data>
      <data key="d1">El traumatismo puede ser un factor que afecta la evaluaci&#243;n nutricional y los niveles de prote&#237;nas en pacientes cr&#237;ticos.</data>
      <data key="d2">9562f39f9e78644164daeff3177a2f84</data>
      <data key="d5">0</data>
      <data key="d6">13646</data>
      <data key="d7">7a3cf61c4541454eb2bd19eb9c963b89</data>
    </node>
    <node id="PROTEIN">
      <data key="d0">EVENT</data>
      <data key="d1">Proteins are essential macromolecules that play a vital role in the body's structure and function, and their levels are monitored in patients</data>
