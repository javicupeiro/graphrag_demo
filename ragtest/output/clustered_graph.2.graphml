    </node>
    <node id="GROENINGEN FRAILTY INDICATOR">
      <data key="d0">EVENT</data>
      <data key="d1">El Groningen Frailty Indicator es un modelo que se utiliza para evaluar la fragilidad en ancianos.</data>
      <data key="d2">00a918807f0c6568ea1d9f0c41f1ad49</data>
      <data key="d3">1768</data>
