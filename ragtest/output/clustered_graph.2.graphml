    <node id="C&#193;NCER PULM&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">C&#225;ncer de pulm&#243;n is a type of lung cancer that has been investigated for potential dietary influences, including omega-3 fatty acids.</data>
      <data key="d2">11c3cb37b1a2c111ceb227aefa8d9e1a</data>
      <data key="d3">980</data>
