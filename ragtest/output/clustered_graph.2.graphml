      <data key="d6">2527</data>
      <data key="d7">c901e47e19044f1bb2efb3c776e7f8e5</data>
    </node>
    <node id="NUTRICI&#211;N PARENTERAL CENTRAL">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional therapy that accesses circulation through a large-caliber vein using a central venous catheter</data>
      <data key="d2">781bee94bdbc4f6a3cf4186d6ae0daff</data>
      <data key="d3">98</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">2528</data>
      <data key="d7">5be378af9fba435191c89960f41e9630</data>
    </node>
    <node id="CVC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">CVC, or Central Venous Catheter, is a medical device designed for various clinical applications, primarily for administering medication, fluids, and parenteral nutrition. It is particularly utilized in acute situations and critical care settings, allowing for long-term intravenous access to the vascular system. CVCs are essential for delivering treatments and drawing blood samples, making them a vital tool in patient management.

However, the use of CVCs is not without risks. They can experience thrombotic obstructions and are associated with potential infections, which are significant concerns in their application. Overall, CVCs play a crucial role in modern medical practice, especially for patients requiring sustained intravenous therapy.</data>
      <data key="d2">1c3eeb30a49c70f750b79e7bc1dfef52,20a97c2641138578710a84f5040c86ef,20b676e149e50ddc54c40e2e1577e9ac,222519e556047fafecd61c2964aaaeed,5ad53a3f16964261ae37b64f7c3cb688,781bee94bdbc4f6a3cf4186d6ae0daff,c06e5bcd7933ed338cd1257d11c709cf,e5313f692c0a8259c93be803a704413c,f79f02438413f5accef9ac5fbd96f6df,fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d3">766</data>
      <data key="d4">2</data>
      <data key="d5">49</data>
      <data key="d6">2529</data>
      <data key="d7">ff9a4f62ce5940829ab469f0754f5ee1</data>
    </node>
    <node id="BROVIAC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Another type of tunneled catheter used for long-term venous access</data>
      <data key="d2">781bee94bdbc4f6a3cf4186d6ae0daff</data>
      <data key="d3">766</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">2530</data>
      <data key="d7">4906c3426f474fc0b9eb64a4db095add</data>
    </node>
    <node id="GROSHONG">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">GROSHONG refers to a type of central venous catheter specifically designed for long-term venous access. This catheter is engineered to minimize the risk of infection and thrombosis, making it a preferred choice for patients requiring extended intravenous therapy.</data>
      <data key="d2">3d5e0a3ef45c7ba15063791545dc4826,781bee94bdbc4f6a3cf4186d6ae0daff</data>
      <data key="d3">771</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">2531</data>
      <data key="d7">ed0171b31861429389baa99ac8d06091</data>
    </node>
    <node id="PICC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">PICC, or Peripherally Inserted Central Catheter, is a specialized type of central venous catheter designed for insertion into a peripheral vein. It is primarily utilized for longer-term parenteral nutrition, allowing for effective access to the venous system. The PICC provides a reliable means of accessing veins for various medical treatments, making it an essential tool in patient care.</data>
      <data key="d2">222519e556047fafecd61c2964aaaeed,781bee94bdbc4f6a3cf4186d6ae0daff</data>
      <data key="d3">766</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">2532</data>
      <data key="d7">b6b80c414f5f4cc49d807ab584b140e3</data>
    </node>
    <node id="ANESTESIA Y REANIMACI&#211;N">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Department responsible for ensuring the placement and management of catheters</data>
      <data key="d2">781bee94bdbc4f6a3cf4186d6ae0daff</data>
      <data key="d3">98</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">2533</data>
      <data key="d7">84bfb1912af349eca5630ff33fd8c328</data>
    </node>
    <node id="RADIOLOG&#205;A PEDI&#193;TRICA INTERVENCIONISTA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Interventional pediatric radiology department involved in catheter placement</data>
      <data key="d2">781bee94bdbc4f6a3cf4186d6ae0daff</data>
      <data key="d3">98</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
