      <data key="d6">14003</data>
      <data key="d7">8b3404eb0a37403d98bf96840b4aea86</data>
    </node>
    <node id="BRONCOESPASMO">
      <data key="d0">EVENT</data>
      <data key="d1">Broncoespasmo is a condition characterized by the tightening of the muscles around the airways, which can be triggered by food allergies.</data>
      <data key="d2">9d84c9c66c832dd17e7247a6966c2ea1</data>
      <data key="d3">371</data>
      <data key="d4">1</data>
