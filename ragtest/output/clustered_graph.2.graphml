      <data key="d11">2ba3a62d07544a60846a2e80dfcf840b</data>
      <data key="d12">3622</data>
      <data key="d13">2</data>
    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="EXPLORACI&#211;N CL&#205;NICA">
      <data key="d8">8.0</data>
      <data key="d9">La exploraci&#243;n cl&#237;nica incluye la evaluaci&#243;n de la p&#233;rdida de peso del paciente</data>
