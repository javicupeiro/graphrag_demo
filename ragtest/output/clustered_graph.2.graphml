      <data key="d7">913219acd09b4fe8bae9f2fdbd55914f</data>
    </node>
    <node id="BISACODILO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Bisacodilo is a stimulant laxative used to treat constipation by stimulating bowel movements.</data>
      <data key="d2">dc8d12d9f32208671f6067b0bb64a645</data>
      <data key="d3">1110</data>
      <data key="d4">2</data>
