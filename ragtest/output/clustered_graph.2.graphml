      <data key="d1">GADD45G es un inhibidor de la proliferaci&#243;n que se ha relacionado con adenomas hipofisarios.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1323</data>
      <data key="d4">2</data>
