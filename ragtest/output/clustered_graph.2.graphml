    <edge source="MEN2A" target="MARX SJ">
      <data key="d8">5.0</data>
      <data key="d9">Marx SJ has written about multiple endocrine neoplasia, including MEN2A</data>
      <data key="d10">2c745fa0855caf0a3316554b5a46752c</data>
      <data key="d11">46d3266b68a84049bf66a96fd63f52f1</data>
