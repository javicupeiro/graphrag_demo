    <node id="COLORANTE ALIMENTARIO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">El colorante alimentario puede contener gluten y debe ser verificado antes de su uso por personas con enfermedad celiaca.</data>
      <data key="d2">7d2050a2481adc105bdebbcf2af1a173</data>
