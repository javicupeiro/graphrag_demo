    <edge source="LONGO DL" target="HARRISON'S PRINCIPLES OF INTERNAL MEDICINE">
      <data key="d8">6.0</data>
      <data key="d9">Longo DL is an editor of the textbook that includes information on pheochromocytoma</data>
      <data key="d10">973f9100fbfeb9ef31038f51312620a9</data>
      <data key="d11">a97a7c2c149e404190e8870615263d02</data>
      <data key="d12">14633</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MITOTANO" target="EUROPEAN SOCIETY OF ENDOCRINOLOGY">
      <data key="d8">6.0</data>
      <data key="d9">The European Society of Endocrinology provides guidelines that may include the use of mitotano for adrenal carcinoma</data>
      <data key="d10">28bca03cd2152cf2562d7aa16d7ced1d</data>
      <data key="d11">f67608db75594f0aaec3eaad7ee41303</data>
      <data key="d12">14634</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MITOTANO" target="ADRENOCORTICAL CARCINOMA">
      <data key="d8">8.0</data>
      <data key="d9">Mitotano is indicated for the symptomatic treatment of advanced adrenocortical carcinoma.</data>
      <data key="d10">209bcca22090a109f52e26657bf3c999</data>
      <data key="d11">7d307250096448829ef79f0bfca26cf3</data>
      <data key="d12">14635</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MITOTANO" target="HIPOGONADISMO">
      <data key="d8">1.0</data>
      <data key="d9">Treatment with mitotano is commonly associated with hypogonadism in males, necessitating testosterone replacement therapy.</data>
      <data key="d10">209bcca22090a109f52e26657bf3c999</data>
      <data key="d11">613eaa730ce2411298627367b1ca083e</data>
      <data key="d12">14636</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MITOTANO" target="CARCINOMA SUPRARRENAL PRIMARIO">
      <data key="d8">8.0</data>
      <data key="d9">Mitotano is used for the treatment of advanced adrenal cortex carcinoma, making it directly related to the condition</data>
      <data key="d10">8eb2b7021402eb440fe88889b78c2785</data>
      <data key="d11">abde66bf533344d8b64f66c9173af910</data>
      <data key="d12">14637</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MITOTANO" target="GLANDULA SUPRARRENAL">
      <data key="d8">1.0</data>
      <data key="d9">Mitotano has a cytotoxic effect on the adrenal gland, affecting hormone production</data>
      <data key="d10">8eb2b7021402eb440fe88889b78c2785</data>
      <data key="d11">6db1717b7727474c82afece8938e579c</data>
      <data key="d12">14638</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MITOTANO" target="CYP3A4">
      <data key="d8">5.0</data>
      <data key="d9">Mitotano induces CYP3A4, impacting the metabolism of other drugs</data>
      <data key="d10">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d11">3a3b0b4242aa4f50bf476a4b7be8edc2</data>
      <data key="d12">14639</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LOSCAZO J" target="HARRISON'S PRINCIPLES OF INTERNAL MEDICINE">
      <data key="d8">6.0</data>
      <data key="d9">Loscazo J is an editor of the textbook that includes information on pheochromocytoma</data>
      <data key="d10">973f9100fbfeb9ef31038f51312620a9</data>
      <data key="d11">6df3700087bc4ec0af5223aa65477b01</data>
      <data key="d12">14640</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE MCCUNE-ALBRIGHT" target="MUTACIONES SOM&#193;TICAS">
      <data key="d8">8.0</data>
      <data key="d9">Las mutaciones som&#225;ticas son la causa de la enfermedad de McCune-Albright</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">010e6e0a206a40c7be941b9a78a3e605</data>
      <data key="d12">14641</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NA GS&#913;" target="MUTACIONES SOM&#193;TICAS">
      <data key="d8">7.0</data>
      <data key="d9">Las mutaciones en el GNAS afectan la prote&#237;na Gs&#945;, que est&#225; implicada en la enfermedad de McCune-Albright</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">055f461c77d74c1aa094cb0534ece255</data>
      <data key="d12">14642</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEXAMETHASONE" target="CUSHING SYNDROME">
      <data key="d8">8.0</data>
      <data key="d9">Dexamethasone is used in tests to diagnose Cushing syndrome by assessing cortisol suppression.</data>
      <data key="d10">8fe4d0101ea7a6ddaefd71c963d9ecc7</data>
      <data key="d11">17c02e9901d543f896fe98de12eea152</data>
      <data key="d12">14643</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEXAMETHASONE" target="HYPERANDROGENISM">
      <data key="d8">1.0</data>
      <data key="d9">Dexamethasone suppression tests are used to evaluate the cause of hyperandrogenism, linking the two entities through diagnostic procedures</data>
      <data key="d10">05a6995cef9c8d0279b9f026da1ffed1</data>
      <data key="d11">e2a09c18b7e94aa981fbfa1c7c933755</data>
      <data key="d12">14644</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RESISTENCIA TISULAR A GLUCOCORTICOIDES" target="MUTACIONES EN EL DOMINIO DE FIJACI&#211;N A LOS ESTEROIDES">
      <data key="d8">1.0</data>
      <data key="d9">Mutations in the steroid-binding domain can lead to tissue resistance to glucocorticoids</data>
      <data key="d10">bcbca87f5ebf2c5d260810cf83a70257</data>
      <data key="d11">ee9a6f30da8e4dea83d86013dc4eef0e</data>
      <data key="d12">14645</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE BARTTER" target="ACIDOSIS TUBULAR RENAL">
      <data key="d8">4.0</data>
      <data key="d9">Ambos son trastornos renales que afectan la regulaci&#243;n de electrolitos y el equilibrio &#225;cido-base</data>
      <data key="d10">473502714ce73073f93b598ca0edcc21</data>
      <data key="d11">56624932621644ab8a9090cd606de354</data>
      <data key="d12">14646</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE BARTTER" target="BESOUW MTP">
      <data key="d8">7.0</data>
      <data key="d9">Besouw MTP ha investigado el s&#237;ndrome de Bartter, contribuyendo a su comprensi&#243;n</data>
      <data key="d10">473502714ce73073f93b598ca0edcc21</data>
      <data key="d11">f94f2188b0e04257b11c0aa12aa4ad45</data>
      <data key="d12">14647</data>
