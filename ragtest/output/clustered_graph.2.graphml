      <data key="d11">0daf05c6826a418ea74362436b2816f5</data>
      <data key="d12">9555</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EICH" target="TRANSPLANTE HEMATOL&#211;GICO">
      <data key="d8">8.0</data>
      <data key="d9">El trasplante hematol&#243;gico puede dar lugar a la aparici&#243;n de EICH como una complicaci&#243;n postoperatoria</data>
      <data key="d10">81bb0be389c10331fb2a5568b6c379dc</data>
      <data key="d11">655a33569e084c2c8b9d53cef0145371</data>
      <data key="d12">9556</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EICH" target="MUSCARITOLI ET AL">
      <data key="d8">7.0</data>
      <data key="d9">Muscaritoli et al han demostrado que el aporte de l&#237;pidos puede disminuir la incidencia de EICH en trasplantes alog&#233;nicos</data>
      <data key="d10">81bb0be389c10331fb2a5568b6c379dc</data>
      <data key="d11">ddbfdbeed4314665982a9946899416df</data>
      <data key="d12">9557</data>
