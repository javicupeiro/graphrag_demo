    </node>
    <node id="COCINA EN FR&#205;O">
      <data key="d0">EVENT</data>
      <data key="d1">La cocina en fr&#237;o es un sistema de producci&#243;n de alimentos que se utiliza en hospitales para mejorar la ingesta nutricional de los pacientes.</data>
      <data key="d2">4de75db0e24f0f89d890287e2a3f3dcc</data>
      <data key="d3">1171</data>
