      <data key="d8">8.0</data>
      <data key="d9">Eva Mar&#237;a Garc&#237;a Raimundo is part of the team at Hospital Universitari de Bellvitge, focusing on nutrition and dietetics</data>
      <data key="d10">ba4a819ecea2015fc907ed907767f6c5</data>
      <data key="d11">40733ec2f748479e927f4e75472b5110</data>
      <data key="d12">18616</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#211;NICA MONTSERRAT GIL DE BERNAB&#201;" target="HOSPITAL UNIVERSITARI DE BELLVITGE">
      <data key="d8">8.0</data>
      <data key="d9">M&#243;nica Montserrat Gil de Bernab&#233; is a member of the Unit of Nutrition and Dietetics at Hospital Universitari de Bellvitge</data>
      <data key="d10">ba4a819ecea2015fc907ed907767f6c5</data>
      <data key="d11">c181848f379f4836bae1976672f5518c</data>
      <data key="d12">18617</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GAUCHER DISEASE TYPE III" target="X-LINKED ADRENOLEUKODYSTROPHY">
      <data key="d8">4.0</data>
      <data key="d9">Both X-linked adrenoleukodystrophy and Gaucher disease type III are genetic disorders that require specialized medical treatment and management</data>
      <data key="d10">ba4a819ecea2015fc907ed907767f6c5</data>
      <data key="d11">9ebcf1c6227642c89d499e4513460024</data>
      <data key="d12">18618</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HURLER SYNDROME" target="MAROTEAUX-LAMY SYNDROME">
      <data key="d8">5.0</data>
      <data key="d9">Hurler syndrome and Maroteaux-Lamy syndrome are both genetic disorders that affect connective tissue and have overlapping symptoms</data>
      <data key="d10">ba4a819ecea2015fc907ed907767f6c5</data>
      <data key="d11">58186257b5704bf8922cfd8098823a24</data>
      <data key="d12">18619</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANNOSIDOSIS" target="FUCOSIDOSIS">
      <data key="d8">5.0</data>
      <data key="d9">Mannosidosis and fucosidosis are both lysosomal storage disorders caused by enzyme deficiencies, leading to similar metabolic issues</data>
      <data key="d10">ba4a819ecea2015fc907ed907767f6c5</data>
      <data key="d11">6fd9658164c547fbb292e2c1fe456d54</data>
      <data key="d12">18620</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ASPARTYGLUCOSAMINURIA" target="X-LINKED ADRENOLEUKODYSTROPHY">
      <data key="d8">1.0</data>
      <data key="d9">Aspartylglucosaminuria and X-linked adrenoleukodystrophy are both genetic disorders that can impact metabolic processes in the body</data>
      <data key="d10">ba4a819ecea2015fc907ed907767f6c5</data>
      <data key="d11">e9954166a6d942e0b3db85f73ae3e3f4</data>
      <data key="d12">18621</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CONDUCTO TOR&#193;CICO" target="SISTEMA LINF&#193;TICO">
      <data key="d8">8.0</data>
      <data key="d9">El conducto tor&#225;cico es una parte integral del sistema linf&#225;tico, transportando la linfa al sistema venoso.</data>
      <data key="d10">0f2aa9d202fbabe2b0f310000e6987e7</data>
      <data key="d11">65d2caa4e8d44aedad9dde921c0c9d7b</data>
      <data key="d12">18622</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AN&#193;LISIS MICROBIOL&#211;GICO" target="DERRAME PLEURAL">
      <data key="d8">7.0</data>
      <data key="d9">El an&#225;lisis microbiol&#243;gico se utiliza para descartar infecciones en casos de derrame pleural.</data>
      <data key="d10">8d4057f6ab3a5d00b2ae7609742cdf86</data>
      <data key="d11">417fb11e01ec4764b471e57af184ca26</data>
      <data key="d12">18623</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AN&#193;LISIS MICROBIOL&#211;GICO" target="PRODUCTOS DE NUTRICI&#211;N ENTERAL">
      <data key="d8">7.0</data>
      <data key="d9">Microbiological analysis is a critical evaluation for enteral nutrition products</data>
      <data key="d10">2e07cfac64a6162c745f1c392de1bff4</data>
      <data key="d11">b0a01589869847d6bb115b50ecb91bab</data>
      <data key="d12">18624</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LINFOCITOS T" target="ALOANT&#205;GENOS">
      <data key="d8">1.0</data>
      <data key="d9">Los linfocitos T del donante pueden reconocer los aloant&#237;genos del receptor como extra&#241;os, lo que desencadena la EICH.</data>
      <data key="d10">5b26dc0fdf0ff94c225f96626b785972</data>
      <data key="d11">7df19b17bd6b4ef6bb70a34bcec27886</data>
      <data key="d12">18625</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTARY SUPPLEMENTATION" target="LIPIDS">
      <data key="d8">1.0</data>
      <data key="d9">The dietary advice regarding lipids is relevant to the context of nutritional supplementation with TCM</data>
      <data key="d10">347e3d175ef7f30e3dcad731f84fb375</data>
      <data key="d11">48f41894571245a296b74bcace5348a3</data>
      <data key="d12">18626</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPIDS" target="PA">
      <data key="d8">6.0</data>
      <data key="d9">The use of lipids in intravenous nutrition for pancreatitis patients is controversial due to their association with hyperlipemia and pancreatitis</data>
      <data key="d10">46bc44144e19709e2d7f9838c9c54ccf</data>
      <data key="d11">1540ffff54284e869ce6103ecad1af98</data>
      <data key="d12">18627</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPIDS" target="ICU">
      <data key="d8">6.0</data>
      <data key="d9">Lipid emulsions are administered to patients in the ICU as part of their nutritional support</data>
