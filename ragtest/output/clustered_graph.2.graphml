      <data key="d11">72a286fbc8694389bb50aab2c7688116</data>
      <data key="d12">10836</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESTUDIO OCTABAIX" target="WOODHOUSE">
      <data key="d8">6.0</data>
      <data key="d9">Woodhouse's definition of frail elderly aligns with the objectives of the OCTABAIX study in Barcelona</data>
      <data key="d10">e09463a0b899f9cd54a1daefc265ca39</data>
      <data key="d11">c37fa0327b964f8f9443feac5f6d6273</data>
      <data key="d12">10837</data>
      <data key="d13">2</data>
    </edge>
