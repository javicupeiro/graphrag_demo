    <node id="ANTIBI&#211;TICO">
      <data key="d0">EVENT</data>
      <data key="d1">El tratamiento antibi&#243;tico es necesario para manejar infecciones asociadas a cat&#233;teres, junto con la posible retirada del cat&#233;ter.</data>
      <data key="d2">21bd0c4198fa2be0aa931387bd631728</data>
      <data key="d3">758</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
