      <data key="d8">4.0</data>
      <data key="d9">Van Bokhorst-de van der Schueren's review discusses the effectiveness of tools like the Nutrition Screening Initiative</data>
      <data key="d10">8e8a6418528a5c33a9ddf7eb94066a04</data>
      <data key="d11">d20e3b98d35148fb8b285465e879a927</data>
      <data key="d12">11426</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VGS" target="VGS-GP">
      <data key="d8">7.0</data>
