      <data key="d7">90edabe566f845d0abe689458e8b70af</data>
    </node>
    <node id="EISENBARTH GS">
      <data key="d0">PERSON</data>
      <data key="d1">Eisenbarth GS is a prominent figure and scientist in the field of diabetes research, with a particular focus on type 1 diabetes. His contributions to the understanding and treatment of this condition have established him as a key player in the scientific community dedicated to diabetes research.</data>
      <data key="d2">d0231ac4e41b0e826d80763b5b8c61e0,ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1720</data>
