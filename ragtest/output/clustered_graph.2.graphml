      <data key="d11">66955f660786485f9bc532d7ae51bf02</data>
      <data key="d12">11662</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMINO&#193;CIDOS ESENCIALES" target="ISOLUCINA">
      <data key="d8">7.0</data>
      <data key="d9">Isoleucine is one of the essential amino acids that contribute to muscle metabolism and is important for older adults.</data>
      <data key="d10">368804d3e1f8a58c4e6c3a8210f08a35</data>
      <data key="d11">48cde95d567f4a22972aa88b7dd249b1</data>
      <data key="d12">11663</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMINO&#193;CIDOS ESENCIALES" target="VALINA">
      <data key="d8">7.0</data>
      <data key="d9">Valine is an essential amino acid that supports muscle growth and is included in discussions about dietary needs for older adults.</data>
      <data key="d10">368804d3e1f8a58c4e6c3a8210f08a35</data>
      <data key="d11">23bb5be8de274c53964dfe6c4083c76d</data>
      <data key="d12">11664</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMINO&#193;CIDOS ESENCIALES" target="LISINA">
      <data key="d8">7.0</data>
      <data key="d9">Lysine is an essential amino acid that is necessary for protein synthesis and is relevant for older adults' dietary needs.</data>
      <data key="d10">368804d3e1f8a58c4e6c3a8210f08a35</data>
      <data key="d11">8b2d5efc7ae14494b50cf11a0a4ab2e7</data>
      <data key="d12">11665</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMINO&#193;CIDOS ESENCIALES" target="HISTIDINA">
