      <data key="d11">44ed82d78b9247e6b1df8a0966bb1e00</data>
      <data key="d12">61</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SENPE" target="SEDOM">
      <data key="d8">12.0</data>
      <data key="d9">SENPE and SEDOM collaborate on the development of guidelines and documentation pertaining to hospital nutrition and nutritional care in Spain. Their joint efforts focus on creating protocols that enhance the quality of nutritional support provided in healthcare settings.</data>
      <data key="d10">1bad878c6efa9d3f5719546bb51bccb6,bf0cc16dc61df5b90a5a1e961322391a</data>
      <data key="d11">b6ba2280d0fb4030a44862a650ff9cee</data>
