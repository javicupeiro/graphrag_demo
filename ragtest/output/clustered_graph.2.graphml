    <node id="DESNUTRICI&#211;N LEVE">
      <data key="d0">EVENT</data>
      <data key="d1">A classification of malnutrition characterized by a Body Mass Index (BMI) between 17 and 18.4.</data>
      <data key="d2">4734ce2075bc72c352950c018bab7185</data>
      <data key="d3">1099</data>
      <data key="d4">2</data>
