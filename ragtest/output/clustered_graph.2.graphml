      <data key="d5">4</data>
      <data key="d6">3687</data>
      <data key="d7">83dec70e02bb4768ae6144c78cff56d8</data>
    </node>
    <node id="OXITOCINA">
      <data key="d0">EVENT</data>
      <data key="d1">OXITOCINA is a hormone produced in the hypothalamus and released by the neurohypophysis. It plays a crucial role in childbirth and lactation, facilitating these essential physiological processes. Additionally, oxytocin exhibits antidiuretic effects, contributing to various other physiological functions within the body.</data>
      <data key="d2">773a1daa539dd85e562a59e09f434af1,78b093da6669fb9ed3258ed62a73260e</data>
      <data key="d3">1324</data>
