    <node id="D-D&#205;MEROS">
      <data key="d0">EVENT</data>
      <data key="d1">D-d&#237;meros are a laboratory test used to assess the presence of thrombotic events, with levels above 500 mg/ml indicating a potential issue.</data>
      <data key="d2">20a97c2641138578710a84f5040c86ef</data>
      <data key="d3">768</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
