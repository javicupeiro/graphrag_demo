    </edge>
    <edge source="COMPLICACIONES" target="INFECCI&#211;N">
      <data key="d8">9.0</data>
      <data key="d9">La infecci&#243;n es una de las complicaciones m&#225;s comunes asociadas con el uso de cat&#233;teres venosos centrales</data>
      <data key="d10">ff844169c2b512733f5bde26e6f1ed32</data>
      <data key="d11">80cb6c32c23343578447926d5aec4e0c</data>
      <data key="d12">7807</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES" target="TROMBOSIS VENOSA">
      <data key="d8">8.0</data>
      <data key="d9">La trombosis venosa es otra complicaci&#243;n que puede surgir en pacientes con cat&#233;teres venosos centrales</data>
      <data key="d10">ff844169c2b512733f5bde26e6f1ed32</data>
