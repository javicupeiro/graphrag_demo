      <data key="d0">EVENT</data>
      <data key="d1">Medications used to treat diarrhea, including loperamide and difenoxilato.</data>
      <data key="d2">09e9623b3facc5045e80541b1cd2cada</data>
      <data key="d3">1178</data>
