    <node id="CIRCUMFERENCE OF ARM">
      <data key="d0">EVENT</data>
      <data key="d1">The circumference of the arm is a simple measurement used to assess muscle mass and nutritional status in patients with EPOC.</data>
      <data key="d2">cc406ffdbe4f62a6f2d9763ee4888fdf</data>
      <data key="d3">1037</data>
      <data key="d4">2</data>
