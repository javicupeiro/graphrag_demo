    <node id="GASTRITIS CR&#211;NICA ATR&#211;FICA">
      <data key="d0">EVENT</data>
      <data key="d1">Gastritis cr&#243;nica atr&#243;fica is a chronic condition that can lead to decreased absorption of Vitamin B&#8321;&#8322;.</data>
      <data key="d2">2cff1005fe34ac994249b78b4ca112c7</data>
