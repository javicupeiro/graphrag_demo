      <data key="d10">0a43b350a248173236a96a64e266b744</data>
      <data key="d11">7ea1a2084a34432ca5d34527e826ff94</data>
      <data key="d12">3855</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTOS" target="ENFERMEDAD CARDIOVASCULAR">
      <data key="d8">7.0</data>
