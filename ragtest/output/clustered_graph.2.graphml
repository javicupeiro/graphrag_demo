      <data key="d6">7970</data>
      <data key="d7">1dd7e486afd5421a869ab40fe9892816</data>
    </node>
    <node id="PRODUCTS IN CONVERSION">
      <data key="d0">EVENT</data>
      <data key="d1">Products in conversion are those that are in the process of transitioning to ecological farming and cannot yet be labeled as ecological.</data>
      <data key="d2">d3ffabc46da9b238994a7769ffc8f6b7</data>
      <data key="d3">134</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7971</data>
      <data key="d7">6d139fb1003348e1b4e11ca090eae062</data>
    </node>
    <node id="ECOLOGICAL INGREDIENTS">
      <data key="d0">EVENT</data>
      <data key="d1">Ecological ingredients are components of food products that are produced according to ecological standards.</data>
      <data key="d2">d3ffabc46da9b238994a7769ffc8f6b7</data>
      <data key="d5">1</data>
      <data key="d6">7972</data>
      <data key="d7">52b180279fa04ba8adb8ddc6dc54425e</data>
    </node>
    <node id="ECOLOGICAL CERTIFICATION">
      <data key="d0">EVENT</data>
      <data key="d1">Ecological certification is the process by which products are verified to meet ecological standards by a recognized control organism.</data>
      <data key="d2">d3ffabc46da9b238994a7769ffc8f6b7</data>
      <data key="d5">1</data>
      <data key="d6">7973</data>
      <data key="d7">f2c822d0e65b4c859f0bba06df13f9e2</data>
    </node>
    <node id="EUROPEAN ORGANIC CERTIFICATION ENTITY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">An organization that certifies products as organic according to EU standards, ensuring compliance with regulations for organic labeling.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d3">443</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">7974</data>
      <data key="d7">9dc541177d71479a8ae40dd0f01bdc75</data>
    </node>
    <node id="EGGS">
      <data key="d0">EVENT</data>
      <data key="d1">Eggs are a common dietary item that have been extensively studied for their potential impact on cholesterol levels and cardiovascular risk. Additionally, they are subject to specific regulations that require proper labeling concerning their production methods and origin. This ensures that consumers are informed about the quality and source of the eggs they purchase.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a,5b7201af7da852101713ee9f11864f50</data>
      <data key="d3">443</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">7975</data>
      <data key="d7">dd991b0d659f44bd8d8080494ad95bd9</data>
    </node>
    <node id="DENOMINATION OF ORIGIN PROTECTED">
      <data key="d0">EVENT</data>
      <data key="d1">A quality label that indicates that a product comes from a specific geographical area and meets certain quality standards.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d3">443</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7976</data>
      <data key="d7">1bea52a276bd493ca40efb3b6b71975e</data>
    </node>
    <node id="INDICATION OF GEOGRAPHICAL PROTECTED">
      <data key="d0">EVENT</data>
      <data key="d1">A quality label that signifies that a product has a specific geographical origin and possesses qualities or a reputation due to that origin.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d3">443</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7977</data>
      <data key="d7">8421c049ce3c46e992015ad1bdfd36f2</data>
    </node>
    <node id="TRADITIONAL SPECIALTY GUARANTEED">
      <data key="d0">EVENT</data>
      <data key="d1">A label that indicates a product is recognized for its traditional production methods and characteristics.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d3">443</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7978</data>
      <data key="d7">975ed840552746879b9454e5d8f8f41c</data>
    </node>
    <node id="ORGANIC PRODUCTS">
      <data key="d0">EVENT</data>
      <data key="d1">Organic products are those that are produced without synthetic fertilizers or pesticides and must adhere to specific labeling regulations in the EU.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d5">4</data>
      <data key="d6">7979</data>
      <data key="d7">2d6247605d834074a4b8362cb36fb7f9</data>
    </node>
    <node id="CONTROL BODY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A control body is an organization responsible for certifying that products meet organic standards and regulations set by the European Union.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d3">443</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7980</data>
      <data key="d7">04178ff6a2444a2286c8edda71981f91</data>
    </node>
    <node id="AGRICULTURE UE">
      <data key="d0">EVENT</data>
      <data key="d1">Agriculture UE refers to products that are sourced from the European Union, indicating their origin in organic labeling.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d5">1</data>
      <data key="d6">7981</data>
      <data key="d7">1d186e27679744c790e4978da9030a17</data>
    </node>
    <node id="AGRICULTURE NON UE">
      <data key="d0">EVENT</data>
      <data key="d1">Agriculture non UE refers to products that are sourced from outside the European Union, indicating their origin in organic labeling.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d5">1</data>
      <data key="d6">7982</data>
      <data key="d7">6f3aaf021aaf48aab269c886168bc23e</data>
    </node>
    <node id="AGRICULTURE UE/ NON UE">
      <data key="d0">EVENT</data>
      <data key="d1">Agriculture UE/ non UE refers to products that have ingredients sourced from both the European Union and non-EU countries, indicating their origin in organic labeling.</data>
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d5">1</data>
      <data key="d6">7983</data>
      <data key="d7">3e1e2f521ebf4cc9986a0d1669d8c48d</data>
    </node>
    <node id="EUROPEAN LOGO">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">5a591aa1c68fac4ef889974f6a57c73a</data>
      <data key="d5">1</data>
      <data key="d6">7984</data>
      <data key="d7">7014ed2df2e54b3085a888c9fcbdd90d</data>
    </node>
    <node id="DENOMINACI&#211;N DE ORIGEN PROTEGIDA">
      <data key="d0">EVENT</data>
      <data key="d1">Denominaci&#243;n de Origen Protegida (DOP) identifies food products originating from a specific place, region, or country, whose quality or characteristics are fundamentally due to the geographical environment, and must be produced in that defined geographical area.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">7985</data>
      <data key="d7">a2735f61fd7d4c23b4a6e939e4a5d4d5</data>
    </node>
    <node id="INDICACI&#211;N GEOGR&#193;FICA PROTEGIDA">
      <data key="d0">EVENT</data>
      <data key="d1">Indicaci&#243;n Geogr&#225;fica Protegida (IGP) identifies products originating from a specific place, region, or country, which possess a certain quality or reputation attributable to their geographical origin, with at least one phase of production occurring in the defined area.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">7986</data>
      <data key="d7">d30f608157b149a78e974888f1f75040</data>
    </node>
    <node id="ESPECIALIDAD TRADICIONAL GARANTIZADA">
      <data key="d0">EVENT</data>
      <data key="d1">Especialidad Tradicional Garantizada (ETG) protects traditional production methods and recipes, identifying specific products resulting from traditional practices, regardless of their geographical origin.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
      <data key="d6">7987</data>
      <data key="d7">622e4dd831db4d25862183b197949dd3</data>
    </node>
    <node id="CORDERO MANCHEGO">
      <data key="d0">EVENT</data>
      <data key="d1">Cordero manchego is an example of a product that falls under Indicaci&#243;n Geogr&#225;fica Protegida, recognized for its specific qualities attributed to its geographical origin.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7988</data>
      <data key="d7">97bb84c75b4d40f3aa6db04df5804c76</data>
    </node>
    <node id="JAM&#211;N SERRANO">
      <data key="d0">EVENT</data>
      <data key="d1">Jam&#243;n serrano is a product that is recognized under Especialidad Tradicional Garantizada, known for its traditional production methods.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7989</data>
      <data key="d7">5a22c5b96e6e44628ce30dc9bda60d39</data>
    </node>
    <node id="TORTAS DE ACEITE">
      <data key="d0">EVENT</data>
      <data key="d1">Tortas de aceite are traditional Spanish products that are protected under Especialidad Tradicional Garantizada for their unique production methods.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7990</data>
      <data key="d7">567d82358f654e248c533588a3cd4df8</data>
    </node>
    <node id="LECHE DE GRANJA">
      <data key="d0">EVENT</data>
      <data key="d1">Leche de granja is a traditional product recognized under Especialidad Tradicional Garantizada, produced using traditional methods.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7991</data>
      <data key="d7">0eebb4c03c7640fea00b75dde8c9298f</data>
    </node>
    <node id="PANELLETS">
      <data key="d0">EVENT</data>
      <data key="d1">Panellets are traditional sweets in Spain that are protected under Especialidad Tradicional Garantizada, made with traditional recipes.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">7992</data>
      <data key="d7">4410189cacb94f0e856e01f368432968</data>
    </node>
    <node id="ENVASADO INTELIGENTE">
      <data key="d0">EVENT</data>
      <data key="d1">Envasado inteligente refers to a type of food packaging that provides information about the product inside, based on the interaction between the food and the packaging.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d5">4</data>
      <data key="d6">7993</data>
      <data key="d7">afb5fb68d3a6420795b1830ca8f4d9d9</data>
    </node>
    <node id="INDICADORES DE FRESCURA">
      <data key="d0">EVENT</data>
      <data key="d1">Indicadores de frescura are devices used in smart packaging to monitor the quality of packaged food by responding to changes in the food's condition.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d5">1</data>
      <data key="d6">7994</data>
      <data key="d7">74dd28e07a8646849ed01d790238c56c</data>
    </node>
    <node id="DISPOSITIVOS DE TIEMPO Y TEMPERATURA">
      <data key="d0">EVENT</data>
      <data key="d1">Dispositivos de tiempo y temperatura provide visual information about the cumulative effect of time and temperature on food products.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d5">1</data>
      <data key="d6">7995</data>
      <data key="d7">c3e2619931e24bb8acdd7cd9db4dddd9</data>
    </node>
    <node id="DISPOSITIVOS DE FUGAS">
      <data key="d0">EVENT</data>
      <data key="d1">Dispositivos de fugas monitor the presence or absence of oxygen in food packaging, indicating potential spoilage.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d5">1</data>
      <data key="d6">7996</data>
      <data key="d7">3af9e73f737f4b7ea015985e3eed6382</data>
    </node>
    <node id="INDICADOR DE FR&#205;O">
      <data key="d0">EVENT</data>
      <data key="d1">Indicador de fr&#237;o is a temperature indicator that changes color to show whether a product has been kept at the appropriate cold temperature.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54</data>
      <data key="d5">1</data>
      <data key="d6">7997</data>
      <data key="d7">ffc35601fae14629b9cb3a7a79682e15</data>
    </node>
    <node id="REGLAMENTO (CE) 510/2006">
      <data key="d0" />
      <data key="d1">The "REGLAMENTO (CE) 510/2006" is a regulation focused on the protection of geographical indications and designations of origin for agricultural and food products. This regulation aims to safeguard the unique characteristics and reputation of products that are linked to specific geographical areas, ensuring that consumers are not misled about the origin of these products.</data>
      <data key="d2">ed225adac152d1c29c228d1a09c2ce54,edc9ccbe5d98671343d0119a309cddaf</data>
      <data key="d3">524</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">7998</data>
      <data key="d7">4806a411daaa4c8a92f6f8284edd66b9</data>
    </node>
    <node id="COMISI&#211;N DE LAS COMUNIDADES EUROPEAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The European Commission is the executive branch of the European Union responsible for proposing legislation and implementing decisions.</data>
      <data key="d2">e0102bb655b6476ce3296726e3aceb4a</data>
      <data key="d5">1</data>
      <data key="d6">7999</data>
      <data key="d7">6a0655c5d8d34650adb6438777b8e279</data>
    </node>
    <node id="NUTRICI&#211;N CL&#205;NICA Y METABOLISMO">
      <data key="d0">EVENT</data>
      <data key="d1">Clinical Nutrition and Metabolism is a field of study and practice focused on the nutritional needs and metabolic processes of patients.</data>
      <data key="d2">e0102bb655b6476ce3296726e3aceb4a</data>
      <data key="d3">1553</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8000</data>
      <data key="d7">e82b5daa3fe5444880adc9ff102b4ca1</data>
    </node>
    <node id="FIABS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Spanish Federation of Food and Beverage Industries (FIABS) represents the interests of the food and beverage sector in Spain.</data>
      <data key="d2">e0102bb655b6476ce3296726e3aceb4a</data>
      <data key="d5">1</data>
      <data key="d6">8001</data>
      <data key="d7">2383d2f428764c35b74f61346cb8d2c5</data>
    </node>
    <node id="REGULACI&#211;N DE LAS DECLARACIONES NUTRICIONALES">
      <data key="d0">EVENT</data>
      <data key="d1">The regulation of nutritional claims aims to standardize how nutritional information is presented to avoid misleading consumers.</data>
      <data key="d2">e0102bb655b6476ce3296726e3aceb4a</data>
      <data key="d5">0</data>
      <data key="d6">8002</data>
      <data key="d7">83f2ca0a69464579989cdfa662668bd8</data>
    </node>
    <node id="NUEVA NORMATIVA">
      <data key="d0">EVENT</data>
      <data key="d1">The new regulation refers to recent changes in food labeling laws that enhance the clarity and visibility of nutritional information.</data>
      <data key="d2">e0102bb655b6476ce3296726e3aceb4a</data>
      <data key="d3">1559</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8003</data>
      <data key="d7">6c04a7c799c54785a840c1a240800277</data>
    </node>
    <node id="PATOLOG&#205;AS ESPEC&#205;FICAS">
      <data key="d0">EVENT</data>
      <data key="d1">Specific pathologies refer to health conditions that can be improved through dietary changes, highlighting the importance of nutrition.</data>
      <data key="d2">e0102bb655b6476ce3296726e3aceb4a</data>
      <data key="d3">1559</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8004</data>
      <data key="d7">ef21339a2056471baeb9e8f75a1a2b13</data>
    </node>
    <node id="AECOSAN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">AECOSAN, or the Agencia Espa&#241;ola de Consumo, Seguridad Alimentaria y Nutrici&#243;n, is the Spanish Agency for Food Safety and Nutrition. This agency is tasked with regulating food safety and ensuring that nutrition standards are upheld in Spain. Its primary role is to oversee and enforce regulations that protect consumers and promote public health related to food consumption.</data>
      <data key="d2">3159307e5633698722f72fde1e82702f,edc9ccbe5d98671343d0119a309cddaf</data>
      <data key="d3">1584</data>
      <data key="d4">2</data>
      <data key="d5">7</data>
      <data key="d6">8005</data>
      <data key="d7">8efcd8a6485f4f2f978ea1089280d801</data>
    </node>
    <node id="FEDERACI&#211;N DE ASOCIACIONES DE CELIACOS DE ESPA&#209;A">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The "FEDERACI&#211;N DE ASOCIACIONES DE CELIACOS DE ESPA&#209;A" (FACE) is the leading organization in Spain dedicated to advocating for the rights and needs of individuals affected by celiac disease. This federation plays a crucial role in raising awareness and providing support for those with the condition. Additionally, FACE offers comprehensive information regarding gluten-free foods and dietary recommendations specifically tailored for celiac patients, ensuring they have access to the necessary resources to manage their health effectively.</data>
      <data key="d2">1387d49a5eae8a32dd81f2f9991a4821,edc9ccbe5d98671343d0119a309cddaf</data>
      <data key="d3">808</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8006</data>
      <data key="d7">97257c7627f640c485b6b6e336697925</data>
    </node>
    <node id="COMPLEJO HOSPITALARIO UNIVERSITARIO DE SANTIAGO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Complex University Hospital of Santiago is a major healthcare facility in Santiago de Compostela, A Coru&#241;a, specializing in various medical fields including endocrinology.</data>
      <data key="d2">edc9ccbe5d98671343d0119a309cddaf</data>
      <data key="d3">1448</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">8007</data>
      <data key="d7">14ac5a8b88b44319b41fff11ece94484</data>
    </node>
    <node id="REGLAMENTO (CE) N&#186; 834/2007">
      <data key="d0">EVENT</data>
      <data key="d1">Reglamento (CE) n&#186; 834/2007 is a regulation regarding the production and labeling of organic products in the European Union.</data>
      <data key="d2">edc9ccbe5d98671343d0119a309cddaf</data>
      <data key="d3">1584</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8008</data>
      <data key="d7">a55c097c216b48b49275dfc9d5e2b7cb</data>
    </node>
    <node id="MANUAL DE ETIQUETADO DE PRODUCTOS ECOL&#211;GICOS">
      <data key="d0">EVENT</data>
      <data key="d1">The Manual de etiquetado de productos ecol&#243;gicos is a guide published by the Junta de Andaluc&#237;a concerning the labeling of organic products.</data>
      <data key="d2">edc9ccbe5d98671343d0119a309cddaf</data>
      <data key="d5">0</data>
      <data key="d6">8009</data>
      <data key="d7">0460a46837704664b42d457607d253ce</data>
    </node>
    <node id="FUNDACI&#211;N VASCA PARA LA SEGURIDAD AGROALIMENTARIA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Fundaci&#243;n Vasca para la Seguridad Agroalimentaria (ELIKA) focuses on food safety and innovation in the Basque Country.</data>
      <data key="d2">edc9ccbe5d98671343d0119a309cddaf</data>
      <data key="d3">1584</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8010</data>
      <data key="d7">b71c571669904b8f92460366974614be</data>
    </node>
    <node id="REGLAMENTO DE EJECUCI&#211;N (CE) NO. 828/2014">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">edc9ccbe5d98671343d0119a309cddaf</data>
      <data key="d3">1584</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8011</data>
      <data key="d7">158d0676de4f4a809c3fbd908b4d0925</data>
    </node>
    <node id="GRUPOS POBLACIONALES SUSCEPTIBLES">
      <data key="d0">EVENT</data>
      <data key="d1">Los grupos poblacionales susceptibles incluyen ancianos, pacientes oncol&#243;gicos y hospitalizados, quienes tienen un mayor riesgo de desnutrici&#243;n.</data>
      <data key="d2">02b61e2d4f840772c76a05502aa4f171</data>
      <data key="d3">1099</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8012</data>
