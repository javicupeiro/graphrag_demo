    </node>
    <node id="J PEN J PARENTER ENTERAL NUTR">
      <data key="d0">EVENT</data>
      <data key="d1">JPEN J Parenter Enteral Nutr is a journal that publishes research related to parenteral and enteral nutrition.</data>
      <data key="d2">bd8df34b86026d71089bcf062570b70f</data>
