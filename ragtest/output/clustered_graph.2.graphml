    </edge>
    <edge source="BARIATRIC SURGERY" target="CUMMINGS DE">
      <data key="d8">6.0</data>
      <data key="d9">Cummings DE has conducted research on the effectiveness of metabolic surgery for treating Type 2 diabetes in obese individuals.</data>
      <data key="d10">a3e3a651e24883d279405241439b58bc</data>
      <data key="d11">749255d7864544b2afe3b3e429d7a92e</data>
      <data key="d12">15337</data>
