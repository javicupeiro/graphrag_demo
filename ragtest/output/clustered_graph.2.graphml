      <data key="d6">3158</data>
      <data key="d7">e9240a9e5db64a62940a336f7db4d3d5</data>
    </node>
    <node id="GERIATRICS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Geriatrics is a branch of medicine that focuses on health care for elderly people, addressing issues like frailty and cognitive decline.</data>
      <data key="d2">b5f705e0ba650f5ad1f558446be0191e</data>
      <data key="d5">0</data>
      <data key="d6">3159</data>
