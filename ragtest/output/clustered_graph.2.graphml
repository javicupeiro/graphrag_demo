      <data key="d9">Axonopathy is a significant neurological manifestation of adrenoleucodistrofia</data>
      <data key="d10">34299d74df25d13e56cd62aab766e618</data>
      <data key="d11">b4503fb7f0064c34851046f1963b5617</data>
      <data key="d12">14546</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADRENOLEUCODISTROFIA" target="ADRENAL INSUFFICIENCY">
      <data key="d8">9.0</data>
      <data key="d9">Adrenal insufficiency is a frequent complication in patients suffering from adrenoleucodistrofia</data>
      <data key="d10">34299d74df25d13e56cd62aab766e618</data>
      <data key="d11">ffb9b8fdc5e640c5909cf5167a3d46a0</data>
      <data key="d12">14547</data>
      <data key="d13">2</data>
    </edge>
