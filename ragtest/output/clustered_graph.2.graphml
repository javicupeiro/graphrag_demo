    <node id="CHYLOUS ASCITES">
      <data key="d0">EVENT</data>
      <data key="d1">Chylous ascites is a medical condition characterized by the accumulation of lymphatic fluid in the abdominal cavity. This condition often necessitates specific diagnosis and management strategies to address the underlying causes and alleviate symptoms.</data>
      <data key="d2">a35fdf8cbbb5fe4783572ea6e86f7776,fba8cc8092875a542f3b63663ce5c8d9</data>
      <data key="d3">735</data>
