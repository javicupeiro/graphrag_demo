    </node>
    <node id="NUTRICI&#211;N ENTERAL HIPERPROTEICA">
      <data key="d0">EVENT</data>
      <data key="d1">Intervenci&#243;n nutricional que puede ser necesaria en caso de desnutrici&#243;n previa al trasplante.</data>
      <data key="d2">b2b9da64e886eb0b5a8b332d2ba9c7fb</data>
