    </edge>
    <edge source="GLYCOGEN STORAGE DISEASE I" target="DIAZOXIDE">
      <data key="d8">7.0</data>
      <data key="d9">DIAZOXIDE is used as a treatment option for patients with Glycogen Storage Disease I who cannot maintain adequate blood glucose levels through diet alone.</data>
