    <node id="DIET ADAPTATION">
      <data key="d0">EVENT</data>
      <data key="d1">Diet adaptation is crucial for patients with dysphagia after diagnosis, focusing on texture, volume, and viscosity of liquids.</data>
      <data key="d2">da965f79110bd8915deff461d0d91187</data>
      <data key="d3">914</data>
