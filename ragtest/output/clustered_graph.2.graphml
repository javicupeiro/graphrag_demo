      <data key="d13">2</data>
    </edge>
    <edge source="ACIDOSIS LACTICA" target="CATABOLISMO">
      <data key="d8">6.0</data>
      <data key="d9">Increased catabolism can lead to lactic acidosis due to the overproduction of lactic acid</data>
      <data key="d10">638e8fa7af82ec833d23c7df72ee9b1f</data>
      <data key="d11">756370c5d6244efdb160c7c8c988874e</data>
      <data key="d12">9412</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACIDOSIS LACTICA" target="GLUCOGENOSIS DE TIPO I">
      <data key="d8">7.0</data>
      <data key="d9">Acidosis l&#225;ctica can occur as a complication in patients with glucogenosis de tipo I</data>
