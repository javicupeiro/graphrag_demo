    <node id="CROMOSOMA 6">
      <data key="d0">GEO</data>
      <data key="d1">El cromosoma 6 es el cromosoma humano donde se localiza el gen CYP21A2, relacionado con la hiperplasia suprarrenal cong&#233;nita.</data>
