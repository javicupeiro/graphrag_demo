    <edge source="FUROSEMIDA" target="HIPONATREMIA EUVOL&#201;MICA">
      <data key="d8">7.0</data>
      <data key="d9">La furosemida se utiliza para tratar la hiponatremia euvol&#233;mica al ayudar a eliminar el exceso de agua del cuerpo.</data>
      <data key="d10">d8ad55d79ba614f2c8906babacf0e9f6</data>
