    <node id="ASOCIACI&#211;N ESPA&#209;OLA DE FAMILIARES Y ENFERMOS DE WILSON">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Asociaci&#243;n Espa&#241;ola de Familiares y Enfermos de Wilson is an organization that provides support for families and patients affected by Wilson's disease, offering resources and information through their website.</data>
      <data key="d2">ed4179754d9e9ed3a2971c762ec54390</data>
      <data key="d3">1792</data>
