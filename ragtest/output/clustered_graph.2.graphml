      <data key="d12">16746</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EURODIET" target="POBLACI&#211;N GENERAL">
      <data key="d8">8.0</data>
      <data key="d9">EURODIET provides dietary recommendations for the general population in Europe</data>
