    </node>
    <node id="CIGARETTE SMOKING">
      <data key="d0">EVENT</data>
      <data key="d1">Cigarette smoking has been identified as an environmental factor that may exacerbate Graves' ophthalmopathy.</data>
      <data key="d2">3c8b29df4105e84d4766d8d632de8535</data>
