    <node id="NUTRICIONES COMERCIALIZADAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Commercial nutrition formulations are ready-to-use mixtures produced by the pharmaceutical industry, containing macronutrients but lacking vitamins and trace elements.</data>
      <data key="d2">12ceae17f5df9d7a1a40ebc43156a35e</data>
