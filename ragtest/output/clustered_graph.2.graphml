      <data key="d7">3813450efe554bb79d1b6cbca4f3da39</data>
    </node>
    <node id="LINFOMA BAJO GRADO">
      <data key="d0">EVENT</data>
      <data key="d1">Linfoma bajo grado refers to low-grade lymphoma, which can also be associated with weight loss.</data>
      <data key="d2">b26b998479da515c234ce46b1bfa73db</data>
