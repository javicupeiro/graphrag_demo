      <data key="d10">3898563966943dbfc8a0f6e84bc627b1</data>
      <data key="d11">a5bef8966cf04e419a1a4d2998c3d6ff</data>
      <data key="d12">18881</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EW" target="ACANTOSIS NIGRICANS">
      <data key="d8">5.0</data>
      <data key="d9">Acanthosis nigricans may be observed in patients with Wilson's disease as a skin manifestation</data>
