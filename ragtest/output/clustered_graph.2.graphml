    <node id="KASPER DL.">
      <data key="d0">PERSON</data>
      <data key="d1">Kasper DL. es un autor que ha contribuido a la literatura m&#233;dica sobre medicina interna, incluyendo temas relacionados con la hiperplasia suprarrenal cong&#233;nita.</data>
      <data key="d2">095d265c06452e52ccbfbc871a19a899</data>
