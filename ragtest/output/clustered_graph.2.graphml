      <data key="d10">65e1359e381a0ac66f53b3a6eeba408b</data>
      <data key="d11">b3bb653b39634c89af056bc1ca2a2374</data>
      <data key="d12">5158</data>
      <data key="d13">2</data>
    </edge>
    <edge source="UNI&#211;N EUROPEA" target="FRAILTY">
      <data key="d8">7.0</data>
      <data key="d9">The concept of frailty is emphasized by the European Union due to its implications for healthcare resources and elderly care.</data>
      <data key="d10">65e1359e381a0ac66f53b3a6eeba408b</data>
      <data key="d11">e0df72380b1c4be881e79616394cf335</data>
      <data key="d12">5159</data>
      <data key="d13">2</data>
    </edge>
