    <edge source="DISFAGIA" target="UMLE">
      <data key="d8">7.0</data>
      <data key="d9">UMLE is an organization that specializes in the treatment and assessment of patients with dysphagia, a condition characterized by difficulty in swallowing. It is involved in providing care specifically tailored for individuals suffering from this condition, ensuring that they receive the necessary support and interventions to manage their dysphagia effectively.</data>
      <data key="d10">42cc35e2edb450d48bb31f7c51b7a02f,98f9ca00cf50b7e359aa41f1d58d0735</data>
      <data key="d11">e25d1a5ad5354dbd817328e5868e6cd1</data>
      <data key="d12">353</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DISFAGIA" target="MALNUTRICI&#211;N">
      <data key="d8">8.0</data>
