    </node>
    <node id="MALNUTRICI&#211;N EN C&#193;NCER">
      <data key="d0">EVENT</data>
      <data key="d1">The study of nutritional needs and interventions for cancer patients, highlighting the prevalence and impact of malnutrition on treatment outcomes.</data>
      <data key="d2">bf234f719a608fc6858d9a1749463539</data>
