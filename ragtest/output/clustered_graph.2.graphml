    <node id="HYPEROXALURIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hyperoxaluria is a condition characterized by excessive oxalate in the urine, which can lead to kidney stones and other complications.</data>
      <data key="d2">6533cbcb76873caf6fd68eb95d313d24</data>
      <data key="d5">1</data>
      <data key="d6">12077</data>
