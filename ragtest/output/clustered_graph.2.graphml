      <data key="d6">9799</data>
      <data key="d7">c69f94135369408e8777c22353c6789c</data>
    </node>
    <node id="MA&#205;Z">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">MA&#205;Z, commonly known as corn, is a gluten-free cereal grain that is safe for individuals with celiac disease. It is widely used in various food products due to its gluten-free properties. In Spanish, it is also referred to as "el ma&#237;z," emphasizing that it is a cereal that does not contain gluten, making it a suitable option for patients with celiac disease.</data>
      <data key="d2">281c46dd2bcde6e6fbb1505ed667b0e9,8eef8cced3d7433de267e8e624813566,f713611b23199b8a9eb9c28377b9f128</data>
