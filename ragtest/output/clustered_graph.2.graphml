      <data key="d12">5581</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GASTROSTOM&#205;A" target="PANCREATITIS">
      <data key="d8">6.0</data>
      <data key="d9">GASTROSTOM&#205;A may be necessary for patients with severe PANCREATITIS who cannot eat</data>
