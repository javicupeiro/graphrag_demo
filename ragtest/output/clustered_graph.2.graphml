    <edge source="CARDIOVASCULAR RISK" target="FITOQU&#205;MICOS">
      <data key="d8">1.0</data>
      <data key="d9">Fitoqu&#237;micos are linked to improved cardiovascular health outcomes.</data>
      <data key="d10">4b79601d85087d62f0d4890761776c04</data>
      <data key="d11">60b29fa959c540409b48631b1b3eaeda</data>
      <data key="d12">17249</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CARDIOVASCULAR RISK" target="NUTS">
      <data key="d8">7.0</data>
      <data key="d9">Nuts are associated with lower cardiovascular risk due to their healthy fat profile.</data>
      <data key="d10">4b79601d85087d62f0d4890761776c04</data>
      <data key="d11">f620cb49b4f6475ea976e8f789763b7e</data>
      <data key="d12">17250</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CARDIOVASCULAR RISK" target="ADDED SUGARS">
      <data key="d8">1.0</data>
      <data key="d9">High consumption of added sugars is associated with obesity and increased cardiovascular risk.</data>
      <data key="d10">4b79601d85087d62f0d4890761776c04</data>
      <data key="d11">c2ec673df03a4a6eba5fb28b93626520</data>
      <data key="d12">17251</data>
      <data key="d13">2</data>
    </edge>
