    <node id="AGP-&#937;3">
      <data key="d0">EVENT</data>
      <data key="d1">AGP-&#969;3 refers to omega-3 fatty acids derived from fish, which are evaluated for their protective effects against coronary disease and sudden death.</data>
      <data key="d2">41d7db510fc74d3763959481cc15ea20</data>
      <data key="d3">1636</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
