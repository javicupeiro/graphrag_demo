    </node>
    <node id="F&#205;STULAS GASTROC&#211;LICAS">
      <data key="d0">EVENT</data>
      <data key="d1">Gastrocolic fistulas are abnormal connections that can develop between the stomach and colon, often as a complication of gastrostomy.</data>
      <data key="d2">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d3">1156</data>
      <data key="d4">2</data>
