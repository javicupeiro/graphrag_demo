      <data key="d7">b9f8e711034b4b4994d9d674ed09b245</data>
    </node>
    <node id="PANCREATITIS CR&#211;NICA">
      <data key="d0">EVENT</data>
      <data key="d1">Chronic pancreatitis, known as "pancreatitis cr&#243;nica," is a long-term inflammatory condition of the pancreas that results in irreversible structural changes. This chronic inflammation can lead to permanent damage, affecting both the exocrine and endocrine functions of the pancreas. As a consequence, individuals with chronic pancreatitis may experience various digestive issues and impaired insulin production, necessitating nutritional support and careful management of their condition.</data>
      <data key="d2">67106be274787fd7f400ce3023c33a3d,71df6da8c96a533357f4380fd6066417,803363886f385b089938bf122246dfa2,dce680808e039e852dc0f2639835db32</data>
      <data key="d3">198</data>
      <data key="d4">1</data>
      <data key="d5">26</data>
      <data key="d6">12234</data>
      <data key="d7">a2fb668128ad4916a32a0adbfad16057</data>
    </node>
    <node id="GL&#193;NDULA PANCRE&#193;TICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The pancreatic gland is responsible for the secretion of digestive enzymes and hormones such as insulin and glucagon, playing a crucial role in metabolism regulation.</data>
      <data key="d2">71df6da8c96a533357f4380fd6066417</data>
      <data key="d3">1094</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">12235</data>
      <data key="d7">66306f97cf8a434bab70a1409c413f64</data>
    </node>
    <node id="ISLOTES DE LANGERHANS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The islets of Langerhans are clusters of cells in the pancreas that produce insulin and glucagon, essential for carbohydrate metabolism regulation.</data>
      <data key="d2">71df6da8c96a533357f4380fd6066417</data>
      <data key="d3">1094</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12236</data>
      <data key="d7">1da2f843f129406e913ca4cff6d21fe8</data>
    </node>
    <node id="C&#193;LCULOS BILIARES">
      <data key="d0">EVENT</data>
      <data key="d1">Gallstones are solid particles that form in the gallbladder and are a leading cause of acute pancreatitis.</data>
      <data key="d2">71df6da8c96a533357f4380fd6066417</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12237</data>
      <data key="d7">2401cb5bc77b432ea365235fb44b865f</data>
    </node>
    <node id="TUMOR DE PAPILA DUODENAL">
      <data key="d0">EVENT</data>
      <data key="d1">Duodenal papilla tumors are another condition that must be considered when diagnosing pancreatitis without a clear cause.</data>
      <data key="d2">71df6da8c96a533357f4380fd6066417</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12238</data>
      <data key="d7">c7edefc9c1804c0cb207179ec4369b21</data>
    </node>
    <node id="DR. JOHN RANSON">
      <data key="d0">PERSON</data>
      <data key="d1">Dr. John Ranson established criteria in 1974 to evaluate the severity and prognosis of pancreatitis, identifying patients at high risk of complications.</data>
      <data key="d2">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d3">1198</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12239</data>
      <data key="d7">276689aac24444c2a262e3c49caf2d26</data>
    </node>
    <node id="ACUTE PHYSIOLOGY AND CHRONIC HEALTH EVALUATION II">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Acute Physiology and Chronic Health Evaluation II (APACHE II) is a system used to quantify the severity of illness in critically ill patients, which is adjusted with the body mass index.</data>
      <data key="d2">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d3">1198</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12240</data>
      <data key="d7">eb36fa54699145ba86425b0533979440</data>
    </node>
    <node id="PANCREATITIS ALCOHOLICA">
      <data key="d0">EVENT</data>
      <data key="d1">Pancreatitis alcoholica refers to pancreatitis caused by excessive alcohol consumption, with specific criteria for severity.</data>
      <data key="d2">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d3">1198</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12241</data>
      <data key="d7">09a43239fe8a48bea6c1fb937e303dd3</data>
    </node>
    <node id="PANCREATITIS BILIAR">
      <data key="d0">EVENT</data>
      <data key="d1">Pancreatitis biliar is pancreatitis caused by gallstones, with its own set of severity criteria.</data>
      <data key="d2">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d3">1198</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12242</data>
      <data key="d7">4593790089fd409393339e67cef6bc80</data>
    </node>
    <node id="BALTHAZAR CLASSIFICATION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Balthazar classification is a system used to assess the severity of pancreatitis based on imaging findings.</data>
      <data key="d2">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d3">1198</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12243</data>
      <data key="d7">de0047655f1f47d0b91d507e30e52a69</data>
    </node>
    <node id="LEUCOCITOSIS">
      <data key="d0">EVENT</data>
      <data key="d1">Leucocitosis is a condition characterized by an elevated white blood cell count, often observed in patients with pancreatitis as part of the inflammatory response.</data>
      <data key="d2">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d3">1198</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12244</data>
      <data key="d7">8db3a9dcc3b24e3383f5ac482590ddb3</data>
    </node>
    <node id="ECOGRAF&#205;A ABDOMINAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ecograf&#237;a abdominal is an imaging technique used to detect alterations in the gallbladder and bile duct, helping to determine the origin of pancreatitis.</data>
      <data key="d2">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d3">1198</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12245</data>
      <data key="d7">4c88e78727504b62a1a6658ecbbe24f8</data>
    </node>
