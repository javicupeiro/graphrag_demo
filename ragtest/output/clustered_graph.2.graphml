    <edge source="SENPE" target="NUTRICIONES PARENTERALES ADULTOS PROTOCOLIZADAS EN EL HOSPITAL">
      <data key="d8">7.0</data>
      <data key="d9">SENPE provides guidelines that inform the protocol for adult parenteral nutrition in hospitals</data>
      <data key="d10">3f3896c039ea7ef78de8bf5fb6e09a48</data>
      <data key="d11">a3863dce625546d29d1d359cef8f1649</data>
