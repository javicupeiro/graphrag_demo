    <node id="PACIENTE DE 56 A&#209;OS">
      <data key="d0">PERSON</data>
      <data key="d1">Una paciente de 56 a&#241;os que presenta s&#237;ntomas compatibles con el s&#237;ndrome de Cushing, incluyendo aumento de peso, equimosis y hipertensi&#243;n arterial.</data>
      <data key="d2">1de72f0ea3a981289854857b691b52af</data>
