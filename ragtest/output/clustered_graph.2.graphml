      <data key="d10">8778654a17a48b8ea7b1cec378d52346</data>
      <data key="d11">017a3518370843e6969dc838027d8040</data>
      <data key="d12">16798</data>
      <data key="d13">2</data>
    </edge>
    <edge source="USDA" target="NUTRISOL">
      <data key="d8">7.0</data>
      <data key="d9">NUTRISOL utilizes USDA's food composition database for dietary surveys and analysis</data>
      <data key="d10">6da89a24c60015649c1d669e4e23fb2d</data>
      <data key="d11">71bc6e7340554ac888dc789c773b6435</data>
      <data key="d12">16799</data>
