    </node>
    <node id="TRILOSTANO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Trilostano is a medication that blocks the synthesis of adrenal steroid hormones, indicated for the treatment of hyperadrenocorticism in dogs due to Cushing's disease.</data>
      <data key="d2">dbe034ccd694ae06cf72d347d7dbdacb</data>
      <data key="d3">1332</data>
      <data key="d4">2</data>
