      <data key="d7">3a35a089ab1a47359849e9bf6f133815</data>
    </node>
    <node id="DIETA OLIGOPEPT&#205;DICA">
      <data key="d0">EVENT</data>
      <data key="d1">Dieta oligopept&#237;dica is a specialized diet consisting of short-chain peptides, used for patients with malabsorption issues or specific gastrointestinal conditions.</data>
      <data key="d2">f7ca532ae3a834fd6643ad694d3e850c</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
