      <data key="d0">ORGANIZATION</data>
      <data key="d1">Diabetic diets for small children are designed for children under 6 years with diabetes.</data>
      <data key="d2">4e7560a799f319bdc8ae25737acc4d05</data>
      <data key="d3">1150</data>
