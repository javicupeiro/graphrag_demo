    <edge source="CALIDAD DE VIDA" target="PACIENTES CR&#211;NICOS">
      <data key="d8">6.0</data>
      <data key="d9">Chronic patients' quality of life can be significantly impacted by their health conditions and the care they receive</data>
      <data key="d10">29c2dd6ce196c0166033a861582e9721</data>
      <data key="d11">67aec748dbce4c998fe100d821495b01</data>
