    </node>
    <node id="MYSIMBA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Mysimba is the European name for the combination of bupropion and naltrexone used for weight management.</data>
      <data key="d2">488970234520652b063db88e8346031c</data>
      <data key="d3">314</data>
