    <edge source="MORBIMORTALIDAD" target="CITOQUINAS PROINFLAMATORIAS">
      <data key="d8">5.0</data>
      <data key="d9">Pro-inflammatory cytokines increase during inflammation, which can lead to higher rates of morbimortalidad in critically ill patients</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">34963a63dfc043638eee2fbba1f85110</data>
      <data key="d12">1347</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="HORMONAS CONTRARREGULADORAS">
      <data key="d8">5.0</data>
      <data key="d9">Counter-regulatory hormones are involved in the stress response, which can impact the health outcomes of critically ill patients</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">1337fca7240d41788ef3fa71478be7d1</data>
      <data key="d12">1348</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="GLUC&#211;GENOLISIS">
      <data key="d8">5.0</data>
      <data key="d9">Increased glycogenolysis can affect glucose levels and overall metabolism in critically ill patients, influencing morbimortalidad</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">cd34391c559c49b8b50621d4ac5a0b41</data>
      <data key="d12">1349</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="GLUCONEOGENESIS">
      <data key="d8">5.0</data>
      <data key="d9">Heightened gluconeogenesis can impact energy availability in critically ill patients, affecting their health outcomes</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">6fee049fc4ff40998f75f8ca874df5c3</data>
      <data key="d12">1350</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="LIP&#211;LISIS">
      <data key="d8">5.0</data>
      <data key="d9">Increased lipolysis can affect fat metabolism in critically ill patients, which may influence their overall health and morbimortalidad</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">d52882197adb4154b1fd18d6d6462b2a</data>
      <data key="d12">1351</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="RESISTENCIA A LA INSULINA">
      <data key="d8">5.0</data>
      <data key="d9">Insulin resistance can complicate metabolic processes in critically ill patients, contributing to higher rates of morbimortalidad</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">abdf874353044af3a3120889aa968444</data>
      <data key="d12">1352</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="GLUTAMINA">
      <data key="d8">5.0</data>
      <data key="d9">Depletion of glutamine can affect immune function in critically ill patients, potentially increasing morbimortalidad</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">4a0c7222b6ba4461b3e4714982a3757f</data>
      <data key="d12">1353</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="INFECCIONES">
      <data key="d8">8.0</data>
      <data key="d9">Infections are a significant factor in increasing morbidity and mortality rates in critically ill patients</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">50505e3332e046d299b3602066a954d0</data>
      <data key="d12">1354</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="DISFUNCI&#211;N MULTIORG&#193;NICA">
      <data key="d8">9.0</data>
      <data key="d9">Multi-organ dysfunction is a critical condition that can lead to increased mortality in critically ill patients</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">613c3d7eed6c457ea00aad41b9ef5350</data>
      <data key="d12">1355</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="TIEMPO DE HOSPITALIZACI&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">Prolonged hospitalization is often associated with higher morbidity and mortality rates in critically ill patients</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">9e668d2ef4604f10805d8ec84291c781</data>
      <data key="d12">1356</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="DA&#209;O OXIDATIVO CELULAR">
      <data key="d8">6.0</data>
      <data key="d9">Cellular oxidative damage can contribute to complications and increased mortality in critically ill patients</data>
      <data key="d10">25192e60a2c23bd74095f4602efeac4c</data>
      <data key="d11">903ad99a54cb4b37a8c44d94d7fa6b2e</data>
      <data key="d12">1357</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="SOPORTE NUTRICIONAL">
      <data key="d8">7.0</data>
      <data key="d9">Effective nutritional support can help reduce morbimortalidad in critically ill patients</data>
      <data key="d10">21e6d7085f520d8a2f415746dc7eab71</data>
      <data key="d11">e9728ebd7d034abf9b742a04e0e6a9eb</data>
      <data key="d12">1358</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="C&#193;NCER G&#193;STRICO">
      <data key="d8">1.0</data>
      <data key="d9">El mal estado nutricional en pacientes con c&#225;ncer g&#225;strico se asocia con una mayor morbimortalidad</data>
      <data key="d10">70a9e916b8c55784c53828958c76eb09</data>
      <data key="d11">7ac7f9e5257d4d4fb288dbd4c279e019</data>
      <data key="d12">1359</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="SOPORTE NUTRICIONAL AVANZADO">
      <data key="d8">6.0</data>
      <data key="d9">Advanced nutritional support can influence the morbidity and mortality associated with underlying health conditions by improving immune function.</data>
      <data key="d10">d2f16314e7098030a6780411d2e03023</data>
      <data key="d11">2a21531a458f418bad9684dc8f1fadb4</data>
      <data key="d12">1360</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORBIMORTALIDAD" target="HIPONATREMIA">
      <data key="d8">7.0</data>
      <data key="d9">Hyponatremia is linked to higher morbidity and mortality rates in hospital populations</data>
      <data key="d10">e5a3c206a42a0c2ba4df914b54591a3b</data>
      <data key="d11">f725d87255ba4a2f8a9e768642b63cb7</data>
      <data key="d12">1361</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AISLAMIENTO" target="MALNUTRICI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">Isolation negatively affects the nutritional habits of the elderly, contributing to malnutrition.</data>
      <data key="d10">b6180d67d6fdf45ff73aa2a63a8e3f74</data>
      <data key="d11">fd276a5cf021459aabeeb9435eea9741</data>
      <data key="d12">1362</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="DEGLUCI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">Alimentaci&#243;n (eating) is directly related to the process of degluci&#243;n (swallowing)</data>
      <data key="d10">afc1e23538d13759662d0a4ea2d45191</data>
      <data key="d11">3e82a305f6b0441f866773ae801404a1</data>
      <data key="d12">1363</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="NUTRITIONAL ASSESSMENT">
      <data key="d8">8.0</data>
      <data key="d9">Alimentaci&#243;n is evaluated during nutritional assessment to determine dietary status</data>
      <data key="d10">67f60ae11335cf41da4f96400b69e67b</data>
      <data key="d11">6b09b44a87e1482eaeb16e3e2e995bf2</data>
      <data key="d12">1364</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="VISCOCIDAD">
      <data key="d8">1.0</data>
      <data key="d9">Viscosity adjustments are essential in modifying the texture of food and liquids for dysphagia patients</data>
      <data key="d10">362634b4b8ce951770d2a81e572f15b2</data>
      <data key="d11">1b045275bf4a4f76a3be8b9f48a3322a</data>
      <data key="d12">1365</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="SERVICIO DE COCINA">
      <data key="d8">9.0</data>
      <data key="d9">The kitchen service is responsible for the preparation and delivery of meals to patients</data>
      <data key="d10">aacbc2a88a21cd749df3c22de5daea04</data>
      <data key="d11">21d7d560215d48bc8cfe83211c45871b</data>
      <data key="d12">1366</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="SISTEMA NACIONAL DE SALUD">
      <data key="d8">1.0</data>
      <data key="d9">The National Health System promotes healthy eating habits as part of its public health initiatives.</data>
      <data key="d10">6d174de24d62997808908333da591120</data>
      <data key="d11">0fcc671eaa89436baa4578d6bd9feeae</data>
      <data key="d12">1367</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="PRETERM INFANT">
      <data key="d8">1.0</data>
      <data key="d9">Alimentaci&#243;n encompasses the feeding practices necessary for the health and growth of preterm infants</data>
      <data key="d10">ea5e972294754a47333efb4c580cf15c</data>
      <data key="d11">fe89addd82434e9ebe2f561d758ca512</data>
      <data key="d12">1368</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="OMS">
      <data key="d8">1.0</data>
      <data key="d9">La OMS promueve pr&#225;cticas de alimentaci&#243;n saludable como parte de sus iniciativas de salud p&#250;blica</data>
      <data key="d10">91131751d701592a597bae807e00c1dc</data>
      <data key="d11">8f07b10b8af44870a43028fce0cd95e3</data>
      <data key="d12">1369</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="MUCOSITIS">
      <data key="d8">6.0</data>
      <data key="d9">Mucositis can significantly impact the dietary management and nutritional support for affected patients</data>
      <data key="d10">5aa4da1a8d1e0b60ec7e801c7db1701c</data>
      <data key="d11">f913e438ce2f489297a16a0a980c9f21</data>
      <data key="d12">1370</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="PANCREATITIS CR&#211;NICA">
      <data key="d8">8.0</data>
      <data key="d9">Alimentaci&#243;n strategies are essential for managing symptoms and nutritional needs in patients with pancreatitis cr&#243;nica</data>
      <data key="d10">67106be274787fd7f400ce3023c33a3d</data>
      <data key="d11">e0e3c932181740e2872a0b59b0784c26</data>
      <data key="d12">1371</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="HIDRATACI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">Una buena alimentaci&#243;n es esencial para mantener un nivel adecuado de hidrataci&#243;n en el cuerpo.</data>
      <data key="d10">364aa13581a973c2e55c25191bad27cc</data>
      <data key="d11">b2e388240e5247ada6e64c712b2a06c8</data>
      <data key="d12">1372</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N" target="NUTRICI&#211;N ENTERAL">
      <data key="d8">16.0</data>
      <data key="d9">ALIMENTACI&#211;N and NUTRICI&#211;N ENTERAL refer to enteral nutrition, which is a method of providing nutritional support when oral feeding is not possible. This specific form of nutrition is particularly important for patients who are unable to eat by mouth, including pediatric patients who require nutritional support. Enteral nutrition ensures that these individuals receive the necessary nutrients to maintain their health and well-being when traditional feeding methods are not viable.</data>
      <data key="d10">29b85b34282f79a12349b7e1d967b1a7,4fbc9ba7c1f3ff190b594c75e7eac015,6a5102072d17111dafe768ab7d38f41a</data>
      <data key="d11">47f046adcaea439abe6a44703912cdea</data>
      <data key="d12">1373</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="NEUROANATOM&#205;A">
      <data key="d8">1.0</data>
      <data key="d9">La neuroanatom&#237;a es fundamental para entender c&#243;mo las lesiones afectan el proceso de degluci&#243;n.</data>
      <data key="d10">665ed3c8d60f8ac770c48c9f59596eea</data>
      <data key="d11">35878c0740cb47b6a594858fafbf4cf3</data>
      <data key="d12">1374</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="PATIENCE">
      <data key="d8">8.0</data>
      <data key="d9">The patient is being assessed for their swallowing capabilities through the degluci&#243;n tests</data>
      <data key="d10">db12fd42641d2de0cee5f33601bfb6dc</data>
      <data key="d11">73eb8285b4f64f7589e2a432863c13d5</data>
      <data key="d12">1375</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="FARINGE">
      <data key="d8">9.0</data>
      <data key="d9">The pharynx, also known as "DEGLUCI&#211;n," is a critical anatomical structure involved in the act of swallowing. It plays an essential role in the swallowing process by facilitating the movement of food from the mouth to the esophagus. This function is vital for proper digestion and overall health, highlighting the importance of the pharynx in the digestive system.</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90,b2fcedcb1399bd22a82d188227aa9fad</data>
      <data key="d11">d3bf555ab2eb4862ba60c81dd78a8212</data>
      <data key="d12">1376</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="ANATOM&#205;A">
      <data key="d8">7.0</data>
      <data key="d9">Understanding anatomy is essential for evaluating and treating swallowing disorders</data>
      <data key="d10">b2fcedcb1399bd22a82d188227aa9fad</data>
      <data key="d11">32732f3ed6ee448ea9be5528a980a489</data>
      <data key="d12">1377</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="FISIOLOG&#205;A">
      <data key="d8">7.0</data>
      <data key="d9">Physiology is crucial for understanding how swallowing functions and identifying issues</data>
      <data key="d10">b2fcedcb1399bd22a82d188227aa9fad</data>
      <data key="d11">3535de241360446f99b99ac66c468788</data>
      <data key="d12">1378</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="T&#201;CNICAS DE MEJORA SENSORIAL">
      <data key="d8">6.0</data>
      <data key="d9">Sensory enhancement techniques are applied to improve the swallowing process</data>
      <data key="d10">b2fcedcb1399bd22a82d188227aa9fad</data>
      <data key="d11">11c9f866273e418f87dbc8a50402e0bb</data>
      <data key="d12">1379</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="MANIOBRAS DE DEGLUCI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">Swallowing maneuvers are used to facilitate safer and more effective swallowing</data>
      <data key="d10">b2fcedcb1399bd22a82d188227aa9fad</data>
      <data key="d11">0dcc78430c6e4540901123ab798392e1</data>
      <data key="d12">1380</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="OMNIPAQUE">
      <data key="d8">7.0</data>
      <data key="d9">Omnipaque is used as a contrast medium in diagnostic procedures related to swallowing</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90</data>
      <data key="d11">d91c240b36c6496c9f331dfcccb24b36</data>
      <data key="d12">1381</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="ESF&#205;NTER ESOF&#193;GICO SUPERIOR">
      <data key="d8">9.0</data>
      <data key="d9">The upper esophageal sphincter plays a critical role in the swallowing process by controlling the passage of food</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90</data>
      <data key="d11">15161885cfe64386820becc24f79b549</data>
      <data key="d12">1382</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="DIVERT&#205;CULO DE ZENKER">
      <data key="d8">6.0</data>
      <data key="d9">Zenker's diverticulum can interfere with the swallowing process, causing symptoms</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90</data>
      <data key="d11">2eb2c105f75c4ae5adb71c6e52385045</data>
      <data key="d12">1383</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="ENFERMEDADES NEUROMUSCULARES">
      <data key="d8">8.0</data>
      <data key="d9">Neuromuscular diseases can impair the swallowing process, affecting the reflex and muscle strength</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90</data>
      <data key="d11">1cd5dc30a78e4dee847d9a767ff7c329</data>
      <data key="d12">1384</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="PRUEBAS DIAGN&#211;STICAS INSTRUMENTALES">
      <data key="d8">7.0</data>
      <data key="d9">Instrumental diagnostic tests are essential for assessing swallowing function and identifying issues</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90</data>
      <data key="d11">db1ac1b98d144f299230dcf90afcdc4e</data>
      <data key="d12">1385</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="V&#205;A A&#201;REA">
      <data key="d8">8.0</data>
      <data key="d9">The airway is involved in the swallowing process, and issues can arise if food enters the airway</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90</data>
      <data key="d11">b908698481804bc9bdb071210666f8ca</data>
      <data key="d12">1386</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="RESIDUO">
      <data key="d8">6.0</data>
      <data key="d9">The presence of residue after swallowing indicates potential problems with the swallowing mechanism</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90</data>
      <data key="d11">18aa42bc5fa8429db605ad77a95c36ca</data>
      <data key="d12">1387</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="FASES DE LA DEGLUCI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">Understanding the phases of swallowing is crucial for diagnosing and treating swallowing disorders</data>
      <data key="d10">63bd8dcdc323614f5359e4978e154e90</data>
      <data key="d11">7e1069f8002a4c908cc51e342d6e5558</data>
      <data key="d12">1388</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="CEREBRO HUMANO">
      <data key="d8">8.0</data>
      <data key="d9">El cerebro humano se activa durante el proceso de degluci&#243;n, respondiendo a las propiedades reol&#243;gicas del bolo alimenticio.</data>
      <data key="d10">bc20bf64107d944924272321bba4ab25</data>
      <data key="d11">2381f42fdb1643fcbdd4dee1053d8662</data>
      <data key="d12">1389</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="BOLLO ALIMENTICIO">
      <data key="d8">9.0</data>
      <data key="d9">El bolo alimenticio es el resultado del proceso de degluci&#243;n, donde se forma y se traga.</data>
      <data key="d10">bc20bf64107d944924272321bba4ab25</data>
      <data key="d11">79a64568df054acda20326c401eadcbe</data>
      <data key="d12">1390</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="ELECTROENCEFALOGRAF&#205;A">
      <data key="d8">7.0</data>
      <data key="d9">La electroencefalograf&#237;a ha demostrado patrones de actividad cerebral espec&#237;ficos relacionados con el proceso de degluci&#243;n.</data>
      <data key="d10">bc20bf64107d944924272321bba4ab25</data>
      <data key="d11">b3f24c7059cd4f6b821f323c42790606</data>
      <data key="d12">1391</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="IM&#193;GENES CEREBRALES">
      <data key="d8">8.0</data>
      <data key="d9">Las im&#225;genes cerebrales muestran que la sensaci&#243;n del gusto activa &#225;reas del cerebro durante la degluci&#243;n.</data>
      <data key="d10">bc20bf64107d944924272321bba4ab25</data>
      <data key="d11">774676159aa647ebb8962656fde91ca4</data>
      <data key="d12">1392</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="M&#201;TODOS PSICOF&#205;SICOS">
      <data key="d8">1.0</data>
      <data key="d9">Los m&#233;todos psicof&#237;sicos son relevantes para la evaluaci&#243;n de la degluci&#243;n y las propiedades sensoriales de los alimentos.</data>
      <data key="d10">bc20bf64107d944924272321bba4ab25</data>
      <data key="d11">7c40d0c2345d4f38b2d282ffa0b6d9c7</data>
      <data key="d12">1393</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="ESPESANTES">
      <data key="d8">8.0</data>
      <data key="d9">Swallowing can be improved with the use of thickeners, which modify the viscosity of liquids to ensure safety.</data>
      <data key="d10">c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">df3ee9bf158145d6b05812aee0d1fc84</data>
      <data key="d12">1394</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="BOL">
      <data key="d8">7.0</data>
      <data key="d9">The bolus is formed during the swallowing process, and its consistency can be affected by the viscosity of thickeners.</data>
      <data key="d10">c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">8a2a16ec75074b6fb7f6d8ae3689eade</data>
      <data key="d12">1395</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="PACIENTE">
      <data key="d8">16.0</data>
      <data key="d9">The entity "DEGLUCI&#211;n" refers to the act of swallowing, which is particularly relevant for "PACIENTE" (patients) experiencing dysphagia. Patients with dysphagia require assistance in performing the act of degluci&#243;n through specific techniques designed to facilitate swallowing. As part of their treatment for oropharyngeal dysphagia, these patients must actively engage in the swallowing process. This active participation is crucial for their recovery and management of the condition.</data>
      <data key="d10">28e2e3a92ef4dd76af0898ae3e3df522,c6fc88c88f73b50820517647aa8f4959</data>
      <data key="d11">e1fac00f9e5c439b9c692cd4abc1b5fb</data>
      <data key="d12">1396</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="EJERCICIOS DE POTENCIACI&#211;N DE LA LENGUA">
      <data key="d8">7.0</data>
      <data key="d9">Tongue strengthening exercises are essential for improving the swallowing process</data>
      <data key="d10">0d5d152382113aa1b8faab4e554c88cd</data>
      <data key="d11">896186eefe5f400ea586fba4749db4f9</data>
      <data key="d12">1397</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="MUCOSITIS">
      <data key="d8">7.0</data>
      <data key="d9">Mucositis can lead to difficulties in degluci&#243;n, affecting the patient's ability to eat</data>
      <data key="d10">5aa4da1a8d1e0b60ec7e801c7db1701c</data>
      <data key="d11">5785b3d6dc2a415d8cd196ea035e6faa</data>
      <data key="d12">1398</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUCI&#211;N" target="HOSPITALIZACI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">Hospitalization may be necessary for patients with impaired degluci&#243;n due to treatment complications</data>
      <data key="d10">5aa4da1a8d1e0b60ec7e801c7db1701c</data>
      <data key="d11">7550170fe4df48f9ac7d691923ecdcf2</data>
      <data key="d12">1399</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NERVIO VAGO" target="C&#211;RTEX">
      <data key="d8">7.0</data>
      <data key="d9">El c&#243;rtex controla el inicio y facilitaci&#243;n de la degluci&#243;n, que involucra la actividad del nervio vago.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">f958f6be7b7b4df7bd4611146586f913</data>
      <data key="d12">1400</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NERVIO VAGO" target="M&#218;SCULOS INFRAHIOIDEOS">
      <data key="d8">6.0</data>
      <data key="d9">El nervio vago proporciona inervaci&#243;n a los m&#250;sculos infrahioideos que ayudan en la recuperaci&#243;n de la configuraci&#243;n respiratoria tras la degluci&#243;n.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">6d8e52e7362c420f898ff813abcbada4</data>
      <data key="d12">1401</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="TRIG&#201;MINO">
      <data key="d8">5.0</data>
      <data key="d9">El nervio trig&#233;mino participa en la masticaci&#243;n, que es el primer paso en la formaci&#243;n del bolo alimenticio.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">c88599efe7d24fb999620d9211e8c0d0</data>
      <data key="d12">1402</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="FACIAL">
      <data key="d8">5.0</data>
      <data key="d9">El nervio facial ayuda en la motilidad de los labios y mejillas, que son esenciales para la formaci&#243;n del bolo alimenticio.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">f29cba41c88d4b668416a2a141dfdabe</data>
      <data key="d12">1403</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="GLOSOFAR&#205;NGEO">
      <data key="d8">5.0</data>
      <data key="d9">El nervio glosofar&#237;ngeo proporciona inervaci&#243;n a la faringe, que es crucial para el paso del bolo alimenticio.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">e4578b08d7d24ca49cea83b1ae62a792</data>
      <data key="d12">1404</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="HIPOGLOSO">
      <data key="d8">1.0</data>
      <data key="d9">El nervio hipogloso inerva la lengua, que es fundamental para mover el bolo alimenticio hacia el es&#243;fago.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">77bbc6cb8435491d98d290f02bebf663</data>
      <data key="d12">1405</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="LARINGE">
      <data key="d8">9.0</data>
      <data key="d9">La laringe se cierra durante la degluci&#243;n para evitar que el bolo alimenticio entre en las v&#237;as respiratorias.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">51dd5dc0ded54241ae82358cb5568db3</data>
      <data key="d12">1406</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="EPIGLOTIS">
      <data key="d8">9.0</data>
      <data key="d9">La epiglotis bloquea la laringe durante la degluci&#243;n, dirigiendo el bolo alimenticio hacia el es&#243;fago.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">bf5c6dc38c674eb0b381df2ee9e8e004</data>
      <data key="d12">1407</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="PALADAR">
      <data key="d8">7.0</data>
      <data key="d9">El paladar ayuda a cerrar la cavidad nasal durante la degluci&#243;n, facilitando el paso del bolo alimenticio.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">fb9593dd43a7464b8edd44ec3dbc1fb8</data>
      <data key="d12">1408</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="NERVIOS CRANEALES">
      <data key="d8">1.0</data>
      <data key="d9">Los nervios craneales proporcionan la inervaci&#243;n necesaria para los m&#250;sculos que participan en la degluci&#243;n del bolo alimenticio.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">883f6d706b4f4ec1a41af5d4c99527ce</data>
      <data key="d12">1409</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="PROPIEDADES REOL&#211;GICAS">
      <data key="d8">7.0</data>
      <data key="d9">Las propiedades reol&#243;gicas influyen en la formaci&#243;n y percepci&#243;n del bolo alimenticio durante la degluci&#243;n.</data>
      <data key="d10">bc20bf64107d944924272321bba4ab25</data>
      <data key="d11">3870cd981bf2406c8b0404ebd5d0ba7d</data>
      <data key="d12">1410</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLO ALIMENTICIO" target="AN&#193;LISIS DE PERFIL DE TEXTURA">
      <data key="d8">6.0</data>
      <data key="d9">El an&#225;lisis de perfil de textura se utiliza para evaluar c&#243;mo las propiedades del bolo alimenticio afectan su percepci&#243;n sensorial.</data>
      <data key="d10">bc20bf64107d944924272321bba4ab25</data>
      <data key="d11">d6ce0be859214f558165516d47d373da</data>
      <data key="d12">1411</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ES&#211;FAGO" target="FARINGE">
      <data key="d8">8.0</data>
      <data key="d9">La faringe act&#250;a como un conducto que permite el paso del bolo alimenticio hacia el es&#243;fago durante la degluci&#243;n.</data>
      <data key="d10">d2aaa88e54c474e2077b1e3791828964</data>
      <data key="d11">52b76cbcf41d42c9a81644cc2c519d31</data>
      <data key="d12">1412</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LARINGE" target="VED">
      <data key="d8">7.0</data>
      <data key="d9">The larynx is assessed during the VED to evaluate its role in the swallowing process.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">ec5651ec18b84183b3594c28feb83b25</data>
      <data key="d12">1413</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FARINGE" target="VED">
      <data key="d8">7.0</data>
      <data key="d9">The pharynx is one of the anatomical structures evaluated during the VED process for swallowing assessment.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">5b6a10f93e064b8ea3503bba0a74b015</data>
      <data key="d12">1414</data>
      <data key="d13">2</data>
    </edge>
    <edge source="N&#218;CLEO DEL TRACTO SOLITARIO" target="CEREBRO">
      <data key="d8">8.0</data>
      <data key="d9">El n&#250;cleo del tracto solitario es una parte del cerebro que integra informaci&#243;n sensorial y motora relacionada con la degluci&#243;n</data>
      <data key="d10">f8f8f31481daf6b8d0cc5e103a31b2a9</data>
      <data key="d11">042a57eb1d204e4c8c2dfe4afa060465</data>
      <data key="d12">1415</data>
      <data key="d13">2</data>
    </edge>
    <edge source="N&#218;CLEO DEL TRACTO SOLITARIO" target="CORTEX CEREBRAL">
      <data key="d8">8.0</data>
      <data key="d9">El cortex cerebral env&#237;a se&#241;ales al n&#250;cleo del tracto solitario para iniciar la respuesta de degluci&#243;n</data>
      <data key="d10">f8f8f31481daf6b8d0cc5e103a31b2a9</data>
      <data key="d11">e8aa4c9aeb6c4dec83fa1ec57e119335</data>
      <data key="d12">1416</data>
      <data key="d13">2</data>
    </edge>
    <edge source="N&#218;CLEO DEL TRACTO SOLITARIO" target="FORMACI&#211;N RETICULAR">
      <data key="d8">7.0</data>
      <data key="d9">La formaci&#243;n reticular est&#225; relacionada con el n&#250;cleo del tracto solitario en la regulaci&#243;n de la degluci&#243;n y la respiraci&#243;n</data>
      <data key="d10">f8f8f31481daf6b8d0cc5e103a31b2a9</data>
      <data key="d11">e642e7bdd60145bc81307e701d6eb717</data>
      <data key="d12">1417</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="RESONANCIA MAGN&#201;TICA">
      <data key="d8">6.0</data>
      <data key="d9">La resonancia magn&#233;tica se utiliza para estudiar la actividad del cerebro en relaci&#243;n con la degluci&#243;n</data>
      <data key="d10">f8f8f31481daf6b8d0cc5e103a31b2a9</data>
      <data key="d11">73e1a44093d74a239906a84e43e56391</data>
      <data key="d12">1418</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="ESTIMULACI&#211;N MAGN&#201;TICA TRANSCRANEAL">
      <data key="d8">1.0</data>
      <data key="d9">La estimulaci&#243;n magn&#233;tica transcraneal se aplica para investigar la funci&#243;n cerebral en el contexto de la degluci&#243;n</data>
      <data key="d10">f8f8f31481daf6b8d0cc5e103a31b2a9</data>
      <data key="d11">f3453b2d0ca744fda5ee61f986c5b973</data>
      <data key="d12">1419</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="GANGLIOS BASALES">
      <data key="d8">6.0</data>
      <data key="d9">Los ganglios basales est&#225;n involucrados en el control motor y pueden afectar la funci&#243;n de degluci&#243;n</data>
      <data key="d10">f8f8f31481daf6b8d0cc5e103a31b2a9</data>
      <data key="d11">a3a645bd82724630911ae5128ba099f0</data>
      <data key="d12">1420</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="T&#193;LAMO">
      <data key="d8">6.0</data>
      <data key="d9">El t&#225;lamo act&#250;a como un centro de relevo para la informaci&#243;n sensorial que influye en la degluci&#243;n</data>
      <data key="d10">f8f8f31481daf6b8d0cc5e103a31b2a9</data>
      <data key="d11">66b59d6d22a545cfbcc6e7c2767426df</data>
      <data key="d12">1421</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="CEREBELO">
      <data key="d8">1.0</data>
      <data key="d9">El cerebelo coordina los movimientos necesarios para la degluci&#243;n y est&#225; conectado con otras &#225;reas del cerebro</data>
      <data key="d10">f8f8f31481daf6b8d0cc5e103a31b2a9</data>
      <data key="d11">47712a54c4b8452fbbb9204751813162</data>
      <data key="d12">1422</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="N&#218;CLEO ARCUATO">
      <data key="d8">7.0</data>
      <data key="d9">The arcuate nucleus is a part of the brain that plays a crucial role in appetite regulation</data>
      <data key="d10">a63d12481faecf7a11206d83de199360</data>
      <data key="d11">f341f621002442d79b09c1bb9778c0f6</data>
      <data key="d12">1423</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="ALD">
      <data key="d8">8.0</data>
      <data key="d9">Cerebro is the primary organ affected by ALD, leading to neurological decline</data>
      <data key="d10">0745ce31d3922cbba1497dbe1d2845de</data>
      <data key="d11">43e1229d4c9644cebe59766f29800a05</data>
      <data key="d12">1424</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="CUPROENZIMAS">
      <data key="d8">8.0</data>
      <data key="d9">Cuproenzyme activity is crucial for various biochemical processes occurring in the brain, including neurotransmitter metabolism</data>
      <data key="d10">d2916698f201a31d6bb74619a3fa064b</data>
      <data key="d11">ac84db4795df4678a85f57f4eaa3b84e</data>
      <data key="d12">1425</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREBRO" target="ENFERMEDAD DE WILSON">
      <data key="d8">8.0</data>
      <data key="d9">The brain is affected by Wilson's disease due to copper accumulation, leading to neurological symptoms</data>
      <data key="d10">071b24f95071bec88fffa3ee7cbcde41</data>
      <data key="d11">3b0dc2d0b0b94842962028128c4ad3d5</data>
      <data key="d12">1426</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RESONANCIA MAGN&#201;TICA" target="CIRROSIS HEP&#193;TICA">
      <data key="d8">8.0</data>
      <data key="d9">MRI can help diagnose liver cirrhosis and assess liver damage in patients with hereditary hemochromatosis.</data>
      <data key="d10">9610fe47fea8bd5de48277db4233764c</data>
      <data key="d11">456c5da5abd54d0da29737f2dafc8fd9</data>
      <data key="d12">1427</data>
      <data key="d13">2</data>
    </edge>
    <edge source="T&#193;LAMO" target="NUTRICI&#211;N ENTERAL">
      <data key="d8">7.0</data>
      <data key="d9">El t&#225;lamo regula aspectos de la alimentaci&#243;n y la degluci&#243;n, que son importantes en el contexto de la nutrici&#243;n enteral.</data>
      <data key="d10">29b85b34282f79a12349b7e1d967b1a7</data>
      <data key="d11">c7f6175fc4a04741b9d304be9c890dfe</data>
      <data key="d12">1428</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CORTEX CEREBRAL" target="NUTRICI&#211;N ENTERAL">
      <data key="d8">1.0</data>
      <data key="d9">La corteza cerebral est&#225; involucrada en el desarrollo de la conducta alimentaria, lo que es relevante para la nutrici&#243;n enteral en ni&#241;os.</data>
      <data key="d10">29b85b34282f79a12349b7e1d967b1a7</data>
      <data key="d11">2a21d6555cfd486cabdba69fb3c2b298</data>
      <data key="d12">1429</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACIDENTE CEREBROVASCULAR" target="PLASTICIDAD NEURONAL">
      <data key="d8">8.0</data>
      <data key="d9">La plasticidad neuronal es un factor importante en la recuperaci&#243;n funcional despu&#233;s de un accidente cerebrovascular.</data>
      <data key="d10">665ed3c8d60f8ac770c48c9f59596eea</data>
      <data key="d11">e09a70f59a1649b2833559bd4cdb9529</data>
      <data key="d12">1430</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE PARKINSON" target="EES">
      <data key="d8">8.0</data>
      <data key="d9">La enfermedad de Parkinson afecta la capacidad de interrumpir el tono vagal que mantiene cerrado el EES</data>
      <data key="d10">cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">df9c3ff186e24f2b8ed07f80ea1d35e6</data>
      <data key="d12">1431</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE PARKINSON" target="EUROPEAN SOCIETY FOR CLINICAL NUTRITION AND METABOLISM">
      <data key="d8">8.0</data>
      <data key="d9">ESPEN provides guidelines for managing nutritional support in patients with Parkinson's disease</data>
      <data key="d10">59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">42d09337b85148f4bddf25703b0e82db</data>
      <data key="d12">1432</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE PARKINSON" target="SWALLOWING DISTURBANCE QUESTIONNAIRE">
      <data key="d8">7.0</data>
      <data key="d9">The Swallowing Disturbance Questionnaire is recommended for screening dysphagia in Parkinson's disease patients</data>
      <data key="d10">59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">7c971370de834479bd38ff890855d8a6</data>
      <data key="d12">1433</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE PARKINSON" target="DYSPHAGIA TEST-PARKINSON'S DISEASE">
      <data key="d8">7.0</data>
      <data key="d9">The Dysphagia Test for Parkinson's Disease is specifically designed for assessing swallowing issues in Parkinson's patients</data>
      <data key="d10">59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">08fa807e7b9b44f0908df3be9cdc61ab</data>
      <data key="d12">1434</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE PARKINSON" target="FIBEROPTIC ENDOSCOPIC EVALUATION OF SWALLOWING">
      <data key="d8">6.0</data>
      <data key="d9">FEES is recommended for instrumental assessment of swallowing in patients with Parkinson's disease</data>
      <data key="d10">59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">1e5885562d92442ea724a84bc0cccdfd</data>
      <data key="d12">1435</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE PARKINSON" target="VIDEOFLOUROSCOPIA">
      <data key="d8">6.0</data>
      <data key="d9">Videofluoroscopy is an alternative assessment method for swallowing in Parkinson's patients when FEES is not feasible</data>
      <data key="d10">59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">9598b8a05a7541b789bb6be7f8d985d1</data>
      <data key="d12">1436</data>
      <data key="d13">2</data>
    </edge>
    <edge source="P. CLAV&#201;" target="MECV-V">
      <data key="d8">6.0</data>
      <data key="d9">P. Clav&#233; modified the MECV-V method for swallowing assessment</data>
      <data key="d10">4befdcd21a98898cec30bbac7b402d4b</data>
      <data key="d11">f4badfa13c1243bcbb4222a455bc1eea</data>
      <data key="d12">1437</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="EUROPEAN SOCIETY FOR CLINICAL NUTRITION AND METABOLISM">
      <data key="d8">16.0</data>
      <data key="d9">The European Society for Clinical Nutrition and Metabolism (ESPEN) offers guidelines for nutritional support tailored specifically for patients with Esclerosis Lateral Amiotr&#243;fica (ELA), also known as amyotrophic lateral sclerosis (ALS). These guidelines include nutritional recommendations aimed at improving the care and quality of life for individuals diagnosed with this condition.</data>
      <data key="d10">02d838eb7d60f4fe558e304b6b6933e8,59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">806623fd202343e1b0a2fd32372a144b</data>
      <data key="d12">1438</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="SWALLOWING DISTURBANCE QUESTIONNAIRE">
      <data key="d8">6.0</data>
      <data key="d9">The Swallowing Disturbance Questionnaire is relevant for assessing dysphagia in ALS patients</data>
      <data key="d10">59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">c3c375436a8240d8be6d9e229b9bb5ae</data>
      <data key="d12">1439</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="FIBEROPTIC ENDOSCOPIC EVALUATION OF SWALLOWING">
      <data key="d8">6.0</data>
      <data key="d9">FEES is utilized for evaluating swallowing in ALS patients</data>
      <data key="d10">59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">bcc6a84907314b7e83731127cfc0bc03</data>
      <data key="d12">1440</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="VIDEOFLOUROSCOPIA">
      <data key="d8">1.0</data>
      <data key="d9">Videofluoroscopy is employed to assess swallowing function in ALS patients</data>
      <data key="d10">59a97e6bf8748a66eb335bec2852ce38</data>
      <data key="d11">7781addb6ff54bb5bebaa7f09f4ce21e</data>
      <data key="d12">1441</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="NADYA">
      <data key="d8">5.0</data>
      <data key="d9">NADYA's research includes the impact of ALS on malnutrition and dysphagia</data>
      <data key="d10">9449ed00392e250aa871c689af51a540</data>
      <data key="d11">640f4cf9647240b6b18008ad93c1ea2a</data>
      <data key="d12">1442</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="NUTRICI&#211;N ENTERAL">
      <data key="d8">1.0</data>
      <data key="d9">NE is crucial for managing the nutritional needs of patients with ELA</data>
      <data key="d10">02d838eb7d60f4fe558e304b6b6933e8</data>
      <data key="d11">6886ec45645f4e2a87553a75a3d7ad08</data>
      <data key="d12">1443</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="DIETOTERAPIA">
      <data key="d8">8.0</data>
      <data key="d9">La dietoterapia es especialmente importante en los estadios tempranos de la esclerosis lateral amiotr&#243;fica para optimizar la ingesta nutricional</data>
      <data key="d10">1adf391b13598f3ffe28ae596ff49438</data>
      <data key="d11">51105f9297f7467ba0916f1f755cbc7c</data>
      <data key="d12">1444</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="NUTRICI&#211;N PARENTERAL">
      <data key="d8">7.0</data>
      <data key="d9">La nutrici&#243;n parenteral se utiliza en pacientes con esclerosis lateral amiotr&#243;fica en estado terminal para estabilizar el peso</data>
      <data key="d10">1adf391b13598f3ffe28ae596ff49438</data>
      <data key="d11">b6096bce077244d6afcabfe3dd5323e6</data>
      <data key="d12">1445</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="GASTROSTOM&#205;A">
      <data key="d8">6.0</data>
      <data key="d9">La gastrostom&#237;a se recomienda en pacientes con esclerosis lateral amiotr&#243;fica que sufren de desnutrici&#243;n severa o disfagia</data>
      <data key="d10">1adf391b13598f3ffe28ae596ff49438</data>
      <data key="d11">5a1ac942288e44338ee78b46e4e733cf</data>
      <data key="d12">1446</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="SNG">
      <data key="d8">5.0</data>
      <data key="d9">La SNG es la v&#237;a de elecci&#243;n para pacientes con esclerosis lateral amiotr&#243;fica en mal estado general que no pueden someterse a procedimientos m&#225;s invasivos</data>
      <data key="d10">1adf391b13598f3ffe28ae596ff49438</data>
      <data key="d11">f7082e76207d406583d8fc8fe26e0b30</data>
      <data key="d12">1447</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="MICRONUTRIENTES">
      <data key="d8">1.0</data>
      <data key="d9">Los micronutrientes son esenciales para el desarrollo y funcionamiento del sistema nervioso, lo que es relevante en el contexto de la esclerosis lateral amiotr&#243;fica</data>
      <data key="d10">1adf391b13598f3ffe28ae596ff49438</data>
      <data key="d11">d59293f4b3d549409fb1297f628d72f0</data>
      <data key="d12">1448</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESCLEROSIS LATERAL AMIOTR&#211;FICA" target="SUPORTE NUTRICIONAL">
      <data key="d8">8.0</data>
      <data key="d9">El soporte nutricional es fundamental para mejorar la supervivencia en pacientes con esclerosis lateral amiotr&#243;fica</data>
      <data key="d10">1adf391b13598f3ffe28ae596ff49438</data>
      <data key="d11">ed6e45f9acb84ea3834882e22f2bb271</data>
      <data key="d12">1449</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="P. CALV&#201;">
      <data key="d8">7.0</data>
      <data key="d9">P. Calv&#233; ha investigado y defendido el an&#225;lisis de la apertura del EES mediante videofluoroscopia</data>
      <data key="d10">cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">c11e07cb860f4fa7b17ba33be3ce4a3f</data>
      <data key="d12">1450</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="DIVERT&#205;CULO DE ZENKER">
      <data key="d8">6.0</data>
      <data key="d9">El divert&#237;culo de Zenker puede causar fibrosis del EES, afectando su distensibilidad</data>
      <data key="d10">cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">e842561503f14f678da2220b82505f3f</data>
      <data key="d12">1451</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="ENFERMEDAD DE CROHN">
      <data key="d8">5.0</data>
      <data key="d9">La enfermedad de Crohn puede causar problemas en la apertura del EES</data>
      <data key="d10">cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">1d520ae953d348eaa7fd046194bffb34</data>
      <data key="d12">1452</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="MIOPAT&#205;A POR CUERPOS DE INCLUSI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">La miopat&#237;a por cuerpos de inclusi&#243;n puede estar relacionada con la disfunci&#243;n del EES</data>
      <data key="d10">cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">3c36514feb0f4f679ae7ac0aec0779a1</data>
      <data key="d12">1453</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="M&#218;SCULOS SUPRAHIOIDEOS">
      <data key="d8">7.0</data>
      <data key="d9">La debilidad de los m&#250;sculos suprahioideos afecta la apertura del EES, especialmente en ancianos</data>
      <data key="d10">cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">a80c4c393c2e4f3fa866e2cf0c4d0adf</data>
      <data key="d12">1454</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="MANOMETR&#205;A">
      <data key="d8">15.0</data>
      <data key="d9">The EES, or esophageal sphincter, is evaluated through manometry, a diagnostic procedure that assesses its function and relaxation capacity. This assessment is crucial for diagnosing swallowing disorders, as it provides valuable insights into the performance of the EES.</data>
      <data key="d10">c4707350a1cb759e58f3d611445992ba,cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">82a3a9ae6755492d81c665fac059fec6</data>
      <data key="d12">1455</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="RESIDUOS POSTDEGLUCI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">Los residuos postdegluci&#243;n pueden ser un indicativo de problemas en la apertura del EES</data>
      <data key="d10">cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">01b053fc4038419aa5959b6b40c444f3</data>
      <data key="d12">1456</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="ASPIRACI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">La aspiraci&#243;n puede ocurrir debido a una apertura anormal del EES, lo que representa un riesgo para la salud</data>
      <data key="d10">cad4abc24b98ed3e82ec4c199dd49698</data>
      <data key="d11">94a5a979f8f5492c956e53841be1fd11</data>
      <data key="d12">1457</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EES" target="DOF">
      <data key="d8">7.0</data>
      <data key="d9">The upper esophageal sphincter is involved in the swallowing process and can be affected in patients with dysphagia oropharyngeal</data>
      <data key="d10">c257fcbbfdc5ac2678d371cee5c12edf</data>
      <data key="d11">ffce051ad43d40b7a3ac79c1443aa5df</data>
      <data key="d12">1458</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="VITAMINA E">
      <data key="d8">6.0</data>
      <data key="d9">Crohn's disease can lead to malabsorption of vitamin E, affecting health.</data>
      <data key="d10">c879b2e3799c9353091ac931a92a99e8</data>
      <data key="d11">a2e1b97aba784d5ab21f4ba40ad0fb30</data>
      <data key="d12">1459</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="FODMAP">
      <data key="d8">6.0</data>
      <data key="d9">FODMAPs may also be relevant in managing symptoms for patients with Enfermedad de Crohn</data>
      <data key="d10">6c98e1347f14c72617198a910cf8c246</data>
      <data key="d11">350e979dde234b3f98488c24a663829a</data>
      <data key="d12">1460</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="SII">
      <data key="d8">4.0</data>
      <data key="d9">Both SII and Enfermedad de Crohn are gastrointestinal conditions that may be influenced by dietary factors, including FODMAPs</data>
      <data key="d10">6c98e1347f14c72617198a910cf8c246</data>
      <data key="d11">daf3bc7098304af6b7b1343cdc7f7aa4</data>
      <data key="d12">1461</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="DIARREA CR&#211;NICA">
      <data key="d8">7.0</data>
      <data key="d9">La enfermedad de Crohn puede causar diarrea cr&#243;nica como uno de sus s&#237;ntomas</data>
      <data key="d10">449c8567a3aa59b49fbe65b7a3a26d46</data>
      <data key="d11">c299dd5edd884c18b34bfffc65ce2f88</data>
      <data key="d12">1462</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="ENFERMEDAD INFLAMATORIA INTESTINAL">
      <data key="d8">23.0</data>
      <data key="d9">Crohn's disease, known in Spanish as "enfermedad de Crohn," is a specific type of inflammatory bowel disease (IBD), which falls under the broader category of chronic inflammatory diseases. It is characterized by its ability to affect any part of the digestive tract, leading to a range of symptoms and complications. Additionally, Crohn's disease is associated with nutritional deficiencies, which can arise due to the inflammation and damage it causes within the gastrointestinal system. Overall, Crohn's disease is a significant form of inflammatory bowel disease that impacts both the digestive health and nutritional status of affected individuals.</data>
      <data key="d10">609140cabbcd0c7297a7029f5365d186,88647cc4d1748c5bb058d4aab1817d63,a519216aaee7bf8a1317f5d6b522c4b6</data>
      <data key="d11">86837194e1b24f708b9a15b83652843f</data>
      <data key="d12">1463</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="COLITIS ULCEROSA">
      <data key="d8">8.0</data>
      <data key="d9">Enfermedad de Crohn and colitis ulcerosa are both types of inflammatory bowel diseases (IBD) that exhibit similar symptoms and treatment approaches. While they share common characteristics, they also possess distinct differences. Both conditions can lead to inflammation of the gastrointestinal tract, but they differ in their specific locations and the nature of the inflammation. Overall, understanding these similarities and differences is crucial for effective diagnosis and management of these conditions.</data>
      <data key="d10">a519216aaee7bf8a1317f5d6b522c4b6,ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">1c401cfc166640968111cfe99593c715</data>
      <data key="d12">1464</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="AMINOSALICILATOS">
      <data key="d8">8.0</data>
      <data key="d9">Aminosalicylic drugs are used in the treatment of enfermedad de Crohn to manage symptoms and maintain remission.</data>
      <data key="d10">ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">02aa685adf984e9abc5184eaaa72b2da</data>
      <data key="d12">1465</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="ANEMIA">
      <data key="d8">6.0</data>
      <data key="d9">Anemia can occur in patients with enfermedad de Crohn due to chronic inflammation and nutrient deficiencies.</data>
      <data key="d10">ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">786503c94a1e4ebfb4fd3bdf89306fe7</data>
      <data key="d12">1466</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="OSTEOPOROSIS">
      <data key="d8">1.0</data>
      <data key="d9">Osteoporosis can develop in patients with enfermedad de Crohn due to chronic inflammation and malabsorption issues.</data>
      <data key="d10">ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">4c27287241964ace878c7047fea326f1</data>
      <data key="d12">1467</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="FIEBRE">
      <data key="d8">4.0</data>
      <data key="d9">Fever can occur in patients with enfermedad de Crohn, often indicating an active inflammatory process.</data>
      <data key="d10">ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">f6f2e26b1cb5485ca6eaf0088d95d981</data>
      <data key="d12">1468</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="DOLOR ABDOMINAL">
      <data key="d8">8.0</data>
      <data key="d9">Abdominal pain is a common symptom in enfermedad de Crohn, often varying based on the location of the disease.</data>
      <data key="d10">ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">af47e26248a442a28d45cb01332adadc</data>
      <data key="d12">1469</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="DIARREA">
      <data key="d8">8.0</data>
      <data key="d9">Diarrhea is a frequent symptom in enfermedad de Crohn, often multifactorial in nature.</data>
      <data key="d10">ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">4872faade734460892e25eada4dc880e</data>
      <data key="d12">1470</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="PERDIDA DE PESO">
      <data key="d8">6.0</data>
      <data key="d9">Weight loss is a common issue in patients with enfermedad de Crohn, often due to malabsorption and chronic symptoms.</data>
      <data key="d10">ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">4c70424f31934359a8491810cfe2ec09</data>
      <data key="d12">1471</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="NUTRICI&#211;N ENTERAL">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional support through enteral nutrition is used as a primary treatment for Crohn's disease to prevent malnutrition and induce remission</data>
      <data key="d10">4ec3e8cb1f21808e70bbc71cb26d7396</data>
      <data key="d11">9508e597bf6b4380bb9e506d90cee7c0</data>
      <data key="d12">1472</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="S&#205;NDROME DE INTESTINO CORTO">
      <data key="d8">4.0</data>
      <data key="d9">La enfermedad de Crohn puede causar complicaciones que contribuyen al desarrollo del s&#237;ndrome de intestino corto</data>
      <data key="d10">ace4abd79441a61d6688d67db2dc0747</data>
      <data key="d11">4b103e09fa784c28a43492d94fae7113</data>
      <data key="d12">1473</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD DE CROHN" target="NUTRICI&#211;N PARENTERAL">
      <data key="d8">8.0</data>
      <data key="d9">La enfermedad de Crohn puede causar malnutrici&#243;n y requerir nutrici&#243;n parenteral en casos severos donde la alimentaci&#243;n oral no es suficiente.</data>
      <data key="d10">dbd97c366d747303c58ef40ebfd44ea5</data>
      <data key="d11">3f3cbee6a3b1480e8ddf28fc9f6feafa</data>
      <data key="d12">1474</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANOMETR&#205;A" target="ESF&#205;NTER ESOF&#193;GICO INFERIOR">
      <data key="d8">7.0</data>
      <data key="d9">La manometr&#237;a eval&#250;a la presi&#243;n y la funci&#243;n del esf&#237;nter esof&#225;gico inferior, que es crucial para prevenir el reflujo.</data>
      <data key="d10">dbe1af2b277e06c9d447af56351e496f</data>
      <data key="d11">40e4343a9bb24eeb9b306a22b02919c6</data>
      <data key="d12">1475</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANOMETR&#205;A" target="ESF&#205;NTER ESOF&#193;GICO SUPERIOR">
      <data key="d8">7.0</data>
      <data key="d9">La manometr&#237;a se utiliza para estudiar la funci&#243;n del esf&#237;nter esof&#225;gico superior en pacientes con disfagia.</data>
      <data key="d10">dbe1af2b277e06c9d447af56351e496f</data>
      <data key="d11">d7f54631430045d4afea8b33ec74d485</data>
      <data key="d12">1476</data>
