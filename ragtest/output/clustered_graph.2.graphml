    </node>
    <node id="MANOMETRY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Manometry is a diagnostic test that measures the pressure within the esophagus and can help in diagnosing rumination syndrome.</data>
      <data key="d2">44d6374ee887ebef4cba5ec2a31f0673</data>
