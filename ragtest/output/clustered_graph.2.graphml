      <data key="d10">3dfc700a2eaec232c05b0a53f2089229</data>
      <data key="d11">7b48b86aafa048c0ac6a7191eb0a51a5</data>
      <data key="d12">5733</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES" target="PANCREATIC RESECTION">
      <data key="d8">8.0</data>
      <data key="d9">Pancreatic resection can lead to the development of diabetes due to the loss of insulin-producing cells</data>
      <data key="d10">3dfc700a2eaec232c05b0a53f2089229</data>
      <data key="d11">44e4e1bd733947d996f4b8e224a18876</data>
