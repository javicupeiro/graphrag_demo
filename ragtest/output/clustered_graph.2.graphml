    </edge>
    <edge source="FRUCTOSA" target="MALABSORCI&#211;N DE FRUCTOSA">
      <data key="d8">8.0</data>
      <data key="d9">Malabsorci&#243;n de fructosa is directly related to the consumption of fructosa, which can lead to gastrointestinal symptoms</data>
      <data key="d10">033a22e7215395479d0775d6a1a2563e</data>
      <data key="d11">9a1cde31e3b04682a68a9021683e190f</data>
      <data key="d12">16872</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUCTOSA" target="GLUCOGENOSIS DE TIPO I">
