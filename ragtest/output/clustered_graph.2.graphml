      <data key="d11">bd4fefa84f324e2fb28c6c0159741491</data>
      <data key="d12">17858</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SGLT1" target="MALABSORCI&#211;N DE GLUCOSA-GALACTOSA">
      <data key="d8">8.0</data>
      <data key="d9">SGLT1 is the transporter that is mutated in glucose-galactose malabsorption, leading to the condition</data>
      <data key="d10">e329b5d4c64709889680df357bd1cc09</data>
      <data key="d11">4305ed25ab0043f08834eaf6b62ba102</data>
      <data key="d12">17859</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALTODEXTRINAS" target="BEBIDAS DEPORTIVAS">
      <data key="d8">8.0</data>
      <data key="d9">Maltodextrins are used in sports drinks to provide a quick source of energy and improve hydration.</data>
      <data key="d10">cfe1de28f01fa6428be1486b6af8f0a2</data>
      <data key="d11">633904521d0c45eaa9d44135cb8fef7b</data>
      <data key="d12">17860</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SACARASA-ISOMALTASA" target="DISAC&#193;RIDAS">
      <data key="d8">1.0</data>
      <data key="d9">Sacarasa-isomaltasa is responsible for the digestion of disac&#225;ridas, including lactose</data>
      <data key="d10">6ff2742793c37a38db1c11c14d2a6629</data>
      <data key="d11">120c678b2ed4400c896bd8680db43e1c</data>
      <data key="d12">17861</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SACARASA-ISOMALTASA" target="D&#201;FICIT CONG&#201;NITO">
      <data key="d8">8.0</data>
      <data key="d9">The congenital deficit is directly related to the malfunction of the sacarasa-isomaltasa enzyme, leading to symptoms upon sucrose intake.</data>
      <data key="d10">a079902e52676a05df746098c930a0e7</data>
      <data key="d11">1e1a16f0cf4b43e4a6b701da46ebc984</data>
      <data key="d12">17862</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SACARASA-ISOMALTASA" target="D&#201;FICIT SECUNDARIO">
      <data key="d8">6.0</data>
      <data key="d9">The secondary deficit can affect the activity of sacarasa-isomaltasa due to intestinal pathologies, impacting its enzymatic function.</data>
      <data key="d10">a079902e52676a05df746098c930a0e7</data>
      <data key="d11">fcc0c87ebecf4f76a3adb588a79c8d51</data>
      <data key="d12">17863</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CITOPLASMA" target="AGCC">
      <data key="d8">5.0</data>
