      <data key="d7">bec6555b6f3f4960959195d1f483e5b7</data>
    </node>
    <node id="ACADEMY OF NUTRITION AND DIETETICS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Academy of Nutrition and Dietetics is a professional organization for food and nutrition professionals, which publishes research and guidelines related to diet and nutrition.</data>
      <data key="d2">694f957b0b008ab3339e5bf1fd57b81a</data>
      <data key="d3">85</data>
      <data key="d4">1</data>
