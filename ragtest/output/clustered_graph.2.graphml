      <data key="d6">14601</data>
      <data key="d7">4851609a346f484b98aeb5dac36f20c7</data>
    </node>
    <node id="COMPLICACIONES DE LAS SONDAS DE YEYUNOSTOM&#205;A">
      <data key="d0">EVENT</data>
      <data key="d1">Complicaciones de las sondas de yeyunostom&#237;a refer to potential issues that can arise from the use of feeding tubes in the jejunum, including obstruction and infection.</data>
      <data key="d2">a956cded459a9729e0f2f62707249acc</data>
      <data key="d3">1146</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14602</data>
      <data key="d7">fae5f656e81c485187c3f153cb80d3eb</data>
    </node>
    <node id="CAT&#201;TER FINO">
      <data key="d0">EVENT</data>
      <data key="d1">Cat&#233;ter fino is a thin tube used in medical procedures, particularly in yeyunostom&#237;a, to facilitate feeding directly into the jejunum.</data>
      <data key="d2">a956cded459a9729e0f2f62707249acc</data>
      <data key="d3">1146</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14603</data>
