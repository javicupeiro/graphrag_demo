    <node id="LA FE UNIVERSITY AND POLYTECHNIC HOSPITAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">La Fe University and Polytechnic Hospital is associated with educational and medical training, focusing on advanced healthcare practices.</data>
      <data key="d2">820640c45c3a696fca3c8c45b680b19b</data>
