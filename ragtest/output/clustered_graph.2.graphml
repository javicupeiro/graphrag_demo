    </node>
    <node id="ADRENAL GLANDS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The adrenal glands are endocrine glands that produce hormones, including cortisol, and are involved in Cushing's syndrome.</data>
      <data key="d2">9ff14a3c49bd56b2fb12b3fd8ed246de</data>
