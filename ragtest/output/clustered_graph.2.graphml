      <data key="d10">5cab61b11d03ef705141159d100ae7c5</data>
      <data key="d11">f79f6e84de69445ea08e3f5adbca6814</data>
      <data key="d12">8651</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIERRO" target="MICRONUTRIENT DEFICIENCY">
      <data key="d8">7.0</data>
      <data key="d9">Iron deficiency is a common type of micronutrient deficiency after bariatric surgery</data>
      <data key="d10">bd26f1257d0d7f3e1de6624b3b4a3cc2</data>
      <data key="d11">71f0e9d8ae0b44919f5f9ca492a2535b</data>
      <data key="d12">8652</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIERRO" target="INSUFICIENCIA RENAL AGUDA">
      <data key="d8">1.0</data>
      <data key="d9">El control de los niveles de hierro es crucial en pacientes con insuficiencia renal aguda para prevenir anemia</data>
      <data key="d10">9f77fc213da2123b013166c181a60323</data>
      <data key="d11">5d82cf961a8e408bb639906b0742ece8</data>
      <data key="d12">8653</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIERRO" target="ENFERMEDAD CELIACA">
      <data key="d8">8.0</data>
      <data key="d9">La malabsorci&#243;n en la enfermedad cel&#237;aca puede llevar a deficiencia de hierro, contribuyendo a la anemia</data>
      <data key="d10">4335489f570bb14684484e76cd6c196f</data>
      <data key="d11">2fafd24b67cc4b05b34629540f0cbd7d</data>
