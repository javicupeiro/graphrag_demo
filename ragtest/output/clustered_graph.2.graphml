      <data key="d0">ORGANIZATION</data>
      <data key="d1">Mini Nutritional Assessment Short Form Revised is a tool used to assess the nutritional status of elderly patients.</data>
      <data key="d2">5277ea34ef65b7d029950f2c905c6732</data>
