      <data key="d9">Patients receiving enteral nutrition often experience constipation</data>
      <data key="d10">09e9623b3facc5045e80541b1cd2cada</data>
      <data key="d11">121dd43010f74afe87810eac345d0658</data>
      <data key="d12">3504</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="FIBRA">
      <data key="d8">6.0</data>
