      <data key="d6">6387</data>
      <data key="d7">afef4925553e46f8a98967f52144534f</data>
    </node>
    <node id="FORMACI&#211;N EN NUTRICI&#211;N CL&#205;NICA">
      <data key="d0">EVENT</data>
      <data key="d1">Training in clinical nutrition is essential for healthcare professionals to effectively manage patients' dietary needs.</data>
      <data key="d2">a5ee3f91f8571820c338a8db4d3db09d</data>
      <data key="d3">1080</data>
