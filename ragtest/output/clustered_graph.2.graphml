      <data key="d7">74b8bd3d63024230888bbfe51e2551f9</data>
    </node>
    <node id="MORBIMORTALIDAD CARDIOVASCULAR">
      <data key="d0">EVENT</data>
      <data key="d1">Morbimortalidad cardiovascular refers to the incidence of morbidity and mortality associated with cardiovascular diseases.</data>
      <data key="d2">41d7db510fc74d3763959481cc15ea20</data>
      <data key="d3">310</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">10824</data>
      <data key="d7">f6a9449c1da24695b88a31c1e5dd321a</data>
    </node>
    <node id="ANTIGREGANTES PLAQUETARIOS">
      <data key="d0">EVENT</data>
      <data key="d1">Antigregantes plaquetarios are medications that prevent blood clots by inhibiting platelet aggregation, used in cardiovascular disease management.</data>
      <data key="d2">41d7db510fc74d3763959481cc15ea20</data>
      <data key="d3">310</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
