    <node id="AMILASA (ALFA)">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Alpha-amylase is an enzyme that helps digest carbohydrates, included in pancreatic enzyme preparations for patients with pancreatic insufficiency.</data>
