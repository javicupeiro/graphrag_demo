      <data key="d7">f8864a5fb856402eaa12514f874568a5</data>
    </node>
    <node id="PUBLIC HEALTH NUTR">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Public Health Nutr is a peer-reviewed journal that focuses on research related to public health nutrition.</data>
      <data key="d2">8cdedff25a6a366c17615073d05a5aa2</data>
      <data key="d3">1500</data>
      <data key="d4">2</data>
