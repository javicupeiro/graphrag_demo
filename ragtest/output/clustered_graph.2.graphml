    </node>
    <node id="DRENAJES">
      <data key="d0">EVENT</data>
      <data key="d1">Medical devices used to remove fluids from the body, which require careful monitoring in patients with FEC.</data>
      <data key="d2">c031cb3bc7513b4a3f8e4f264c00a675</data>
      <data key="d3">656</data>
      <data key="d4">2</data>
