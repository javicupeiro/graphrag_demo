      <data key="d9">BN requires caution in patients with generalized anxiety disorder</data>
      <data key="d10">f44811ae5b3e9dab0f295efe8842767a</data>
      <data key="d11">09ca9048f26e4370988f417d05466654</data>
      <data key="d12">17222</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIGHT STUDY" target="2022">
      <data key="d8">1.0</data>
      <data key="d9">The LIGHT study is expected to provide results by 2022 regarding the safety of BN</data>
      <data key="d10">f44811ae5b3e9dab0f295efe8842767a</data>
      <data key="d11">49564beb6c2b4066b4a23a5d2abbceec</data>
      <data key="d12">17223</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIGHT STUDY" target="CARDIOVASCULAR EVENTS">
      <data key="d8">8.0</data>
      <data key="d9">The LIGHT study monitors major cardiovascular events in patients treated with BN</data>
      <data key="d10">f44811ae5b3e9dab0f295efe8842767a</data>
      <data key="d11">7dcded14976e418c9790294bc2ef7378</data>
      <data key="d12">17224</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="17-BETA ESTRADIOL">
      <data key="d8">8.0</data>
      <data key="d9">17-Beta Estradiol is used in hormone replacement therapy for patients with Anorexia Nervosa to improve bone mass</data>
      <data key="d10">bb6a2caec3fa27e00fc1044b17147ccb</data>
      <data key="d11">244be8f10f334cf6821c1b2f4f2f56e8</data>
      <data key="d12">17225</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="DHEAS">
      <data key="d8">5.0</data>
      <data key="d9">DHEAS has been studied for its effects when used with oral contraceptives in patients with Anorexia Nervosa</data>
      <data key="d10">bb6a2caec3fa27e00fc1044b17147ccb</data>
      <data key="d11">151bfce2971c463ca5c70bbae2e3fa36</data>
      <data key="d12">17226</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="TERIPARATIDE">
      <data key="d8">7.0</data>
      <data key="d9">Teriparatide is a medication that has been demonstrated to increase bone density and improve bone mass in women suffering from anorexia nervosa. Research indicates that this treatment can lead to significant enhancements in bone health for individuals affected by this eating disorder, addressing one of the critical health concerns associated with anorexia nervosa.</data>
      <data key="d10">203ff7a2671a44d48a1a326f469c5543,bb6a2caec3fa27e00fc1044b17147ccb</data>
      <data key="d11">cfade6de9d274c47bf1d031905ac9785</data>
      <data key="d12">17227</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="NUTRITIONAL REHABILITATION">
      <data key="d8">18.0</data>
      <data key="d9">Anorexia nervosa is a serious eating disorder characterized by an intense fear of gaining weight and a distorted body image, leading to self-imposed starvation and excessive weight loss. Nutritional rehabilitation is a key intervention in the treatment of anorexia nervosa, playing a crucial role in the recovery process. This approach is essential for addressing the disorder, as it focuses on weight recovery and the restoration of menstrual function. Through nutritional rehabilitation, individuals with anorexia nervosa can begin to restore their physical health and improve their overall well-being.</data>
      <data key="d10">0692eb750371d46b9fff71ec305df6ce,bb6a2caec3fa27e00fc1044b17147ccb</data>
      <data key="d11">80aaf6cbee214ff59e15fe8ade46ad9c</data>
      <data key="d12">17228</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="BONE DENSITOMETRY">
      <data key="d8">8.0</data>
      <data key="d9">Bone densitometry is recommended for patients with Anorexia Nervosa to evaluate bone density after prolonged amenorrhea</data>
      <data key="d10">bb6a2caec3fa27e00fc1044b17147ccb</data>
      <data key="d11">2fe70e287f094ae6ad3c08f45ce033ba</data>
      <data key="d12">17229</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="SOCIETY OF MEDICINE OF ADOLESCENTS">
      <data key="d8">8.0</data>
      <data key="d9">The Society of Medicine of Adolescents provides recommendations for the treatment of Anorexia Nervosa in adolescents</data>
      <data key="d10">770e8796aac9c96d967ef99d1f307e06</data>
      <data key="d11">a07298b430e84fd381b2e0e4bb7bb302</data>
      <data key="d12">17230</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="SEINHAUSEN HC">
      <data key="d8">5.0</data>
      <data key="d9">Seinhausen HC has studied the outcomes of Anorexia Nervosa, particularly in the 20th century</data>
      <data key="d10">770e8796aac9c96d967ef99d1f307e06</data>
      <data key="d11">28788dec114d402f9d4123b34a68762f</data>
      <data key="d12">17231</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="MEHLER PS">
      <data key="d8">8.0</data>
      <data key="d9">Mehler PS has researched the medical complications of Anorexia Nervosa</data>
      <data key="d10">770e8796aac9c96d967ef99d1f307e06</data>
      <data key="d11">b30f7920111a4394801791794999bfc8</data>
      <data key="d12">17232</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="ZIPFEL S">
      <data key="d8">1.0</data>
      <data key="d9">Zipfel S has studied the effects of Anorexia Nervosa on bone health</data>
      <data key="d10">770e8796aac9c96d967ef99d1f307e06</data>
      <data key="d11">1ec125cadff84aecb254821efae63647</data>
      <data key="d12">17233</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="REFEEDING SYNDROME">
      <data key="d8">14.0</data>
      <data key="d9">Refeeding syndrome is a potential complication that can arise during the treatment of anorexia nervosa, particularly when nutritional rehabilitation is initiated. This syndrome poses a risk during the refeeding process, highlighting the importance of careful management and monitoring in individuals recovering from anorexia nervosa.</data>
      <data key="d10">0692eb750371d46b9fff71ec305df6ce,770e8796aac9c96d967ef99d1f307e06</data>
      <data key="d11">b667991df37b4615a1f2984861314c31</data>
      <data key="d12">17234</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="MILLER KK">
      <data key="d8">8.0</data>
      <data key="d9">Miller KK has conducted research on the treatment of anorexia nervosa, particularly its effects on bone density.</data>
      <data key="d10">203ff7a2671a44d48a1a326f469c5543</data>
      <data key="d11">9f891b1a2f194157b0e15128796d630d</data>
      <data key="d12">17235</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="GRINSPOON S">
      <data key="d8">8.0</data>
      <data key="d9">Grinspoon S has studied the endocrine aspects of anorexia nervosa and its treatment implications.</data>
      <data key="d10">203ff7a2671a44d48a1a326f469c5543</data>
      <data key="d11">10f5130a040d41258c4cf7404c9974a4</data>
      <data key="d12">17236</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="ALENDRONATE">
      <data key="d8">6.0</data>
      <data key="d9">Alendronate has been tested as a treatment for osteopenia in patients with anorexia nervosa.</data>
      <data key="d10">203ff7a2671a44d48a1a326f469c5543</data>
      <data key="d11">5a47be82c7024fcd82bb9fd59323cea5</data>
      <data key="d12">17237</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="GHRELIN">
      <data key="d8">5.0</data>
      <data key="d9">Ghrelin levels are affected in patients with anorexia nervosa, influencing appetite and hormonal balance.</data>
      <data key="d10">203ff7a2671a44d48a1a326f469c5543</data>
      <data key="d11">03da1be68dd0429abcf0d336141d57d2</data>
      <data key="d12">17238</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="RIBOFLAVIN">
      <data key="d8">1.0</data>
      <data key="d9">Riboflavin status is an important aspect of nutritional assessment in adolescent girls with anorexia nervosa.</data>
