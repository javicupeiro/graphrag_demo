    <node id="MORBIMORTALIDAD PERIOPERATORIA">
      <data key="d0">EVENT</data>
      <data key="d1">Morbimortalidad perioperatoria refers to the complications and mortality associated with surgical procedures.</data>
      <data key="d2">d23c564df025cf16e37f2ef2be83ec34</data>
      <data key="d3">1249</data>
      <data key="d4">2</data>
