    <node id="SON">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">SON refers to chemically defined formulas designed for nutritional support in dysphagia patients.</data>
      <data key="d2">da965f79110bd8915deff461d0d91187</data>
