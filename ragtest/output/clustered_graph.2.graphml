      <data key="d11">bec2a50c321c438daa0ea333dbde7d43</data>
      <data key="d12">8323</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MAGNESIO" target="PTH INTACTA">
      <data key="d8">7.0</data>
