    </edge>
    <edge source="CALCIO" target="NEFROLITIASIS">
      <data key="d8">8.0</data>
      <data key="d9">Calcium is a key factor in the development of kidney stones, particularly in cases of hypercalciuria</data>
      <data key="d10">e67ea94c6cdb27cf6bb6715598cfe224</data>
      <data key="d11">29122358e7cf4fa9b5ded112e05a4586</data>
      <data key="d12">8282</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CALCIO" target="CITRATO">
      <data key="d8">1.0</data>
      <data key="d9">Citrate can help mitigate the effects of calcium in the urine, reducing the risk of stone formation</data>
      <data key="d10">e67ea94c6cdb27cf6bb6715598cfe224</data>
      <data key="d11">4b31ef8a61b64bd3a76cb895a9384a2f</data>
      <data key="d12">8283</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CALCIO" target="EII">
      <data key="d8">7.0</data>
      <data key="d9">Patients with EII often require calcium supplementation to prevent osteoporosis due to dietary restrictions</data>
      <data key="d10">94afd4bf40b661992e66cf7963ef236c</data>
      <data key="d11">65b1fe969d22446f86fe4d083ad98695</data>
      <data key="d12">8284</data>
