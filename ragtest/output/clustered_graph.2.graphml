      <data key="d10">0a0bea4b9792f715e9d625450c4cd25c</data>
      <data key="d11">562460b0cabe43bdb9878179228f8d8a</data>
      <data key="d12">16862</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GALLETA MARIA" target="FRUCTOSA">
      <data key="d8">8.0</data>
