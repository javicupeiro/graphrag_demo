      <data key="d0">EVENT</data>
      <data key="d1">Ciste&#237;na is a non-essential amino acid that plays a crucial role in the metabolism of homociste&#237;na and is often supplemented in dietary treatments.</data>
      <data key="d2">b1d588e0c9c4cef32da41373afbd1901</data>
      <data key="d3">1640</data>
