      <data key="d8">1.0</data>
      <data key="d9">Calcium gluconate is used in parenteral nutrition to prevent calculation errors associated with calcium chloride</data>
      <data key="d10">5fb0e4d2f6efd6c6abcd9f7b7583ed7f</data>
      <data key="d11">84ef2f32e14c4c8fb1019655b258743f</data>
