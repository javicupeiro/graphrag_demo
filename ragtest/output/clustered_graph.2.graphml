    </node>
    <node id="FIBROSIS MIOCARDICA">
      <data key="d0">EVENT</data>
      <data key="d1">Cardiac fibrosis is a condition exacerbated by obesity and the interactions between leptin, aldosterone, and natriuretic peptides.</data>
      <data key="d2">c575e742f54d5f3f674a8e52ad041221</data>
      <data key="d3">1390</data>
      <data key="d4">2</data>
