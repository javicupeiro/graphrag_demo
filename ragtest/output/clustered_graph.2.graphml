      <data key="d12">904</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RADIOTERAPIA" target="CARCINOMA EPIDERMOIDE DE LARINGE">
      <data key="d8">6.0</data>
      <data key="d9">Radiotherapy is part of the treatment plan for the patient's carcinoma epidermoide de laringe</data>
