    </edge>
    <edge source="NUTRICI&#211;N" target="M&#201;TODO DE CARDONA">
      <data key="d8">7.0</data>
      <data key="d9">The Cardona method is used in nutritional assessments to identify patients at risk of malnutrition</data>
      <data key="d10">2ebe12524f7750215eee73b328b601ee</data>
      <data key="d11">17422882c1084adb9e3e0c100c108d67</data>
