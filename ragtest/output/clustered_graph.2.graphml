    </node>
    <node id="FOXP3 GENE">
      <data key="d0">PERSON</data>
      <data key="d1">The FOXP3 gene is crucial for the development of regulatory T cells and is linked to autoimmune diabetes.</data>
      <data key="d2">d0231ac4e41b0e826d80763b5b8c61e0</data>
      <data key="d3">1720</data>
      <data key="d4">2</data>
