    </node>
    <node id="GRUPOS DE APOYO A LA LACTANCIA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Support groups for breastfeeding mothers that provide assistance and encouragement for successful breastfeeding practices.</data>
      <data key="d2">cf034f02916ec46dcba7e0f8d8e24c0c</data>
      <data key="d3">1493</data>
