    </edge>
    <edge source="TEST DEL ALIENTO" target="DIETA BAJA EN HC FERMENTABLES">
      <data key="d8">1.0</data>
      <data key="d9">A low fermentable carbohydrate diet is recommended before breath tests to avoid false results</data>
      <data key="d10">8c87213151750706e4e87956bfc9cb88</data>
