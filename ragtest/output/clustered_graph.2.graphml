    </node>
    <node id="BMC NEUROSCIENCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A scientific journal that publishes research articles in the field of neuroscience, including studies on swallowing and dysphagia.</data>
      <data key="d2">694f957b0b008ab3339e5bf1fd57b81a</data>
      <data key="d3">1221</data>
      <data key="d4">2</data>
