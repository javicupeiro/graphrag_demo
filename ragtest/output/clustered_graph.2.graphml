      <data key="d11">1b0645acccd147ae871d837911bca8eb</data>
      <data key="d12">3701</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="CANCER">
      <data key="d8">17.0</data>
      <data key="d9">Nutritional support is critical for cancer patients, particularly those undergoing treatment, as they often experience difficulties in maintaining adequate nutrition. This support addresses their specific dietary needs, ensuring that they receive the necessary nutrients to aid in their recovery and overall well-being.</data>
      <data key="d10">36cffc3e7c3a6fe82e50787e939f7537,bb209dcfffac9c89dae0ad4ed2908d85</data>
      <data key="d11">1da0768969454298a0484e29055fd0dc</data>
      <data key="d12">3702</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="P. JUSTO PAVIA">
      <data key="d8">6.0</data>
      <data key="d9">P. Justo Pavia discusses the importance of nutritional support in the context of burn patients</data>
