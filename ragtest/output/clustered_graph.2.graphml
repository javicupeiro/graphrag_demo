      <data key="d13">2</data>
    </edge>
    <edge source="CELIAC DISEASE" target="GLUTEN-FREE DIET">
      <data key="d8">20.0</data>
      <data key="d9">Celiac disease is a serious autoimmune disorder that requires individuals diagnosed with it to adhere to a gluten-free diet. This diet is essential for avoiding health complications associated with the disease. The gluten-free diet serves as the primary treatment for managing celiac disease, helping to prevent its complications and ensuring the well-being of those affected.</data>
      <data key="d10">1387d49a5eae8a32dd81f2f9991a4821,17593b5969d4126aef1c56a7d32dc922</data>
      <data key="d11">e67cd4ea46f948ae92007fdbfb0f441f</data>
      <data key="d12">17907</data>
      <data key="d13">2</data>
    </edge>
