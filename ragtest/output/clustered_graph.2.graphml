    <node id="ESTEATOSIS">
      <data key="d0">EVENT</data>
      <data key="d1">La esteatosis es una acumulaci&#243;n de grasa en el h&#237;gado que puede ser causada por la nutrici&#243;n parenteral y otros factores, afectando la funci&#243;n hep&#225;tica.</data>
      <data key="d2">0cdbb308e3359fd3ddbb1d828d12dc04</data>
