    </node>
    <node id="STRESS EMOTIONAL">
      <data key="d0">EVENT</data>
      <data key="d1">Emotional stress is considered a potential environmental trigger for the onset or exacerbation of Graves' disease.</data>
      <data key="d2">3c8b29df4105e84d4766d8d632de8535</data>
      <data key="d3">1516</data>
      <data key="d4">2</data>
