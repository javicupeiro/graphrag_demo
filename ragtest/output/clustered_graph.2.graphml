      <data key="d13">2</data>
    </edge>
    <edge source="SSA" target="AGUDA">
      <data key="d8">6.0</data>
      <data key="d9">SSA is primarily used for patients with acute neurological conditions</data>
      <data key="d10">4befdcd21a98898cec30bbac7b402d4b</data>
      <data key="d11">95362ce1cada49e397a15ae3ca185ef9</data>
