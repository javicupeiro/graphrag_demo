    </edge>
    <edge source="HIERRO" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional guidelines highlight the importance of iron intake for cognitive development in children</data>
      <data key="d10">62bb1dedc96b7530649f4c9762faab9d</data>
      <data key="d11">aedb2729dd904ba49700f608d4501537</data>
      <data key="d12">8664</data>
