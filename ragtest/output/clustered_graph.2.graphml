    <node id="ENTEROBACTERIACEAE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Enterobacteriaceae is a family of bacteria within the phylum Proteobacteria, commonly found in the intestines and important for gut flora.</data>
      <data key="d2">b36b8846f109ee75806c6ea03015e5d5</data>
      <data key="d3">1002</data>
      <data key="d4">2</data>
