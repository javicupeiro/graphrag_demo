    </node>
    <node id="ENSRUD">
      <data key="d0">PERSON</data>
      <data key="d1">Ensrud es un investigador que propuso criterios diagn&#243;sticos para la fragilidad en ancianos.</data>
      <data key="d2">bdb8258b310cb9ed8a0e4354fac5a33c</data>
      <data key="d3">1768</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
