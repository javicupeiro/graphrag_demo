      <data key="d7">c6256097ce1f415e81ce5342bd65f6d9</data>
    </node>
    <node id="HEMOCULTIVO">
      <data key="d0">EVENT</data>
      <data key="d1">El hemocultivo es una prueba que se realiz&#243; para detectar infecciones en el paciente, mostrando crecimiento de cocos gram positivos.</data>
      <data key="d2">7c10030e29c1434df3b10b1533710486</data>
      <data key="d3">1080</data>
