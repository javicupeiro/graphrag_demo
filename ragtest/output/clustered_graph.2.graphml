      <data key="d6">12079</data>
      <data key="d7">618b2f3915e1459ba79b230b591200e2</data>
    </node>
    <node id="ACIDO ACETICO">
      <data key="d0">PERSON</data>
      <data key="d1">Acido Acetico is a primary substrate for cholesterol synthesis, metabolized in muscle.</data>
      <data key="d2">0d9c11c44c3cf4e1e3148949cc0a4096</data>
      <data key="d3">325</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">12080</data>
      <data key="d7">d5fc2b2ff046472ea266d9e2d6ce227e</data>
    </node>
    <node id="HOUTHELING Y WALKER">
      <data key="d0">PERSON</data>
      <data key="d1">Houghteling and Walker are authors of a significant article published in 2015 discussing immunological mechanisms and their relation to health.</data>
      <data key="d2">0d9c11c44c3cf4e1e3148949cc0a4096</data>
      <data key="d3">941</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12081</data>
      <data key="d7">d155a1e54524433b9f3d3c74880ef5cc</data>
    </node>
    <node id="BACTERIAS INTESTINALES">
      <data key="d0">PERSON</data>
      <data key="d1">Intestinal bacteria play a crucial role in nutrient absorption and immune function.</data>
      <data key="d2">0d9c11c44c3cf4e1e3148949cc0a4096</data>
      <data key="d3">1392</data>
      <data key="d4">2</data>
      <data key="d5">7</data>
      <data key="d6">12082</data>
      <data key="d7">33e08dc5347c43b0a7b1fce74a85fa9c</data>
    </node>
    <node id="ESTEATOHEPATITIS">
      <data key="d0">EVENT</data>
      <data key="d1">Esteatohepatitis is a liver condition that may be related to gut health and the microbiome.</data>
      <data key="d2">0d9c11c44c3cf4e1e3148949cc0a4096</data>
      <data key="d3">1392</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12083</data>
      <data key="d7">7dc6045221b749e4b85f66be68a1b73c</data>
    </node>
    <node id="ATOPIA">
      <data key="d0">EVENT</data>
      <data key="d1">Atopia is an allergic condition that can be influenced by the gut microbiome during early life.</data>
      <data key="d2">0d9c11c44c3cf4e1e3148949cc0a4096</data>
      <data key="d3">1392</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12084</data>
      <data key="d7">9cbd4fa5ce674ebcaebe286829d1d0eb</data>
    </node>
    <node id="ENTEROCOLITIS">
      <data key="d0">EVENT</data>
      <data key="d1">Enterocolitis is an inflammatory condition of the intestine that can manifest in infants, especially those with APLV (Allergic Proctocolitis due to Cow's Milk Protein) not mediated by IgE. This condition leads to various digestive issues and is often associated with imbalances in the gut microbiome.</data>
      <data key="d2">08d66dc8414668a3ec627a1e164cfa6c,0d9c11c44c3cf4e1e3148949cc0a4096</data>
      <data key="d3">454</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">12085</data>
      <data key="d7">65c9176cb2fd41bda229f054934cec7e</data>
    </node>
    <node id="COLONOCITO">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">0d9c11c44c3cf4e1e3148949cc0a4096</data>
