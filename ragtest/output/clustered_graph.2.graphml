    </node>
    <node id="DIFICULTADES PARA LA DIGESTI&#211;N Y ABSORCI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">A category of conditions that affect digestion and nutrient absorption, often requiring enteral nutrition interventions in pediatric care.</data>
