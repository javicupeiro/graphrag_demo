    </node>
    <node id="DIABETES MITOCONDRIAL">
      <data key="d0">EVENT</data>
      <data key="d1">Mitochondrial diabetes is a condition that complicates treatment in patients with MNGIE, requiring careful management of blood sugar levels.</data>
      <data key="d2">763c8ac63b4c91616bcea6f1f4aa38c9</data>
