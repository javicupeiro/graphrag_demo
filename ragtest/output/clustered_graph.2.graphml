      <data key="d13">2</data>
    </edge>
    <edge source="PATIENT" target="LARYNGEAL VESTIBULE">
      <data key="d8">6.0</data>
      <data key="d9">The laryngeal vestibule is evaluated in patients to determine the presence of secretions during swallowing</data>
      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
