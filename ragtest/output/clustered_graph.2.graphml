      <data key="d9">Bruselas is known for its agricultural products, including the cultivation of peras.</data>
      <data key="d10">9d56eb0b82a3266e422a6a8ac5e63944</data>
      <data key="d11">a942ec8fa3d747cabb1317590bcea9ce</data>
      <data key="d12">6638</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="C&#193;NCER">
      <data key="d8">8.0</data>
      <data key="d9">El consumo de frutas se asocia con una reducci&#243;n del riesgo de c&#225;ncer en diversas localizaciones</data>
      <data key="d10">240ded3c69bd7ae82bed4089517ffb6b</data>
      <data key="d11">8eaf7e59e52a47babd54b6274e261d54</data>
      <data key="d12">6639</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="VERDURAS">
      <data key="d8">6.0</data>
      <data key="d9">Frutas y verduras son componentes clave de una dieta saludable que puede reducir el riesgo de c&#225;ncer</data>
      <data key="d10">240ded3c69bd7ae82bed4089517ffb6b</data>
      <data key="d11">edbae5c8467544f9a53b0392a7b3df95</data>
      <data key="d12">6640</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="DIETA MEDITERR&#193;NEA">
      <data key="d8">8.0</data>
      <data key="d9">Las frutas son un componente esencial de la dieta mediterr&#225;nea, promoviendo la salud y el bienestar.</data>
      <data key="d10">4e6568999eba5abd852eedecc5fc580f</data>
      <data key="d11">879d97bb8ab94e55ad0bdd6b6fcfee0c</data>
      <data key="d12">6641</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="DIETAS POR RACIONES">
      <data key="d8">6.0</data>
      <data key="d9">Frutas are included in dietas por raciones to provide essential vitamins and minerals</data>
      <data key="d10">e9d9dbd1ccc60737441dcf7bfeef638e</data>
      <data key="d11">390280b142a249c0a45a75d6ecd213a0</data>
      <data key="d12">6642</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="GALACTOSEMIA">
      <data key="d8">5.0</data>
      <data key="d9">Certain fruits may contain galactose and should be consumed with caution by individuals with galactosemia.</data>
      <data key="d10">743649231e27012822c870ff5878263c</data>
      <data key="d11">1777daabc0de4cd8a5fccfca708abde0</data>
      <data key="d12">6643</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="DIETA CONTROLADA EN GLUTEN">
      <data key="d8">8.0</data>
      <data key="d9">Las frutas son recomendadas en la dieta controlada en gluten, evitando las comerciales que pueden contener gluten.</data>
      <data key="d10">08edfb59071449728499ca59eb51ac84</data>
      <data key="d11">38b980fe69e744fcb1a1c7c6948d29ac</data>
      <data key="d12">6644</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="ENFERMEDAD CARDIOVASCULAR">
      <data key="d8">7.0</data>
      <data key="d9">Increased fruit consumption is associated with a reduced risk of cardiovascular events</data>
      <data key="d10">73896da11a9ec209fb3e5b61f19f81df</data>
      <data key="d11">12ec19be2c794e95831e368bf86ed60c</data>
      <data key="d12">6645</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="NUTRICIONAL RECOMMENDATIONS">
      <data key="d8">8.0</data>
      <data key="d9">Fruits are recommended in dietary guidelines for their health benefits.</data>
      <data key="d10">f41688eecb31d8e55fc70e993e99c3e9</data>
      <data key="d11">ce869c2b672e4b2b825d0442d0d016e2</data>
      <data key="d12">6646</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="SODIO">
      <data key="d8">5.0</data>
      <data key="d9">Frutas typically contain small amounts of sodium, making them suitable for low-sodium diets</data>
      <data key="d10">01d788abeab4fc29c425bf27168356e2</data>
      <data key="d11">c973ba3eb58c44429a01491b94d3a152</data>
      <data key="d12">6647</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="DASH">
      <data key="d8">8.0</data>
      <data key="d9">The DASH diet encourages the intake of fruits to improve health and manage hypertension</data>
      <data key="d10">b5db5210dfb726bf3f6d3fae82598596</data>
      <data key="d11">6590abeef2c3456daef438e65badf259</data>
      <data key="d12">6648</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="LITIASIS RENAL">
      <data key="d8">6.0</data>
      <data key="d9">Increasing fruit intake is part of dietary recommendations to prevent kidney stones.</data>
      <data key="d10">451bbcaee8b1a025277b84488ea7db61</data>
      <data key="d11">af68c4b4332e4cb8b2c949fd12fc63b8</data>
      <data key="d12">6649</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="PESOS DE RACIONES">
      <data key="d8">1.0</data>
      <data key="d9">The recommended weights for fruits are specified in the Pesos de raciones</data>
      <data key="d10">72ed1fffc10ea163a92b5f1a7b972732</data>
      <data key="d11">a2f0ea9f6aed42ec90efe33629d9c1dc</data>
      <data key="d12">6650</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">9.0</data>
      <data key="d9">Fruits are encouraged as part of a balanced diet for children in the nutritional guidelines</data>
      <data key="d10">61b84039de5ac2d9e25890c3b8f4f87a</data>
      <data key="d11">a8bf7aa111b84cf291c3c9db07f168ed</data>
      <data key="d12">6651</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUTAS" target="NI&#209;O">
      <data key="d8">6.0</data>
      <data key="d9">Fruits are recommended as part of a balanced diet for children</data>
      <data key="d10">56e7bab8da5c5e8d37b7545618a648bb</data>
