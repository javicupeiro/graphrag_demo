    <node id="TPH">
      <data key="d0">EVENT</data>
      <data key="d1">TPH refers to hematopoietic stem cell transplantation, a medical procedure involving high doses of chemotherapy followed by the infusion of hematopoietic cells.</data>
      <data key="d2">61890d3cb54fb752b95a4dfad8db8bb6</data>
