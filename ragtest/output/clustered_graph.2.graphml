    </node>
    <node id="ANTIBIOTERAPIA PROLONGADA">
      <data key="d0">EVENT</data>
      <data key="d1">Prolonged antibiotic therapy can impact nutrient absorption and may necessitate supplementation of vitamins and minerals.</data>
      <data key="d2">a4886f74d848ccd61cefcaab3103f233</data>
      <data key="d3">584</data>
      <data key="d4">2</data>
