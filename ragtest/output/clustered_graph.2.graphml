      <data key="d0">ORGANIZATION</data>
      <data key="d1">International societies provide guidelines for the management and treatment of critically ill patients, including those with burns.</data>
      <data key="d2">916d4d35de887923f4ea5b05928f13e3</data>
      <data key="d3">1113</data>
