    <node id="ANTIPIRINA">
      <data key="d0">PERSON</data>
      <data key="d1">Antipirina is a medication whose metabolism can be influenced by dietary factors, particularly by enzymatic inducers.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">0</data>
      <data key="d6">14241</data>
