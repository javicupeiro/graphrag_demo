      <data key="d7">a95c443579854f9d96e8c87cd8d941aa</data>
    </node>
    <node id="DYNAMOMETRY">
      <data key="d0">EVENT</data>
      <data key="d1">Dynamometry is a method used to measure muscle strength, often employed in nutritional assessments.</data>
      <data key="d2">14039baea6555ffc156768e503ff0b90</data>
      <data key="d3">693</data>
      <data key="d4">2</data>
