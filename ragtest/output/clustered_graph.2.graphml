    <node id="COSTES INDIRECTOS">
      <data key="d0">EVENT</data>
      <data key="d1">Indirect costs associated with diabetes, including absenteeism and early retirements, which impact the economy.</data>
      <data key="d2">d2e2009d967ecd49af312dba4e2ed4fd</data>
      <data key="d3">990</data>
