      <data key="d8">8.0</data>
      <data key="d9">Las f&#243;rmulas oligomonom&#233;ricas son un tipo de producto utilizado en la nutrici&#243;n enteral</data>
      <data key="d10">2def4be9506db96f8bdfe9e3ba6f9b6f</data>
      <data key="d11">231fc946b3084e91888633d6c9a9c179</data>
