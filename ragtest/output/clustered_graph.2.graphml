      <data key="d11">6eb658e433ef4bf3a69ce81da9e38db1</data>
      <data key="d12">16859</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GALLETA MARIA" target="PALMA">
      <data key="d8">7.0</data>
      <data key="d9">Galleta Maria includes Palma as an ingredient, which affects its texture and taste</data>
      <data key="d10">0a0bea4b9792f715e9d625450c4cd25c</data>
      <data key="d11">7d84b575914447db87f5f024e2761c6a</data>
      <data key="d12">16860</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GALLETA MARIA" target="NUTRICIONAL INFORMACI&#211;N">
      <data key="d8">9.0</data>
