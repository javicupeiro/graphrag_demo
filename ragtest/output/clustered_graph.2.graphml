    <node id="BMJ CLINICAL EVIDENCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">BMJ Clinical Evidence is an online resource providing updated summaries of integrated evidence for clinical practice.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d3">1284</data>
      <data key="d4">2</data>
