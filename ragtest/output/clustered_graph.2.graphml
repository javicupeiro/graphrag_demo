      <data key="d8">4.0</data>
      <data key="d9">Research published in the Korean Circ J may address the relationship between dietary habits and cancer risk.</data>
      <data key="d10">6c509f5e704c690cfa39b3f7b19eb766</data>
      <data key="d11">aa8d7b0190fe4548a4a386536fd97168</data>
      <data key="d12">6355</data>
      <data key="d13">2</data>
    </edge>
