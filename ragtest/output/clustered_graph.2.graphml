    <edge source="NUTRITIONAL SUPPORT" target="CHRONIC NEUROLOGICAL DISEASES">
      <data key="d8">6.0</data>
      <data key="d9">Patients with chronic neurological diseases often require nutritional support to maintain their health</data>
      <data key="d10">abd9a4b801dbdaca1708f0e22331a829</data>
      <data key="d11">5b943df59c9d4ad1aece0c38efcfc813</data>
      <data key="d12">3814</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="ENTERAL NUTRITION">
      <data key="d8">9.0</data>
      <data key="d9">Enteral nutrition is a critical aspect of providing nutritional support to patients with chronic conditions</data>
      <data key="d10">abd9a4b801dbdaca1708f0e22331a829</data>
      <data key="d11">9e10c4c129f447a8a594d4b9a79e73a9</data>
      <data key="d12">3815</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="INTRAVENOUS LIPID EMULSIONS">
      <data key="d8">7.0</data>
      <data key="d9">Intravenous lipid emulsions are a form of nutritional support for infants unable to receive enteral nutrition</data>
      <data key="d10">9ef354c0ee5ac877ce8fba79fcc7e2b3</data>
      <data key="d11">66fa3d455aa34a8a9cc23595df055498</data>
      <data key="d12">3816</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="NUTRITIONAL GUIDELINES">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional guidelines inform the practices of providing nutritional support in clinical settings</data>
      <data key="d10">9ef354c0ee5ac877ce8fba79fcc7e2b3</data>
      <data key="d11">c413ff92dcfa44a3bcd547f4f7724b46</data>
      <data key="d12">3817</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="TERRI SCHIAVO">
      <data key="d8">8.0</data>
      <data key="d9">The case of Terri Schiavo involved significant ethical discussions about the use of artificial nutrition and hydration</data>
      <data key="d10">193f43446f6311107c8a73b6111fa25a</data>
      <data key="d11">aa4898e1901a4b19a754dc1db9bb325f</data>
      <data key="d12">3818</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="ELUANA ENGLARO">
      <data key="d8">1.0</data>
      <data key="d9">The case of Eluana Englaro raised ethical questions regarding the withdrawal of artificial nutrition</data>
      <data key="d10">193f43446f6311107c8a73b6111fa25a</data>
      <data key="d11">3d4bcf82c02347689c27e1f1163eaa84</data>
      <data key="d12">3819</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="MUST">
      <data key="d8">7.0</data>
      <data key="d9">Nutritional support may be recommended for individuals identified at risk of malnutrition by the Malnutrition Universal Screening Tool (MUST)</data>
      <data key="d10">005b22fc9dae5f9b135f0c8ba729819f</data>
      <data key="d11">a363c5a2e55e4b0fb72cc79872206870</data>
      <data key="d12">3820</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL TREATMENT" target="HOSPITAL MALNUTRITION">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional treatment is aimed at addressing hospital malnutrition</data>
      <data key="d10">67f60ae11335cf41da4f96400b69e67b</data>
      <data key="d11">00f38d5057b243d3bc03d099477c34c7</data>
      <data key="d12">3821</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL TREATMENT" target="DIABETES">
      <data key="d8">9.0</data>
      <data key="d9">Nutritional treatment is essential for managing diabetes and reducing long-term complications.</data>
      <data key="d10">e2304aa7e992d9e26558aab3c807b51d</data>
      <data key="d11">22ce9b154fd447d8a48688fefc03a09a</data>
      <data key="d12">3822</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL TREATMENT" target="HEALTHCARE COSTS">
      <data key="d8">1.0</data>
      <data key="d9">Effective nutritional treatment can lead to significant savings in healthcare costs related to diabetes management.</data>
      <data key="d10">e2304aa7e992d9e26558aab3c807b51d</data>
      <data key="d11">d24016dba5f14ea48e280a60aad58a91</data>
      <data key="d12">3823</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL TREATMENT" target="GSDIB">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional treatment is essential for managing GSDIb and maintaining normal glucose levels.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">3409bdd1e5ae4ee6ae35570fafa13ea5</data>
      <data key="d12">3824</data>
      <data key="d13">2</data>
    </edge>
