    </edge>
    <edge source="PROTE&#205;NAS" target="NUTRICIONAL RECOMMENDATIONS">
      <data key="d8">7.0</data>
      <data key="d9">Proteins are included in nutritional recommendations for a balanced diet.</data>
      <data key="d10">f41688eecb31d8e55fc70e993e99c3e9</data>
      <data key="d11">9916e8815fea48e2ae30f6b087efac5c</data>
