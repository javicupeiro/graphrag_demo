      <data key="d11">5e97021031f748fb84285c34d6dcf893</data>
      <data key="d12">5582</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GASTROSTOM&#205;A" target="HEPATOPAT&#205;A CR&#211;NICA">
