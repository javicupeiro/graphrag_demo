    <edge source="MEDITERRANEAN DIET" target="FRAILTY SYNDROME">
      <data key="d8">9.0</data>
      <data key="d9">Adherence to the Mediterranean diet is associated with a lower risk of developing frailty in older adults</data>
      <data key="d10">3ec3efbe130c20d623681e00e3d784f7</data>
      <data key="d11">471e99a9d943419fba80c0bb5ad8fd2b</data>
