    <node id="KATZNELSON L.">
      <data key="d0">PERSON</data>
      <data key="d1">Katznelson L. is a researcher and author who has contributed to the understanding of acromegaly and its treatment.</data>
      <data key="d2">2261671ccad439da1ed9ea5a27857dc8</data>
