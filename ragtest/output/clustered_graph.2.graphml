    </edge>
    <edge source="PACIENTE QUIR&#218;RGICO" target="F&#211;RMULAS INMUNOMODULADORAS">
      <data key="d8">6.0</data>
      <data key="d9">Las f&#243;rmulas inmunomoduladoras son recomendadas para pacientes quir&#250;rgicos para mejorar su recuperaci&#243;n</data>
      <data key="d10">169eceabd2bd24183f24faccb2c00088</data>
      <data key="d11">03d35fd32a3f4cde804e1c6a9d6b60ae</data>
