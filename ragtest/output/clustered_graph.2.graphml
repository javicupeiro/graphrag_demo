    </node>
    <node id="EMBOLISMO GASEOSO">
      <data key="d0">EVENT</data>
      <data key="d1">El embolismo gaseoso es una complicaci&#243;n que puede ocurrir por la entrada de aire en el sistema vascular durante la inserci&#243;n de un cat&#233;ter.</data>
      <data key="d2">21bd0c4198fa2be0aa931387bd631728</data>
