    </node>
    <node id="PALIATIVOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Palliative care focuses on providing relief from the symptoms and stress of serious illness, aiming to improve quality of life for patients and their families.</data>
      <data key="d2">d3f53b7b7352e8ba2fd9dc8be977648c</data>
      <data key="d3">1082</data>
