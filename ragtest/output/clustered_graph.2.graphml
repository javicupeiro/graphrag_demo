    <node id="SOCIETY INTERNACIONAL DE NUTRICI&#211;N Y METABOLISMO RENAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The International Society of Renal Nutrition and Metabolism (ISRNM) is an organization that establishes guidelines and consensus on nutritional support for patients with kidney disease.</data>
      <data key="d2">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
