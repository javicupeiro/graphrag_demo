      <data key="d9">Acute cerebrovascular accidents can lead to oropharyngeal dysphagia, requiring specific screening methods</data>
      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">8a6222d299a04864beec62e402dae896</data>
      <data key="d12">134</data>
