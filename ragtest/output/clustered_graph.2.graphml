    </edge>
    <edge source="CUPROENZIMAS" target="TEJIDO EL&#193;STICO">
      <data key="d8">8.0</data>
      <data key="d9">Cuproenzyme activity is required for the synthesis and maintenance of elastic tissue</data>
      <data key="d10">d2916698f201a31d6bb74619a3fa064b</data>
      <data key="d11">15f1822c65f248178e7cecd45f594b44</data>
