    <edge source="HYPOGLYCEMIA" target="GLYCOGEN STORAGE DISEASE TYPE I">
      <data key="d8">9.0</data>
      <data key="d9">Hypoglycemia is a significant clinical manifestation of Glycogen Storage Disease Type I</data>
      <data key="d10">704cfd179507a977ecc0691a5bd2861e</data>
      <data key="d11">b66c2ea3822e445ab3c0e75a21ef9e2a</data>
      <data key="d12">13302</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="GSDIII">
      <data key="d8">6.0</data>
      <data key="d9">Hypoglycemia is a complication that can occur in patients with GSDIII</data>
      <data key="d10">9f5a8d86160d5d097bca174e2e2496c1</data>
      <data key="d11">c9105b7a752145759a01077d15f51f52</data>
      <data key="d12">13303</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="GSD0">
      <data key="d8">7.0</data>
