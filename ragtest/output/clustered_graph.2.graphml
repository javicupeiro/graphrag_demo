    <node id="HIPOXEMIA CR&#211;NICA">
      <data key="d0">EVENT</data>
      <data key="d1">Chronic hypoxemia is a condition characterized by low oxygen levels in the blood, which can complicate the health of patients with respiratory diseases</data>
      <data key="d2">e4002acd67016cc1f7428e0a3ab42977</data>
      <data key="d3">1131</data>
      <data key="d4">2</data>
