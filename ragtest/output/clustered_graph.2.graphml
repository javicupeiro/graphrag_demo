    </node>
    <node id="QUALITY OF LIFE">
      <data key="d0">EVENT</data>
      <data key="d1">Quality of life for patients with oropharyngeal dysphagia is significantly affected due to difficulties in swallowing and associated health issues.</data>
      <data key="d2">02c3924fac2660b8531f61207f3b04bb</data>
