    <node id="PRODUCTOS COMERCIALES RTU">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ready-to-use commercial products are specially designed nutritional supplements for patients with dysphagia, providing modified consistency and texture.</data>
      <data key="d2">4aeca0ee5f2663f449cfd017d3e3bbfb</data>
