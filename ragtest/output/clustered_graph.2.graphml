    </edge>
    <edge source="USDA" target="PIR&#193;MIDES DE LA ALIMENTACI&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">The USDA developed the food pyramids as part of their nutritional guidelines for healthy eating.</data>
      <data key="d10">3bd46addca98ca875c66aab3827bbf5f</data>
      <data key="d11">96e65d9aae3e41e383c5dad9e1e7dbbb</data>
      <data key="d12">16800</data>
      <data key="d13">2</data>
    </edge>
    <edge source="METILMERCURIO" target="CARDIOVASCULAR RISK">
      <data key="d8">1.0</data>
      <data key="d9">Methylmercury exposure can negatively impact cardiovascular health, especially in vulnerable populations</data>
      <data key="d10">e1766b4a9f6cff776650a29195cee9fc</data>
      <data key="d11">2a291585a411447991b4029bd7caa3b2</data>
      <data key="d12">16801</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS TRANS" target="ECV">
      <data key="d8">8.0</data>
      <data key="d9">Trans fatty acids are linked to increased levels of LDL cholesterol and decreased HDL cholesterol, contributing to cardiovascular disease risk.</data>
      <data key="d10">59a6475dbe0ccafda60f2647dea78371</data>
      <data key="d11">90fa3d953495497b86e28e9c8b667c38</data>
      <data key="d12">16802</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS TRANS" target="NUTRICIONAL RECOMMENDATIONS">
      <data key="d8">8.0</data>
      <data key="d9">Trans fatty acids are advised to be limited in dietary recommendations for health.</data>
      <data key="d10">f41688eecb31d8e55fc70e993e99c3e9</data>
      <data key="d11">477884c5768640938a76070607e2b5a8</data>
      <data key="d12">16803</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AZ&#218;CARES LIBRES" target="CARIES DENTAL">
      <data key="d8">9.0</data>
      <data key="d9">High intake of free sugars is directly linked to the development of dental caries</data>
      <data key="d10">7ba4c7b49d445c147394ac626d055ef3</data>
      <data key="d11">60ff3d23d74049d99b4ced489a1695bb</data>
      <data key="d12">16804</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VEGETARIAN DIET" target="CARDIOVASCULAR RISK">
      <data key="d8">7.0</data>
      <data key="d9">The vegetarian diet is associated with lower cardiovascular risk due to its nutrient composition.</data>
      <data key="d10">4b79601d85087d62f0d4890761776c04</data>
      <data key="d11">6b47411d997642f2821dba19ab263741</data>
      <data key="d12">16805</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SUPLEMENTOS" target="POIC">
      <data key="d8">7.0</data>
