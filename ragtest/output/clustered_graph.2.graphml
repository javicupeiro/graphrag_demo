    </node>
    <node id="FUNDUPLICATURA">
      <data key="d0">EVENT</data>
      <data key="d1">La funduplicatura es un procedimiento quir&#250;rgico indicado en casos de enfermedad pulmonar asociada al reflujo gastroesof&#225;gico.</data>
      <data key="d2">e569eda9506ef1e77080a8120e388963</data>
      <data key="d3">1192</data>
