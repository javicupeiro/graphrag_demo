      <data key="d13">2</data>
    </edge>
    <edge source="CATABOLISMO" target="ANABOLISMO">
      <data key="d8">1.0</data>
      <data key="d9">Catabolism and anabolism are opposing metabolic processes that are critical in the context of nutrition for infants</data>
      <data key="d10">61a35dc8c2c6728e1df80cb1037e6296</data>
