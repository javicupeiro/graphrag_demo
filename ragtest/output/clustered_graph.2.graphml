    <node id="NUTRITION PATHOLOGY">
      <data key="d0">EVENT</data>
      <data key="d1">Nutrition pathology refers to the study of how nutritional factors contribute to disease processes and health outcomes.</data>
      <data key="d2">6533cbcb76873caf6fd68eb95d313d24</data>
      <data key="d3">1855</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
