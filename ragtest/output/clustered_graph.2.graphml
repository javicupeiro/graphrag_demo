    </node>
    <node id="SOLUCIONES SIN L&#205;PIDOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Solutions without lipids are specific formulations in parenteral nutrition that require different filtration methods.</data>
      <data key="d2">222519e556047fafecd61c2964aaaeed</data>
      <data key="d3">588</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15588</data>
      <data key="d7">c8917645dd6b43c2b50c1c5c49ca6a51</data>
    </node>
    <node id="MEZCLAS TERNARIAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ternary mixtures in parenteral nutrition refer to the combination of amino acids, glucose, and lipids in a single solution.</data>
