    <node id="VERTICAL GASTRECTOMY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Vertical gastrectomy is a surgical procedure for weight loss that involves removing a portion of the stomach.</data>
      <data key="d2">79afec9f55a4cb9aa31a7e4566dae279</data>
      <data key="d3">1012</data>
      <data key="d4">2</data>
