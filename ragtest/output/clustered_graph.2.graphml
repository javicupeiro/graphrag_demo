    </node>
    <node id="OBSTRUCCI&#211;N PARCIAL DEL DUODENO">
      <data key="d0">EVENT</data>
      <data key="d1">La obstrucci&#243;n parcial del duodeno puede ser una complicaci&#243;n de la pancreatitis aguda, afectando la alimentaci&#243;n y la absorci&#243;n de nutrientes.</data>
      <data key="d2">caf14765027dbf6266841af0571a522e</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
