      <data key="d6">2096</data>
      <data key="d7">ea2703835cd34b6b8ee8e2b71a929ac5</data>
    </node>
    <node id="HIPOEMESIS GRAV&#205;DICA">
      <data key="d0">EVENT</data>
      <data key="d1">La hiper&#233;mesis grav&#237;dica es una condici&#243;n que puede causar desnutrici&#243;n en mujeres embarazadas, requiriendo atenci&#243;n nutricional especial.</data>
      <data key="d2">44346a4b1b9a6d3ae2bc161314ff9efd</data>
      <data key="d3">748</data>
