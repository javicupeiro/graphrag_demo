    <edge source="DIARREA" target="RESINAS FIJADORAS DE &#193;CIDOS BILIARES">
      <data key="d8">6.0</data>
      <data key="d9">Bile acid sequestrants can help manage diarrhea by binding bile acids in the intestine</data>
