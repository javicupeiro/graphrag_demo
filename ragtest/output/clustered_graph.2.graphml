    </edge>
    <edge source="CALCIUM" target="OSTEOPOROSIS">
      <data key="d8">18.0</data>
      <data key="d9">Calcium is a vital nutrient in the diet that plays a crucial role in preventing and treating osteoporosis. It is essential for maintaining bone health, and a deficiency in calcium can lead to the development of osteoporosis, a condition characterized by weakened bones and an increased risk of fractures. Therefore, adequate calcium intake is important for individuals at risk of or suffering from osteoporosis.</data>
      <data key="d10">4a59488a9440b38afba989ca88d49ca3,65ba063e1a9e43a87dbfe9cf627674b1</data>
      <data key="d11">131414d897f24c1c92720f889b189478</data>
      <data key="d12">10496</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CALCIUM" target="MAGNESIUM">
      <data key="d8">1.0</data>
      <data key="d9">Magnesium plays a role in the metabolism of calcium and is important for bone health</data>
      <data key="d10">1f8cd198519be7b535a3f5be8181931c</data>
      <data key="d11">964a8562ff8247bd921ae7a40d845479</data>
      <data key="d12">10497</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CALCIUM" target="CHRONIC KIDNEY DISEASE">
