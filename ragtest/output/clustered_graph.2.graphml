      <data key="d11">8962b74878ca495aa7e382f261d16875</data>
      <data key="d12">10211</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD CARDIOVASCULAR" target="RIESGO MUY ALTO">
      <data key="d8">9.0</data>
      <data key="d9">Patients with documented cardiovascular disease are classified in the very high-risk group</data>
