    </edge>
    <edge source="&#193;CIDO F&#211;LICO" target="MUJERES EMBARAZADAS">
      <data key="d8">8.0</data>
      <data key="d9">Las mujeres embarazadas deben ingerir &#225;cido f&#243;lico para reducir el riesgo de defectos del tubo neural en sus descendientes.</data>
      <data key="d10">b68dc7398a80c0b67d28b1d9f73ff885</data>
      <data key="d11">b7a8b59de456412bbd876141d69ceefe</data>
