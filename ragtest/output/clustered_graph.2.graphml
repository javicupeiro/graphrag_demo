      <data key="d0">PERSON</data>
      <data key="d1">The patient is a 66-year-old male who has undergone surgery for laryngeal carcinoma and is receiving nutritional support.</data>
      <data key="d2">0b901814a09392d24880be465dcbce6f</data>
