      <data key="d12">6268</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BMC PUBLIC HEALTH" target="HEART">
      <data key="d8">6.0</data>
      <data key="d9">Both journals publish research related to cardiovascular health, indicating a connection in their focus on public health issues.</data>
      <data key="d10">cf833689453c8ce13d3650766a8b47a7</data>
      <data key="d11">6194092404394e46b061d419c59387a5</data>
      <data key="d12">6269</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BMC PUBLIC HEALTH" target="ESPEN EXPERT GROUP">
      <data key="d8">5.0</data>
