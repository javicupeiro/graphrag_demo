      <data key="d12">5044</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA GHATTI" target="ANOGEISSUS LATIFOLIA">
      <data key="d8">9.0</data>
      <data key="d9">La goma ghatti se obtiene del exudado del &#225;rbol Anogeissus latifolia</data>
