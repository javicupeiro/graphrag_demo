      <data key="d11">de764ebf977341d2ad3cfd3dafcbcb14</data>
      <data key="d12">14882</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONE" target="HORMONAL RESISTANCE">
      <data key="d8">4.0</data>
      <data key="d9">Testosterone therapy may be impacted by hormonal resistance mechanisms, which affect the response to hormonal treatments</data>
      <data key="d10">84ebd4f784ceacfe0744f6bb9cd9a5a3</data>
      <data key="d11">aacb1ff2b00843cda5415d1d6065d369</data>
      <data key="d12">14883</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONE" target="BHASIN S">
