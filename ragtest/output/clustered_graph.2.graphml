    <node id="DETERIORO DE ACTIVIDAD">
      <data key="d0">EVENT</data>
      <data key="d1">Deterioro de actividad indicates the level of physical activity impairment in patients.</data>
      <data key="d2">67f60ae11335cf41da4f96400b69e67b</data>
