      <data key="d11">519bc89fe967405b9a5aba0fe8eb4756</data>
      <data key="d12">10980</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="PERSONAS MAYORES">
      <data key="d8">9.0</data>
      <data key="d9">Older adults are at a higher risk of developing osteoporosis due to age-related changes in bone density and mineral absorption.</data>
      <data key="d10">aa44a32ccc29ae80ddbbc4a77b33a297</data>
      <data key="d11">618978575c704d2c81dd899842a6e9c1</data>
      <data key="d12">10981</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="HIPERCALCEMIA">
      <data key="d8">5.0</data>
      <data key="d9">Osteoporosis can be influenced by calcium levels in the body, as both conditions relate to bone health and calcium metabolism.</data>
      <data key="d10">7c6e51fbc38204b42b4d619b271037c3</data>
      <data key="d11">6b3a81f59e98430ca8b0de9b2ec974dd</data>
      <data key="d12">10982</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="HIPOCLACEMIA">
      <data key="d8">6.0</data>
      <data key="d9">Hypocalcemia can contribute to the development of osteoporosis</data>
      <data key="d10">e945adb09eb8d9984302b72f9a2a68cb</data>
      <data key="d11">5c397fbc33e442b0921a4d9f0bacdd3c</data>
      <data key="d12">10983</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="KLINEFELTER SYNDROME">
      <data key="d8">6.0</data>
      <data key="d9">Patients with Klinefelter syndrome have an increased risk of osteoporosis</data>
      <data key="d10">5509bb6959e4faa5989289c1ddbcc96b</data>
      <data key="d11">449ef035bbdc45b79e96f1e6095cf81d</data>
      <data key="d12">10984</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="S&#205;NDROME DE TURNER">
      <data key="d8">7.0</data>
      <data key="d9">La osteoporosis es m&#225;s frecuente en pacientes con s&#237;ndrome de Turner, lo que puede estar relacionado con la deficiencia de estr&#243;genos.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b</data>
      <data key="d11">14a49862af1f46fe9a97aaef9f6c3f21</data>
      <data key="d12">10985</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="HYPERTIROIDISM">
      <data key="d8">5.0</data>
      <data key="d9">Osteoporosis is a risk factor for older adults with subclinical hyperthyroidism, necessitating careful management</data>
      <data key="d10">f979a07da5d7c814ccf957629ab91cc5</data>
      <data key="d11">15ebd94bbdc749709c04ad777f14e6a8</data>
      <data key="d12">10986</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="EASTELL R">
      <data key="d8">8.0</data>
      <data key="d9">Eastell R's guidelines address the pharmacological management of osteoporosis</data>
      <data key="d10">85ee651c191c3b0c5fe786fe2e0718a4</data>
      <data key="d11">d4b35ed5ecd948a8b4a815a6acb0b748</data>
      <data key="d12">10987</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="DEXA">
      <data key="d8">1.0</data>
      <data key="d9">DEXA is used to assess bone mineral density in patients at risk for osteoporosis</data>
      <data key="d10">18f04b0302d49a339210d54d9cc55cd3</data>
      <data key="d11">f5cba8df6a5f46a680b7b8653ca4d5c2</data>
      <data key="d12">10988</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="ALENDRONATO">
      <data key="d8">17.0</data>
      <data key="d9">Osteoporosis is a condition characterized by weakened bones, increasing the risk of fractures. Alendronate, also known as Alendronato, is a medication specifically used to treat osteoporosis. It works by reducing bone resorption, which helps to increase bone mineral density, thereby lowering the likelihood of fractures. Through its dual action of decreasing bone loss and enhancing bone strength, Alendronate plays a crucial role in the management of osteoporosis.</data>
      <data key="d10">15cc53e1fcf2a1afd24bf25a2b059f98,43b6763c37598cae7a26ed8a26b45f54</data>
      <data key="d11">421ce9930e3541fdb2b97a747c72b3c2</data>
      <data key="d12">10989</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="RISEDRONATO">
      <data key="d8">8.0</data>
      <data key="d9">Risedronate is used to treat osteoporosis and reduce the risk of fractures</data>
      <data key="d10">15cc53e1fcf2a1afd24bf25a2b059f98</data>
      <data key="d11">a867b63c301b4aa297f81f97568ac0f2</data>
      <data key="d12">10990</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="IBANDRONATO">
      <data key="d8">8.0</data>
      <data key="d9">Ibandronate is used to treat osteoporosis and reduce the risk of vertebral fractures</data>
      <data key="d10">15cc53e1fcf2a1afd24bf25a2b059f98</data>
      <data key="d11">3dce7a1948bf418caeeecbff1d1def37</data>
      <data key="d12">10991</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="RIZEDRONATO">
      <data key="d8">9.0</data>
      <data key="d9">Rizedronato is effective in treating osteoporosis by reducing bone resorption and increasing bone mineral density</data>
      <data key="d10">43b6763c37598cae7a26ed8a26b45f54</data>
      <data key="d11">0c710e828ceb482b9ae481bdc21ce536</data>
      <data key="d12">10992</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="DENOSUMAB">
      <data key="d8">9.0</data>
      <data key="d9">Denosumab is used in the treatment of osteoporosis by inhibiting RANKL, which reduces bone resorption</data>
      <data key="d10">43b6763c37598cae7a26ed8a26b45f54</data>
      <data key="d11">c9a6056e960e4959855cf2c8a615f9d1</data>
      <data key="d12">10993</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="RALOXIFENO">
      <data key="d8">8.0</data>
      <data key="d9">Raloxifene reduces the risk of fractures in postmenopausal women with osteoporosis</data>
      <data key="d10">43b6763c37598cae7a26ed8a26b45f54</data>
      <data key="d11">65b0e47c2d7e43c386b13676303018b9</data>
      <data key="d12">10994</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="BISFOSFONATOS">
      <data key="d8">9.0</data>
      <data key="d9">Bisphosphonates are the first-line treatment for osteoporosis, effectively reducing the risk of fractures</data>
      <data key="d10">43b6763c37598cae7a26ed8a26b45f54</data>
      <data key="d11">80989ef83f414cb8bbdab7fb5fe1bdca</data>
      <data key="d12">10995</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="CALCITONINA">
      <data key="d8">5.0</data>
      <data key="d9">Calcitonin has been used in the treatment of osteoporosis, although its effectiveness is less established compared to other treatments</data>
      <data key="d10">43b6763c37598cae7a26ed8a26b45f54</data>
      <data key="d11">6e9921fe3b3441659824b2f54a2d0e3b</data>
      <data key="d12">10996</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="RANELATO DE ESTRONCIO">
      <data key="d8">15.0</data>
      <data key="d9">Osteoporosis is a condition characterized by weakened bones, making individuals more susceptible to fractures. Ranelato de estroncio, also known as strontium ranelate, is a medication specifically used to address this issue. It is effective in reducing the risk of vertebral fractures in postmenopausal women who are affected by osteoporosis. The mechanism of action for ranelato de estroncio involves reducing bone resorption while simultaneously promoting bone formation, thereby helping to strengthen bones and mitigate the risks associated with osteoporosis.</data>
      <data key="d10">08bc93c6dcf6df5ebf660f30b1f1ef2d,43b6763c37598cae7a26ed8a26b45f54</data>
      <data key="d11">ed5a4f4ea9f64e43be10d1f52ae188c1</data>
      <data key="d12">10997</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="TAMOXIFENO">
      <data key="d8">1.0</data>
      <data key="d9">Tamoxifen has effects on bone density and is used in the context of osteoporosis treatment in women with breast cancer</data>
      <data key="d10">43b6763c37598cae7a26ed8a26b45f54</data>
      <data key="d11">ab07a85974854f13880cd26c6fc3e2c1</data>
      <data key="d12">10998</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="GLUCOCORTICOIDS">
      <data key="d8">8.0</data>
      <data key="d9">Osteoporosis is a condition characterized by weakened bones and an increased risk of fractures. It is notably associated with the excessive use of glucocorticoids, which are a class of steroid hormones. Long-term use of glucocorticoids is known to cause osteoporosis as a significant side effect. Therefore, individuals who are prescribed glucocorticoids should be aware of the potential risk of developing osteoporosis as a consequence of their treatment.</data>
      <data key="d10">08bc93c6dcf6df5ebf660f30b1f1ef2d,65ba063e1a9e43a87dbfe9cf627674b1</data>
      <data key="d11">c1b698f377a9457681c2036bb1fa8bc3</data>
      <data key="d12">10999</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="CALCITONIN">
      <data key="d8">7.0</data>
      <data key="d9">Calcitonin is used to treat osteoporosis by inhibiting bone resorption</data>
      <data key="d10">08bc93c6dcf6df5ebf660f30b1f1ef2d</data>
      <data key="d11">904341ec482c4700acd5df84fd42ca7d</data>
      <data key="d12">11000</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="OSTEOCLASTOS">
      <data key="d8">9.0</data>
      <data key="d9">Osteoclasts are involved in the resorption of bone, which is a key factor in the development of osteoporosis</data>
      <data key="d10">08bc93c6dcf6df5ebf660f30b1f1ef2d</data>
      <data key="d11">72c19a79ec6b41baaa4326858a9b5d28</data>
      <data key="d12">11001</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="HUESO TRABECULAR">
      <data key="d8">8.0</data>
      <data key="d9">Trabecular bone is the most affected type of bone in osteoporosis, leading to increased fracture risk</data>
      <data key="d10">08bc93c6dcf6df5ebf660f30b1f1ef2d</data>
      <data key="d11">cef735b4c4bb42208410d58110726f00</data>
      <data key="d12">11002</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="DMO VERTEBRAL">
      <data key="d8">9.0</data>
      <data key="d9">Vertebral bone mineral density is a critical measure for assessing the severity of osteoporosis</data>
      <data key="d10">08bc93c6dcf6df5ebf660f30b1f1ef2d</data>
      <data key="d11">3f48c17eba354c8cb7b727e94a34f6e5</data>
      <data key="d12">11003</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="IGF-1">
      <data key="d8">1.0</data>
      <data key="d9">IGF-1 levels are influenced by glucocorticoids and play a role in bone formation, impacting osteoporosis</data>
      <data key="d10">08bc93c6dcf6df5ebf660f30b1f1ef2d</data>
      <data key="d11">7366abc80cdb4a678ada95f53f52c835</data>
      <data key="d12">11004</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="DIABETES MELLITUS TIPO 2">
      <data key="d8">5.0</data>
      <data key="d9">Regular physical activity can reduce the incidence of osteoporosis, which is relevant for individuals with diabetes</data>
      <data key="d10">dea64d5eb807430bc52e8bed6e30c393</data>
      <data key="d11">dba9aecd6f894f8ea9627805c1c704ba</data>
      <data key="d12">11005</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPOROSIS" target="EJERCICIO F&#205;SICO REGULAR">
      <data key="d8">7.0</data>
      <data key="d9">Regular physical exercise has been shown to decrease the incidence of osteoporosis</data>
      <data key="d10">dea64d5eb807430bc52e8bed6e30c393</data>
      <data key="d11">15432fc490404173bd186768a9613d7b</data>
      <data key="d12">11006</data>
