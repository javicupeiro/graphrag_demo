      <data key="d9">Ifosfamide can lead to nephrogenic diabetes insipidus as a side effect.</data>
      <data key="d10">1fb4c8ba1bc908ea3a3c7717a073fa4f</data>
      <data key="d11">e95b2f0a525f447cade5f8359602e9dd</data>
