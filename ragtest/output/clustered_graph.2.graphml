    <node id="ETOMIDATE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Etomidate is an intravenous anesthetic that suppresses adrenal cortisol synthesis, used in urgent clinical situations to lower cortisol levels.</data>
