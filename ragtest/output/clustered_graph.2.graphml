    </node>
    <node id="SOCIEDAD ESPA&#209;OLA DE NUTRICI&#211;N COMUNITARIA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Sociedad Espa&#241;ola de Nutrici&#243;n Comunitaria is an organization focused on community nutrition in Spain, known for publishing dietary guidelines for the Spanish population.</data>
      <data key="d2">8778654a17a48b8ea7b1cec378d52346</data>
