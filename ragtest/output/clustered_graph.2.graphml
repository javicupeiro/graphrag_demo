    <edge source="CVC" target="PSEUDOMONA AERUGINOSA">
      <data key="d8">14.0</data>
      <data key="d9">Pseudomonas aeruginosa is a bacterium known for its potential to cause serious infections, particularly in patients who have central venous catheters (CVCs) in place. It is recognized as a common pathogen associated with infections in individuals utilizing CVCs, highlighting the risks that these medical devices can pose to vulnerable patients.</data>
      <data key="d10">e5313f692c0a8259c93be803a704413c,fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d11">87804e14a1cf4bf98f4c63ff1b2abdbe</data>
      <data key="d12">10128</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CVC" target="STAPHYLOCOCCUS AUREUS">
