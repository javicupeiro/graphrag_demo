      <data key="d10">61890d3cb54fb752b95a4dfad8db8bb6</data>
      <data key="d11">eb5d8168f85c49d2bae346c9d368ef41</data>
      <data key="d12">9550</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EICH" target="ALOG&#201;NICO">
      <data key="d8">8.0</data>
      <data key="d9">El trasplante alog&#233;nico puede resultar en la aparici&#243;n de EICH, lo que representa un riesgo para el receptor.</data>
      <data key="d10">db0a4fc296a2fd5ecfbc4afcda444738</data>
      <data key="d11">35c4b8e382ef444eb989d5023f60a74c</data>
      <data key="d12">9551</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EICH" target="HLA">
      <data key="d8">6.0</data>
      <data key="d9">La compatibilidad del HLA puede influir en la severidad de la EICH en trasplantes alog&#233;nicos.</data>
