      <data key="d10">beef8f83c872431c6e371987b717e43b</data>
      <data key="d11">ec477a425f8b4d0f94e7ddabb7c54f25</data>
      <data key="d12">17868</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TEST DEL ALIENTO" target="HIDR&#211;GENO">
      <data key="d8">8.0</data>
      <data key="d9">Hydrogen levels are measured in the breath test to confirm carbohydrate malabsorption</data>
      <data key="d10">8c87213151750706e4e87956bfc9cb88</data>
      <data key="d11">e63e1414c3264281bb21dfc73bc01d33</data>
      <data key="d12">17869</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TEST DEL ALIENTO" target="METANO">
      <data key="d8">8.0</data>
      <data key="d9">Methane levels are also measured in the breath test to assess carbohydrate fermentation</data>
      <data key="d10">8c87213151750706e4e87956bfc9cb88</data>
      <data key="d11">7d536249da69455fa0f4ccef14e410cd</data>
      <data key="d12">17870</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TEST DEL ALIENTO" target="PREPARACIONES PARA COLONOSCOPIA">
      <data key="d8">5.0</data>
