      <data key="d6">3409</data>
      <data key="d7">8f88dccddc504660a3e681671b9b5d0b</data>
    </node>
    <node id="SARCOPEMIC OBESITY">
      <data key="d0">EVENT</data>
      <data key="d1">Sarcopenic obesity refers to the combination of sarcopenia (loss of muscle mass) and obesity, which is a significant concern in older adults.</data>
      <data key="d2">0903b40c7774225e89c5e798f9feef9b</data>
