    <node id="TABLA VIII">
      <data key="d0">EVENT</data>
      <data key="d1">Table VIII outlines the diagnostic criteria for dehydration, including symptoms and signs associated with the condition.</data>
      <data key="d2">186a95fdfe908123ad6f42d43b52ee1d</data>
