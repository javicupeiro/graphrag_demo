    <edge source="NUTRITIONAL SUPPORT" target="PHOSPHORUS">
      <data key="d8">6.0</data>
      <data key="d9">Phosphorus levels must be controlled as part of the nutritional support for patients with renal issues</data>
      <data key="d10">97a728c18b63007d07b6a4a5fc22d5e4</data>
