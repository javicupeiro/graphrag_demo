    </node>
    <node id="FUGAS A PERITONEO">
      <data key="d0">EVENT</data>
      <data key="d1">Leaks into the peritoneum are serious complications that can arise from gastrostomy procedures.</data>
      <data key="d2">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d3">1156</data>
      <data key="d4">2</data>
