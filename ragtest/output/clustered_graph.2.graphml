    </edge>
    <edge source="VITAMINA E" target="ANTIOXIDANTE">
      <data key="d8">8.0</data>
      <data key="d9">Vitamin E is an antioxidant that protects against lipid peroxidation and improves immune function.</data>
      <data key="d10">c879b2e3799c9353091ac931a92a99e8</data>
      <data key="d11">4961878d2cec47dea43ca8862ca15623</data>
