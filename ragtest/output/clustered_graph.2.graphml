      <data key="d0">EVENT</data>
      <data key="d1">HLA DR-DQ haplotypes are genetic variations that have been studied for their association with type 1 diabetes risk.</data>
      <data key="d2">d0231ac4e41b0e826d80763b5b8c61e0</data>
