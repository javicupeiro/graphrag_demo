    <node id="GASTRECTOM&#205;A TOTAL">
      <data key="d0">EVENT</data>
      <data key="d1">Gastrecom&#237;a total is a surgical procedure that involves the complete removal of the stomach, necessitating specific nutritional management.</data>
      <data key="d2">f7ca532ae3a834fd6643ad694d3e850c</data>
