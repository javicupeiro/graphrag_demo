    </edge>
    <edge source="ENFERMEDAD CARDIOVASCULAR" target="DIETAS VEGETARIANAS">
      <data key="d8">5.0</data>
      <data key="d9">Vegetarian diets may help reduce the risk of cardiovascular disease due to lower saturated fat intake</data>
