    <node id="ONCOLOGICAL TREATMENT">
      <data key="d0">EVENT</data>
      <data key="d1">Oncological treatment refers to medical care provided to patients with cancer, which may require specific dietary considerations.</data>
      <data key="d2">49279a0184d5222e806637f084f42c50</data>
