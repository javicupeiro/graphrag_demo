    <node id="ORNIT&#205;N TRANSACARBAMILASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ornit&#237;n transcarbamilasa (OTS) is an enzyme that catalyzes the conversion of carbamoyl phosphate and ornithine to citrulline in the urea cycle.</data>
      <data key="d2">0487e1a4525547575a1d284297280f9a</data>
      <data key="d5">2</data>
      <data key="d6">10687</data>
      <data key="d7">1e98dcd651fb42a08f3c6f893f29fe43</data>
