    </node>
    <node id="HMGA2">
      <data key="d0">PERSON</data>
      <data key="d1">HMGA2 es un oncog&#233;n que se ha asociado con la formaci&#243;n de adenomas hipofisarios.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1323</data>
      <data key="d4">2</data>
