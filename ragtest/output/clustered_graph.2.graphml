      <data key="d7">999dad307aba4642b0185a936825e6be</data>
    </node>
    <node id="ONCOPROTE&#205;NAS">
      <data key="d0">EVENT</data>
      <data key="d1">Las oncoprote&#237;nas son prote&#237;nas que pueden ser producidas por tumores, como los germinomas, y est&#225;n relacionadas con el l&#237;quido cefalorraqu&#237;deo.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
