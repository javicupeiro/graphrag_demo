    <edge source="TRIGLIC&#201;RIDOS DE CADENA MEDIA" target="DIETA CONTROLADA EN GRASAS">
      <data key="d8">8.0</data>
      <data key="d9">Medium-chain triglycerides are often included in controlled fat diets to improve nutrient absorption</data>
