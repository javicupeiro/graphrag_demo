    </edge>
    <edge source="CALCIO" target="LITIASIS">
      <data key="d8">1.0</data>
      <data key="d9">CALCIO can influence the crystallization process in urine, affecting stone formation</data>
      <data key="d10">64d85b2cd48849f9143370c8c04ab04c</data>
      <data key="d11">e9f4413027ab4a38a8f04f05befb7e2a</data>
      <data key="d12">8279</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CALCIO" target="LITIASIS RENAL">
      <data key="d8">8.0</data>
      <data key="d9">Adequate calcium intake is recommended to reduce the risk of kidney stones.</data>
      <data key="d10">451bbcaee8b1a025277b84488ea7db61</data>
      <data key="d11">96d3f7ecf3754a7cb1d5347ce3fe874e</data>
      <data key="d12">8280</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CALCIO" target="OXALATO">
      <data key="d8">1.0</data>
      <data key="d9">Calcium binds to oxalate in the intestines, which helps prevent the absorption of oxalate and its subsequent excretion in urine.</data>
      <data key="d10">451bbcaee8b1a025277b84488ea7db61</data>
      <data key="d11">99465e627def4fc8bafc56864ab16a56</data>
      <data key="d12">8281</data>
