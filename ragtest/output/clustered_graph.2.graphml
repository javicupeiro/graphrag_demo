    <node id="GLAUCOMA">
      <data key="d0">EVENT</data>
      <data key="d1">Glaucoma is a medical condition that is listed as a contraindication for the use of fentermina and topiramato.</data>
      <data key="d2">af631316aa8584710d755d8c59e851b6</data>
      <data key="d5">0</data>
      <data key="d6">8602</data>
      <data key="d7">4788a2f796ac42d8aa27297014288d67</data>
    </node>
    <node id="TAQUIARRITMIAS">
      <data key="d0">EVENT</data>
      <data key="d1">Taquiarritmias are a type of heart rhythm disorder that is mentioned as a precaution for patients using fentermina and topiramato.</data>
      <data key="d2">af631316aa8584710d755d8c59e851b6</data>
