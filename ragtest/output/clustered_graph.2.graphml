      <data key="d11">03c2f85d1bef473492706c4d07a6be71</data>
      <data key="d12">9410</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACIDOSIS LACTICA" target="FRUCTOSA-1,6-BIFOSFATASA">
      <data key="d8">7.0</data>
      <data key="d9">Fructosa-1,6-bifosfatas deficiency can lead to lactic acidosis due to metabolic disturbances.</data>
      <data key="d10">449046c83c1432d2b8cc6cacb5eadf51</data>
