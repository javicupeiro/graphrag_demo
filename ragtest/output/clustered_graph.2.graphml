      <data key="d7">eb74bd1c06c4470a93b943f26e129cac</data>
    </node>
    <node id="HYPOMAGNESEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hypomagnesemia is a condition of low magnesium levels in the blood, which can also be seen in patients with pancreatitis.</data>
      <data key="d2">46bc44144e19709e2d7f9838c9c54ccf</data>
      <data key="d3">1717</data>
