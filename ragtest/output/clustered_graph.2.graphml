      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ejercicio aer&#243;bico is a form of physical activity recommended for patients to improve their overall health and manage diabetes.</data>
      <data key="d2">dc7539b4d637d6dd09963c2564f4f084</data>
      <data key="d3">1109</data>
      <data key="d4">2</data>
