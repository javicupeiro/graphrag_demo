    </node>
    <node id="PLACEBO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Placebo is a control treatment used in clinical trials to compare the effects of liraglutida against no active medication.</data>
      <data key="d2">90c684dca4542bbe1177afd26e78581e</data>
