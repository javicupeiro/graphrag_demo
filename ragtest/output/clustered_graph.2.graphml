    <node id="HYPO-NATREMIA GUIDELINE DEVELOPMENT GROUP">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Hyponatremia Guideline Development Group is responsible for creating clinical practice guidelines for the diagnosis and treatment of hyponatremia.</data>
      <data key="d2">b9342cecd69cdc0e9936df041657f5f5</data>
      <data key="d5">1</data>
      <data key="d6">6231</data>
