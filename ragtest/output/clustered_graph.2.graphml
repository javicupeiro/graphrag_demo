      <data key="d11">e0550fc4de1145e293220aaa89f678b5</data>
      <data key="d12">9552</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EICH" target="TRASPLANTE">
      <data key="d8">8.0</data>
      <data key="d9">La EICH es una complicaci&#243;n que puede surgir despu&#233;s de un trasplante de c&#233;lulas hematopoy&#233;ticas, afectando la recuperaci&#243;n del paciente</data>
      <data key="d10">084639519c323a72fcf1322c38efd173</data>
      <data key="d11">1a0f33e1c47e4bcb8561f913b1509b12</data>
      <data key="d12">9553</data>
