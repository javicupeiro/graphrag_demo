    <node id="PACIENTE S&#201;PTICO">
      <data key="d0">PERSON</data>
      <data key="d1">El paciente s&#233;ptico es un individuo que presenta una respuesta inflamatoria sist&#233;mica a una infecci&#243;n, lo que requiere un tratamiento nutricional espec&#237;fico.</data>
      <data key="d2">422dbd193843eb5098307e57ba002ced</data>
