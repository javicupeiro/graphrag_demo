    </edge>
    <edge source="SEPSIS" target="HEPATOBILIARY COMPLICATIONS">
      <data key="d8">7.0</data>
      <data key="d9">Sepsis can lead to elevated liver enzymes and is a common complication in patients receiving parenteral nutrition</data>
      <data key="d10">036e8182deab774d39f06cd811738c9b</data>
      <data key="d11">183ad6703a904c7b8f956affa0c3db01</data>
      <data key="d12">6842</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="CITOQUINAS">
      <data key="d8">6.0</data>
      <data key="d9">Cytokines are released during sepsis and can impact liver function, contributing to hepatobiliary complications</data>
      <data key="d10">036e8182deab774d39f06cd811738c9b</data>
      <data key="d11">dde54cdc569b48bf8582ea9d426fb957</data>
      <data key="d12">6843</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="INFECCI&#211;N">
      <data key="d8">9.0</data>
      <data key="d9">La sepsis puede ser una consecuencia grave de infecciones relacionadas con cat&#233;teres venosos centrales.</data>
