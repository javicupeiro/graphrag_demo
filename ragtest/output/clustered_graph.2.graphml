    <node id="EDMAS GENERALIZADOS">
      <data key="d0">EVENT</data>
      <data key="d1">Generalized edema is a common condition in burn patients due to massive fluid infusion, affecting various body systems.</data>
      <data key="d2">916d4d35de887923f4ea5b05928f13e3</data>
      <data key="d3">1113</data>
      <data key="d4">2</data>
