      <data key="d4">2</data>
      <data key="d5">7</data>
      <data key="d6">7182</data>
      <data key="d7">c8dd41ca1f374e9da8020ee1d65e1147</data>
    </node>
    <node id="YEUJUNOSTOMY">
      <data key="d0">EVENT</data>
      <data key="d1">Yeyunostomy is a surgical procedure that connects the stomach to the jejunum for nutritional purposes.</data>
      <data key="d2">3a5d7e4dc412f1d4701672c3af3cb4ed</data>
      <data key="d3">1109</data>
