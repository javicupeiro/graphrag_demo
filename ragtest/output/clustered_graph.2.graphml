      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICIONES PARENTERALES ADULTOS PROTOCOLIZADAS EN EL HOSPITAL" target="GUIDELINES FOR THE USE OF PARENTERAL AND ENTERAL NUTRITION">
      <data key="d8">7.0</data>
