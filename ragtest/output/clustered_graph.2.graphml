      <data key="d11">2af4244d611149efa2f4e58e9a53c727</data>
      <data key="d12">16745</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SENC" target="TEMA 53">
      <data key="d8">8.0</data>
      <data key="d9">Tema 53 is a dietary guideline provided by SENC for pediatric patients</data>
      <data key="d10">72ed1fffc10ea163a92b5f1a7b972732</data>
