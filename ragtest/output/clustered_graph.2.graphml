      <data key="d12">16387</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VERDURAS" target="CRUC&#205;FERAS">
      <data key="d8">1.0</data>
      <data key="d9">Las verduras cruc&#237;feras son un tipo espec&#237;fico de verduras que se ha estudiado por sus efectos en la reducci&#243;n del riesgo de c&#225;ncer</data>
      <data key="d10">240ded3c69bd7ae82bed4089517ffb6b</data>
      <data key="d11">088b556ce0084546bd40831b19c05426</data>
      <data key="d12">16388</data>
