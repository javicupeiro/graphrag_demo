    <node id="GASTRECTOMY VERTICAL">
      <data key="d0">EVENT</data>
      <data key="d1">Gastrectomy vertical is a surgical technique for weight loss that involves the removal of a portion of the stomach.</data>
      <data key="d2">7eea8ed505de441028811dbb848d0fa0</data>
      <data key="d3">1393</data>
