    </node>
    <node id="TMO">
      <data key="d0">EVENT</data>
      <data key="d1">TMO refers to bone marrow transplantation, a type of hematopoietic stem cell transplantation.</data>
      <data key="d2">61890d3cb54fb752b95a4dfad8db8bb6</data>
