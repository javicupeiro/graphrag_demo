    </edge>
    <edge source="GLUTEN" target="MA&#205;Z">
      <data key="d8">1.0</data>
      <data key="d9">Corn is a gluten-free cereal grain that does not trigger symptoms in individuals with celiac disease.</data>
      <data key="d10">281c46dd2bcde6e6fbb1505ed667b0e9</data>
      <data key="d11">d30872cc31864132a5c730919400cebf</data>
      <data key="d12">16901</data>
