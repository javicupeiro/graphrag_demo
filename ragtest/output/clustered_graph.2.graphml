      <data key="d1">Vitamin B1, also known as thiamine, is a B vitamin that plays a crucial role in energy metabolism and nerve function.</data>
      <data key="d2">acfde2ff93b969353912836034d74242</data>
      <data key="d3">1629</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16938</data>
      <data key="d7">2370c97beaaf4fee9225f68ce6c11fde</data>
    </node>
    <node id="VITAMIN B3">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Vitamin B3, also known as niacin, is a B vitamin that supports metabolism and DNA repair.</data>
      <data key="d2">acfde2ff93b969353912836034d74242</data>
      <data key="d3">1629</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16939</data>
      <data key="d7">bb962d80d1d34262ae4fb24e73f9050d</data>
    </node>
    <node id="VITAMIN B5">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Vitamin B5, or pantothenic acid, is a B vitamin essential for the synthesis of coenzyme A and fatty acid metabolism.</data>
      <data key="d2">acfde2ff93b969353912836034d74242</data>
      <data key="d3">1627</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16940</data>
      <data key="d7">69229fa7c04a4aa398d3fe26e6603556</data>
    </node>
    <node id="VITAMIN D3">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Vitamin D3 is a form of vitamin D that is important for calcium absorption and bone health.</data>
      <data key="d2">acfde2ff93b969353912836034d74242</data>
      <data key="d3">1630</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16941</data>
      <data key="d7">64fa920d1dbf45bda56afafedb24856c</data>
    </node>
    <node id="POLI A*B*E5">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Poli A*B*E5 is a pharmaceutical product containing 50 mg and 50 UI of active ingredients.</data>
      <data key="d2">86129e76900522a439d2234eea76e3b9</data>
      <data key="d5">0</data>
      <data key="d6">16942</data>
      <data key="d7">caa4b6a0fd0c45d1862ef03dda320d47</data>
    </node>
    <node id="PROTOVIT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Protovit is a pharmaceutical product available in drops, containing various dosages of active ingredients.</data>
      <data key="d2">86129e76900522a439d2234eea76e3b9</data>
      <data key="d5">0</data>
      <data key="d6">16943</data>
      <data key="d7">62fc4782c4b64b81bd1c00ea73661e37</data>
    </node>
    <node id="REVIT NM">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Revit NM is a pharmaceutical product available in capsule form, containing 60 mg and 500 &#956;g of active ingredients.</data>
      <data key="d2">86129e76900522a439d2234eea76e3b9</data>
      <data key="d5">0</data>
      <data key="d6">16944</data>
      <data key="d7">c7649bf5d69743288366b15fa10ec00a</data>
    </node>
    <node id="SOLUVIT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Soluvit is a pharmaceutical product administered via intravenous injection, containing various dosages of active ingredients.</data>
      <data key="d2">86129e76900522a439d2234eea76e3b9</data>
      <data key="d5">0</data>
      <data key="d6">16945</data>
      <data key="d7">3f7da46e2d6248a38c601609073df70f</data>
    </node>
    <node id="D2:VITALIPID">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">D2:Vitalipid is a pharmaceutical product that is administered via intravenous injection. It contains 330 UI along with other dosages of active ingredients.</data>
      <data key="d2">86129e76900522a439d2234eea76e3b9</data>
      <data key="d5">0</data>
      <data key="d6">16946</data>
      <data key="d7">eb6f2cde54d14bcd95873c7d7f9df306</data>
    </node>
