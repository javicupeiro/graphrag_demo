      <data key="d7">576ff5eee9e44a04bc7d93fd618a0bda</data>
    </node>
    <node id="SALA DE NEUROLOG&#205;A">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Neurology ward is a medical facility where patients with neurological disorders, including dysphagia, are treated.</data>
