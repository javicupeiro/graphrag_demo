    <edge source="ESTUDIOS ECOLOGICOS" target="ESTUDIOS DE CASOS Y CONTROLES">
      <data key="d8">1.0</data>
      <data key="d9">Both ecological studies and case-control studies are types of epidemiological studies used to analyze health-related issues</data>
