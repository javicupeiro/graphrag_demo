    </edge>
    <edge source="FEOCROMOCITOMA" target="MUTACIONES">
      <data key="d8">1.0</data>
      <data key="d9">Mutations in specific genes can lead to the development of feocromocitomas</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">eff6d0da580049229da1fa9e5431d4d8</data>
      <data key="d12">11970</data>
