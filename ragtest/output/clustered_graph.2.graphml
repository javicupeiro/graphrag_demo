      <data key="d7">ddea5cb86bb24ca599acd69491beddff</data>
    </node>
    <node id="HISTORIA CL&#205;NICA ELECTR&#211;NICA">
      <data key="d0">EVENT</data>
      <data key="d1">The "HISTORIA CL&#205;NICA ELECTR&#211;NICA" (HCE) is an electronic health record system designed to store and manage comprehensive patient data. It includes the nutritional and medical history of patients, facilitating their ongoing monitoring and care. The HCE plays a crucial role in managing health conditions by providing vital information that supports healthcare professionals in making informed decisions regarding patient treatment and follow-up.</data>
      <data key="d2">514518b96e32b025815b45cc2a504f0d,b7034350b98abd27ed6af7560149691d</data>
      <data key="d3">1131</data>
