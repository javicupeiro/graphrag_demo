    </edge>
    <edge source="HIERRO" target="ENTRENAMIENTO DE FUERZA">
      <data key="d8">1.0</data>
      <data key="d9">El hierro es importante para el rendimiento en el entrenamiento de fuerza, ya que ayuda en la producci&#243;n de energ&#237;a</data>
      <data key="d10">bb9a5c32408b601f9ecedc2a2b82d6b6</data>
      <data key="d11">f38c6c40f8de4a7fae72ff56b8b4f8ea</data>
