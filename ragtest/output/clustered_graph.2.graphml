    <node id="F&#211;RMULAS CON REPARTO EQUILIBRADO DE NUTRIENTES">
      <data key="d0">EVENT</data>
      <data key="d1">Balanced nutrient formulas are designed to provide a specific quality of carbohydrates and fiber for better absorption in diabetic patients.</data>
      <data key="d2">d3dab2869ed103bbf74ecb1a4a822567</data>
