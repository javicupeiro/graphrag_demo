    </edge>
    <edge source="UNIDAD FUNCIONAL DE DISFAGIA OROFAR&#205;NGEA" target="GRD">
      <data key="d8">5.0</data>
      <data key="d9">The Unidad Funcional de Disfagia Orofar&#237;ngea utilizes GRD to assess the complexity of patient care and resource allocation</data>
      <data key="d10">5dd39815651d2d44f18c16e69696c0cf</data>
      <data key="d11">7f80e92a5c5a499a989919735e134ed6</data>
