    <node id="ASOCIACI&#211;N DE CEL&#205;ACOS ITALIANA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Italian Celiac Association is responsible for granting ELS certification in Italy for gluten-free products.</data>
