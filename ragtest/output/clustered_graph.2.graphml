    <node id="CUIDADOS PALIATIVOS ONCOL&#211;GICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Son cuidados paliativos espec&#237;ficos para pacientes con c&#225;ncer incurable, enfocados en el control de s&#237;ntomas asociados al tumor o a su tratamiento.</data>
      <data key="d2">54f3b76c0240696aa63ae60ad52b82b6</data>
