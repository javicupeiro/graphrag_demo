    <node id="ALIMENTACI&#211;N V&#205;A NASOG&#193;STRICA">
      <data key="d0">EVENT</data>
      <data key="d1">Nasogastric feeding involves placing a tube through the nose into the stomach for nutritional support.</data>
      <data key="d2">20491afa9a4770e93e6cff9034f8b0f0</data>
