      <data key="d13">2</data>
    </edge>
    <edge source="OSTEOPENIA" target="GSDIB">
      <data key="d8">5.0</data>
      <data key="d9">Osteopenia can occur in patients with GSDIb due to chronic metabolic disturbances affecting bone health.</data>
