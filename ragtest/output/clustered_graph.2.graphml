    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="DIARREA GRAVE PERSISTENTE">
      <data key="d8">9.0</data>
      <data key="d9">Diarrea grave persistente is a contraindication for the use of nutritional support via enteral nutrition</data>
