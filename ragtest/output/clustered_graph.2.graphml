    <node id="SULLIVAN DH">
      <data key="d0">PERSON</data>
      <data key="d1">Sullivan DH is an author who studied the impact of nutrition status on morbidity and mortality in geriatric patients.</data>
      <data key="d2">2f5d9123a78d23b1bc3d9f06d7a53d78</data>
      <data key="d3">721</data>
      <data key="d4">2</data>
