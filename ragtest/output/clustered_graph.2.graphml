      <data key="d0">EVENT</data>
      <data key="d1">Procedimiento m&#233;dico que fue muy mal tolerado por la paciente durante la evaluaci&#243;n de su condici&#243;n.</data>
      <data key="d2">39ea441f219d949e8bc3c6f430970689</data>
