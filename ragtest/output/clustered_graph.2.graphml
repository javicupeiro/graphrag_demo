      <data key="d7">273609a08ba04b71ad9bf5eaf354ca84</data>
    </node>
    <node id="ESTADO FUNCIONAL">
      <data key="d0">EVENT</data>
      <data key="d1">El estado funcional se eval&#250;a mediante la fuerza del brazo y la resistencia f&#237;sica del paciente durante el tratamiento de nutrici&#243;n parenteral.</data>
      <data key="d2">5cf1703fd601b27dd0ebda9f20cb3259</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">2034</data>
      <data key="d7">b4164b57d28743c4ab91bd3c628ddf37</data>
    </node>
    <node id="FUNCION GASTROINTESTINAL">
      <data key="d0">EVENT</data>
      <data key="d1">La funci&#243;n gastrointestinal se controla para detectar alteraciones en la ingesta del paciente que recibe nutrici&#243;n parenteral.</data>
      <data key="d2">5cf1703fd601b27dd0ebda9f20cb3259</data>
