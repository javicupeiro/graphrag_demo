    <edge source="DIABETES 2" target="PALMER BF">
      <data key="d8">7.0</data>
      <data key="d9">Palmer BF has studied electrolyte and acid-base disturbances in patients with diabetes, which is relevant to the management of Diabetes 2</data>
      <data key="d10">9889a9000d5a82ffba9e0f6c92da918a</data>
      <data key="d11">c5d47ab3f6cb44ba863975d9d4f5de09</data>
