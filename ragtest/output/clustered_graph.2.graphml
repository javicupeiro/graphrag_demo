      <data key="d10">502bae6c907e900b95f5fe6aa963b0fc</data>
      <data key="d11">7d6c7046829044d8af26e5dd29bf5104</data>
      <data key="d12">9774</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="PA">
      <data key="d8">8.0</data>
      <data key="d9">Hyperglycemia is a common complication in patients with severe pancreatitis</data>
      <data key="d10">46bc44144e19709e2d7f9838c9c54ccf</data>
      <data key="d11">cff7151d91c14f6096660cff4a615d0b</data>
      <data key="d12">9775</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="HYPERGLYCEMIA CONTROL">
      <data key="d8">8.0</data>
      <data key="d9">Hyperglycemia control is necessary to manage the risks associated with high blood glucose levels in critically ill patients</data>
      <data key="d10">a66b01654a2f495559fd1a24efc0e64e</data>
      <data key="d11">b1efa93df13f49c28fde933b7843c13a</data>
      <data key="d12">9776</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="METZGER BE">
      <data key="d8">7.0</data>
      <data key="d9">Metzger BE's research focuses on hyperglycemia in pregnancy, which is a significant concern in diabetes management</data>
      <data key="d10">54bdd3faa067cdbb44671453ffaf4be5</data>
      <data key="d11">343283e9902142eca300087b0bf4cc71</data>
      <data key="d12">9777</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="TOTAL PARENTERAL NUTRITION">
      <data key="d8">17.0</data>
      <data key="d9">Hyperglycemia is a common complication that arises in patients receiving total parenteral nutrition (TPN). It is a significant concern for these patients, as the presence of hyperglycemia can indicate poor clinical outcomes and is associated with increased mortality rates. Therefore, monitoring and managing blood glucose levels in individuals on TPN is crucial to mitigate the risks associated with hyperglycemia.</data>
      <data key="d10">64378df2be6b08b39bd652c0a2d3789c,a265c943c66b9cb5d09f89d40ddb995f</data>
      <data key="d11">9ea4177ac5644ee4869e81f997480340</data>
      <data key="d12">9778</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="DIABETES CARE">
      <data key="d8">7.0</data>
      <data key="d9">Diabetes Care is a publication that focuses on research related to the management of hyperglycemia, especially in patients who are receiving parenteral nutrition. The journal publishes a variety of studies and articles that address hyperglycemia and its management specifically in diabetic patients, contributing valuable insights into effective diabetes care practices.</data>
      <data key="d10">64378df2be6b08b39bd652c0a2d3789c,a265c943c66b9cb5d09f89d40ddb995f</data>
      <data key="d11">aff97849671f4be58a76315e7cbd50bf</data>
