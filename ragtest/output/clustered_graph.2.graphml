      <data key="d10">9f5a8d86160d5d097bca174e2e2496c1</data>
      <data key="d11">e037da6b1f1646d8831b1c9f33a71ea8</data>
      <data key="d12">13304</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="ALMID&#211;N CRUDO DE MA&#205;Z">
      <data key="d8">8.0</data>
      <data key="d9">Raw corn starch is used to prevent hypoglycemia in patients with glycogen storage diseases</data>
      <data key="d10">9f5a8d86160d5d097bca174e2e2496c1</data>
      <data key="d11">a0c36f17bd3843d19635422cc41156c1</data>
      <data key="d12">13305</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="GSDVI">
      <data key="d8">7.0</data>
