    <node id="NUTRITIONAL SUPPORT OF CANCER PATIENTS">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional support of cancer patients is a critical area of research addressing the needs and challenges faced by cancer patients.</data>
