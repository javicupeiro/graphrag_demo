    </edge>
    <edge source="MUCOSITIS" target="CANCER PATIENTS">
      <data key="d8">1.0</data>
      <data key="d9">Mucositis is a common complication in cancer patients undergoing treatment, affecting their ability to swallow and necessitating nutritional interventions.</data>
