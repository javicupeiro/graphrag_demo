      <data key="d11">474093f880a64de1a8a854af87c1048c</data>
      <data key="d12">6655</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALERGENOS" target="ANAFILAXIA">
      <data key="d8">9.0</data>
      <data key="d9">Los al&#233;rgenos son responsables de causar anafilaxia en individuos susceptibles.</data>
      <data key="d10">e0a2b5f5d5b3682c870f787f54f6b5ef</data>
      <data key="d11">96a84c8644314f97ad4b0319b0d9dfe9</data>
      <data key="d12">6656</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALERGENOS" target="REGULAMENTO (UE) N.&#186; 1169/2011">
      <data key="d8">8.0</data>
      <data key="d9">El reglamento exige destacar al&#233;rgenos en el etiquetado de alimentos</data>
