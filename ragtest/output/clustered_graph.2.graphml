    <node id="INFLAMMATION SYSTEM">
      <data key="d0">EVENT</data>
      <data key="d1">The inflammation system is a biological response to harmful stimuli, which is often activated in the context of frailty and comorbidities.</data>
      <data key="d2">0903b40c7774225e89c5e798f9feef9b</data>
      <data key="d3">1762</data>
