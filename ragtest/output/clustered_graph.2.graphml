    </node>
    <node id="CULTURA DE SEGURIDAD">
      <data key="d0">EVENT</data>
      <data key="d1">A safety culture in healthcare emphasizes the importance of safety and risk management practices among healthcare professionals.</data>
      <data key="d2">07e45dae0f017eba9ef9f48439de5c59</data>
      <data key="d3">43</data>
