      <data key="d10">cc9543ac7abe58ae289e1fbd5353e219</data>
      <data key="d11">437fdcec89e2483082ebdd24d2bf77e4</data>
      <data key="d12">15037</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NURIA VALDES GALLEGO" target="GETNE">
      <data key="d8">8.0</data>
