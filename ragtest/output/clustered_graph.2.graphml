    <node id="CICLOS DE PESO">
      <data key="d0">EVENT</data>
      <data key="d1">Los ciclos de peso se refieren a las fluctuaciones en el peso corporal, que pueden afectar la salud cardiovascular y la recurrencia de arritmias.</data>
      <data key="d2">884a8370915a18a005fb2fa913e4b95c</data>
