      <data key="d6">1265</data>
      <data key="d7">5ba1de7c19874e9d81cf2fc35d0e271d</data>
    </node>
    <node id="DISPOSITIVOS TECNOL&#211;GICOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Technological devices, such as wearables, are designed to monitor health parameters and collect data relevant to patient care and management.</data>
      <data key="d2">b7034350b98abd27ed6af7560149691d</data>
      <data key="d3">1131</data>
      <data key="d4">2</data>
