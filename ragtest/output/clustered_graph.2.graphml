    <node id="DEFERASIROX">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Deferasirox is another iron chelator indicated for certain forms of iron overload, such as thalassemia major and chronic hemolytic anemia.</data>
      <data key="d2">83d2bb17e643e047bb3ad2ecc88d8271</data>
