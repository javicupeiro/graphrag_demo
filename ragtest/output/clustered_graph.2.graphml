    <edge source="NUTRIENTES" target="SONDAS NASOENTERALES">
      <data key="d8">8.0</data>
      <data key="d9">Las sondas nasoenterales se utilizan para la administraci&#243;n de nutrientes a pacientes con problemas gastrointestinales.</data>
