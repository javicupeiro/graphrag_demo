      <data key="d10">5236affa95aaf73b0f2d08e839e4db54</data>
      <data key="d11">630bb97bae314ef48427312ec809c7bc</data>
      <data key="d12">17129</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIQUID DIET" target="SEMISOLID DIET">
      <data key="d8">8.0</data>
      <data key="d9">The semisolid diet follows the liquid diet as the next phase of dietary adaptation</data>
