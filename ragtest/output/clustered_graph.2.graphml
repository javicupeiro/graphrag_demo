    <node id="HIPOGLICEMIA AGUDA">
      <data key="d0">EVENT</data>
      <data key="d1">Acute hypoglycemia is a rapid drop in blood sugar levels that can lead to symptoms such as confusion, seizures, and loss of consciousness.</data>
      <data key="d2">773a1daa539dd85e562a59e09f434af1</data>
      <data key="d3">1427</data>
      <data key="d4">2</data>
