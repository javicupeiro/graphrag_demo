    </node>
    <node id="SITUACIONES DE ESTR&#201;S">
      <data key="d0">EVENT</data>
      <data key="d1">Las situaciones de estr&#233;s pueden afectar los niveles de prote&#237;nas plasm&#225;ticas y el estado nutricional de los pacientes.</data>
      <data key="d2">9562f39f9e78644164daeff3177a2f84</data>
      <data key="d3">1085</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13644</data>
      <data key="d7">3c49361e449b467cb699aab1843c5387</data>
    </node>
    <node id="ENTEROPAT&#205;AS">
      <data key="d0">EVENT</data>
      <data key="d1">Las enteropat&#237;as son condiciones que pueden llevar a la p&#233;rdida de prote&#237;nas y afectar el estado nutricional de los pacientes.</data>
      <data key="d2">9562f39f9e78644164daeff3177a2f84</data>
