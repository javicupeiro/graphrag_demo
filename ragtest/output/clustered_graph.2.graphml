      <data key="d0">ORGANIZATION</data>
      <data key="d1">Insulina degludec is a newer long-acting insulin used to improve glycemic control in patients with diabetes.</data>
      <data key="d2">dc7539b4d637d6dd09963c2564f4f084</data>
