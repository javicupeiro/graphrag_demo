      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d11">514e69f8ba904fd6b9a4d5ddaff2821f</data>
      <data key="d12">2315</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PATIENT" target="OROPHARYNX">
      <data key="d8">6.0</data>
      <data key="d9">The oropharynx is an area of concern during the evaluation of the patient's swallowing capabilities</data>
      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d11">54d38e67bfe747ec9c773fb5f1417f04</data>
      <data key="d12">2316</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PATIENT" target="HYPOPHARYNX">
      <data key="d8">6.0</data>
