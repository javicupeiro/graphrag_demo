      <data key="d10">fd661ab8e042d0fed76b34b7ceff6631</data>
      <data key="d11">f51e503ebe044c27b4c9af09ad7a9602</data>
      <data key="d12">3851</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTOS" target="GOS">
      <data key="d8">6.0</data>
      <data key="d9">GOS are included in alimentos for their health benefits</data>
      <data key="d10">fd661ab8e042d0fed76b34b7ceff6631</data>
