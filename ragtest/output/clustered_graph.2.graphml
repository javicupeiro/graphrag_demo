      <data key="d7">e027abd5ae06468d9d37103947f2f4be</data>
    </node>
    <node id="BILIS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Bilis is a digestive fluid produced by the liver that contains electrolytes and aids in digestion.</data>
