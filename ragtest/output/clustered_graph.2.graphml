    </node>
    <node id="HIPOGLICEMIA CR&#211;NICA">
      <data key="d0">EVENT</data>
      <data key="d1">Chronic hypoglycemia refers to persistently low blood sugar levels over an extended period, which can have various causes and health implications.</data>
      <data key="d2">773a1daa539dd85e562a59e09f434af1</data>
      <data key="d3">1427</data>
      <data key="d4">2</data>
