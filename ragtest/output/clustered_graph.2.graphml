      <data key="d10">cb8368db73f739b1f11f2a202c776e6d</data>
      <data key="d11">312862bcacbf4ad3899e58a0a92ddf53</data>
      <data key="d12">11057</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REV ESP GERIATR GERONTOL" target="GELANCH J">
      <data key="d8">8.0</data>
      <data key="d9">Gelanch J is one of the authors of the study published in Rev Esp Geriatr Gerontol</data>
      <data key="d10">cb8368db73f739b1f11f2a202c776e6d</data>
      <data key="d11">d0fb9c0ba28c46759f3f3513621c5d29</data>
      <data key="d12">11058</data>
