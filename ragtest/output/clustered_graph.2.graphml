      <data key="d7">0450296a1bfc4662a77cd738c5bed446</data>
    </node>
    <node id="RANGOS ACEPTABLES DE DISTRIBUCI&#211;N DE NUTRIENTES">
      <data key="d0">EVENT</data>
      <data key="d1">Acceptable Macronutrient Distribution Ranges (AMDR) are guidelines for nutrient intake to reduce chronic disease risk.</data>
      <data key="d2">dea64d5eb807430bc52e8bed6e30c393</data>
      <data key="d3">1390</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
