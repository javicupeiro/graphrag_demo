    </node>
    <node id="RIBEFOOD">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ribefood is an interactive web application designed for dietary adherence surveys.</data>
      <data key="d2">f14ec70726a24a574ae5d437903fddb8</data>
      <data key="d3">1445</data>
