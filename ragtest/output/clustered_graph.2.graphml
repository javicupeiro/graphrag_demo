    </node>
    <node id="F&#211;RMULAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Formulas refer to nutritional solutions designed for infants and children, tailored to their specific dietary needs based on age and health conditions.</data>
      <data key="d2">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d3">665</data>
      <data key="d4">2</data>
