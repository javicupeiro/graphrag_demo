    <edge source="MEDITERRANEAN DIET" target="SENIOR NUTRITION">
      <data key="d8">1.0</data>
      <data key="d9">The Mediterranean diet is a recommended dietary pattern for senior nutrition due to its health benefits</data>
      <data key="d10">3ec3efbe130c20d623681e00e3d784f7</data>
      <data key="d11">d507ae5c7fca48399410e5a9a0dea043</data>
