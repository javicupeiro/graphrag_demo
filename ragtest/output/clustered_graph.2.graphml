    </edge>
    <edge source="DIETA EQUILIBRADA" target="LITIASIS RENAL">
      <data key="d8">8.0</data>
      <data key="d9">Dieta equilibrada is crucial for preventing kidney stones, establishing a strong relationship between diet and the condition.</data>
      <data key="d10">9ea70909c43b9b7923a0fa217c0e7290</data>
