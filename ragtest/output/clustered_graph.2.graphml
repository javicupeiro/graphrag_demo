      <data key="d9">NAP.EDU provides access to research and publications from the American Institute of Medicine</data>
      <data key="d10">d091ddf14a273c8981b300afdea77912</data>
      <data key="d11">7faa4ca7d6ed4fe59bd47c2b6201f252</data>
      <data key="d12">16729</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RIESGO" target="INGESTA &#211;PTIMA">
      <data key="d8">8.0</data>
      <data key="d9">The risk of inadequate intake is directly related to the optimal intake levels defined by health organizations</data>
      <data key="d10">d091ddf14a273c8981b300afdea77912</data>
      <data key="d11">8298b5b9421e45858d1f7a0709b6956d</data>
      <data key="d12">16730</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RIESGO" target="NIVEL DE INGESTA">
      <data key="d8">1.0</data>
      <data key="d9">The level of intake is assessed in relation to the risk of adverse effects from inadequate or excessive nutrient intake</data>
      <data key="d10">d091ddf14a273c8981b300afdea77912</data>
      <data key="d11">005ef144e7dc4889aab6714da493f1ed</data>
      <data key="d12">16731</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RIESGO" target="CULTURA DE SEGURIDAD">
      <data key="d8">9.0</data>
      <data key="d9">Risk management is a fundamental aspect of establishing a safety culture in healthcare settings.</data>
      <data key="d10">07e45dae0f017eba9ef9f48439de5c59</data>
      <data key="d11">7b1e588adf4a4e8c89b3f5213859c04b</data>
      <data key="d12">16732</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DRI" target="RDA">
      <data key="d8">17.0</data>
      <data key="d9">The Dietary Reference Intakes (DRI) encompass the Recommended Dietary Allowances (RDA) as part of their guidelines for nutrient intake. The RDA serves as a specific component within the DRI framework, offering detailed recommendations for the amounts of essential nutrients that individuals should consume to maintain optimal health. Together, DRI and RDA provide a comprehensive approach to understanding and meeting nutritional needs.</data>
      <data key="d10">88d6f98c356e5a49db38ab5aa960bb95,d091ddf14a273c8981b300afdea77912</data>
      <data key="d11">e00e285e8b5e450286f51f2bced59bb6</data>
      <data key="d12">16733</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DRI" target="AI">
      <data key="d8">9.0</data>
      <data key="d9">DRI includes Adequate Intake (AI) as a measure for assessing nutrient adequacy.</data>
      <data key="d10">88d6f98c356e5a49db38ab5aa960bb95</data>
      <data key="d11">103f6c0a93b04f53ac725ec2179f5c8c</data>
      <data key="d12">16734</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RDA" target="UL">
      <data key="d8">7.0</data>
      <data key="d9">RDA and UL are both part of the dietary guidelines that help define safe and adequate nutrient intake levels</data>
      <data key="d10">d091ddf14a273c8981b300afdea77912</data>
      <data key="d11">797d2186fce041f88ffedec5c3182f5e</data>
      <data key="d12">16735</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RDA" target="EAR">
      <data key="d8">13.0</data>
      <data key="d9">The Estimated Average Requirement (EAR) is utilized to determine the Recommended Dietary Allowance (RDA) for specific populations. Both the RDA and EAR are integral components of dietary guidelines that assess the adequacy of nutrient intake.</data>
      <data key="d10">88d6f98c356e5a49db38ab5aa960bb95,d091ddf14a273c8981b300afdea77912</data>
      <data key="d11">b0a17905ee314856be082cec528b7827</data>
      <data key="d12">16736</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RDA" target="EU">
      <data key="d8">5.0</data>
      <data key="d9">The EU is working on the implementation and harmonization of legislation related to Recommended Dietary Allowances (RDA) for food labeling.</data>
      <data key="d10">88d6f98c356e5a49db38ab5aa960bb95</data>
      <data key="d11">d3c37670d9984ad29f6dcd39330077b4</data>
      <data key="d12">16737</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RDA" target="PACIENTE ONCOL&#211;GICO">
      <data key="d8">6.0</data>
      <data key="d9">Los pacientes oncol&#243;gicos deben seguir las RDA para asegurar una ingesta adecuada de nutrientes durante su tratamiento</data>
      <data key="d10">d667e6abc204bbfa6aba210705db6d56</data>
      <data key="d11">d5cd817aa2f5499396d4f34f462ea151</data>
      <data key="d12">16738</data>
      <data key="d13">2</data>
    </edge>
    <edge source="UL" target="NOAEL">
      <data key="d8">5.0</data>
      <data key="d9">NOAEL helps establish the UL by indicating the highest dose without adverse effects</data>
      <data key="d10">d091ddf14a273c8981b300afdea77912</data>
      <data key="d11">ee523089f652452bb541bab801c4fd14</data>
      <data key="d12">16739</data>
      <data key="d13">2</data>
    </edge>
    <edge source="UL" target="AI">
      <data key="d8">1.0</data>
      <data key="d9">AI and UL are both part of the dietary guidelines that help assess nutrient intake levels and safety.</data>
      <data key="d10">88d6f98c356e5a49db38ab5aa960bb95</data>
      <data key="d11">041c97a61b044ffcbe07563d38a405c4</data>
      <data key="d12">16740</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LOAEL" target="EFECTOS ADVERSOS">
      <data key="d8">1.0</data>
      <data key="d9">LOAEL indicates the lowest dose that causes adverse effects, linking it to potential health risks</data>
      <data key="d10">d091ddf14a273c8981b300afdea77912</data>
      <data key="d11">7725f002d90749f7a919092af5d35317</data>
      <data key="d12">16741</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EU" target="SODIUM INTAKE">
      <data key="d8">8.0</data>
      <data key="d9">The EU provides dietary recommendations for sodium intake to help manage public health</data>
      <data key="d10">7ff62e1dc423be2f4b2fe08546751d0d</data>
      <data key="d11">ccc2392eadc645a8abd0a8a5bef8fb30</data>
      <data key="d12">16742</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EU" target="POTASSIUM INTAKE">
      <data key="d8">1.0</data>
      <data key="d9">The EU recommends potassium intake to reduce cardiovascular risks</data>
      <data key="d10">7ff62e1dc423be2f4b2fe08546751d0d</data>
      <data key="d11">cc822f63fbd240fa8f9e18dd3b89ab3a</data>
      <data key="d12">16743</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SENC" target="POBLACI&#211;N GENERAL">
      <data key="d8">8.0</data>
      <data key="d9">SENC has developed nutritional recommendations aimed at the general population to promote health and prevent chronic diseases</data>
      <data key="d10">c2a8dd9d28d1992a73de2834131b69c9</data>
      <data key="d11">0817fa332b234d63b67e81c903591709</data>
      <data key="d12">16744</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SENC" target="NUTRICI&#211;N PEDI&#193;TRICA">
