      <data key="d11">bb35340961f94e83b34d37d27dab0a03</data>
      <data key="d12">6845</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="DALY">
      <data key="d8">5.0</data>
      <data key="d9">Daly's research on nutritional support is relevant to patients suffering from sepsis, as it evaluates clinical outcomes in this population.</data>
      <data key="d10">0f965e7f43fe2ea0144b4b16715a04ba</data>
