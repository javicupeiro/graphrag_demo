    </edge>
    <edge source="SEPSIS" target="FACTOR DE ESTR&#201;S">
      <data key="d8">8.0</data>
      <data key="d9">Sepsis is one of the conditions classified under Factor de Estr&#233;s, affecting metabolic needs</data>
