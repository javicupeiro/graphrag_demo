      <data key="d7">887d5fec7b10483eb9be4665b364d629</data>
    </node>
    <node id="AGUA POTABLE">
      <data key="d0">PERSON</data>
      <data key="d1">El agua potable puede contener cobre y contribuir a la ingesta diaria de este mineral, aunque en cantidades variables.</data>
      <data key="d2">d6bd9fbceb166872651dd2deade92849</data>
