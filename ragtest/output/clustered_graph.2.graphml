    <edge source="ALIMENTOS" target="DIETA HIPOS&#211;DICA MODERADA">
      <data key="d8">8.0</data>
      <data key="d9">La dieta hipos&#243;dica moderada incluye una selecci&#243;n de alimentos espec&#237;ficos para controlar el sodio</data>
