    </edge>
    <edge source="VITAMINAS" target="INFUVITE&#174;">
      <data key="d8">8.0</data>
      <data key="d9">INFUVITE&#174; contains various vitaminas essential for the growth and health of pediatric patients</data>
      <data key="d10">a6e7937ce59bfc2b38e9ed2acf3e991c</data>
      <data key="d11">02ce550754d1496594a144667a3d436a</data>
      <data key="d12">8198</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINAS" target="SOLUTION FORMULATIONS">
      <data key="d8">8.0</data>
      <data key="d9">Vitaminas are included in solution formulations to ensure nutritional adequacy for patients</data>
      <data key="d10">622b4827c8894dba02debfade4a9f817</data>
      <data key="d11">c8b258daab4f4527b153e0f88e382456</data>
      <data key="d12">8199</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINAS" target="PERSONAS MAYORES">
      <data key="d8">8.0</data>
      <data key="d9">Older adults are at high risk for vitamin deficiencies, making vitamin supplementation important for their health.</data>
