    <edge source="ENFERMEDAD CEREBROVASCULAR" target="FRUTAS Y VERDURAS">
      <data key="d8">8.0</data>
      <data key="d9">El consumo adicional de frutas y verduras se ha relacionado con una disminuci&#243;n del riesgo de ictus.</data>
