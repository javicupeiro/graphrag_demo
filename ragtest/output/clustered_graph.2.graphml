    </node>
    <node id="DESNUTRICI&#211;N AGUDA MODERADA">
      <data key="d0">EVENT</data>
      <data key="d1">Moderate acute malnutrition is a condition characterized by a significant weight loss or low weight-for-height in children, indicating a serious health risk.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15280</data>
      <data key="d7">22318d88f4e14eeabadbaf17e5f7f981</data>
    </node>
    <node id="DESNUTRICI&#211;N AGUDA GRAVE">
      <data key="d0">EVENT</data>
      <data key="d1">Severe acute malnutrition is a life-threatening condition that occurs when a child is extremely thin for their height or has nutritional edema.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15281</data>
      <data key="d7">f55f86920f384c0ca1e5d3a8a2fa0af7</data>
    </node>
    <node id="DESNUTRICI&#211;N CR&#211;NICA MODERADA">
      <data key="d0">EVENT</data>
      <data key="d1">Moderate chronic malnutrition is characterized by low height-for-age, indicating long-term nutritional deficiencies.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15282</data>
      <data key="d7">02f1dc9b8c9a45328391c502b6f3a7f9</data>
    </node>
    <node id="DESNUTRICI&#211;N CR&#211;NICA GRAVE">
      <data key="d0">EVENT</data>
      <data key="d1">Severe chronic malnutrition is a serious condition where a child is significantly shorter than the average for their age due to prolonged nutritional deficiencies.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
