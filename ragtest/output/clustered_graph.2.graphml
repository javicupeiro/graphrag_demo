    <edge source="LACTANTES" target="0-6 MESES">
      <data key="d8">15.0</data>
      <data key="d9">The entity "LACTANTES" encompasses the age range of "0-6 MESES," which is a specific subset within this category. This age group includes lactantes who have particular dietary recommendations tailored to their developmental needs.</data>
      <data key="d10">565aef05382a327b4bdefb2ab3d3b4be,74a9c62d0f932e27419151241f7db445</data>
