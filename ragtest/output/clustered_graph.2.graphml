      <data key="d11">fa1ee81f539541169acfd94f768801a8</data>
      <data key="d12">16888</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FACE" target="AOECS">
      <data key="d8">14.0</data>
      <data key="d9">FACE operates under the regulations set by the Association of European Coeliac Societies (AOECS) to certify gluten-free products in Spain. In collaboration with AOECS, FACE ensures that these products meet the necessary certification standards, thereby promoting safe consumption for individuals with gluten intolerance.</data>
      <data key="d10">d3ffabc46da9b238994a7769ffc8f6b7,dfb6e1826ded0b8ca7cf3304d1b75d1a</data>
      <data key="d11">9a586ba53fc94aa8a2515da272d90dba</data>
      <data key="d12">16889</data>
      <data key="d13">2</data>
    </edge>
