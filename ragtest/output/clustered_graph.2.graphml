    </node>
    <node id="S&#205;NDROME DE QUILOMICRONEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Syndrome of chylomicronemia is a condition referenced in the protocols on hypertriglyceridemia, indicating a specific type of hypertriglyceridemia.</data>
      <data key="d2">75a4b2d504de480eaef247aa682bfd05</data>
      <data key="d5">0</data>
      <data key="d6">6178</data>
      <data key="d7">3000058f485048aaa7e0401604bf2ea5</data>
    </node>
    <node id="URGENCIAS">
      <data key="d0">EVENT</data>
      <data key="d1">Urgent care is referenced in the context of a patient presenting with severe symptoms related to electrolyte imbalances.</data>
      <data key="d2">75a4b2d504de480eaef247aa682bfd05</data>
      <data key="d3">664</data>
      <data key="d4">2</data>
