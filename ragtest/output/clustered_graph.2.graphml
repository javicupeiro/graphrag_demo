    </edge>
    <edge source="PHOSPHORUS" target="DIETARY RESTRICTION">
      <data key="d8">9.0</data>
      <data key="d9">Dietary restrictions are implemented to manage phosphorus levels in patients with chronic kidney disease</data>
      <data key="d10">1f8cd198519be7b535a3f5be8181931c</data>
      <data key="d11">df1e588b76404bc5ba00b662061be70a</data>
      <data key="d12">10456</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHOSPHORUS" target="ADDITIVES">
      <data key="d8">1.0</data>
      <data key="d9">The use of additives in processed foods can significantly increase phosphorus intake, affecting kidney disease patients</data>
      <data key="d10">1f8cd198519be7b535a3f5be8181931c</data>
      <data key="d11">3fd88e3e12234296b7f0c6bbfdd0c0f1</data>
      <data key="d12">10457</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHOSPHORUS" target="CHRONIC KIDNEY DISEASE">
      <data key="d8">8.0</data>
      <data key="d9">Chronic kidney disease management often involves monitoring phosphorus intake to prevent complications.</data>
      <data key="d10">08bc4a83d18482b48f5bbef4fbf316f3</data>
      <data key="d11">e147595e35804774bae4bb7da335c2e8</data>
      <data key="d12">10458</data>
      <data key="d13">2</data>
    </edge>
