      <data key="d9">Euglana Englano's situation raises similar concerns about the necessity of informed consent in decisions about nutrition and hydration</data>
      <data key="d10">bf941c97b0ce9caab6cfbab0a4832c27</data>
      <data key="d11">8d5537c484014f49b5512fe6fb48dbcb</data>
      <data key="d12">20241</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AUTONOM&#205;A DEL PACIENTE" target="DIRECTIVAS ANTICIPADAS">
      <data key="d8">9.0</data>
      <data key="d9">Advance directives are a key aspect of patient autonomy, allowing individuals to express their healthcare preferences</data>
      <data key="d10">bf941c97b0ce9caab6cfbab0a4832c27</data>
      <data key="d11">8834c68f37764ecb97649908cdb705e5</data>
      <data key="d12">20242</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AUTONOM&#205;A DEL PACIENTE" target="TESTAMENTO VITAL">
      <data key="d8">9.0</data>
      <data key="d9">Living wills are a manifestation of patient autonomy, ensuring that individuals can dictate their medical treatment preferences</data>
      <data key="d10">bf941c97b0ce9caab6cfbab0a4832c27</data>
      <data key="d11">bd07860af274485995f13c631263f0be</data>
      <data key="d12">20243</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AUTONOM&#205;A DEL PACIENTE" target="LEY 41/2002">
      <data key="d8">8.0</data>
      <data key="d9">La Ley 41/2002 refuerza el derecho a la autonom&#237;a del paciente en el contexto de la atenci&#243;n m&#233;dica.</data>
      <data key="d10">4b9cc8ae09d12c1bf2e3c9b103a1050a</data>
      <data key="d11">921132e3c7e64022b523eb22e296efbc</data>
      <data key="d12">20244</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AUTONOM&#205;A DEL PACIENTE" target="PRINCIPIO DE AUTONOM&#205;A">
      <data key="d8">9.0</data>
      <data key="d9">El principio de autonom&#237;a es fundamental para el reconocimiento de la autonom&#237;a del paciente en la atenci&#243;n m&#233;dica.</data>
      <data key="d10">4b9cc8ae09d12c1bf2e3c9b103a1050a</data>
      <data key="d11">d2d2601b163c43b98712b3c6598b3762</data>
      <data key="d12">20245</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AUTONOM&#205;A DEL PACIENTE" target="PRINCIPIO DE BENEFICENCIA">
      <data key="d8">1.0</data>
      <data key="d9">El principio de beneficencia se contrapone al principio de autonom&#237;a en la toma de decisiones m&#233;dicas.</data>
      <data key="d10">4b9cc8ae09d12c1bf2e3c9b103a1050a</data>
      <data key="d11">5133121b0871419aafde26692467313b</data>
      <data key="d12">20246</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CONSENTIMIENTO INFORMADO" target="LEY 41/2002">
      <data key="d8">8.0</data>
      <data key="d9">La Ley 41/2002 regula el consentimiento informado como un derecho del paciente en la atenci&#243;n m&#233;dica.</data>
      <data key="d10">4b9cc8ae09d12c1bf2e3c9b103a1050a</data>
      <data key="d11">96384d93e54a4eb485dcb858a0969493</data>
      <data key="d12">20247</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CONSENTIMIENTO INFORMADO" target="LEY">
      <data key="d8">7.0</data>
      <data key="d9">La ley regula el proceso de consentimiento informado y los derechos de los pacientes</data>
      <data key="d10">e475fe60f9aab6773eddfe8bad25eef6</data>
      <data key="d11">72eda48fc70b4473814fada74c8e8187</data>
      <data key="d12">20248</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CONSENTIMIENTO INFORMADO" target="INTERVENCI&#211;N QUIR&#218;RGICA">
      <data key="d8">8.0</data>
      <data key="d9">La intervenci&#243;n quir&#250;rgica requiere el consentimiento informado del paciente debido a los riesgos involucrados</data>
      <data key="d10">e475fe60f9aab6773eddfe8bad25eef6</data>
      <data key="d11">6fa48b0a06bc41a7bb3352bd4b3deec5</data>
      <data key="d12">20249</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CONSENTIMIENTO INFORMADO" target="PROCEDIMIENTOS DIAGN&#211;STICOS">
      <data key="d8">6.0</data>
      <data key="d9">Los procedimientos diagn&#243;sticos pueden requerir el consentimiento informado dependiendo de su naturaleza</data>
      <data key="d10">e475fe60f9aab6773eddfe8bad25eef6</data>
      <data key="d11">22650a46e8844609b7f12655edbce212</data>
      <data key="d12">20250</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CONSENTIMIENTO INFORMADO" target="PACIENTE MENOR DE EDAD">
      <data key="d8">1.0</data>
      <data key="d9">El paciente menor de edad necesita consentimiento por representaci&#243;n para intervenciones m&#233;dicas</data>
      <data key="d10">e475fe60f9aab6773eddfe8bad25eef6</data>
      <data key="d11">5f48db60927b4db5a50f23a55a9283f7</data>
      <data key="d12">20251</data>
      <data key="d13">2</data>
    </edge>
