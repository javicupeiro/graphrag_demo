    </edge>
    <edge source="DAVID G SMITHARD" target="SSA">
      <data key="d8">8.0</data>
      <data key="d9">David G Smithard co-designed the SSA, a tool for detecting dysphagia</data>
      <data key="d10">4befdcd21a98898cec30bbac7b402d4b</data>
      <data key="d11">071b3fd008324f81a0cff9f5a4ed880c</data>
      <data key="d12">2268</data>
