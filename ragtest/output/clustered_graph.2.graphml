    </node>
    <node id="FUNCTIONAL ROLE">
      <data key="d0">EVENT</data>
      <data key="d1">Functional role refers to the biological activity of a gene or protein, such as the role of lactase in lactose digestion.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68</data>
      <data key="d5">0</data>
