    </node>
    <node id="DIETARY PHOSPHORUS">
      <data key="d0">EVENT</data>
      <data key="d1">Dietary phosphorus is a key focus in managing chronic kidney disease and its complications.</data>
      <data key="d2">08bc4a83d18482b48f5bbef4fbf316f3</data>
