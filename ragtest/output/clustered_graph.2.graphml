      <data key="d8">7.0</data>
      <data key="d9">The Japanese Society of Hypertension focuses on research and guidelines related to the management of hypertension</data>
      <data key="d10">e40d5e26456fbd223dc887d7d6d0eeb7</data>
      <data key="d11">0e6ed418691c4dc7874b9952d982e07a</data>
      <data key="d12">10972</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERTENSION" target="POTASSIUM">
