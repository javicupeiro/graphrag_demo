    <node id="DIURETICS">
      <data key="d0">EVENT</data>
      <data key="d1">Diuretics are medications that promote the elimination of water and electrolytes from the body and can lead to hypomagnesemia.</data>
      <data key="d2">b9342cecd69cdc0e9936df041657f5f5</data>
      <data key="d3">711</data>
      <data key="d4">2</data>
