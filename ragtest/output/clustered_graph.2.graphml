      <data key="d6">4309</data>
      <data key="d7">a046d029124345eb8dc5377c6ca9388b</data>
    </node>
    <node id="VILDAGLIPTINA">
      <data key="d0">PERSON</data>
      <data key="d1">Vildagliptina is a diabetes medication that requires dose adjustment based on renal function.</data>
      <data key="d2">630ac8fefe27e4b893831674a67dcc82</data>
      <data key="d3">987</data>
