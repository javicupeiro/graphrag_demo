    <node id="THYROID STORM">
      <data key="d0">EVENT</data>
      <data key="d1">Thyroid storm is a severe and life-threatening condition resulting from uncontrolled hyperthyroidism, requiring immediate medical attention and management.</data>
      <data key="d2">92e235fe76b5046c18c1cb2c782e1ac2</data>
      <data key="d3">174</data>
