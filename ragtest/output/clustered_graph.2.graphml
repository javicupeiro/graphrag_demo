    <node id="HOMOGENEIZACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Homogenization is a process applied to liquids to reduce particle size and create a uniform product, crucial in the formulation of clinical nutrition products.</data>
      <data key="d2">d9e4179f945ec9152199511522d70159</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
