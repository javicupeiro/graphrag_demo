    <edge source="NUTRICI&#211;N ENTERAL" target="FRA">
      <data key="d8">7.0</data>
      <data key="d9">Enteral nutrition is often utilized for patients with acute renal failure who cannot meet their nutritional needs orally.</data>
      <data key="d10">cd16cc82ca1357af8c9c1ab73ea55c5a</data>
