      <data key="d7">23c2599e7e0b4703ae285a984148d84d</data>
    </node>
    <node id="F&#193;RMACOS FIBRINOL&#205;TICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Medications used to attempt to dissolve clots in cases where saline solution fails to clear catheter obstructions.</data>
      <data key="d2">c031cb3bc7513b4a3f8e4f264c00a675</data>
      <data key="d3">768</data>
      <data key="d4">2</data>
