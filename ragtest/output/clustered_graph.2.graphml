      <data key="d6">16013</data>
      <data key="d7">bd1d8723ec094d6dbbde6b948532a2c3</data>
    </node>
    <node id="EUROPEAN FOUNDATION FOR QUALITY MANAGEMENT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The European Foundation for Quality Management (EFQM) is an organization that provides a model for excellence in management, particularly in healthcare systems.</data>
      <data key="d2">03b047c49cda5e7bb642efcc9109ccc6</data>
      <data key="d5">2</data>
      <data key="d6">16014</data>
      <data key="d7">4e831eb98666416f939d004cbd2e0b5d</data>
    </node>
    <node id="JOINT COMMISSION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Joint Commission is an external committee that evaluates healthcare organizations to ensure they meet certain standards.</data>
      <data key="d2">03b047c49cda5e7bb642efcc9109ccc6</data>
      <data key="d5">1</data>
      <data key="d6">16015</data>
      <data key="d7">35dd95ef4e2c472b9306be9a73012644</data>
    </node>
    <node id="QUALITY MANAGEMENT">
      <data key="d0">EVENT</data>
      <data key="d1">Quality management refers to the processes and practices that organizations implement to ensure they meet quality standards and satisfy stakeholders.</data>
      <data key="d2">03b047c49cda5e7bb642efcc9109ccc6</data>
      <data key="d5">2</data>
      <data key="d6">16016</data>
      <data key="d7">e6d659e4ed0741bfbe39933474cd2ab0</data>
    </node>
    <node id="BENCHMARKING">
      <data key="d0">EVENT</data>
      <data key="d1">Benchmarking is a systematic technique used by organizations to compare their processes with those of similar organizations to identify best practices.</data>
      <data key="d2">03b047c49cda5e7bb642efcc9109ccc6</data>
      <data key="d5">1</data>
      <data key="d6">16017</data>
      <data key="d7">91787ebaf73c4eab83acf7d65a4cae05</data>
    </node>
