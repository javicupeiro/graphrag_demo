    </edge>
    <edge source="NIVELES DE ACTIVIDAD F&#205;SICA" target="PAL">
      <data key="d8">1.0</data>
      <data key="d9">Physical activity levels are used to determine the appropriate PAL for individuals to maintain or achieve health goals</data>
      <data key="d10">c2a8dd9d28d1992a73de2834131b69c9</data>
      <data key="d11">2f4882420c894d058379dfaded5af89a</data>
      <data key="d12">16754</data>
      <data key="d13">2</data>
    </edge>
