    <node id="ACIDOSIS HIPERCLOR&#201;MICA">
      <data key="d0">EVENT</data>
      <data key="d1">Acidosis hiperclor&#233;mica is a medical condition that is mentioned as a precaution for the use of fentermina and topiramato.</data>
      <data key="d2">af631316aa8584710d755d8c59e851b6</data>
