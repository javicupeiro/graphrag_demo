      <data key="d11">0a91cede6297406db3b7a84192ccda02</data>
      <data key="d12">10212</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD CARDIOVASCULAR" target="DISLIPIDEMIA">
      <data key="d8">1.0</data>
      <data key="d9">Dyslipidemia is a significant risk factor for developing cardiovascular disease</data>
