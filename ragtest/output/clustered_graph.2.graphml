      <data key="d5">1</data>
      <data key="d6">14223</data>
      <data key="d7">80dcefa88d1b464a9ae73b3f2b9a81d1</data>
    </node>
    <node id="MEPROBAMATO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Meprobamato is a basic medication that can have increased absorption when the pH of the stomach is raised by food.</data>
      <data key="d2">75b625e1dd088fa7beed19a4142f726f</data>
      <data key="d3">891</data>
      <data key="d4">2</data>
