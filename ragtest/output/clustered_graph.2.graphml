    <node id="ADIPOSIDAD VISCERAL">
      <data key="d0">EVENT</data>
      <data key="d1">La adiposidad visceral es la acumulaci&#243;n de grasa en el abdomen, que se asocia con un mayor riesgo de enfermedades cardiovasculares.</data>
      <data key="d2">884a8370915a18a005fb2fa913e4b95c</data>
      <data key="d5">0</data>
      <data key="d6">5901</data>
