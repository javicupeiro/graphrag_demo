    </node>
    <node id="COLANGIO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">El colangio es un t&#233;rmino que se refiere a los conductos biliares, que pueden verse afectados por el flujo biliar y la salud hep&#225;tica.</data>
      <data key="d2">0cdbb308e3359fd3ddbb1d828d12dc04</data>
