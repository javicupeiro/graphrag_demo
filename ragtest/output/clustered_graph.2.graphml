      <data key="d11">565880cebde14572936f6a99521c5019</data>
      <data key="d12">11454</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SNAQ" target="DUTCH MALNUTRITION STEERING GROUP">
      <data key="d8">8.0</data>
