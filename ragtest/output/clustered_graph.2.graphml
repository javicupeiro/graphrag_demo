      <data key="d0">ORGANIZATION</data>
      <data key="d1">The European Society of Cardiology is an organization that provides guidelines for cardiovascular disease prevention and treatment.</data>
      <data key="d2">ce43a9a4cdf2497b2f984547a2787fff</data>
