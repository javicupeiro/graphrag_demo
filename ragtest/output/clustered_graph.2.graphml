      <data key="d13">2</data>
    </edge>
    <edge source="CIRROSIS" target="BIOELECTRICAL IMPEDANCE ANALYSIS">
      <data key="d8">7.0</data>
      <data key="d9">Bioelectrical impedance analysis is used to estimate body composition in patients with cirrhosis, aiding in nutritional assessment</data>
      <data key="d10">f7b74dc42fea9d33e4675a41e15975ab</data>
      <data key="d11">511e4ec560644e428f7fd3496a61f188</data>
      <data key="d12">9334</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIRROSIS" target="DEXA">
      <data key="d8">7.0</data>
      <data key="d9">DEXA is utilized to measure body composition in patients with cirrhosis, providing insights into their nutritional status</data>
      <data key="d10">f7b74dc42fea9d33e4675a41e15975ab</data>
      <data key="d11">c0b9f1aa69dc4fce96cf5919c5c2de73</data>
      <data key="d12">9335</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIRROSIS" target="CREATININE EXCRETION">
      <data key="d8">1.0</data>
      <data key="d9">Creatinine excretion is assessed in patients with cirrhosis to evaluate muscle mass, which is important for nutritional evaluation</data>
      <data key="d10">f7b74dc42fea9d33e4675a41e15975ab</data>
      <data key="d11">978b592b6a84409593c29836d2a4fb84</data>
      <data key="d12">9336</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIRROSIS" target="ECHA">
      <data key="d8">8.0</data>
      <data key="d9">ECHA is a condition that arises as a complication of cirrhosis, affecting patients' nutritional status</data>
      <data key="d10">ea1d430dfc773b669eec18759441b31a</data>
      <data key="d11">e0b45f4fa2e649eb8e6d8c71fd7a3a0e</data>
      <data key="d12">9337</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIRROSIS" target="SELENIUM">
      <data key="d8">6.0</data>
      <data key="d9">Selenium deficiency can occur in patients with cirrhosis, affecting their overall health</data>
      <data key="d10">ea1d430dfc773b669eec18759441b31a</data>
      <data key="d11">19a480298432410e9045a7eb70c82d96</data>
      <data key="d12">9338</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIRROSIS" target="MAGNESIUM">
      <data key="d8">6.0</data>
      <data key="d9">Magnesium deficiency is common in patients with liver disease, particularly those with alcohol-related issues</data>
      <data key="d10">ea1d430dfc773b669eec18759441b31a</data>
      <data key="d11">8a7f90d3d95247b9be7acab25dcbfbbe</data>
      <data key="d12">9339</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIRROSIS" target="FOLIC ACID">
      <data key="d8">6.0</data>
      <data key="d9">Folic acid deficiency is often seen in patients with alcohol-related liver disease</data>
      <data key="d10">ea1d430dfc773b669eec18759441b31a</data>
      <data key="d11">2e2d3d69107b4248aca282fcf566d317</data>
      <data key="d12">9340</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIRROSIS" target="SANGRADO">
      <data key="d8">7.0</data>
      <data key="d9">Bleeding is a common complication in patients with cirrhosis, which can worsen their condition</data>
      <data key="d10">ea1d430dfc773b669eec18759441b31a</data>
      <data key="d11">ecd99dc21b86482ca9bd956f0871de7d</data>
