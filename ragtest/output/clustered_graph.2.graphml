      <data key="d8">7.0</data>
      <data key="d9">Real Decreto 1090/2015 incorporates principles from Ley Org&#225;nica 15/1999 to protect personal data in clinical trials</data>
      <data key="d10">0fd4d7a9544dd7c2999b9ce1708919bc</data>
      <data key="d11">0e43a09b05fe422a9d6a2c29f90bf96d</data>
