      <data key="d6">4628</data>
      <data key="d7">394372ce13af49cca34a8de3ded610c3</data>
    </node>
    <node id="CAMPANELLA">
      <data key="d0">PERSON</data>
      <data key="d1">Campanella is a researcher who conducted a study on the malignancy risk of thyroid nodules, providing odds ratios for various characteristics associated with malignancy.</data>
      <data key="d2">673c86b4e90c81d1c4bc78cdd08e9be0</data>
