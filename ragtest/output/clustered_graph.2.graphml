      <data key="d5">1</data>
      <data key="d6">13687</data>
      <data key="d7">b06a418960df47aa9e7997afdfbad5c0</data>
    </node>
    <node id="COCHRANE LIBRARY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Cochrane Library is a collection of databases that provide systematic reviews of healthcare interventions, including studies on nutritional supplements and their effects on patients.</data>
