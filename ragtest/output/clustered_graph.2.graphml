    </node>
    <node id="HIPOANTREMIA">
      <data key="d0" />
      <data key="d1">HIPOANTREMIA refers to a common water metabolism disorder known as hiponatremia, which is particularly prevalent among hospitalized patients, especially those who are receiving artificial nutrition.</data>
      <data key="d2">306519cca8810e0ff1c973128a75200a,addd6db95fafa3464a6f085f8d0041ce</data>
      <data key="d3">1421</data>
