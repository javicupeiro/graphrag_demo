      <data key="d6">634</data>
      <data key="d7">395e5338c25e4bd2a7c4cd7ade62e4e9</data>
    </node>
    <node id="EDEMA/ASCITIS">
      <data key="d0">EVENT</data>
      <data key="d1">Edema/ascitis indicates fluid retention conditions that can affect nutritional assessment.</data>
      <data key="d2">67f60ae11335cf41da4f96400b69e67b</data>
