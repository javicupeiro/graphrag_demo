      <data key="d10">90f122c65fbb08f52e052d0e22714849</data>
      <data key="d11">46bf327c270a437fb82dd81ca298d7cc</data>
      <data key="d12">5907</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OBESIDAD" target="PROTE&#205;NAS">
