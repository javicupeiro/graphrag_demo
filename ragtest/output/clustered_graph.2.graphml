    </node>
    <node id="MUERTE S&#218;BITA">
      <data key="d0">EVENT</data>
      <data key="d1">Muerte s&#250;bita refers to sudden death, often associated with cardiac events.</data>
      <data key="d2">41d7db510fc74d3763959481cc15ea20</data>
      <data key="d3">1636</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">10826</data>
      <data key="d7">038d15ddd81b49cfa4f129bbc85f2776</data>
    </node>
    <node id="REINFARTO MORTAL">
      <data key="d0">EVENT</data>
      <data key="d1">Reinfarto mortal refers to a fatal heart attack, which can occur after a previous heart attack.</data>
      <data key="d2">41d7db510fc74d3763959481cc15ea20</data>
      <data key="d3">1636</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
