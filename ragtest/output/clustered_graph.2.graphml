    <node id="LIPPINCOTT-RAVEN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Lippincott-Raven is a publishing company that specializes in medical and clinical texts, with publications based in Philadelphia.</data>
      <data key="d2">47ba8105b81c59f81a9038446898d200</data>
