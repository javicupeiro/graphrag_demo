    <node id="CISTATIONINA">
      <data key="d0">EVENT</data>
      <data key="d1">Cistationina is a compound involved in the metabolism of homociste&#237;na and is affected by dietary intake of amino acids.</data>
      <data key="d2">b1d588e0c9c4cef32da41373afbd1901</data>
