      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">1891</data>
      <data key="d7">979033159d3d460f8efb4c6a22dfe317</data>
    </node>
    <node id="BOLSA DE DRENAJE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The drainage bag connected to the feeding tube to collect gastric residuals during enteral nutrition.</data>
      <data key="d2">3c6db755168f2fea94b2535a81ce6f58</data>
      <data key="d3">1182</data>
      <data key="d4">2</data>
