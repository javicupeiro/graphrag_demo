    <node id="CRISIS COMICIALES">
      <data key="d0">EVENT</data>
      <data key="d1">Crisis comiciales refer to seizure episodes that can occur in patients with adrenoleukodystrophy and may also serve as a contraindication for certain medications, such as bupropion.</data>
      <data key="d2">0745ce31d3922cbba1497dbe1d2845de,7eea8ed505de441028811dbb848d0fa0</data>
