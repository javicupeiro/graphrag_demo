      <data key="d11">8d3071c873cb43349ce67925f2a1a399</data>
      <data key="d12">16775</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C. M&#201;TODO 3" target="REPOSO">
      <data key="d8">6.0</data>
      <data key="d9">Reposo is one of the activities listed in C. M&#201;TODO 3 for estimating energy expenditure</data>
      <data key="d10">a2675f78609440ca1162c24997360929</data>
      <data key="d11">47c8c2f7cf1449f8a55ee6812300975b</data>
