      <data key="d9">Shaffer J has contributed to research on home artificial nutrition practices</data>
      <data key="d10">7e3e2024996e402fc0ab62933ab9417b</data>
      <data key="d11">e0f0d436961f41c88b769a873a4d8362</data>
