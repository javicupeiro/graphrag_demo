    </node>
    <node id="DIETA HOLLYWOOD">
      <data key="d0">EVENT</data>
      <data key="d1">The Hollywood Diet is a popular diet that promises quick weight loss, often considered a miracle diet.</data>
      <data key="d2">64347a9be918a67f786cbdf9f9db9c8a</data>
      <data key="d3">1374</data>
