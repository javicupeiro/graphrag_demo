    <node id="&#201;XTASIS">
      <data key="d0">EVENT</data>
      <data key="d1">Ecstasy is a psychoactive drug that can lead to acute hyponatremia due to its effects on water retention and vasopressin release.</data>
      <data key="d2">773a1daa539dd85e562a59e09f434af1</data>
