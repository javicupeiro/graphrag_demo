      <data key="d6">13032</data>
      <data key="d7">d8d03e5e455148b4bf5eeeec76ca2834</data>
    </node>
    <node id="RESECCIONES COL&#211;NICAS AMPLIAS">
      <data key="d0">EVENT</data>
      <data key="d1">Extensive colon resections can lead to malabsorption issues, requiring careful nutritional support and supplementation.</data>
      <data key="d2">a4886f74d848ccd61cefcaab3103f233</data>
      <data key="d3">584</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13033</data>
      <data key="d7">2d2a9691773748b3b2b20565f648fe80</data>
    </node>
    <node id="ENZYMES">
      <data key="d0">EVENT</data>
      <data key="d1">Pancreatic enzymes are supplements that help cystic fibrosis patients with IPE to absorb fats effectively from their diet.</data>
      <data key="d2">c2211f0deb7328a77cb632140690da03</data>
