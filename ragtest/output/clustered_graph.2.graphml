    <node id="DEFICIENCIA DE ZINC">
      <data key="d0">EVENT</data>
      <data key="d1">La deficiencia de zinc puede causar problemas de cicatrizaci&#243;n, alteraciones neuropsicol&#243;gicas y un sistema inmune debilitado.</data>
      <data key="d2">89fc75473a09f83406bce1f9e3a15a3d</data>
