    </node>
    <node id="ESTEROIDES ANDROG&#201;NICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Esteroides androg&#233;nicos (anabolic steroids) can influence SHBG levels and testosterone availability in the body.</data>
      <data key="d2">4beab004731d7baff10fd2796a523b55</data>
      <data key="d3">1356</data>
      <data key="d4">2</data>
