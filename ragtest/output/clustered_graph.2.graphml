    </node>
    <node id="PERFORACI&#211;N CARD&#205;ACA">
      <data key="d0">EVENT</data>
      <data key="d1">Cardiac perforation is a serious complication that can occur during catheter insertion, leading to cardiac tamponade.</data>
      <data key="d2">fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d5">0</data>
      <data key="d6">15596</data>
