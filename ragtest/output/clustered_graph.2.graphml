    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="NE">
      <data key="d8">7.0</data>
      <data key="d9">Nutritional support can include NE to provide necessary nutrients to diabetic patients</data>
      <data key="d10">8413d4414414c5cb139198857cce327a</data>
