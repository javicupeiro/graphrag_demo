    </node>
    <node id="MANIFESTACIONES CL&#205;NICAS DE LA HIPONATREMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Clinical manifestations of hyponatremia, which are important for diagnosis in patients with artificial nutrition</data>
      <data key="d2">8ff1cad741bacfef19d53bb8941b5ca9</data>
      <data key="d3">1427</data>
      <data key="d4">2</data>
