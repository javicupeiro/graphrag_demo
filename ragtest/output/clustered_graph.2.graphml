    </edge>
    <edge source="COMPLEJO DE CARNEY" target="PRKAR1A">
      <data key="d8">8.0</data>
      <data key="d9">El complejo de Carney est&#225; asociado a mutaciones en el gen PRKAR1A, que es crucial para su desarrollo</data>
