      <data key="d7">0510f76899524e4ebe11f236ac2d6028</data>
    </node>
    <node id="AGENCIA ESPA&#209;OLA DE SEGURIDAD ALIMENTARIA Y NUTRICI&#211;N">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The AGENCIA ESPA&#209;OLA DE SEGURIDAD ALIMENTARIA Y NUTRICI&#211;N (AESAN) is the Spanish agency tasked with overseeing food safety and nutrition policies in Spain. It is responsible for providing guidelines on various dietary practices, including miracle diets, and their potential implications for health. AESAN plays a crucial role in ensuring that food safety standards are met and that the nutritional needs of the population are addressed effectively.</data>
      <data key="d2">64347a9be918a67f786cbdf9f9db9c8a,89ca65c4bdc30027c9c9ed1e1b442939</data>
      <data key="d3">1374</data>
