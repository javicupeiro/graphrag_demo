    </node>
    <node id="PROCTOCOLITIS">
      <data key="d0">EVENT</data>
      <data key="d1">Proctocolitis is an inflammatory condition affecting the colon and rectum, which can be associated with allergies in infants.</data>
      <data key="d2">08d66dc8414668a3ec627a1e164cfa6c</data>
