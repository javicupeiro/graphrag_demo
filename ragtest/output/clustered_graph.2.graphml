      <data key="d0">EVENT</data>
      <data key="d1">Inserci&#243;n en est&#243;mago de dispositivo de alimentaci&#243;n is a procedure for placing a feeding device directly into the stomach for nutritional delivery.</data>
      <data key="d2">2a387a0f62fd64b31ecf55b1538932c2</data>
