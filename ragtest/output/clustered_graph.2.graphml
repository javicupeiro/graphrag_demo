      <data key="d10">fec130428af4ee62996a9b72494212dc</data>
      <data key="d11">ea8d81d3b4204744b93dd1e2583be27e</data>
      <data key="d12">13292</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="IGF-2">
      <data key="d8">8.0</data>
