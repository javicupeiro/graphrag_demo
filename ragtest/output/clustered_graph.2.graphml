      <data key="d7">66a3e64dfc544e23afd8e314fb85120b</data>
    </node>
    <node id="WJG">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">WJG is a medical journal that publishes research and reviews in the field of gastroenterology.</data>
      <data key="d2">47ba8105b81c59f81a9038446898d200</data>
      <data key="d3">507</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">14192</data>
      <data key="d7">65d6b570ff0d4c26a16deeb477e9bcf5</data>
    </node>
    <node id="AJR">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">AJR is a journal that publishes articles related to radiology and medical imaging.</data>
      <data key="d2">47ba8105b81c59f81a9038446898d200</data>
      <data key="d3">1301</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
