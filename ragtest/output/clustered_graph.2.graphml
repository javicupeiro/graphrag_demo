    <node id="EURRECA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">EURRECA (European Micronutrient Recommendations Aligned) is a group working on developing micronutrient recommendations based on various factors such as age, gender, genotype, and physical activity.</data>
      <data key="d2">aa44a32ccc29ae80ddbbc4a77b33a297</data>
