    <node id="BAUTISTA-CASTA&#209;O I">
      <data key="d0">PERSON</data>
      <data key="d1">Bautista-Casta&#241;o I is a researcher who co-authored studies on obesity surgery and its effects on patients.</data>
      <data key="d2">ecd0e2cc6ed4a480591f4ac32cd7f691</data>
