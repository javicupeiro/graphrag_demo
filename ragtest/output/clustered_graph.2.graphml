    <node id="PADRES">
      <data key="d0" />
      <data key="d1">The entity "PADRES" refers to parents who hold the responsibility of ensuring safe nutrition for their children with food allergies.</data>
      <data key="d2">0f0303399f29734dede9db544e1dda9e,410fab643c125e0f8944ebae5dba5ec0</data>
