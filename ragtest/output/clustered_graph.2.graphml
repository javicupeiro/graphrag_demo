    <node id="PARABACTEROIDES DISTASONIS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Parabacteroides distasonis is a species of bacteria that has been positively associated with obesity.</data>
      <data key="d2">959173b0e9d9c5ea2edabff579240462</data>
      <data key="d3">996</data>
