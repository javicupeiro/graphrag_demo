    </node>
    <node id="PRISMA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Prisma is a prescription assistance program at HUP La Fe that includes a database for administering medications via enteral feeding.</data>
      <data key="d2">52a0434694f8face489cdb4c8d206a9e</data>
      <data key="d3">905</data>
