    <node id="AGS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">AGS refers to saturated fatty acids, which are discussed in the context of their impact on cholesterol levels and cardiovascular disease risk.</data>
      <data key="d2">3d053ac744015b40d8790ff91b5d02f2</data>
