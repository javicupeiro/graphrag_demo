      <data key="d7">004ddbf14f094014a31b1958b08bf94b</data>
    </node>
    <node id="HEMATOPOIETIC STEM CELL TRANSPLANTATION">
      <data key="d0">EVENT</data>
      <data key="d1">Hematopoietic stem cell transplantation is a medical procedure used to treat certain cancers and blood disorders by replacing damaged bone marrow with healthy stem cells.</data>
      <data key="d2">ddd686507e25374444e2e7525a5aacf4</data>
      <data key="d3">1203</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">13913</data>
      <data key="d7">a5537b6aeaaf4e1ebe3a7cfe76b2625c</data>
    </node>
    <node id="GLUTAMINE SUPPLEMENTATION">
      <data key="d0">EVENT</data>
      <data key="d1">Glutamine supplementation is a nutritional intervention that involves the use of glutamine, an amino acid, to enhance health outcomes in various populations. It is particularly aimed at preventing morbidity and mortality in preterm infants, highlighting its importance in neonatal care. Additionally, glutamine supplementation is utilized to improve health outcomes in critically ill patients and those undergoing specific medical treatments, demonstrating its broader application in clinical settings.</data>
      <data key="d2">9ef354c0ee5ac877ce8fba79fcc7e2b3,ddd686507e25374444e2e7525a5aacf4</data>
      <data key="d3">252</data>
