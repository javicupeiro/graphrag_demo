      <data key="d6">13625</data>
      <data key="d7">a1184c8df9364845a23bb3e0b369c230</data>
    </node>
    <node id="MARTIN L">
      <data key="d0">PERSON</data>
      <data key="d1">Martin L is a researcher and author who has made significant contributions to the field of medical research. He studied patients' perspectives on living with a PEG (Percutaneous Endoscopic Gastrostomy), providing valuable insights into their experiences and challenges. Additionally, Martin L contributed to a study on cancer cachexia, exploring its implications in obesity, further highlighting his commitment to understanding complex health issues.</data>
      <data key="d2">4b0d0238a19e23ffee592c9d0817e226,fb7b0d121f195e2a472f3d47e28ccff9</data>
