    </edge>
    <edge source="DIARREA" target="INTOLERANCIA A LA LACTOSA">
      <data key="d8">1.0</data>
      <data key="d9">Lactose intolerance can occur as a result of diarrhea, affecting dietary management</data>
      <data key="d10">e318ae466c5fed49e6aeb9c9a23d2d38</data>
      <data key="d11">fca6624ed14f4772a7fb0b7bc3efddf2</data>
