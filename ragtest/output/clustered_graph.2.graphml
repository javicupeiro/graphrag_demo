      <data key="d11">489d0833463648229467f769c5430273</data>
      <data key="d12">11638</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ASOCIACI&#211;N INTERNACIONAL PARA EL ESTUDIO DE LOS &#193;CIDOS GRASOS Y L&#205;PIDOS" target="FUNDACI&#211;N BRIT&#193;NICA PARA LA NUTRICI&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">Both organizations advise on the intake of essential fatty acids</data>
      <data key="d10">60577bdc0f4979d10ba7385bf483c344</data>
      <data key="d11">fe94ec151a71406d93160f24c1aa9206</data>
      <data key="d12">11639</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AGENCIA FRANCESA PARA LA SEGURIDAD SANITARIA DE LOS ALIMENTOS" target="FUNDACI&#211;N BRIT&#193;NICA PARA LA NUTRICI&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">Both organizations establish guidelines for dietary intake</data>
      <data key="d10">60577bdc0f4979d10ba7385bf483c344</data>
      <data key="d11">c75750a7daae4dcc9e465365e98fd30e</data>
      <data key="d12">11640</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FUNDACI&#211;N BRIT&#193;NICA PARA LA NUTRICI&#211;N" target="RECOMENDACIONES DIETARIAS">
      <data key="d8">1.0</data>
      <data key="d9">BNF provides dietary recommendations that include essential nutrients like proteins and fatty acids</data>
      <data key="d10">60577bdc0f4979d10ba7385bf483c344</data>
      <data key="d11">aca981eaf19e45d28764a557b1a21be6</data>
      <data key="d12">11641</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRASAS SATURADAS" target="&#193;CIDOS GRASOS TRANS">
      <data key="d8">1.0</data>
      <data key="d9">Both saturated fats and trans fatty acids are linked to increased cardiovascular risk and are subjects of dietary recommendations.</data>
      <data key="d10">59a6475dbe0ccafda60f2647dea78371</data>
      <data key="d11">b82f30b3dbdf41efaf8320834e90ada5</data>
      <data key="d12">11642</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRASAS SATURADAS" target="ECV">
      <data key="d8">8.0</data>
      <data key="d9">Saturated fats are associated with an increased risk of cardiovascular disease, making their consumption a health concern.</data>
      <data key="d10">59a6475dbe0ccafda60f2647dea78371</data>
      <data key="d11">7abbab0a2b2b49eb91cd92d2fce3b636</data>
      <data key="d12">11643</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRASAS SATURADAS" target="BIOMARCADORES">
      <data key="d8">6.0</data>
      <data key="d9">Biomarkers are used to study the intake of saturated fats and their correlation with cardiovascular disease risk.</data>
      <data key="d10">59a6475dbe0ccafda60f2647dea78371</data>
      <data key="d11">92168d406e9c495993532003f94e8486</data>
      <data key="d12">11644</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRASAS SATURADAS" target="GRASAS INSATURADAS">
      <data key="d8">1.0</data>
      <data key="d9">Unsaturated fats are recommended as a substitute for saturated fats to lower cardiovascular risk.</data>
      <data key="d10">59a6475dbe0ccafda60f2647dea78371</data>
      <data key="d11">1ba87355c86c4e9abf91fed7983ee6f8</data>
      <data key="d12">11645</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD CORONARIA" target="FRUTAS Y VERDURAS">
      <data key="d8">8.0</data>
      <data key="d9">El mayor consumo de frutas y verduras se ha asociado con una disminuci&#243;n de la enfermedad coronaria en estudios de cohortes retrospectivos.</data>
      <data key="d10">ca3fd82e042bcc480e80a1ae56b34507</data>
      <data key="d11">88695ef681c445cea89335a6bc7b7513</data>
      <data key="d12">11646</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD CORONARIA" target="PESCADO">
      <data key="d8">8.0</data>
      <data key="d9">Consuming fish rich in omega-3 fatty acids may reduce coronary disease risk</data>
      <data key="d10">3dd309c324107af87b7988bd0284892e</data>
      <data key="d11">1cd7523ce6784dcbbfedb578541b6940</data>
      <data key="d12">11647</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD CORONARIA" target="S&#205;NDROME CORONARIO AGUDO">
      <data key="d8">1.0</data>
      <data key="d9">Increased fish consumption may reduce the risk of acute coronary syndrome</data>
      <data key="d10">3dd309c324107af87b7988bd0284892e</data>
      <data key="d11">52efe6aaafea4fe4ba921a8f0005cf9a</data>
      <data key="d12">11648</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE PR&#211;STATA" target="C&#193;NCER VESICAL">
      <data key="d8">9.0</data>
      <data key="d9">C&#193;NCER DE PR&#211;STATA and C&#193;NCER VESICAL are both types of cancer that may be influenced by dietary factors. Research indicates that the risks associated with these cancers can be affected by the consumption of fruits and vegetables, as well as processed meats. This suggests that dietary choices play a significant role in the development of both bladder cancer and prostate cancer.</data>
      <data key="d10">4ff95b497607c33ba3da4182ac19d198,a6ba6423064bccccefee095de7435164</data>
      <data key="d11">286d3eee98494b0bad5a61938f610986</data>
      <data key="d12">11649</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE PR&#211;STATA" target="LINFOMA NO HODGKIN">
      <data key="d8">5.0</data>
      <data key="d9">Both conditions have been linked to the consumption of red and processed meats according to studies</data>
      <data key="d10">a6ba6423064bccccefee095de7435164</data>
      <data key="d11">f0d172b976e8441b9818081711cdfa86</data>
      <data key="d12">11650</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE PR&#211;STATA" target="PESCADO">
      <data key="d8">5.0</data>
      <data key="d9">High fish consumption has not been shown to decrease the incidence of prostate cancer, but may affect mortality</data>
      <data key="d10">11c3cb37b1a2c111ceb227aefa8d9e1a</data>
      <data key="d11">fa02c317f4f148bb836912c3f530d79a</data>
      <data key="d12">11651</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE H&#205;GADO" target="HEPATECTOM&#205;AS">
      <data key="d8">7.0</data>
      <data key="d9">El c&#225;ncer de h&#237;gado es una de las condiciones que puede requerir hepatectom&#237;as</data>
      <data key="d10">7184072817ac284bebfea449e3eaac8b</data>
      <data key="d11">5ebbb4b75b734d94bcb4b7e0b502035e</data>
      <data key="d12">11652</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE P&#193;NCREAS" target="DIABETES MELLITUS TIPO 1">
      <data key="d8">6.0</data>
      <data key="d9">C&#225;ncer de p&#225;ncreas can complicate the management of Diabetes Mellitus Tipo 1 due to its impact on health</data>
      <data key="d10">a960ccbf15a28151d1461c4203408408</data>
      <data key="d11">3399cc1966274be0ad68b2aad2c8b640</data>
      <data key="d12">11653</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE P&#193;NCREAS" target="ADENOCARCINOMA PANCREATICO DUCTAL">
      <data key="d8">9.0</data>
      <data key="d9">C&#225;ncer de p&#225;ncreas is often diagnosed as adenocarcinoma pancre&#225;tico ductal, which is a specific type of pancreatic cancer</data>
      <data key="d10">a960ccbf15a28151d1461c4203408408</data>
      <data key="d11">06f42b76406f4b6ea828585320013e98</data>
      <data key="d12">11654</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE P&#193;NCREAS" target="S&#205;NDROME PARANEOPL&#193;SICO">
      <data key="d8">6.0</data>
      <data key="d9">C&#225;ncer de p&#225;ncreas can lead to the development of s&#237;ndrome paraneopl&#225;sico in affected patients</data>
      <data key="d10">a960ccbf15a28151d1461c4203408408</data>
      <data key="d11">cfc2a30d8e49453282cc68abfd86aac9</data>
      <data key="d12">11655</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE P&#193;NCREAS" target="CA 19.9">
      <data key="d8">1.0</data>
      <data key="d9">CA 19.9 is a tumor marker that is often elevated in patients with c&#225;ncer de p&#225;ncreas</data>
      <data key="d10">a960ccbf15a28151d1461c4203408408</data>
      <data key="d11">0559d79d1d5842778ac5b1efdf52bf35</data>
      <data key="d12">11656</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE P&#193;NCREAS" target="C&#193;NCER COLORRECTAL">
      <data key="d8">5.0</data>
      <data key="d9">Both cancers have been linked to the consumption of processed meats</data>
      <data key="d10">a6ba6423064bccccefee095de7435164</data>
      <data key="d11">2a494149a142461c9e87c7530b84804f</data>
      <data key="d12">11657</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE P&#193;NCREAS" target="C&#193;NCER DE TIROIDES">
      <data key="d8">1.0</data>
      <data key="d9">No se ha encontrado relaci&#243;n entre el consumo de pescado y el riesgo de c&#225;ncer de tiroides o de p&#225;ncreas, sugiriendo que la ingesta de pescado no afecta a estos tipos de c&#225;ncer</data>
      <data key="d10">5075c65bfc020ec93f9bf14d3fe764c3</data>
      <data key="d11">d98a7644799040c2b297345c28f0f876</data>
