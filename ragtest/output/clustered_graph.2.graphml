    <node id="PRIMARY BILIARY CIRRHOSIS">
      <data key="d0">EVENT</data>
      <data key="d1">Primary biliary cirrhosis is a chronic disease that slowly destroys the bile ducts in the liver, leading to cirrhosis and nutritional issues.</data>
      <data key="d2">c45c1688135653a80812cdaf426ec9a3</data>
