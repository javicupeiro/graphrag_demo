    </edge>
    <edge source="PACIENTE" target="ALTERACIONES ELECTROL&#205;TICAS">
      <data key="d8">1.0</data>
      <data key="d9">Pacientes may face Alteraciones Electrol&#237;ticas as a result of nutritional support, affecting their health</data>
      <data key="d10">cff2f16dff598dbf0bff544091c77837</data>
      <data key="d11">449c1b1d3dcf47dca66e6898da19570b</data>
      <data key="d12">3513</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="TRASTORNO DEPRESIVO">
      <data key="d8">6.0</data>
      <data key="d9">The patient may experience depressive disorder due to the inability to consume food orally</data>
      <data key="d10">4fbc9ba7c1f3ff190b594c75e7eac015</data>
      <data key="d11">7dfc874efce74c8e929cb193d36f6afa</data>
      <data key="d12">3514</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="AGITACI&#211;N PSICOMOTRIZ">
      <data key="d8">5.0</data>
      <data key="d9">The patient may exhibit psychomotor agitation as a reaction to having a nasoenteral tube or ostomy</data>
      <data key="d10">4fbc9ba7c1f3ff190b594c75e7eac015</data>
      <data key="d11">8d4010c5e2c74e388a59d01c9e688eb1</data>
      <data key="d12">3515</data>
