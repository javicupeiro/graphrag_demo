    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="MCT PROCAL&#174;">
      <data key="d8">7.0</data>
      <data key="d9">MCT PROCAL&#174; can be used in nutritional parenteral therapy</data>
      <data key="d10">12b6478763cfb60ad144be6b81778e03</data>
