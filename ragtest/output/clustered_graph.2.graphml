      <data key="d8">1.0</data>
      <data key="d9">La evaluaci&#243;n psicol&#243;gica es un paso importante en la preparaci&#243;n de pacientes para la cirug&#237;a bari&#225;trica</data>
      <data key="d10">de5f304890ba39f7c9e3d5c0201bc247</data>
      <data key="d11">efda9c0acecc463b84fbb2165d276d37</data>
      <data key="d12">15308</data>
