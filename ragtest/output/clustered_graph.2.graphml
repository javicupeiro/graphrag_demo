    </node>
    <node id="NUTRITION RISK SCREENING 2002">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Nutrition Risk Screening 2002 (NRS-2002) is a validated tool used for nutritional screening to identify patients at risk of malnutrition.</data>
      <data key="d2">5277ea34ef65b7d029950f2c905c6732</data>
