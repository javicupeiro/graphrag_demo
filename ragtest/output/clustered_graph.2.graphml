      <data key="d5">2</data>
      <data key="d6">2150</data>
      <data key="d7">fb548477dcf94e6482413b4112c6c352</data>
    </node>
    <node id="ATROFIA DEL ENTEROCITO">
      <data key="d0">EVENT</data>
      <data key="d1">Atrophy of intestinal cells that can occur without enteral nutrition.</data>
      <data key="d2">89c28a4a0410d8f4cbbbc0fbdf4b1c40</data>
