      <data key="d5">33</data>
      <data key="d6">8621</data>
      <data key="d7">aa81739734f14abab9cff3bc82e9acef</data>
    </node>
    <node id="BIPOLAR DISORDER">
      <data key="d0">EVENT</data>
      <data key="d1">Bipolar disorder is a mental health condition that requires special attention when using BN.</data>
      <data key="d2">f44811ae5b3e9dab0f295efe8842767a</data>
