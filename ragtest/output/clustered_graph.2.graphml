      <data key="d10">6d15ecf6cc2367b96e3ff917060f7f68</data>
      <data key="d11">895970cef4a64a8396e2b310bc7dcfe7</data>
      <data key="d12">19349</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BODE INDEX" target="MRC">
      <data key="d8">7.0</data>
