      <data key="d12">8324</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MAGNESIO" target="DI&#193;LISIS">
      <data key="d8">7.0</data>
      <data key="d9">Dialysis can impact magnesium levels in patients with kidney disease, affecting their overall magnesium balance</data>
