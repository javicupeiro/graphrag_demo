      <data key="d13">2</data>
    </edge>
    <edge source="HIPOXALURIA" target="HIPOXALURIA PRIMARIA">
      <data key="d8">6.0</data>
      <data key="d9">Primary hypoxaluria is a genetic disorder that leads to low oxalate levels in the urine, affecting kidney function.</data>
      <data key="d10">634b74df7b9403e4c578f3fc84fe3335</data>
      <data key="d11">f966aab6a35d4209b0d58740c7247749</data>
