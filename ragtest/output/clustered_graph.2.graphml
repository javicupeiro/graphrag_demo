      <data key="d11">512c7111e9d542dfaf90e1032df963e5</data>
      <data key="d12">14066</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GALICIA" target="ENPE">
      <data key="d8">6.0</data>
