    <node id="ADRI&#193;N AR&#201;S LUQUE">
      <data key="d0">PERSON</data>
      <data key="d1">Adri&#225;n Ar&#233;s Luque is a healthcare professional affiliated with the Service of Neurology at the Complejo Asistencial Universitario in Le&#243;n. He is involved in the Secci&#243;n de Neurolog&#237;a, where he contributes to evidence-based medical practices, enhancing the quality of care provided in the field of neurology.</data>
      <data key="d2">0ea889003f06c1b62aea79aae0901061,651bf69cdd5aec52b456cbea567f1987,e5542485c64706310c70513397de07f9</data>
