    <node id="PACIENTE QUEMADO">
      <data key="d0">PERSON</data>
      <data key="d1">The "PACIENTE QUEMADO" refers to a burn patient who is suffering from severe burns and requires specific nutritional assessment and support. Due to the effects of burns on metabolism and nutrition, this patient necessitates specialized nutritional support and fluid therapy to aid in their recovery.</data>
      <data key="d2">916d4d35de887923f4ea5b05928f13e3,b1b42f264a7bfe8d5c9b931ef8b29b02</data>
      <data key="d3">1113</data>
      <data key="d4">2</data>
      <data key="d5">18</data>
      <data key="d6">13180</data>
      <data key="d7">6c18f2689b00499ea429d5a39724d62b</data>
    </node>
    <node id="MUSCULATURA ESQUEL&#201;TICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Skeletal muscle is affected in burn patients, leading to significant nutritional challenges and risks of malnutrition.</data>
      <data key="d2">b1b42f264a7bfe8d5c9b931ef8b29b02</data>
      <data key="d3">1113</data>
      <data key="d4">2</data>
