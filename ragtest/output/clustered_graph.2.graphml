    </node>
    <node id="ANTIOXIDANTES E-306, E-304">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los antioxidantes E-306 y E-304 son aditivos alimentarios utilizados en productos como las galletas para preservar su frescura.</data>
      <data key="d2">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
