    </node>
    <node id="LAVIE C">
      <data key="d0">PERSON</data>
      <data key="d1">Lavie C es un autor que ha estudiado la asociaci&#243;n entre la grasa epic&#225;rdica y la fibrilaci&#243;n auricular.</data>
      <data key="d2">884a8370915a18a005fb2fa913e4b95c</data>
