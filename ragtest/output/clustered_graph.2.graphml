      <data key="d7">45aac87fd99144e092eb6c762c03b5b5</data>
    </node>
    <node id="BURNED PATIENT">
      <data key="d0">PERSON</data>
      <data key="d1">A burned patient is an individual who has sustained burns and may require specialized nutritional support and medical care.</data>
      <data key="d2">fb0c6cd346ca91e15f8ff1cc07570d9d</data>
      <data key="d3">687</data>
