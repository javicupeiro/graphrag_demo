      <data key="d10">d22c91140c11f7344e9aeebb21454cee</data>
      <data key="d11">641f56b2886645e2bf4e398c3b757941</data>
      <data key="d12">7093</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FIBROSIS QU&#205;STICA" target="TRASTORNOS PSIQUI&#193;TRICOS">
      <data key="d8">1.0</data>
      <data key="d9">Trastornos psiqui&#225;tricos are more frequent in patients with chronic severe diseases like fibrosis qu&#237;stica, establishing a connection</data>
      <data key="d10">d22c91140c11f7344e9aeebb21454cee</data>
      <data key="d11">95dbe2db2ab94a6f9ae25e77bff56c31</data>
      <data key="d12">7094</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FIBROSIS QU&#205;STICA" target="VITAMINA D">
      <data key="d8">9.0</data>
      <data key="d9">Vitamin D supplementation is recommended for patients with Fibrosis Qu&#237;stica to prevent osteoporosis</data>
      <data key="d10">f3d21fef234a5c6fed6ef3fb2c8da1f4</data>
      <data key="d11">5a359cb6dbf741baade561eadabce322</data>
      <data key="d12">7095</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FIBROSIS QU&#205;STICA" target="OSTEOPOROSIS">
      <data key="d8">8.0</data>
      <data key="d9">Patients with Fibrosis Qu&#237;stica are at increased risk for developing osteoporosis</data>
      <data key="d10">f3d21fef234a5c6fed6ef3fb2c8da1f4</data>
      <data key="d11">12837fd4197f416a82e0eb1da12d7e30</data>
      <data key="d12">7096</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FIBROSIS QU&#205;STICA" target="OSTEOPENIA">
      <data key="d8">7.0</data>
      <data key="d9">Osteopenia is a common concern in patients with Fibrosis Qu&#237;stica</data>
      <data key="d10">f3d21fef234a5c6fed6ef3fb2c8da1f4</data>
