      <data key="d6">6854</data>
      <data key="d7">f5cd48e2f24048e98c8e79ed279f6c70</data>
    </node>
    <node id="NECROSIS DEL PAR&#201;NQUIMA">
      <data key="d0">EVENT</data>
      <data key="d1">La necrosis del par&#233;nquima pancre&#225;tico puede ocurrir en casos severos de pancreatitis aguda, complicando el tratamiento y aumentando el riesgo de mortalidad.</data>
      <data key="d2">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
