    </edge>
    <edge source="ACROMEGALY" target="HYPERPHOSPHATEMIA">
      <data key="d8">1.0</data>
      <data key="d9">Hyperphosphatemia may occur in patients with acromegaly due to metabolic alterations</data>
      <data key="d10">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d11">f72bdd502c6d4a55823e340759abb185</data>
