    <node id="SARCOMA DE KAPOSI">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Kaposi's sarcoma is a type of cancer that can lead to complications such as ascitis quilosa.</data>
      <data key="d2">c77caafffd9b5d42c51cb2359ad9cc6d</data>
