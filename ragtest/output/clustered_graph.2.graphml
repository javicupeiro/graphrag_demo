    <node id="C&#193;NCER OVARIO">
      <data key="d0">EVENT</data>
      <data key="d1">C&#225;ncer de ovario is a type of ovarian cancer that has been studied in relation to omega-3 fatty acids.</data>
      <data key="d2">11c3cb37b1a2c111ceb227aefa8d9e1a</data>
      <data key="d3">980</data>
