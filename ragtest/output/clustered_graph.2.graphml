    </node>
    <node id="MEZCLA DE MINERALES">
      <data key="d0">INGREDIENT</data>
      <data key="d1">Mineral mix is included to ensure the product meets dietary mineral requirements.</data>
      <data key="d2">3d73ef14929e7391e915f739189e4dfa</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
