    </edge>
    <edge source="CIRUG&#205;A BARI&#193;TRICA" target="SEGUIMIENTO CL&#205;NICO">
      <data key="d8">1.0</data>
      <data key="d9">El seguimiento cl&#237;nico es crucial para el &#233;xito de la cirug&#237;a bari&#225;trica y la salud a largo plazo del paciente</data>
      <data key="d10">01d01bb87220a5cf6d7b37d95834e15f</data>
      <data key="d11">d63c8e9c74774a9a9b76c6625d2d33db</data>
      <data key="d12">15309</data>
