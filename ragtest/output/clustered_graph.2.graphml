    <edge source="GASTO EN REPOSO" target="GASTO ENERGETICO TOTAL">
      <data key="d8">8.0</data>
      <data key="d9">El gasto en reposo es un componente del gasto energ&#233;tico total, representando una parte significativa de la energ&#237;a utilizada por el cuerpo</data>
      <data key="d10">285343ba92b89a1761b72d9d789ba8f6</data>
      <data key="d11">bccf8af195e4437e9a229550d7c05073</data>
