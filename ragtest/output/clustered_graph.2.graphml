    </node>
    <node id="NUTRITIONAL SUPPORT PREOPERATIVE">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional support in the preoperative phase aims to maintain or improve the nutritional status before surgery.</data>
      <data key="d2">d23c564df025cf16e37f2ef2be83ec34</data>
      <data key="d3">1249</data>
