    <node id="PROTECCI&#211;N BILIAR">
      <data key="d0">EVENT</data>
      <data key="d1">A dietary strategy that reduces fat intake to support gallbladder health, often involving low-fat dairy and simple cooking methods.</data>
      <data key="d2">4681d149c863ed06c99b19443f841abd</data>
      <data key="d3">1445</data>
