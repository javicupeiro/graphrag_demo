    <node id="HIGIENE DEL PACIENTE">
      <data key="d0">EVENT</data>
      <data key="d1">La higiene del paciente es un factor importante que puede influir en el riesgo de infecci&#243;n en aquellos que tienen cat&#233;teres venosos centrales</data>
