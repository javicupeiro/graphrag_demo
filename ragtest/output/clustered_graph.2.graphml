      <data key="d5">0</data>
      <data key="d6">4007</data>
      <data key="d7">c2ec75219a234302a4812465839fb39b</data>
    </node>
    <node id="P&#193;RAMO FERN&#193;NDEZ C.">
      <data key="d0">PERSON</data>
      <data key="d1">P&#225;ramo Fern&#225;ndez C. is the author of the Manual de Endocrinolog&#237;a y Nutrici&#243;n, which contains comprehensive information on diabetes insipida. Additionally, P&#225;ramo Fern&#225;ndez C. has contributed a chapter specifically focused on diabetes insipidus within this manual.</data>
      <data key="d2">2b390802e6a6df561cafb9593e97d6bd,67fc85f14d95a9a24054c2a3ec125e37</data>
      <data key="d3">1457</data>
