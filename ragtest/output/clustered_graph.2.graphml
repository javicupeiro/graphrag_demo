    </node>
    <node id="YALE SCALE">
      <data key="d0">EVENT</data>
      <data key="d1">A standardized scale developed for assessing the severity of pharyngeal residue after swallowing, providing a reliable anatomical evaluation based on imaging.</data>
      <data key="d2">0096a43decd2fc51a199ad13832cca8a</data>
      <data key="d3">1857</data>
