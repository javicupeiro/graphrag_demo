      <data key="d0">ORGANIZATION</data>
      <data key="d1">Working groups on diabetes within the Spanish Society of Endocrinology and Nutrition focus on advancing knowledge and treatment of diabetes.</data>
      <data key="d2">920badd1fd76f2c279282a4a20295a55</data>
      <data key="d3">1297</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6055</data>
      <data key="d7">5187291bb2ba4017b7cec0378966e94a</data>
    </node>
    <node id="GRUPO DE CONSENSOS DE LA SOCIEDAD ESPA&#209;OLA DE DIABETES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A consensus group within the Spanish Diabetes Society that works on guidelines and best practices for diabetes management.</data>
      <data key="d2">920badd1fd76f2c279282a4a20295a55</data>
      <data key="d3">1297</data>
      <data key="d4">2</data>
