    </node>
    <node id="PROPATRIA">
      <data key="d0">EVENT</data>
      <data key="d1">PROPATRIA is a multicenter, randomized, double-blind study that investigated the effects of probiotics in patients with severe pancreatic diseases.</data>
      <data key="d2">fb24bf4c9fcf60bbc1dd56cd60ba0a47</data>
      <data key="d3">1233</data>
      <data key="d4">2</data>
