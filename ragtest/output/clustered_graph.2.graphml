    <node id="GESTATIONAL DIABETES">
      <data key="d0">EVENT</data>
      <data key="d1">Gestational diabetes is a form of diabetes that occurs during pregnancy and is addressed in the screening criteria established by Carpenter MW.</data>
      <data key="d2">54bdd3faa067cdbb44671453ffaf4be5</data>
      <data key="d3">868</data>
      <data key="d4">2</data>
