      <data key="d11">faaefc120fed492c8d42b9f638e15d40</data>
      <data key="d12">5927</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="DIETA EQUILIBRADA">
      <data key="d8">7.0</data>
      <data key="d9">La OMS promueve la dieta equilibrada como parte de sus recomendaciones de salud p&#250;blica</data>
      <data key="d10">91131751d701592a597bae807e00c1dc</data>
      <data key="d11">f2f268ef37074facbbf284643241e75a</data>
      <data key="d12">5928</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="SAL">
      <data key="d8">7.0</data>
      <data key="d9">La OMS proporciona directrices sobre la ingesta de sal para prevenir enfermedades relacionadas con la dieta</data>
      <data key="d10">91131751d701592a597bae807e00c1dc</data>
      <data key="d11">dfb8edd0e8ba41c09eb25a1d685dd34c</data>
      <data key="d12">5929</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="FIBRA DIET&#201;TICA">
      <data key="d8">7.0</data>
      <data key="d9">La OMS recomienda un consumo adecuado de fibra diet&#233;tica para mantener la salud digestiva</data>
