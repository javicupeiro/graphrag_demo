      <data key="d11">a15eaa3f3bbd49af9d8ead8afee8e8a7</data>
      <data key="d12">5039</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA CARRAGENINA" target="CARRAGHEEN">
      <data key="d8">1.0</data>
      <data key="d9">La carragenina ha sido utilizada en Carragheen durante siglos, destacando su importancia en la elaboraci&#243;n de alimentos.</data>
