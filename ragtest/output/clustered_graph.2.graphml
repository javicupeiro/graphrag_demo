    </edge>
    <edge source="DIN" target="ORLISTAT">
      <data key="d8">1.0</data>
      <data key="d9">Orlistat can lead to nephrogenic diabetes insipidus as a side effect.</data>
      <data key="d10">1fb4c8ba1bc908ea3a3c7717a073fa4f</data>
