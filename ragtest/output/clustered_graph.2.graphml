    <node id="ADIPOSIDAD INTRAMIOC&#193;RDICA">
      <data key="d0">EVENT</data>
      <data key="d1">La adiposidad intramioc&#225;rdica se refiere a la acumulaci&#243;n de grasa dentro del m&#250;sculo card&#237;aco, que puede afectar la funci&#243;n card&#237;aca.</data>
      <data key="d2">884a8370915a18a005fb2fa913e4b95c</data>
