    </edge>
    <edge source="C&#193;NCER DE CABEZA Y CUELLO" target="HYPERCALCEMIA">
      <data key="d8">7.0</data>
      <data key="d9">C&#225;ncer de cabeza y cuello can lead to hypercalcemia in patients</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">19bea9e4092a4bf88c270d0b3e749eb9</data>
      <data key="d12">5442</data>
