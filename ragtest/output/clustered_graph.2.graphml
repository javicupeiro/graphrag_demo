      <data key="d11">2bc0e511b1c647e284fb670f108c9699</data>
      <data key="d12">20276</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRIBUNAL" target="MINISTERIO FISCAL">
      <data key="d8">7.0</data>
      <data key="d9">The Ministerio Fiscal is involved in legal proceedings and presents cases to the tribunal</data>
