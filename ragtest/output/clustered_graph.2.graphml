      <data key="d5">7</data>
      <data key="d6">3542</data>
      <data key="d7">1251f0a8161348c7bafc372e2ff404c6</data>
    </node>
    <node id="GASTRECTOMIZED">
      <data key="d0">EVENT</data>
      <data key="d1">Gastrectomized refers to individuals who have undergone surgical removal of part or all of the stomach, which can affect nutrient absorption, including iron.</data>
