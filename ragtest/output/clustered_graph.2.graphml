      <data key="d6">3322</data>
      <data key="d7">88093dc89d7d4978805ed1be2912d697</data>
    </node>
    <node id="LEUCINE">
      <data key="d0">EVENT</data>
      <data key="d1">Leucine is an essential amino acid that plays a significant role in stimulating muscle protein synthesis, particularly important for elderly individuals.</data>
      <data key="d2">2f194bef97e28167f81acc7a66ac56ab</data>
      <data key="d3">482</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
