    <edge source="NUTRICI&#211;N ARTIFICIAL" target="EEUU">
      <data key="d8">5.0</data>
      <data key="d9">Las leyes en EEUU sobre nutrici&#243;n artificial var&#237;an por estado, lo que afecta c&#243;mo se considera este tratamiento</data>
