    </node>
    <node id="POLIARTRITIS">
      <data key="d0">EVENT</data>
      <data key="d1">La poliartritis es una inflamaci&#243;n de m&#250;ltiples articulaciones que puede ser un s&#237;ntoma asociado a la enfermedad de Wilson.</data>
      <data key="d2">ea816809115cc37c571bd36191042123</data>
      <data key="d3">1792</data>
