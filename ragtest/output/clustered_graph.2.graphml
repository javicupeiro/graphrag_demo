    <node id="PREDI&#193;LISIS">
      <data key="d0">EVENT</data>
      <data key="d1">La predi&#225;lisis es la fase anterior a la di&#225;lisis en pacientes con enfermedad renal cr&#243;nica, donde se requiere un manejo nutricional espec&#237;fico.</data>
      <data key="d2">169eceabd2bd24183f24faccb2c00088</data>
      <data key="d3">1157</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14458</data>
      <data key="d7">915c7b5c1b1c4292870d3dc4cb65843d</data>
    </node>
    <node id="OCFA">
      <data key="d0">EVENT</data>
      <data key="d1">Obstructive Chronic Airflow Disease (OCFA) is a condition where specialized nutritional formulas may be indicated.</data>
      <data key="d2">428ea9c156fe3f0571b20d5d81648868</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14459</data>
      <data key="d7">27cf2109502c42ac9622b5c4f58825ce</data>
    </node>
    <node id="FORMULAS NUTRICIONALES">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional formulas are specialized products designed to meet the dietary needs of patients, particularly those unable to consume food orally.</data>
      <data key="d2">428ea9c156fe3f0571b20d5d81648868</data>
      <data key="d3">1110</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14460</data>
      <data key="d7">9a3a53cf53cf4af4968d8a86b1601132</data>
    </node>
    <node id="F&#211;RMULA">
      <data key="d0">EVENT</data>
      <data key="d1">F&#211;RMULA es un sustituto de la leche materna utilizado para alimentar a los reci&#233;n nacidos, especialmente aquellos que son prematuros. Esta f&#243;rmula est&#225; dise&#241;ada para satisfacer las necesidades nutricionales espec&#237;ficas de estos infantes. Adem&#225;s, las f&#243;rmulas de nutrici&#243;n enteral son preparaciones que proporcionan nutrientes a pacientes que no pueden alimentarse por v&#237;a oral, lo que resalta la versatilidad y la importancia de las f&#243;rmulas en el &#225;mbito de la nutrici&#243;n m&#233;dica y pedi&#225;trica.</data>
      <data key="d2">724f16660e0077267b0836a0e1fb02c3,8178ba40e7ef08e569845c1f3f1621cc</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">14461</data>
      <data key="d7">81b34fd3f0374fb4bb2fc45c0d6de8e0</data>
    </node>
    <node id="SUEROTERAPIA">
      <data key="d0">EVENT</data>
      <data key="d1">La sueroterapia es un m&#233;todo de administraci&#243;n de l&#237;quidos y nutrientes a trav&#233;s de una v&#237;a venosa, complementando la nutrici&#243;n enteral.</data>
      <data key="d2">8178ba40e7ef08e569845c1f3f1621cc</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14462</data>
      <data key="d7">ead5fd10173640daaeeaeb425bc5bd98</data>
    </node>
    <node id="F&#211;RMULA ESPECIAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A specialized nutritional formula designed for patients with organ failure.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1096</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">14463</data>
      <data key="d7">faba7a84ef3c405298a341906cf42df5</data>
    </node>
    <node id="F&#211;RMULA ADAPTADA A PATOLOG&#205;A">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A nutritional formula adapted to specific medical conditions.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1096</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14464</data>
      <data key="d7">ca8987a4d36d47acb355c8a78550a6c8</data>
    </node>
    <node id="F&#211;RMULA OLIGOM&#201;RICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A type of nutritional formula that is partially hydrolyzed for easier absorption in patients with intestinal failure.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d5">0</data>
      <data key="d6">14465</data>
      <data key="d7">f05c46a8184544cd980c2b8585788758</data>
    </node>
    <node id="F&#211;RMULA NORMOPROTEICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A nutritional formula containing a normal amount of protein, suitable for patients without severe stress.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">211</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">14466</data>
      <data key="d7">611137c35be743f6908e40441e0cbcbd</data>
    </node>
    <node id="F&#211;RMULA HIPERPROTEICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A nutritional formula with a high protein content, used for patients under severe stress.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">211</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">14467</data>
      <data key="d7">4e792ec90efc4e73ad59f45fd1117356</data>
    </node>
    <node id="F&#211;RMULA NORMOCAL&#211;RICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A nutritional formula providing a normal caloric intake.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">211</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">14468</data>
      <data key="d7">692d4f930aa147e19e3411438cf6536f</data>
    </node>
    <node id="F&#211;RMULA HIPERCAL&#211;RICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A nutritional formula providing a high caloric intake for patients with increased energy needs.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">211</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">14469</data>
      <data key="d7">3fd56a4c852746ae9948ddc1ea2f6a0e</data>
    </node>
    <node id="VAR&#211;N DE 75 A&#209;OS">
      <data key="d0">PERSON</data>
      <data key="d1">A 75-year-old male patient admitted for medical treatment, potentially requiring nutritional support.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14470</data>
      <data key="d7">6e9cf324ed144427aa2b2cb8b31d9e18</data>
    </node>
    <node id="NUTRICI&#211;N CON JERINGA">
      <data key="d0">EVENT</data>
      <data key="d1">A method of administering nutrition using a special syringe, typically delivering 200-300 ml per intake throughout the day.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14471</data>
      <data key="d7">6cd1be7512504e34b894962beb3ad902</data>
    </node>
    <node id="NUTRICI&#211;N POR GRAVEDAD">
      <data key="d0">EVENT</data>
      <data key="d1">A method of intermittent infusion that relies on gravity to regulate the flow of nutrition, typically administered 4-6 times a day.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14472</data>
      <data key="d7">8d37c780fcc24a0b85354aaaa072a508</data>
    </node>
    <node id="PRESCRIPCI&#211;N DE NUTRICI&#211;N ENTERAL">
      <data key="d0">EVENT</data>
      <data key="d1">The process of prescribing enteral nutrition, which must be standardized and precise to reduce errors in dispensing.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14473</data>
      <data key="d7">9deb33f136f046b88832bc86611516ce</data>
    </node>
    <node id="MONITORIZACI&#211;N DE NUTRICI&#211;N ENTERAL">
      <data key="d0">EVENT</data>
      <data key="d1">The monitoring of enteral nutrition, focusing on the clinical and metabolic status of the patient and their tolerance to the nutritional preparation.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">14474</data>
      <data key="d7">6c3190f70a9e46f08e987455af2aa3af</data>
    </node>
    <node id="VALORACI&#211;N DE LA TOLERANCIA">
      <data key="d0">EVENT</data>
      <data key="d1">The assessment of a patient's tolerance to enteral nutrition, which is crucial for effective treatment.</data>
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14475</data>
      <data key="d7">e16ae053476040c0ab4d07d912dbc8b5</data>
    </node>
    <node id="NUTRICI&#211;N INTERMITENTE">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14476</data>
      <data key="d7">997449c3f2ea46ff9254e86f2ad8300d</data>
    </node>
    <node id="REQUERIMIENTOS PROTEICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los requerimientos proteicos son la cantidad de prote&#237;nas que el var&#243;n de 75 a&#241;os necesita diariamente, que se ha establecido en 70 g/d&#237;a.</data>
      <data key="d2">4b0e0d4e1d3067bf7e0e850063a43d21</data>
      <data key="d3">1095</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14477</data>
      <data key="d7">0ec90480945f459181aadcec81098286</data>
    </node>
    <node id="REQUERIMIENTOS H&#205;DRICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los requerimientos h&#237;dricos son la cantidad de l&#237;quidos que el var&#243;n de 75 a&#241;os necesita diariamente, que se ha establecido entre 2100-2800 ml/d&#237;a.</data>
      <data key="d2">4b0e0d4e1d3067bf7e0e850063a43d21</data>
      <data key="d3">1095</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14478</data>
      <data key="d7">885fe9bdd3304a38be88109bdf5a62b5</data>
    </node>
    <node id="BOLOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los bolos son una forma de administraci&#243;n de nutrici&#243;n enteral en la que se administran cantidades espec&#237;ficas de alimento en intervalos regulares.</data>
      <data key="d2">4b0e0d4e1d3067bf7e0e850063a43d21</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14479</data>
      <data key="d7">734111dc68604ef485bb118b333c2a29</data>
    </node>
    <node id="EVALUACI&#211;N DE LA TOLERANCIA">
      <data key="d0">EVENT</data>
      <data key="d1">La evaluaci&#243;n de la tolerancia es un proceso importante para determinar c&#243;mo el var&#243;n de 75 a&#241;os est&#225; respondiendo a la nutrici&#243;n enteral.</data>
      <data key="d2">4b0e0d4e1d3067bf7e0e850063a43d21</data>
      <data key="d3">1095</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14480</data>
      <data key="d7">9f7a2a4a025f4b49a9a9d0013d1fcda0</data>
    </node>
    <node id="S&#205;NTOMAS DEL PACIENTE">
      <data key="d0">EVENT</data>
      <data key="d1">Los s&#237;ntomas del paciente, como dolor abdominal y n&#225;useas, son indicadores que se eval&#250;an para determinar la tolerancia a la nutrici&#243;n enteral.</data>
      <data key="d2">4b0e0d4e1d3067bf7e0e850063a43d21</data>
      <data key="d3">1095</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14481</data>
      <data key="d7">df575a6a3bd848d7aa73667a1ad8465c</data>
    </node>
    <node id="VARIABLES ANTROPOM&#201;TRICAS">
      <data key="d0">EVENT</data>
      <data key="d1">Las variables antropom&#233;tricas, como el peso y los per&#237;metros, son medidas que se revisan semanalmente en el var&#243;n de 75 a&#241;os para evaluar su estado nutricional.</data>
      <data key="d2">4b0e0d4e1d3067bf7e0e850063a43d21</data>
      <data key="d3">1095</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14482</data>
      <data key="d7">16d9a56c34d442d8aaf8322d595ec525</data>
    </node>
    <node id="V&#205;A ORAL">
      <data key="d0">EVENT</data>
      <data key="d1">V&#205;A ORAL refers to the method of nutrition that is being considered for a 75-year-old male patient once his condition allows for it. This approach aims to recover the oral feeding method, which some patients have transitioned to after ending their NPD (Nutritional Parenteral Diet) treatment.</data>
      <data key="d2">4b0e0d4e1d3067bf7e0e850063a43d21,efc0b55f4e91f02e4708b7cc43c64608</data>
      <data key="d3">1095</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14483</data>
      <data key="d7">2da2852fcd3e424b9f5383f03f280c98</data>
    </node>
    <node id="RESIDUO G&#193;STRICO">
      <data key="d0">EVENT</data>
      <data key="d1">El residuo g&#225;strico se refiere a la cantidad de alimento o l&#237;quido que permanece en el est&#243;mago despu&#233;s de la alimentaci&#243;n. Este volumen de contenido es importante para evaluar la tolerancia a la nutrici&#243;n enteral, ya que su presencia puede indicar problemas de tolerancia. En pacientes que reciben nutrici&#243;n enteral, el residuo g&#225;strico se mide y se monitoriza para asegurar que el cuerpo est&#225; procesando adecuadamente los nutrientes.</data>
      <data key="d2">13c6297da17b9be4a67cf439f62cd289,69de439cf1f8310eaa37927a74d94c6b,e569eda9506ef1e77080a8120e388963</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">14484</data>
      <data key="d7">f46bbe5dfcc44f749e23daa0d17baca1</data>
    </node>
    <node id="ESTRATEGIAS PARA REDUCIR EL RIESGO DE ASPIRACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Son pr&#225;cticas recomendadas para minimizar el riesgo de aspiraci&#243;n en pacientes que reciben nutrici&#243;n enteral.</data>
      <data key="d2">13c6297da17b9be4a67cf439f62cd289</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14485</data>
      <data key="d7">f8eea38c44ff4fa48b1205736cf4df77</data>
    </node>
    <node id="BLOQUE SOPORTE NUTRICIONAL AVANZADO">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">13c6297da17b9be4a67cf439f62cd289</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14486</data>
      <data key="d7">936089e6a55e4cf7bd84e5676057c0a1</data>
    </node>
    <node id="VACIADO G&#193;STRICO">
      <data key="d0">EVENT</data>
      <data key="d1">El vaciado g&#225;strico es el proceso mediante el cual el contenido del est&#243;mago se mueve hacia el intestino delgado, y es un factor cr&#237;tico en la nutrici&#243;n enteral.</data>
      <data key="d2">6a5102072d17111dafe768ab7d38f41a</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14487</data>
      <data key="d7">8cdb32d1ba5d485b8c6f8641ea265ee4</data>
    </node>
    <node id="T&#201;CNICA DE ADMINISTRACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">La t&#233;cnica de administraci&#243;n se refiere a los m&#233;todos utilizados para proporcionar nutrici&#243;n enteral, incluyendo la posici&#243;n del paciente y el ritmo de infusi&#243;n.</data>
      <data key="d2">6a5102072d17111dafe768ab7d38f41a</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14488</data>
      <data key="d7">4b26fb8f45ab4c24a7331d81894e5948</data>
    </node>
    <node id="SOPORTE NUTRICIONAL AVANZADO">
      <data key="d0">EVENT</data>
      <data key="d1">SOPORTE NUTRICIONAL AVANZADO refers to advanced nutritional support practices and protocols utilized in medical settings, particularly for patients in critical conditions. This approach encompasses various techniques aimed at managing the nutritional needs of patients, especially those requiring enteral and parenteral nutrition. It emphasizes the importance of catheter management and infection prevention to ensure patient safety and efficacy of nutritional support. Additionally, SOPORTE NUTRICIONAL AVANZADO focuses on the specific electrolyte and mineral requirements necessary for optimal patient care, while also addressing potential complications associated with parenteral nutrition. Overall, it plays a crucial role in influencing patient outcomes, including the management of conditions such as diarrhea.</data>
      <data key="d2">241d358b60724c07a75223b79c9e5f41,4ce6342fdfe4419826c1ab2f84c56247,be901905a9eef428a784ea179931028a,cff2f16dff598dbf0bff544091c77837,d1d2d307f9b3ceb8f8a21846f314b260,d2f16314e7098030a6780411d2e03023,d3e1df90991ea82fcccbd02589473ead</data>
      <data key="d3">589</data>
      <data key="d4">2</data>
      <data key="d5">17</data>
      <data key="d6">14489</data>
      <data key="d7">320cc94a13934b058aa64d15c18f8d31</data>
    </node>
    <node id="ANTIHIPERTENSIVOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Antihypertensives are medications used to treat high blood pressure, which can have diarrhea as a side effect.</data>
      <data key="d2">d3e1df90991ea82fcccbd02589473ead</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14490</data>
      <data key="d7">fc1e396ffd3f472781f04dbc0485eebc</data>
    </node>
    <node id="COLINERGICOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Cholinergics are drugs that can stimulate the parasympathetic nervous system and may cause diarrhea as a side effect.</data>
      <data key="d2">d3e1df90991ea82fcccbd02589473ead</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14491</data>
      <data key="d7">90ff30a8eb684dcb923fbb24e1ce9231</data>
    </node>
    <node id="ANTIACIDOS CON MAGNESIO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Antacids containing magnesium can lead to diarrhea due to their laxative effect.</data>
      <data key="d2">d3e1df90991ea82fcccbd02589473ead</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14492</data>
      <data key="d7">13869aa64d0f45ddb03f2cf0999eae4c</data>
    </node>
    <node id="ANTIDIABETICOS ORALES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Oral antidiabetic medications can cause gastrointestinal side effects, including diarrhea.</data>
      <data key="d2">d3e1df90991ea82fcccbd02589473ead</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14493</data>
      <data key="d7">85e5d598bad54d408720f8060718ce68</data>
    </node>
    <node id="INHIBIDORES DE LA RECAPTACION DE LA SEROTONINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Serotonin reuptake inhibitors are antidepressants that can have gastrointestinal side effects, including diarrhea.</data>
      <data key="d2">d3e1df90991ea82fcccbd02589473ead</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
