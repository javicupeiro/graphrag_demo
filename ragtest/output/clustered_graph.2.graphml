      <data key="d5">4</data>
      <data key="d6">7916</data>
      <data key="d7">f7933f0821244591b97a7147e7d23ea4</data>
    </node>
    <node id="NATA FERMENTADA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">La nata fermentada es un producto l&#225;cteo que debe cumplir con las regulaciones de etiquetado de la Uni&#243;n Europea.</data>
      <data key="d2">8255943be503f6709a8e63d7d33b79d1</data>
