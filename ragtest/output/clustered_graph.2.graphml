      <data key="d9">The Harris-Benedict equation is used to calculate the nutritional requirements for patients to ensure adequate caloric intake</data>
      <data key="d10">2b9c137acf3599eaa41c3514aba67a8a</data>
      <data key="d11">5966140103ee44d2b553d336c63a7582</data>
      <data key="d12">760</data>
