    </node>
    <node id="AMILORIDA">
      <data key="d0">EVENT</data>
      <data key="d1">Amilorida is a medication mentioned in the treatment of nephrogenic diabetes insipidus.</data>
      <data key="d2">2b390802e6a6df561cafb9593e97d6bd</data>
      <data key="d3">1324</data>
      <data key="d4">2</data>
