      <data key="d11">d41bf154929548c0b8d9c0160824f92a</data>
      <data key="d12">16774</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CITOQUINAS" target="&#193;CIDOS OMEGA-3">
      <data key="d8">1.0</data>
      <data key="d9">Omega-3 fatty acids reduce pro-inflammatory cytokines, thus influencing the immune response.</data>
