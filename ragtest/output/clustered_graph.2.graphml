      <data key="d0">ORGANIZATION</data>
      <data key="d1">SOPORTE NUTRICIONAL POSTOPERATORIO refers to the nutritional support provided to patients after surgery to aid recovery.</data>
      <data key="d2">a089d87928ddde83e1945eece488d3f5</data>
