    </node>
    <node id="COAGULATION SYSTEM">
      <data key="d0">EVENT</data>
      <data key="d1">The coagulation system is a complex process that prevents and stops bleeding, which can be affected by frailty and inflammation.</data>
      <data key="d2">0903b40c7774225e89c5e798f9feef9b</data>
      <data key="d3">1762</data>
