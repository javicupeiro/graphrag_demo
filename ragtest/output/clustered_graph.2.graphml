    <node id="COELIAC DISEASE">
      <data key="d0">EVENT</data>
      <data key="d1">Celiac disease is a chronic autoimmune disorder that occurs in genetically predisposed people where the ingestion of gluten leads to damage in the small intestine.</data>
      <data key="d2">17593b5969d4126aef1c56a7d32dc922</data>
      <data key="d5">0</data>
      <data key="d6">10517</data>
