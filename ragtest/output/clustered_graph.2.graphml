    <node id="ELIE METCHNIKOFF">
      <data key="d0">PERSON</data>
      <data key="d1">Elie Metchnikoff was a Russian scientist and Nobel laureate known for his research on lactic acid bacteria and their health benefits, particularly in promoting longevity.</data>
      <data key="d2">113f5fda648e7322f4771e2ade72481f</data>
      <data key="d3">1024</data>
      <data key="d4">2</data>
