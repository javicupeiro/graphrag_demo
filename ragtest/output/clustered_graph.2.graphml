      <data key="d6">882</data>
      <data key="d7">eff1dd3e9e714502a3da99720bf76436</data>
    </node>
    <node id="PRINCIPIO 5">
      <data key="d0">EVENT</data>
      <data key="d1">Principio 5 outlines the establishment of corrective actions for critical control points in food safety management.</data>
      <data key="d2">4431bc1a109798ef648c103ac4eb321a</data>
      <data key="d3">1857</data>
