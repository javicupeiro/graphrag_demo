      <data key="d8">7.0</data>
      <data key="d9">SEFH collaborates in the preparation of parenteral nutrition mixtures as part of the protocol</data>
      <data key="d10">3f3896c039ea7ef78de8bf5fb6e09a48</data>
      <data key="d11">382989b93a974ac9bf3fcbbbca6c7e2c</data>
