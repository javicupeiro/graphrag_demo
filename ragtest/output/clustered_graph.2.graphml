      <data key="d10">d1d2d307f9b3ceb8f8a21846f314b260</data>
      <data key="d11">a4a6c28a7f0e4cbbb077d3ee047e50f1</data>
      <data key="d12">9478</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACETATO DE MEGESTROL" target="MEDICINA DIGESTIVA">
      <data key="d8">7.0</data>
      <data key="d9">Medicina Digestiva prescribed acetato de megestrol to increase the patient's appetite</data>
      <data key="d10">bfdbf41efa08067d5ae1b1a67830affd</data>
      <data key="d11">c11543977a6c478e9f0616a6090ee9c2</data>
      <data key="d12">9479</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACETATO DE MEGESTROL" target="FQ">
      <data key="d8">7.0</data>
      <data key="d9">Acetato de megestrol is used as a treatment to address malnutrition in patients with cystic fibrosis, aiming to improve their caloric intake.</data>
      <data key="d10">f1f6ad756644e84b6caa8e4e3adb94da</data>
      <data key="d11">d283482cf6af4db98d578c386f32bd6f</data>
      <data key="d12">9480</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACETATO DE MEGESTROL" target="NUTRICI&#211;N EN ONCOLOG&#205;A">
      <data key="d8">8.0</data>
      <data key="d9">Acetato de megestrol is used as part of nutritional strategies in oncology to improve appetite in cancer patients</data>
      <data key="d10">42e8a4a4bff905ef121f1101d65c959f</data>
      <data key="d11">5bb9963914b34782ace45ebfdc477285</data>
      <data key="d12">9481</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACETATO DE MEGESTROL" target="ANABOLIZANTES">
      <data key="d8">8.0</data>
      <data key="d9">Acetato de megestrol is considered more effective than anabolizantes for improving appetite in cancer patients</data>
      <data key="d10">16887bf1589e9515213d2e392bbc8c69</data>
      <data key="d11">d45547e33be84418a66e889f7df4e022</data>
      <data key="d12">9482</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACETATO DE MEGESTROL" target="DRONABINOL">
      <data key="d8">7.0</data>
      <data key="d9">Dronabinol and acetato de megestrol are both used to stimulate appetite in cancer patients, but acetato de megestrol has shown superior efficacy</data>
