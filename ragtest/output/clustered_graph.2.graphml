      <data key="d7">9b9a44ed2d574f4a963a2ce8660081e0</data>
    </node>
    <node id="GEMELOS">
      <data key="d0">PERSON</data>
      <data key="d1">Los gemelos son sujetos de un estudio que relaciona el tabaquismo con la enfermedad tiroidea autoinmune, mostrando la influencia gen&#233;tica en la enfermedad.</data>
      <data key="d2">1263bbcd20f6e54800e1c9361466bc63</data>
