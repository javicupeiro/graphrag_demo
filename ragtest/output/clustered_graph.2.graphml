      <data key="d0">EVENT</data>
      <data key="d1">Hospitalizaci&#243;n a domicilio refers to home hospitalization services that may collaborate in the organization of NPD.</data>
      <data key="d2">f84386a9907d954b9cf46475d0d45243</data>
