      <data key="d7">c88ac45b33c4461582611df1c7baee61</data>
    </node>
    <node id="NUTRICI&#211;N PARENTERAL COMPLEMENTARIA">
      <data key="d0">EVENT</data>
      <data key="d1">La nutrici&#243;n parenteral complementaria se indica en pacientes cr&#237;ticos cuando la nutrici&#243;n enteral no es suficiente para cubrir sus necesidades.</data>
      <data key="d2">422dbd193843eb5098307e57ba002ced</data>
      <data key="d3">1163</data>
