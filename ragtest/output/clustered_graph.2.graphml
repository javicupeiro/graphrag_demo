      <data key="d7">36876700fcf54c358c3c43483c0d29c2</data>
    </node>
    <node id="PRINCIPIO 6">
      <data key="d0">EVENT</data>
      <data key="d1">Principio 6 emphasizes the creation of a verification system to ensure the proper functioning of food safety protocols.</data>
      <data key="d2">4431bc1a109798ef648c103ac4eb321a</data>
      <data key="d3">1857</data>
      <data key="d4">2</data>
