    </node>
    <node id="SPIGA BARRADA">
      <data key="d0">EVENT</data>
      <data key="d1">Spiga barrada is the international symbol for gluten-free products, regulated by AOECS and used by industries to signify compliance with gluten-free standards.</data>
      <data key="d2">dfb6e1826ded0b8ca7cf3304d1b75d1a</data>
