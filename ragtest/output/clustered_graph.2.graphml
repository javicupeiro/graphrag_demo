      <data key="d8">7.0</data>
      <data key="d9">Nutritional support involves specific macronutrient distribution to help manage diabetes</data>
      <data key="d10">8413d4414414c5cb139198857cce327a</data>
      <data key="d11">35699f8168da4699933a4f715cc97bcd</data>
      <data key="d12">3709</data>
