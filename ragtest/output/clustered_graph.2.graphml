      <data key="d8">1.0</data>
      <data key="d9">Neonatal care includes the administration of parenteral nutrition for newborns who require it</data>
      <data key="d10">103ae80b955f35401aca706444999b29</data>
      <data key="d11">11a73571a20a432eb31a4199d4c13c71</data>
      <data key="d12">4703</data>
      <data key="d13">2</data>
    </edge>
