    </node>
    <node id="ANEMIA CARENCIAL">
      <data key="d0">EVENT</data>
      <data key="d1">Deficiency anemia is a condition that occurs when the body does not have enough healthy red blood cells due to a lack of iron, which is often associated with malnutrition.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
