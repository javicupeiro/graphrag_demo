      <data key="d11">6c4a69405d4f46fc87555dd38f1d200e</data>
      <data key="d12">4739</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ESTEATOSIS HEP&#193;TICA">
      <data key="d8">15.0</data>
      <data key="d9">NUTRICI&#211;N PARENTERAL and ESTEATOSIS HEP&#193;TICA are interconnected in the context of medical nutrition. Hepatic steatosis, also known as fatty liver, is a common complication that can occur following the initiation of parenteral nutrition. This condition arises as a result of the nutritional support provided through parenteral means, highlighting the potential risks associated with this form of nutrition.</data>
      <data key="d10">036e8182deab774d39f06cd811738c9b,9480cb55d00db88cfe1decdf011cb41f</data>
      <data key="d11">c3677c09c53140f48c6b259816a7c95d</data>
      <data key="d12">4740</data>
      <data key="d13">2</data>
    </edge>
