    <edge source="NI&#209;OS/AS" target="9-13 A&#209;OS">
      <data key="d8">11.0</data>
      <data key="d9">Children aged 9-13 years, referred to as "Ni&#241;os/as," are a specific segment within the broader category of children. This age group encompasses individuals who are in the developmental stage of early adolescence, characterized by significant physical, emotional, and social changes.</data>
      <data key="d10">4fe098dece0637a1082d6a439757620a,6c65beaf6ed5575b0945052270630136</data>
      <data key="d11">5a8a24bed99648d49ee555c15a1fff0d</data>
      <data key="d12">20634</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NI&#209;OS/AS" target="14-18 A&#209;OS">
      <data key="d8">11.0</data>
      <data key="d9">The entity "NI&#209;OS/AS" encompasses children aged 14-18 years, who are specifically identified as part of this broader category. Therefore, children aged 14-18 are included within the definition of Ni&#241;os/as, highlighting that this age group is recognized as children within the larger context of youth.</data>
      <data key="d10">4fe098dece0637a1082d6a439757620a,6c65beaf6ed5575b0945052270630136</data>
      <data key="d11">b4d496079a814730b25f3e0635363abc</data>
      <data key="d12">20635</data>
      <data key="d13">2</data>
    </edge>
