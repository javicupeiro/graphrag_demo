    <node id="GUIDELINES FOR THE USE OF PARENTERAL AND ENTERAL NUTRITION">
      <data key="d0">EVENT</data>
      <data key="d1">A set of guidelines published for the use of parenteral and enteral nutrition in adult and pediatric patients.</data>
      <data key="d2">3f3896c039ea7ef78de8bf5fb6e09a48</data>
