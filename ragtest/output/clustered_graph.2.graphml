    </edge>
    <edge source="SONDA ENTERAL" target="FENITO&#205;NA">
      <data key="d8">8.0</data>
      <data key="d9">Fenito&#237;na requires careful administration protocols when given through enteral feeding tubes due to its narrow therapeutic range</data>
      <data key="d10">0e014859b304da60c29590e36c9cbc85</data>
      <data key="d11">baf8d9ea995b47a8878598c0d52b0a36</data>
      <data key="d12">7916</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SONDA ENTERAL" target="DICUMAR&#205;NICOS">
      <data key="d8">8.0</data>
      <data key="d9">Dicumar&#237;nicos need special precautions when administered through enteral feeding tubes</data>
      <data key="d10">0e014859b304da60c29590e36c9cbc85</data>
