      <data key="d7">ea9ddfa92d944c2dae8a2eb2cd7d57e6</data>
    </node>
    <node id="EVALUACI&#211;N DE RESERVA FUNCIONAL SOMATOTROPA">
      <data key="d0">EVENT</data>
      <data key="d1">Evaluaci&#243;n de reserva funcional somatotropa is a clinical assessment process to evaluate the function of the growth hormone axis in patients.</data>
      <data key="d2">593ae586183f02d2611966f8a1603e5d</data>
      <data key="d3">1080</data>
