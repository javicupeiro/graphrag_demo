      <data key="d0">PERSON</data>
      <data key="d1">Mar&#237;a Jos&#233; Molina Puerta is a specialist in Endocrinology and Nutrition at Hospital Universitario Reina Sof&#237;a in C&#243;rdoba.</data>
      <data key="d2">e70fa2e099766154321f13c0112d436a</data>
