    </node>
    <node id="ALIMENTACI&#211;N S&#211;LIDA">
      <data key="d0">EVENT</data>
      <data key="d1">Alimentaci&#243;n s&#243;lida (solid food introduction) marks a significant change in the composition of the intestinal microbiota as the child grows.</data>
      <data key="d2">b36b8846f109ee75806c6ea03015e5d5</data>
      <data key="d3">661</data>
      <data key="d4">2</data>
