    </node>
    <node id="YONSEI MEDICAL JOURNAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Yonsei Medical Journal is a peer-reviewed medical journal that covers various aspects of medical research and clinical practices.</data>
      <data key="d2">c3c8c4edabc77ed1f0a834676de2939c</data>
