    <edge source="HIPOPITUITARISMO" target="CORTICOTROPINOMAS">
      <data key="d8">7.0</data>
      <data key="d9">Corticotropinomas can lead to hypopituitarism due to their impact on hormone production</data>
      <data key="d10">4faa9b46acd7540904fc5b0772bb7c51</data>
      <data key="d11">a41b4c64398741129d69fb800f7a2e53</data>
      <data key="d12">12365</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="ADENOMAS">
      <data key="d8">6.0</data>
      <data key="d9">Adenomas may require monitoring for the development of hypopituitarism</data>
      <data key="d10">4faa9b46acd7540904fc5b0772bb7c51</data>
      <data key="d11">a28c05bfd3fa4885a3453198116f52c4</data>
      <data key="d12">12366</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="DIABETES INSIPIDA">
      <data key="d8">5.0</data>
      <data key="d9">Diabetes insipida can be a symptom of hypopituitarism</data>
      <data key="d10">4faa9b46acd7540904fc5b0772bb7c51</data>
      <data key="d11">a637a3a1370f413e83f287530b55246e</data>
      <data key="d12">12367</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="DEFICIT DE GH">
      <data key="d8">8.0</data>
      <data key="d9">Hipopituitarismo can lead to deficit de GH due to insufficient hormone production</data>
      <data key="d10">742d2991389effe376f335dad6fbafa1</data>
      <data key="d11">5b61e2c5b11b4910b5879b5a39c9f87f</data>
      <data key="d12">12368</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="DEFINICI&#211;N DE CRITERIOS AUXOL&#211;GICOS">
      <data key="d8">1.0</data>
      <data key="d9">Definici&#243;n de criterios auxol&#243;gicos includes guidelines for diagnosing hipopituitarismo</data>
      <data key="d10">742d2991389effe376f335dad6fbafa1</data>
      <data key="d11">f9dbe88bc3a14f5e83617377489d285b</data>
      <data key="d12">12369</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="RETARDO PUBERAL">
      <data key="d8">1.0</data>
      <data key="d9">El hipopituitarismo puede resultar en retraso puberal debido a la falta de producci&#243;n hormonal adecuada</data>
      <data key="d10">b972e75c5d62cc5cd76d9fc308265621</data>
      <data key="d11">4e65f1b12d554bc59818f6f2bbe90077</data>
      <data key="d12">12370</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="IPILIMUMAB">
      <data key="d8">6.0</data>
      <data key="d9">Ipilimumab can cause hypopituitarism as an adverse effect</data>
      <data key="d10">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d11">c787461042c8456fa2987d8212b8e2fa</data>
      <data key="d12">12371</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="DIABETES TIPO 1">
      <data key="d8">4.0</data>
      <data key="d9">La diabetes tipo 1 puede estar relacionada con el hipopituitarismo debido a la disfunci&#243;n hormonal que afecta el metabolismo de la glucosa.</data>
      <data key="d10">68c1e1d1d60cf84e8ba37450cd6dc7d3</data>
      <data key="d11">cbc96e576e50471ab20e75f35959b245</data>
      <data key="d12">12372</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="HORMONA LUTEINIZANTE">
      <data key="d8">7.0</data>
      <data key="d9">La disminuci&#243;n de la hormona luteinizante es un s&#237;ntoma del hipopituitarismo, afectando la funci&#243;n reproductiva.</data>
      <data key="d10">68c1e1d1d60cf84e8ba37450cd6dc7d3</data>
      <data key="d11">1535a839537f42f0a773bdae97e624d9</data>
      <data key="d12">12373</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPITUITARISMO" target="HORMONA FOLICULOESTIMULANTE">
      <data key="d8">7.0</data>
      <data key="d9">La disminuci&#243;n de la hormona foliculoestimulante es un s&#237;ntoma del hipopituitarismo, afectando la producci&#243;n de esperma y el ciclo menstrual.</data>
      <data key="d10">68c1e1d1d60cf84e8ba37450cd6dc7d3</data>
      <data key="d11">e5ad7667e2c04b309e768fa4279d5c01</data>
      <data key="d12">12374</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONAS HIPOFISARIAS" target="MICROPROLACTINOMA">
      <data key="d8">8.0</data>
      <data key="d9">Microprolactinoma affects the levels of pituitary hormones, including prolactin</data>
      <data key="d10">a1403e657780088123382f4725789e67</data>
      <data key="d11">3bd2501bf21d481784521eb4f33b9c11</data>
      <data key="d12">12375</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONAS HIPOFISARIAS" target="HIPOFSIS">
      <data key="d8">1.0</data>
      <data key="d9">The pituitary gland is responsible for the production of various hormones, including prolactin</data>
      <data key="d10">a1403e657780088123382f4725789e67</data>
      <data key="d11">56f17c22e22340928309a278b81fd338</data>
      <data key="d12">12376</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONAS HIPOFISARIAS" target="INSUFICIENCIA SUPRARRENAL SECUNDARIA">
      <data key="d8">7.0</data>
      <data key="d9">The evaluation of hormonal deficiencies in the context of insuficiencia suprarrenal secundaria involves assessing various pituitary hormones</data>
      <data key="d10">6083387b51909347a13ed5aa1c92bb26</data>
      <data key="d11">8a7a8ac1c08242afa1192c5ba8a9c7bc</data>
      <data key="d12">12377</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONAS HIPOFISARIAS" target="HIPOGONADISMO HIPOGONADOTROPO">
      <data key="d8">8.0</data>
      <data key="d9">Las hormonas hipofisarias son cruciales en la regulaci&#243;n del hipogonadismo hipogonadotropo, ya que su producci&#243;n insuficiente puede llevar a esta condici&#243;n.</data>
      <data key="d10">df1d5ee8cb182840589e630b67691942</data>
      <data key="d11">d1396ef20ee441898481fb9efdc8f7c8</data>
      <data key="d12">12378</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GEN&#201;TICAS" target="HIPERPROLACTINEMIA">
      <data key="d8">4.0</data>
      <data key="d9">Las mutaciones en el gen del receptor de prolactina pueden asociarse con la hiperprolactinemia.</data>
      <data key="d10">2b6e6d589cd4e83086e44c77205b3740</data>
      <data key="d11">3be0c0f0911948d5b9389aa60a5ce6ae</data>
      <data key="d12">12379</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADULTOS" target="NAS">
      <data key="d8">8.0</data>
      <data key="d9">The NAS provides specific formulas for calculating energy requirements for adults over 19 years</data>
      <data key="d10">bd31c6face847551241359e37e4baa2e</data>
      <data key="d11">3282649042114ed3bde6a66706116ac1</data>
      <data key="d12">12380</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADULTOS" target="ALMID&#211;N DE MA&#205;Z">
      <data key="d8">1.0</data>
      <data key="d9">Los adultos deben incluir almid&#243;n de ma&#237;z en su dieta para asegurar un aporte adecuado de carbohidratos y energ&#237;a.</data>
      <data key="d10">658ee56030a35ceeeec05d15cfa49842</data>
      <data key="d11">0a92509939d1461498cab2ebe1f9ca1d</data>
      <data key="d12">12381</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADULTOS" target="D&#201;FICIT SECUNDARIO">
      <data key="d8">1.0</data>
      <data key="d9">Adults may experience a secondary deficit affecting sacarasa-isomaltasa activity, which can be resolved with treatment of the underlying intestinal condition.</data>
      <data key="d10">a079902e52676a05df746098c930a0e7</data>
      <data key="d11">3503b02f619f41f99e92f78c532f2e88</data>
      <data key="d12">12382</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADULTOS" target="DIETA CETOG&#201;NICA">
      <data key="d8">5.0</data>
