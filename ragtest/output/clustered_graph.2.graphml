    <node id="CALIDAD EN LA ASISTENCIA">
      <data key="d0">EVENT</data>
      <data key="d1">La calidad en la asistencia es un objetivo fundamental en la gesti&#243;n sanitaria, que busca mejorar los resultados de salud.</data>
