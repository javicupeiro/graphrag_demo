    <node id="F&#193;RMACOS COMERCIALIZADOS">
      <data key="d0">EVENT</data>
      <data key="d1">Marketed drugs refer to pharmaceutical products that are available for sale and used in the treatment of various conditions, including obesity.</data>
      <data key="d2">89ca65c4bdc30027c9c9ed1e1b442939</data>
      <data key="d3">834</data>
      <data key="d4">2</data>
