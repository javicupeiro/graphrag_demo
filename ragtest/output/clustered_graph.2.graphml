    </node>
    <node id="TABLAS DE PERCENTILES">
      <data key="d0">EVENT</data>
      <data key="d1">Percentile tables are used to assess the circumference and muscle area of the arm in different age groups, providing benchmarks for nutritional evaluation.</data>
      <data key="d2">30d5c2ac31f39f8177bec50f6b5e631b</data>
