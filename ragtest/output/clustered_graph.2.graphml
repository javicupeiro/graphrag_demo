    <edge source="DIABETES MELLITUS" target="PATOLOG&#205;AS">
      <data key="d8">6.0</data>
      <data key="d9">La diabetes mellitus es una de las patolog&#237;as que se a&#241;aden a la historia cl&#237;nica del paciente, complicando su salud general</data>
      <data key="d10">8b6f748cffc65b1521a9ee4b11f2273d</data>
