    <node id="ESCLEROSIS SIST&#201;MICA">
      <data key="d0">EVENT</data>
      <data key="d1">A chronic autoimmune disease that causes the skin and connective tissues to become thick and hard</data>
      <data key="d2">0f51b0c02b1e8200f9a98b830621c55c</data>
