    <node id="HOSPITAL UNIVERSITARIO R&#205;O HORTEGA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Hospital Universitario R&#237;o Hortega is a medical facility situated in Valladolid, Spain. It specializes in endocrinology and nutrition, providing comprehensive healthcare services in these fields.</data>
      <data key="d2">488affd4bfc1b1b4b9f5b6a054c97d80,e5ec5005272f7691eba86e2cc7240f5a</data>
