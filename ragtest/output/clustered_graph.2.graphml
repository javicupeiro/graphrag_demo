    </node>
    <node id="DIETA BAJA EN HISTAMINA">
      <data key="d0">EVENT</data>
      <data key="d1">La dieta baja en histamina se utiliza para tratar condiciones como urticaria y cefaleas cr&#243;nicas, y se recomienda para personas con intolerancias alimentarias.</data>
      <data key="d2">527c3c962d22018377b32c52e984d4e1</data>
      <data key="d3">379</data>
      <data key="d4">1</data>
