    </node>
    <node id="PANCITOPENIA">
      <data key="d0">EVENT</data>
      <data key="d1">Pancitopenia is a medical condition characterized by a reduction in red and white blood cells and platelets, often seen in patients undergoing chemotherapy.</data>
      <data key="d2">08d8220e35364eb95bacafae7dd2953b</data>
      <data key="d3">1131</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13802</data>
      <data key="d7">084b9d53769f48fc8717932c2dabd67c</data>
    </node>
    <node id="DIFICULTADES DE TOLERANCIA">
      <data key="d0">EVENT</data>
      <data key="d1">Dificultades de tolerancia refers to the challenges patients face when adapting to nutritional interventions, such as enteral or parenteral nutrition.</data>
      <data key="d2">08d8220e35364eb95bacafae7dd2953b</data>
      <data key="d3">1131</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13803</data>
