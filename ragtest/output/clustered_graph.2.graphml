    </edge>
    <edge source="MALABSORCI&#211;N" target="EII">
      <data key="d8">7.0</data>
      <data key="d9">Malabsorption is a common issue in patients with EII, affecting their ability to absorb nutrients</data>
      <data key="d10">94afd4bf40b661992e66cf7963ef236c</data>
      <data key="d11">a64b3587d9c841b98fcd7b1e0bfdeef8</data>
