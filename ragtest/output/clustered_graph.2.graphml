    <node id="HEMIT&#211;RAX">
      <data key="d0">GEO</data>
      <data key="d1">Hemit&#243;rax refers to one side of the thoracic cavity, which is relevant in the context of venous access procedures to minimize complications.</data>
      <data key="d2">3d5e0a3ef45c7ba15063791545dc4826</data>
      <data key="d3">763</data>
      <data key="d4">2</data>
