      <data key="d8">5.0</data>
      <data key="d9">Cardiac disease is a consideration in the treatment of subclinical hyperthyroidism in older adults</data>
      <data key="d10">f979a07da5d7c814ccf957629ab91cc5</data>
      <data key="d11">8ca0873d6e684ddc816a448ac4ca0c05</data>
