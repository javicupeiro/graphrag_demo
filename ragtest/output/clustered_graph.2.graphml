    <node id="R. SCHANLER">
      <data key="d0">PERSON</data>
      <data key="d1">R. Schanler is an author who contributed to the work on the nutrition of preterm infants, specifically discussing human milk composition and guidelines for infant nutrition.</data>
      <data key="d2">ea5e972294754a47333efb4c580cf15c</data>
