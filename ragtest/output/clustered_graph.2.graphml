      <data key="d10">c6fc88c88f73b50820517647aa8f4959</data>
      <data key="d11">424ac95137b34614909c130c7866b654</data>
      <data key="d12">3049</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="EQUIPO PROFESIONAL">
      <data key="d8">7.0</data>
      <data key="d9">The patient interacts with the professional team for assessment and treatment of dysphagia</data>
      <data key="d10">28e2e3a92ef4dd76af0898ae3e3df522</data>
      <data key="d11">9e3733fbb80d4478adea73ff43b40965</data>
      <data key="d12">3050</data>
      <data key="d13">2</data>
    </edge>
