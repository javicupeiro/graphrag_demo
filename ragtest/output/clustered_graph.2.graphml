    <edge source="OSTEOPENIA" target="ANOREXIA NERVOSA">
      <data key="d8">8.0</data>
      <data key="d9">Anorexia nervosa can lead to osteopenia due to inadequate nutrition and hormonal changes.</data>
      <data key="d10">203ff7a2671a44d48a1a326f469c5543</data>
      <data key="d11">b9a5bfc82c294fb8988ec0fe6b243356</data>
