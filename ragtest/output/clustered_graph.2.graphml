    </node>
    <node id="NOSOCOMIAL INFECTION">
      <data key="d0">EVENT</data>
      <data key="d1">Nosocomial infection refers to infections acquired in a hospital setting, which can pose significant risks to patients, especially those undergoing treatments like bone marrow transplantation.</data>
      <data key="d2">73d47e377c2910da3393d7bb65f80e8e</data>
      <data key="d5">0</data>
      <data key="d6">13831</data>
