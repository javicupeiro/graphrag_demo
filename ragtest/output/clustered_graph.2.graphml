      <data key="d0">EVENT</data>
      <data key="d1">La evidencia cl&#237;nica se refiere a la informaci&#243;n y datos obtenidos de investigaciones que son relevantes para la pr&#225;ctica m&#233;dica.</data>
      <data key="d2">7dbb13ddc40e2f4d060338cabf9ecea7</data>
