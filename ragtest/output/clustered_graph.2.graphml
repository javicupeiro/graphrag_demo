    <node id="GRUPO DE TRABAJO SOBRE NEOPLASIA ENDOCRINA M&#218;LTIPLE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Working Group on Multiple Endocrine Neoplasia is a group Nuria Valdes Gallego coordinated from 2011 to 2017.</data>
      <data key="d2">cc9543ac7abe58ae289e1fbd5353e219</data>
