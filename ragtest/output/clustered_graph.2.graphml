      <data key="d8">8.0</data>
      <data key="d9">M.&#170; Nuria Virgili Casas works at Hospital Universitari de Bellvitge in the Unit of Nutrition and Dietetics</data>
      <data key="d10">ba4a819ecea2015fc907ed907767f6c5</data>
      <data key="d11">d24a75ca717448a9a4d2d73f44ef6f09</data>
      <data key="d12">18614</data>
      <data key="d13">2</data>
    </edge>
