      <data key="d6">2706</data>
      <data key="d7">4647d449873a489099b097d01e2f0b95</data>
    </node>
    <node id="NUTRICI&#211;N PARENTERAL NEONATAL">
      <data key="d0">EVENT</data>
      <data key="d1">A medical practice involving the intravenous administration of nutrients to patients who cannot meet their nutritional needs through digestion, particularly in newborns</data>
      <data key="d2">61a35dc8c2c6728e1df80cb1037e6296</data>
      <data key="d3">753</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">2707</data>
      <data key="d7">d015ba1f8ebb446e8f9ffede39036fab</data>
    </node>
    <node id="ALIMENTACI&#211;N ENTERAL TOTAL">
      <data key="d0">EVENT</data>
      <data key="d1">"ALIMENTACI&#211;N ENTERAL TOTAL" refers to the practice of providing complete nutritional support through enteral feeding, particularly for infants. This approach is designed to ensure that infants receive all necessary nutrients directly through the gastrointestinal tract, thereby supporting their growth and development effectively.</data>
      <data key="d2">103ae80b955f35401aca706444999b29,61a35dc8c2c6728e1df80cb1037e6296</data>
      <data key="d3">660</data>
      <data key="d4">2</data>
