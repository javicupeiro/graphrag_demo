      <data key="d7">f91beb620f1e4d1a861df34811c116aa</data>
    </node>
    <node id="LIGHT STUDY">
      <data key="d0">EVENT</data>
      <data key="d1">The LIGHT study is a cardiovascular safety study initiated by the FDA to evaluate the safety of BN.</data>
      <data key="d2">f44811ae5b3e9dab0f295efe8842767a</data>
