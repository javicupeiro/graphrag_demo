      <data key="d7">02fe6b16bc4a49b7a85c9df0206aa13b</data>
    </node>
    <node id="EUROPEAN THYROID ASSOCIATION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The European Thyroid Association is an organization dedicated to advancing the understanding and treatment of thyroid disorders. It plays a crucial role in providing guidelines and conducting research related to these conditions. Among its contributions, the Association has developed specific guidelines for ultrasound malignancy risk stratification of thyroid nodules in adults, ensuring that healthcare professionals have the necessary resources to assess and manage thyroid health effectively.</data>
      <data key="d2">39cdf983b8de558536d2d829978daba1,68816641022021ef30afd4a52368fbf1</data>
      <data key="d5">7</data>
      <data key="d6">4607</data>
      <data key="d7">6b9df6d4c0c14f75b48109c95a092a53</data>
    </node>
