      <data key="d10">41a33a13610bbae73208f0d201781724</data>
      <data key="d11">8b366ae4a4bb4861a2292631b8ad9911</data>
      <data key="d12">18873</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ITALIA" target="NED">
      <data key="d8">11.0</data>
      <data key="d9">Italia has established regulations for NED funding since 1988, indicating a long-standing framework for managing such financial support. Additionally, NED has been the subject of study in Italia, alongside other countries, highlighting the interest and research efforts directed towards understanding NED within the Italian context.</data>
      <data key="d10">eab1daf48c7ca09f43fc115a3379cc10,f84386a9907d954b9cf46475d0d45243</data>
      <data key="d11">21cf39d677c54d1bb4851693b29d217e</data>
      <data key="d12">18874</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EW" target="D-PENICILAMINA">
      <data key="d8">18.0</data>
      <data key="d9">D-Penicillamine is a primary treatment for Wilson's disease (EW), utilized to help remove excess copper from the body and manage copper levels effectively.</data>
      <data key="d10">1dbfa8fa6421e3dd5e585baa8a10c25c,3898563966943dbfc8a0f6e84bc627b1</data>
      <data key="d11">c80e16c71930425eae7a34065e4d13ca</data>
      <data key="d12">18875</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EW" target="TRIENTINA">
      <data key="d8">8.0</data>
      <data key="d9">Trientine is also used to treat Wilson's disease (EW) and may be better tolerated than D-Penicillamine.</data>
      <data key="d10">1dbfa8fa6421e3dd5e585baa8a10c25c</data>
      <data key="d11">3ab9ea79d01b4025a8dc22a14db927cf</data>
      <data key="d12">18876</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EW" target="HEPATITIS AUTOINMUNE">
      <data key="d8">1.0</data>
      <data key="d9">Autoimmune hepatitis should be considered in the differential diagnosis of Wilson's disease (EW) due to overlapping symptoms.</data>
      <data key="d10">1dbfa8fa6421e3dd5e585baa8a10c25c</data>
      <data key="d11">2b5d66f90bda48bb8bcfa37fd34f99e5</data>
      <data key="d12">18877</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EW" target="FAMILIARES DE PRIMER GRADO">
      <data key="d8">7.0</data>
      <data key="d9">First-degree relatives of patients diagnosed with Wilson's disease (EW) should be screened for the condition due to its genetic nature.</data>
      <data key="d10">1dbfa8fa6421e3dd5e585baa8a10c25c</data>
      <data key="d11">77cb07db955e4cea8558dd6fac9917d2</data>
      <data key="d12">18878</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EW" target="INSUFICIENCIA HEP&#193;TICA AGUDA">
      <data key="d8">8.0</data>
      <data key="d9">Acute liver failure can be a complication of Wilson's disease (EW), necessitating urgent care.</data>
      <data key="d10">1dbfa8fa6421e3dd5e585baa8a10c25c</data>
      <data key="d11">d540ddc54328473f841d4553b298ba83</data>
      <data key="d12">18879</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EW" target="CUPRURIA">
      <data key="d8">1.0</data>
      <data key="d9">Cupruria is a key diagnostic criterion for Wilson's disease (EW), indicating copper metabolism issues.</data>
      <data key="d10">1dbfa8fa6421e3dd5e585baa8a10c25c</data>
      <data key="d11">86325e12668145d1b64e14d60b39341e</data>
      <data key="d12">18880</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EW" target="KAYSER-FLEISCHER RINGS">
      <data key="d8">8.0</data>
