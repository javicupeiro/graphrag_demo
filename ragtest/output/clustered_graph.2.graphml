      <data key="d12">14537</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADRENOLEUCODISTROFIA" target="CORTEX ADRENAL">
      <data key="d8">8.0</data>
      <data key="d9">Adrenoleucodistrofia affects the adrenal cortex, leading to adrenal insufficiency in patients</data>
      <data key="d10">34299d74df25d13e56cd62aab766e618</data>
      <data key="d11">c819dad64dde465d9e404d067098de62</data>
      <data key="d12">14538</data>
