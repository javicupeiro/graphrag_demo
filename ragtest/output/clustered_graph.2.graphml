    </node>
    <node id="HIPOANTREMIA GRAVE">
      <data key="d0">EVENT</data>
      <data key="d1">Severe hyponatremia is a critical condition that requires immediate medical intervention, often involving hypertonic saline.</data>
      <data key="d2">306519cca8810e0ff1c973128a75200a</data>
