      <data key="d11">dd3a7e7212d84d3e9486ec2c592b931b</data>
      <data key="d12">11468</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PERSONAS MAYORES" target="HARRIS AND BENEDICT">
      <data key="d8">5.0</data>
      <data key="d9">The Harris and Benedict equations are used to assess the energy needs of older adults</data>
      <data key="d10">12281055b260e7dc55fcaeeab7eefde6</data>
      <data key="d11">36a9a1302017469b8595f3d9a8e2b834</data>
      <data key="d12">11469</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PERSONAS MAYORES" target="TABLA 6">
      <data key="d8">1.0</data>
      <data key="d9">Table 6 outlines the dietary requirements specifically for older adults</data>
      <data key="d10">60577bdc0f4979d10ba7385bf483c344</data>
      <data key="d11">5d671d51c4c44c1e85af8a37979061e4</data>
      <data key="d12">11470</data>
