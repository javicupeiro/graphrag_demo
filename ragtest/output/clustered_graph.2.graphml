    </node>
    <node id="INHIBIDORES DE LA MONOAMINOXIDASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los inhibidores de la monoaminooxidasa (MAO) son medicamentos que pueden interactuar con la dieta baja en histamina y afectar la actividad de DAO.</data>
      <data key="d2">527c3c962d22018377b32c52e984d4e1</data>
