    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="RAPID SCREEN">
      <data key="d8">4.0</data>
      <data key="d9">Both tools are used for quick assessments of nutritional risk in various populations</data>
