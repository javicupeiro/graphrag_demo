      <data key="d0">EVENT</data>
      <data key="d1">Son cuidados paliativos dirigidos a pacientes con enfermedades cr&#243;nicas avanzadas y procesos degenerativos en fase terminal.</data>
      <data key="d2">54f3b76c0240696aa63ae60ad52b82b6</data>
