    </node>
    <node id="ALD/ARP">
      <data key="d0">EVENT</data>
      <data key="d1">The aldosterone/renin plasma activity ratio is a test performed to assess adrenal function, particularly in cases of primary hyperaldosteronism.</data>
      <data key="d2">151237aa6e4e4aaa2d1115a10ab09be0</data>
      <data key="d3">1340</data>
