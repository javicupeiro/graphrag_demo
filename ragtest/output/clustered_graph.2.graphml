      <data key="d6">8992</data>
      <data key="d7">6aec4000ca7046d5b5c0b008f8329395</data>
    </node>
    <node id="DESTETE">
      <data key="d0">EVENT</data>
      <data key="d1">Destete (weaning) is the process that further diversifies the intestinal microbiota as the child transitions to solid foods.</data>
      <data key="d2">b36b8846f109ee75806c6ea03015e5d5</data>
      <data key="d3">661</data>
