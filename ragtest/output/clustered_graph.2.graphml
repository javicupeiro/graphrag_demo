      <data key="d0">PERSON</data>
      <data key="d1">Macdonald N is a researcher involved in the study of cancer cachexia and its effects on patients.</data>
      <data key="d2">fb7b0d121f195e2a472f3d47e28ccff9</data>
      <data key="d3">1206</data>
      <data key="d4">2</data>
