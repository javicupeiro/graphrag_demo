      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ENTERITIS SEVERA">
      <data key="d8">7.0</data>
      <data key="d9">La enteritis severa inducida por radiaci&#243;n es una indicaci&#243;n para la nutrici&#243;n parenteral</data>
      <data key="d10">538970e30e9d0e758546ca1a3cf5a205</data>
      <data key="d11">bc1eb1a0bad94366924feb1d3480eb1d</data>
      <data key="d12">4889</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="F&#205;STULAS GASTROINTESTINALES">
      <data key="d8">7.0</data>
      <data key="d9">Las f&#237;stulas gastrointestinales con alto d&#233;bito pueden requerir nutrici&#243;n parenteral</data>
      <data key="d10">538970e30e9d0e758546ca1a3cf5a205</data>
      <data key="d11">19d986f5339a43bbb6c938b417c7bc0c</data>
      <data key="d12">4890</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ILEO POSTOPERATORIO">
      <data key="d8">7.0</data>
      <data key="d9">El &#237;leo postoperatorio persistente puede ser una raz&#243;n para iniciar nutrici&#243;n parenteral</data>
      <data key="d10">538970e30e9d0e758546ca1a3cf5a205</data>
      <data key="d11">985b65f53183456ba0c7d12dc19d10cd</data>
      <data key="d12">4891</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="VENAS CENTRALES">
      <data key="d8">8.0</data>
      <data key="d9">Las venas centrales son necesarias para la administraci&#243;n de soluciones de alta osmolaridad en nutrici&#243;n parenteral</data>
      <data key="d10">538970e30e9d0e758546ca1a3cf5a205</data>
      <data key="d11">e3efd115acd84b0d9c598c6f5d2d77ac</data>
      <data key="d12">4892</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="VENAS PERIF&#201;RICAS">
      <data key="d8">6.0</data>
      <data key="d9">Las venas perif&#233;ricas pueden ser utilizadas para la nutrici&#243;n parenteral, pero requieren soluciones m&#225;s diluidas</data>
      <data key="d10">538970e30e9d0e758546ca1a3cf5a205</data>
      <data key="d11">1ceb9cdb53ca4a0798e1d3d9c779958e</data>
      <data key="d12">4893</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CAT&#201;TER CENTRAL INSERTADO DE FORMA PERIF&#201;RICA">
      <data key="d8">7.0</data>
      <data key="d9">El cat&#233;ter central insertado de forma perif&#233;rica se utiliza para la administraci&#243;n de nutrici&#243;n parenteral a corto plazo</data>
      <data key="d10">538970e30e9d0e758546ca1a3cf5a205</data>
      <data key="d11">a6689210acbf4e2f97f0687dda64ffdb</data>
      <data key="d12">4894</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CAT&#201;TER VENOSO CENTRAL TUNELIZADO">
      <data key="d8">1.0</data>
      <data key="d9">El cat&#233;ter venoso central tunelizado se utiliza para la nutrici&#243;n parenteral a largo plazo, reduciendo el riesgo de infecciones</data>
      <data key="d10">538970e30e9d0e758546ca1a3cf5a205</data>
      <data key="d11">f6dca30bfd964abab7ce8a247722ebdc</data>
      <data key="d12">4895</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CAT&#201;TERES CENTRALES">
      <data key="d8">8.0</data>
      <data key="d9">Los cat&#233;teres centrales son utilizados para la administraci&#243;n de nutrici&#243;n parenteral en pacientes</data>
      <data key="d10">ff844169c2b512733f5bde26e6f1ed32</data>
      <data key="d11">63a31e442b5248048ce2a9286005afde</data>
      <data key="d12">4896</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="COMPLICACIONES">
      <data key="d8">8.0</data>
      <data key="d9">La nutrici&#243;n parenteral puede llevar a complicaciones como infecciones y trombosis venosa</data>
      <data key="d10">ff844169c2b512733f5bde26e6f1ed32</data>
      <data key="d11">ffd054606b934cdbacd275cb412ea285</data>
      <data key="d12">4897</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CAT&#201;TER INTRAVASCULAR">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional therapy often requires the use of an intravascular catheter for administration.</data>
      <data key="d10">61eea56f443c7bb2509edd6f42af2643</data>
      <data key="d11">e6beb8792cd14c239df1cdc74edba294</data>
      <data key="d12">4898</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="KUWAHARA T">
      <data key="d8">1.0</data>
      <data key="d9">Kuwahara T's research focuses on aspects relevant to the administration of NUTRICI&#211;N PARENTERAL</data>
      <data key="d10">4ce6342fdfe4419826c1ab2f84c56247</data>
      <data key="d11">6a7881e9ea5c41a8a6806978758bf431</data>
      <data key="d12">4899</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ENFERMERAS ESPECIALIZADAS">
      <data key="d8">8.0</data>
      <data key="d9">Enfermeras especializadas are responsible for the care and monitoring of patients receiving NUTRICI&#211;N PARENTERAL</data>
      <data key="d10">4ce6342fdfe4419826c1ab2f84c56247</data>
      <data key="d11">75ef60b0414c401cbfd79ee182ffbe55</data>
      <data key="d12">4900</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CATABOLISMO PROTEICO">
      <data key="d8">6.0</data>
      <data key="d9">CATABOLISMO PROTEICO can influence the effectiveness and requirements of NUTRICI&#211;N PARENTERAL</data>
      <data key="d10">4ce6342fdfe4419826c1ab2f84c56247</data>
      <data key="d11">9f45d11dfc9b4ad586c32b14c38bea1e</data>
      <data key="d12">4901</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="GRUPO ITALIANO COLABORATIVO">
      <data key="d8">7.0</data>
      <data key="d9">The Italian group compared parenteral nutrition with immunomodulatory formulas in their study</data>
      <data key="d10">9e4c5851293c18ef6b304ff6293b0be5</data>
      <data key="d11">0281bdade6ce493dbc8bd5db3dcc24d4</data>
      <data key="d12">4902</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">14.0</data>
      <data key="d9">NUTRICI&#211;N PARENTERAL is an essential aspect of NUTRICI&#211;N PEDI&#193;TRICA, particularly for children who are unable to obtain nutrition through conventional methods. In cases where enteral nutrition is inadequate, parenteral nutrition becomes necessary to provide the required nutritional support for these young patients.</data>
      <data key="d10">b789dfd7a5aa36fac33c5c881a1a4981,ec4fd77add427ab49ea4b8687b94b263</data>
      <data key="d11">57e3403a91774df4aa49d9d82a6c3675</data>
      <data key="d12">4903</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="HOSPITAL UNIVERSITARIO 12 DE OCTUBRE">
      <data key="d8">7.0</data>
      <data key="d9">Hospital Universitario 12 de Octubre provides parenteral nutrition services for children</data>
      <data key="d10">57a5157c4312ac09073e72ad7789ad7c</data>
      <data key="d11">5c6b05910b384798ae81317d1a4b6269</data>
      <data key="d12">4904</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="NUTRICI&#211;N PARENTERAL EN EL PACIENTE PEDI&#193;TRICO">
      <data key="d8">6.0</data>
      <data key="d9">Nutritional therapy for pediatric patients is a specific application of parenteral nutrition</data>
      <data key="d10">57a5157c4312ac09073e72ad7789ad7c</data>
      <data key="d11">a7f613987ed749e898b890cde5033220</data>
      <data key="d12">4905</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CUIDADOS INTENSIVOS">
      <data key="d8">7.0</data>
      <data key="d9">Nutritional support is often provided in intensive care units for critically ill patients</data>
      <data key="d10">cd63370bdd798f0b060b047dc29056ae</data>
      <data key="d11">701d883cb24349afb20c8f96f403ef3a</data>
      <data key="d12">4906</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="RECI&#201;N NACIDOS PRET&#201;RMINO">
      <data key="d8">9.0</data>
      <data key="d9">Preterm newborns may require the initiation of parenteral nutrition on their first day of life if they cannot meet their energy requirements</data>
      <data key="d10">cd63370bdd798f0b060b047dc29056ae</data>
      <data key="d11">cc11686fd27e4e4d807e33e9cb6eee9d</data>
      <data key="d12">4907</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ATRESIA ILEAL">
      <data key="d8">8.0</data>
      <data key="d9">Ileal atresia can lead to short bowel syndrome, necessitating parenteral nutrition for affected infants</data>
      <data key="d10">cd63370bdd798f0b060b047dc29056ae</data>
      <data key="d11">2ac408181c564a22babc7cf028d333e0</data>
      <data key="d12">4908</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="SOLUCIONES NUTRICIONALES">
      <data key="d8">7.0</data>
      <data key="d9">Nutritional solutions are essential components of parenteral nutrition, providing necessary nutrients to patients</data>
      <data key="d10">cd63370bdd798f0b060b047dc29056ae</data>
      <data key="d11">87bfe144b4854ab9b93670769bb9dcaf</data>
      <data key="d12">4909</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="EQUIPOS DE SOPORTE NUTRICIONAL">
      <data key="d8">1.0</data>
      <data key="d9">Nutritional support teams play a crucial role in the administration and monitoring of parenteral nutrition</data>
      <data key="d10">cd63370bdd798f0b060b047dc29056ae</data>
      <data key="d11">aeb1bb2a29c842288ad244818a8545e1</data>
      <data key="d12">4910</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="PACIENTE PEDI&#193;TRICO">
      <data key="d8">9.0</data>
      <data key="d9">La nutrici&#243;n parenteral es un tratamiento utilizado espec&#237;ficamente para pacientes pedi&#225;tricos que no pueden alimentarse adecuadamente.</data>
      <data key="d10">79dc467f42c611bc9f285c95a6c6ff62</data>
      <data key="d11">5354f4d8322040589ab5d38327013ea8</data>
      <data key="d12">4911</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ENFERMEDAD DIGESTIVA">
      <data key="d8">7.0</data>
      <data key="d9">Las enfermedades digestivas son una de las principales indicaciones para el uso de nutrici&#243;n parenteral en pediatr&#237;a.</data>
      <data key="d10">79dc467f42c611bc9f285c95a6c6ff62</data>
      <data key="d11">ad7baf6a6ca04136b9bea1682b5fecc1</data>
      <data key="d12">4912</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ENFERMEDAD EXTRADIGESTIVA">
      <data key="d8">1.0</data>
      <data key="d9">Las enfermedades extradigestivas tambi&#233;n pueden requerir nutrici&#243;n parenteral, ampliando su uso en pediatr&#237;a.</data>
      <data key="d10">79dc467f42c611bc9f285c95a6c6ff62</data>
      <data key="d11">397cd635b8934ad6aa9a50592e6d9d29</data>
      <data key="d12">4913</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="AMERICAN SOCIETY FOR PARENTERAL AND ENTERAL NUTRITION">
      <data key="d8">8.0</data>
      <data key="d9">ASPEN provides guidelines for the practice of parenteral nutrition, particularly in pediatric patients</data>
      <data key="d10">2d14f6773b107ec9a872245c32ae0a94</data>
      <data key="d11">ba48df83924e4f348026eea0869e9f7d</data>
      <data key="d12">4914</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="SCHOFIELD">
      <data key="d8">7.0</data>
      <data key="d9">The Schofield formula is used to estimate energy requirements in parenteral nutrition</data>
      <data key="d10">2d14f6773b107ec9a872245c32ae0a94</data>
      <data key="d11">be49ea0603d84f4d9a8fe47bddc80407</data>
      <data key="d12">4915</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ENERG&#205;A TOTAL DIARIA">
      <data key="d8">8.0</data>
      <data key="d9">The total daily energy intake is a critical component of parenteral nutrition calculations</data>
      <data key="d10">2d14f6773b107ec9a872245c32ae0a94</data>
      <data key="d11">6d00a1a3ca8a43ada6b93d4c0aa95bbf</data>
      <data key="d12">4916</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CALOR&#205;METR&#205;A INDIRECTA">
      <data key="d8">7.0</data>
      <data key="d9">Indirect calorimetry is recommended for accurately assessing energy needs in patients requiring parenteral nutrition</data>
      <data key="d10">2d14f6773b107ec9a872245c32ae0a94</data>
      <data key="d11">5ef33ab98ddc48c49643f7fc6f51a61b</data>
      <data key="d12">4917</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="OBESIDAD">
      <data key="d8">6.0</data>
      <data key="d9">Obesity complicates the calculation of nutritional requirements, particularly in the context of parenteral nutrition</data>
      <data key="d10">2d14f6773b107ec9a872245c32ae0a94</data>
      <data key="d11">16d6e9e986e44f66b9823b580d253cba</data>
      <data key="d12">4918</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="REQUERIMIENTOS DE PROTE&#205;NA">
      <data key="d8">8.0</data>
      <data key="d9">Protein requirements must be calculated first to ensure proper nutritional support in parenteral nutrition</data>
      <data key="d10">2d14f6773b107ec9a872245c32ae0a94</data>
      <data key="d11">5b0d9299f73543c498fa6482ce9a5009</data>
      <data key="d12">4919</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CALOR&#205;AS NO PROTEICAS">
      <data key="d8">7.0</data>
      <data key="d9">The balance of non-protein calories is essential in the formulation of parenteral nutrition</data>
      <data key="d10">2d14f6773b107ec9a872245c32ae0a94</data>
      <data key="d11">6c714d98a0944abf80acbd7892f9f266</data>
      <data key="d12">4920</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="FRACASO INTESTINAL">
      <data key="d8">1.0</data>
      <data key="d9">Parenteral nutrition is often necessary for patients suffering from intestinal failure to ensure adequate nutrition</data>
      <data key="d10">2d14f6773b107ec9a872245c32ae0a94</data>
      <data key="d11">639c310b97c245daa513f5a76d05e94b</data>
      <data key="d12">4921</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="OMEGAVEN">
      <data key="d8">8.0</data>
      <data key="d9">Omegaven is used in parenteral nutrition to treat liver disease in patients, particularly those with short bowel syndrome</data>
      <data key="d10">a9268f98da988e7f94a3faf7bc7627c7</data>
      <data key="d11">552396d8445440dfb8129c4d38746b59</data>
      <data key="d12">4922</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CARNITINA">
      <data key="d8">5.0</data>
      <data key="d9">Carnitine is often considered for inclusion in parenteral nutrition solutions to aid in lipid clearance</data>
      <data key="d10">a9268f98da988e7f94a3faf7bc7627c7</data>
      <data key="d11">1efd833b23544912b1608c66c738edc8</data>
      <data key="d12">4923</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="RECI&#201;N NACIDO PRET&#201;RMINO">
      <data key="d8">9.0</data>
      <data key="d9">Preterm newborns often require parenteral nutrition due to their inability to feed orally</data>
      <data key="d10">a9268f98da988e7f94a3faf7bc7627c7</data>
      <data key="d11">51c73e20cac1405683044ea29873e13f</data>
      <data key="d12">4924</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="&#193;CIDOS GRASOS ESENCIALES">
      <data key="d8">1.0</data>
      <data key="d9">Essential fatty acids must be included in parenteral nutrition to prevent deficiencies in patients</data>
      <data key="d10">a9268f98da988e7f94a3faf7bc7627c7</data>
      <data key="d11">b71704276fcf4f92824be6c6c64d9efd</data>
      <data key="d12">4925</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="INTRALIPID">
      <data key="d8">8.0</data>
      <data key="d9">Intralipid is used in parenteral nutrition to provide essential fatty acids to patients</data>
      <data key="d10">a9268f98da988e7f94a3faf7bc7627c7</data>
      <data key="d11">3269c3a9f2fc4de18d8ed7d097322db3</data>
      <data key="d12">4926</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="CLINOLEIC">
      <data key="d8">8.0</data>
      <data key="d9">Clinoleic is utilized in parenteral nutrition to supply essential fatty acids and support patient health</data>
      <data key="d10">a9268f98da988e7f94a3faf7bc7627c7</data>
      <data key="d11">3bcd1afb49d9438f99cfd6c800940612</data>
      <data key="d12">4927</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="LIPOPLUS">
