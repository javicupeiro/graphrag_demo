      <data key="d7">53c8b49ac65c4e7d834c8a5893f553a1</data>
    </node>
    <node id="CANCER MANAGEMENT">
      <data key="d0">EVENT</data>
      <data key="d1">Cancer management refers to the comprehensive approach to treating cancer, including surgery, chemotherapy, radiation, and supportive care.</data>
