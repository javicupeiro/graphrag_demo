      <data key="d12">144</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DISFAGIA OROFAR&#205;NGEA" target="EXCURSI&#211;N LAR&#205;NGEA">
      <data key="d8">7.0</data>
      <data key="d9">Laryngeal excursion is critical in managing oropharyngeal dysphagia and ensuring airway protection</data>
      <data key="d10">eff38537223691079c4930d76cbb7427</data>
      <data key="d11">c7ac890017194ecfafd3a34f544d3493</data>
      <data key="d12">145</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DISFAGIA OROFAR&#205;NGEA" target="ALTERACIONES DE LA SEGURIDAD">
      <data key="d8">1.0</data>
      <data key="d9">Alterations in safety are a key concern in the management of oropharyngeal dysphagia</data>
