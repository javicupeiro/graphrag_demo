    <edge source="DIABETES 2" target="CETOACIDOSIS DIAB&#201;TICA">
      <data key="d8">8.0</data>
      <data key="d9">Diabetic ketoacidosis is a serious complication that can occur in individuals with Diabetes 2 due to poor glycemic control</data>
      <data key="d10">afe0f4f37815c175f0faff06eb24a256</data>
      <data key="d11">7df129fb0c9e4c95b6c417f34b845a9c</data>
      <data key="d12">13047</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES 2" target="CETOACIDOSIS">
      <data key="d8">8.0</data>
      <data key="d9">Cetoacidosis is a severe complication that arises from uncontrolled Diabetes 2, leading to significant metabolic disturbances</data>
      <data key="d10">afe0f4f37815c175f0faff06eb24a256</data>
      <data key="d11">e75f3f3da2ef4df4b444faee4a7848d5</data>
      <data key="d12">13048</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES 2" target="CAD">
      <data key="d8">8.0</data>
      <data key="d9">Diabetes 2 can lead to the development of CAD due to insulin deficiency and hormonal imbalances</data>
      <data key="d10">bcded135629c889cb0a10ae968743582</data>
      <data key="d11">05154fa3f1e04d6ab372e26bbacd0666</data>
      <data key="d12">13049</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES 2" target="SHH">
      <data key="d8">8.0</data>
      <data key="d9">Diabetes 2 can result in SHH as a severe complication when blood sugar levels become critically high</data>
      <data key="d10">bcded135629c889cb0a10ae968743582</data>
      <data key="d11">db069d0c897141a2b74783e1c3484a19</data>
      <data key="d12">13050</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES 2" target="CATECHOLAMINES">
      <data key="d8">6.0</data>
      <data key="d9">Catecholamines are released in response to stress and can exacerbate hyperglycemia in diabetes</data>
      <data key="d10">bcded135629c889cb0a10ae968743582</data>
      <data key="d11">763652c8f60b4b3e98f29f90e5da59d3</data>
      <data key="d12">13051</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES 2" target="GROWTH HORMONE">
      <data key="d8">1.0</data>
      <data key="d9">Growth hormone can affect glucose metabolism and contribute to insulin resistance in diabetes</data>
      <data key="d10">bcded135629c889cb0a10ae968743582</data>
      <data key="d11">f81af1b2016a4373a16b3ee6f22ec19c</data>
      <data key="d12">13052</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES 2" target="GLUCONEOGENESIS">
      <data key="d8">7.0</data>
      <data key="d9">Gluconeogenesis is a process that can be excessively activated in diabetes, contributing to high blood sugar levels</data>
      <data key="d10">bcded135629c889cb0a10ae968743582</data>
      <data key="d11">a293b81c0c574b88a92cc7a24f1794e1</data>
      <data key="d12">13053</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES 2" target="GLYCOGENOLYSIS">
      <data key="d8">7.0</data>
      <data key="d9">Glycogenolysis can occur in diabetes when insulin levels are low, leading to increased blood glucose levels</data>
      <data key="d10">bcded135629c889cb0a10ae968743582</data>
      <data key="d11">ed84ad20ec474a319edbcf3caa6b2e2e</data>
      <data key="d12">13054</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES 2" target="GLP-1">
      <data key="d8">8.0</data>
