    </edge>
    <edge source="DIN" target="AQUAPORINA-2">
      <data key="d8">8.0</data>
      <data key="d9">Aquaporin-2 is essential for kidney function, and its dysfunction leads to nephrogenic diabetes insipidus.</data>
