      <data key="d7">ecfee86598504c8bb35ddc4ebf88ba7a</data>
    </node>
    <node id="MOLTHERAPY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Molecular Therapy is a journal that publishes research on gene therapy and related fields, including treatments for metabolic disorders.</data>
      <data key="d2">9783830959445135c718dc21daa0a46b</data>
