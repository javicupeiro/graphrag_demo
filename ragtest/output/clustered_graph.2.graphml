    </node>
    <node id="COSTES M&#193;S ELEVADOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los costes m&#225;s elevados se refieren a los gastos adicionales que pueden surgir de la rotaci&#243;n de alimentos en la alimentaci&#243;n hospitalaria.</data>
      <data key="d2">4de75db0e24f0f89d890287e2a3f3dcc</data>
