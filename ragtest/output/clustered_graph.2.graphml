    </node>
    <node id="GENES AIP Y PRKAR1A">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los genes AIP y PRKAR1A est&#225;n implicados en la patog&#233;nesis de los adenomas hipofisarios y pueden influir en su desarrollo.</data>
      <data key="d2">b18ef5c018c100e1582224fe82f03626</data>
      <data key="d3">1321</data>
