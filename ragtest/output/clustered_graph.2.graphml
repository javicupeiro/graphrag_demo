      <data key="d7">2cc9643b6913414e92825580bdf3b2d6</data>
    </node>
    <node id="ECOLOGICAL FARMING">
      <data key="d0">EVENT</data>
      <data key="d1">Ecological farming is a method of agriculture that avoids synthetic chemicals and respects natural growth rhythms.</data>
      <data key="d2">d3ffabc46da9b238994a7769ffc8f6b7</data>
      <data key="d3">134</data>
      <data key="d4">1</data>
