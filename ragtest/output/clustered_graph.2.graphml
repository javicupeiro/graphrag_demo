      <data key="d6">2722</data>
      <data key="d7">89fd8d205f014f498441edbdee5f7a21</data>
    </node>
    <node id="HUMEDAD RELATIVA">
      <data key="d0">EVENT</data>
      <data key="d1">Relative humidity levels between 80-85% are crucial for the care of neonates in incubators.</data>
      <data key="d2">15ffbfba2decfecb69a26bcb1e4bd898</data>
      <data key="d3">627</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">2723</data>
      <data key="d7">2d19d1b50dc049a0a0288b264392a540</data>
    </node>
    <node id="OLIGURIA">
      <data key="d0">EVENT</data>
      <data key="d1">Oliguria is a condition characterized by low urine output, which is a concern in the management of neonates.</data>
      <data key="d2">15ffbfba2decfecb69a26bcb1e4bd898</data>
      <data key="d3">627</data>
      <data key="d4">2</data>
