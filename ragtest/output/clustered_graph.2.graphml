      <data key="d11">e8e05007465146678f399804325cb75b</data>
      <data key="d12">4185</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HOSPITAL GENERAL DE TORONTO" target="DETSKY">
      <data key="d8">1.0</data>
      <data key="d9">Detsky developed the subjective global assessment method at the Hospital General de Toronto in the 1980s</data>
      <data key="d10">2ae5ac5b335a00d15c090777da386817</data>
      <data key="d11">4040216aa44347fc89396e2c04e76359</data>
      <data key="d12">4186</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DETSKY" target="BAKER">
      <data key="d8">7.0</data>
