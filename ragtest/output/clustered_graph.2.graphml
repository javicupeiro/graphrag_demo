    <node id="PRUEBAS INSTRUMENTALES">
      <data key="d0">EVENT</data>
      <data key="d1">Instrumental tests are diagnostic procedures used to assess swallowing function and identify dysphagia.</data>
      <data key="d2">0bff3417518c19ae80d20de8150be58b</data>
      <data key="d3">914</data>
      <data key="d4">2</data>
