      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">2031</data>
      <data key="d7">36036e58512c4223857506082e1bf8b1</data>
    </node>
    <node id="TEMPERATURA CORPORAL">
      <data key="d0">EVENT</data>
      <data key="d1">La temperatura corporal se mide para detectar complicaciones infecciosas en el paciente que recibe nutrici&#243;n parenteral.</data>
      <data key="d2">5cf1703fd601b27dd0ebda9f20cb3259</data>
