    </node>
    <node id="PRESION ARTERIAL">
      <data key="d0">EVENT</data>
      <data key="d1">Elevated blood pressure is a common consequence of obesity, linked to increased aldosterone and sympathetic nervous system activity.</data>
      <data key="d2">c575e742f54d5f3f674a8e52ad041221</data>
      <data key="d3">1390</data>
