    <node id="LEPRECHAUNISMO">
      <data key="d0">EVENT</data>
      <data key="d1">Leprechaunism is a congenital syndrome characterized by extreme insulin resistance and severe growth retardation due to mutations in the insulin receptor gene.</data>
      <data key="d2">ac89fcaa7dcce835c0d5b9ed9ce94cea</data>
      <data key="d5">2</data>
      <data key="d6">4144</data>
