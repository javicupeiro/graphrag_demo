      <data key="d11">6733a73a03b641da9e2afb82b1991649</data>
      <data key="d12">8330</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MAGNESIO" target="DASH DIET">
      <data key="d8">6.0</data>
      <data key="d9">The DASH diet is rich in magnesium, which helps reduce calcium oxalate saturation in the urine.</data>
      <data key="d10">57d928013f61475d356dcec181cc0c6c</data>
      <data key="d11">4736bc2e94464b149ff6893ccc028ee9</data>
