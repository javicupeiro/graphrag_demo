    <node id="MODELO FRAIL">
      <data key="d0">EVENT</data>
      <data key="d1">El modelo FRAIL es uno de los modelos utilizados para evaluar la fragilidad en ancianos.</data>
      <data key="d2">00a918807f0c6568ea1d9f0c41f1ad49</data>
