    </node>
    <node id="DESNATURALIZACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">DESNATURALIZACI&#211;N is the process by which proteins lose their natural structure due to factors like temperature, impacting their functionality in nutrition products.</data>
      <data key="d2">dc38a37c30b175667931b84a9c9103bb</data>
      <data key="d3">670</data>
