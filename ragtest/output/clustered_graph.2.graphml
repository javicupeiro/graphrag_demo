    <node id="NUTRICI&#211;N PARENTERAL PARCIAL">
      <data key="d0">EVENT</data>
      <data key="d1">Nutrici&#243;n parenteral parcial (NPP) is a form of parenteral nutrition that provides part of a patient's nutritional needs.</data>
