    </node>
    <node id="VENOUS CATHETERIZATION">
      <data key="d0">EVENT</data>
      <data key="d1">Venous catheterization is the process of inserting a catheter into a vein for medical purposes, such as medication delivery or fluid administration.</data>
      <data key="d2">3d5e0a3ef45c7ba15063791545dc4826</data>
      <data key="d3">763</data>
      <data key="d4">2</data>
