    </node>
    <node id="DIETARY PHOSPHORUS INTAKE">
      <data key="d0">EVENT</data>
      <data key="d1">Dietary phosphorus intake is critical for patients with chronic kidney disease and is often monitored.</data>
      <data key="d2">08bc4a83d18482b48f5bbef4fbf316f3</data>
