    </node>
    <node id="AGREGACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">AGREGACI&#211;N refers to the clumping of denatured proteins, which can affect the quality of clinical nutrition products.</data>
      <data key="d2">dc38a37c30b175667931b84a9c9103bb</data>
      <data key="d3">670</data>
      <data key="d4">2</data>
