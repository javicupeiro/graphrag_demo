      <data key="d9">Quilomicrones are composed primarily of triglycerides, which they transport</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">fc9fc49d37cd4bfcb1e34d5a0106f768</data>
      <data key="d12">15477</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUILOMICRONES" target="LIPOPROTE&#205;NA LIPASA">
      <data key="d8">8.0</data>
      <data key="d9">La lipoprote&#237;na lipasa act&#250;a sobre los quilomicrones para hidrolizar los triglic&#233;ridos que transportan</data>
      <data key="d10">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d11">107f0fbf9acf4ba891f0c5914eadfb98</data>
      <data key="d12">15478</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUILOMICRONES" target="HIDROLIZADAS">
      <data key="d8">7.0</data>
      <data key="d9">The hydrolysis of chylomicrons by LPL releases free fatty acids for tissue use</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">a24f767042614f28ba4c20ec3dc94bce</data>
      <data key="d12">15479</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUILOMICRONES" target="SISTEMA LINF&#193;TICO">
      <data key="d8">6.0</data>
      <data key="d9">Los quilomicrones son transportados a trav&#233;s del sistema linf&#225;tico antes de entrar en el sistema circulatorio.</data>
      <data key="d10">0f2aa9d202fbabe2b0f310000e6987e7</data>
      <data key="d11">3249c967d92a42bb8438a0d6501515ad</data>
      <data key="d12">15480</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUILOMICRONES" target="TCM">
      <data key="d8">8.0</data>
      <data key="d9">TCM are absorbed and transported by quilomicrones in the lymphatic system</data>
      <data key="d10">3c2bb3d9d6534668e58f571710c9bb02</data>
      <data key="d11">18b7b7363b534fcfbfe0e501e2aa0bb2</data>
      <data key="d12">15481</data>
      <data key="d13">2</data>
    </edge>
    <edge source="APO B-100" target="LDLS">
      <data key="d8">8.0</data>
      <data key="d9">Apo B-100 is the main apolipoprotein of LDL, crucial for its function in cholesterol transport</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">c4c5dcc4f915430ebf595cb267c36722</data>
      <data key="d12">15482</data>
      <data key="d13">2</data>
    </edge>
    <edge source="APO B-100" target="VLDL">
      <data key="d8">8.0</data>
      <data key="d9">Apo B-100 is a key component of VLDL, facilitating its assembly and secretion</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">9c57e8426f48491d972c23e83c9bf5c2</data>
      <data key="d12">15483</data>
      <data key="d13">2</data>
    </edge>
    <edge source="APO B-100" target="APOLIPOPROTEINAS">
      <data key="d8">8.0</data>
      <data key="d9">Apo B-100 is an apolipoprotein that is a key component of LDL and VLDL</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">9a685d8dd9d5474198b2a68748eb13ee</data>
      <data key="d12">15484</data>
      <data key="d13">2</data>
    </edge>
    <edge source="APO B-100" target="LDL">
      <data key="d8">9.0</data>
      <data key="d9">Apo B-100 is a key component of LDL, essential for its metabolism and recognition by receptors</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">01f00234c4b04d4b8c97752d15a3eb58</data>
      <data key="d12">15485</data>
      <data key="d13">2</data>
    </edge>
    <edge source="APO B-48" target="APOLIPOPROTEINAS">
      <data key="d8">8.0</data>
      <data key="d9">Apo B-48 is an apolipoprotein that is a key component of quilomicrones</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">a2f8027bba984c3b847cf4cb4e842a19</data>
      <data key="d12">15486</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTEINA LIPASA (LPL)" target="VLDL">
      <data key="d8">9.0</data>
      <data key="d9">LPL hydrolyzes VLDL to release fatty acids for use and storage</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">ac85615a66524f54bb010989bbe2279b</data>
      <data key="d12">15487</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTEINA LIPASA (LPL)" target="TEJIDO ADIPOSO">
      <data key="d8">8.0</data>
      <data key="d9">LPL releases fatty acids to adipose tissue for storage</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">f1a9dc25ee3a4ba4a5755059800bf722</data>
      <data key="d12">15488</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTEINA LIPASA (LPL)" target="MUSCULO ESQUELETICO">
      <data key="d8">8.0</data>
      <data key="d9">LPL releases fatty acids to skeletal muscle for utilization</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">afeca52c4bdf4bf0ada44814fb04424e</data>
      <data key="d12">15489</data>
      <data key="d13">2</data>
    </edge>
    <edge source="IDLS" target="VLDL">
      <data key="d8">7.0</data>
      <data key="d9">IDL is formed from the catabolism of VLDL during lipid metabolism</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">22e7e21a5d2a42c7a3a7f6815c7bf29b</data>
      <data key="d12">15490</data>
      <data key="d13">2</data>
    </edge>
    <edge source="IDLS" target="LDLS">
      <data key="d8">7.0</data>
      <data key="d9">LDL is the final product of the metabolic pathway that includes IDL</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">b30199acb77e48748ba4d7a0f6a300ff</data>
      <data key="d12">15491</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LDLS" target="LIPOPROTEINAS">
      <data key="d8">8.0</data>
      <data key="d9">LDLs are lipoproteins that transport cholesterol to cells throughout the body</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">63059aebafdc439ab844cce8a05147d1</data>
      <data key="d12">15492</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HDLS" target="VLDL">
      <data key="d8">1.0</data>
      <data key="d9">HDL is synthesized from the catabolism of VLDL</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">6880d85cdb6a4f20b95c1019cf5abf08</data>
      <data key="d12">15493</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HDLS" target="LIPOPROTEINAS">
      <data key="d8">8.0</data>
      <data key="d9">HDLs are lipoproteins that help remove cholesterol from the bloodstream</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">3f0ce7f6c4f84d08a942b0c71eb2d0a0</data>
      <data key="d12">15494</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VLDL" target="LIPOPROTEINAS">
      <data key="d8">8.0</data>
      <data key="d9">VLDL is another type of lipoprotein that carries triglycerides from the liver to tissues</data>
      <data key="d10">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d11">f787e884163e4998923978128d413a24</data>
      <data key="d12">15495</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VLDL" target="LIPOPROTE&#205;NA LIPASA">
      <data key="d8">8.0</data>
      <data key="d9">La lipoprote&#237;na lipasa tambi&#233;n act&#250;a sobre las VLDL para facilitar la hidr&#243;lisis de triglic&#233;ridos</data>
      <data key="d10">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d11">c02bd7157da24e10b919ae95b93b46f4</data>
      <data key="d12">15496</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VLDL" target="IDL">
      <data key="d8">8.0</data>
      <data key="d9">IDL is formed from the metabolism of VLDL, indicating a direct metabolic relationship</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">6328b0527f9d4ac3a375427dda55cfaf</data>
      <data key="d12">15497</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VLDL" target="LPL">
      <data key="d8">7.0</data>
      <data key="d9">LPL hydrolyzes triglycerides in VLDL, facilitating the release of free fatty acids</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">bc7b14c2b6cb475bb09ae0f54b678a0a</data>
      <data key="d12">15498</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRIGLICERIDOS" target="LIPIDS">
      <data key="d8">6.0</data>
      <data key="d9">Trigliceridos are a form of lipids that are important for energy storage and are included in lipid solutions for nutritional support.</data>
      <data key="d10">bb7584256e051f1c3d8cb13502ade155</data>
      <data key="d11">af603a4ffdaa47928406cad1ebdd9745</data>
      <data key="d12">15499</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERTRIGLYCERIDEMIA" target="LIPOPROTE&#205;NA LIPASA">
      <data key="d8">1.0</data>
      <data key="d9">Lipoprotein lipase is involved in the metabolism of triglycerides, which is relevant to the condition of hypertriglyceridemia</data>
      <data key="d10">9312fdfba5d3f79b95c5e6af38ced009</data>
      <data key="d11">53fc76ab70914646bb1ab3e18d08741b</data>
      <data key="d12">15500</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERTRIGLYCERIDEMIA" target="CARDIOVASCULAR RISK">
      <data key="d8">9.0</data>
      <data key="d9">Hypertriglyceridemia is a condition that increases the risk of cardiovascular diseases</data>
      <data key="d10">e1766b4a9f6cff776650a29195cee9fc</data>
      <data key="d11">9485fb6a7f064214be309db18f388460</data>
      <data key="d12">15501</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTE&#205;NA LIPASA" target="APO C-II">
      <data key="d8">9.0</data>
      <data key="d9">La apolipoprote&#237;na C-II es necesaria para la activaci&#243;n de la lipoprote&#237;na lipasa, lo que afecta el metabolismo de los triglic&#233;ridos</data>
      <data key="d10">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d11">e982fae0e97e457c927e5a6ccc87e3f1</data>
      <data key="d12">15502</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTE&#205;NA LIPASA" target="HEPATOMEGALIA">
      <data key="d8">7.0</data>
      <data key="d9">El d&#233;ficit de lipoprote&#237;na lipasa puede llevar a hepatomegalia como una de sus manifestaciones</data>
      <data key="d10">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d11">e148b2eb91154080846038e7eb0caf7c</data>
      <data key="d12">15503</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTE&#205;NA LIPASA" target="ESPLENOMEGALIA">
      <data key="d8">7.0</data>
      <data key="d9">El d&#233;ficit de lipoprote&#237;na lipasa puede llevar a esplenomegalia como una de sus manifestaciones</data>
      <data key="d10">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d11">26f0b8a086ac43c78947e2501fec98eb</data>
      <data key="d12">15504</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTE&#205;NA LIPASA" target="DISLIPIDEMIAS">
      <data key="d8">8.0</data>
      <data key="d9">El d&#233;ficit de lipoprote&#237;na lipasa es un tipo de dislipidemia que afecta los niveles de l&#237;pidos en la sangre</data>
      <data key="d10">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d11">e5a691af41574028973db6d7b3013f7d</data>
      <data key="d12">15505</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTE&#205;NA LIPASA" target="QUILOMICRONEMIA">
      <data key="d8">7.0</data>
      <data key="d9">La quilomicronemia puede resultar de un d&#233;ficit de lipoprote&#237;na lipasa, que impide la correcta metabolizaci&#243;n de los quilomicrones</data>
      <data key="d10">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d11">e6dd27d6d4e14e69ba60069ed1f59bd9</data>
      <data key="d12">15506</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LIPOPROTE&#205;NA LIPASA" target="APO V">
      <data key="d8">1.0</data>
      <data key="d9">La apolipoprote&#237;na V tiene un papel en la uni&#243;n de VLDL y quilomicrones con lipoprote&#237;na lipasa, afectando su metabolismo</data>
      <data key="d10">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d11">836c6249966e46b69db31e96e7911075</data>
      <data key="d12">15507</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CITOCROMO P450" target="GRISEOFULVINA">
      <data key="d8">6.0</data>
      <data key="d9">Cytochrome P450 metabolizes griseofulvina in the liver</data>
      <data key="d10">18d237ccee6cf99bff4690087156025a</data>
      <data key="d11">e17e4a946054440596a31ecf439b76d1</data>
      <data key="d12">15508</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CITOCROMO P450" target="HALOFANTRINA">
      <data key="d8">6.0</data>
      <data key="d9">Cytochrome P450 metabolizes halofantrina in the liver</data>
      <data key="d10">18d237ccee6cf99bff4690087156025a</data>
      <data key="d11">009091a1af4b4beea137b4baa3395f3e</data>
      <data key="d12">15509</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CITOCROMO P450" target="FURANOCUMARINAS">
      <data key="d8">5.0</data>
      <data key="d9">Furanocoumarins inhibit CYP3A4, affecting the metabolism of drugs</data>
      <data key="d10">18d237ccee6cf99bff4690087156025a</data>
      <data key="d11">257d2644d2a348f79ddd6806a06847cb</data>
      <data key="d12">15510</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MIOPAT&#205;A" target="TRASTORNOS METAB&#211;LICOS">
      <data key="d8">7.0</data>
      <data key="d9">La miopat&#237;a puede presentarse como un s&#237;ntoma en trastornos metab&#243;licos relacionados con la &#946;-oxidaci&#243;n</data>
      <data key="d10">2f96bbc5eafd39b659620da7282a2079</data>
      <data key="d11">a441dc7481834191947443bce873af2d</data>
      <data key="d12">15511</data>
      <data key="d13">2</data>
    </edge>
    <edge source="APO C-II" target="LPL">
      <data key="d8">7.0</data>
      <data key="d9">Apo C-II is a necessary cofactor for the activation of LPL, linking it to the metabolism of triglycerides</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">8f2f63af7ada451aaebb20f6c9178959</data>
      <data key="d12">15512</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOMEGALIA" target="GSDIII">
      <data key="d8">7.0</data>
      <data key="d9">Hepatomegalia is a common clinical manifestation of GSDIII</data>
      <data key="d10">b5e899a3def3da339630eb0d2bfe4af8</data>
      <data key="d11">7fcde513db1f450f8cc17b9496262e0e</data>
      <data key="d12">15513</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOMEGALIA" target="HIPOGLUCEMIAS">
      <data key="d8">5.0</data>
      <data key="d9">Hepatomegalia can be a symptom associated with episodes of hipoglucemias in patients with glycogen storage diseases</data>
      <data key="d10">eb1f89320202c337496dbad5ca168356</data>
      <data key="d11">40ea19eaac89469f992ead48a8425f80</data>
      <data key="d12">15514</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOMEGALIA" target="HH">
      <data key="d8">7.0</data>
      <data key="d9">Hepatomegalia is a clinical sign that may indicate the presence of hereditary hemochromatosis</data>
      <data key="d10">a3d834f1d854ecde12e808ae924b8eb0</data>
      <data key="d11">38bb3fb16956473c84df926dfd484d9b</data>
      <data key="d12">15515</data>
      <data key="d13">2</data>
    </edge>
    <edge source="IDL" target="LDL">
      <data key="d8">8.0</data>
      <data key="d9">LDL is the final product of the metabolic cascade that begins with VLDL and passes through IDL</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">aff8ba205ea24964bf3710c5a6adbb4d</data>
      <data key="d12">15516</data>
      <data key="d13">2</data>
    </edge>
    <edge source="IDL" target="APO E">
      <data key="d8">6.0</data>
      <data key="d9">Apo E is involved in the clearance of IDL from the bloodstream, indicating a functional relationship</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">daaa6dc57dbb4cb9859829501e96e9dd</data>
      <data key="d12">15517</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LDL" target="PCSK9">
      <data key="d8">8.0</data>
      <data key="d9">PCSK9 regulates the levels of LDL receptors, affecting LDL metabolism</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">cbd54e2e4668473ba0cdb107485f7cb6</data>
      <data key="d12">15518</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIETA DASH" target="&#193;CIDOS GRASOS POLIINSATURADOS">
      <data key="d8">1.0</data>
      <data key="d9">The DASH diet includes recommendations for polyunsaturated fats, which can influence lipid levels</data>
      <data key="d10">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d11">3a48531498db48a8a00a916ce225735b</data>
      <data key="d12">15519</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS POLIINSATURADOS" target="CARDIOVASCULAR SALUD">
      <data key="d8">8.0</data>
      <data key="d9">&#193;cidos grasos poliinsaturados are essential for cardiovascular health and should be part of a healthy diet</data>
      <data key="d10">c78125c02ea4d5afdf5cb5ac4baeeb27</data>
      <data key="d11">655cf3d3fe5a438383917cd71ea97569</data>
      <data key="d12">15520</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PREDIMED" target="EUROPEAN SOCIETY OF CARDIOLOGY">
      <data key="d8">7.0</data>
      <data key="d9">The PREDIMED trial is referenced in the guidelines provided by the European Society of Cardiology for managing dyslipidemia</data>
      <data key="d10">c78125c02ea4d5afdf5cb5ac4baeeb27</data>
      <data key="d11">1b8929778dd948cda0641c06f5db992f</data>
      <data key="d12">15521</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PREDIMED" target="EUROPEAN SOCIETY OF ATHEROSCLEROSIS">
      <data key="d8">7.0</data>
      <data key="d9">The PREDIMED trial is referenced in the guidelines provided by the European Society of Atherosclerosis for managing dyslipidemia</data>
      <data key="d10">c78125c02ea4d5afdf5cb5ac4baeeb27</data>
      <data key="d11">a4cb03d072af4833883255b72aa5d44b</data>
      <data key="d12">15522</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PREDIMED" target="FESNAD">
      <data key="d8">7.0</data>
      <data key="d9">FESNAD promotes the Predimed study which focuses on the benefits of the Mediterranean diet</data>
