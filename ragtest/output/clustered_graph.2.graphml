      <data key="d0">PERSON</data>
      <data key="d1">Head of the Endocrinology and Nutrition Service at Hospital Universitario Ntra. Sra. de Candelaria in Tenerife.</data>
      <data key="d2">7c37a605ce9323c724b713aa64b7fae5</data>
      <data key="d3">1442</data>
      <data key="d4">2</data>
