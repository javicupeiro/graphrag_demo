    </node>
    <node id="MALABSORCI&#211;N DE FRUCTOSA">
      <data key="d0">EVENT</data>
      <data key="d1">Malabsorci&#243;n de fructosa is a condition characterized by the inability to absorb fructose properly, leading to gastrointestinal symptoms such as flatulence, diarrhea, and abdominal pain.</data>
      <data key="d2">033a22e7215395479d0775d6a1a2563e</data>
      <data key="d3">862</data>
      <data key="d4">2</data>
