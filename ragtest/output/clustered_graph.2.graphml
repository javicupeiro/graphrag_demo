    <node id="AIRE GENE">
      <data key="d0">PERSON</data>
      <data key="d1">The AIRE gene is associated with autoimmune conditions, including type 1 diabetes, and is involved in immune tolerance.</data>
      <data key="d2">d0231ac4e41b0e826d80763b5b8c61e0</data>
      <data key="d3">1720</data>
