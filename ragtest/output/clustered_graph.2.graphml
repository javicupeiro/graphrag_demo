      <data key="d8">5.0</data>
      <data key="d9">Chronic autoimmune thyroiditis is mentioned as being associated with adrenal insufficiency in patients with POEMS syndrome</data>
      <data key="d10">77fb6e19a2882617993d1d283afcb86a</data>
      <data key="d11">1b2fefda238e40f4accabd548726a0d0</data>
      <data key="d12">14949</data>
