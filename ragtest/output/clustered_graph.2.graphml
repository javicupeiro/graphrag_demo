      <data key="d5">15</data>
      <data key="d6">865</data>
      <data key="d7">2535e4c8b7e647719c13154633680697</data>
    </node>
    <node id="SANCYD">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">SANCYD, or La Sociedad Andaluza de Nutrici&#243;n Cl&#237;nica y Diet&#233;tica, is a working group dedicated to the standardization of hospital nutrition in Andalusia. In addition to its focus on improving dietary practices within healthcare settings, SANCYD also provides valuable resources for patients with disabilities, including those who experience dysphagia. This dual commitment highlights SANCYD's role in enhancing nutritional care and support for diverse patient needs in the region.</data>
      <data key="d2">4de75db0e24f0f89d890287e2a3f3dcc,5aef6ccb162a04d926beeb343ceea252</data>
      <data key="d3">1570</data>
