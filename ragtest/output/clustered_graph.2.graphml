      <data key="d5">3</data>
      <data key="d6">3612</data>
      <data key="d7">cc33bfaaf0284d0d8204497633132392</data>
    </node>
    <node id="C&#193;NCER MEDULAR DE TIROIDES">
      <data key="d0">EVENT</data>
      <data key="d1">C&#225;ncer medular de tiroides is another form of thyroid cancer discussed in the context of endocrinology.</data>
      <data key="d2">fc81f645a5600b374c960fd8739a0503</data>
      <data key="d3">1486</data>
