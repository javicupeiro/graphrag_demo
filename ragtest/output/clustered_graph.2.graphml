    <node id="AMERICAN COLLEGE OF GASTROENTEROLOGY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The American College of Gastroenterology is a professional organization that provides guidelines for the management of gastrointestinal diseases, including acute pancreatitis.</data>
      <data key="d2">c84372864fd2ee7b7ed425b2d597efdb</data>
