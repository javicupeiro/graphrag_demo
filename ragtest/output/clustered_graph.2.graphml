      <data key="d8">6.0</data>
      <data key="d9">Los niveles bajos de colesterol pueden ser un signo de malnutrici&#243;n en pacientes con insuficiencia renal cr&#243;nica</data>
      <data key="d10">61564a330848cb173088bd08e1a9a181</data>
      <data key="d11">d6e1956521a34647ae191fe4625478d8</data>
      <data key="d12">9161</data>
      <data key="d13">2</data>
    </edge>
