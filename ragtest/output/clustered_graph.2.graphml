    <node id="STAPHYLOCOCCUS EPIDERMIDIS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Staphylococcus epidermidis is a type of bacteria commonly implicated in catheter-related infections.</data>
      <data key="d2">fe3ebcedac0857680bcc85bb58dcb3e1</data>
