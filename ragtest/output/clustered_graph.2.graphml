    </node>
    <node id="DIABETIC DEBUT">
      <data key="d0">EVENT</data>
      <data key="d1">Diabetic debut refers to the initial onset of diabetes in a patient, during which dietary education and management are crucial.</data>
      <data key="d2">49279a0184d5222e806637f084f42c50</data>
      <data key="d5">0</data>
      <data key="d6">8440</data>
