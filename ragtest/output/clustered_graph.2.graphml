    </node>
    <node id="&#205;NDICES ERITROCITARIOS">
      <data key="d0">EVENT</data>
      <data key="d1">Erythrocyte indices are measurements used to evaluate the size and hemoglobin content of red blood cells, which can indicate nutritional status.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
