      <data key="d7">02d6eeb867494b2d9460f0f0794d3f02</data>
    </node>
    <node id="FASCITIS NECROTIZANTE">
      <data key="d0">EVENT</data>
      <data key="d1">Severe infection of the soft tissue that leads to necrosis, often occurring in patients with compromised immune systems.</data>
      <data key="d2">09e9623b3facc5045e80541b1cd2cada</data>
      <data key="d3">1178</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
