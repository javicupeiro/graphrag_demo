    </edge>
    <edge source="QUIMIOTERAPIA" target="EFECTOS SECUNDARIOS">
      <data key="d8">8.0</data>
      <data key="d9">La quimioterapia provoca efectos secundarios que afectan la capacidad de alimentaci&#243;n normal del paciente.</data>
      <data key="d10">9c3716c3860855ce045a1e5d9d30b9d1</data>
