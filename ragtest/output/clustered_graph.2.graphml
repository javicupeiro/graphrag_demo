    </edge>
    <edge source="GLUCOGENOSIS" target="GM-CSF">
      <data key="d8">4.0</data>
      <data key="d9">GM-CSF is used in the treatment of glucogenosis to help manage immune responses and prevent infections.</data>
      <data key="d10">76287e9b94faab94755c56fead3541d7</data>
      <data key="d11">299a47af3a034088a8b4d581035e98fa</data>
      <data key="d12">18337</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCOGENOSIS" target="G-CSF">
      <data key="d8">4.0</data>
      <data key="d9">G-CSF is utilized in the treatment of glucogenosis to stimulate the production of neutrophils and manage neutropenia.</data>
      <data key="d10">76287e9b94faab94755c56fead3541d7</data>
      <data key="d11">9a854da054fe40909b9872e7d9e7efaa</data>
