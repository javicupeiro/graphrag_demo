    </node>
    <node id="RINITIS">
      <data key="d0">EVENT</data>
      <data key="d1">Rinitis is an inflammation of the nasal mucous membrane, which can be caused by food allergies.</data>
      <data key="d2">9d84c9c66c832dd17e7247a6966c2ea1</data>
      <data key="d3">371</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">14005</data>
      <data key="d7">93ae1bda44c94ce5bed1bf553c098fd9</data>
    </node>
    <node id="ANGIOEDEMA">
      <data key="d0">EVENT</data>
      <data key="d1">Angioedema is a condition involving swelling beneath the skin, often related to allergic reactions to food.</data>
      <data key="d2">9d84c9c66c832dd17e7247a6966c2ea1</data>
      <data key="d3">371</data>
      <data key="d4">1</data>
