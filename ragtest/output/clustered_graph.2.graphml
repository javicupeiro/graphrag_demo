    </node>
    <node id="MONITORIZACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Monitoring refers to the ongoing assessment of patients, particularly those undergoing treatment for thrombosis, to ensure effective management and detect complications.</data>
      <data key="d2">5ad53a3f16964261ae37b64f7c3cb688</data>
