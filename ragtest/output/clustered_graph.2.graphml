    </edge>
    <edge source="ORGANIZACI&#211;N M&#201;DICA MUNDIAL" target="PILANESBERG">
      <data key="d8">5.0</data>
      <data key="d9">Pilanesberg es el lugar donde se revis&#243; la declaraci&#243;n de la Organizaci&#243;n M&#233;dica Mundial en 2006, lo que afecta a la atenci&#243;n de pacientes en huelga de hambre.</data>
      <data key="d10">3a39d5a157094736650455097e986fdd</data>
      <data key="d11">be8b2452af6740cebd3fa856a0db29f4</data>
      <data key="d12">20281</data>
