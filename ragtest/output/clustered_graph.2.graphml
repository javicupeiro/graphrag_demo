      <data key="d13">2</data>
    </edge>
    <edge source="MEDITERRANEAN DIET" target="CEREALS">
      <data key="d8">9.0</data>
      <data key="d9">Cereals are a staple in the Mediterranean diet, providing essential nutrients</data>
      <data key="d10">c4f12f866dc714cdbb2323a920f524c2</data>
      <data key="d11">337d4fb3405c457c8b2d0e1b1cc54566</data>
      <data key="d12">11188</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MEDITERRANEAN DIET" target="FISH">
      <data key="d8">9.0</data>
      <data key="d9">Fish is a key component of the Mediterranean diet, known for its omega-3 fatty acids beneficial for brain health</data>
