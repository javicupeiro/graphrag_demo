      <data key="d13">2</data>
    </edge>
    <edge source="GASTO EN REPOSO" target="MASA MAGRA CORPORAL">
      <data key="d8">1.0</data>
      <data key="d9">La masa magra corporal es un determinante clave del gasto energ&#233;tico en reposo, ya que mayor masa muscular generalmente se asocia con un mayor gasto energ&#233;tico</data>
      <data key="d10">285343ba92b89a1761b72d9d789ba8f6</data>
      <data key="d11">cc42f6d9978d4fe08a4a112a899e4c33</data>
      <data key="d12">14098</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GASTO ENERGETICO TOTAL" target="TERMOG&#201;NESIS INDUCIDA POR ALIMENTOS">
      <data key="d8">7.0</data>
      <data key="d9">La termog&#233;nesis inducida por alimentos contribuye al gasto energ&#233;tico total al requerir energ&#237;a para la digesti&#243;n y metabolizaci&#243;n de los alimentos</data>
      <data key="d10">285343ba92b89a1761b72d9d789ba8f6</data>
      <data key="d11">1936e91a3d714baa88352fc8d56306d4</data>
      <data key="d12">14099</data>
      <data key="d13">2</data>
    </edge>
