    </node>
    <node id="ACARBOSE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Acarbose is a medication that can be used to manage postprandial hyperglycemia in patients who have undergone bariatric surgery.</data>
      <data key="d2">79afec9f55a4cb9aa31a7e4566dae279</data>
      <data key="d3">1654</data>
      <data key="d4">2</data>
