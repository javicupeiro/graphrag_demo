      <data key="d11">ed8e7e6991a94432a87ef052f36c12b6</data>
      <data key="d12">16747</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EURODIET" target="SOCIETY OF SPANISH COMMUNITY NUTRITION">
      <data key="d8">4.0</data>
      <data key="d9">The SENC participates in the EURODIET project to establish dietary guidelines</data>
      <data key="d10">844d065cac5f5304fffed35b5da90416</data>
      <data key="d11">2816e4a8258244c7a2c3f0a1cddc2607</data>
      <data key="d12">16748</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NAS" target="POBLACI&#211;N GENERAL">
      <data key="d8">8.0</data>
      <data key="d9">NAS has published dietary recommendations that are relevant to the general population</data>
      <data key="d10">c2a8dd9d28d1992a73de2834131b69c9</data>
      <data key="d11">57d42b4f6d5a49e8bc070cb99a974696</data>
      <data key="d12">16749</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NAS" target="GEB">
