    </node>
    <node id="TAY-SACHS DISEASE">
      <data key="d0">EVENT</data>
      <data key="d1">Tay-Sachs disease is a neurodegenerative disorder caused by a deficiency of &#946;-hexosaminidase A, affecting primarily Ashkenazi Jews.</data>
      <data key="d2">592d424edaa447a54ab4489d82495db6</data>
      <data key="d3">1298</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
