    <node id="TRASTORNOS MOTORAS DEL ES&#211;FAGO">
      <data key="d0">EVENT</data>
      <data key="d1">Los trastornos motores del es&#243;fago son condiciones que afectan la motilidad del es&#243;fago y pueden causar disfagia, siendo menos frecuentes que la estenosis p&#233;ptica.</data>
      <data key="d2">cfd217c3642e90cb9f3e1ff854830bd6</data>
