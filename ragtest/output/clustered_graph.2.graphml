    <node id="ARGINASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Arginasa (ASA) is an enzyme that hydrolyzes arginine to ornithine and urea, playing a key role in the urea cycle.</data>
      <data key="d2">0487e1a4525547575a1d284297280f9a</data>
      <data key="d5">1</data>
      <data key="d6">10690</data>
