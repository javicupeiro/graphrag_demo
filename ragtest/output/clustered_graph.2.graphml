    </node>
    <node id="HADZISELIMOVIC">
      <data key="d0">PERSON</data>
      <data key="d1">Hadziselimovic is a researcher who authored a debate on hormonal treatment of congenital undescended testes in a medical journal.</data>
      <data key="d2">592d424edaa447a54ab4489d82495db6</data>
      <data key="d3">1286</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">5472</data>
