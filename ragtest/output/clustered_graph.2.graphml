    </node>
    <node id="SAXAGLIPTINA">
      <data key="d0">PERSON</data>
      <data key="d1">Saxagliptina is a medication for type 2 diabetes that is eliminated primarily through the kidneys and requires dose adjustment in renal impairment.</data>
      <data key="d2">630ac8fefe27e4b893831674a67dcc82</data>
