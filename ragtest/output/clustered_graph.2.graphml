      <data key="d10">9df735d7829302712be068a5d1b1540b</data>
      <data key="d11">5199ce7fdc344b4e9f8853334c9a47fe</data>
      <data key="d12">20274</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AUTORIDAD JUDICIAL" target="CENTRO PENITENCIARIO DE PREVENTIVOS MADRID-2">
