    <node id="OROFARINGEA">
      <data key="d0">EVENT</data>
      <data key="d1">Orofaringea refers to the oropharyngeal type of dysphagia, where the oral cavity and pharynx are involved.</data>
      <data key="d2">23c483bf9bf70d04577ef3735a1ca2e8</data>
