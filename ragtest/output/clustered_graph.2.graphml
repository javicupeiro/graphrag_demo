      <data key="d7">7808f099d579414aad1375ec45aabf92</data>
    </node>
    <node id="ZARAGOZA">
      <data key="d0">GEO</data>
      <data key="d1">Zaragoza is a city in Spain that is home to the Hospital Cl&#237;nico Universitario Lozano Blesa, which serves as a prominent center for medical research and treatment. Additionally, this hospital is affiliated with the University, further emphasizing its role in the healthcare and educational landscape of the region.</data>
      <data key="d2">45c3281fd6beffb0e9ac61ae5700af3d,994c13f250eafe4b1a52d40b56230a0c</data>
      <data key="d5">0</data>
      <data key="d6">6390</data>
