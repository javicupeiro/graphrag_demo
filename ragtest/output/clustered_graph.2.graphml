    </node>
    <node id="BETA-AMYLOID">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Beta-amyloid is a protein that forms plaques in the brain, contributing to the development of Alzheimer's disease.</data>
      <data key="d2">dd8c7ee9ef48992cebb11e84fbb0fe34</data>
      <data key="d3">1626</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">3194</data>
      <data key="d7">bbe59f0869b74b9285396a81ae801bcd</data>
    </node>
    <node id="TAU PROTEIN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Tau protein is associated with neurodegeneration and is involved in the formation of tangles in Alzheimer's disease.</data>
      <data key="d2">dd8c7ee9ef48992cebb11e84fbb0fe34</data>
      <data key="d3">1626</data>
      <data key="d4">2</data>
