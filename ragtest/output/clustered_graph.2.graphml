      <data key="d10">cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d11">af1133746e634324bf412277139f7496</data>
      <data key="d12">8026</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMINO ACIDS" target="GLUTAMINE">
      <data key="d8">6.0</data>
      <data key="d9">Glutamine is a specific amino acid that plays a role in immune function and recovery</data>
      <data key="d10">cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d11">8de80a192b7c413caf4bbad68f4d1692</data>
