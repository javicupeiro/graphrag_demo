      <data key="d7">e6607adcb9124be88fc6a88b0a761db8</data>
    </node>
    <node id="BANCOS I">
      <data key="d0">PERSON</data>
      <data key="d1">Bancos I is a significant contributor to the management guidelines for adrenal incidentalomas, emphasizing clinical practice in the field of endocrinology. Additionally, Bancos I is recognized as an author of the European Society of Endocrinology guidelines specifically addressing the management of adrenal incidentalomas.</data>
      <data key="d2">28bca03cd2152cf2562d7aa16d7ced1d,8fe4d0101ea7a6ddaefd71c963d9ecc7</data>
