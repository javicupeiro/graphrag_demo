    <node id="FEN/TPM">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">FEN/TPM is a combination of drugs that is considered the most effective for weight loss based on clinical trial results.</data>
      <data key="d2">22a361e57659e072600d6575631f6160</data>
