    </node>
    <node id="PACIENTE OBESO">
      <data key="d0">PERSON</data>
      <data key="d1">An obese patient is an individual who may require bariatric surgery and needs a structured nutritional education program for healthy eating habits.</data>
      <data key="d2">64347a9be918a67f786cbdf9f9db9c8a</data>
      <data key="d3">1371</data>
