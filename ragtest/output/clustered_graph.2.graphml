    </node>
    <node id="GITELMAN SYNDROME">
      <data key="d0">EVENT</data>
      <data key="d1">Gitelman syndrome is a genetic disorder that affects the kidneys' ability to reabsorb certain electrolytes, leading to hypomagnesemia and hypokalemia.</data>
      <data key="d2">b9342cecd69cdc0e9936df041657f5f5</data>
      <data key="d3">711</data>
      <data key="d4">2</data>
