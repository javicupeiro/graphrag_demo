    <edge source="HEALTHY DIET" target="DIABETIC PATIENT">
      <data key="d8">9.0</data>
      <data key="d9">Diabetic patients need to follow a healthy diet to manage their condition effectively.</data>
      <data key="d10">e2304aa7e992d9e26558aab3c807b51d</data>
      <data key="d11">1e5bc4670dde4e09b66fb9deb452862d</data>
      <data key="d12">17526</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEALTHY DIET" target="COSTS HOSPITALARIOS">
      <data key="d8">1.0</data>
      <data key="d9">Implementing a healthy diet can lead to lower hospital costs for diabetic patients by preventing complications.</data>
      <data key="d10">e2304aa7e992d9e26558aab3c807b51d</data>
      <data key="d11">0ca2ea16c3904c9c92dcc159ae708378</data>
      <data key="d12">17527</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEALTHY DIET" target="DIETARY HABITS">
      <data key="d8">1.0</data>
      <data key="d9">Healthy dietary habits are essential for maintaining a balanced and nutritious diet</data>
      <data key="d10">2f1fed346bb25032751634adf513337a</data>
      <data key="d11">171ea02826d24f8ab0720739c1d2d500</data>
      <data key="d12">17528</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIETAS POR RACIONES" target="UNIDADES DE INTERCAMBIO">
      <data key="d8">7.0</data>
      <data key="d9">Dietas por raciones utilize unidades de intercambio to plan meals and manage dietary intake</data>
      <data key="d10">e9d9dbd1ccc60737441dcf7bfeef638e</data>
      <data key="d11">6242e6dd21d8496d927eaf92fe3838c5</data>
      <data key="d12">17529</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIETAS POR RACIONES" target="CEREALES">
      <data key="d8">6.0</data>
      <data key="d9">Cereales are part of dietas por raciones to provide necessary carbohydrates for energy</data>
      <data key="d10">e9d9dbd1ccc60737441dcf7bfeef638e</data>
      <data key="d11">fe8b7109b9684cc3b28fb4eb0278ff6f</data>
      <data key="d12">17530</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIETAS POR RACIONES" target="TUB&#201;RCULOS">
      <data key="d8">6.0</data>
      <data key="d9">Tub&#233;rculos are part of dietas por raciones to offer a source of carbohydrates</data>
      <data key="d10">e9d9dbd1ccc60737441dcf7bfeef638e</data>
      <data key="d11">64b858cd5cde4f2d84187ee21f70d6ef</data>
      <data key="d12">17531</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREALES" target="ENFERMEDAD CELIACA">
      <data key="d8">15.0</data>
      <data key="d9">CEREALES, que son una de las principales fuentes de gluten, pueden provocar s&#237;ntomas en personas con ENFERMEDAD CELIACA. Por lo tanto, es crucial que las personas con esta condici&#243;n eviten el consumo de cereales que contienen gluten para prevenir reacciones adversas.</data>
      <data key="d10">41babae4bb4b80271c9bfd9da1528392,7d2050a2481adc105bdebbcf2af1a173</data>
      <data key="d11">ad756960edeb42e9bf228c6e31d45bde</data>
      <data key="d12">17532</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREALES" target="DASH">
      <data key="d8">7.0</data>
      <data key="d9">The DASH diet includes recommendations for daily servings of cereals as a source of energy and fiber</data>
      <data key="d10">b5db5210dfb726bf3f6d3fae82598596</data>
      <data key="d11">d69c8af782284601b764750f14540253</data>
      <data key="d12">17533</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CEREALES" target="NI&#209;O">
      <data key="d8">6.0</data>
      <data key="d9">Cereals are recommended as a daily food source for children</data>
      <data key="d10">56e7bab8da5c5e8d37b7545618a648bb</data>
      <data key="d11">edd3d9f62c4947eb9aac382a4f7b0b94</data>
      <data key="d12">17534</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TUB&#201;RCULOS" target="CELIAC DISEASE">
      <data key="d8">9.0</data>
      <data key="d9">Tubers are gluten-free foods that are recommended for individuals with celiac disease.</data>
      <data key="d10">1387d49a5eae8a32dd81f2f9991a4821</data>
      <data key="d11">33d7fe94cf9742f4b92922e01ac68a7f</data>
      <data key="d12">17535</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLYCEMIA" target="HIGH GLYCEMIC INDEX FOODS">
      <data key="d8">8.0</data>
      <data key="d9">High glycemic index foods can lead to spikes in glycemia, which is detrimental for diabetes management</data>
      <data key="d10">c98ed25e58194d76463e3553fb3f3c15</data>
      <data key="d11">6584b3f4d49d42de8deac94babd3f845</data>
      <data key="d12">17536</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLYCEMIA" target="LOW GLYCEMIC INDEX FOODS">
      <data key="d8">8.0</data>
      <data key="d9">Low glycemic index foods help maintain stable glycemia, making them preferable for diabetes management</data>
      <data key="d10">c98ed25e58194d76463e3553fb3f3c15</data>
      <data key="d11">4b822cb9c16c4032b975db456c0fbd6c</data>
      <data key="d12">17537</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SACAROSA" target="HEREDITARY FRUCTOSE INTOLERANCE">
      <data key="d8">8.0</data>
      <data key="d9">Sucrose must be eliminated from the diet of individuals with hereditary fructose intolerance due to its fructose content</data>
      <data key="d10">cdc634d994ef64b248220c990c844160</data>
      <data key="d11">4248aa3cb3cb4182a1de0dc34749a19c</data>
      <data key="d12">17538</data>
      <data key="d13">2</data>
    </edge>
