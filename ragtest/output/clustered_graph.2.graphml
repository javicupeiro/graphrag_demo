      <data key="d11">49459f9d96054f1eb1ef5c72e7b4f591</data>
      <data key="d12">3054</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="DIFICULTADES COGNITIVAS">
      <data key="d8">1.0</data>
