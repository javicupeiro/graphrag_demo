      <data key="d8">5.0</data>
      <data key="d9">The PapEndoCrinic program addresses differentiated thyroid cancer in its clinical guidelines</data>
      <data key="d10">fc81f645a5600b374c960fd8739a0503</data>
      <data key="d11">16eb7731b8e5462bbe86dfc6c7050593</data>
      <data key="d12">11807</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PAPENDOCRINIC" target="C&#193;NCER MEDULAR DE TIROIDES">
      <data key="d8">5.0</data>
      <data key="d9">The PapEndoCrinic program includes information on medullary thyroid cancer</data>
      <data key="d10">fc81f645a5600b374c960fd8739a0503</data>
      <data key="d11">da31749fc8e84b5eaa6d0d498a87eb95</data>
      <data key="d12">11808</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="HIPERTIROIDISMO">
      <data key="d8">9.0</data>
      <data key="d9">The entity "TIROIDES" refers to the thyroid gland, which is responsible for the production of thyroid hormones. When this gland becomes overactive, it leads to a condition known as "HIPERTIROIDISMO," or hyperthyroidism. Hyperthyroidism is characterized by the excessive secretion of thyroid hormones due to the overactivity of the thyroid gland.</data>
      <data key="d10">4c18507e3d98242cdbcddd1a1997b92f,c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">f593f1d673164c4e8b81f3c7d7f087b5</data>
      <data key="d12">11809</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="GRAVES">
      <data key="d8">8.0</data>
      <data key="d9">Graves' disease is a condition that affects the thyroid gland, leading to hyperthyroidism</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">1f6d56f9b4804298bd25f41fe5f522fe</data>
      <data key="d12">11810</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="AMIODARONE">
      <data key="d8">7.0</data>
      <data key="d9">Amiodarone can induce type 2 thyrotoxicosis, affecting the function of the thyroid gland</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">0b72cc24b2474187a973d12792fe39c9</data>
      <data key="d12">11811</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="OSTEOCALCINA">
      <data key="d8">6.0</data>
      <data key="d9">Osteocalcin levels are elevated in patients with hyperthyroidism, indicating increased bone metabolism related to thyroid function</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">48ec1e1c1fed4fb2bc92282ee328107c</data>
      <data key="d12">11812</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="VASOPRESINA">
      <data key="d8">4.0</data>
      <data key="d9">Vasopressin levels may vary in relation to thyroid function, particularly in states of thyroid dysfunction</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">ed03f544baa94d47af67fdd4d3e84a79</data>
      <data key="d12">11813</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="SHBG">
      <data key="d8">5.0</data>
      <data key="d9">SHBG levels are influenced by thyroid hormones, with increased production in hyperthyroid states</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">204d99527c6b4019b60c5eb57df7f745</data>
      <data key="d12">11814</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="FERRITINA">
      <data key="d8">1.0</data>
      <data key="d9">Ferritin levels can be elevated in hyperthyroidism, reflecting changes in iron metabolism associated with thyroid function</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">5f6b4f39bb1b41338dbd787a055e7354</data>
      <data key="d12">11815</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="N&#211;DULO T&#211;XICO">
      <data key="d8">7.0</data>
      <data key="d9">Toxic nodules are a cause of hyperthyroidism, indicating abnormal function of the thyroid gland</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">e7aea63e069147be8882dc949fa1ec17</data>
      <data key="d12">11816</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="TSH">
      <data key="d8">6.0</data>
      <data key="d9">TSH regulates the production of thyroid hormones, thus directly influencing thyroid function</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">2269dbc142e540a6ad0e6fe4db8e793a</data>
      <data key="d12">11817</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="HORMONA TIROIDEA">
      <data key="d8">8.0</data>
      <data key="d9">Thyroid hormones are produced by the thyroid gland and are essential for metabolic regulation</data>
      <data key="d10">c4f0f024f16be34d17dbbbae57042b2b</data>
      <data key="d11">b3711f727fa14a9a8699a5e7f9b17179</data>
      <data key="d12">11818</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="CRISIS TIROT&#211;XICA">
      <data key="d8">1.0</data>
      <data key="d9">Crisis tirot&#243;xica is a condition related to the dysfunction of the thyroid gland</data>
      <data key="d10">10cd1db13dc50a14adab6e4c215bb3b0</data>
      <data key="d11">841c818e94304987928c10905be9083f</data>
      <data key="d12">11819</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="TIROTROPINOMA">
      <data key="d8">7.0</data>
      <data key="d9">Tirotropinoma affects the function of the thyroid gland by producing excess TSH</data>
      <data key="d10">10cd1db13dc50a14adab6e4c215bb3b0</data>
      <data key="d11">a2f21b52d4be4e0d8dcb8e0c32343457</data>
      <data key="d12">11820</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="PAAF">
      <data key="d8">9.0</data>
      <data key="d9">La PAAF se realiza para evaluar n&#243;dulos en la gl&#225;ndula tiroides y determinar su naturaleza maligna o benigna.</data>
      <data key="d10">171bf5a205ba13cbab91aab05e088040</data>
      <data key="d11">c373028542c745c089565850abdb4acb</data>
      <data key="d12">11821</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="COL">
      <data key="d8">6.0</data>
      <data key="d9">La col contiene sustancias que pueden inhibir la captaci&#243;n de yodo por el tirocito, afectando la funci&#243;n tiroidea.</data>
      <data key="d10">171bf5a205ba13cbab91aab05e088040</data>
      <data key="d11">78c33ed9963a44bcb46bdc23022bae8e</data>
      <data key="d12">11822</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="NABO">
      <data key="d8">6.0</data>
      <data key="d9">El nabo contiene sustancias que pueden inhibir la captaci&#243;n de yodo por el tirocito, afectando la funci&#243;n tiroidea.</data>
      <data key="d10">171bf5a205ba13cbab91aab05e088040</data>
      <data key="d11">d5c99831b8504fc4956a9b83e31376a4</data>
      <data key="d12">11823</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="BR&#211;COLI">
      <data key="d8">6.0</data>
      <data key="d9">El br&#243;coli contiene tiocianatos que pueden inhibir la captaci&#243;n de yodo por el tirocito, afectando la funci&#243;n tiroidea.</data>
      <data key="d10">171bf5a205ba13cbab91aab05e088040</data>
      <data key="d11">2fefd2230dec47189c7fa9a4f9cae60d</data>
      <data key="d12">11824</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="ALMENDRAS">
      <data key="d8">2.0</data>
      <data key="d9">Las almendras no contienen tiocianatos, por lo que no afectan la captaci&#243;n de yodo por el tirocito.</data>
      <data key="d10">171bf5a205ba13cbab91aab05e088040</data>
      <data key="d11">efde65d1a38742a88b1c4a6e464c35f0</data>
      <data key="d12">11825</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="AR&#193;NDANOS">
      <data key="d8">1.0</data>
      <data key="d9">Los ar&#225;ndanos no contienen tiocianatos, por lo que no afectan la captaci&#243;n de yodo por el tirocito.</data>
      <data key="d10">171bf5a205ba13cbab91aab05e088040</data>
      <data key="d11">7adbaf213c7c4651a4dd19180dd821d3</data>
      <data key="d12">11826</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="CARCINOMA MEDULAR">
      <data key="d8">8.0</data>
      <data key="d9">El carcinoma medular es un tipo de c&#225;ncer que se origina en la tiroides, afectando su funci&#243;n y salud.</data>
      <data key="d10">8ef1954ebfc3ede96038ff1db145e140</data>
      <data key="d11">1790bcf155d1486fad464f6e524f9c38</data>
      <data key="d12">11827</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="INSUFICIENCIA ADRENAL">
      <data key="d8">5.0</data>
      <data key="d9">Thyroid dysfunction can be associated with adrenal insufficiency, affecting overall endocrine function</data>
      <data key="d10">af95ffa2f3eaddc28a86d59cd2d89415</data>
      <data key="d11">fb8147b5f0f24d1984c787038aad1529</data>
      <data key="d12">11828</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TIROIDES" target="C&#193;NCER DIFERENCIADO DE TIROIDES">
      <data key="d8">6.0</data>
      <data key="d9">The thyroid is involved in the development and monitoring of differentiated thyroid cancer</data>
      <data key="d10">7d4d879207b235ab3018772eea448b2a</data>
      <data key="d11">6e4c2b0bac24436295568f9de7c6fc66</data>
      <data key="d12">11829</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DIFERENCIADO DE TIROIDES" target="THYROID CARCINOMA">
      <data key="d8">1.0</data>
      <data key="d9">Differentiated thyroid carcinoma is a specific type of thyroid carcinoma with distinct characteristics and treatment approaches</data>
      <data key="d10">f4a7e9b010f4062fc8a4ad57c51de506</data>
      <data key="d11">d754ab2e7fc544628d415e233081f08b</data>
      <data key="d12">11830</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="DRA. ROC&#205;O VILLAR TAIBO">
      <data key="d8">1.0</data>
      <data key="d9">Dra. Roc&#237;o Villar Taibo is involved in research related to the pituitary gland and its hormonal functions</data>
      <data key="d10">490c43a262bf2f4ac77134fdcf14e891</data>
      <data key="d11">01c8abbd490b49ffb82c82b66402a57b</data>
      <data key="d12">11831</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="ADENOHIP&#211;FISIS">
      <data key="d8">8.0</data>
      <data key="d9">La adenohip&#243;fisis es una de las dos partes principales de la hip&#243;fisis, responsable de la producci&#243;n de varias hormonas</data>
      <data key="d10">78b093da6669fb9ed3258ed62a73260e</data>
      <data key="d11">9e236eeda83c4ae1bb14027d5e0aab3b</data>
      <data key="d12">11832</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="NEUROHIP&#211;FISIS">
      <data key="d8">8.0</data>
      <data key="d9">La neurohip&#243;fisis es la otra parte principal de la hip&#243;fisis, que almacena y libera hormonas del hipot&#225;lamo</data>
      <data key="d10">78b093da6669fb9ed3258ed62a73260e</data>
      <data key="d11">51d317e50a854828982c0c5453c094e0</data>
      <data key="d12">11833</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="PIT-1">
      <data key="d8">8.0</data>
      <data key="d9">Pit-1 is a transcription factor that plays a crucial role in the differentiation of cells in the pituitary gland</data>
      <data key="d10">9d100ca2bc5b797561fe3b3a4bb61586</data>
      <data key="d11">7f44f10ac61d4b6f9cb451d48f940506</data>
      <data key="d12">11834</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="T-PIT">
      <data key="d8">8.0</data>
      <data key="d9">T-Pit is essential for the differentiation of corticotropic cells in the pituitary gland</data>
      <data key="d10">9d100ca2bc5b797561fe3b3a4bb61586</data>
      <data key="d11">3cad658e9c9141439def255351e843ec</data>
      <data key="d12">11835</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="HORMONAS HIPOT&#193;LAMO-HIPOFISARIAS">
      <data key="d8">7.0</data>
      <data key="d9">The pituitary gland produces hormones that are regulated by the hypothalamus</data>
      <data key="d10">9d100ca2bc5b797561fe3b3a4bb61586</data>
      <data key="d11">717d555a4de9457081686ced05d7ffce</data>
      <data key="d12">11836</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="ACTH">
      <data key="d8">18.0</data>
      <data key="d9">HIP&#211;FISIS produces ACTH, which is essential for regulating adrenal function, specifically the production of cortisol in the adrenal glands. ACTH is produced by the pituitary gland and plays a crucial role in maintaining the body's response to stress and metabolic processes.</data>
      <data key="d10">9d100ca2bc5b797561fe3b3a4bb61586,c5ebf416dfb2be58a226e15fb9771c86</data>
      <data key="d11">f8eda5c0b458453abc24e9ae890e4d2b</data>
      <data key="d12">11837</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="GH">
      <data key="d8">18.0</data>
      <data key="d9">HIP&#211;FISIS, also known as the pituitary gland, is responsible for the secretion of growth hormone (GH), which is essential for growth and metabolism. This hormone plays a critical role in the growth and development of the body, highlighting the importance of the HIP&#211;FISIS in regulating these vital processes.</data>
      <data key="d10">9b9d487a35d8197bfe9d1aa0fce19c32,9d100ca2bc5b797561fe3b3a4bb61586</data>
      <data key="d11">e9d786d43b3c4a0d8763c3e30e4524c9</data>
      <data key="d12">11838</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="PRL">
      <data key="d8">9.0</data>
      <data key="d9">Prolactin is produced by the pituitary gland and is important for lactation</data>
      <data key="d10">9d100ca2bc5b797561fe3b3a4bb61586</data>
      <data key="d11">6473b1398a3041a5b175b62cc3882845</data>
      <data key="d12">11839</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="TSH">
      <data key="d8">9.0</data>
      <data key="d9">Thyroid-stimulating hormone is secreted by the pituitary gland and regulates thyroid function</data>
      <data key="d10">9d100ca2bc5b797561fe3b3a4bb61586</data>
      <data key="d11">c7ed0f7cc7de4b43820f6ed9049b7942</data>
      <data key="d12">11840</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="HIPOPITUITARISMO">
      <data key="d8">1.0</data>
      <data key="d9">Hypopituitarism is a condition that affects the functioning of the pituitary gland</data>
      <data key="d10">9d100ca2bc5b797561fe3b3a4bb61586</data>
      <data key="d11">5e0aa97e9d8042329471804aaf2a52fe</data>
      <data key="d12">11841</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="HCG">
      <data key="d8">7.0</data>
      <data key="d9">La hCG es producida por tumores que pueden afectar la hip&#243;fisis y tiene efectos en la producci&#243;n hormonal.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">dbbf88e351a241f8ae4b909678a37e78</data>
      <data key="d12">11842</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="AIP">
      <data key="d8">6.0</data>
      <data key="d9">AIP es un gen supresor tumoral implicado en la aparici&#243;n de adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">4ee81a6254a74ed2a5520703676ee6a2</data>
      <data key="d12">11843</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="MEN1">
      <data key="d8">6.0</data>
      <data key="d9">MEN1 es un gen supresor tumoral relacionado con la formaci&#243;n de adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">232af7779d2e4628b6361eec49634e9a</data>
      <data key="d12">11844</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="PRKARIA">
      <data key="d8">6.0</data>
      <data key="d9">PRKARIA es un gen que act&#250;a como supresor tumoral y est&#225; implicado en adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">fda2e78db95d40b1a664ddd5a7ad8e50</data>
      <data key="d12">11845</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="RB">
      <data key="d8">6.0</data>
      <data key="d9">RB es un gen supresor tumoral asociado con adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">db009b4da45b459b9bdde8b6538172a4</data>
      <data key="d12">11846</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="GNAS">
      <data key="d8">8.0</data>
      <data key="d9">HIP&#211;FISIS is associated with GNAS, an oncogene that plays a significant role in the development of pituitary adenomas, particularly those that are somatotropic in nature. The GNAS gene is essential for the proper functioning of the pituitary gland, especially in regulating the secretion of growth hormone. This highlights the importance of GNAS in both the pathology of pituitary tumors and the normal physiological processes of the pituitary gland.</data>
      <data key="d10">2e73034a100b1adb0a00561c08416bda,309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">05cf7cf1930d4c1fb5ab2502ab071ca2</data>
      <data key="d12">11847</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="H-RAS">
      <data key="d8">6.0</data>
      <data key="d9">H-RAS es un oncog&#233;n relacionado con la aparici&#243;n de adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">ed981675571d47a88a35f04775368449</data>
      <data key="d12">11848</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="CCND1">
      <data key="d8">6.0</data>
      <data key="d9">CCND1 es un oncog&#233;n que se ha implicado en adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">94bcf8fc887743e1ab42c503d639e559</data>
      <data key="d12">11849</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="HMGA2">
      <data key="d8">6.0</data>
      <data key="d9">HMGA2 es un oncog&#233;n asociado con la formaci&#243;n de adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">5ce272984e664b578e9bac98c40e0079</data>
      <data key="d12">11850</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="FGFR4">
      <data key="d8">6.0</data>
      <data key="d9">FGFR4 es un oncog&#233;n que puede estar implicado en adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">d71dfeda67a24cf9883554222ab2740c</data>
      <data key="d12">11851</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="GADD45G">
      <data key="d8">6.0</data>
      <data key="d9">GADD45G es un inhibidor de la proliferaci&#243;n relacionado con adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">6e59963e9b6b4e819e7b0e6b0b64abc5</data>
      <data key="d12">11852</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="MEG3">
      <data key="d8">6.0</data>
      <data key="d9">MEG3 es un inhibidor de la proliferaci&#243;n implicado en adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">2253e5000da84204baaf3b174d571a60</data>
      <data key="d12">11853</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="CDKN1B">
      <data key="d8">6.0</data>
      <data key="d9">CDKN1B es un inhibidor de CDK relacionado con adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">37a7a01342624b89bfc0c9021453c259</data>
      <data key="d12">11854</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="CCNB2">
      <data key="d8">6.0</data>
      <data key="d9">CCNB2 es una ciclina implicada en adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">ef19f62743d84361a106cfaf5cf3272b</data>
      <data key="d12">11855</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="PPTG">
      <data key="d8">1.0</data>
      <data key="d9">PPTG es una prote&#237;na relacionada con la regulaci&#243;n del ciclo celular y adenomas hipofisarios.</data>
      <data key="d10">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d11">255641e33a994992b07f12fe5bd62cdf</data>
      <data key="d12">11856</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="ADENOMA HIPOFISARIO">
      <data key="d8">8.0</data>
      <data key="d9">El adenoma hipofisario es un tumor que se origina en la hip&#243;fisis y afecta su funci&#243;n</data>
      <data key="d10">755475a08c9b594dacee6386b782065f</data>
      <data key="d11">f328f24ef6dc41a9bd8ee492c4f04870</data>
      <data key="d12">11857</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="CANCER DE MAMA">
      <data key="d8">5.0</data>
      <data key="d9">El c&#225;ncer de mama puede metastatizar en la hip&#243;fisis, afectando su funci&#243;n</data>
      <data key="d10">755475a08c9b594dacee6386b782065f</data>
      <data key="d11">092434776e804ddf8736114f50fe5513</data>
      <data key="d12">11858</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="COMPLEJO DE CARNEY">
      <data key="d8">6.0</data>
      <data key="d9">La hip&#243;fisis puede verse afectada por el complejo de Carney, que incluye tumores en gl&#225;ndulas endocrinas</data>
      <data key="d10">39838811d935b8d580e419ac87ef32ab</data>
      <data key="d11">5db88ec0980e4c579f0839aa9be441bf</data>
      <data key="d12">11859</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="PROLACTINOMA">
      <data key="d8">9.0</data>
      <data key="d9">The HIP&#211;FISIS, or pituitary gland, is the gland where prolactinomas develop. Prolactinomas are tumors that produce prolactin, a hormone that plays a crucial role in various bodily functions. These tumors can affect hormone levels, leading to various health issues. Thus, the relationship between the HIP&#211;FISIS and PROLACTINOMA is significant, as the former is the site of occurrence for the latter.</data>
      <data key="d10">b157600f59e67793829a144ddaff24df,b530539793a70d1223f3307aa47777fe</data>
      <data key="d11">a73fb6a4a9f544e69ffdd5448820bd0e</data>
      <data key="d12">11860</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="MELMED S">
      <data key="d8">5.0</data>
      <data key="d9">Melmed S ha escrito sobre la adenohip&#243;fisis y su relaci&#243;n con los prolactinomas</data>
      <data key="d10">b157600f59e67793829a144ddaff24df</data>
      <data key="d11">692b38142dc947b08af641016f264ae9</data>
      <data key="d12">11861</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="ADENOMAS HIPOFISARIOS">
      <data key="d8">16.0</data>
      <data key="d9">HIP&#211;FISIS, tambi&#233;n conocida como la gl&#225;ndula pituitaria, es el &#243;rgano afectado por los adenomas hipofisarios, que son tumores que se desarrollan en esta gl&#225;ndula. Estos tumores pueden provocar hiperprolactinemia, una condici&#243;n caracterizada por niveles elevados de prolactina en la sangre. En resumen, los adenomas hipofisarios son tumores que impactan la funci&#243;n de la hip&#243;fisis y pueden tener efectos significativos en la salud hormonal del individuo.</data>
      <data key="d10">2b6e6d589cd4e83086e44c77205b3740,b157600f59e67793829a144ddaff24df</data>
      <data key="d11">b09b5dca60ba447fa306fdefb3c108ce</data>
      <data key="d12">11862</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="HYPERPROLACTINEMIA">
      <data key="d8">1.0</data>
      <data key="d9">La hiperprolactinemia es una condici&#243;n que afecta la funci&#243;n de la hip&#243;fisis al alterar la producci&#243;n de prolactina</data>
      <data key="d10">94acece2df038421a302ca1fa53d5275</data>
      <data key="d11">7288d064f4e74abaaec06e6d08e4e131</data>
      <data key="d12">11863</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="ENFERMEDAD DE CUSHING">
      <data key="d8">9.0</data>
      <data key="d9">La hip&#243;fisis es la gl&#225;ndula responsable de la producci&#243;n de ACTH, que est&#225; relacionada con la enfermedad de Cushing.</data>
      <data key="d10">6d1d33d516f4ff2c0edf5bf266205c1f</data>
      <data key="d11">de894df6ae4641039a57c19926714cb5</data>
      <data key="d12">11864</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="CUSHING'S SYNDROME">
      <data key="d8">8.0</data>
      <data key="d9">Cushing's syndrome is often caused by an adenoma in the hypophysis, leading to increased levels of ACTH and cortisol</data>
      <data key="d10">88a8ebb15abeea8eaded56ef3d2df73f</data>
      <data key="d11">6919d927519f44c78d863af55028e204</data>
      <data key="d12">11865</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="GH RECOMBINANTE">
      <data key="d8">8.0</data>
      <data key="d9">The hip&#243;fisis produces growth hormone, which is related to the use of GH recombinante in treatments</data>
      <data key="d10">2f30de565a9a9acf7ac0930483276bbb</data>
      <data key="d11">ad9d720b73ca4789811a9a712e885741</data>
      <data key="d12">11866</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="DEFICIT DE GH">
      <data key="d8">8.0</data>
      <data key="d9">The hipofisis is responsible for the secretion of growth hormone, and its deficiency leads to deficit de GH</data>
      <data key="d10">742d2991389effe376f335dad6fbafa1</data>
      <data key="d11">a8bf0b961093481599ed7b6da157ac1d</data>
      <data key="d12">11867</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="DIABETES INS&#205;PIDA">
      <data key="d8">16.0</data>
      <data key="d9">HIP&#211;FISIS and DIABETES INS&#205;PIDA are closely related in the context of water regulation in the body. Diabetes ins&#237;pida can arise from dysfunctions in the hip&#243;fisis, which plays a critical role in regulating the secretion of antidiuretic hormone (ADH). This hormone is essential for maintaining proper water balance and concentration in urine. Therefore, any impairment in the function of the hip&#243;fisis can significantly impact the pathophysiology of diabetes ins&#237;pida, leading to issues with water retention and urinary concentration.</data>
      <data key="d10">67fc85f14d95a9a24054c2a3ec125e37,9b9d487a35d8197bfe9d1aa0fce19c32</data>
      <data key="d11">9b91dcd54f9d4c05a838177b21354d4c</data>
      <data key="d12">11868</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="S&#205;NDROME DE INTERRUPCI&#211;N DEL TALLA HIPOFISARIO">
      <data key="d8">7.0</data>
      <data key="d9">El s&#237;ndrome de interrupci&#243;n del tallo hipofisario afecta la funci&#243;n de la hip&#243;fisis, resultando en deficiencias hormonales.</data>
      <data key="d10">9b9d487a35d8197bfe9d1aa0fce19c32</data>
      <data key="d11">b6b22739f59146279c15ae013af1fcb4</data>
      <data key="d12">11869</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="INFARTO HIPOFISARIO">
      <data key="d8">7.0</data>
      <data key="d9">El infarto hipofisario implica da&#241;o a la hip&#243;fisis, lo que puede resultar en deficiencias hormonales.</data>
      <data key="d10">9b9d487a35d8197bfe9d1aa0fce19c32</data>
      <data key="d11">3625252cacb343f49d5f4672ef61eb19</data>
      <data key="d12">11870</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="HEMOCROMATOSIS HEREDITARIA">
      <data key="d8">5.0</data>
      <data key="d9">La hemocromatosis hereditaria puede causar dep&#243;sitos de hierro en la hip&#243;fisis, afectando su funci&#243;n.</data>
      <data key="d10">9b9d487a35d8197bfe9d1aa0fce19c32</data>
      <data key="d11">19c36e41367548d19b06510f08b68f5c</data>
      <data key="d12">11871</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="HORMONAS">
      <data key="d8">8.0</data>
      <data key="d9">The HIP&#211;FISIS, also known as the pituitary gland, plays a crucial role in regulating the production and secretion of various hormones in the body. This regulation significantly impacts multiple physiological functions, highlighting the importance of the HIP&#211;FISIS in maintaining overall health and homeostasis.</data>
      <data key="d10">9b9d487a35d8197bfe9d1aa0fce19c32,af95ffa2f3eaddc28a86d59cd2d89415</data>
      <data key="d11">532d1e28d9664748b286a2e47a9989f6</data>
      <data key="d12">11872</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="TUMORES CEREBRALES">
      <data key="d8">6.0</data>
      <data key="d9">Los tumores cerebrales pueden afectar la funci&#243;n de la hip&#243;fisis, causando hipopituitarismo y otros problemas hormonales.</data>
      <data key="d10">9b9d487a35d8197bfe9d1aa0fce19c32</data>
      <data key="d11">8cd342475e4741838f42d71a620b0ecb</data>
      <data key="d12">11873</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="TUMORES NASOFAR&#205;NGEOS">
      <data key="d8">6.0</data>
      <data key="d9">Los tumores nasofar&#237;ngeos pueden afectar la hip&#243;fisis, resultando en deficiencias hormonales.</data>
      <data key="d10">9b9d487a35d8197bfe9d1aa0fce19c32</data>
      <data key="d11">6a274714760449cc80987468606da44c</data>
      <data key="d12">11874</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="TRAUMA CRANEAL">
      <data key="d8">7.0</data>
      <data key="d9">El trauma craneal puede causar da&#241;o a la hip&#243;fisis, resultando en problemas hormonales.</data>
      <data key="d10">9b9d487a35d8197bfe9d1aa0fce19c32</data>
      <data key="d11">4f7eec0019f74a6aa44d3b1dc20b5996</data>
      <data key="d12">11875</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="ACROMEGALIA">
      <data key="d8">8.0</data>
      <data key="d9">Acromegalia is a disorder that is directly related to the functioning of the pituitary gland, which produces growth hormone.</data>
      <data key="d10">2e73034a100b1adb0a00561c08416bda</data>
      <data key="d11">f784c65845384d39932c09ada5cc71a5</data>
      <data key="d12">11876</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="ADH">
      <data key="d8">9.0</data>
      <data key="d9">La hip&#243;fisis produce ADH, que es esencial para la regulaci&#243;n de la concentraci&#243;n urinaria y el equilibrio de l&#237;quidos en el cuerpo.</data>
      <data key="d10">67fc85f14d95a9a24054c2a3ec125e37</data>
      <data key="d11">1f6a3d15c3fe476bad209e727f254fdb</data>
      <data key="d12">11877</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="INSUFICIENCIA SUPRARRENAL">
      <data key="d8">8.0</data>
      <data key="d9">La hip&#243;fisis regula la producci&#243;n de ACTH, que a su vez controla la producci&#243;n de cortisol, y su disfunci&#243;n puede llevar a insuficiencia suprarrenal.</data>
      <data key="d10">c5ebf416dfb2be58a226e15fb9771c86</data>
      <data key="d11">77d702b3abfd46b39730a5c4b57e92aa</data>
      <data key="d12">11878</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIP&#211;FISIS" target="NEUROSARCOIDOSIS">
      <data key="d8">1.0</data>
      <data key="d9">La neurosarcoidosis puede afectar la hip&#243;fisis, aunque en este caso se considera menos probable como causa de los s&#237;ntomas de la paciente.</data>
      <data key="d10">c5ebf416dfb2be58a226e15fb9771c86</data>
      <data key="d11">e6b1557a8741471ab37b2e2ee54ad446</data>
      <data key="d12">11879</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#211;DULO 4" target="M&#211;DULO 5">
      <data key="d8">8.0</data>
      <data key="d9">M&#243;dulo 4 and M&#243;dulo 5 are both educational modules that focus on health-related topics. They contain questions and answers designed to enhance understanding in this area. Additionally, M&#243;dulo 4 and M&#243;dulo 5 are sections of a larger document, each addressing different aspects of health and nutrition, which indicates a thematic connection between the two modules. Together, they contribute to a comprehensive exploration of health and nutrition topics.</data>
      <data key="d10">476274b4d401aba4307379ed0f5387ac,545db57c3c81825310618d52b413a5a5</data>
      <data key="d11">89e12848937e44ed9fe1221694603777</data>
      <data key="d12">11880</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#211;DULO 4" target="M&#211;DULO 3">
      <data key="d8">5.0</data>
      <data key="d9">M&#243;dulo 3 and M&#243;dulo 4 are both educational modules that contain questions and answers on health-related topics</data>
      <data key="d10">545db57c3c81825310618d52b413a5a5</data>
      <data key="d11">00be7799448c493eb70408b039925802</data>
      <data key="d12">11881</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#211;DULO 5" target="M&#211;DULO 3">
      <data key="d8">5.0</data>
      <data key="d9">M&#243;dulo 3 and M&#243;dulo 5 are both educational modules that contain questions and answers on health-related topics</data>
      <data key="d10">545db57c3c81825310618d52b413a5a5</data>
      <data key="d11">97dbd3c45b134184a482819b16307da1</data>
      <data key="d12">11882</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MISCELEANEA" target="SIADH">
      <data key="d8">6.0</data>
      <data key="d9">La miscel&#225;nea incluye varias sustancias que pueden inducir el SIADH, afectando la regulaci&#243;n hormonal.</data>
      <data key="d10">c5ebf416dfb2be58a226e15fb9771c86</data>
      <data key="d11">07e62307eee04923aebfd0ed4d8b5fa2</data>
      <data key="d12">11883</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CASOS CL&#205;NICOS" target="HIPERPLASIA SUPRARRENAL CONG&#201;NITA">
      <data key="d8">1.0</data>
      <data key="d9">Casos cl&#237;nicos often include examples of hiperplasia suprarrenal cong&#233;nita for educational purposes</data>
      <data key="d10">bcb4f7ab0760e548b520c667b305722a</data>
      <data key="d11">8422784e45294589878f6405475b00cf</data>
      <data key="d12">11884</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CASOS CL&#205;NICOS" target="OTROS">
      <data key="d8">1.0</data>
      <data key="d9">Otros conditions may be included in casos cl&#237;nicos for comprehensive medical education</data>
      <data key="d10">bcb4f7ab0760e548b520c667b305722a</data>
      <data key="d11">5e295e8e7f9549f9b749dae3a058837f</data>
      <data key="d12">11885</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="ENFERMEDAD ADDISON">
      <data key="d8">7.0</data>
      <data key="d9">La insuficiencia suprarrenal puede ser causada por la enfermedad de Addison, que es una forma de insuficiencia adrenal primaria.</data>
      <data key="d10">c5ebf416dfb2be58a226e15fb9771c86</data>
      <data key="d11">b891f37cf2f34ba185b9093b1ec4cbf3</data>
      <data key="d12">11886</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="CASO CLINICO 1">
      <data key="d8">7.0</data>
      <data key="d9">El caso cl&#237;nico 1 describe una paciente con s&#237;ntomas compatibles con insuficiencia suprarrenal, lo que es relevante para el diagn&#243;stico.</data>
      <data key="d10">c5ebf416dfb2be58a226e15fb9771c86</data>
      <data key="d11">1146ed25ebd74ee6908f30230617479e</data>
      <data key="d12">11887</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="CORTISOL BAJO">
      <data key="d8">8.0</data>
      <data key="d9">El hallazgo de cortisol bajo es un indicador clave de insuficiencia suprarrenal en la paciente.</data>
      <data key="d10">c5ebf416dfb2be58a226e15fb9771c86</data>
      <data key="d11">e07aa5fde337470fac4792416cceff38</data>
      <data key="d12">11888</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="ADRENOLEUCODISTROFIA">
      <data key="d8">14.0</data>
      <data key="d9">Adrenal insufficiency, known as "insuficiencia suprarrenal," can manifest as a symptom of adrenoleukodystrophy, referred to as "adrenoleucodistrofia," in certain patients. This indicates a direct relationship between the two conditions, suggesting that individuals with adrenoleukodystrophy may experience adrenal insufficiency as part of their clinical presentation.</data>
      <data key="d10">1ac394c08f6c4bdfbee5440e56a97dd0,4eb5a5cd6147917dd1380d49c613a78b</data>
      <data key="d11">e7ca1740401e4754b3272a5ce9d6c6c5</data>
      <data key="d12">11889</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="ANEMIA PERNICIOSA">
      <data key="d8">12.0</data>
      <data key="d9">Insuficiencia suprarrenal y anemia perniciosa son dos condiciones m&#233;dicas que pueden coexistir. La anemia perniciosa es una enfermedad autoinmunitaria que afecta la absorci&#243;n de vitamina B12, lo que puede llevar a una serie de complicaciones hematol&#243;gicas. Esta condici&#243;n a menudo se asocia con la insuficiencia suprarrenal primaria, lo que indica una relaci&#243;n significativa entre ambas enfermedades. En resumen, la anemia perniciosa y la insuficiencia suprarrenal pueden presentarse juntas, sugiriendo una conexi&#243;n entre los mecanismos autoinmunitarios que afectan al cuerpo.</data>
      <data key="d10">1ac394c08f6c4bdfbee5440e56a97dd0,4eb5a5cd6147917dd1380d49c613a78b</data>
      <data key="d11">17a71d5f76514391841609ff5183f616</data>
      <data key="d12">11890</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="S&#205;NDROME PLURIGLANDULAR AUTOINMUNE TIPO 2">
      <data key="d8">8.0</data>
      <data key="d9">El s&#237;ndrome pluriglandular autoinmune tipo 2 es una de las causas m&#225;s comunes de insuficiencia suprarrenal primaria, lo que establece una conexi&#243;n entre ambas.</data>
      <data key="d10">1ac394c08f6c4bdfbee5440e56a97dd0</data>
      <data key="d11">406ee75759ac492b80894853138bb953</data>
      <data key="d12">11891</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="CYP21A2">
      <data key="d8">7.0</data>
      <data key="d9">La deficiencia de la enzima CYP21A2 puede llevar a insuficiencia suprarrenal primaria, lo que indica una relaci&#243;n entre la enzima y la condici&#243;n.</data>
      <data key="d10">1ac394c08f6c4bdfbee5440e56a97dd0</data>
      <data key="d11">5c2c9a9101a444ad9404c197216c27d9</data>
      <data key="d12">11892</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="LINFOMAS">
      <data key="d8">6.0</data>
      <data key="d9">Lymphomas can also lead to adrenal insufficiency</data>
      <data key="d10">c925b6205ea7a28ba24640c28ec558da</data>
      <data key="d11">e3094d7d10bd40058b363b13a7e3cec9</data>
      <data key="d12">11893</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="SOX3">
      <data key="d8">1.0</data>
      <data key="d9">Mutations in the SOX3 gene are associated with rare causes of adrenal insufficiency</data>
      <data key="d10">c925b6205ea7a28ba24640c28ec558da</data>
      <data key="d11">271147c5e1864335abc4cbdcc1e52903</data>
      <data key="d12">11894</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="ADRENALITIS AUTOINMUNITARIA">
      <data key="d8">9.0</data>
      <data key="d9">Adrenalitis autoinmunitaria is the most common cause of primary adrenal insufficiency</data>
      <data key="d10">c925b6205ea7a28ba24640c28ec558da</data>
      <data key="d11">c64145baac9e4f2b819e8d9ac7295e5e</data>
      <data key="d12">11895</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="ALDOSTERONA">
      <data key="d8">8.0</data>
      <data key="d9">Deficiency of aldosterone is a common feature in primary adrenal insufficiency</data>
      <data key="d10">c925b6205ea7a28ba24640c28ec558da</data>
      <data key="d11">5bb3d592a9bb4dc2b3ab8b34b995dac8</data>
      <data key="d12">11896</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="HORMONA ANTIDIUR&#201;TICA">
      <data key="d8">7.0</data>
      <data key="d9">In adrenal insufficiency, levels of hormone antidiur&#233;tica can be elevated due to cortisol deficiency</data>
      <data key="d10">c925b6205ea7a28ba24640c28ec558da</data>
      <data key="d11">3df9ffae7deb4c8d9e6486f4d038677b</data>
      <data key="d12">11897</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="POMC">
      <data key="d8">6.0</data>
      <data key="d9">Mutations in the POMC gene can lead to isolated ACTH deficiency, impacting adrenal function</data>
      <data key="d10">c925b6205ea7a28ba24640c28ec558da</data>
      <data key="d11">0e93d324ebb44a16bf9941423d31d1ba</data>
      <data key="d12">11898</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="TBX19">
      <data key="d8">1.0</data>
      <data key="d9">Mutations in the TBX19 gene can cause isolated ACTH deficiency, affecting adrenal function</data>
      <data key="d10">c925b6205ea7a28ba24640c28ec558da</data>
      <data key="d11">1ea4383db6184647b2f908d8e6cba3e1</data>
      <data key="d12">11899</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="HIPOPOTASEMIA">
      <data key="d8">7.0</data>
      <data key="d9">La insuficiencia suprarrenal puede causar hipopotasemia debido a la falta de producci&#243;n de aldosterona, que regula los niveles de potasio</data>
      <data key="d10">b9bf0b94c01d3dfa9ef4cbce09dd7ec3</data>
      <data key="d11">69bddd3544dc459892ae1d09a54a7afd</data>
      <data key="d12">11900</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA SUPRARRENAL" target="HIPO-NATREMIA">
      <data key="d8">1.0</data>
      <data key="d9">Adrenal insufficiency can cause hyponatremia due to inadequate hormone production affecting sodium balance</data>
      <data key="d10">a56fad7f6dac4a75bd4748b247aa9215</data>
      <data key="d11">517642acbcc442de8bedd74ac3e9ef49</data>
      <data key="d12">11901</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="TRATAMIENTO CON GH">
      <data key="d8">6.0</data>
      <data key="d9">El tratamiento con GH se menciona en el contexto de la enfermedad de Cushing, que puede requerir intervenci&#243;n m&#233;dica</data>
      <data key="d10">b11e575be155e186717a992a9d641577</data>
      <data key="d11">d15066e1a3804b1cbd534c4f96d01168</data>
      <data key="d12">11902</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="PACIENTE DE 56 A&#209;OS">
      <data key="d8">8.0</data>
      <data key="d9">La paciente de 56 a&#241;os presenta s&#237;ntomas que sugieren la presencia del s&#237;ndrome de Cushing</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af</data>
      <data key="d11">16d46306bb0d46bbb0931abacc961742</data>
      <data key="d12">11903</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="ACTH">
      <data key="d8">14.0</data>
      <data key="d9">El s&#237;ndrome de Cushing est&#225; relacionado con la producci&#243;n y regulaci&#243;n de ACTH (hormona adrenocorticotr&#243;pica), que es crucial para su diagn&#243;stico. La medici&#243;n de los niveles de ACTH es relevante en el diagn&#243;stico del s&#237;ndrome de Cushing, ya que estos niveles pueden indicar la causa subyacente de la enfermedad.</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af,62abcb4e755766817e948341a56b196b</data>
      <data key="d11">887279d1b6a244218acd545618b3aba2</data>
      <data key="d12">11904</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="TAC CRANEAL">
      <data key="d8">5.0</data>
      <data key="d9">La TAC craneal se utiliza para descartar tumores que pueden estar causando el s&#237;ndrome de Cushing</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af</data>
      <data key="d11">57f1114f7af249429150ea2ececb044b</data>
      <data key="d12">11905</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="RMN">
      <data key="d8">5.0</data>
      <data key="d9">La RMN se utiliza para evaluar la presencia de adenomas suprarrenales en pacientes con s&#237;ndrome de Cushing</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af</data>
      <data key="d11">c131ff99cef64146bec1a153d4f14fe0</data>
      <data key="d12">11906</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="HORMONAS HIPOFISARIAS">
      <data key="d8">1.0</data>
      <data key="d9">Las hormonas hipofisarias, como la ACTH, est&#225;n involucradas en la regulaci&#243;n del s&#237;ndrome de Cushing</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af</data>
      <data key="d11">804cb9c67ca44b70bca70e153f776c8e</data>
      <data key="d12">11907</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="HARRISON PRINCIPIOS DE MEDICINA INTERNA">
      <data key="d8">10.0</data>
      <data key="d9">El "S&#237;ndrome de Cushing" es un trastorno endocrino que se caracteriza por la exposici&#243;n prolongada a niveles elevados de cortisol en el cuerpo. El libro "Harrison Principios de Medicina Interna" incluye informaci&#243;n relevante sobre este s&#237;ndrome, abarcando tanto su diagn&#243;stico como su tratamiento. Este texto es una fuente valiosa para los profesionales de la salud, ya que proporciona una comprensi&#243;n integral de las implicaciones cl&#237;nicas del s&#237;ndrome de Cushing y las estrategias para su manejo.</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af,62abcb4e755766817e948341a56b196b</data>
      <data key="d11">9039d389b3ca413c8888393ed1ee4ce1</data>
      <data key="d12">11908</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="ENDOCRINE SOCIETY">
      <data key="d8">6.0</data>
      <data key="d9">La Endocrine Society establece gu&#237;as cl&#237;nicas que son relevantes para el diagn&#243;stico y tratamiento del s&#237;ndrome de Cushing</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af</data>
      <data key="d11">83c6f75b231a4520bd73bd3520871187</data>
      <data key="d12">11909</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="MANUAL DE ENDOCRINOLOG&#205;A Y NUTRICI&#211;N">
      <data key="d8">9.0</data>
      <data key="d9">The "S&#237;ndrome de Cushing" is a condition that is discussed in the "Manual de Endocrinolog&#237;a y Nutrici&#243;n." This manual provides comprehensive information about various endocrine disorders, including the syndrome itself. Additionally, it covers related topics such as primary adrenal insufficiency, which is associated with the syndrome of Cushing. The manual serves as a valuable resource for understanding the complexities of these endocrine conditions and their interrelations.</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af,62abcb4e755766817e948341a56b196b</data>
      <data key="d11">88eb1c13c62742edba5f7f2c08b1a0e4</data>
      <data key="d12">11910</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="WILLIAMS TEXTBOOK OF ENDOCRINOLOGY">
      <data key="d8">1.0</data>
      <data key="d9">El libro de Williams proporciona informaci&#243;n sobre el s&#237;ndrome de Cushing y sus causas</data>
      <data key="d10">1de72f0ea3a981289854857b691b52af</data>
      <data key="d11">f994cfa75d6540b18c026b35dfbeb9f5</data>
      <data key="d12">11911</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="GL&#193;NDULAS SUPRARRENALES">
      <data key="d8">7.0</data>
      <data key="d9">El s&#237;ndrome de Cushing afecta la funci&#243;n de las gl&#225;ndulas suprarrenales, que producen cortisol</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">a72fc7dca678451fb41e4e455ab2961b</data>
      <data key="d12">11912</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="GLUCOCORTICOIDES">
      <data key="d8">6.0</data>
      <data key="d9">El s&#237;ndrome de Cushing puede ser causado por la administraci&#243;n de glucocorticoides ex&#243;genos</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">7116eb8772c1434e9c6aaad5118ab565</data>
      <data key="d12">11913</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="ADENOMA HIPOFISARIO">
      <data key="d8">7.0</data>
      <data key="d9">El adenoma hipofisario puede causar el s&#237;ndrome de Cushing al producir ACTH en exceso</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">19eea6129d564aaf8184b9122491fbc2</data>
      <data key="d12">11914</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="TUMORES NEUROENDOCRINOS PANCRE&#193;TICOS">
      <data key="d8">5.0</data>
      <data key="d9">Los tumores neuroendocrinos pancre&#225;ticos pueden causar secreci&#243;n ect&#243;pica de ACTH, contribuyendo al s&#237;ndrome de Cushing</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">3f4bb97039754f20989c7901bd4fe0da</data>
      <data key="d12">11915</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="CARCINOMAS DE C&#201;LULAS PEQUE&#209;AS PULMONARES">
      <data key="d8">5.0</data>
      <data key="d9">Los carcinomas de c&#233;lulas peque&#241;as pulmonares pueden ser una causa de s&#237;ndrome de Cushing por producci&#243;n ect&#243;pica de ACTH</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">2a90afea9de949e5a1f0e76ee632d503</data>
      <data key="d12">11916</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="KASPER DL">
      <data key="d8">3.0</data>
      <data key="d9">Kasper DL es un autor que proporciona informaci&#243;n sobre el s&#237;ndrome de Cushing en su libro</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">2dfdf0349332440e8e4f034e91cff6a6</data>
      <data key="d12">11917</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="NIEMAN LK">
      <data key="d8">1.0</data>
      <data key="d9">Nieman LK ha escrito sobre el s&#237;ndrome de Cushing, contribuyendo a su comprensi&#243;n</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">2a83908d55ae4e6ba9d2fca07f8c7d0d</data>
      <data key="d12">11918</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="UPTODATE">
      <data key="d8">4.0</data>
      <data key="d9">UpToDate ofrece informaci&#243;n actualizada sobre el diagn&#243;stico y tratamiento del s&#237;ndrome de Cushing</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">67f8f4bcfc614a6db87699cc0f271bd5</data>
      <data key="d12">11919</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="LITERATURA REVISADA">
      <data key="d8">1.0</data>
      <data key="d9">La literatura revisada incluye informaci&#243;n sobre el s&#237;ndrome de Cushing</data>
      <data key="d10">62abcb4e755766817e948341a56b196b</data>
      <data key="d11">5da1f03725744b07880eef0092fc3d43</data>
      <data key="d12">11920</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE CUSHING" target="HIPERANDROGENISMO">
      <data key="d8">7.0</data>
      <data key="d9">Cushing's syndrome can lead to hyperandrogenism, establishing a relationship between the two conditions.</data>
      <data key="d10">b30c94def1763c77fe1fc302cc896d6c</data>
      <data key="d11">b4b71fc675f44923bda993d659146687</data>
      <data key="d12">11921</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO" target="LAHERA VARGAS M.">
      <data key="d8">5.0</data>
      <data key="d9">Lahera Vargas M. discusses hyperaldosteronism in the Manual de Endocrinolog&#237;a y Nutrici&#243;n</data>
      <data key="d10">2b390802e6a6df561cafb9593e97d6bd</data>
      <data key="d11">0f7cae651b0e42a4823ebd6351afa547</data>
      <data key="d12">11922</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO" target="AINE">
      <data key="d8">1.0</data>
      <data key="d9">Non-steroidal anti-inflammatory drugs are mentioned in the treatment of hyperaldosteronism</data>
      <data key="d10">2b390802e6a6df561cafb9593e97d6bd</data>
      <data key="d11">2835854d271a4b71a8e8644bf27621c9</data>
      <data key="d12">11923</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO" target="HIPOPOTASEMIA">
      <data key="d8">7.0</data>
      <data key="d9">El hiperaldosteronismo puede causar hipopotasemia debido a la retenci&#243;n de sodio y la excreci&#243;n excesiva de potasio</data>
      <data key="d10">b9bf0b94c01d3dfa9ef4cbce09dd7ec3</data>
      <data key="d11">fb618b2e5d5c4635940fda14a042f6f4</data>
      <data key="d12">11924</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO" target="ESPIRONOLACTONA">
      <data key="d8">1.0</data>
      <data key="d9">La espironolactona se utiliza para tratar el hiperaldosteronismo al antagonizar los efectos de la aldosterona</data>
      <data key="d10">b9bf0b94c01d3dfa9ef4cbce09dd7ec3</data>
      <data key="d11">2e50df58b35d46d3ac4bad45c0c0289a</data>
      <data key="d12">11925</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO" target="INCIDENTALOMA SUPRARRENAL">
      <data key="d8">5.0</data>
      <data key="d9">Primary hyperaldosteronism may be diagnosed in patients with adrenal incidentalomas</data>
      <data key="d10">6ebb5385c8eda09a187e6d0595812bbf</data>
      <data key="d11">027b74a47d574583a638fd5fc4d50034</data>
      <data key="d12">11926</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO" target="DIUR&#201;TICOS">
      <data key="d8">4.0</data>
      <data key="d9">Diuretics may influence the evaluation of hyperaldosteronism in patients with adrenal incidentalomas</data>
      <data key="d10">6ebb5385c8eda09a187e6d0595812bbf</data>
      <data key="d11">91e0f249d50c4c878abbc0a2ebf3987a</data>
      <data key="d12">11927</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO" target="ANTAGONISTAS DE LA ALDOSTERONA">
      <data key="d8">7.0</data>
      <data key="d9">Aldosterone antagonists are used in the treatment of primary hyperaldosteronism</data>
      <data key="d10">6ebb5385c8eda09a187e6d0595812bbf</data>
      <data key="d11">b4dd543e14b5468a94261e1199cfb8c0</data>
      <data key="d12">11928</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="M918T MEN2B">
      <data key="d8">5.0</data>
      <data key="d9">El feocromocitoma es un riesgo asociado a la mutaci&#243;n M918T MEN2B y se debe realizar un cribado en pacientes con esta mutaci&#243;n</data>
      <data key="d10">c4c0b3b2e4f4d6cad02aa1bbd92fd558</data>
      <data key="d11">abb25c151b214d559cc3fa8364302614</data>
      <data key="d12">11929</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="MEN2A">
      <data key="d8">14.0</data>
      <data key="d9">Feocromocitoma is a condition that can occur as part of the MEN2A syndrome. It is often diagnosed concurrently with MEN2A in patients, indicating a strong association between the two entities.</data>
      <data key="d10">2c745fa0855caf0a3316554b5a46752c,4433d2fdc6ba080efa0cf63e8603172a</data>
      <data key="d11">03ec45defdab469d90a00062f44599ac</data>
      <data key="d12">11930</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="CARCINOMA MEDULAR">
      <data key="d8">6.0</data>
      <data key="d9">Carcinoma medular and feocromocitoma can occur together in patients with MEN2A</data>
      <data key="d10">2c745fa0855caf0a3316554b5a46752c</data>
      <data key="d11">0c8e4f07504e41f1b89d5cd408b7884a</data>
      <data key="d12">11931</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="MEDULLARY THYROID CARCINOMA">
      <data key="d8">1.0</data>
      <data key="d9">Feocromocitoma must be ruled out prior to surgery for medullary thyroid carcinoma due to potential complications</data>
      <data key="d10">de6e1d8ac9f422acb17fd26b77b485da</data>
      <data key="d11">63817379791544a3be7789af12a6e22c</data>
      <data key="d12">11932</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="METANEFRINAS">
      <data key="d8">24.0</data>
      <data key="d9">FEOCROMOCITOMA, also known as pheochromocytoma, is a type of tumor that arises from the adrenal glands and is characterized by the excessive production of catecholamines. METANEFRINAS, or metanephrines, are important metabolites of catecholamines that are measured in urine tests for diagnosing pheochromocytoma. They serve as a key diagnostic marker for this condition, helping to confirm the presence of the tumor. The measurement of metanephrines is crucial in the diagnostic process for feocromocitomas, as elevated levels indicate the likelihood of the tumor's presence.</data>
      <data key="d10">8f5500c9a9e74d855b17365c80375df3,94ef3a3488643695a99523d5c9d1f606,a0b43d4a377fca32f55f83fd79e3d9e1</data>
      <data key="d11">db3bb4607de64b7899368fa1eda5b32e</data>
      <data key="d12">11933</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="YODO-COLESTEROL">
      <data key="d8">5.0</data>
      <data key="d9">Iodine-cholesterol treatment is a therapeutic option for patients diagnosed with malignant pheochromocytoma</data>
      <data key="d10">8f5500c9a9e74d855b17365c80375df3</data>
      <data key="d11">085eb667ab56422c977c0e12ec23ddf6</data>
      <data key="d12">11934</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="FENOXIBENZAMIDA">
      <data key="d8">15.0</data>
      <data key="d9">Fenoxibenzamida, also known as phenoxybenzamine, is utilized in the preoperative management of feocromocitomas (pheochromocytomas) to effectively control hypertensive episodes. This medication plays a crucial role in preparing patients for surgery by managing the symptoms associated with this type of tumor.</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a,8f5500c9a9e74d855b17365c80375df3</data>
      <data key="d11">6ab6f31e833a40a990a6b2429f245aca</data>
      <data key="d12">11935</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="TUMORES SECRETORES DE CATECOLAMINAS">
      <data key="d8">8.0</data>
      <data key="d9">Pheochromocytoma is a specific type of tumor that secretes catecholamines</data>
      <data key="d10">8f5500c9a9e74d855b17365c80375df3</data>
      <data key="d11">9769eb7469a440588011027a3ce11d1f</data>
      <data key="d12">11936</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="MIBG">
      <data key="d8">8.0</data>
      <data key="d9">MIBG is used diagnostically and therapeutically for pheochromocytoma due to its high affinity for chromaffin cells</data>
      <data key="d10">a0b43d4a377fca32f55f83fd79e3d9e1</data>
      <data key="d11">f8bbdc2983e44ca89b063175d419d5ee</data>
      <data key="d12">11937</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="D&#205;AZ P&#201;REZ JA">
      <data key="d8">11.0</data>
      <data key="d9">D&#237;az P&#233;rez JA is an author known for his contributions to the literature on pheochromocytomas, including a manual that discusses the condition and its management. His work provides valuable insights into feocromocitomas, a type of tumor that affects the adrenal glands and can lead to significant health issues if not properly managed.</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a,a0b43d4a377fca32f55f83fd79e3d9e1</data>
      <data key="d11">c4132e71842445b18b5bcaa09e763eb0</data>
      <data key="d12">11938</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="CRESPO HERN&#193;NDEZ I">
      <data key="d8">11.0</data>
      <data key="d9">Crespo Hern&#225;ndez I is an author known for his contributions to the literature on pheochromocytomas, including a manual that discusses the condition and its management. His work provides valuable insights into the understanding and treatment of feocromocitomas, contributing to the broader medical knowledge surrounding this adrenal gland tumor.</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a,a0b43d4a377fca32f55f83fd79e3d9e1</data>
      <data key="d11">dd52e3ffa4b14211914bfac9b88413a6</data>
      <data key="d12">11939</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="YOUNG WF, JR.">
      <data key="d8">1.0</data>
      <data key="d9">Young WF, Jr. has authored guidelines and literature on the clinical presentation and treatment of pheochromocytoma</data>
      <data key="d10">a0b43d4a377fca32f55f83fd79e3d9e1</data>
      <data key="d11">4739a77c8c8d4b4d82f2c74179ff9e46</data>
      <data key="d12">11940</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="ANTIDEPRESIVOS TRIC&#205;CLICOS">
      <data key="d8">7.0</data>
      <data key="d9">FEOCROMOCITOMA, also known as pheochromocytoma, is a type of tumor that arises from the adrenal glands and can lead to the overproduction of catecholamines, resulting in various symptoms such as hypertension. Antidepresivos tric&#237;clicos, or tricyclic antidepressants, are a class of medications used primarily to treat depression and certain anxiety disorders. However, these antidepressants can significantly affect the interpretation of diagnostic tests for pheochromocytoma. Specifically, they can interfere with the diagnostic process by impacting MIBG (metaiodobenzylguanidine) uptake, which is a crucial component in the imaging and diagnosis of pheochromocytomas. Therefore, the use of tricyclic antidepressants may complicate the accurate diagnosis of pheochromocytoma, necessitating careful consideration in clinical settings.</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a,a0b43d4a377fca32f55f83fd79e3d9e1</data>
      <data key="d11">450503d874ab41ec800682481848252d</data>
      <data key="d12">11941</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="CALCIOANTAGONISTAS">
      <data key="d8">6.0</data>
      <data key="d9">Calcioantagonistas can interfere with the diagnostic process for pheochromocytoma by affecting MIBG uptake</data>
      <data key="d10">a0b43d4a377fca32f55f83fd79e3d9e1</data>
      <data key="d11">5356fbd848234b66a0a879e5288e1878</data>
      <data key="d12">11942</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="ENFERMEDAD RENAL CR&#211;NICA">
      <data key="d8">1.0</data>
      <data key="d9">Enfermedad renal cr&#243;nica can invalidate the results of tests used to diagnose pheochromocytoma</data>
      <data key="d10">a0b43d4a377fca32f55f83fd79e3d9e1</data>
      <data key="d11">21dbb9366d0c476b8ba9e5cf9bcb4398</data>
      <data key="d12">11943</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="PARAGANGLIOMA">
      <data key="d8">8.0</data>
      <data key="d9">Feocromocitoma and paraganglioma are both types of tumors that secrete catecholamines</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a</data>
      <data key="d11">5a86d3e11b0f41869bb211b93b61b489</data>
      <data key="d12">11944</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="ENDOCRINE SOCIETY">
      <data key="d8">16.0</data>
      <data key="d9">The Endocrine Society offers comprehensive clinical guidelines for the management, diagnosis, and treatment of feochromocytomas. These guidelines are designed to assist healthcare professionals in effectively addressing this condition, ensuring that patients receive optimal care based on the latest evidence and best practices in the field of endocrinology.</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a,5fd3de876d776b591d7dfd812aa2873c</data>
      <data key="d11">362e7929dbdc43e6a0db47c492e955b2</data>
      <data key="d12">11945</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="HARRISON PRINCIPIOS DE MEDICINA INTERNA">
      <data key="d8">1.0</data>
      <data key="d9">Harrison's Principles of Internal Medicine includes information on feocromocitomas</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a</data>
      <data key="d11">946956e4f69945f9b0daf1a2af2dfd16</data>
      <data key="d12">11946</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="CRISIS HIPERTENSIVAS">
      <data key="d8">8.0</data>
      <data key="d9">Feocromocitomas can cause crisis hipertensivas if not properly managed</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a</data>
      <data key="d11">2bb48d97b1784b74bd941961fc89c3b7</data>
      <data key="d12">11947</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="TUMOR PRODUCTOR DE CATECOLAMINAS">
      <data key="d8">1.0</data>
      <data key="d9">Feochromocytoma is a type of tumor that produces catecholamines</data>
      <data key="d10">5fd3de876d776b591d7dfd812aa2873c</data>
      <data key="d11">5903522b9cf54d7ea608b6348faeb32d</data>
      <data key="d12">11948</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="GEN RET">
      <data key="d8">6.0</data>
      <data key="d9">Mutations in the RET gene can increase the risk of developing feochromocytomas</data>
      <data key="d10">5fd3de876d776b591d7dfd812aa2873c</data>
      <data key="d11">acf24ff3c8c34063baa45eaa4166a2c3</data>
      <data key="d12">11949</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="GEN VHL">
      <data key="d8">14.0</data>
      <data key="d9">Feocromocitoma, a type of tumor that arises from the adrenal glands, is often associated with mutations in the VHL gene. This genetic link suggests that individuals with mutations in the VHL gene have an increased risk of developing feochromocytomas, as well as other types of tumors. The relationship between feocromocitoma and the VHL gene underscores the importance of genetic factors in the development of this condition.</data>
      <data key="d10">0ec21b45b9a154289761f46105b364f2,5fd3de876d776b591d7dfd812aa2873c</data>
      <data key="d11">99e275aa79ef4888ab43f8fd89a87486</data>
      <data key="d12">11950</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="GEN SDHB">
      <data key="d8">6.0</data>
      <data key="d9">The SDHB gene is linked to hereditary forms of feochromocytoma and paraganglioma</data>
      <data key="d10">5fd3de876d776b591d7dfd812aa2873c</data>
      <data key="d11">6b755692ba3f47e5a7028b7aa41bf852</data>
      <data key="d12">11951</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="GEN SDHC">
      <data key="d8">1.0</data>
      <data key="d9">Mutations in the SDHC gene can lead to familial paragangliomas and feochromocytomas</data>
      <data key="d10">5fd3de876d776b591d7dfd812aa2873c</data>
      <data key="d11">f0775a4fb82f45e286a1cdb1e3213fba</data>
      <data key="d12">11952</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="S&#205;NDROME DE VON HIPPEL-LINDAU">
      <data key="d8">8.0</data>
      <data key="d9">Feocromocitomas are commonly associated with Von Hippel-Lindau syndrome, which increases the risk of developing these tumors</data>
      <data key="d10">c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">a9a8f6c81138438a99f761a1ec8182a0</data>
      <data key="d12">11953</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="NEOPLASIA ENDOCRINA M&#218;LTIPLE TIPO 2">
      <data key="d8">14.0</data>
      <data key="d9">Feocromocitomas, a type of tumor that arises from the adrenal glands, can occur in patients with Neoplasia Endocrina M&#250;ltiple Tipo 2 (Multiple Endocrine Neoplasia Type 2), indicating a genetic predisposition to this condition. Individuals with Multiple Endocrine Neoplasia Type 2 have an increased risk of developing feocromocitomas, highlighting the interconnectedness of these two entities in the context of hereditary endocrine disorders.</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606,c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">bb44cda256054abfa41ca32e119aebb9</data>
      <data key="d12">11954</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="NEUROFIBROMATOSIS DE TIPO 1">
      <data key="d8">4.0</data>
      <data key="d9">Feocromocitomas can be associated with Neurofibromatosis type 1, although this is less common compared to other syndromes</data>
      <data key="d10">c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">26dbfa0a697a43d2a5ccf54bbc70f50b</data>
      <data key="d12">11955</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="SDHB">
      <data key="d8">13.0</data>
      <data key="d9">FEOCROMOCITOMA is associated with mutations in the SDHB gene, which are linked to hereditary forms of this tumor. These mutations indicate a genetic risk factor for the development of feocromocitomas, suggesting that individuals with such mutations may have an increased likelihood of developing this type of tumor.</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606,c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">52c63f27be7d42fbb4e073815aaa1b28</data>
      <data key="d12">11956</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="SDHC">
      <data key="d8">7.0</data>
      <data key="d9">Mutations in the SDHC gene are associated with feocromocitomas, contributing to the genetic understanding of these tumors</data>
      <data key="d10">c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">124db012ad384acbbb623c066c3492bf</data>
      <data key="d12">11957</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="VHL">
      <data key="d8">14.0</data>
      <data key="d9">The VHL gene is associated with the development of feocromocitomas, particularly in patients diagnosed with Von Hippel-Lindau (VHL) syndrome. This genetic condition significantly increases the risk of developing feocromocitomas, which are tumors that arise from the adrenal glands. Thus, individuals with VHL syndrome are at a heightened risk for these types of tumors due to the implications of the VHL gene in their pathogenesis.</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606,c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">59a2c8a46ff04cfbbebc218453da4877</data>
      <data key="d12">11958</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="SDHD">
      <data key="d8">7.0</data>
      <data key="d9">The SDHD gene is associated with the risk of developing feocromocitomas, particularly in relation to hypoxia</data>
      <data key="d10">c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">bcc40af765664076aec3c27efb85b332</data>
      <data key="d12">11959</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="TAC">
      <data key="d8">1.0</data>
      <data key="d9">A TAC is commonly used to detect feocromocitomas by providing detailed imaging of the adrenal glands</data>
      <data key="d10">c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">b679fe2e1bae4c5686d3029d33cfdc9d</data>
      <data key="d12">11960</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="PARAGANGLIOMAS">
      <data key="d8">6.0</data>
      <data key="d9">Paragangliomas are often associated with feocromocitomas, sharing similar genetic predispositions and clinical features</data>
      <data key="d10">c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">c1a1524faea94a7ab1dab14407ef3aec</data>
      <data key="d12">11961</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="GENES DE SUSCEPTIBILIDAD">
      <data key="d8">1.0</data>
      <data key="d9">Genes of susceptibility are linked to the development of feocromocitomas, indicating a genetic risk factor for these tumors</data>
      <data key="d10">c77f2833180015d5264f465f51c441f3</data>
      <data key="d11">f63fc9faeab54786bdcb15ab7e928383</data>
      <data key="d12">11962</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="SUPRARRENAL">
      <data key="d8">9.0</data>
      <data key="d9">Feocromocitomas are tumors that develop in the suprarrenal glands, leading to hypertension</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">741c02876923495182e21aca86fc2be6</data>
      <data key="d12">11963</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="TAC ABDOMINAL">
      <data key="d8">8.0</data>
      <data key="d9">TAC abdominal is performed to identify the presence of feocromocitomas in the adrenal glands</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">292e1bb5858f4836a3fba9150ce5f56c</data>
      <data key="d12">11964</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="ANATOMOPATOL&#211;GICO">
      <data key="d8">8.0</data>
      <data key="d9">Anatomopathological reports are used to confirm the diagnosis of feocromocitomas</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">701fc8a0ef3646938a918fefe1b65f6b</data>
      <data key="d12">11965</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="GEN&#201;TICO">
      <data key="d8">8.0</data>
      <data key="d9">Genetic studies are conducted to identify mutations that may lead to feocromocitomas</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">3901ffb395b7479f9d7ce1656d09c449</data>
      <data key="d12">11966</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="NEUROFIBROMATOSIS TIPO 1">
      <data key="d8">1.0</data>
      <data key="d9">Neurofibromatosis Type 1 can be associated with feocromocitomas, although less frequently</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">b1559b94eb4b4aceb1d32c1b549f38a8</data>
      <data key="d12">11967</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="SUPRARRENALCTOM&#205;A BILATERAL">
      <data key="d8">9.0</data>
      <data key="d9">Bilateral adrenalectomy is performed to treat feocromocitomas</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">2a3cb5b9332e4793bb36d808d18b3752</data>
      <data key="d12">11968</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FEOCROMOCITOMA" target="HALLAZGO">
      <data key="d8">7.0</data>
      <data key="d9">Findings from imaging studies can indicate the presence of feocromocitomas</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">e6c770aabe8a42fe941de930870480c5</data>
      <data key="d12">11969</data>
