      <data key="d10">54633fef79a422c0fada846ff2b861ba</data>
      <data key="d11">f9049fed26184f73a2bdebfd2c76e545</data>
      <data key="d12">11388</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HOSPITALIZATION" target="COSTS OF CARE">
      <data key="d8">1.0</data>
