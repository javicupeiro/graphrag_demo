    </edge>
    <edge source="LITIASIS RENAL" target="NATIONAL HEALTH AND NUTRITION EXAMINATION SURVEY">
      <data key="d8">6.0</data>
      <data key="d9">NHANES proporciona datos sobre la prevalencia de litiasis renal en la poblaci&#243;n de EE.UU.</data>
      <data key="d10">b703f173982cf68d36653cc0d9cc1fcb</data>
      <data key="d11">1a4e202377d144a396ff00a3c1de497c</data>
      <data key="d12">15207</data>
