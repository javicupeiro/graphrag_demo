      <data key="d13">2</data>
    </edge>
    <edge source="HYPERPROLACTINEMIA" target="RISPERIDONA">
      <data key="d8">8.0</data>
      <data key="d9">La risperidona es un medicamento que frecuentemente causa hiperprolactinemia</data>
