      <data key="d5">0</data>
      <data key="d6">16947</data>
      <data key="d7">6ee293f0f74b4702bae7a844b0e84e15</data>
    </node>
    <node id="CAPSULE">
      <data key="d0">EVENT</data>
      <data key="d1">The form in which medications like Neurodavur and Neuromade are delivered, typically for oral consumption.</data>
      <data key="d2">86129e76900522a439d2234eea76e3b9</data>
      <data key="d5">0</data>
      <data key="d6">16948</data>
