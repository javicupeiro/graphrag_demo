      <data key="d8">9.0</data>
      <data key="d9">Frequent glycemic monitoring is necessary to prevent the onset of diabetic ketoacidosis</data>
      <data key="d10">ac2955cad85e541f3b61de2f4df0a3a9</data>
      <data key="d11">889ef7ad00b84577b592b3462428fe38</data>
