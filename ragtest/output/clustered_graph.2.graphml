    <node id="ACIDOS GRASOS MONOINSATURADOS">
      <data key="d0">EVENT</data>
      <data key="d1">&#193;cidos Grasos Monoinsaturados are healthy fats recommended for individuals with diabetes, particularly in the context of the Mediterranean diet.</data>
      <data key="d2">f558c372d16630f14b614e232fc151de</data>
