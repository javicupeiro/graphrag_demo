      <data key="d10">05a2506becec805cd1374d73de9a9fec</data>
      <data key="d11">019bcd54ac3b47d395baa31a4809b2cf</data>
      <data key="d12">7797</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES" target="ESCAPES DEL CONTENIDO G&#193;STRICO">
      <data key="d8">8.0</data>
