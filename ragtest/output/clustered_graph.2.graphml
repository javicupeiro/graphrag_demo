    </node>
    <node id="NEFROGENICA">
      <data key="d0">EVENT</data>
      <data key="d1">Nephrogenic diabetes insipidus is a rare condition where the kidneys fail to respond to antidiuretic hormone, leading to excessive urination and thirst.</data>
      <data key="d2">773a1daa539dd85e562a59e09f434af1</data>
      <data key="d3">1574</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6205</data>
      <data key="d7">c567bdc233fc44d98b88fb35915fbe98</data>
    </node>
    <node id="DIN">
      <data key="d0">EVENT</data>
      <data key="d1">Diabetes insipidus nephrogenic (DIN) is a condition characterized by the kidneys' inability to concentrate urine, leading to excessive urination and thirst.</data>
      <data key="d2">1fb4c8ba1bc908ea3a3c7717a073fa4f</data>
      <data key="d3">1573</data>
      <data key="d4">2</data>
      <data key="d5">14</data>
