    <node id="ALTERACI&#211;N PAR&#201;NQUIMA PULMONAR">
      <data key="d0">EVENT</data>
      <data key="d1">Alteration of pulmonary parenchyma refers to changes in the lung tissue that can affect respiratory function, commonly observed in EPOC.</data>
      <data key="d2">ddd48beea3c882bf1a651cb25283ba91</data>
      <data key="d3">1037</data>
      <data key="d4">2</data>
