    </edge>
    <edge source="VLCD" target="REAL DECRETO 1430/1997">
      <data key="d8">7.0</data>
      <data key="d9">El Real Decreto 1430/1997 incorpora la regulaci&#243;n de las dietas VLCD en el ordenamiento jur&#237;dico espa&#241;ol</data>
      <data key="d10">3926ed628d3d5919b8a65e44fffbc3b9</data>
      <data key="d11">f1642ff3b13e4f81b1c78188f0a72b2e</data>
