      <data key="d7">5856c09daad7484a860d2060ed69d590</data>
    </node>
    <node id="DIETA DE HAY">
      <data key="d0">EVENT</data>
      <data key="d1">The Hay Diet is a disassociative diet that separates food types to aid in weight loss, often categorized as a miracle diet.</data>
      <data key="d2">64347a9be918a67f786cbdf9f9db9c8a</data>
      <data key="d3">1374</data>
      <data key="d4">2</data>
