    <edge source="DIHYDROTESTOSTERONE" target="5&#913;-REDUCTASE TYPE 2">
      <data key="d8">1.0</data>
      <data key="d9">5&#945;-reductase type 2 is the enzyme that converts testosterone into dihydrotestosterone, playing a key role in male development.</data>
      <data key="d10">766fec9f74738cf0af53aee77d58dc78</data>
      <data key="d11">005d6d0f0f344776a074289b17b53eda</data>
