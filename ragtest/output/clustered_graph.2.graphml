      <data key="d7">1602453296dc499ba779d08ff7c0fa2e</data>
    </node>
    <node id="HETEROCIGOTOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los heterocigotos compuestos para las mutaciones pat&#243;genas en el gen CYP21A2 son comunes en pacientes con hiperplasia suprarrenal cong&#233;nita.</data>
      <data key="d2">095d265c06452e52ccbfbc871a19a899</data>
      <data key="d3">1288</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
