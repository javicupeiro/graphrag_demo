      <data key="d5">1</data>
      <data key="d6">9804</data>
      <data key="d7">bed1ffd46746473f9f606d0b0a2cf074</data>
    </node>
    <node id="PASTELES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">PASTELES are baked goods that typically contain gluten, making them unsuitable for individuals with celiac disease. However, it is important to note that cakes can vary in their gluten content, and some may be specifically made to accommodate gluten-free diets. This means that while many traditional pasteles are harmful to those with gluten sensitivities, there are also options available that cater to gluten-free needs.</data>
      <data key="d2">7d2050a2481adc105bdebbcf2af1a173,f713611b23199b8a9eb9c28377b9f128</data>
      <data key="d3">816</data>
