      <data key="d11">83a2354d953143fab36e9953fc05750c</data>
      <data key="d12">6854</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="DIETA DE HEMODI&#193;LISIS">
      <data key="d8">9.0</data>
