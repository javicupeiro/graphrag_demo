    <edge source="NUTRICI&#211;N ENTERAL" target="HEMODIALISIS">
      <data key="d8">6.0</data>
      <data key="d9">Patients undergoing hemodialysis may require enteral nutrition to meet their dietary needs.</data>
      <data key="d10">00467cf9f31ccb0046bfd36ff48c4448</data>
