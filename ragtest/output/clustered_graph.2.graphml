      <data key="d11">49ef9ba1edcd4eaca3d4fc831100e66a</data>
      <data key="d12">8629</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SELENIO" target="ALIMENTOS RICOS EN SELENIO">
      <data key="d8">6.0</data>
      <data key="d9">Foods rich in selenium are necessary for maintaining adequate selenium levels in the diet.</data>
