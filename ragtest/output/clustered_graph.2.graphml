      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS SATURADOS" target="RIESGO DE ENFERMEDAD CORONARIA">
      <data key="d8">6.0</data>
      <data key="d9">Saturated fatty acids can increase the risk of coronary disease when consumed in excess</data>
