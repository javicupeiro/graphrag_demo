      <data key="d7">d6f65b977f22400a8e59dc8e2f6a928a</data>
    </node>
    <node id="EXERCISE PHYSICAL">
      <data key="d0">EVENT</data>
      <data key="d1">Physical exercise is recommended to be combined with protein intake to prevent muscle loss in elderly individuals.</data>
      <data key="d2">2f194bef97e28167f81acc7a66ac56ab</data>
      <data key="d5">0</data>
      <data key="d6">3324</data>
      <data key="d7">d83344c2d0574ba1be1f38221923146e</data>
    </node>
    <node id="MUSCLE SYNTHESIS">
      <data key="d0">EVENT</data>
      <data key="d1">Muscle synthesis is the process of building muscle tissue, which can be enhanced by adequate protein intake and exercise.</data>
      <data key="d2">2f194bef97e28167f81acc7a66ac56ab</data>
