    <node id="BISTRIAN B">
      <data key="d0">PERSON</data>
      <data key="d1">Bistrian B is an author who co-authored research on malnutrition syndromes and their continuum in clinical settings.</data>
      <data key="d2">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d3">733</data>
      <data key="d4">2</data>
