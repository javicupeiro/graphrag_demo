      <data key="d13">2</data>
    </edge>
    <edge source="PKU" target="DETERMINACI&#211;N DE AA EN SANGRE">
      <data key="d8">8.0</data>
      <data key="d9">Blood amino acid determination is a key diagnostic tool for identifying PKU by detecting characteristic amino acid profiles.</data>
      <data key="d10">06b374fc6a6ebf2091ac0a00329bd027</data>
      <data key="d11">1757ed9ac9c04877bb4712d24c1d22f3</data>
