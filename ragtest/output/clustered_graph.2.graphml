      <data key="d0">ORGANIZATION</data>
      <data key="d1">La Agencia Europea de Seguridad Alimentaria (EFSA) eval&#250;a las bases cient&#237;ficas de las declaraciones sobre la salud de los alimentos.</data>
      <data key="d2">e4edae03f8089b7bc1c46e697e658e3c</data>
