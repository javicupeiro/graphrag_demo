    <node id="H&#205;GADO FETAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">El h&#237;gado fetal es un &#243;rgano de donde se pueden obtener c&#233;lulas hematopoy&#233;ticas en casos espec&#237;ficos de trasplante.</data>
