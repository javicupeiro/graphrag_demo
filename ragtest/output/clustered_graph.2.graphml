      <data key="d1">Certain neurological diseases may be treated with ketogenic diets, which can involve enteral nutrition.</data>
      <data key="d2">0df5ab4ef9db16004ddebefc8290f5f2</data>
      <data key="d5">0</data>
      <data key="d6">16273</data>
