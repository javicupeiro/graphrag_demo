      <data key="d6">9359</data>
      <data key="d7">8248b42c4d0344eab00b328c6cd8611b</data>
    </node>
    <node id="NUTRITIONAL FORMULAS RICH IN FAT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Nutritional formulas rich in fat are specialized dietary products designed to help manage blood sugar levels in patients with diabetes.</data>
      <data key="d2">502bae6c907e900b95f5fe6aa963b0fc</data>
      <data key="d3">1719</data>
      <data key="d4">2</data>
