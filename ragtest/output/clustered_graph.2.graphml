    </node>
    <node id="COLEGIOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los colegios son instituciones educativas que tambi&#233;n deben informar sobre los alimentos que sirven a los estudiantes.</data>
      <data key="d2">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d3">635</data>
      <data key="d4">2</data>
