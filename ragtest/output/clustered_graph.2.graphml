    <edge source="ENFERMEDADES NEURODEGENERATIVAS" target="SUPPRESI">
      <data key="d8">1.0</data>
      <data key="d9">Suppresi is a nutritional product designed to support individuals with neurodegenerative diseases (enfermedades neurodegenerativas)</data>
