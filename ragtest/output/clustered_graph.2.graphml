    <edge source="ACIDOSIS METAB&#211;LICA" target="CETOACIDOSIS">
      <data key="d8">9.0</data>
      <data key="d9">Cetoacidosis is characterized by metabolic acidosis due to the accumulation of ketone bodies</data>
