    </node>
    <node id="GASTRECTOMIZADAS">
      <data key="d0">PERSON</data>
      <data key="d1">Gastrectomizadas refers to individuals who have undergone gastrectomy, affecting their Vitamin B&#8321;&#8322; absorption.</data>
      <data key="d2">2cff1005fe34ac994249b78b4ca112c7</data>
      <data key="d5">0</data>
      <data key="d6">3519</data>
      <data key="d7">f12a5be20fb24a3d88311750748e6a6f</data>
    </node>
    <node id="COLISTIRAMINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Colestiramina is a medication that can interfere with the absorption of Vitamin B&#8321;&#8322;. It is recommended that Colestiramina be taken with meals to help decrease gastrointestinal discomfort.</data>
      <data key="d2">04f886244ff7d736eb270f175d6b120e,2cff1005fe34ac994249b78b4ca112c7</data>
      <data key="d5">0</data>
      <data key="d6">3520</data>
