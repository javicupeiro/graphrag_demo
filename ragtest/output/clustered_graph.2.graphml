      <data key="d12">7097</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FIBROSIS QU&#205;STICA" target="HARRIS-BENEDICT">
      <data key="d8">8.0</data>
      <data key="d9">The Harris-Benedict formula is used to estimate caloric requirements for patients with cystic fibrosis</data>
      <data key="d10">a4886f74d848ccd61cefcaab3103f233</data>
