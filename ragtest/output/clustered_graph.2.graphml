      <data key="d1">Ballmann M is a researcher involved in clinical trials related to diabetes management in cystic fibrosis patients.</data>
      <data key="d2">1e997b2a6bf1c926a7a17d8b5ac1e699</data>
      <data key="d3">1042</data>
