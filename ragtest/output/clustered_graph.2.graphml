      <data key="d11">d5484f5fd66a43c6936e4614451573e0</data>
      <data key="d12">12681</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GALACTORREA" target="D">
      <data key="d8">6.0</data>
      <data key="d9">D exhibits galactorrea, which is a symptom related to elevated prolactin levels in MEN1</data>
      <data key="d10">fbba0b43850ff5e50b710069959c2416</data>
      <data key="d11">c0cc2ab110b146cfb1a62c5b683daa5a</data>
      <data key="d12">12682</data>
      <data key="d13">2</data>
    </edge>
