    <node id="JOURNAL OF GASTROINTESTINAL SURGERY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A publication that features research and studies related to gastrointestinal surgery, including nutritional aspects.</data>
      <data key="d2">0a742cf103e30cf0fadaf6ffabbbde2d</data>
      <data key="d3">742</data>
      <data key="d4">2</data>
