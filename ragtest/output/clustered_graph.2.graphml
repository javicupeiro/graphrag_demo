    </node>
    <node id="CARDIOVASCULAR HEALTH STUDY FRAILTY SCREENING SCALE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Cardiovascular Health Study Frailty Screening Scale is a tool designed to assess frailty in older adults based on cardiovascular health.</data>
      <data key="d2">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d3">261</data>
