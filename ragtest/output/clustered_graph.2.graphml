    </node>
    <node id="BIRDSELL L">
      <data key="d0">PERSON</data>
      <data key="d1">Birdsell L is a co-author of the research on cancer cachexia, focusing on muscle depletion as a prognostic factor.</data>
      <data key="d2">fb7b0d121f195e2a472f3d47e28ccff9</data>
      <data key="d3">1206</data>
