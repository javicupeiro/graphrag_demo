    <node id="ASOCIACI&#211;N ESPA&#209;OLA DE CEL&#205;ACOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Asociaci&#243;n Espa&#241;ola de Cel&#237;acos is an organization that authorizes foods suitable for a gluten-free diet for patients with celiac disease.</data>
      <data key="d2">8a7b2d5e0440750e36603c8d3f93a68a</data>
