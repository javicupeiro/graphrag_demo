      <data key="d6">1974</data>
      <data key="d7">0b501c3ea4cc4e29b49c7a5c119a7f59</data>
    </node>
    <node id="TRAUMA">
      <data key="d0">EVENT</data>
      <data key="d1">TRAUMA refers to physical or psychological injuries that can significantly impact an individual's well-being. It can lead to increased nutritional needs, particularly for amino acids, which are essential for recovery.</data>
      <data key="d2">651bf69cdd5aec52b456cbea567f1987,cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d3">1923</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">1975</data>
      <data key="d7">9c51f61277da436c97bd4dd2aee83b55</data>
    </node>
    <node id="RENAL INSUFFICIENCY">
      <data key="d0">EVENT</data>
      <data key="d1">A medical condition where the kidneys are unable to filter waste effectively, affecting protein and amino acid needs.</data>
      <data key="d2">cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d3">1266</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
