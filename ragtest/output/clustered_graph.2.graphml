    </edge>
    <edge source="POTASIO" target="LACTANTE DE 6 MESES">
      <data key="d8">8.0</data>
      <data key="d9">The potassium levels in the infant are monitored to assess kidney function and overall health</data>
      <data key="d10">a1b16c80a55fd88d0b1efb78addf3853</data>
      <data key="d11">c2203fb347004b0f9faed37f519b2a15</data>
