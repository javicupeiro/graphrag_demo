    </node>
    <node id="LACTANTE DE 6 MESES">
      <data key="d0">PERSON</data>
      <data key="d1">A 6-month-old infant presenting with dehydration and electrolyte imbalances, indicative of potential underlying health issues.</data>
      <data key="d2">a1b16c80a55fd88d0b1efb78addf3853</data>
      <data key="d3">628</data>
      <data key="d4">2</data>
