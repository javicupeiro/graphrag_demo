      <data key="d7">6dc65f37d0644273b2de65ed29fc16db</data>
    </node>
    <node id="JOURNAL OF GASTROENTEROLOGY AND HEPATOLOGY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A journal that covers research related to gastroenterology, including nutritional studies for gastric cancer patients.</data>
      <data key="d2">0a742cf103e30cf0fadaf6ffabbbde2d</data>
      <data key="d3">742</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13413</data>
      <data key="d7">f4d095be507c475392b3efe63aa9af00</data>
    </node>
    <node id="BODY MASS INDEX">
      <data key="d0">EVENT</data>
      <data key="d1">Body Mass Index (BMI) is a significant measure that assesses nutritional status and can influence perioperative outcomes and survival rates following gastric cancer resection. It serves as an important indicator in evaluating the health and nutritional condition of individuals, particularly in the context of cancer outcomes.</data>
      <data key="d2">0a742cf103e30cf0fadaf6ffabbbde2d,bef1f848ac9b922f7361b740210a8314</data>
      <data key="d3">742</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">13414</data>
      <data key="d7">fad354012a4446f3b825c0a71683ef40</data>
    </node>
    <node id="NUTRITIONAL INDEX">
      <data key="d0">EVENT</data>
      <data key="d1">The prognostic nutritional index is a tool used to predict the biological aggressiveness of gastric carcinoma.</data>
      <data key="d2">0a742cf103e30cf0fadaf6ffabbbde2d</data>
      <data key="d3">742</data>
      <data key="d4">2</data>
