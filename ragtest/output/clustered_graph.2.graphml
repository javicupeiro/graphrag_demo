      <data key="d5">3</data>
      <data key="d6">8072</data>
      <data key="d7">55e8a05f9ada46a5a7d489592e727e32</data>
    </node>
    <node id="HOLANDA">
      <data key="d0">GEO</data>
      <data key="d1">Holland has successfully implemented programs to combat malnutrition since 2007, aiming to gradually reduce its prevalence across all healthcare levels.</data>
      <data key="d2">ba214f6f228224af19c5ca2dcc9c6772</data>
      <data key="d3">685</data>
