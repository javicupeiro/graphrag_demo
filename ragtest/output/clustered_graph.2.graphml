    <node id="THYROID NODULE">
      <data key="d0">EVENT</data>
      <data key="d1">Thyroid nodules are growths in the thyroid gland that may require evaluation and management based on their characteristics and risk of malignancy.</data>
      <data key="d2">cb3b93a50040c892ecf439582ebb6ac0</data>
