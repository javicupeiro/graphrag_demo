      <data key="d11">3123bf2f37b642f7ab6fd05ab6b516ba</data>
      <data key="d12">12673</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROLACTINOMA" target="AGONISTAS DOPAMIN&#201;RGICOS">
      <data key="d8">7.0</data>
      <data key="d9">Los agonistas dopamin&#233;rgicos son el tratamiento de elecci&#243;n para reducir los niveles de prolactina en pacientes con prolactinomas</data>
      <data key="d10">b157600f59e67793829a144ddaff24df</data>
      <data key="d11">db4048b2a93544c08f6a588c34a84162</data>
      <data key="d12">12674</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROLACTINOMA" target="CABERGOLINA">
      <data key="d8">17.0</data>
      <data key="d9">Prolactinoma is a type of pituitary tumor that produces excess prolactin, leading to hyperprolactinemia. Cabergolina is a treatment option for managing prolactinoma, effectively controlling the symptoms associated with this condition. It is specifically used to manage prolactinomas and regulate elevated prolactin levels in the body.</data>
      <data key="d10">a1403e657780088123382f4725789e67,b530539793a70d1223f3307aa47777fe</data>
      <data key="d11">c2a8f547e74645e9a5b47ef53abe00f2</data>
      <data key="d12">12675</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROLACTINOMA" target="HYPERPROLACTINEMIA">
      <data key="d8">9.0</data>
      <data key="d9">Hyperprolactinemia is often caused by prolactinomas, which produce excess prolactin</data>
      <data key="d10">b530539793a70d1223f3307aa47777fe</data>
      <data key="d11">c03d8e3ba0624022921bdec9f03de4f5</data>
      <data key="d12">12676</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROLACTINOMA" target="MACROPROLACTINOMA">
      <data key="d8">8.0</data>
      <data key="d9">Macroprolactinoma is a subtype of prolactinoma that is larger in size and may require different treatment approaches</data>
      <data key="d10">b530539793a70d1223f3307aa47777fe</data>
      <data key="d11">034d757094b24258a454f736a61b6dec</data>
      <data key="d12">12677</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROLACTINOMA" target="MICROPROLACTINOMA">
      <data key="d8">1.0</data>
      <data key="d9">Microprolactinoma is a subtype of prolactinoma that is smaller and typically managed with medication</data>
      <data key="d10">b530539793a70d1223f3307aa47777fe</data>
      <data key="d11">49a61749a60d40058aae2f488da7d11b</data>
      <data key="d12">12678</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROLACTINOMA" target="IPILIMUMAB">
      <data key="d8">6.0</data>
      <data key="d9">Ipilimumab can lead to hypophysitis, which may affect prolactin levels in patients with prolactinoma</data>
      <data key="d10">a1403e657780088123382f4725789e67</data>
      <data key="d11">47e9a38b93ec4a929d6a614b9e2da5f8</data>
      <data key="d12">12679</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROLACTINOMA" target="VERAPAMILO">
      <data key="d8">1.0</data>
      <data key="d9">Verapamil is associated with causing hyperprolactinemia, which can complicate the management of prolactinoma</data>
      <data key="d10">a1403e657780088123382f4725789e67</data>
      <data key="d11">a0fee7fb112649159ec5095ee58c5a31</data>
      <data key="d12">12680</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GALACTORREA" target="HYPERPROLACTINEMIA">
      <data key="d8">6.0</data>
      <data key="d9">La hiperprolactinemia a menudo se presenta con galactorrea como s&#237;ntoma</data>
