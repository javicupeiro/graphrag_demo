    <node id="NUTRITIONAL ASSESSMENT IN HOSPITAL">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional assessment in hospitals is a process to evaluate the nutritional status of patients, particularly the elderly.</data>
      <data key="d2">65143afbc494705be9ccc4e48bee296b</data>
