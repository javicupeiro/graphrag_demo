      <data key="d6">12263</data>
      <data key="d7">9599f9fc13194bc18b5f8c5c8f3c6321</data>
    </node>
    <node id="CALCIFICACIONES PANCRE&#193;TICAS">
      <data key="d0">EVENT</data>
      <data key="d1">Pancreatic calcifications are a classic finding in chronic pancreatitis, indicating permanent damage to the gland.</data>
      <data key="d2">803363886f385b089938bf122246dfa2</data>
      <data key="d3">198</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
