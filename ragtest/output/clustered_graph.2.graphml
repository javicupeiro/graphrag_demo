    <node id="S. MART&#205;N SANCHIS">
      <data key="d0">PERSON</data>
      <data key="d1">S. Mart&#237;n Sanchis is an author contributing to the chapter on enteral nutrition, discussing its concepts and applications.</data>
      <data key="d2">bd297992bd38c0b110dd5f0cae141f83</data>
