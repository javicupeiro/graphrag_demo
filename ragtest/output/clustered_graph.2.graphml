    <edge source="ADRENOLEUCODISTROFIA" target="CYP21A2">
      <data key="d8">1.0</data>
      <data key="d9">CYP21A2 antibodies are relevant in diagnosing adrenal insufficiency, which can be associated with adrenoleukodystrophy</data>
      <data key="d10">4eb5a5cd6147917dd1380d49c613a78b</data>
