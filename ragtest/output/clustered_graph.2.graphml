      <data key="d5">2</data>
      <data key="d6">10513</data>
      <data key="d7">caeb53a3b5394798821c35777ebb5c34</data>
    </node>
    <node id="ATROFIA VELLOSITARIA">
      <data key="d0">EVENT</data>
      <data key="d1">Villus atrophy is a condition characterized by the flattening of the intestinal villi, commonly seen in patients with celiac disease.</data>
      <data key="d2">e6153f0024d75c281071b521b08ed53a</data>
      <data key="d3">807</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">10514</data>
      <data key="d7">83363929ef4d4c5685ca7c60f7e763f1</data>
    </node>
    <node id="GASTROENTERITIS EOSINOF&#205;LICA">
      <data key="d0" />
      <data key="d1">Gastroenteritis eosinof&#237;lica is an inflammatory condition of the gastrointestinal tract that is associated with food allergies. It can occur at any age and is characterized by severe gastrointestinal symptoms. A key feature of this condition is the presence of eosinophils in gastric or intestinal biopsies, which helps in its diagnosis.</data>
      <data key="d2">693b5721c7fc52c8165c48b580777840,9d84c9c66c832dd17e7247a6966c2ea1,e6153f0024d75c281071b521b08ed53a</data>
