    </edge>
    <edge source="MNA" target="ESTANCIA MEDIA">
      <data key="d8">1.0</data>
      <data key="d9">MNA may help in predicting the average length of stay for patients based on their nutritional assessment</data>
      <data key="d10">79b6030cb061514423118a8c4214b5e4</data>
