    <edge source="NUTRICI&#211;N ENTERAL" target="DIETAS MONOM&#201;RICAS">
      <data key="d8">8.0</data>
      <data key="d9">Las dietas monom&#233;ricas son un tipo de producto utilizado en la nutrici&#243;n enteral</data>
      <data key="d10">2def4be9506db96f8bdfe9e3ba6f9b6f</data>
      <data key="d11">0882630beb9049528bd714a37c7ce1c1</data>
