      <data key="d11">a7274898bf98472dab6d25d31fbad7d7</data>
      <data key="d12">7805</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES" target="NUTRICI&#211;N PARENTERAL SUPLEMENTARIA">
      <data key="d8">1.0</data>
      <data key="d9">La nutrici&#243;n parenteral suplementaria puede estar asociada con un aumento de complicaciones en algunos pacientes.</data>
      <data key="d10">40fbc53467b8460d1d2d6bcd0d6dbf2a</data>
      <data key="d11">cb17115005b24f65b4bd7a2d504bf184</data>
      <data key="d12">7806</data>
