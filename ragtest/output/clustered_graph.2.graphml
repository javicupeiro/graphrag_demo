      <data key="d11">e48fe2d434e24ffeae1d156a04848f0e</data>
      <data key="d12">5037</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA GAROF&#205;N" target="GOMA CARRAGENINA">
