      <data key="d10">90c684dca4542bbe1177afd26e78581e</data>
      <data key="d11">e6a764f3a38848e5af0a2da4b16cb3a5</data>
      <data key="d12">7237</data>
      <data key="d13">2</data>
    </edge>
    <edge source="WEIGHT LOSS" target="HBA1C REDUCTION">
      <data key="d8">7.0</data>
      <data key="d9">Weight loss is associated with a reduction in HbA1c levels in obese patients.</data>
      <data key="d10">64821313d6eb9af473ab515aff2ba3c7</data>
      <data key="d11">aedd80920dc34c86ab4a9cd904f50a6b</data>
      <data key="d12">7238</data>
      <data key="d13">2</data>
    </edge>
    <edge source="WEIGHT LOSS" target="TESOFENSINE">
      <data key="d8">6.0</data>
      <data key="d9">Tesofensine has been studied for its effects on weight loss in obese patients.</data>
      <data key="d10">64821313d6eb9af473ab515aff2ba3c7</data>
      <data key="d11">a3bc651a98314875a295ff9d835bbd11</data>
      <data key="d12">7239</data>
      <data key="d13">2</data>
    </edge>
    <edge source="WEIGHT LOSS" target="BELORANIB">
      <data key="d8">6.0</data>
      <data key="d9">Beloranib was evaluated for its efficacy in promoting weight loss in obese adults.</data>
      <data key="d10">64821313d6eb9af473ab515aff2ba3c7</data>
      <data key="d11">37439e589474455fa7880284cca5fb92</data>
      <data key="d12">7240</data>
      <data key="d13">2</data>
    </edge>
