      <data key="d5">9</data>
      <data key="d6">21</data>
      <data key="d7">f862acf7015346e8a6a46191e20a340e</data>
    </node>
    <node id="F&#201;LIX BRAVO SANZ">
      <data key="d0">PERSON</data>
      <data key="d1">F&#233;lix Bravo Sanz is the Director Manager of the Hospital Universitario Pr&#237;ncipe de Asturias. In this role, he oversees the hospital's operations and initiatives, including specific efforts related to oropharyngeal dysphagia. His leadership is integral to the management and strategic direction of the hospital, ensuring that various health initiatives are effectively implemented.</data>
      <data key="d2">c56e48073639b88eaeeaf183cbcdeb20,ea0b88195d04b227bedf7fa3cb3b6513</data>
