    <node id="JAPAN">
      <data key="d0">GEO</data>
      <data key="d1">Japan is the country where cetilistat, a drug similar to orlistat, is approved for use.</data>
      <data key="d2">22a361e57659e072600d6575631f6160</data>
      <data key="d3">324</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">8641</data>
      <data key="d7">9c65507a165b41e6a8b220aecc544fe4</data>
    </node>
    <node id="CETILISTAT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Cetilistat is a pharmaceutical treatment designed for obesity management, functioning as a gastric and pancreatic lipase inhibitor. It has been successfully tested in randomized controlled trials, demonstrating its efficacy in reducing body weight. Notably, cetilistat is associated with fewer side effects compared to orlistat, making it a potentially safer alternative for individuals seeking obesity treatment.</data>
      <data key="d2">22a361e57659e072600d6575631f6160,64821313d6eb9af473ab515aff2ba3c7</data>
      <data key="d3">324</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">8642</data>
      <data key="d7">85db6304f31c4d57a8929f6f840a2808</data>
    </node>
    <node id="TESOFENSINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Tesofensina is a drug used for treating Parkinson's disease that has shown potential for weight loss in clinical trials.</data>
      <data key="d2">22a361e57659e072600d6575631f6160</data>
      <data key="d3">961</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8643</data>
      <data key="d7">3d278da6cc0142dabbc862c60889f397</data>
    </node>
    <node id="BELORANIF">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Beloranif is a drug that inhibits MetAP2, reducing fat biosynthesis and increasing fat oxidation, showing significant weight loss in trials.</data>
      <data key="d2">22a361e57659e072600d6575631f6160</data>
      <data key="d3">324</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">8644</data>
      <data key="d7">1ff5935194c9435294c103dbb70e8adc</data>
    </node>
    <node id="BUPROPION-ZONISAMIDA">
      <data key="d0">ORGANIZATION</data>
