    <node id="PATRONES PERCENTILADOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los patrones percentilados son herramientas utilizadas para evaluar el crecimiento y el estado nutricional de los ni&#241;os en comparaci&#243;n con est&#225;ndares de referencia.</data>
