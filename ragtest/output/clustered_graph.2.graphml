    <node id="HEMATOL&#211;GIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hematology is a field of study that focuses on blood disorders, including anemia associated with malnutrition.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
      <data key="d3">1163</data>
      <data key="d4">2</data>
