    </node>
    <node id="CARDIOPAT&#205;A CONG&#201;NITA">
      <data key="d0">EVENT</data>
      <data key="d1">Congenital heart disease refers to a range of heart defects present at birth, which may require specialized nutritional support.</data>
      <data key="d2">8366a6776a090c4e13b4746a1b23e96f</data>
