      <data key="d6">16092</data>
      <data key="d7">96b4d0c0617747a398cfb5cecc8a396a</data>
    </node>
    <node id="PROTE&#205;NAS DE LA LECHE P">
      <data key="d0">INGREDIENT</data>
      <data key="d1">Milk proteins P are included in clinical nutrition products for their nutritional value and role in muscle maintenance.</data>
      <data key="d2">3d73ef14929e7391e915f739189e4dfa</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16093</data>
      <data key="d7">5bca4e7a786545259925c601dbbca16e</data>
    </node>
    <node id="ACEITE VEGETAL V1">
      <data key="d0">INGREDIENT</data>
      <data key="d1">Vegetable oil V1 is used in formulations to provide essential fatty acids and improve palatability.</data>
      <data key="d2">3d73ef14929e7391e915f739189e4dfa</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16094</data>
      <data key="d7">cac5498992ed4e978c88ad039ab93bba</data>
    </node>
    <node id="ACEITE VEGETAL V2">
      <data key="d0">INGREDIENT</data>
      <data key="d1">Vegetable oil V2 serves a similar purpose as V1, contributing to the nutritional profile of the product.</data>
      <data key="d2">3d73ef14929e7391e915f739189e4dfa</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16095</data>
      <data key="d7">d2689051964d42c997ca32963e108a7a</data>
    </node>
