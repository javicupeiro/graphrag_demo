    <node id="UNIT OF OROPHARYNGEAL DYSPHAGIA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Unit of Oropharyngeal Dysphagia at HUPA is dedicated to providing multidisciplinary care for patients with swallowing difficulties.</data>
