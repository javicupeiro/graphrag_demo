    </edge>
    <edge source="PACIENTE ANCIANO" target="ALTERACIONES DE LA MASTICACI&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">Las alteraciones de la masticaci&#243;n en pacientes ancianos requieren ajustes en la dieta para facilitar la alimentaci&#243;n.</data>
      <data key="d10">2f548ddee569586dbe82ca124f2695e9</data>
      <data key="d11">7e3414d7e89a4abe9948d6f0765170d8</data>
