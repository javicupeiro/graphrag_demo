    </node>
    <node id="FRAMINGHAM STUDY">
      <data key="d0">EVENT</data>
      <data key="d1">The Framingham Study is a long-term, ongoing cardiovascular cohort study of residents of the town of Framingham, Massachusetts, which has provided significant insights into the relationship between omega-3 levels and cognitive function.</data>
      <data key="d2">b3760fcb9c0421b66d37c20b1dc68577</data>
      <data key="d3">1214</data>
