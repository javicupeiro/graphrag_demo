      <data key="d0">EVENT</data>
      <data key="d1">Suplementaci&#243;n con calcio y vitamina D is recommended for patients on a ketogenic diet to prevent bone demineralization.</data>
      <data key="d2">bf7fc15e1aac41553dc6586efe68b8cb</data>
      <data key="d3">1940</data>
