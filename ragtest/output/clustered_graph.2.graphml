    <node id="KORNICH DB">
      <data key="d0">PERSON</data>
      <data key="d1">Kornich DB es un autor que ha colaborado en la investigaci&#243;n sobre el s&#237;ndrome de dumping y su prevalencia tras la cirug&#237;a bari&#225;trica.</data>
