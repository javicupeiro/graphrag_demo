      <data key="d6">8609</data>
      <data key="d7">7c5db70127594857a063e5f65cda25b0</data>
    </node>
    <node id="CONTRAVE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Contrave is a combination medication of bupropion and naltrexone approved in the USA for weight management.</data>
      <data key="d2">488970234520652b063db88e8346031c</data>
      <data key="d3">314</data>
      <data key="d4">1</data>
