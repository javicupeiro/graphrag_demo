      <data key="d5">1</data>
      <data key="d6">11350</data>
      <data key="d7">0ff23ac4554f420ebd1dec9b91ab133a</data>
    </node>
    <node id="ALIMENTOS PRECOCINADOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los alimentos precocinados son productos que suelen contener sodio para su conservaci&#243;n y sabor.</data>
