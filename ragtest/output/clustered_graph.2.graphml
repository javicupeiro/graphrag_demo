      <data key="d10">70bc9625e649f5e478fdef15e27dda58</data>
      <data key="d11">b946a170b08349e88fd29963db23a147</data>
      <data key="d12">14918</data>
      <data key="d13">2</data>
    </edge>
    <edge source="28-YEAR-OLD PATIENT" target="POLYCYSTIC OVARY SYNDROME">
      <data key="d8">8.0</data>
      <data key="d9">The 28-year-old patient is being evaluated for Polycystic Ovary Syndrome due to her symptoms of hirsutism and irregular menstrual cycles.</data>
      <data key="d10">70bc9625e649f5e478fdef15e27dda58</data>
      <data key="d11">09568b58d2cf45daad4916170f2c6dcb</data>
      <data key="d12">14919</data>
      <data key="d13">2</data>
    </edge>
    <edge source="POLYCYSTIC OVARY SYNDROME" target="HOMA INDEX">
      <data key="d8">7.0</data>
      <data key="d9">The HOMA index is used to assess insulin resistance, which is often elevated in patients with Polycystic Ovary Syndrome.</data>
      <data key="d10">dda58e50ce4bb9fa40e3c61e40e1b9c7</data>
      <data key="d11">5ca6e93a1693474290c3a659de725694</data>
      <data key="d12">14920</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIE-11" target="CIE-10">
      <data key="d8">7.0</data>
      <data key="d9">The CIE-10 is currently in use until the CIE-11 is implemented</data>
      <data key="d10">3779506e9a987b6bdf5da381df675430</data>
      <data key="d11">a8f5d5515a46471bb88dc54a83a496e1</data>
      <data key="d12">14921</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIE-10" target="TRASTORNO DE LA IDENTIDAD SEXUAL">
      <data key="d8">6.0</data>
      <data key="d9">The CIE-10 includes classifications for disorders of sexual identity</data>
      <data key="d10">3779506e9a987b6bdf5da381df675430</data>
      <data key="d11">881b8be5d6134ec68746380c03f8171e</data>
      <data key="d12">14922</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIE-10" target="TRASTORNO DEL COMPORTAMIENTO ALIMENTARIO">
      <data key="d8">1.0</data>
      <data key="d9">The ICD-10 provides updated classification for eating disorders, which is essential for diagnosis and treatment</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">401baea8e9c14c418c10ef3b8b535960</data>
      <data key="d12">14923</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIE-10" target="GRUPOS RELACIONADOS CON EL DIAGN&#211;STICO">
      <data key="d8">8.0</data>
      <data key="d9">El sistema GRD utiliza la CIE-10 para clasificar diagn&#243;sticos y procedimientos relacionados con la desnutrici&#243;n</data>
      <data key="d10">b6336e61e2a290a5c471fd72297d6093</data>
      <data key="d11">2fe69d55efbf48b2ac85da2c8169a3cf</data>
      <data key="d12">14924</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRASTORNO DE LA IDENTIDAD SEXUAL" target="INCONGRUENCIA DE G&#201;NERO">
      <data key="d8">7.0</data>
      <data key="d9">Gender incongruence is classified under disorders of sexual identity in the CIE</data>
      <data key="d10">3779506e9a987b6bdf5da381df675430</data>
      <data key="d11">2e7de4209cf1419abf3e33b07382cbd8</data>
      <data key="d12">14925</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRATAMIENTOS CON HORMONAS" target="TRANSEXUAL MUJER">
      <data key="d8">8.0</data>
      <data key="d9">Transgender women may undergo hormone treatments to align their physical characteristics with their gender identity</data>
      <data key="d10">3779506e9a987b6bdf5da381df675430</data>
      <data key="d11">510ff16af3f74d7697dd5c412e098ab9</data>
      <data key="d12">14926</data>
      <data key="d13">2</data>
    </edge>
    <edge source="IDENTIDAD DE G&#201;NERO" target="TRANSEXUAL MUJER">
      <data key="d8">9.0</data>
      <data key="d9">A transgender woman identifies as a woman, which is a key aspect of her gender identity</data>
      <data key="d10">3779506e9a987b6bdf5da381df675430</data>
      <data key="d11">b9403d175ab04564ae31a005872df266</data>
      <data key="d12">14927</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INCONGRUENCIA DE G&#201;NERO" target="TRANSEXUAL MUJER">
      <data key="d8">9.0</data>
      <data key="d9">Transgender women experience gender incongruence, which is the mismatch between their gender identity and assigned sex at birth</data>
      <data key="d10">3779506e9a987b6bdf5da381df675430</data>
      <data key="d11">931d8fca619c424a87a8fa5463aa57bf</data>
      <data key="d12">14928</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INCONGRUENCIA DE G&#201;NERO" target="TRASTORNO DE LA IDENTIDAD SEXUAL DE LA INFANCIA">
      <data key="d8">1.0</data>
      <data key="d9">Childhood gender identity disorder is a form of gender incongruence observed in children</data>
      <data key="d10">3779506e9a987b6bdf5da381df675430</data>
      <data key="d11">ef84e64cd491436ca9fac9d66324dbd7</data>
      <data key="d12">14929</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTICULOS CRIPTORQU&#205;DICOS" target="TORSI&#211;N TESTICULAR">
      <data key="d8">8.0</data>
      <data key="d9">Cryptorchid testicles are at risk for torsion, which is a serious medical condition</data>
      <data key="d10">1776df2694e83680f59e035be5ffb00b</data>
      <data key="d11">08d4f7e70de24a74b1968ecd456fff82</data>
      <data key="d12">14930</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TAY-SACHS DISEASE" target="HORMONAL STUDY">
      <data key="d8">3.0</data>
      <data key="d9">The hormonal study was conducted to rule out conditions like Tay-Sachs disease, which has different hormonal implications.</data>
      <data key="d10">592d424edaa447a54ab4489d82495db6</data>
      <data key="d11">2f84b58a40474ad2824b05273fa4fbe6</data>
      <data key="d12">14931</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENDOCRINOLOGY CONSULTATION" target="MUSCLE FATIGUE">
      <data key="d8">8.0</data>
      <data key="d9">The endocrinology consultation was prompted by the patient's reported muscle fatigue and other symptoms.</data>
      <data key="d10">592d424edaa447a54ab4489d82495db6</data>
      <data key="d11">0eb3d38afa7a4d18aa29a98c2b1b9015</data>
      <data key="d12">14932</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENDOCRINOLOGY CONSULTATION" target="HORMONAL STUDY">
      <data key="d8">9.0</data>
      <data key="d9">The endocrinology consultation led to a hormonal study being requested for the patient.</data>
      <data key="d10">592d424edaa447a54ab4489d82495db6</data>
      <data key="d11">f716f92dae7b41a2a44428f86286b8bb</data>
      <data key="d12">14933</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENDOCRINOLOGY CONSULTATION" target="NEUROLOGY REFERRAL">
      <data key="d8">1.0</data>
      <data key="d9">The findings from the endocrinology consultation resulted in a referral to neurology for further evaluation.</data>
      <data key="d10">592d424edaa447a54ab4489d82495db6</data>
      <data key="d11">c4020a6da60648f9b7cd368f2f70f555</data>
      <data key="d12">14934</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE KENNEDY" target="CAG">
      <data key="d8">9.0</data>
      <data key="d9">La expansi&#243;n de la tripleta CAG en el receptor androg&#233;nico causa el s&#237;ndrome de Kennedy, afectando la producci&#243;n de testosterona</data>
      <data key="d10">4accb4afaddfdc671690221252ff1b99</data>
      <data key="d11">2727701fd27241e295b63e2307677d76</data>
      <data key="d12">14935</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VIH" target="HIV-INFECTED WOMEN">
      <data key="d8">1.0</data>
      <data key="d9">HIV-infected women are directly affected by the VIH virus, leading to various health complications</data>
      <data key="d10">4beab004731d7baff10fd2796a523b55</data>
      <data key="d11">d30e0326ec594b5589a1c66f6281b6b2</data>
      <data key="d12">14936</data>
      <data key="d13">2</data>
    </edge>
