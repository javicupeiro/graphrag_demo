      <data key="d11">0d69f5156ff745869521cd6c7860cc2d</data>
      <data key="d12">12659</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CRANEOPARINGIOMAS" target="BRAF">
      <data key="d8">7.0</data>
      <data key="d9">Las mutaciones en el oncog&#233;n BRAF son comunes en craneofaringiomas papilares, lo que indica una relaci&#243;n directa</data>
