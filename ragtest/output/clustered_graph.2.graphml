    </edge>
    <edge source="MALABSORCI&#211;N" target="EPOC">
      <data key="d8">6.0</data>
      <data key="d9">Malabsorption can occur as a complication in patients with EPOC due to nutritional deficiencies</data>
      <data key="d10">ddd48beea3c882bf1a651cb25283ba91</data>
