    <node id="PROGRAMAS DE MEDICAID">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Programas de Medicaid are health insurance programs in the United States that provide coverage for low-income individuals, including aspects of NED.</data>
      <data key="d2">f84386a9907d954b9cf46475d0d45243</data>
