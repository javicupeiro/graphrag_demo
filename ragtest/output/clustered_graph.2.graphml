      <data key="d11">5c73a0d55bf245e5bff6e1382b5ae7b1</data>
      <data key="d12">1978</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SONDA NASOG&#193;STRICA" target="HIGIENE BUCAL">
      <data key="d8">5.0</data>
      <data key="d9">La higiene bucal es un cuidado necesario para los pacientes que tienen una Sonda Nasog&#225;strica colocada</data>
      <data key="d10">c78e1786c296e2b8a7ad428c0fb10c36</data>
      <data key="d11">0b3d250f21054155bd048afe09f72768</data>
      <data key="d12">1979</data>
