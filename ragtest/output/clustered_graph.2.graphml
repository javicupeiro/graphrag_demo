    </node>
    <node id="TETRACOSACTIDA">
      <data key="d0">EVENT</data>
      <data key="d1">La tetracosactida es un medicamento utilizado en pruebas de estimulaci&#243;n con ACTH para evaluar la funci&#243;n adrenal en pacientes con sospecha de hiperplasia suprarrenal cong&#233;nita.</data>
      <data key="d2">095d265c06452e52ccbfbc871a19a899</data>
