    </node>
    <node id="MALTODEXTRINA M">
      <data key="d0">INGREDIENT</data>
      <data key="d1">Maltodextrin M is a carbohydrate used in clinical nutrition formulations to provide energy and improve texture.</data>
      <data key="d2">3d73ef14929e7391e915f739189e4dfa</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
