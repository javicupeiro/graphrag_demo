    <node id="ILEO POSTOPERATORIO">
      <data key="d0">EVENT</data>
      <data key="d1">El &#237;leo postoperatorio persistente es una condici&#243;n que puede requerir nutrici&#243;n parenteral.</data>
      <data key="d2">538970e30e9d0e758546ca1a3cf5a205</data>
      <data key="d3">588</data>
