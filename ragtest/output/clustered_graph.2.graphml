    </edge>
    <edge source="INTERNATIONAL AGENCY FOR RESEARCH ON CANCER" target="WORLD CANCER RESEARCH FUND">
      <data key="d8">6.0</data>
      <data key="d9">Both organizations conduct research on cancer risks associated with obesity</data>
