      <data key="d10">4734ce2075bc72c352950c018bab7185</data>
      <data key="d11">eb671b53492640c5a4bd143d79ce04e0</data>
      <data key="d12">3825</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL RISK SCREENING 2002" target="ANEXO 1">
      <data key="d8">1.0</data>
      <data key="d9">Anexo 1 provides guidelines for the Nutritional Risk Screening 2002</data>
      <data key="d10">4734ce2075bc72c352950c018bab7185</data>
      <data key="d11">fc5d995688a34589942eaab45da4db36</data>
      <data key="d12">3826</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL RISK SCREENING 2002" target="ASPEN">
      <data key="d8">6.0</data>
      <data key="d9">ASPEN proposes the use of NRS-2002 for nutritional risk assessment in hospitalized patients.</data>
      <data key="d10">17444b83ec19bdcc65ff0722869e7b4b</data>
      <data key="d11">3f6830d26bbd4827804f49f8acd50028</data>
      <data key="d12">3827</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL RISK SCREENING 2002" target="NUTRICI&#211;N PARENTERAL DOMICILIARIA">
      <data key="d8">1.0</data>
      <data key="d9">NRS 2002 is applicable for assessing nutritional risk in patients on home parenteral nutrition.</data>
      <data key="d10">8ccd7ff955c5b8a333f23f41e34c563a</data>
      <data key="d11">bedf91ca882f473ca5824326c31b449f</data>
      <data key="d12">3828</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL RISK SCREENING 2002" target="MINI NUTRITIONAL ASSESSMENT">
      <data key="d8">5.0</data>
      <data key="d9">Both are methods for assessing nutritional risk, with the former being recommended for hospitalized patients and the latter for elderly populations</data>
      <data key="d10">687a74f539aea483b8c6611f3b062931</data>
      <data key="d11">e56bc81e64484410b4988cd2b7056049</data>
      <data key="d12">3829</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL RISK SCREENING 2002" target="RYU SW">
      <data key="d8">7.0</data>
