    <edge source="ACROMEGALY" target="HYPERINSULINISM">
      <data key="d8">6.0</data>
      <data key="d9">Hyperinsulinism can occur as a result of the metabolic effects of excess growth hormone in acromegaly</data>
      <data key="d10">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d11">575f5329c20e427d946ce35dc3acc628</data>
