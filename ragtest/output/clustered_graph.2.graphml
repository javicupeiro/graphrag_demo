    <edge source="NUTRITIONAL SUPPORT" target="NUTRIENTS">
      <data key="d8">15.0</data>
      <data key="d9">Nutritional support refers to the provision of essential nutrients necessary for recovery and health maintenance, particularly following surgical procedures. It involves the administration of these vital nutrients to patients to ensure their well-being and facilitate the healing process.</data>
      <data key="d10">6517add809ee588bede013f59f20b0ef,69bfdb98603d3d8c4733cb795f4c82f3</data>
      <data key="d11">9ad4afdd687d4683ae3071705a2047b0</data>
