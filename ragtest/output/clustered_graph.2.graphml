      <data key="d3">1648</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">10806</data>
      <data key="d7">899a7bbf0d3c4bfeb1db4733790708dc</data>
    </node>
    <node id="ACEITE DE OLIVA VIRGEN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Extra virgin olive oil is a key component of the Mediterranean diet, recommended for its health benefits, particularly in cardiovascular health.</data>
      <data key="d2">0090177678aee58d08471d09d24d2842</data>
      <data key="d3">1376</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">10807</data>
      <data key="d7">546eb09530d845048ee9de01ae3fc0cf</data>
    </node>
    <node id="CRETA">
      <data key="d0">GEO</data>
      <data key="d1">Creta is an island in Greece renowned for its traditional Mediterranean diet, which is linked to lower rates of coronary heart disease. The island's dietary habits, characterized by a high intake of alpha-linolenic acid (ALA), contribute to its notably low rates of coronary disease. This combination of dietary practices and health outcomes highlights Creta's significance in discussions about nutrition and cardiovascular health.</data>
      <data key="d2">0090177678aee58d08471d09d24d2842,0a43b350a248173236a96a64e266b744</data>
      <data key="d3">1376</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">10808</data>
      <data key="d7">1531e52c2ee241b2b9a6d83d291dd4ce</data>
    </node>
    <node id="AGP">
      <data key="d0">EVENT</data>
      <data key="d1">AGP refers to polyunsaturated fatty acids, which are essential fats that play a crucial role in cardiovascular health.</data>
      <data key="d2">0090177678aee58d08471d09d24d2842</data>
      <data key="d3">1378</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">10809</data>
      <data key="d7">12b801938dee4646aef61d5cc51dc4cb</data>
    </node>
    <node id="RIESGO DE ENFERMEDAD CORONARIA">
      <data key="d0">EVENT</data>
      <data key="d1">Risk of coronary disease refers to the likelihood of developing heart-related conditions, influenced by dietary intake and lifestyle.</data>
      <data key="d2">0090177678aee58d08471d09d24d2842</data>
      <data key="d3">1576</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">10810</data>
      <data key="d7">8571957521be45eaa38020ed51c9db3b</data>
    </node>
    <node id="LYON HEART STUDY">
      <data key="d0">EVENT</data>
      <data key="d1">The Lyon Heart Study is an intervention study that demonstrated a significant reduction in mortality among participants consuming ALA.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744</data>
      <data key="d5">1</data>
      <data key="d6">10811</data>
      <data key="d7">72e6238b65d042d881b55a0c66cbe803</data>
    </node>
    <node id="AGP &#937;-6">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">AGP &#969;-6 refers to omega-6 fatty acids that are recommended for cholesterol reduction when replacing saturated fats in the diet.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744</data>
      <data key="d5">0</data>
      <data key="d6">10812</data>
      <data key="d7">d5fe33b698b847f5a683cd7b79341c7b</data>
    </node>
    <node id="AGP &#937;-3">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">AGP &#969;-3 refers to omega-3 fatty acids, including EPA and DHA, which are important for cardiovascular health.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744</data>
      <data key="d5">6</data>
      <data key="d6">10813</data>
      <data key="d7">22f56def8ff3403f8ed666f92d8e0ddb</data>
    </node>
    <node id="GISSI-PREVENZIONE TRIAL">
      <data key="d0">EVENT</data>
      <data key="d1">The GISSI-Prevenzione Trial is a clinical study that investigated the effects of dietary supplementation with n-3 polyunsaturated fatty acids, specifically eicosapentaenoic acid (EPA) and docosahexaenoic acid (DHA), along with vitamin E, in patients who had experienced a myocardial infarction. The trial demonstrated a significant reduction in coronary mortality among those patients who received the supplementation, highlighting the potential benefits of these nutrients in post-myocardial infarction care.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744,dbdb3cd3b9065e8846fd2eb15b9d5879</data>
      <data key="d5">2</data>
      <data key="d6">10814</data>
      <data key="d7">92cddb4d5c914af0a4e47dcf41660f3f</data>
    </node>
    <node id="ESTUDIO JELIS">
      <data key="d0">EVENT</data>
      <data key="d1">The JELIS study is a clinical trial that demonstrated a reduction in ischemic events among patients treated with EPA in addition to statins.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744</data>
      <data key="d5">1</data>
      <data key="d6">10815</data>
      <data key="d7">8da01286b5734df7b62651ccc622d1c4</data>
    </node>
    <node id="OMEGA">
      <data key="d0">EVENT</data>
      <data key="d1">The OMEGA study is a clinical trial that investigated the effects of EPA and DHA on patients with a history of myocardial infarction.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744</data>
      <data key="d5">1</data>
      <data key="d6">10816</data>
      <data key="d7">86f2d5f6ba4f4afd98afa32928bcd695</data>
    </node>
    <node id="ALPHA-OMEGA">
      <data key="d0">EVENT</data>
      <data key="d1">The ALPHA-OMEGA study is a clinical trial that assessed the impact of EPA and DHA on patients with a history of myocardial infarction.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744</data>
      <data key="d5">1</data>
      <data key="d6">10817</data>
      <data key="d7">e4c34040a3e34effb3cc6b23e6954ec1</data>
    </node>
    <node id="SU.FOL.OM3">
      <data key="d0">EVENT</data>
      <data key="d1">The SU.FOL.OM3 study is a clinical trial that evaluated the effects of omega-3 fatty acids on patients with recent ischemic events.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744</data>
      <data key="d5">1</data>
      <data key="d6">10818</data>
      <data key="d7">dd7a5d1363ce4f799ca54f389f1bd5fd</data>
    </node>
    <node id="HIPOLESTEROLEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hipocholesterolemia refers to the condition of having low cholesterol levels, which can be influenced by dietary intake of omega-6 fatty acids.</data>
      <data key="d2">0a43b350a248173236a96a64e266b744</data>
      <data key="d3">832</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">10819</data>
      <data key="d7">d604a9884db342aa9cf7300f3e3388ac</data>
    </node>
    <node id="RISK AND PREVENTION STUDY COLLABORATIVE GROUP">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Risk and Prevention Study Collaborative Group conducted a study involving 12,513 patients with multiple cardiovascular risk factors to assess the effects of EPA+DHA on cardiovascular morbidity and mortality.</data>
      <data key="d2">41d7db510fc74d3763959481cc15ea20</data>
      <data key="d3">310</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">10820</data>
      <data key="d7">e948fd6589504c7c8c49db84fdb2d628</data>
    </node>
    <node id="EPA+DHA">
      <data key="d0">EVENT</data>
      <data key="d1">EPA+DHA refers to eicosapentaenoic acid and docosahexaenoic acid, which are omega-3 fatty acids studied for their effects on cardiovascular health.</data>
      <data key="d2">41d7db510fc74d3763959481cc15ea20</data>
      <data key="d3">310</data>
      <data key="d4">1</data>
