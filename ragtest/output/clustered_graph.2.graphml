      <data key="d0">EVENT</data>
      <data key="d1">La alimentaci&#243;n digna se refiere a la provisi&#243;n de una nutrici&#243;n adecuada y respetuosa para ancianos dependientes.</data>
      <data key="d2">2ad1c3591301bd2ea6f99c3782714d69</data>
