    <node id="CRITERIOS DE ATLANTA">
      <data key="d0">EVENT</data>
      <data key="d1">Los criterios de Atlanta son un conjunto de directrices utilizadas para clasificar la severidad de la pancreatitis aguda.</data>
      <data key="d2">caf14765027dbf6266841af0571a522e</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12247</data>
