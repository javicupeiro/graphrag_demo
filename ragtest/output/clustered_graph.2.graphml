    <node id="BULBAR SYMPTOMS">
      <data key="d0">EVENT</data>
      <data key="d1">Bulbar symptoms in amyotrophic lateral sclerosis refer to difficulties in speech and swallowing, which require specific diagnosis and treatment strategies.</data>
