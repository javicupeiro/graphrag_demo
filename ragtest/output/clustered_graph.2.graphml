    </node>
    <node id="TEXAS SCALE">
      <data key="d0">EVENT</data>
      <data key="d1">The Texas scale is a classification system used to assess the severity of ulcers, particularly in diabetic patients.</data>
      <data key="d2">d77ee7b5259ebdf92e8375c5f2d322e6</data>
      <data key="d3">880</data>
