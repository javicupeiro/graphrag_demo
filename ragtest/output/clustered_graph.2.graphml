      <data key="d9">Caregivers of children receiving NED experience psychological effects related to their caregiving responsibilities</data>
      <data key="d10">29c2dd6ce196c0166033a861582e9721</data>
      <data key="d11">df2f9eace23440469cfac18fdf92829f</data>
      <data key="d12">873</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUIDADORES" target="S&#205;NDROME DEL CUIDADOR &#171;QUEMADO&#187;">
      <data key="d8">8.0</data>
      <data key="d9">Caregivers often experience caregiver burnout syndrome due to the emotional and physical demands of their role</data>
      <data key="d10">29c2dd6ce196c0166033a861582e9721</data>
      <data key="d11">f082891bf7e24391902c0d33e65a1f65</data>
      <data key="d12">874</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUIDADORES" target="NED">
      <data key="d8">6.0</data>
      <data key="d9">Cuidadores are involved in the implementation of NED, providing care and support to elderly patients receiving nutritional assistance</data>
      <data key="d10">0d083c309fb6f4d0d16c0e2b23ea5c8b</data>
      <data key="d11">e7a99d620f8545b48fa7a8a7caa941a6</data>
      <data key="d12">875</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUIDADORES" target="NUTRICI&#211;N ARTIFICIAL DOMICILIARIA">
      <data key="d8">1.0</data>
      <data key="d9">Los cuidadores juegan un papel crucial en la administraci&#243;n de la nutrici&#243;n artificial domiciliaria, afectando la calidad de vida de los pacientes.</data>
      <data key="d10">123ef22fb42b6ade4fa2dda096df8490</data>
      <data key="d11">747fb7de7a8b4b868f724f0ec2943b5a</data>
      <data key="d12">876</data>
      <data key="d13">2</data>
    </edge>
    <edge source="F&#201;LIX BRAVO SANZ" target="MANUAL DE DISFAGIA OROFAR&#205;NGEA">
      <data key="d8">6.0</data>
      <data key="d9">F&#233;lix Bravo Sanz is involved in the publication of the Manual de Disfagia Orofar&#237;ngea, which aims to serve as a reference for professionals treating dysphagia.</data>
      <data key="d10">c56e48073639b88eaeeaf183cbcdeb20</data>
      <data key="d11">8128c102ee944c778d1404fca90d3b7a</data>
      <data key="d12">877</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDADES NEUROL&#211;GICAS" target="NADYA">
      <data key="d8">1.0</data>
