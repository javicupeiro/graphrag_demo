    </edge>
    <edge source="HIPOXALURIA" target="HIPOXALURIA SECUNDARIA">
      <data key="d8">5.0</data>
      <data key="d9">Secondary hypoxaluria is caused by underlying conditions that affect oxalate levels in the urine.</data>
      <data key="d10">634b74df7b9403e4c578f3fc84fe3335</data>
