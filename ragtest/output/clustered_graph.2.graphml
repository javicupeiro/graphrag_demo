    <node id="NATIONAL DYSPHAGIA DIET TASK FORCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The National Dysphagia Diet Task Force is an organization that establishes guidelines for the management of dysphagia, particularly regarding the viscosity of thickened liquids and foods.</data>
      <data key="d2">4aeca0ee5f2663f449cfd017d3e3bbfb</data>
