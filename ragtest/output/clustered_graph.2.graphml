    <edge source="DUODENOPANCREATECTOM&#205;A" target="GASTROYEYUNOSTOM&#205;A">
      <data key="d8">8.0</data>
      <data key="d9">La gastroyeyunostom&#237;a es parte del procedimiento quir&#250;rgico de duodenopancreatectom&#237;a, que se realiza para facilitar la digesti&#243;n</data>
      <data key="d10">3ee948dc4ddfdc75daa8fe7db9bb471e</data>
