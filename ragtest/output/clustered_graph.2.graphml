    <node id="HOSPITAL UNIVERSITARIO 12 DE OCTUBRE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Hospital Universitario 12 de Octubre is a medical institution located in Madrid, Spain. It specializes in pediatrics, endocrinology, and clinical nutrition, providing a comprehensive range of healthcare services in these fields.</data>
      <data key="d2">57a5157c4312ac09073e72ad7789ad7c,5c69bb68f0d23a5aa15fa31301aa13c2</data>
      <data key="d3">1441</data>
