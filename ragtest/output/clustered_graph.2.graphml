    </node>
    <node id="SURGICAL TREATMENT">
      <data key="d0">EVENT</data>
      <data key="d1">Surgical treatment is a common approach for managing acromegaly, particularly for tumor removal.</data>
      <data key="d2">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d3">886</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
