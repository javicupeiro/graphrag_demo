    <edge source="APLV" target="SOY FORMULAS">
      <data key="d8">7.0</data>
      <data key="d9">Soy formulas are contraindicated for infants with APLV due to the risk of inadequate weight gain and other health issues.</data>
      <data key="d10">08d66dc8414668a3ec627a1e164cfa6c</data>
      <data key="d11">2748a8174c22436c95f69f7d28fb41a0</data>
