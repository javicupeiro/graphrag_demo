    </node>
    <node id="YUGULAR EXTERNA">
      <data key="d0">GEO</data>
      <data key="d1">Yugular externa is a superficial vein used for venous access, particularly visible in elderly patients, with specific advantages and disadvantages for medical procedures.</data>
      <data key="d2">67344d72dff60fcb903b258fbca95de5</data>
      <data key="d3">1263</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">14863</data>
      <data key="d7">b51ced1284b344ea9e4e2b65fe4e151c</data>
    </node>
    <node id="YUGULAR INTERNA">
      <data key="d0">GEO</data>
      <data key="d1">Yugular interna is a central vein with minimal risk of pneumothorax, often used for venous access, especially when ultrasound guidance is available.</data>
      <data key="d2">67344d72dff60fcb903b258fbca95de5</data>
      <data key="d3">1263</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">14864</data>
      <data key="d7">aff80998483a41c5b65935838ca543ed</data>
    </node>
    <node id="SUBCLAVIA">
      <data key="d0">GEO</data>
      <data key="d1">Subclavia is a central vein that provides easier maintenance of dressings and is more comfortable for patients, but has a higher risk of pneumothorax.</data>
      <data key="d2">67344d72dff60fcb903b258fbca95de5</data>
      <data key="d3">1263</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">14865</data>
      <data key="d7">90c2068731564df293b47106d852f14f</data>
    </node>
    <node id="FEMORAL">
      <data key="d0">GEO</data>
      <data key="d1">Femoral access is a central vein that allows rapid access with a high success rate, but can impede patient mobility and has a higher risk of iliofemoral thrombosis.</data>
      <data key="d2">67344d72dff60fcb903b258fbca95de5</data>
      <data key="d3">1263</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">14866</data>
      <data key="d7">27a3f2ae24814d16b065f43832b6ef29</data>
    </node>
    <node id="CAT&#201;TER CENTRAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Central catheters are used for temporary access in patients requiring infusion for more than 15 days, with specific complications associated with their use.</data>
      <data key="d2">67344d72dff60fcb903b258fbca95de5</data>
      <data key="d3">1263</data>
      <data key="d4">2</data>
