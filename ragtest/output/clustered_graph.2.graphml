    <edge source="GLUC&#211;GENO" target="GLUCONEOG&#201;NESIS">
      <data key="d8">7.0</data>
      <data key="d9">La glucogenog&#233;nesis es el proceso mediante el cual se sintetiza el gluc&#243;geno a partir de glucosa</data>
      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">f32cdd3600c64dfcaacf440047b86551</data>
      <data key="d12">17608</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="GLUCOLISIS">
      <data key="d8">7.0</data>
      <data key="d9">La glucogen&#243;lisis es el proceso mediante el cual se degrada el gluc&#243;geno para liberar glucosa</data>
      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">f758fca0f1244fa98eaab8a66a8a1937</data>
      <data key="d12">17609</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="GLUC&#211;GENO FOSFORILASA">
      <data key="d8">8.0</data>
      <data key="d9">Gluc&#243;geno fosforilasa breaks down gluc&#243;geno into glucose-1-phosphate, facilitating energy release</data>
      <data key="d10">f0bfe278aa9f43f4bc9d056de67a5b96</data>
      <data key="d11">03fbb550e8c84d6eb9138a0b818f9b55</data>
      <data key="d12">17610</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="GLUC&#211;GENO SINTASA">
      <data key="d8">8.0</data>
      <data key="d9">Gluc&#243;geno sintasa synthesizes gluc&#243;geno from glucose, enabling energy storage</data>
      <data key="d10">f0bfe278aa9f43f4bc9d056de67a5b96</data>
      <data key="d11">00a1c516479e4d7db8973119625fb6ef</data>
      <data key="d12">17611</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="ENZIMA RAMIFICANTE">
      <data key="d8">7.0</data>
      <data key="d9">Enzima ramificante modifies gluc&#243;geno by adding branches, affecting its structure and metabolism</data>
      <data key="d10">f0bfe278aa9f43f4bc9d056de67a5b96</data>
      <data key="d11">c3fe0a05ef584e248d397b7f3ff2622a</data>
      <data key="d12">17612</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="GLUCOGENOG&#201;NESIS">
      <data key="d8">1.0</data>
      <data key="d9">Glycogenesis synthesizes gluc&#243;geno from glucosa, storing energy for future use</data>
      <data key="d10">f0bfe278aa9f43f4bc9d056de67a5b96</data>
      <data key="d11">16cbef6d38614a66ae5be0476b1f8b4b</data>
      <data key="d12">17613</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="ENFERMEDAD DE MCARDLE">
      <data key="d8">8.0</data>
      <data key="d9">McArdle disease is characterized by a deficiency in glycogen metabolism, leading to exercise intolerance and muscle symptoms</data>
      <data key="d10">4464b0da291e94ba7b7f5b51134b4a75</data>
      <data key="d11">0df80fe59148403a8461246102eb997e</data>
      <data key="d12">17614</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="FRUCTOSE">
      <data key="d8">1.0</data>
      <data key="d9">Fructose can be converted into glycogen through gluconeogenesis when necessary</data>
      <data key="d10">f290b280f5c5a9e2e8326fec68b6016f</data>
      <data key="d11">48a113a2664247788dc20d8afd1869f6</data>
      <data key="d12">17615</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="DEPORTISTAS">
      <data key="d8">8.0</data>
      <data key="d9">Los deportistas dependen del gluc&#243;geno como fuente de energ&#237;a durante el ejercicio f&#237;sico</data>
      <data key="d10">490f5e3c6dbf3754eee50c52154da09a</data>
      <data key="d11">7a56be48b4e64d8690706c0b4f81aabf</data>
      <data key="d12">17616</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="DEPORTISTA">
      <data key="d8">17.0</data>
      <data key="d9">GLUC&#211;GENO is a crucial energy source for DEPORTISTA (athletes), as they depend on glycogen stores to fuel their physical activities. The storage of glycogen is essential for optimal performance during exercise, highlighting its importance in the athletic domain.</data>
      <data key="d10">39da0855b83941d97766254aa36ed2fd,470e6bb2e8b8ca543addb0f07464f38c</data>
      <data key="d11">3caded54938044c5b161132594c4f39b</data>
      <data key="d12">17617</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO" target="ALMACENAMIENTO DE GLUC&#211;GENO">
      <data key="d8">8.0</data>
      <data key="d9">Glycogen storage is a key process for athletes to ensure they have sufficient energy reserves for physical activity.</data>
      <data key="d10">39da0855b83941d97766254aa36ed2fd</data>
      <data key="d11">7a0473a8d95944179b6368ee878245c1</data>
      <data key="d12">17618</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOG&#201;NESIS" target="HEXOKINASA">
      <data key="d8">9.0</data>
      <data key="d9">La hexokinasa es una enzima clave en el proceso de glucogenog&#233;nesis, fosforilando la glucosa para su almacenamiento</data>
      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">fd395f371a7048598c78af7d1fb4cf58</data>
      <data key="d12">17619</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOG&#201;NESIS" target="GLUCOSA-6-FOSFATO">
      <data key="d8">8.0</data>
      <data key="d9">La glucosa-6-fosfato es un producto clave en el proceso de glucogenog&#233;nesis, manteniendo la glucosa dentro de las c&#233;lulas</data>
      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">9c426da2db574640b80a5369a3719a9a</data>
      <data key="d12">17620</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOG&#201;NESIS" target="GLUCOSA-1-FOSFATO">
      <data key="d8">7.0</data>
      <data key="d9">La glucosa-1-fosfato se forma durante la conversi&#243;n de glucosa en gluc&#243;geno, siendo un intermediario importante</data>
      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">a17e740a7d1944089f9cb0026dedcd67</data>
      <data key="d12">17621</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOG&#201;NESIS" target="URIDIN-DIFOSFATO-GLUCOSA">
      <data key="d8">7.0</data>
      <data key="d9">El uridin-difosfato-glucosa es un compuesto que se a&#241;ade al gluc&#243;geno durante su s&#237;ntesis</data>
      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">37e77434857549538ad911c9e5fa947f</data>
      <data key="d12">17622</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOG&#201;NESIS" target="ENZIMA RAMIFICANTE">
      <data key="d8">1.0</data>
      <data key="d9">La enzima ramificante es crucial para la formaci&#243;n de ramificaciones en el gluc&#243;geno durante su s&#237;ntesis</data>
      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">8450689c2fe04e489b570cc6c2486c2c</data>
      <data key="d12">17623</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCONEOG&#201;NESIS" target="ENFERMEDAD DE MCARDLE">
      <data key="d8">7.0</data>
      <data key="d9">Gluconeogenesis is a compensatory mechanism for maintaining glucose levels in patients with McArdle disease due to the lack of glycogenolysis</data>
      <data key="d10">4464b0da291e94ba7b7f5b51134b4a75</data>
      <data key="d11">b3a876fa1d8747b68d381838309f2f19</data>
      <data key="d12">17624</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCOLISIS" target="GLUC&#211;GENO FOSFORILASA">
      <data key="d8">1.0</data>
      <data key="d9">La gluc&#243;geno fosforilasa es una enzima esencial en la glucogen&#243;lisis, liberando glucosa-1-fosfato del gluc&#243;geno</data>
      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">00bd6c5a6da6498dbe8e2e57b11c0975</data>
      <data key="d12">17625</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO FOSFORILASA" target="GLUC&#211;GENO STORAGE DISEASE">
      <data key="d8">7.0</data>
      <data key="d9">Glycogen Storage Disease is caused by deficiencies in enzymes like gluc&#243;geno fosforilasa, affecting glycogen metabolism</data>
      <data key="d10">f0bfe278aa9f43f4bc9d056de67a5b96</data>
      <data key="d11">3f14167afa59489a8fb96a0ced6a82c4</data>
      <data key="d12">17626</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCOSA-6-FOSFATO" target="GLUCOSA-6-FOSFATASA">
      <data key="d8">9.0</data>
      <data key="d9">Glucosa-6-fosfatasa converts glucosa-6-fosfato to free glucosa, allowing it to enter the bloodstream</data>
      <data key="d10">f0bfe278aa9f43f4bc9d056de67a5b96</data>
      <data key="d11">0cef3879c7a2449e9423ca0fcf086992</data>
      <data key="d12">17627</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCOSA-1-FOSFATO" target="FOSFOGLUCOMUTASA">
      <data key="d8">8.0</data>
      <data key="d9">Fosfoglucomutasa converts glucosa-1-fosfato to glucosa-6-fosfato, facilitating its use in metabolism</data>
      <data key="d10">f0bfe278aa9f43f4bc9d056de67a5b96</data>
      <data key="d11">93c50be7ba3549d4b6f907c7047af474</data>
      <data key="d12">17628</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUC&#211;GENO SINTASA" target="GLUC&#211;GENO STORAGE DISEASE">
