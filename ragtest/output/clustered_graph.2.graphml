      <data key="d3">1443</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16119</data>
      <data key="d7">bf3867c6466446399968e1642dbde9aa</data>
    </node>
    <node id="SENSACI&#211;N TRIGEMINAL">
      <data key="d0">EVENT</data>
      <data key="d1">Trigeminal sensation refers to the mouthfeel experienced when consuming clinical nutrition products, which can be affected by protein coagulation and viscosity.</data>
      <data key="d2">62f527b38024e8807d3e63a0cf488046</data>
      <data key="d3">1443</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16120</data>
      <data key="d7">f35c98de9bad4d41bca663b4bbc8ad82</data>
    </node>
