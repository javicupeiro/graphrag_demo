    <edge source="SAEDYN" target="PAPENDOCRINIC">
      <data key="d8">14.0</data>
      <data key="d9">SAEDYN and PAPENDOCRINIC are interconnected entities in the field of endocrinology education. PAPENDOCRINIC is an accredited program that receives support from SAEDYN, highlighting their collaborative relationship. SAEDYN provides scientific endorsement to the PAPENDOCRINIC program, further emphasizing its commitment to advancing education and research in endocrinology.</data>
      <data key="d10">1485a96a60386bca4d8facc2ccedbb22,fc81f645a5600b374c960fd8739a0503</data>
      <data key="d11">17d0f3cb29884701870561e19fe46e0a</data>
      <data key="d12">11801</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SAEDYN" target="ESTEVE">
