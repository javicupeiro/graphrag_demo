    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="TRATAMIENTOS">
      <data key="d8">8.0</data>
      <data key="d9">Tratamientos can significantly impact the nutritional status of cancer patients, leading to p&#233;rdida de peso.</data>
      <data key="d10">b26b998479da515c234ce46b1bfa73db</data>
      <data key="d11">fdeedf0324fa48e1ae33cd1ee6a09fa7</data>
      <data key="d12">3626</data>
      <data key="d13">2</data>
    </edge>
