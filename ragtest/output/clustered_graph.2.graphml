    <node id="EVALUACI&#211;N DE SENSIBILIDAD FAR&#205;NGEA">
      <data key="d0">EVENT</data>
      <data key="d1">Pharyngeal sensitivity evaluation is a clinical assessment used to determine the ability to swallow safely and detect dysphagia.</data>
