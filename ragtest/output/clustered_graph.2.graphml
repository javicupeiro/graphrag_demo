    <node id="GLUT1">
      <data key="d0">PERSON</data>
      <data key="d1">El s&#237;ndrome de la deficiencia de GLUT1 es un defecto de transporte de glucosa al cerebro que causa epilepsia y retraso en el desarrollo.</data>
      <data key="d2">a8929d6c031b44205ed738ec0a0cd435</data>
