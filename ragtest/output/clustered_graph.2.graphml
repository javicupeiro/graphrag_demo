    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="CAQUEXIA TUMORAL">
      <data key="d8">9.0</data>
      <data key="d9">La caquexia tumoral se manifiesta a trav&#233;s de la p&#233;rdida de peso en pacientes con c&#225;ncer.</data>
      <data key="d10">5664277128c865feb0e93f9fd56a3d05</data>
      <data key="d11">6c4fb1ff7f6441ad8dae59755cd6fe39</data>
