      <data key="d7">a83374ad3141430a8c3bc8205605b225</data>
    </node>
    <node id="CIRUG&#205;A ABDOMINAL">
      <data key="d0">EVENT</data>
      <data key="d1">La cirug&#237;a abdominal es un procedimiento quir&#250;rgico que puede requerir soporte nutricional, especialmente en pacientes desnutridos.</data>
      <data key="d2">44346a4b1b9a6d3ae2bc161314ff9efd</data>
      <data key="d3">748</data>
      <data key="d4">2</data>
