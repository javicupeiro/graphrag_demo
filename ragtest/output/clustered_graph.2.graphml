    </edge>
    <edge source="DIARREA" target="ALUMINALES">
      <data key="d8">5.0</data>
      <data key="d9">Aluminales may be used in the treatment of diarrhea by providing necessary substances for recovery</data>
      <data key="d10">6886c5b652319bea0ba2427a3fdbf701</data>
      <data key="d11">2946e0e1e1ec4f149b1cfd9d7f6b589c</data>
      <data key="d12">4233</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIARREA" target="CARB&#211;N ACTIVADO">
      <data key="d8">6.0</data>
      <data key="d9">Activated carbon can be used to treat diarrhea by absorbing toxins in the gastrointestinal tract</data>
      <data key="d10">6886c5b652319bea0ba2427a3fdbf701</data>
      <data key="d11">98a155b64e8142d4b581133c11bc009d</data>
