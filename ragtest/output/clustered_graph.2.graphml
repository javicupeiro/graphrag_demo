    <edge source="CUPROENZIMAS" target="M&#218;SCULOS">
      <data key="d8">8.0</data>
      <data key="d9">Cuproenzyme activity is necessary for metabolic functions in muscles</data>
      <data key="d10">d2916698f201a31d6bb74619a3fa064b</data>
