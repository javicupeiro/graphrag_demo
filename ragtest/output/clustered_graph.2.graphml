      <data key="d6">3881</data>
      <data key="d7">653db7632a04420c94968c04aa7d2645</data>
    </node>
    <node id="LOPEZ MEZQUITA TORRES E">
      <data key="d0">PERSON</data>
      <data key="d1">L&#243;pez Mezquita Torres E is a co-author of the Manual de Endocrinolog&#237;a y Nutrici&#243;n, focusing on endocrine disorders including hyperprolactinemia.</data>
      <data key="d2">b530539793a70d1223f3307aa47777fe</data>
      <data key="d3">1457</data>
