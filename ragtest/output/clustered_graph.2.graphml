    <node id="CORTICOTROPINOMAS">
      <data key="d0">EVENT</data>
      <data key="d1">Corticotropinomas are a type of pituitary tumor that can lead to various hormonal imbalances and require careful monitoring post-surgery.</data>
      <data key="d2">4faa9b46acd7540904fc5b0772bb7c51</data>
