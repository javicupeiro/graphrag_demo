    <node id="PROTON PUMP INHIBITORS">
      <data key="d0">EVENT</data>
      <data key="d1">Proton pump inhibitors are medications that reduce stomach acid and have been associated with the development of hypomagnesemia.</data>
      <data key="d2">b9342cecd69cdc0e9936df041657f5f5</data>
      <data key="d3">711</data>
