      <data key="d10">2b5b30d7b9371f8fe9e686c89dde3cb7</data>
      <data key="d11">7b7cfc4d703a441cb46a1a50fd754fda</data>
      <data key="d12">7235</data>
      <data key="d13">2</data>
    </edge>
    <edge source="WEIGHT LOSS" target="VLCD">
      <data key="d8">9.0</data>
