    </node>
    <node id="SECRETINA CCK">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Secretina CCK is a hormonal test used to assess pancreatic function by stimulating the pancreas and measuring its exocrine reserve.</data>
      <data key="d2">32642463df83d3626d7a9c5acf121825</data>
      <data key="d3">1198</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12266</data>
