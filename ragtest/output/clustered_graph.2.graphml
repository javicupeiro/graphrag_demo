      <data key="d0">PERSON</data>
      <data key="d1">Bahn RS es un autor que ha contribuido a la literatura m&#233;dica sobre la oftalmopat&#237;a de Graves.</data>
      <data key="d2">4c18507e3d98242cdbcddd1a1997b92f</data>
