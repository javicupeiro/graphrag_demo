    </edge>
    <edge source="CIRUG&#205;A BARI&#193;TRICA" target="RM">
      <data key="d8">6.0</data>
      <data key="d9">La resonancia magn&#233;tica (RM) es una prueba que puede ser dif&#237;cil de realizar en pacientes con obesidad m&#243;rbida</data>
      <data key="d10">de5f304890ba39f7c9e3d5c0201bc247</data>
      <data key="d11">09792305c9ef4e05ab0e5b396633320e</data>
      <data key="d12">15307</data>
      <data key="d13">2</data>
