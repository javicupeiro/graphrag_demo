      <data key="d12">17241</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EPILEPSY" target="ATKINS DIET">
      <data key="d8">5.0</data>
      <data key="d9">The Atkins diet is suggested as an alternative for patients who cannot adhere to the traditional ketogenic diet for epilepsy</data>
      <data key="d10">55b85a76a2c3d515bd3fe6137255abac</data>
      <data key="d11">1cff37bd7e0c4624b820c448a93ac276</data>
      <data key="d12">17242</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EPILEPSY" target="DIETARY THERAPIES">
      <data key="d8">8.0</data>
      <data key="d9">Dietary therapies, including the ketogenic diet, are explored as treatments for managing epilepsy</data>
      <data key="d10">55b85a76a2c3d515bd3fe6137255abac</data>
      <data key="d11">613eda30951f4689adab72d125a356f8</data>
