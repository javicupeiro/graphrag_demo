      <data key="d13">2</data>
    </edge>
    <edge source="PKU" target="TERAPIA G&#201;NICA">
      <data key="d8">8.0</data>
      <data key="d9">Gene therapy aims to correct the metabolic defect in PKU by introducing a functional PAH gene into the patient's cells.</data>
      <data key="d10">06b374fc6a6ebf2091ac0a00329bd027</data>
      <data key="d11">b2a1f2d12a3d461a936a9a8e0293a5e1</data>
