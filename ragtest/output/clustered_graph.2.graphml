      <data key="d0">ORGANIZATION</data>
      <data key="d1">ESPEN is an organization that offers clinical guidelines for artificial nutritional support in patients undergoing hematopoietic cell transplantation.</data>
      <data key="d2">27c75984e62c5adcac1ac33cbdc520dc</data>
