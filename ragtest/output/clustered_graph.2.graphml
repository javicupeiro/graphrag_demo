      <data key="d7">aee819634908450aaa94fecbd8a940d1</data>
    </node>
    <node id="MUJER DE 48 A&#209;OS">
      <data key="d0">PERSON</data>
      <data key="d1">Una mujer de 48 a&#241;os que ha sido intervenida de cirug&#237;a bari&#225;trica y tiene antecedentes de diabetes tipo 2 y obesidad m&#243;rbida.</data>
      <data key="d2">39ea441f219d949e8bc3c6f430970689</data>
