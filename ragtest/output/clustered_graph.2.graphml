      <data key="d6">12105</data>
      <data key="d7">1e922ede3c21482b857162081ad782cd</data>
    </node>
    <node id="DIARREA INVASIVA">
      <data key="d0">EVENT</data>
      <data key="d1">Diarrea invasiva or dysentery is a more severe form of diarrhea where mucus or blood is present in the stool, often linked to infections by specific pathogens.</data>
      <data key="d2">db3e6b8c8514f310618353612e378ce6</data>
      <data key="d3">1755</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">12106</data>
      <data key="d7">b73900b4d276406ab859753427d34c03</data>
    </node>
    <node id="ESCHIRICHIA COLI">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Escherichia coli is a type of bacteria that can cause severe gastrointestinal illness, including diarrhea.</data>
      <data key="d2">db3e6b8c8514f310618353612e378ce6</data>
      <data key="d3">1755</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12107</data>
      <data key="d7">11cfaa3778c14ebdb07e674f7b1e0e81</data>
    </node>
    <node id="ENTAMOEBA HISTOLYTICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Entamoeba histolytica is a parasitic protozoan that can cause amoebic dysentery and is associated with diarrhea.</data>
      <data key="d2">db3e6b8c8514f310618353612e378ce6</data>
      <data key="d3">1755</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12108</data>
      <data key="d7">b06c6ed7a2d9433aac82ebbbc62e4689</data>
    </node>
    <node id="VIBRIO CHOLERAE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Vibrio cholerae is a bacterium that causes cholera, leading to severe watery diarrhea and high morbidity and mortality rates.</data>
      <data key="d2">db3e6b8c8514f310618353612e378ce6</data>
      <data key="d3">1753</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12109</data>
      <data key="d7">b88b56cc786d4353bf0e41baf75a743c</data>
    </node>
    <node id="SALMONELLA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Salmonella is a genus of bacteria that can cause foodborne illness, often resulting in diarrhea.</data>
      <data key="d2">db3e6b8c8514f310618353612e378ce6</data>
      <data key="d3">1753</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12110</data>
      <data key="d7">3eb0ced39eda428eb4b31a8c036d605c</data>
    </node>
    <node id="CAMPYLOBACTER">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Campylobacter is a type of bacteria that can lead to gastrointestinal infections, commonly resulting in diarrhea.</data>
      <data key="d2">db3e6b8c8514f310618353612e378ce6</data>
      <data key="d3">1753</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12111</data>
      <data key="d7">64d1396d39c64ff0894f23cfc8ae330c</data>
