    <node id="AUTLOGOUS STEM CELL TRANSPLANTATION">
      <data key="d0">EVENT</data>
      <data key="d1">Autologous stem cell transplantation is a procedure where a patient's own stem cells are collected, stored, and then infused back after intensive treatment.</data>
