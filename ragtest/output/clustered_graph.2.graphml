    <node id="SINDROME DE LA PERSONA RIGIDA">
      <data key="d0">EVENT</data>
      <data key="d1">Stiff-person syndrome is a rare neurological disorder characterized by muscle rigidity and spasms, with a notable association with diabetes in some patients.</data>
      <data key="d2">ac89fcaa7dcce835c0d5b9ed9ce94cea</data>
      <data key="d5">3</data>
