      <data key="d11">978fdda9be9d4702bf93248e6682917d</data>
      <data key="d12">5038</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA CARRAGENINA" target="CHONDRUS CRISPUS">
      <data key="d8">8.0</data>
      <data key="d9">La carragenina se extrae de Chondrus crispus, un tipo de alga roja utilizada en la industria alimentaria.</data>
