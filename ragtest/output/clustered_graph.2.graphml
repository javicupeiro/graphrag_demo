    </node>
    <node id="PUDIN">
      <data key="d0">EVENT</data>
      <data key="d1">Pudding is a food with a viscosity greater than 1750 cP, which can only be consumed with a spoon and maintains its shape.</data>
      <data key="d2">c30b47b534824f4d1b74f3c0bb00ffd9</data>
      <data key="d5">0</data>
