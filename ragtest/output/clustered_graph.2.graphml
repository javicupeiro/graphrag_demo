      <data key="d6">13181</data>
      <data key="d7">5fee49f92cd9444787d7e0e2db17453b</data>
    </node>
    <node id="DEPLECI&#211;N INTRACELULAR">
      <data key="d0">EVENT</data>
      <data key="d1">Intracellular depletion of amino acids occurs in burn patients, affecting their metabolic processes.</data>
      <data key="d2">b1b42f264a7bfe8d5c9b931ef8b29b02</data>
      <data key="d3">1113</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13182</data>
      <data key="d7">afbe775a07b64cab9214b7071e674217</data>
    </node>
    <node id="TORONTO EQUATION">
      <data key="d0">EVENT</data>
      <data key="d1">The Toronto equation is a formula suggested for calculating energy requirements in burned patients, based on regression analysis from indirect calorimetry studies.</data>
      <data key="d2">fb0c6cd346ca91e15f8ff1cc07570d9d</data>
      <data key="d3">687</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">13183</data>
      <data key="d7">d52e312db59f4e4a8c7ba4cf57ed5a1b</data>
    </node>
    <node id="HARRIS-BENEDICT FORMULA">
      <data key="d0">EVENT</data>
      <data key="d1">The Harris-Benedict formula is a method used to estimate an individual's basal metabolic rate and daily energy requirements.</data>
      <data key="d2">fb0c6cd346ca91e15f8ff1cc07570d9d</data>
      <data key="d3">687</data>
      <data key="d4">2</data>
