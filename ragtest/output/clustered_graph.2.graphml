    </node>
    <node id="RECEPTORES DE SOMATOSTATINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los receptores de somatostatina son prote&#237;nas que se encuentran en la superficie de las c&#233;lulas y que median los efectos de la somatostatina.</data>
      <data key="d2">b18ef5c018c100e1582224fe82f03626</data>
      <data key="d3">1344</data>
      <data key="d4">2</data>
