    <node id="TAC CRANEAL">
      <data key="d0">EVENT</data>
      <data key="d1">La TAC craneal es un procedimiento de imagen utilizado para diagnosticar condiciones relacionadas con el cerebro, incluyendo tumores que pueden causar el s&#237;ndrome de Cushing.</data>
      <data key="d2">1de72f0ea3a981289854857b691b52af</data>
