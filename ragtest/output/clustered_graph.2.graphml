    </node>
    <node id="ENFERMEDAD DE ERDHEIM-CHESTER">
      <data key="d0">EVENT</data>
      <data key="d1">Erdheim-Chester disease is a rare form of non-Langerhans histiocytosis that can cause systemic symptoms and affect the pituitary gland.</data>
      <data key="d2">4faa9b46acd7540904fc5b0772bb7c51</data>
