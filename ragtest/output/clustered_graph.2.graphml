      <data key="d7">e0edd5e78f034178ae65e4f1d7d8b731</data>
    </node>
    <node id="FOSTER JE">
      <data key="d0">PERSON</data>
      <data key="d1">Foster JE is a researcher who investigated the effects of gentamicin on renal handling of electrolytes.</data>
      <data key="d2">b9342cecd69cdc0e9936df041657f5f5</data>
