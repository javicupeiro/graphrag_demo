    </node>
    <node id="GETNE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">GETNE is an organization that awarded Nuria Valdes Gallego a research grant in 2015.</data>
      <data key="d2">cc9543ac7abe58ae289e1fbd5353e219</data>
      <data key="d3">1367</data>
