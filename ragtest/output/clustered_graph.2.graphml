    </node>
    <node id="RECUENTO DE RETICULOCITOS">
      <data key="d0">EVENT</data>
      <data key="d1">Reticulocyte count is a test that measures the number of young red blood cells in the blood, which can help assess bone marrow function and response to anemia.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
