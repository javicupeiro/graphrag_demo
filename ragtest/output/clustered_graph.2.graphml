      <data key="d10">73d47e377c2910da3393d7bb65f80e8e</data>
      <data key="d11">81bf777691fa42ad8cbf669ed1965967</data>
      <data key="d12">13341</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INFECTION" target="HEMATOPOIETIC CELL TRANSPLANTATION">
      <data key="d8">9.0</data>
      <data key="d9">Hematopoietic cell transplantation recipients are particularly vulnerable to infections due to their compromised immune systems.</data>
      <data key="d10">73d47e377c2910da3393d7bb65f80e8e</data>
      <data key="d11">3eb35e428a2f48c6ac65314c9277a8e8</data>
      <data key="d12">13342</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INFECTION" target="VENOUS ACCESS">
      <data key="d8">7.0</data>
      <data key="d9">Infection is a common complication that can arise from venous access procedures</data>
      <data key="d10">3d5e0a3ef45c7ba15063791545dc4826</data>
      <data key="d11">f480836e9f674fde8f930398c14f2254</data>
      <data key="d12">13343</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INFECTION" target="STAPHYLOCOCCUS AUREUS">
      <data key="d8">8.0</data>
      <data key="d9">Staphylococcus aureus is a common cause of infections related to catheter use</data>
      <data key="d10">be901905a9eef428a784ea179931028a</data>
      <data key="d11">e124affdf6404aee9cf5850419b95bed</data>
      <data key="d12">13344</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INFECTION" target="CATHETER">
      <data key="d8">8.0</data>
      <data key="d9">Infections are commonly associated with the use of catheters, leading to complications such as sepsis</data>
      <data key="d10">be901905a9eef428a784ea179931028a</data>
      <data key="d11">f4dfd30e402c47b4bf4e047e893b16fc</data>
      <data key="d12">13345</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INFECTION" target="ENTEROBACTER">
      <data key="d8">7.0</data>
      <data key="d9">Enterobacter can cause infections in patients with catheters, leading to complications</data>
      <data key="d10">be901905a9eef428a784ea179931028a</data>
      <data key="d11">963ef74681e245899b3f47c9586b27d1</data>
      <data key="d12">13346</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INFECTION" target="ACINETOBACTER">
      <data key="d8">7.0</data>
      <data key="d9">Acinetobacter is associated with infections in patients with catheters</data>
      <data key="d10">be901905a9eef428a784ea179931028a</data>
      <data key="d11">824cdc9ea18e4971bda7d6393d05d3fd</data>
      <data key="d12">13347</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INFECTION" target="SERRETIA MARCESCENS">
      <data key="d8">7.0</data>
      <data key="d9">Serratia marcescens can cause infections in patients with catheters</data>
      <data key="d10">be901905a9eef428a784ea179931028a</data>
      <data key="d11">8a9893f454924cd6b54d1e679b658b81</data>
      <data key="d12">13348</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INFECTION" target="PROTEUS MIRABILIS">
      <data key="d8">1.0</data>
      <data key="d9">Proteus mirabilis is associated with urinary tract infections in patients with catheters</data>
      <data key="d10">be901905a9eef428a784ea179931028a</data>
      <data key="d11">3ed27df80e394eea9ee014b8ab4b3c6b</data>
      <data key="d12">13349</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIC HYPERSMOLAR STATE" target="NEFROPAT&#205;A DIAB&#201;TICA">
      <data key="d8">7.0</data>
      <data key="d9">Hyperglycemic hypersmolar state can contribute to the development of diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">baae57bab74d4d17a773ff1d6f1a124b</data>
      <data key="d12">13350</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="NATIONAL KIDNEY FOUNDATION">
      <data key="d8">1.0</data>
      <data key="d9">The National Kidney Foundation provides classifications and guidelines for diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">59c6125358eb4dfba491af961ada423c</data>
      <data key="d12">13351</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="GLUCOTOXICIDAD">
      <data key="d8">6.0</data>
      <data key="d9">Glucotoxicity contributes to the development of diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">00d401f1c93a409eb73c71b1d4496d91</data>
      <data key="d12">13352</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="HYPERTENSI&#211;N ARTERIAL">
      <data key="d8">8.0</data>
      <data key="d9">Hypertension is a major risk factor for the onset and progression of diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">53a8342ce08044a696c0d5ca5f378475</data>
      <data key="d12">13353</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="HIPERFILTRACI&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">Hyperfiltration is an early functional change that can lead to diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">dcc344bb6a1942858bc750d03d31a443</data>
      <data key="d12">13354</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="PROTEINURIA">
      <data key="d8">8.0</data>
      <data key="d9">Proteinuria is a common sign of diabetic nephropathy and indicates kidney damage</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">fa21a0e1d285439a8998ccbbaeeeb3eb</data>
      <data key="d12">13355</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="ATROFIA TUBULAR">
      <data key="d8">7.0</data>
      <data key="d9">Tubular atrophy is a characteristic finding in patients with diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">6e614c32e0be4feb9bf66cd2c3f3a284</data>
      <data key="d12">13356</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="FIBROSIS INTERSTICIAL">
      <data key="d8">7.0</data>
      <data key="d9">Interstitial fibrosis is often observed in the kidneys of patients with diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">d2c94390a77a4c4b80c368f649972a90</data>
      <data key="d12">13357</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="MICROHEMATURIA">
      <data key="d8">4.0</data>
      <data key="d9">Microhematuria may indicate a kidney issue that is not directly related to diabetes but requires further investigation</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">46d4c52f10834ffead9bb1098cad1492</data>
      <data key="d12">13358</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="PODOCITOS">
      <data key="d8">8.0</data>
      <data key="d9">Damage to podocytes is an early event in the progression of diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">1dabbb2bf1b3491fa6edaf82748b2efe</data>
      <data key="d12">13359</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEFROPAT&#205;A DIAB&#201;TICA" target="MATRIZ MESANGIAL">
      <data key="d8">1.0</data>
      <data key="d9">Expansion of the mesangial matrix is associated with the progression of diabetic nephropathy</data>
      <data key="d10">08f89bb92750950761f8f59bffa402c1</data>
      <data key="d11">449cdf55a3884f4d8c9ffd530463b831</data>
      <data key="d12">13360</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NATIONAL KIDNEY FOUNDATION" target="ALBUMINURIA">
      <data key="d8">1.0</data>
      <data key="d9">The National Kidney Foundation addresses albuminuria in its guidelines for chronic kidney disease management.</data>
      <data key="d10">8886631425cf090457592f633ee8cae8</data>
      <data key="d11">62b46cfe23ce43478f1471591f2948d4</data>
      <data key="d12">13361</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NATIONAL KIDNEY FOUNDATION" target="NICE">
      <data key="d8">1.0</data>
      <data key="d9">Both organizations provide guidelines related to kidney health and management of related conditions</data>
      <data key="d10">d77ee7b5259ebdf92e8375c5f2d322e6</data>
      <data key="d11">6448d0f5cabd49cdb7e8a198655a5218</data>
      <data key="d12">13362</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NATIONAL KIDNEY FOUNDATION" target="DIALYSIS OUTCOMES AND PRACTICE PATTERNS STUDY">
      <data key="d8">7.0</data>
      <data key="d9">The National Kidney Foundation provides guidelines that are relevant to the findings of the Dialysis Outcomes and Practice Patterns Study</data>
      <data key="d10">1f8cd198519be7b535a3f5be8181931c</data>
      <data key="d11">6dba0746b40e459fad0063994f2c469b</data>
      <data key="d12">13363</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NATIONAL KIDNEY FOUNDATION" target="WILLIAMS TREATISE ON ENDOCRINOLOGY">
      <data key="d8">6.0</data>
      <data key="d9">The National Kidney Foundation's guidelines are informed by comprehensive medical texts like the Williams Treatise on Endocrinology</data>
      <data key="d10">1f8cd198519be7b535a3f5be8181931c</data>
      <data key="d11">b51856b58210411e9a82ec196664e321</data>
      <data key="d12">13364</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALBUMINURIA" target="DIABETIC NEPHROPATHY">
      <data key="d8">8.0</data>
      <data key="d9">Albuminuria is a key indicator of diabetic nephropathy, often used to diagnose and monitor the disease.</data>
      <data key="d10">8886631425cf090457592f633ee8cae8</data>
      <data key="d11">752dc209458e4a3fa56e28ab656bad55</data>
      <data key="d12">13365</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERTENSI&#211;N ARTERIAL" target="VAR&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">The patient has a history of hypertension, which is part of his medical profile</data>
      <data key="d10">3356667d6f35de6a8587ece00f8c6580</data>
      <data key="d11">f585a806fdc347c7abd7330cfe2e9080</data>
      <data key="d12">13366</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD RENAL CR&#211;NICA" target="MAR&#205;A">
      <data key="d8">6.0</data>
      <data key="d9">Mar&#237;a's condition may be related to chronic kidney disease, as indicated by her symptoms and medical history</data>
      <data key="d10">d77ee7b5259ebdf92e8375c5f2d322e6</data>
      <data key="d11">8c1cddf67f4648f7ad3b8110fb9061f6</data>
      <data key="d12">13367</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD RENAL CR&#211;NICA" target="ESTATINAS">
      <data key="d8">8.0</data>
      <data key="d9">Las estatinas son recomendadas para el manejo de l&#237;pidos en pacientes con enfermedad renal cr&#243;nica, especialmente en aquellos con enfermedad cardiovascular</data>
      <data key="d10">14b7a8c27778bb8821d74790cd2da5ea</data>
      <data key="d11">121c19c4d52143569d633647f8617462</data>
      <data key="d12">13368</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD RENAL CR&#211;NICA" target="K-DOQI">
      <data key="d8">7.0</data>
      <data key="d9">Las gu&#237;as K-Doqi proporcionan recomendaciones sobre la ingesta de f&#243;sforo para pacientes con enfermedad renal cr&#243;nica</data>
      <data key="d10">7925a5f252f3bfc107f8199401edf824</data>
      <data key="d11">23d6941efd264b9ab7b97a3e187b20fd</data>
      <data key="d12">13369</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD RENAL CR&#211;NICA" target="DIARREA AGUDA">
      <data key="d8">6.0</data>
      <data key="d9">La enfermedad renal cr&#243;nica es una comorbilidad que puede complicar el manejo de la diarrea aguda.</data>
      <data key="d10">28f6d6818b8f0ce3d2b8f483fe0dac6c</data>
      <data key="d11">636845a4d4ee43e1b0a29525dabb606d</data>
      <data key="d12">13370</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD RENAL CR&#211;NICA" target="F&#211;RMULAS ESPEC&#205;FICAS">
      <data key="d8">1.0</data>
      <data key="d9">Formulas for patients with renal disease are a type of specific formula used in enteral nutrition</data>
      <data key="d10">d028f23d86d7ed32eebe35c5d90765f2</data>
      <data key="d11">3ca38fb07b8e43b2854e0586be68fd4f</data>
      <data key="d12">13371</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD RENAL CR&#211;NICA" target="PREDI&#193;LISIS">
      <data key="d8">7.0</data>
      <data key="d9">La predi&#225;lisis es una fase de la enfermedad renal cr&#243;nica que requiere atenci&#243;n nutricional</data>
      <data key="d10">169eceabd2bd24183f24faccb2c00088</data>
      <data key="d11">c40f9149206a46e09e2331ee8b37c376</data>
      <data key="d12">13372</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETIC NEPHROPATHY" target="RETINOPATHY">
      <data key="d8">6.0</data>
      <data key="d9">Diabetic nephropathy and retinopathy are both complications of diabetes that require careful management to prevent progression.</data>
      <data key="d10">8886631425cf090457592f633ee8cae8</data>
      <data key="d11">3d05dc775e344935bb0b959ca3780bc2</data>
      <data key="d12">13373</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RETINOPATHY" target="VEGF">
      <data key="d8">7.0</data>
      <data key="d9">VEGF is targeted in treatments for diabetic retinopathy to prevent vision loss by inhibiting abnormal blood vessel growth.</data>
      <data key="d10">8886631425cf090457592f633ee8cae8</data>
      <data key="d11">d4321dd7a1694a7980c1bf17000c045b</data>
      <data key="d12">13374</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RETINOPATHY" target="PANRETINAL LASER COAGULATION">
      <data key="d8">1.0</data>
      <data key="d9">Panretinal laser coagulation is a standard treatment for patients with proliferative diabetic retinopathy to reduce the risk of vision loss.</data>
      <data key="d10">8886631425cf090457592f633ee8cae8</data>
      <data key="d11">7dd36dc81ca447fda5a43e453a042e99</data>
      <data key="d12">13375</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VEGF" target="RETINOPAT&#205;A DIAB&#201;TICA">
      <data key="d8">7.0</data>
      <data key="d9">El incremento del VEGF se ha relacionado con la patog&#233;nesis de la retinopat&#237;a diab&#233;tica</data>
      <data key="d10">4f445fb2c039daae07b71341057c9b9b</data>
      <data key="d11">d50627c1835a467aaf6b91ac7ed74341</data>
      <data key="d12">13376</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VEGF" target="POEMS">
      <data key="d8">1.0</data>
      <data key="d9">VEGF is mentioned in the context of the criteria for diagnosing POEMS syndrome</data>
      <data key="d10">77fb6e19a2882617993d1d283afcb86a</data>
      <data key="d11">16f6787c7f1f46b78169132e6a49c11a</data>
      <data key="d12">13377</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES-2019" target="WILKINSON C">
      <data key="d8">8.0</data>
      <data key="d9">Wilkinson C is an author of the research presented in Diabetes-2019</data>
      <data key="d10">784f8d7f49cdce2d0611be585eda7e2c</data>
      <data key="d11">ea6ac5ed486c4482971c4ec3d2657806</data>
      <data key="d12">13378</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES-2019" target="KLEIN R">
      <data key="d8">8.0</data>
      <data key="d9">Klein R is an author of the research presented in Diabetes-2019</data>
      <data key="d10">784f8d7f49cdce2d0611be585eda7e2c</data>
      <data key="d11">ed0f9b2b16d84879aa05290d4392e718</data>
      <data key="d12">13379</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES-2019" target="GARDNER TW">
      <data key="d8">8.0</data>
      <data key="d9">Gardner TW is an author of the research presented in Diabetes-2019</data>
      <data key="d10">784f8d7f49cdce2d0611be585eda7e2c</data>
      <data key="d11">8f9c922adf6f497189a45ecb387e0dea</data>
      <data key="d12">13380</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="RETINOPAT&#205;A DIAB&#201;TICA">
      <data key="d8">8.0</data>
      <data key="d9">Diabetes Mellitus Type 1 is associated with the development of retinopathy, which can occur after prolonged hyperglycemia</data>
      <data key="d10">784f8d7f49cdce2d0611be585eda7e2c</data>
      <data key="d11">48db9a2235ae4eea9f9c38d6ab174a7b</data>
      <data key="d12">13381</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="DIABETIC RETINOPATHY">
      <data key="d8">6.0</data>
      <data key="d9">Patients with Diabetes Mellitus Type 1 are at risk of developing diabetic retinopathy due to prolonged high blood sugar levels</data>
      <data key="d10">aa9279dacd764b478618ae36af93ad83</data>
      <data key="d11">f73ba0b36f61481dbbb87b8d3cef7fb5</data>
      <data key="d12">13382</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="DIABETIC NEUROPATHY">
      <data key="d8">7.0</data>
      <data key="d9">Diabetic neuropathy can develop in patients with Diabetes Mellitus Type 1 due to poor glucose control</data>
      <data key="d10">fe5f390fb67fd3b1ad222db3500574b9</data>
      <data key="d11">f3b591dc457e4d19b9fca6f575307390</data>
      <data key="d12">13383</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="KLINEFELTER SYNDROME">
      <data key="d8">7.0</data>
      <data key="d9">Patients with Klinefelter syndrome are at increased risk for developing diabetes mellitus type 1</data>
      <data key="d10">5509bb6959e4faa5989289c1ddbcc96b</data>
      <data key="d11">784ec285bb524509b9f1ddbb0102acaf</data>
      <data key="d12">13384</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="TRASTORNO DEL COMPORTAMIENTO ALIMENTARIO">
      <data key="d8">8.0</data>
      <data key="d9">Diabetes Mellitus Type 1 can lead to the development of eating disorders due to the challenges of managing insulin and weight, particularly in adolescents</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">2123bca783d7423da35d8b6041d7dff0</data>
      <data key="d12">13385</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="FUNDACI&#211;N SED">
      <data key="d8">6.0</data>
      <data key="d9">The Fundaci&#243;n SED provides statistics and support for minors suffering from Diabetes Mellitus Type 1 in Spain, highlighting the prevalence of the disease</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">0be53aeddc4c45769f39bcf87148cc52</data>
      <data key="d12">13386</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="BULIMIA NERVIOSA">
      <data key="d8">8.0</data>
      <data key="d9">The management of Diabetes Mellitus Type 1 can lead to Bulimia Nervosa as individuals may engage in binge eating and purging to control weight</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">2e59470bd6ae477bb7a5a023c4db6472</data>
      <data key="d12">13387</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="TRASTORNO DE EVITACI&#211;N/RESTRICCI&#211;N DE ALIMENTOS">
      <data key="d8">7.0</data>
      <data key="d9">The challenges of managing Diabetes Mellitus Type 1 can result in Avoidant/Restrictive Food Intake Disorder as patients may avoid certain foods</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">0495d7ce51dc486e8fc6ecf025a6bec5</data>
      <data key="d12">13388</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="TRASTORNO DE ATRACONES">
      <data key="d8">7.0</data>
      <data key="d9">Individuals with Diabetes Mellitus Type 1 may experience Binge Eating Disorder due to emotional stress related to their condition</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">f1aaf4924c32413a8afeeaf2c97cbbd1</data>
      <data key="d12">13389</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="PICA">
      <data key="d8">6.0</data>
      <data key="d9">There may be cases where individuals with Diabetes Mellitus Type 1 develop Pica, leading to serious health risks due to non-nutritive eating behaviors</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">f66e7922fa394368bd10c45c0f645b65</data>
      <data key="d12">13390</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="TRASTORNO DE RUMIACI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">The stress of managing Diabetes Mellitus Type 1 can lead to Rumination Disorder, where individuals may regurgitate food</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">cb04f8426c564c6790ee97bd00efbd2e</data>
      <data key="d12">13391</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS TYPE 1" target="BICI">
      <data key="d8">9.0</data>
