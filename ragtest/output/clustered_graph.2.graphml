      <data key="d7">4cbb80704f7d403d8a0e54cc0f6e0ec7</data>
    </node>
    <node id="DIABETES MELLITUS TIPO">
      <data key="d0">PERSON</data>
      <data key="d1">La diabetes mellitus tipo es una condici&#243;n m&#233;dica que puede aumentar el riesgo de infecci&#243;n en pacientes que se someten a la gastrostom&#237;a endosc&#243;pica percut&#225;nea.</data>
      <data key="d2">60a2803170af3c20448ef70091bdfadd</data>
      <data key="d5">0</data>
      <data key="d6">14506</data>
      <data key="d7">c2a58683adf94fcbb9daf48dd1136cdf</data>
    </node>
    <node id="GEP">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">GEP refers to Gastrostomy Enteral Feeding, a medical procedure involving the placement of a tube for nutritional support in patients who cannot eat by mouth.</data>
      <data key="d2">b0b96ec7b9f57581fe18f0ac902af707</data>
      <data key="d3">1217</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">14507</data>
      <data key="d7">6fddb701807d4446ab12809988b9ed95</data>
    </node>
    <node id="BRONCOASPIRATION">
      <data key="d0">EVENT</data>
      <data key="d1">Broncoaspiration is a medical event where food or liquid enters the lungs, often leading to pneumonia and respiratory complications in patients receiving enteral nutrition.</data>
      <data key="d2">b0b96ec7b9f57581fe18f0ac902af707</data>
      <data key="d3">1215</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">14508</data>
      <data key="d7">262a669039a74ca7a7a59757e4eb3dc6</data>
    </node>
    <node id="GRANULOMA">
      <data key="d0">EVENT</data>
      <data key="d1">Granuloma formation is a complication that can occur in patients with GEP, characterized by an abnormal tissue response to irritation or infection.</data>
      <data key="d2">b0b96ec7b9f57581fe18f0ac902af707</data>
      <data key="d3">1217</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14509</data>
