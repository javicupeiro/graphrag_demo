      <data key="d8">7.0</data>
      <data key="d9">Dra. Rosa Burgos Pel&#225;ez is involved in the study and management of adrenoleucodystrophy through dietary interventions.</data>
      <data key="d10">b92f47a5ea6a962826cedb992b832f70</data>
      <data key="d11">43831246199c476196ecdf4b0611ce53</data>
      <data key="d12">14530</data>
      <data key="d13">2</data>
