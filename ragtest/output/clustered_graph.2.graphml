      <data key="d5">6</data>
      <data key="d6">305</data>
      <data key="d7">d2caef59ff57445597761da23518c4b7</data>
    </node>
    <node id="LANDESKLINIKUM DONAUREGION GUGGING">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Landesklinikum Donauregion Gugging is a medical institution in Austria where the GUSS was designed.</data>
      <data key="d2">7ff388a8f346ea7b1ceece48ed64b1a2</data>
      <data key="d3">1222</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">306</data>
      <data key="d7">fff2c5861fc94a6dac2d776b6c226108</data>
    </node>
    <node id="UNIVERSITY OF DANUBE KREMS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The University of Danube Krems is an academic institution in Austria that collaborated in the development of the GUSS.</data>
      <data key="d2">7ff388a8f346ea7b1ceece48ed64b1a2</data>
      <data key="d3">1222</data>
      <data key="d4">2</data>
