    </node>
    <node id="PEPTIDOS NATRIURETICOS">
      <data key="d0">EVENT</data>
      <data key="d1">P&#233;ptidos natriur&#233;ticos play a role in regulating vascular tone and promoting renal excretion of sodium and water, with beneficial metabolic actions.</data>
      <data key="d2">c575e742f54d5f3f674a8e52ad041221</data>
      <data key="d3">1390</data>
      <data key="d4">2</data>
