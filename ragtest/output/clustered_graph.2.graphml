      <data key="d7">2d9a6bfc019c432eb9d3f5065b674e6d</data>
    </node>
    <node id="COMPLEJO HOSPITALARIO UNIVERSITARIO DE EL FERROL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Complex University Hospital of El Ferrol is a healthcare institution where Diego Bellido Guerrero serves as the Head of Service in Endocrinology and Nutrition.</data>
      <data key="d2">3cb4ce49ec9f9c770ff8b27359c0049d</data>
      <data key="d3">1449</data>
