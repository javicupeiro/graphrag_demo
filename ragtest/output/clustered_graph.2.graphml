    <node id="NUTRICIONES PARENTERALES ADULTOS PROTOCOLIZADAS EN EL HOSPITAL">
      <data key="d0">EVENT</data>
      <data key="d1">A protocol for adult parenteral nutrition established in the hospital, detailing the nutritional components and monitoring processes.</data>
