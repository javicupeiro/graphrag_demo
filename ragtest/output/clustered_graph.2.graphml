    <node id="DEFICIENCIA DE COBRE">
      <data key="d0">EVENT</data>
      <data key="d1">La deficiencia de cobre puede llevar a anemia, osteoporosis y alteraciones neurol&#243;gicas.</data>
      <data key="d2">89fc75473a09f83406bce1f9e3a15a3d</data>
      <data key="d3">646</data>
