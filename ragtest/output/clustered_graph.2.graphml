      <data key="d7">2a31c1ec53a849a1a30581bd23280971</data>
    </node>
    <node id="FLUIDOS IV">
      <data key="d0">EVENT</data>
      <data key="d1">Fluidos IV are intravenous fluids administered to patients to maintain hydration and electrolyte balance, especially in cases of acute pancreatitis.</data>
      <data key="d2">6a12bee5b54e4c1706548bca972516e3</data>
