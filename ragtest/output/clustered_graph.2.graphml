      <data key="d10">2bbe847617971cacfe15b2c970de2d21</data>
      <data key="d11">4294daddcf614aabb88f414e86d7b777</data>
      <data key="d12">4189</data>
      <data key="d13">2</data>
    </edge>
    <edge source="V&#211;MITOS" target="VALORACI&#211;N GLOBAL SUBJETIVA">
      <data key="d8">6.0</data>
      <data key="d9">Los v&#243;mitos son un s&#237;ntoma que se eval&#250;a en la Valoraci&#243;n Global Subjetiva para determinar el estado nutricional</data>
      <data key="d10">e12655d89e99e57ce1f6d87563adf674</data>
      <data key="d11">e78aac4b565741c0b9ff12ac0f3e3d8b</data>
      <data key="d12">4190</data>
      <data key="d13">2</data>
    </edge>
    <edge source="V&#211;MITOS" target="NAUSEAS">
      <data key="d8">7.0</data>
      <data key="d9">Nauseas often precede v&#243;mitos, indicating a related symptomatology</data>
      <data key="d10">79a751fb45e4b69c946d088100f43654</data>
      <data key="d11">95be3fee31014d85a7726dba7d84c293</data>
      <data key="d12">4191</data>
      <data key="d13">2</data>
    </edge>
    <edge source="V&#211;MITOS" target="NUTRICI&#211;N PARENTERAL">
      <data key="d8">6.0</data>
      <data key="d9">Los v&#243;mitos pueden complicar la administraci&#243;n de nutrici&#243;n parenteral, aumentando las necesidades de l&#237;quidos y electrolitos</data>
      <data key="d10">37ca60bdc28109c9bec995e3c433c801</data>
      <data key="d11">8dad418a3d5c48678317330ae08e362a</data>
      <data key="d12">4192</data>
      <data key="d13">2</data>
    </edge>
    <edge source="V&#211;MITOS" target="ALIMENTACI&#211;N ENTERAL">
      <data key="d8">6.0</data>
      <data key="d9">V&#243;mitos can indicate intolerance to enteral feeding in infants</data>
      <data key="d10">aacaabd084b7839bdedf5fbebfd7dcf4</data>
      <data key="d11">edbdcb43837041eda69f9ebc5d8035bd</data>
      <data key="d12">4193</data>
      <data key="d13">2</data>
    </edge>
    <edge source="V&#211;MITOS" target="PANCREATITIS AGUDA">
      <data key="d8">7.0</data>
