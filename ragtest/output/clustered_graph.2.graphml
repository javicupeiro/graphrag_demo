    </node>
    <node id="FECHAS DE DURACI&#211;N/CADUCIDAD">
      <data key="d0">EVENT</data>
      <data key="d1">Las fechas de duraci&#243;n y caducidad son informaci&#243;n cr&#237;tica que debe aparecer en el etiquetado de productos alimenticios para garantizar la seguridad del consumidor.</data>
      <data key="d2">8255943be503f6709a8e63d7d33b79d1</data>
