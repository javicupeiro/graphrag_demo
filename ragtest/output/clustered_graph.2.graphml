    <node id="CORTEX SUPRARRENAL">
      <data key="d0">GEO</data>
      <data key="d1">The adrenal cortex is the outer region of the adrenal glands, responsible for producing hormones such as aldosterone.</data>
      <data key="d2">41b6e4025d59564d7881f459e230639d</data>
      <data key="d3">1282</data>
