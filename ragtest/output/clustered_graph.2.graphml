      <data key="d12">3761</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="MULTICENTER PROSPECTIVE COHORT STUDY">
      <data key="d8">1.0</data>
      <data key="d9">The multicenter prospective cohort study investigates the impact of nutritional support on clinical outcomes in patients at nutritional risk</data>
      <data key="d10">9ec3bf4d23f9f4fca8984c81d95aac41</data>
      <data key="d11">b381fcb2f72b43f5a493f4ca8c8929d8</data>
