      <data key="d6">4627</data>
      <data key="d7">c1b62cbf418e43689a9d3c4507f19bf6</data>
    </node>
    <node id="BETHESDA SYSTEM">
      <data key="d0" />
      <data key="d1">The Bethesda System is a classification system specifically designed for reporting thyroid cytopathology. It offers comprehensive guidelines for the management of thyroid nodules and cancer, facilitating standardized communication and decision-making in clinical practice.</data>
      <data key="d2">3491690ff2b417d00598f7df8e68f4d6,cb3b93a50040c892ecf439582ebb6ac0</data>
      <data key="d3">1673</data>
