    <node id="SUSTANCIAS QUE CAUSAN ALERGIAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Las sustancias que causan alergias son ingredientes que deben ser claramente informados en los productos alimenticios.</data>
      <data key="d2">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d3">635</data>
      <data key="d4">2</data>
