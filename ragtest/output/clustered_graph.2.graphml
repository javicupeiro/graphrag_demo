      <data key="d10">4fbc9ba7c1f3ff190b594c75e7eac015</data>
      <data key="d11">a05dc1b218524828aed0cabf92635a40</data>
      <data key="d12">3516</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="CAT&#201;TER INTRAVASCULAR">
      <data key="d8">8.0</data>
      <data key="d9">Patients require intravascular catheters for the administration of medications and nutrition.</data>
      <data key="d10">61eea56f443c7bb2509edd6f42af2643</data>
      <data key="d11">5f6114d555a7445ea0d3ffd73ae0ad4a</data>
      <data key="d12">3517</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="TOLVAPT&#193;N">
      <data key="d8">8.0</data>
      <data key="d9">The patient is receiving tolvapt&#225;n as part of their treatment for SIADH</data>
      <data key="d10">85cfae7019d0efa6f0c87f5cd5b9ce8e</data>
      <data key="d11">ef2f8e3e2e2641afa561f82da6eb7b07</data>
      <data key="d12">3518</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="DESMOPRESINA">
      <data key="d8">1.0</data>
      <data key="d9">The patient may receive desmopresina alongside tolvapt&#225;n to manage sodium levels</data>
      <data key="d10">85cfae7019d0efa6f0c87f5cd5b9ce8e</data>
      <data key="d11">e94a820fe4ef43ef8f3d3b78b0bee0b8</data>
      <data key="d12">3519</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="SIADH">
      <data key="d8">8.0</data>
      <data key="d9">The patient is being treated for SIADH, which affects their sodium levels</data>
      <data key="d10">85cfae7019d0efa6f0c87f5cd5b9ce8e</data>
      <data key="d11">a01c016b10bd45a48c2388a6af195e65</data>
      <data key="d12">3520</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="AGUAS">
      <data key="d8">7.0</data>
      <data key="d9">The patient is advised to drink water to manage initial thirst and sodium levels during treatment</data>
      <data key="d10">85cfae7019d0efa6f0c87f5cd5b9ce8e</data>
      <data key="d11">a4edf8e9c4c643468f9cc21cdbe3018f</data>
      <data key="d12">3521</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="HIPONATREMIA">
      <data key="d8">9.0</data>
      <data key="d9">The patient is experiencing hyponatremia, which is the condition being treated</data>
      <data key="d10">85cfae7019d0efa6f0c87f5cd5b9ce8e</data>
      <data key="d11">5421aadb4a7d44f4824bafe7839c45f7</data>
      <data key="d12">3522</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="FURSEMIDA">
      <data key="d8">8.0</data>
      <data key="d9">Furosemide is administered to patients to manage hyponatremia</data>
      <data key="d10">306519cca8810e0ff1c973128a75200a</data>
      <data key="d11">95573a25fee04b76b6c91222fed0fc1e</data>
      <data key="d12">3523</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="HIPOANTREMIA GRAVE">
      <data key="d8">1.0</data>
      <data key="d9">Severe hyponatremia poses a significant risk to patients, necessitating urgent treatment</data>
      <data key="d10">306519cca8810e0ff1c973128a75200a</data>
      <data key="d11">07c2444813a94e399a8e6a8d844a6be1</data>
      <data key="d12">3524</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="M&#201;DICO">
      <data key="d8">17.0</data>
      <data key="d9">The PACIENTE and M&#201;DICO are integral components of the healthcare system, with the M&#201;DICO playing a crucial role in assessing the condition of the PACIENTE. The M&#201;DICO is responsible for determining the necessity of treatment, which may include involuntary hospitalization if deemed necessary. For effective healthcare delivery, it is essential that the PACIENTE and M&#201;DICO establish a relationship founded on trust and open communication. This relationship enhances the overall quality of care and ensures that the PACIENTE's needs are adequately addressed.</data>
      <data key="d10">574c4f0c1e9d196b5007cf183174ecaa,eaa675a346becd53a4fcfacbb99def88</data>
      <data key="d11">ccb8f9d609584bca9647ecaded54fdd9</data>
      <data key="d12">3525</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="CONSENTIMIENTO INFORMADO">
      <data key="d8">18.0</data>
      <data key="d9">The patient must provide informed consent prior to any medical intervention or treatment. This requirement ensures that the patient is fully aware of the procedures and potential risks involved before proceeding with medical care.</data>
      <data key="d10">9934fdd98a0d66fb3ff7ac1b56b18460,e475fe60f9aab6773eddfe8bad25eef6</data>
      <data key="d11">fadd2e791a61421ea81a04be547f3f15</data>
      <data key="d12">3526</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="M&#201;DICO RESPONSABLE">
      <data key="d8">8.0</data>
      <data key="d9">El m&#233;dico responsable debe garantizar que el paciente reciba la informaci&#243;n necesaria para otorgar su consentimiento</data>
      <data key="d10">e475fe60f9aab6773eddfe8bad25eef6</data>
      <data key="d11">243a19f61eca4bc5b93b958407a025c1</data>
      <data key="d12">3527</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="LEY 41/2002">
      <data key="d8">16.0</data>
      <data key="d9">La Ley 41/2002 establece que el paciente debe dar su consentimiento informado para recibir tratamiento m&#233;dico. Esta ley regula espec&#237;ficamente el proceso de consentimiento informado que debe ser otorgado por el paciente antes de cualquier intervenci&#243;n m&#233;dica, asegurando as&#237; que el paciente est&#233; plenamente informado y de acuerdo con el tratamiento que se le va a proporcionar.</data>
      <data key="d10">9934fdd98a0d66fb3ff7ac1b56b18460,eaa675a346becd53a4fcfacbb99def88</data>
      <data key="d11">1d4ffac009a242fabd5e97f65f8c231d</data>
      <data key="d12">3528</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="ANOREXIA NERVIOSA">
      <data key="d8">24.0</data>
      <data key="d9">The patient is diagnosed with anorexia nerviosa, a condition that significantly impacts her ability to consent to treatment. This eating disorder often complicates the patient's situation, necessitating medical intervention and legal proceedings for her internment. As a result, the patient's condition requires careful consideration regarding her treatment options and the implications of her diagnosis on her capacity to make informed decisions about her care.</data>
      <data key="d10">5099515cbc35bc6330fb794c4f1d715d,9934fdd98a0d66fb3ff7ac1b56b18460,eaa675a346becd53a4fcfacbb99def88</data>
      <data key="d11">52a18d4cf38c433f8d12b561e19c8b3f</data>
      <data key="d12">3529</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="REPRESENTANTE LEGAL">
      <data key="d8">1.0</data>
      <data key="d9">El representante legal act&#250;a en nombre del paciente para asegurar que se respeten sus deseos en el tratamiento m&#233;dico</data>
      <data key="d10">9934fdd98a0d66fb3ff7ac1b56b18460</data>
      <data key="d11">d348a29b9ea2421e81879db9da850fd6</data>
      <data key="d12">3530</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="INSTRUCCIONES PREVIAS">
      <data key="d8">8.0</data>
      <data key="d9">El paciente puede dejar instrucciones previas para guiar el tratamiento en caso de incapacidad</data>
      <data key="d10">9934fdd98a0d66fb3ff7ac1b56b18460</data>
      <data key="d11">abc240a0013c4fb3bc7ac2bd4a0cc46b</data>
      <data key="d12">3531</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="TRATAMIENTO">
      <data key="d8">1.0</data>
      <data key="d9">El tratamiento se lleva a cabo en base a la informaci&#243;n y el consentimiento del paciente</data>
      <data key="d10">9934fdd98a0d66fb3ff7ac1b56b18460</data>
      <data key="d11">66a955642f394b148182904fc3940f72</data>
      <data key="d12">3532</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="CONVENIO DE BIO&#201;TICA DE OVIEDO">
      <data key="d8">7.0</data>
      <data key="d9">El Convenio de Bio&#233;tica de Oviedo establece condiciones bajo las cuales un paciente con trastorno mental puede ser tratado sin su consentimiento.</data>
      <data key="d10">eaa675a346becd53a4fcfacbb99def88</data>
      <data key="d11">b1687ae831f94356bc388fd5076ae624</data>
      <data key="d12">3533</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="LEY 1/2000">
      <data key="d8">8.0</data>
      <data key="d9">La Ley 1/2000 regula el internamiento involuntario de pacientes con trastornos mentales.</data>
      <data key="d10">eaa675a346becd53a4fcfacbb99def88</data>
      <data key="d11">600d60dbf7e04f469456065c0c2b67fd</data>
      <data key="d12">3534</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="AUDIENCIA PROVINCIAL DE BARCELONA">
      <data key="d8">8.0</data>
      <data key="d9">The Audiencia Provincial de Barcelona made a ruling regarding the internment of the patient suffering from anorexia nerviosa</data>
      <data key="d10">5099515cbc35bc6330fb794c4f1d715d</data>
      <data key="d11">756a0875303b4344be01a564a119a23b</data>
      <data key="d12">3535</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="TRIBUNAL">
      <data key="d8">8.0</data>
      <data key="d9">The tribunal made a decision regarding the internment of the patient based on legal and medical evaluations</data>
      <data key="d10">5099515cbc35bc6330fb794c4f1d715d</data>
      <data key="d11">3ca730c0a82647f8b143c519ad28e2e2</data>
      <data key="d12">3536</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="SERVICIOS DE ASISTENCIA AL MENOR">
      <data key="d8">6.0</data>
      <data key="d9">The Servicios de Asistencia al Menor may provide support and assistance to the patient during legal proceedings</data>
      <data key="d10">5099515cbc35bc6330fb794c4f1d715d</data>
      <data key="d11">16c80b4a8acb4bfca8e31f1a18cb17e0</data>
      <data key="d12">3537</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="FACULTATIVO">
      <data key="d8">8.0</data>
      <data key="d9">The facultativo is responsible for assessing the health of the patient and providing necessary medical reports to the tribunal</data>
      <data key="d10">5099515cbc35bc6330fb794c4f1d715d</data>
      <data key="d11">94bf84cce9b9425a8e1d8aaf77186961</data>
      <data key="d12">3538</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="HUELGA DE HAMBRE">
      <data key="d8">1.0</data>
      <data key="d9">The patient may be involved in a huelga de hambre as a form of protest against her internment or treatment</data>
      <data key="d10">5099515cbc35bc6330fb794c4f1d715d</data>
      <data key="d11">7f4eb114221545dbb449b3991e512c2a</data>
      <data key="d12">3539</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="UNIDADES DE NUTRICI&#211;N CL&#205;NICA">
      <data key="d8">8.0</data>
      <data key="d9">El paciente es atendido en las Unidades de Nutrici&#243;n Cl&#237;nica para evaluar y gestionar su estado nutricional</data>
      <data key="d10">f53d37f60efeb5d6cdba204bf8f2bd9b</data>
      <data key="d11">b1947674cfd24c65a848d351b6224040</data>
      <data key="d12">3540</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="CALIDAD DE LA ASISTENCIA SANITARIA">
      <data key="d8">9.0</data>
      <data key="d9">The quality of healthcare directly impacts patient satisfaction and outcomes</data>
      <data key="d10">22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d11">2f937e077f97495c8c9384ad6c73de17</data>
      <data key="d12">3541</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="MEDICINA BASADA EN LA EVIDENCIA">
      <data key="d8">8.0</data>
      <data key="d9">La Medicina Basada en la Evidencia busca integrar los valores y preferencias del paciente en la toma de decisiones cl&#237;nicas</data>
      <data key="d10">7dbb13ddc40e2f4d060338cabf9ecea7</data>
      <data key="d11">ccbb11f9db8b43cb8aede641911ab8be</data>
      <data key="d12">3542</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="CRIBAGE">
      <data key="d8">9.0</data>
      <data key="d9">El paciente es evaluado a trav&#233;s del cribage para determinar su estado nutricional</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">a7e9975b2ff445e1a52c63fc02f32d7b</data>
      <data key="d12">3543</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="EVALUACION">
      <data key="d8">9.0</data>
      <data key="d9">El paciente es objeto de evaluaci&#243;n para determinar el riesgo de malnutrici&#243;n</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">6bc325da7aed4ea4a4b9f4945a74776b</data>
      <data key="d12">3544</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="APETITO">
      <data key="d8">8.0</data>
      <data key="d9">El apetito del paciente es un factor clave en la evaluaci&#243;n nutricional</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">8509909303ba48b0855db204fb7ff3d8</data>
      <data key="d12">3545</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="MOVILIDAD">
      <data key="d8">8.0</data>
      <data key="d9">La movilidad del paciente se eval&#250;a para determinar su independencia y estado nutricional</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">07defafb085444ceb32c71135412a53c</data>
      <data key="d12">3546</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="ENFERMEDAD AGUDA">
      <data key="d8">7.0</data>
      <data key="d9">La presencia de enfermedad aguda en el paciente puede afectar su estado nutricional</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">f43c646ca1a44a978ee13bf0966f124e</data>
      <data key="d12">3547</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="PROBLEMAS NEUROPSICOL&#211;GICOS">
      <data key="d8">7.0</data>
      <data key="d9">Los problemas neuropsicol&#243;gicos del paciente son considerados en la evaluaci&#243;n nutricional</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">c73535f894a14aca9d36d0604b5c413d</data>
      <data key="d12">3548</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="&#205;NDICE DE MASA CORPORAL">
      <data key="d8">8.0</data>
      <data key="d9">El &#237;ndice de masa corporal del paciente se calcula para evaluar su estado nutricional</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">f287acd16e0e4e1f91b21bd2082cfa44</data>
      <data key="d12">3549</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="COMIDAS">
      <data key="d8">8.0</data>
      <data key="d9">La cantidad de comidas que consume el paciente se eval&#250;a para determinar su nutrici&#243;n</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">4b4e398d015f4e1696cd7c2cda7f08bd</data>
      <data key="d12">3550</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="CIRCUNFERENCIA DE LA PANTORRILLA">
      <data key="d8">1.0</data>
      <data key="d9">La circunferencia de la pantorrilla del paciente se utiliza para evaluar su estado nutricional</data>
      <data key="d10">8e8aac45bfe71fa006f622690dfdbbb8</data>
      <data key="d11">e06e7d2d5ef24440b0558066492e5d12</data>
      <data key="d12">3551</data>
      <data key="d13">2</data>
    </edge>
    <edge source="JONATHAN AVIV" target="FEESST">
      <data key="d8">8.0</data>
      <data key="d9">Jonathan Aviv developed the FEESST method for evaluating swallowing reflexes</data>
      <data key="d10">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d11">178d6e9746fd4ed7b0c75d0884e6cc8e</data>
      <data key="d12">3552</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LANGMORE SCALE" target="MURRAY SCALE">
      <data key="d8">1.0</data>
      <data key="d9">Both the Langmore and Murray scales are used to assess the risk of aspiration related to secretions in the pharyngeal areas</data>
      <data key="d10">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d11">14a8112b48aa409fb42c1108ef85a38f</data>
      <data key="d12">3553</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LARYNX" target="ENDOSCOPE">
      <data key="d8">7.0</data>
      <data key="d9">The endoscope is used to visualize the larynx during swallowing assessments</data>
      <data key="d10">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d11">32ecb34d84e44674be4fe08fb811809f</data>
      <data key="d12">3554</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LARYNX" target="DEGLUTITION">
      <data key="d8">8.0</data>
      <data key="d9">The larynx plays a crucial role in the process of deglutition by protecting the airway</data>
      <data key="d10">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d11">c280170be16b476f9561a83a97127fa9</data>
      <data key="d12">3555</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEGLUTITION" target="XEROSTOMIA">
      <data key="d8">1.0</data>
      <data key="d9">Xerostomia can lead to difficulties in deglutition due to insufficient saliva</data>
      <data key="d10">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d11">818b00ce300847119b194a987504757b</data>
      <data key="d12">3556</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SWALLOWING EVALUATION" target="TEXTURE N&#201;CTAR">
      <data key="d8">7.0</data>
      <data key="d9">Nectar is one of the consistencies administered during the swallowing evaluation</data>
      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d11">7da62522c8bb4913b6f925772d9f90da</data>
      <data key="d12">3557</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SWALLOWING EVALUATION" target="PUDDING">
      <data key="d8">7.0</data>
      <data key="d9">Pudding is another consistency used in the swallowing evaluation process</data>
      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d11">0639394ec46e48c9b36b56bd542fb8a0</data>
      <data key="d12">3558</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SWALLOWING EVALUATION" target="LIQUID">
      <data key="d8">7.0</data>
      <data key="d9">Liquid is also a consistency evaluated during the swallowing assessment</data>
      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d11">f92d6ee3290247058e6167afd0c40c0b</data>
      <data key="d12">3559</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SWALLOWING EVALUATION" target="SOLID FOOD">
      <data key="d8">7.0</data>
      <data key="d9">Solid food is assessed during the swallowing evaluation to determine the patient's ability to manage different textures</data>
      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d11">bac90ba4b6e944129b40db1fd87be550</data>
      <data key="d12">3560</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SOLID FOOD" target="ALBONDIGA EN SALSA">
      <data key="d8">6.0</data>
      <data key="d9">Alb&#243;ndiga en salsa is an example of solid food that can be evaluated for swallowing</data>
      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d11">37f6891af8ab4212bfdea4078dae658b</data>
      <data key="d12">3561</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VIDEOFLUOROSCOPIA DE LA DEGLUCI&#211;N" target="EQUIPAMIENTO">
      <data key="d8">9.0</data>
      <data key="d9">The equipment is essential for conducting the video fluoroscopy procedure</data>
      <data key="d10">b2fcedcb1399bd22a82d188227aa9fad</data>
      <data key="d11">cbe6895a7cc144459051f81a4c5cd034</data>
      <data key="d12">3562</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LOGOPEDA" target="IOWA ORAL PERFORMANCE INSTRUMENT">
      <data key="d8">8.0</data>
      <data key="d9">The logopeda uses the IOPI to assess and train patients' tongue strength and endurance</data>
      <data key="d10">2bd5c03d0aa542ef4a7b0380e30e84c3</data>
      <data key="d11">0d35c54d7cc247a496b0593507dff38e</data>
      <data key="d12">3563</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LOGOPEDA" target="EJERCICIO LINGUAL DEL BOT&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">The logopeda instructs patients on how to perform the lingual button exercise to improve tongue strength</data>
      <data key="d10">2bd5c03d0aa542ef4a7b0380e30e84c3</data>
      <data key="d11">a119a66a51cd429295f6c4970d8b4e40</data>
      <data key="d12">3564</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LOGOPEDA" target="EJERCICIOS DE PESAS LINGUALES">
      <data key="d8">7.0</data>
      <data key="d9">The logopeda supervises the tongue weight exercises to ensure proper technique and safety</data>
      <data key="d10">2bd5c03d0aa542ef4a7b0380e30e84c3</data>
      <data key="d11">32455a73b7894849bded3d3bd491d82f</data>
      <data key="d12">3565</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LOGOPEDA" target="EJERCICIOS DE POTENCIACI&#211;N DE LA LENGUA">
      <data key="d8">8.0</data>
      <data key="d9">The logopeda utilizes the IOPI to conduct tongue strengthening exercises</data>
      <data key="d10">2bd5c03d0aa542ef4a7b0380e30e84c3</data>
      <data key="d11">1ba95b99aa454670944f28e587413b58</data>
      <data key="d12">3566</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LOGOPEDA" target="SESIONES DE EJERCICIOS">
      <data key="d8">7.0</data>
      <data key="d9">The logopeda organizes and conducts exercise sessions to improve tongue function</data>
      <data key="d10">2bd5c03d0aa542ef4a7b0380e30e84c3</data>
      <data key="d11">85d2cd888f2d4bf298d5f6f627c4e0e5</data>
      <data key="d12">3567</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LOGOPEDA" target="NUTRICI&#211;N ARTIFICIAL">
      <data key="d8">6.0</data>
      <data key="d9">The logopedist coordinates with the dietitian to ensure safe swallowing and nutritional intake</data>
      <data key="d10">99900c6d95f85a5b4b88fcfed6775cec</data>
      <data key="d11">4d98f0f3b0784713a82311c33fc0a17a</data>
      <data key="d12">3568</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RADIACI&#211;N" target="COLIMADOR">
      <data key="d8">1.0</data>
      <data key="d9">The collimator is used to reduce radiation exposure by limiting the X-ray beam during medical imaging procedures.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">d53c0d0d958741fbbde46e3273ba85ca</data>
      <data key="d12">3569</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RADIACI&#211;N" target="MANTO DE PROTECCI&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">The protective gown is used to shield patients from radiation exposure during medical imaging procedures.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">9cef9df0f7f144dc906338bb93c57dd1</data>
      <data key="d12">3570</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EQUIPO DE ATENCI&#211;N M&#201;DICA" target="COLLAR DE TIROIDES">
      <data key="d8">6.0</data>
      <data key="d9">The thyroid collar is worn by the medical care team to protect against radiation exposure during the VFS.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">39277170844d44dcb0f628f1f6fbaa87</data>
      <data key="d12">3571</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EQUIPO DE ATENCI&#211;N M&#201;DICA" target="DELANTAL DE PLOMO">
      <data key="d8">6.0</data>
      <data key="d9">The lead apron is worn by the medical staff to minimize radiation exposure during the VFS procedure.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">91515fc846674039b01f43a367764856</data>
      <data key="d12">3572</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EQUIPO DE ATENCI&#211;N M&#201;DICA" target="GAFAS PROTECTORAS">
      <data key="d8">1.0</data>
      <data key="d9">Protective glasses are worn by the medical team to safeguard their eyes from radiation during imaging procedures.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">e6bed2fe369f40eda34f59406d513f8a</data>
      <data key="d12">3573</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C1" target="V&#205;A A&#201;REA">
      <data key="d8">6.0</data>
      <data key="d9">The contraction of muscles at C1 influences the movement of the bolus through the airway</data>
      <data key="d10">eff38537223691079c4930d76cbb7427</data>
      <data key="d11">b200429cdf6f4ce595f14c8ae2074929</data>
      <data key="d12">3574</data>
      <data key="d13">2</data>
    </edge>
    <edge source="V&#205;A A&#201;REA" target="BOL">
      <data key="d8">9.0</data>
      <data key="d9">The bolus must pass through the airway during swallowing, making it critical to monitor for safety</data>
      <data key="d10">eff38537223691079c4930d76cbb7427</data>
      <data key="d11">ff3bf98c71514d2281ff6f74dafdafcc</data>
      <data key="d12">3575</data>
      <data key="d13">2</data>
    </edge>
    <edge source="V&#205;A A&#201;REA" target="ESF&#205;NTER ESOF&#193;GICO">
      <data key="d8">1.0</data>
      <data key="d9">The esophageal sphincter's function is crucial for preventing aspiration into the airway</data>
      <data key="d10">eff38537223691079c4930d76cbb7427</data>
      <data key="d11">5d4f9563ac644232bb4561bcf28ebd0f</data>
      <data key="d12">3576</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOL" target="VALL&#201;CULA">
      <data key="d8">7.0</data>
      <data key="d9">The bolus can accumulate in the vallecula if not swallowed properly, leading to potential aspiration</data>
      <data key="d10">eff38537223691079c4930d76cbb7427</data>
      <data key="d11">85a1dd2babcd41c88f5d04edc438e18f</data>
      <data key="d12">3577</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RESIDUO" target="TUBO DIGESTIVO">
      <data key="d8">1.0</data>
      <data key="d9">El residuo se refiere a los materiales que quedan en el tubo digestivo tras la digesti&#243;n</data>
      <data key="d10">072912695b1cff9f390d4ead3b9ad742</data>
      <data key="d11">e3c945ce66be441b821b67c8f7b8e615</data>
      <data key="d12">3578</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CIPLINARES" target="APRAKSI">
      <data key="d8">6.0</data>
      <data key="d9">Ciplinare analyzes apraxia as part of the swallowing assessment</data>
      <data key="d10">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d11">ff2572ecf0b547e7a42a9011c8025e1c</data>
      <data key="d12">3579</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHARYNGEAL PHASE" target="ROSENBECK SCALE">
      <data key="d8">7.0</data>
      <data key="d9">The Rosenbeck scale is used to assess the protection of the airway during the pharyngeal phase</data>
      <data key="d10">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d11">b0d65239b51b476e80da3bb349657e42</data>
      <data key="d12">3580</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHARYNGEAL PHASE" target="SCALE OF YALE">
      <data key="d8">1.0</data>
      <data key="d9">The Yale scale is utilized to evaluate the residue in the pharyngeal phase</data>
      <data key="d10">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d11">5a3e271450424129949d6cd055ea65b9</data>
      <data key="d12">3581</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SENSIBILIDAD" target="FEOCROMOCITOMA">
      <data key="d8">6.0</data>
      <data key="d9">Sensitivity of tests like 18F-FDG is important for detecting metastatic feocromocitomas</data>
      <data key="d10">94ef3a3488643695a99523d5c9d1f606</data>
      <data key="d11">9d8fc543c6a64fc1826d148bfc584f70</data>
      <data key="d12">3582</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BIOPSIAS" target="FQ">
      <data key="d8">6.0</data>
      <data key="d9">Biopsies may be performed to diagnose or monitor the progression of FQ</data>
      <data key="d10">d76cb2d50e736da37be7fe2a415a7281</data>
      <data key="d11">29b939a3938642ccbbbd5a7f01bf24ce</data>
      <data key="d12">3583</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="ES&#211;FAGO DE BARRETT">
      <data key="d8">8.0</data>
      <data key="d9">El reflujo gastroesof&#225;gico puede llevar al desarrollo del es&#243;fago de Barrett, una condici&#243;n precancerosa</data>
      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">d4511754012a45fd822faff01b5df598</data>
      <data key="d12">3584</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="PH-METR&#205;A ESOF&#193;GICA">
      <data key="d8">9.0</data>
      <data key="d9">La pH-metr&#237;a esof&#225;gica se utiliza para diagnosticar el reflujo gastroesof&#225;gico al cuantificar la exposici&#243;n del es&#243;fago al &#225;cido</data>
      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">594ffb0e7a6743f5a4dabd5de21f3097</data>
      <data key="d12">3585</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="IBP">
      <data key="d8">7.0</data>
      <data key="d9">Los inhibidores de la bomba de protones son utilizados para tratar los s&#237;ntomas del reflujo gastroesof&#225;gico</data>
      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">6cb38b295d244270a7bc47331c837212</data>
      <data key="d12">3586</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="DIFICULTADES DE TRAGAR">
      <data key="d8">7.0</data>
      <data key="d9">Las dificultades de tragar pueden ser un s&#237;ntoma del reflujo gastroesof&#225;gico</data>
      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">21342d9110f34eac9d08493a32b557e1</data>
      <data key="d12">3587</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="ANEMIA">
      <data key="d8">6.0</data>
      <data key="d9">La anemia puede ser un signo de complicaciones asociadas al reflujo gastroesof&#225;gico</data>
      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">6b6d7f14240d4beda01b61ecd80f583a</data>
      <data key="d12">3588</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="P&#201;RDIDA DE PESO">
      <data key="d8">6.0</data>
      <data key="d9">La p&#233;rdida de peso puede ser un signo de alarma en pacientes con reflujo gastroesof&#225;gico</data>
      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">e02ed33a695e4ee2b49c275db3d77f82</data>
      <data key="d12">3589</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="TOS CR&#211;NICA">
      <data key="d8">5.0</data>
      <data key="d9">La tos cr&#243;nica puede estar relacionada con el reflujo gastroesof&#225;gico y requiere evaluaci&#243;n</data>
      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">90ff196f0bca4187b6d79d6b7b7860de</data>
      <data key="d12">3590</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="ENFERMEDAD POR REFLUJO REFRACCTARIA">
      <data key="d8">1.0</data>
      <data key="d9">La enfermedad por reflujo refractaria es una forma severa de reflujo gastroesof&#225;gico que no responde al tratamiento</data>
      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">f29cc07a754d43fcb54fab7df068768c</data>
      <data key="d12">3591</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="COMPLICACIONES">
      <data key="d8">8.0</data>
      <data key="d9">Gastroesophageal reflux may worsen as a complication of gastrostomy procedures</data>
      <data key="d10">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d11">ccb4a2fa086e424b8218b7dbd9bc7825</data>
      <data key="d12">3592</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="OBESIDAD">
      <data key="d8">7.0</data>
      <data key="d9">Obesity is a risk factor for gastroesophageal reflux disease, as excess weight can increase abdominal pressure.</data>
      <data key="d10">3e40e9a9e041bbf1e7ca6eaa14080666</data>
      <data key="d11">e03095ecc9de4eb4afe131667ebdb315</data>
      <data key="d12">3593</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REFLUJO GASTROESOF&#193;GICO" target="GASTROSTOM&#205;A">
      <data key="d8">6.0</data>
      <data key="d9">GASTROSTOM&#205;A may be indicated for patients with severe REFLUJO GASTROESOF&#193;GICO</data>
      <data key="d10">70e48774a3f732e015a59d38ba2fa5d5</data>
      <data key="d11">63b1dceaaa254d1f9d369343a1b657ac</data>
      <data key="d12">3594</data>
      <data key="d13">2</data>
    </edge>
    <edge source="IBP" target="ERGE">
      <data key="d8">8.0</data>
      <data key="d9">IBP is used to treat patients suffering from ERGE, indicating a direct therapeutic relationship</data>
      <data key="d10">f7c941bced546a7d607c30a9a5e9d887</data>
      <data key="d11">ca5d635a37cf4c82b215209c9463a309</data>
      <data key="d12">3595</data>
      <data key="d13">2</data>
    </edge>
    <edge source="IBP" target="RGE">
      <data key="d8">8.0</data>
      <data key="d9">IBP is used to treat RGE by reducing stomach acid production, thus alleviating symptoms associated with reflux.</data>
      <data key="d10">b58b0258891d9207b27237bab6a03946</data>
      <data key="d11">96b58778e8de4e768fc251fbd829623f</data>
      <data key="d12">3596</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="MALNUTRICI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">Anemia is often associated with malnutrition in the elderly, leading to further health complications.</data>
      <data key="d10">b6180d67d6fdf45ff73aa2a63a8e3f74</data>
      <data key="d11">936b44e1ee3747ffa972e850936fc6ba</data>
      <data key="d12">3597</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="LACTANCIA MATERNA">
      <data key="d8">8.0</data>
      <data key="d9">Breastfeeding can help reduce the incidence of anemia in postpartum mothers</data>
      <data key="d10">cf034f02916ec46dcba7e0f8d8e24c0c</data>
      <data key="d11">f9bd5dd0fe274d01a204a89958e98127</data>
      <data key="d12">3598</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="COPPER">
      <data key="d8">4.0</data>
      <data key="d9">Copper deficiency can contribute to anemia, as it is essential for iron metabolism</data>
      <data key="d10">5cab61b11d03ef705141159d100ae7c5</data>
      <data key="d11">eaf28633444d4c208996c3f8b8a4baed</data>
      <data key="d12">3599</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="HELICOBACTER PYLORI">
      <data key="d8">4.0</data>
      <data key="d9">Infection with Helicobacter pylori can lead to iron deficiency anemia due to malabsorption</data>
      <data key="d10">5cab61b11d03ef705141159d100ae7c5</data>
      <data key="d11">aa3a6461d97c4f9c87aaf8b293c336ec</data>
      <data key="d12">3600</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="GASTRECTOMIZED">
      <data key="d8">4.0</data>
      <data key="d9">Gastrectomized individuals may experience anemia due to impaired absorption of iron and other nutrients</data>
      <data key="d10">5cab61b11d03ef705141159d100ae7c5</data>
      <data key="d11">c4b4311362cc48b79f10eecb41215a13</data>
      <data key="d12">3601</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="C&#193;NCER DE P&#193;NCREAS">
      <data key="d8">5.0</data>
      <data key="d9">Anemia can be a complication in patients suffering from c&#225;ncer de p&#225;ncreas due to the disease and its treatment</data>
      <data key="d10">a960ccbf15a28151d1461c4203408408</data>
      <data key="d11">a369dcc7e765482cbd281e26525393fe</data>
      <data key="d12">3602</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="INSUFICIENCIA RENAL CR&#211;NICA">
      <data key="d8">8.0</data>
      <data key="d9">Anemia in chronic kidney disease is primarily due to a deficiency of erythropoietin</data>
      <data key="d10">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d11">4f1fb5ecb1044c97ac2385d0fefa4616</data>
      <data key="d12">3603</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="ENFERMEDAD CELIACA">
      <data key="d8">16.0</data>
      <data key="d9">Anemia, specifically ferrop&#233;nica, is a common manifestation in patients with enfermedad cel&#237;aca (celiac disease), primarily due to malabsorption issues. The condition of enfermedad cel&#237;aca can lead to anemia as a result of the impaired absorption of essential nutrients, including iron and folic acid. This relationship highlights the significant impact that enfermedad cel&#237;aca has on nutritional health, particularly in terms of iron and folate levels, which are crucial for maintaining adequate blood health.</data>
      <data key="d10">4335489f570bb14684484e76cd6c196f,68c55f61003b7c0a490a0ee3bc97fcf2</data>
      <data key="d11">5b3b13fd5d56420190f246fd3888dc2e</data>
      <data key="d12">3604</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="VITAMINA B12">
      <data key="d8">6.0</data>
      <data key="d9">La anemia en pacientes cel&#237;acos puede estar relacionada con la deficiencia de vitamina B12</data>
      <data key="d10">4335489f570bb14684484e76cd6c196f</data>
      <data key="d11">b31c1b16326744ab8918d8153163375c</data>
      <data key="d12">3605</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="HEMOCROMATOSIS">
      <data key="d8">16.0</data>
      <data key="d9">Anemia and hemochromatosis are interconnected medical conditions that involve the regulation and management of iron in the body. Anemia can arise as a complication of hemochromatosis, a condition characterized by iron overload, which negatively impacts the production of red blood cells. Both conditions necessitate careful dietary control of iron to manage their effects. Furthermore, hemochromatosis can lead to anemia due to the dysregulation of iron metabolism and absorption, highlighting the complex relationship between these two disorders.</data>
      <data key="d10">2eeab2238556165bbea897f24c5b1c7a,45921035725d6b94d451399b0dac4079,66bc37c9c52956b468bccf2ef89662de</data>
      <data key="d11">1e7bc15171bd45abb79d5006c92b0496</data>
      <data key="d12">3606</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="ANEMIA FERROP&#201;NICA">
      <data key="d8">14.0</data>
      <data key="d9">Anemia is a broader category that encompasses various types of blood disorders characterized by a deficiency in the number or quality of red blood cells. One specific type of anemia within this category is anemia ferrop&#233;nica, also known as iron deficiency anemia. This condition is specifically characterized by low levels of iron in the body, which is essential for the production of hemoglobin, the protein in red blood cells that carries oxygen.</data>
      <data key="d10">4e8b65ec9939ccf2152e68fa7f8b12c4,b65e3955444a7fb402ab92a8ae46311b</data>
      <data key="d11">9ecbeb3a39db4a3f9ad473465b914ecd</data>
      <data key="d12">3607</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="NUTRITIONAL ANEMIAS">
      <data key="d8">7.0</data>
      <data key="d9">Anemia can be classified as nutritional anemia when caused by inadequate intake of essential nutrients.</data>
      <data key="d10">4e8b65ec9939ccf2152e68fa7f8b12c4</data>
      <data key="d11">29191c17ba724fe995ab4ef81837800d</data>
      <data key="d12">3608</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="HEMOGLOBINA">
      <data key="d8">9.0</data>
      <data key="d9">Anemia is diagnosed based on hemoglobin levels in the blood</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">2fca74a29eaa4c13abfe358ab635cf31</data>
      <data key="d12">3609</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="MALABSORCION DE HIERRO">
      <data key="d8">8.0</data>
      <data key="d9">Iron malabsorption can lead to anemia due to insufficient iron absorption</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">c96b75a2dd42420c94cf5ee530918679</data>
      <data key="d12">3610</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="MUJERES EMBARAZADAS">
      <data key="d8">1.0</data>
      <data key="d9">Pregnant women are at risk for anemia, particularly if they do not receive adequate iron</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">e716bdb7e12b4383beacd8f17e3af9f9</data>
      <data key="d12">3611</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="INSUFICIENCIA CARDIACA SEVERA">
      <data key="d8">6.0</data>
      <data key="d9">Severe heart failure can contribute to the development of anemia due to increased iron requirements</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">e3af113aed314c01bf7ac6cccbaf0341</data>
      <data key="d12">3612</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="DEFICIENCIA DE HIERRO">
      <data key="d8">8.0</data>
      <data key="d9">La deficiencia de hierro es una de las principales causas de anemia en el mundo</data>
      <data key="d10">49058309baf3bb1fadf8956dd9ed0e89</data>
      <data key="d11">a18d00e3b03c4677bf12f7e10c9fcd48</data>
      <data key="d12">3613</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="SUPLEMENTOS DE HIERRO">
      <data key="d8">7.0</data>
      <data key="d9">Los suplementos de hierro son utilizados para tratar la anemia causada por deficiencia de hierro</data>
      <data key="d10">49058309baf3bb1fadf8956dd9ed0e89</data>
      <data key="d11">f689564db5e844ddbf2cfe7d07211b14</data>
      <data key="d12">3614</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="HEMOCRMATOSIS">
      <data key="d8">7.0</data>
      <data key="d9">Hemochromatosis can lead to anemia due to iron overload affecting red blood cell production</data>
      <data key="d10">4d0492ec64ce1b97c53328d60bd5bbdd</data>
      <data key="d11">32d8a125bbdf43bfb7093b00456dbe65</data>
      <data key="d12">3615</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="HH">
      <data key="d8">6.0</data>
      <data key="d9">Anemia can be a consequence of iron metabolism disorders, including hereditary hemochromatosis</data>
      <data key="d10">a3d834f1d854ecde12e808ae924b8eb0</data>
      <data key="d11">6974f0831d014acd93395f7d0f7a7747</data>
      <data key="d12">3616</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="ENFERMEDAD DE WILSON">
      <data key="d8">7.0</data>
      <data key="d9">Anemia can be a complication of Wilson's disease due to liver failure and hemolysis</data>
      <data key="d10">ed4179754d9e9ed3a2971c762ec54390</data>
      <data key="d11">5e896bfc6080442f9a995f3acf1d2296</data>
      <data key="d12">3617</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="COLITIS ULCEROSA">
      <data key="d8">6.0</data>
      <data key="d9">Anemia can be a complication of colitis ulcerosa due to chronic blood loss and malabsorption of nutrients.</data>
      <data key="d10">ad855af99ce4e32899436ea8e739ccb4</data>
      <data key="d11">bb76dc1cc9dc4e778247477e203ce799</data>
      <data key="d12">3618</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA" target="ENFERMEDAD INFLAMATORIA INTESTINAL">
      <data key="d8">6.0</data>
      <data key="d9">La anemia puede ser una consecuencia de la desnutrici&#243;n en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">bce30b42693c4d18a882427eed48a60f</data>
      <data key="d12">3619</data>
      <data key="d13">2</data>
    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="VALORACI&#211;N GLOBAL SUBJETIVA">
      <data key="d8">9.0</data>
      <data key="d9">La p&#233;rdida de peso es un criterio clave en la Valoraci&#243;n Global Subjetiva para clasificar el estado nutricional</data>
      <data key="d10">e12655d89e99e57ce1f6d87563adf674</data>
      <data key="d11">ec8cc3bf68f24511a09263e5a565b069</data>
      <data key="d12">3620</data>
