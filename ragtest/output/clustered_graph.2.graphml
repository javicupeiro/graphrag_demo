      <data key="d10">da2707b26ddb548995a6d0e2a3eeddb0</data>
      <data key="d11">1888e7b163584c4f8bb2ab108db9fb90</data>
      <data key="d12">5725</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES" target="DEPARTAMENTO DE SALUD LA FE">
      <data key="d8">8.0</data>
      <data key="d9">The Departamento de Salud La Fe is implementing strategies to manage diabetes in the Comunidad Valenciana</data>
      <data key="d10">da2707b26ddb548995a6d0e2a3eeddb0</data>
      <data key="d11">9d6ed7109a9642ce8b86fd911e6d3fd9</data>
      <data key="d12">5726</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES" target="OBESIDAD">
      <data key="d8">17.0</data>
      <data key="d9">Diabetes and obesity are closely related metabolic diseases. Obesity is a significant risk factor for the development of diabetes, highlighting its importance in prevention efforts. Both conditions are interconnected, with obesity contributing to the onset of diabetes, making the management of obesity a critical focus in addressing and preventing diabetes.</data>
      <data key="d10">01eb4b96cd8e6a886ebc313171922a77,da2707b26ddb548995a6d0e2a3eeddb0</data>
      <data key="d11">3e790ccc024349faa7192cbeabd59033</data>
      <data key="d12">5727</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES" target="H&#193;BITOS ALIMENTARIOS">
      <data key="d8">8.0</data>
      <data key="d9">H&#225;bitos Alimentarios are crucial in the prevention and management of diabetes</data>
      <data key="d10">da2707b26ddb548995a6d0e2a3eeddb0</data>
      <data key="d11">a17b535c213c4c68a01828de991a5f64</data>
      <data key="d12">5728</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES" target="ACTIVIDAD F&#205;SICA">
      <data key="d8">1.0</data>
      <data key="d9">Actividad F&#237;sica is an important factor in preventing and managing diabetes</data>
      <data key="d10">da2707b26ddb548995a6d0e2a3eeddb0</data>
      <data key="d11">a879a86c98ab464bb9cac237caa17ab8</data>
      <data key="d12">5729</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES" target="MELAS SYNDROME">
      <data key="d8">8.0</data>
      <data key="d9">MELAS syndrome often leads to diabetes as a complication due to insulin resistance and insulin deficiency</data>
      <data key="d10">e3370b71146ad5063d6b1e9c3d8a3bd2</data>
      <data key="d11">cdc9033fecab443483fe3906f50f416d</data>
      <data key="d12">5730</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES" target="GLUCEMIA">
      <data key="d8">9.0</data>
      <data key="d9">The management of diabetes involves controlling glucemia levels, particularly before testing. This is crucial for effective diabetes control, especially in patients with MELAS syndrome, where managing glucemia becomes even more essential.</data>
      <data key="d10">e3370b71146ad5063d6b1e9c3d8a3bd2,e82ce4aa73097ca70936be74cdafc12b</data>
      <data key="d11">c7af251e723a4bcb870d4e05516f8c92</data>
