      <data key="d7">f9e703e908164299b406932c444c5d55</data>
    </node>
    <node id="SUGAR BUSTERS">
      <data key="d0">PERSON</data>
      <data key="d1">Sugar Busters is a well-known diet plan that focuses on reducing sugar intake and promoting low glycemic index foods.</data>
      <data key="d2">5116416429465894c102d9fb93d6a8fc</data>
      <data key="d3">1894</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">8517</data>
      <data key="d7">0b31be974b574c279ba9f26894b3c07f</data>
    </node>
    <node id="PLATANO">
      <data key="d0">EVENT</data>
      <data key="d1">Pl&#225;tano is a fruit commonly known as bananas, recognized for its energy-boosting properties. It contains a fructose content ranging from 3 to 6 grams per 100 grams. Additionally, pl&#225;tano has a glycemic index of 83, which indicates a significant impact on blood sugar levels.</data>
      <data key="d2">5116416429465894c102d9fb93d6a8fc,9d56eb0b82a3266e422a6a8ac5e63944</data>
      <data key="d3">1894</data>
