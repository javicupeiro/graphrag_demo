    <edge source="DC" target="HYPERCOLESTEROLIEMIA">
      <data key="d8">5.0</data>
      <data key="d9">Hypercolesterolemia is frequently observed in patients undergoing dietary treatment</data>
      <data key="d10">214cb2b8ddec52ff69849d87feb8e141</data>
      <data key="d11">6fccd0c37bd1457f8436bb98a1ab6185</data>
      <data key="d12">18674</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DC" target="HYPERTRIGLICERIDEMIA">
      <data key="d8">5.0</data>
      <data key="d9">Hypertrigliceridemia has been noted in a significant percentage of patients undergoing dietary treatment</data>
      <data key="d10">214cb2b8ddec52ff69849d87feb8e141</data>
      <data key="d11">7631b0e8e50243cd9784ffa759eff140</data>
      <data key="d12">18675</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DAM" target="LECHE CETOG&#201;NICA">
      <data key="d8">6.0</data>
      <data key="d9">La Leche Cetog&#233;nica se utiliza como complemento a la DAM, especialmente en ni&#241;os y pacientes con secuelas neurol&#243;gicas.</data>
      <data key="d10">c58e4b0e4e936cc1fd696a32d8390bdc</data>
      <data key="d11">864f739ed5c04815b4d05556dd973406</data>
      <data key="d12">18676</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DAM" target="COMPLICACIONES METAB&#211;LICAS">
      <data key="d8">4.0</data>
      <data key="d9">Las Complicaciones Metab&#243;licas pueden surgir durante el tratamiento con DAM, afectando la tolerancia a la dieta.</data>
      <data key="d10">c58e4b0e4e936cc1fd696a32d8390bdc</data>
      <data key="d11">365655e44e1f4bc8ab81a689a91c03dd</data>
      <data key="d12">18677</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DAM" target="ESTUDIOS ALEATORIZADOS">
      <data key="d8">7.0</data>
      <data key="d9">Los Estudios Aleatorizados han evaluado la eficacia de la DAM en comparaci&#243;n con otros tratamientos diet&#233;ticos para crisis epil&#233;pticas.</data>
      <data key="d10">c58e4b0e4e936cc1fd696a32d8390bdc</data>
      <data key="d11">1f53a51fae4742238f885cfe531b8970</data>
      <data key="d12">18678</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DAM" target="CRISIS EPIL&#201;PTICAS">
      <data key="d8">8.0</data>
      <data key="d9">La DAM se utiliza para reducir la frecuencia de Crisis Epil&#233;pticas en pacientes tratados con esta dieta.</data>
      <data key="d10">c58e4b0e4e936cc1fd696a32d8390bdc</data>
      <data key="d11">313b1dc81327432d9f2e81067316f2ff</data>
      <data key="d12">18679</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES METAB&#211;LICAS" target="AYUNO INICIAL">
      <data key="d8">6.0</data>
      <data key="d9">El Ayuno Inicial puede causar Complicaciones Metab&#243;licas, como deshidrataci&#243;n, en pacientes que siguen dietas cetog&#233;nicas.</data>
      <data key="d10">c58e4b0e4e936cc1fd696a32d8390bdc</data>
      <data key="d11">369612008247478eacbd0b4ecebea030</data>
      <data key="d12">18680</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES METAB&#211;LICAS" target="SUEROTERAPIA DE MANTENIMIENTO">
      <data key="d8">1.0</data>
      <data key="d9">La Sueroterapia de Mantenimiento se utiliza para tratar la deshidrataci&#243;n, una de las Complicaciones Metab&#243;licas m&#225;s comunes en dietas cetog&#233;nicas.</data>
      <data key="d10">c58e4b0e4e936cc1fd696a32d8390bdc</data>
      <data key="d11">a38b03cf0d1b4641b4bbb094b56b777a</data>
      <data key="d12">18681</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CRECIMIENTO LINEAL" target="ESTUDIO RETROSPECTIVO">
      <data key="d8">1.0</data>
      <data key="d9">El estudio retrospectivo sugiere que el aporte proteico puede influir en el crecimiento lineal en ni&#241;os con dieta cetog&#233;nica.</data>
      <data key="d10">bf7fc15e1aac41553dc6586efe68b8cb</data>
      <data key="d11">ca69c597a9d94f519b9f24db3dcedaab</data>
      <data key="d12">18682</data>
      <data key="d13">2</data>
