      <data key="d5">3</data>
      <data key="d6">15487</data>
      <data key="d7">3f261453814943a3827cecb0ea91ffc5</data>
    </node>
    <node id="DIARREA PERSISTENTE">
      <data key="d0">EVENT</data>
      <data key="d1">DIARREA PERSISTENTE refers to a condition that may affect infants, requiring special dietary considerations.</data>
      <data key="d2">8f2e38ed25a683975b314e8e56721ad6</data>
      <data key="d3">636</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15488</data>
      <data key="d7">189a08abbd194e3e8952344622575d05</data>
    </node>
    <node id="ENTEROPAT&#205;A SENSIBLE A LECHE DE VACA">
      <data key="d0">EVENT</data>
      <data key="d1">ENTEROPAT&#205;A SENSIBLE A LECHE DE VACA is a condition in which infants have adverse reactions to cow's milk proteins.</data>
      <data key="d2">8f2e38ed25a683975b314e8e56721ad6</data>
      <data key="d3">632</data>
      <data key="d4">2</data>
