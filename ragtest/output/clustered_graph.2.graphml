    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="PANCREATITIS AGUDA GRAVE NECROSANTE">
      <data key="d8">9.0</data>
      <data key="d9">Pancreatitis aguda grave necrosante is a contraindication for the use of nutritional support via enteral nutrition</data>
