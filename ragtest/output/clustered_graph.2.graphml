      <data key="d6">10662</data>
      <data key="d7">9c528d6584c049b9bd8d03bb807b8110</data>
    </node>
    <node id="IRELAND">
      <data key="d0">GEO</data>
      <data key="d1">Ireland is noted for having a higher prevalence of homocystinuria, occurring in approximately 1 in 200,000 to 335,000 live births.</data>
      <data key="d2">4351677d6166c9c88ab941dc8dcecb82</data>
      <data key="d3">1697</data>
      <data key="d4">2</data>
