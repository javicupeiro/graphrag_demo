    <edge source="QUIMIOTERAPIA" target="NUTRICI&#211;N EN CIRUG&#205;A DE TUMORES DE CABEZA Y CUELLO">
      <data key="d8">5.0</data>
      <data key="d9">Nutritional management is crucial for patients undergoing chemotherapy, especially in the context of head and neck surgeries</data>
      <data key="d10">2bbe847617971cacfe15b2c970de2d21</data>
