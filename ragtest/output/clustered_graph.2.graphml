      <data key="d6">3179</data>
      <data key="d7">a2d937225bae48188d2266c2a621c477</data>
    </node>
    <node id="OLDER ADULTS">
      <data key="d0">PERSON</data>
      <data key="d1">Older adults are individuals aged 65 and above who are the focus of studies regarding diet and cognitive health.</data>
      <data key="d2">c4f12f866dc714cdbb2323a920f524c2</data>
      <data key="d3">482</data>
      <data key="d4">1</data>
