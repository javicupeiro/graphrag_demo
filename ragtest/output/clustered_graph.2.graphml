      <data key="d6">1895</data>
      <data key="d7">53ca599892bd47459ddc3e2d94975e50</data>
    </node>
    <node id="VALORACI&#211;N ANAL&#205;TICA">
      <data key="d0">EVENT</data>
      <data key="d1">Analytical evaluation of the patient's nutritional status through laboratory tests.</data>
      <data key="d2">3c6db755168f2fea94b2535a81ce6f58</data>
      <data key="d3">1080</data>
