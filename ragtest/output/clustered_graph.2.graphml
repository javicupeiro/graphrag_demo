    </edge>
    <edge source="PRETERM INFANTS" target="NUTRITIONAL STRATEGIES">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional strategies are implemented to improve the health and growth of preterm infants</data>
      <data key="d10">7c60735b2451e2d314fe6c5377b7a79d</data>
      <data key="d11">616eefdd9f03418d8f4176777162ad4b</data>
      <data key="d12">10386</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRETERM INFANTS" target="GASTROINTESTINAL PRIMING">
      <data key="d8">7.0</data>
      <data key="d9">Gastrointestinal priming is a feeding method used to enhance the feeding tolerance of preterm infants</data>
      <data key="d10">7c60735b2451e2d314fe6c5377b7a79d</data>
      <data key="d11">03ff0f22f5814002bb5b5f157c1c130d</data>
      <data key="d12">10387</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRETERM INFANTS" target="HYDROLYZED FORMULAS">
      <data key="d8">9.0</data>
      <data key="d9">Hydrolyzed formulas are specifically designed to meet the nutritional needs of preterm infants with allergies.</data>
      <data key="d10">08d66dc8414668a3ec627a1e164cfa6c</data>
      <data key="d11">48ff9f64db88405990a3e2e5bdf841f0</data>
      <data key="d12">10388</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRETERM INFANTS" target="ELEMENTAL FORMULAS">
      <data key="d8">1.0</data>
      <data key="d9">Elemental formulas are tailored for the specific dietary requirements of preterm infants, especially after hospital discharge.</data>
      <data key="d10">08d66dc8414668a3ec627a1e164cfa6c</data>
      <data key="d11">46647bbeffbb4f7fa34cb4a760321dea</data>
      <data key="d12">10389</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NEC" target="IBUPROFENO">
      <data key="d8">5.0</data>
      <data key="d9">NEC guidelines may include recommendations for the use of ibuprofen in certain conditions</data>
      <data key="d10">aacaabd084b7839bdedf5fbebfd7dcf4</data>
      <data key="d11">5f2f046a05ea481fa675b6508dd37423</data>
      <data key="d12">10390</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RCIU" target="F&#211;RMULA PARA PREMATUROS">
      <data key="d8">7.0</data>
      <data key="d9">F&#243;rmula para Prematuros is used to provide necessary nutrition for infants diagnosed with RCIU.</data>
      <data key="d10">4a251705839547c8dcd0e9ddc5bb4066</data>
