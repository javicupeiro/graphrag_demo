      <data key="d7">1ea360a28cef4407b773982eea06db8e</data>
    </node>
    <node id="ECOLOGICAL PRODUCTS">
      <data key="d0">EVENT</data>
      <data key="d1">Ecological products are those produced without synthetic chemicals and certified by a control organism, adhering to strict regulations.</data>
      <data key="d2">d3ffabc46da9b238994a7769ffc8f6b7</data>
      <data key="d3">134</data>
