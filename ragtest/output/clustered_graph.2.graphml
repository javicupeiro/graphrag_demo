      <data key="d11">01da35faa69545dc9d77f8741ab453e4</data>
      <data key="d12">12690</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERPROLACTINEMIA" target="FAMILIAL HYPERPROLACTINEMIA">
      <data key="d8">1.0</data>
      <data key="d9">Familial hyperprolactinemia is a genetic form of hyperprolactinemia caused by mutations affecting prolactin receptor function.</data>
