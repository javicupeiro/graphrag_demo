      <data key="d8">8.0</data>
      <data key="d9">Ingestas diarias recomendadas provide guidelines for nutrient intake during lactancia</data>
      <data key="d10">74a9c62d0f932e27419151241f7db445</data>
      <data key="d11">55bc86869c62459abff0eb49b478e654</data>
      <data key="d12">12743</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LACTANCIA" target="INGESTAS ADECUADAS">
      <data key="d8">8.0</data>
      <data key="d9">Ingestas adecuadas provide guidelines for nutrient intake during lactancia</data>
      <data key="d10">74a9c62d0f932e27419151241f7db445</data>
      <data key="d11">51c76d9060a94bc2b871b71d0cc4b6cc</data>
      <data key="d12">12744</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LACTANCIA" target="DRI 971">
      <data key="d8">6.0</data>
      <data key="d9">DRI 971 includes dietary recommendations for the event of Lactancia</data>
      <data key="d10">565aef05382a327b4bdefb2ab3d3b4be</data>
      <data key="d11">8e68ff769bda4121bdbcea6f754da4c5</data>
      <data key="d12">12745</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LACTANCIA" target="FESNAD 2010">
      <data key="d8">8.0</data>
      <data key="d9">Lactancia is closely associated with the dietary reference intake guidelines established in FESNAD 2010, which includes specific dietary intake recommendations for breastfeeding women. These guidelines aim to support the nutritional needs of lactating mothers, ensuring both their health and the well-being of their infants.</data>
      <data key="d10">8ebb2b77b6f63f52544326a7ea94df61,acf7f978dbec397c60ed463f4eb2fcf6</data>
      <data key="d11">02195124965246b6b09d1bb3b484d7c0</data>
      <data key="d12">12746</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LACTANCIA" target="NI&#209;OS/AS">
      <data key="d8">1.0</data>
