      <data key="d0">EVENT</data>
      <data key="d1">The composition of nutritional formulas is crucial for managing diabetes, particularly in terms of carbohydrate and fat content.</data>
      <data key="d2">8d1eb00b23450a2f2cb1243ea32aa36f</data>
      <data key="d5">0</data>
      <data key="d6">9353</data>
