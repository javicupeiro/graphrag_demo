      <data key="d7">d1f2b832b9914e3f97fac1c998ef4904</data>
    </node>
    <node id="MULTIORGAN FAILURE">
      <data key="d0">EVENT</data>
      <data key="d1">Multiorgan failure is a severe condition where multiple organ systems fail, often requiring specialized nutritional management.</data>
      <data key="d2">fb24bf4c9fcf60bbc1dd56cd60ba0a47</data>
      <data key="d3">1233</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12262</data>
      <data key="d7">579fde93455f460c986721dbb983a20f</data>
