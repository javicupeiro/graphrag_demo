    </edge>
    <edge source="GALACTOSEMIA" target="CEREALES">
      <data key="d8">5.0</data>
      <data key="d9">Cereals may contain galactose and should be consumed with caution by individuals with galactosemia.</data>
      <data key="d10">743649231e27012822c870ff5878263c</data>
      <data key="d11">08d8a0cbebd14d2c9e79ed4182d855de</data>
