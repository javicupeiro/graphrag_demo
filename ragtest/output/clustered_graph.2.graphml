      <data key="d6">15926</data>
      <data key="d7">07cc53dcca864ee5824b1c87a5a9485c</data>
    </node>
    <node id="MEDICINA COSTE-EFECTIVA">
      <data key="d0">EVENT</data>
      <data key="d1">Cost-effective medicine aims to maximize patient welfare within the constraints of limited resources.</data>
      <data key="d2">66c092d222e72c03a1f36507ce355cd4</data>
      <data key="d3">1272</data>
      <data key="d4">2</data>
