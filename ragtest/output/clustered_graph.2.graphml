    <node id="AZ&#218;CARES REFINADOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los az&#250;cares refinados son nutrientes proinflamatorios que se reducen con la adherencia a la dieta mediterr&#225;nea.</data>
      <data key="d2">01302d2656a8cbb49cb7505b3182cc63</data>
      <data key="d3">1379</data>
