    <node id="FGFR4">
      <data key="d0">PERSON</data>
      <data key="d1">FGFR4 es un oncog&#233;n que puede estar implicado en la aparici&#243;n de adenomas hipofisarios.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1323</data>
