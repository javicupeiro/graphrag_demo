    <node id="AMERICAN COLLEGE OF SURGEONS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The American College of Surgeons is a professional organization that evaluates patient care and outcomes in surgical practices, including esophageal cancer.</data>
      <data key="d2">bef1f848ac9b922f7361b740210a8314</data>
