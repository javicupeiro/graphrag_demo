    <edge source="MUCOSITIS" target="NPT">
      <data key="d8">7.0</data>
      <data key="d9">La NPT se recurre cuando la tolerancia intestinal no es posible, lo que puede ser causado por mucositis.</data>
      <data key="d10">b2b9da64e886eb0b5a8b332d2ba9c7fb</data>
      <data key="d11">824baa1a934849c1b6fa6d75b41addab</data>
      <data key="d12">9562</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MUCOSITIS" target="APLASIA MEDULAR">
      <data key="d8">5.0</data>
      <data key="d9">La aplasia medular puede estar relacionada con la aparici&#243;n de mucositis en el postrasplante inmediato.</data>
      <data key="d10">b2b9da64e886eb0b5a8b332d2ba9c7fb</data>
      <data key="d11">3083338ddf2040bbb947f3bc5ded723e</data>
      <data key="d12">9563</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MUCOSITIS" target="NUTRICI&#211;N EN CIRUG&#205;A DE TUMORES DE CABEZA Y CUELLO">
      <data key="d8">5.0</data>
