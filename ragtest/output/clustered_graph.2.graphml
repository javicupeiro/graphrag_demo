      <data key="d7">0b0de0e39ed14d68a1d99bca9de39912</data>
    </node>
    <node id="HISTIOCITOSIS X">
      <data key="d0">EVENT</data>
      <data key="d1">Histiocytosis X is a rare disease characterized by the proliferation of histiocytes, which can affect various organs including the pituitary gland.</data>
      <data key="d2">4faa9b46acd7540904fc5b0772bb7c51</data>
      <data key="d3">1342</data>
