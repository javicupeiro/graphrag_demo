    </node>
    <node id="ALTERACIONES EN LA REGULACI&#211;N DEL APETITO">
      <data key="d0">EVENT</data>
      <data key="d1">Las alteraciones en la regulaci&#243;n del apetito pueden ser consecuencia de la afectaci&#243;n hipotal&#225;mica por tumores de la gl&#225;ndula pineal.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">3808</data>
      <data key="d7">7f6e5942322541cfb3b812de7653889b</data>
    </node>
    <node id="MELATONINA">
      <data key="d0">EVENT</data>
      <data key="d1">La melatonina es una hormona producida por la gl&#225;ndula pineal que regula el sue&#241;o y puede verse afectada por tumores en esta gl&#225;ndula.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1343</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
