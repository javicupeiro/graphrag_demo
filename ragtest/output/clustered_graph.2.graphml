    </node>
    <node id="MOLECULAR GASTRONOMY">
      <data key="d0">EVENT</data>
      <data key="d1">Molecular Gastronomy is an event or field of study that explores the physical and chemical transformations of ingredients during cooking, particularly in relation to diets for dysphagia.</data>
      <data key="d2">694f957b0b008ab3339e5bf1fd57b81a</data>
      <data key="d3">1221</data>
