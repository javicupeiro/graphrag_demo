    </node>
    <node id="DIAGN&#211;STICO Y ETIOLOG&#205;A DE LA HIPONATREMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Diagnosis and etiology of hyponatremia in patients receiving artificial nutrition</data>
      <data key="d2">8ff1cad741bacfef19d53bb8941b5ca9</data>
      <data key="d3">1427</data>
      <data key="d4">2</data>
