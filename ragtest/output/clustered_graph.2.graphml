    </node>
    <node id="OBSTRUCCIONES DE ALTO GRADO">
      <data key="d0">EVENT</data>
      <data key="d1">A condition that can occur in patients requiring nutritional intervention, often necessitating parenteral nutrition.</data>
      <data key="d2">bf234f719a608fc6858d9a1749463539</data>
      <data key="d3">588</data>
