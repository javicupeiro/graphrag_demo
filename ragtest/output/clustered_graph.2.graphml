      <data key="d11">ff7393e1a5424466a01bda790f3c27d2</data>
      <data key="d12">8630</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SELENIO" target="LACTANCIA">
      <data key="d8">7.0</data>
      <data key="d9">Selenium has specific recommended intake levels for infants during lactation</data>
