    <node id="SOCIEDAD ASTURIANA DE DIABETES, ENDOCRINOLOG&#205;A, NUTRICI&#211;N Y OBESIDAD">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Asturian Society of Diabetes, Endocrinology, Nutrition, and Obesity is where Nuria Valdes Gallego served as treasurer from 2014 to 2016.</data>
      <data key="d2">cc9543ac7abe58ae289e1fbd5353e219</data>
