      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">4c1ab9d9d234402da2d99fd5202715d8</data>
      <data key="d12">2259</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MECV-V" target="FEES">
      <data key="d8">5.0</data>
