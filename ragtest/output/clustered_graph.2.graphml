    <node id="FILO: BACTEROIDETES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Filo: Bacteroidetes is another major phylum of bacteria that plays a crucial role in the composition of the intestinal microbiota.</data>
      <data key="d2">b36b8846f109ee75806c6ea03015e5d5</data>
