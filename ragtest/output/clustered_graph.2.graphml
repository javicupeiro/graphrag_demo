      <data key="d7">c26bf21a850944c1a69bbbfc424083af</data>
    </node>
    <node id="INSUFICIENCIA SUPRARRENAL AGUDA">
      <data key="d0">EVENT</data>
      <data key="d1">Acute adrenal insufficiency is a medical emergency characterized by low blood pressure and volume depletion, requiring immediate treatment.</data>
      <data key="d2">fec130428af4ee62996a9b72494212dc</data>
      <data key="d3">1425</data>
      <data key="d4">2</data>
      <data key="d5">8</data>
