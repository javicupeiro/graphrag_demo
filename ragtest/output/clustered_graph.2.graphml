      <data key="d7">177d69839ad64c708bd909365842fca3</data>
    </node>
    <node id="PARKINSON">
      <data key="d0" />
      <data key="d1">Parkinson refers to Parkinson's disease, a progressive neurological disorder that primarily affects movement. This condition is characterized by symptoms such as tremors and stiffness. Additionally, it is noted that Parkinson's disease significantly impacts a considerable percentage of patients, leading to complications such as dysphagia (difficulty swallowing) and malnutrition.</data>
      <data key="d2">0f51b0c02b1e8200f9a98b830621c55c,22a361e57659e072600d6575631f6160,9449ed00392e250aa871c689af51a540</data>
      <data key="d3">961</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">8649</data>
      <data key="d7">d687f495c9e944008f38610d34bd8d08</data>
    </node>
    <node id="COLECISTITIS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Colecistitis is the inflammation of the gallbladder, noted in the context of drug precautions.</data>
      <data key="d2">22a361e57659e072600d6575631f6160</data>
      <data key="d5">0</data>
      <data key="d6">8650</data>
