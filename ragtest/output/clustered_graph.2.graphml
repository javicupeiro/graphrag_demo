    </node>
    <node id="STANDARDS FOR NUTRITION SUPPORT">
      <data key="d0">EVENT</data>
      <data key="d1">Standards established for nutrition support in hospitalized adult patients, detailing best practices in clinical nutrition.</data>
      <data key="d2">3f3896c039ea7ef78de8bf5fb6e09a48</data>
