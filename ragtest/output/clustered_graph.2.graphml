    <node id="PROCEDIMIENTOS TERAP&#201;UTICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los procedimientos terap&#233;uticos correctivos son m&#233;todos en estudio para tratar alergias alimentarias, incluyendo desensibilizaci&#243;n y tolerancia.</data>
      <data key="d2">0f0303399f29734dede9db544e1dda9e</data>
      <data key="d5">0</data>
      <data key="d6">14080</data>
      <data key="d7">de197ff223f44239846bb94daa934220</data>
    </node>
    <node id="ALERGIA INFANTILLA FE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">ALERGIA INFANTILLA FE is an organization dedicated to addressing childhood allergies and providing relevant resources.</data>
      <data key="d2">a562e90891c11da0293bc7de511acc8f</data>
