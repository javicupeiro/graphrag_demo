    <node id="&#211;SCAR MORENO P&#201;REZ">
      <data key="d0">PERSON</data>
      <data key="d1">&#211;scar Moreno P&#233;rez is a specialist in Endocrinology and Nutrition, coordinator of the Diabetes Unit at the General University Hospital of Alicante, and associated professor at the Miguel Hern&#225;ndez University.</data>
      <data key="d2">404f3831a7bac02ee23cb4d4f4f2b0e9</data>
