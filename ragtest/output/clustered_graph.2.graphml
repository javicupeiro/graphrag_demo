    </node>
    <node id="GENETIC SIGNATURES">
      <data key="d0">EVENT</data>
      <data key="d1">Genetic signatures refer to specific genetic markers that can indicate the presence of certain traits or conditions, such as lactase persistence.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68</data>
      <data key="d5">0</data>
      <data key="d6">9965</data>
