    </node>
    <node id="RECTO">
      <data key="d0">GEO</data>
      <data key="d1">Recto is the final section of the large intestine, which can be impacted by cancer, affecting bowel habits and nutrient absorption.</data>
      <data key="d2">9ce201472321f20b339146bb6b452f60</data>
