    </edge>
    <edge source="GENETIC DISORDERS" target="ANOMALIES OF SEXUAL DIFFERENTIATION">
      <data key="d8">6.0</data>
      <data key="d9">Anomalies of sexual differentiation are classified as genetic disorders due to their basis in chromosomal and genetic abnormalities.</data>
      <data key="d10">766fec9f74738cf0af53aee77d58dc78</data>
      <data key="d11">d61bad8e660d4950add7be4c8664a7b6</data>
      <data key="d12">14892</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DSD" target="CANCER RISK">
      <data key="d8">8.0</data>
      <data key="d9">Individuals with DSD have an increased cancer risk, particularly those with XY karyotypes</data>
      <data key="d10">bc241ef500af250c0f0e0253bf5ae0f2</data>
      <data key="d11">e48b0f69025b493f8c67513708c48441</data>
      <data key="d12">14893</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DSD" target="HYPERPLASIA SUPRARRENAL CONG&#201;NITA">
      <data key="d8">1.0</data>
      <data key="d9">Congenital Adrenal Hyperplasia is classified under Differences of Sex Development due to its impact on sexual differentiation</data>
      <data key="d10">bc241ef500af250c0f0e0253bf5ae0f2</data>
      <data key="d11">ea5a86267e3d444ba208a176e10e82ec</data>
      <data key="d12">14894</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DSD" target="GEN SRY">
      <data key="d8">7.0</data>
      <data key="d9">Developmental Sexual Disorder (DSD) can be related to abnormalities in the SRY gene affecting sexual development</data>
      <data key="d10">0cf04c95a8e6bbdf9201bf3fff9103f6</data>
      <data key="d11">072c28974c78486c8164f905f862f544</data>
      <data key="d12">14895</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CANCER RISK" target="GONADAL MALIGNANCY">
      <data key="d8">9.0</data>
      <data key="d9">Gonadal malignancy is a potential outcome for individuals at increased cancer risk due to genetic conditions</data>
      <data key="d10">bc241ef500af250c0f0e0253bf5ae0f2</data>
      <data key="d11">b17d1b55a5394b0881ebf78330d95f92</data>
