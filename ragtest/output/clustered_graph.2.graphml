    <node id="OLIGOSAC&#193;RIDOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Oligosaccharides are carbohydrates that can cause digestive issues for some people, often discussed in the context of dietary restrictions.</data>
      <data key="d2">f713611b23199b8a9eb9c28377b9f128</data>
