    </node>
    <node id="HECES &#193;CIDAS">
      <data key="d0">EVENT</data>
      <data key="d1">Acidic stools are a clinical manifestation associated with glucose-galactose malabsorption, indicating malabsorption issues.</data>
      <data key="d2">e329b5d4c64709889680df357bd1cc09</data>
      <data key="d3">846</data>
      <data key="d4">2</data>
