    <node id="CFC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">CFC is a method used for dietary assessment that does not modify the habits of the person surveyed and is relatively easy to develop.</data>
      <data key="d2">f14ec70726a24a574ae5d437903fddb8</data>
      <data key="d3">1478</data>
