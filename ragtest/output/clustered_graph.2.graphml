    </node>
    <node id="ISQUEMIA CEREBRAL">
      <data key="d0">EVENT</data>
      <data key="d1">Isquemia cerebral refers to a condition where there is insufficient blood flow to the brain, potentially resulting in a stroke.</data>
      <data key="d2">41d7db510fc74d3763959481cc15ea20</data>
      <data key="d3">310</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
