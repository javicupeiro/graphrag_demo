    </node>
    <node id="PLASMA FRESCO">
      <data key="d0">EVENT</data>
      <data key="d1">Fresh plasma is used to treat patients with low platelet counts before certain medical procedures.</data>
      <data key="d2">20491afa9a4770e93e6cff9034f8b0f0</data>
