      <data key="d7">0ec4d76acb8c4811b6e64b60417cff66</data>
    </node>
    <node id="DIFFERENTIATED THYROID CANCER">
      <data key="d0">EVENT</data>
      <data key="d1">Differentiated thyroid cancer is a type of thyroid cancer that arises from follicular or parafollicular cells and is typically treated with I-131.</data>
      <data key="d2">bbe700b5b290ea119e511c94a6f0c67f</data>
      <data key="d3">181</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">4749</data>
      <data key="d7">af40e80a3fb249e9a545059059b581dd</data>
    </node>
    <node id="AMERICAN JOINT COMMITTEE ON CANCER">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The American Joint Committee on Cancer (AJCC) is an organization that provides guidelines for cancer staging, including the TNM classification system.</data>
      <data key="d2">b1ce0d940909277d321ee55bffcc69b3</data>
      <data key="d3">1258</data>
      <data key="d4">2</data>
