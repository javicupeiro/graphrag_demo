    </node>
    <node id="FILTRACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Filtration is a process used in parenteral nutrition systems to prevent air entry and retain particles and bacteria.</data>
      <data key="d2">222519e556047fafecd61c2964aaaeed</data>
      <data key="d3">588</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
