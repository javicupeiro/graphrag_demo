      <data key="d11">55e7014e7a9149b0a91ad96cd7c9b68d</data>
      <data key="d12">7644</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FACTOR DE ESTR&#201;S" target="NECESIDADES PROTEICAS">
