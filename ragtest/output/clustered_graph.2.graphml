    <node id="SEFH">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">SEFH is the Spanish Society of Hospital Pharmacy, which collaborates on the preparation of parenteral nutrition mixtures.</data>
      <data key="d2">3f3896c039ea7ef78de8bf5fb6e09a48</data>
