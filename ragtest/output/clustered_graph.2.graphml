      <data key="d8">8.0</data>
      <data key="d9">The feeding protocol is specifically designed for preterm infants to aid in their intestinal development</data>
      <data key="d10">d0f40e5a802daab3992f9e1746a82467</data>
      <data key="d11">0006c00d60a548968255809d5a53e7af</data>
      <data key="d12">10373</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRETERM INFANTS" target="NEC">
