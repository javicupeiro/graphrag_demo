    </node>
    <node id="ENFERMER&#205;A EDUCADORA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">La enfermera educadora es responsable de la educaci&#243;n nutricional de la paciente antes de la cirug&#237;a bari&#225;trica.</data>
      <data key="d2">67f96f3e5c366f82de31f1bf189aa71f</data>
