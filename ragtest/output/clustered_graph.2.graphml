      <data key="d8">8.0</data>
      <data key="d9">Alastru&#233; A is one of the authors of the study published in Rev Esp Geriatr Gerontol</data>
      <data key="d10">cb8368db73f739b1f11f2a202c776e6d</data>
      <data key="d11">a67e5cf935324fe49b80da478b4e8cd4</data>
      <data key="d12">11056</data>
      <data key="d13">2</data>
    </edge>
