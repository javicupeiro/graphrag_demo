    <node id="PEW">
      <data key="d0">EVENT</data>
      <data key="d1">Protein-energy wasting (PEW) is a syndrome characterized by the loss of body protein mass and energy reserves in chronic kidney disease patients, leading to malnutrition.</data>
      <data key="d2">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d3">1159</data>
      <data key="d4">2</data>
