    <node id="F&#211;RMULAS CON ALTO CONTENIDO EN GRASA">
      <data key="d0">EVENT</data>
      <data key="d1">Formulas with high fat content are designed for patients requiring lower carbohydrate intake and higher fat for energy.</data>
      <data key="d2">d3dab2869ed103bbf74ecb1a4a822567</data>
