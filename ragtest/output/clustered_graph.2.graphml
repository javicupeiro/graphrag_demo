    </edge>
    <edge source="DIN" target="DEMELOCICLINA">
      <data key="d8">5.0</data>
      <data key="d9">Demeclocycline can induce nephrogenic diabetes insipidus as a side effect.</data>
      <data key="d10">1fb4c8ba1bc908ea3a3c7717a073fa4f</data>
      <data key="d11">33dc1ef1b24041bfa118dc1295aeb9aa</data>
