      <data key="d7">9873a233b673448ea3d56bae1accab30</data>
    </node>
    <node id="NUTRITIONAL VALUATION">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional valuation is the assessment of a patient's nutritional status to determine the appropriate support needed, particularly in oncology patients.</data>
      <data key="d2">cae7bf8d7b8c9d1f34a87ef41ff39a17</data>
      <data key="d5">0</data>
      <data key="d6">13692</data>
      <data key="d7">b2983d4bb3d341c4a68fe987bd374c7f</data>
    </node>
    <node id="IMMUNOCOMPROMISED PATIENT">
      <data key="d0">PERSON</data>
      <data key="d1">Immunocompromised patients are individuals whose immune systems are weakened, making them more susceptible to infections, particularly relevant in the context of nutritional support.</data>
      <data key="d2">cae7bf8d7b8c9d1f34a87ef41ff39a17</data>
      <data key="d3">1210</data>
      <data key="d4">2</data>
