    <edge source="NUTRICI&#211;N" target="VALORACI&#211;N NUTRICIONAL">
      <data key="d8">1.0</data>
      <data key="d9">Nutritional assessment is a process aimed at evaluating and improving nutrition</data>
      <data key="d10">17f48ff2bbbb22ecd24983f41739c88b</data>
      <data key="d11">803fc387ec4a489fa2c9d5df81245795</data>
