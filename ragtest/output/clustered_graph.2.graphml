    </node>
    <node id="CLASIFICACI&#211;N DE KNOSP">
      <data key="d0">EVENT</data>
      <data key="d1">La clasificaci&#243;n de Knosp es un sistema utilizado para evaluar la invasi&#243;n de los tumores hipofisarios en el seno cavernoso mediante im&#225;genes de resonancia magn&#233;tica.</data>
      <data key="d2">b18ef5c018c100e1582224fe82f03626</data>
      <data key="d3">1321</data>
      <data key="d4">2</data>
