    </edge>
    <edge source="OMS" target="DI@BET.ES">
      <data key="d8">5.0</data>
      <data key="d9">Di@bet.es works alongside the OMS to research obesity and its health implications</data>
      <data key="d10">cb9b69fc936b99615d48b5a9468bc052</data>
