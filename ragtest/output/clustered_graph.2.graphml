    <node id="UNIVERSIDAD MIGUEL HERN&#193;NDEZ">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Miguel Hern&#225;ndez University is an educational institution where &#211;scar Moreno P&#233;rez serves as an associate professor in the Clinical Medicine Department.</data>
      <data key="d2">404f3831a7bac02ee23cb4d4f4f2b0e9</data>
      <data key="d3">551</data>
