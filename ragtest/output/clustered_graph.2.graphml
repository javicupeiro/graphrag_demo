    </edge>
    <edge source="FESNAD" target="&#193;CIDOS GRASOS TRANS">
      <data key="d8">6.0</data>
      <data key="d9">FESNAD's consensus advises minimizing trans fatty acids in the diet due to health risks</data>
      <data key="d10">1ad5b4d7f49ca2d3d44adc99227f07d8</data>
      <data key="d11">a63a5a00a6244737b488f7dacfa3b3c6</data>
      <data key="d12">16795</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GEPREM-HG" target="METILMERCURIO">
      <data key="d8">7.0</data>
      <data key="d9">GEPREM-Hg provides guidelines to minimize methylmercury exposure through fish consumption</data>
      <data key="d10">1ad5b4d7f49ca2d3d44adc99227f07d8</data>
      <data key="d11">ee1147e32b664e12a7f41c1764c01ee5</data>
      <data key="d12">16796</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GEPREM-HG" target="METHYLMERCURY">
      <data key="d8">9.0</data>
      <data key="d9">Methylmercury is the substance for which the GEPREM-Hg recommendations are established to limit its consumption in fish.</data>
      <data key="d10">018644ab78da6f804c57546f08ff6a65</data>
      <data key="d11">b35631d3b8a9461ba42c84c265a9685c</data>
      <data key="d12">16797</data>
