      <data key="d7">5be28345072047478e133173a1f224ca</data>
    </node>
    <node id="F&#211;RMULAS HIDROLIZADAS">
      <data key="d0">EVENT</data>
      <data key="d1">Hydrolyzed formulas contain proteins broken down into smaller peptides, making them easier to digest for allergic infants.</data>
      <data key="d2">a562e90891c11da0293bc7de511acc8f</data>
      <data key="d3">378</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
