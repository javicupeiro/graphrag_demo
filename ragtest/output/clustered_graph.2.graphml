      <data key="d6">2578</data>
      <data key="d7">0e23025f0c9f4faba58b32af234dc24c</data>
    </node>
    <node id="IHAN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Initiative for the Promotion of Breastfeeding (IHAN) is an organization that promotes breastfeeding practices in hospitals and healthcare settings.</data>
