      <data key="d6">15998</data>
      <data key="d7">916dba9adb044651bc2eb04614b70f43</data>
    </node>
    <node id="CALIDAD DE LA ASISTENCIA SANITARIA">
      <data key="d0">EVENT</data>
      <data key="d1">Quality of healthcare refers to ensuring that patients receive the most appropriate diagnostic and therapeutic services for optimal health outcomes.</data>
      <data key="d2">22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d3">1063</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">15999</data>
      <data key="d7">55b7dacaf3714cb0b47a823add292f01</data>
    </node>
    <node id="RECURSOS HUMANOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Human resources refer to the personnel required for delivering healthcare services, including medical staff and administrative support.</data>
      <data key="d2">22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d3">857</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16000</data>
      <data key="d7">f9304520cc0b4cdfa70ee15af577313c</data>
    </node>
    <node id="INFRAESTRUCTURAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Infrastructure encompasses the facilities and equipment necessary for providing healthcare services effectively.</data>
      <data key="d2">22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d3">857</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16001</data>
      <data key="d7">dc43d1273b724fb8b111474429d3ba24</data>
    </node>
    <node id="COSTES">
      <data key="d0">EVENT</data>
      <data key="d1">COSTES refers to the financial expenditures associated with healthcare services, encompassing treatment, hospitalization, and resource utilization. These costs have significant financial implications, which can potentially be reduced through enhanced safety and quality management practices. Additionally, in the context of home artificial nutrition in Europe and the United States, the costs range between $75,000 and $122,000 per patient per year, excluding other medical expenses.</data>
      <data key="d2">07e45dae0f017eba9ef9f48439de5c59,123ef22fb42b6ade4fa2dda096df8490,22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d3">857</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">16002</data>
      <data key="d7">2aa5c0e34c724a1d991e9632d37c747b</data>
    </node>
    <node id="SATISFACCI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Satisfaction is the degree to which patients feel their expectations regarding healthcare services are met.</data>
      <data key="d2">22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d3">1063</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16003</data>
      <data key="d7">3faf3fa836334c458710f2a722002788</data>
    </node>
    <node id="DONABEDIAN">
      <data key="d0">PERSON</data>
      <data key="d1">Donabedian is considered the father of healthcare quality and proposed a framework for measuring healthcare quality through structure, process, and outcomes.</data>
      <data key="d2">0e4628d74bee9cdd38f544f119527748</data>
      <data key="d3">336</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">16004</data>
      <data key="d7">929a9cf3d2444a33ad04167e821c9038</data>
    </node>
    <node id="AENOR">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">AENOR is the Spanish Association for Standardization and Certification, responsible for developing quality standards.</data>
      <data key="d2">0e4628d74bee9cdd38f544f119527748</data>
      <data key="d3">336</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">16005</data>
      <data key="d7">ce62997e0f374a1abdccda6b185d2fdf</data>
    </node>
    <node id="ISO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">ISO is the International Organization for Standardization, which develops and publishes international standards.</data>
      <data key="d2">0e4628d74bee9cdd38f544f119527748</data>
