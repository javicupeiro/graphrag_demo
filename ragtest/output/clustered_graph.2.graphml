      <data key="d8">6.0</data>
      <data key="d9">Hypertriglyceridemia may be a metabolic consequence of acromegaly</data>
      <data key="d10">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d11">78d0ac7a6b0942959e261d699f52344a</data>
