      <data key="d11">58c89725c0b64e298c53dc1c8576acdb</data>
      <data key="d12">7791</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACEITES VEGETALES" target="REGLEMENTO 1169/2011">
      <data key="d8">6.0</data>
      <data key="d9">Los aceites vegetales deben ser claramente identificados en la lista de ingredientes seg&#250;n el Reglamento 1169/2011.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">7cec31a7188d429c88beaf0cf4206d11</data>
