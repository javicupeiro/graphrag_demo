    </node>
    <node id="GLUCEMIAS BASAL">
      <data key="d0">EVENT</data>
      <data key="d1">Basal glucose levels are the baseline blood sugar levels that need to be monitored in diabetic patients.</data>
      <data key="d2">8d1eb00b23450a2f2cb1243ea32aa36f</data>
