    <node id="ANALG&#201;SICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Analgesics are medications used to relieve pain, which are often required for patients suffering from acute abdominal pain due to pancreatitis.</data>
      <data key="d2">6a12bee5b54e4c1706548bca972516e3</data>
