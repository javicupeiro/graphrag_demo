    </node>
    <node id="FORMULAS COMERCIALES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Formulas comerciales are special dietary formulas used for individuals with fructosa malabsorption, often containing fructosa or are free of carbohydrates.</data>
      <data key="d2">033a22e7215395479d0775d6a1a2563e</data>
      <data key="d3">862</data>
      <data key="d4">2</data>
