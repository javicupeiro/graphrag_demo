      <data key="d9">Gonz&#225;lez F is one of the authors of the study published in Rev Esp Geriatr Gerontol</data>
      <data key="d10">cb8368db73f739b1f11f2a202c776e6d</data>
      <data key="d11">a2f23670fa6340c6ab57b6ece5303df4</data>
      <data key="d12">11059</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REV ESP GERIATR GERONTOL" target="RUZAFA A">
      <data key="d8">8.0</data>
      <data key="d9">Ruzafa A is one of the authors of the study published in Rev Esp Geriatr Gerontol</data>
      <data key="d10">cb8368db73f739b1f11f2a202c776e6d</data>
      <data key="d11">ccd82b3ea31949dbad31d6c110125214</data>
      <data key="d12">11060</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REV ESP GERIATR GERONTOL" target="PASTOR M">
      <data key="d8">8.0</data>
      <data key="d9">Pastor M is one of the authors of the study published in Rev Esp Geriatr Gerontol</data>
      <data key="d10">cb8368db73f739b1f11f2a202c776e6d</data>
      <data key="d11">cde5081755764fd291adff56a7c37be4</data>
      <data key="d12">11061</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REV ESP GERIATR GERONTOL" target="X CONGRESO DE LA SOCIEDAD DE NUTRIC">
      <data key="d8">6.0</data>
      <data key="d9">The findings from the study on nutritional assessment were presented at the X Congreso de la Sociedad de Nutric</data>
      <data key="d10">cb8368db73f739b1f11f2a202c776e6d</data>
      <data key="d11">51473217582844d8a5acd118db3aa0ed</data>
      <data key="d12">11062</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REV ESP GERIATR GERONTOL" target="POBLACI&#211;N GERI&#193;TRICA">
      <data key="d8">1.0</data>
      <data key="d9">The study published in Rev Esp Geriatr Gerontol focuses on the nutritional assessment of the geriatric population</data>
      <data key="d10">cb8368db73f739b1f11f2a202c776e6d</data>
      <data key="d11">78322e60f73c4fce9735cd687c251da2</data>
      <data key="d12">11063</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NA C REACTIVA" target="PACIENTE QUEMADO">
      <data key="d8">1.0</data>
      <data key="d9">Prote&#237;na C reactiva is monitored in burn patients to assess inflammation and nutritional status</data>
      <data key="d10">b1b42f264a7bfe8d5c9b931ef8b29b02</data>
      <data key="d11">54dc7acd0b544c099084e69190e3b6f8</data>
      <data key="d12">11064</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NA C REACTIVA" target="PRUEBAS DE FUNCI&#211;N HEP&#193;TICA">
      <data key="d8">1.0</data>
      <data key="d9">Prote&#237;na C Reactiva can be part of the assessment in Pruebas de Funci&#243;n Hep&#225;tica to evaluate inflammation</data>
      <data key="d10">241d358b60724c07a75223b79c9e5f41</data>
      <data key="d11">d759ad10a0fa4c668e7a3d52e5cc3d51</data>
      <data key="d12">11065</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANDR&#211;GENOS" target="S&#205;NDROME DE OVARIO POLIQU&#205;STICO">
      <data key="d8">7.0</data>
      <data key="d9">El s&#237;ndrome de ovario poliqu&#237;stico se caracteriza por un aumento en los niveles de andr&#243;genos en la sangre.</data>
      <data key="d10">401a6af689562ae0b9d7fe627eb56d0f</data>
      <data key="d11">8348f8f61d5d4a14b86a207bf69f85aa</data>
      <data key="d12">11066</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONA DEL CRECIMIENTO" target="ADENOMAS HIPOFISARIOS">
      <data key="d8">1.0</data>
      <data key="d9">Los adenomas hipofisarios pueden secretar hormona del crecimiento, causando acromegalia</data>
      <data key="d10">b18ef5c018c100e1582224fe82f03626</data>
      <data key="d11">53e2027563074d5b84f2c49d76b8cadd</data>
      <data key="d12">11067</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONA DEL CRECIMIENTO" target="HIP&#211;FISIS">
      <data key="d8">9.0</data>
      <data key="d9">The hip&#243;fisis is responsible for producing the hormona del crecimiento, which is vital for growth</data>
      <data key="d10">2f30de565a9a9acf7ac0930483276bbb</data>
      <data key="d11">f02e52a8e1da4195baf1c30ff0efb45e</data>
      <data key="d12">11068</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONA DEL CRECIMIENTO" target="ACROMEGALIA">
      <data key="d8">9.0</data>
      <data key="d9">Acromegalia is characterized by excess levels of growth hormone, which leads to its symptoms and complications.</data>
      <data key="d10">2e73034a100b1adb0a00561c08416bda</data>
      <data key="d11">9fae3580c78241a1850f9a0ffa82d4ff</data>
      <data key="d12">11069</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONA DEL CRECIMIENTO" target="S&#205;NDROME DE TURNER">
      <data key="d8">8.0</data>
      <data key="d9">El tratamiento con hormona del crecimiento est&#225; indicado en pacientes con s&#237;ndrome de Turner para mejorar la talla adulta.</data>
      <data key="d10">a2ccbbd76866c4f88a82e64c95764b04</data>
      <data key="d11">2a95de9460f14efebc3bac19f5364397</data>
      <data key="d12">11070</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONA DEL CRECIMIENTO" target="PLACENTA">
      <data key="d8">9.0</data>
      <data key="d9">The placenta secretes growth hormone which increases IGF-1 levels during pregnancy</data>
      <data key="d10">ebfccc35cef320c7240cf36dd52e847a</data>
      <data key="d11">b92551866eb54535a7c410ac4d109b40</data>
      <data key="d12">11071</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GARC&#205;A-GARC&#205;A FJ" target="FRAGILIDAD Y DEPENDENCIA">
      <data key="d8">1.0</data>
      <data key="d9">Garc&#237;a-Garc&#237;a FJ's exploration of frailty is relevant to the discussions in the publication on frailty and dependency</data>
      <data key="d10">72bafac70ee8322d8f303cf94612b461</data>
      <data key="d11">b7a94f9c34a7424d8c640977dda13888</data>
      <data key="d12">11072</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORLEY JE" target="FRAGILIDAD Y DEPENDENCIA">
      <data key="d8">7.0</data>
      <data key="d9">Morley JE's call to action on frailty is pertinent to the themes discussed in the publication on frailty and dependency</data>
      <data key="d10">72bafac70ee8322d8f303cf94612b461</data>
      <data key="d11">538a4289cb5d49ac9c4b845524d5fd57</data>
      <data key="d12">11073</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORLEY JE" target="FRAILTY CONSENSUS">
      <data key="d8">2.0</data>
      <data key="d9">Morley JE is a key figure in the discussions surrounding the frailty consensus, contributing significantly to its development and the implications it holds for geriatric care. His involvement highlights the importance of addressing frailty in older adults and informs best practices in managing this condition within the field of geriatrics.</data>
      <data key="d10">ea432f742f5cd2b4840a984ae35a9d09</data>
      <data key="d11">83da3807a579452995226acb3ca1e158</data>
      <data key="d12">11074</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORLEY JE" target="J AM MED DIR ASSOC">
      <data key="d8">6.0</data>
      <data key="d9">Morley JE's contributions to frailty research are relevant to the Journal of the American Medical Directors Association</data>
      <data key="d10">3be9d646c354d76527755d79a77c916b</data>
      <data key="d11">3984dbe1e9f648de8addf4023ef4ce8d</data>
      <data key="d12">11075</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ROCKWOOD K" target="RETICEF">
      <data key="d8">4.0</data>
      <data key="d9">Rockwood K is involved in the RETICEF initiative to promote research on aging and frailty</data>
      <data key="d10">ea432f742f5cd2b4840a984ae35a9d09</data>
      <data key="d11">b5025be8ebb3468899ab43ea0a33de4a</data>
      <data key="d12">11076</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ROCKWOOD K" target="FRAILTY PHENOTYPE">
      <data key="d8">7.0</data>
      <data key="d9">Rockwood K is known for developing the frailty phenotype concept</data>
      <data key="d10">ea432f742f5cd2b4840a984ae35a9d09</data>
      <data key="d11">65d7fe3ec05141b4a23a5e7f403b0615</data>
      <data key="d12">11077</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ROCKWOOD K" target="FRAILTY INDEX">
      <data key="d8">7.0</data>
      <data key="d9">Rockwood K has worked on the development of the frailty index</data>
      <data key="d10">ea432f742f5cd2b4840a984ae35a9d09</data>
      <data key="d11">eaff6020526a4dfcb6a2ead81d27ac91</data>
      <data key="d12">11078</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DISABILITY" target="AGING">
      <data key="d8">1.0</data>
      <data key="d9">Aging can lead to disabilities that impact the quality of life in elderly individuals</data>
      <data key="d10">72bafac70ee8322d8f303cf94612b461</data>
      <data key="d11">8e156db17e094804adcc1278c4524542</data>
      <data key="d12">11079</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AGING" target="ALZHEIMER'S DISEASE">
      <data key="d8">9.0</data>
      <data key="d9">Aging is a significant risk factor for developing Alzheimer's disease</data>
      <data key="d10">680ff2c9e67ec29c5952df66bd83c984</data>
      <data key="d11">1d9720ee8dc74422b7eb6f124cec3b51</data>
      <data key="d12">11080</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRIED" target="PATOLOGIAS ESPECIFICAS">
      <data key="d8">1.0</data>
      <data key="d9">Fried's criteria are used to diagnose frailty, which is a specific health condition</data>
      <data key="d10">56da8c0bffe9c7811cc9790d767f4972</data>
      <data key="d11">e2322a206c9a420582663a4e2211ce10</data>
      <data key="d12">11081</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ROCKWOOD" target="FRAIL">
      <data key="d8">1.0</data>
      <data key="d9">The Rockwood classification system is used to assess levels of frailty in elderly individuals</data>
      <data key="d10">5d87d36fec170e242e5e50305a1bec49</data>
      <data key="d11">727a4dacb9ca4329a0a88b9753b85335</data>
      <data key="d12">11082</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="DEPENDENCIA FUNCIONAL">
      <data key="d8">7.0</data>
      <data key="d9">The frailty syndrome increases the risk of functional dependence in elderly individuals</data>
      <data key="d10">6656dd3bdc79720504c3e4245f935d32</data>
      <data key="d11">a3acd649a651474181c79f8482c667c2</data>
      <data key="d12">11083</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="DISCAPACIDAD">
      <data key="d8">7.0</data>
      <data key="d9">The frailty syndrome is associated with a higher risk of developing disability in elderly individuals</data>
      <data key="d10">6656dd3bdc79720504c3e4245f935d32</data>
      <data key="d11">7c0b55b295cb44268613e1f33d0ccd1d</data>
      <data key="d12">11084</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="FACTORES NUTRICIONALES">
      <data key="d8">1.0</data>
      <data key="d9">Nutritional factors are critical in the management and prevention of the frailty syndrome</data>
      <data key="d10">6656dd3bdc79720504c3e4245f935d32</data>
      <data key="d11">779aafbe7dc54b228ecdf044491189cf</data>
      <data key="d12">11085</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="SUPLEMENTACI&#211;N PROTEICO-CAL&#211;RICA">
      <data key="d8">8.0</data>
      <data key="d9">La suplementaci&#243;n proteico-cal&#243;rica es efectiva para combatir la p&#233;rdida de peso y mejorar la salud en ancianos con s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">fc32abba9b5748239021102b9c346180</data>
      <data key="d12">11086</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="COCHRANE">
      <data key="d8">7.0</data>
      <data key="d9">Cochrane ha realizado revisiones sobre la efectividad del entrenamiento de fuerza en el tratamiento del s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">3301bcd39fc040ddae9065af373c7470</data>
      <data key="d12">11087</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="BATER&#205;A BREVE DE RENDIMIENTO F&#205;SICO (SPPB)">
      <data key="d8">7.0</data>
      <data key="d9">La bater&#237;a breve de rendimiento f&#237;sico (SPPB) se utiliza para evaluar la funcionalidad en ancianos con s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">cc0b9e70e5d3477c981f8fdadf3560ff</data>
      <data key="d12">11088</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="VELOCIDAD DE LA MARCHA HABITUAL">
      <data key="d8">7.0</data>
      <data key="d9">La velocidad de la marcha habitual es un indicador de limitaci&#243;n funcional en ancianos con s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">b952274461a74bc990f4c40f8a8b7f3d</data>
      <data key="d12">11089</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="PRUEBA CRONOMETRADA DE LEV&#193;NTATE Y ANDA">
      <data key="d8">7.0</data>
      <data key="d9">La prueba cronometrada de lev&#225;ntate y anda mide el rendimiento f&#237;sico en ancianos con s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">f5fa124bc02b41e0a2d7ad79fdf516a1</data>
      <data key="d12">11090</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="DEXA">
      <data key="d8">6.0</data>
      <data key="d9">DEXA se utiliza para evaluar la masa muscular en ancianos, lo cual es relevante en el contexto del s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">356685e2ae24447c8b9a6839d4a16921</data>
      <data key="d12">11091</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="RESONANCIA NUCLEAR MAGN&#201;TICA (RNM)">
      <data key="d8">6.0</data>
      <data key="d9">La resonancia nuclear magn&#233;tica (RNM) es una t&#233;cnica de elecci&#243;n para evaluar la masa muscular en ancianos con s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">31e0328b51dc4d87a98bdf31a9588f9d</data>
      <data key="d12">11092</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="AN&#193;LISIS DE BIOIMPEDANCIA">
      <data key="d8">6.0</data>
      <data key="d9">El an&#225;lisis de bioimpedancia es &#250;til para calcular la masa corporal en ancianos, lo que es importante en el tratamiento del s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">f0bc510726524abfa7bece8fe3d87e48</data>
      <data key="d12">11093</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="ULTRASONIDO MUSCULAR">
      <data key="d8">1.0</data>
      <data key="d9">El ultrasonido muscular se utiliza para medir la masa muscular en ancianos, siendo relevante para el s&#237;ndrome de fragilidad.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">f5ff59db59ad40bd93461c94c90cb87a</data>
      <data key="d12">11094</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE FRAGILIDAD" target="SUPLEMENTACI&#211;N CAL&#211;RICO-PROTEICA">
      <data key="d8">1.0</data>
      <data key="d9">Caloric-protein supplementation is part of the comprehensive treatment for frailty</data>
      <data key="d10">1052683f23a0c9825af9c5c1d39ceb2c</data>
      <data key="d11">ecb95815a01e40718ac231bf0526902a</data>
      <data key="d12">11095</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="ADENOHIP&#211;FISIS">
      <data key="d8">8.0</data>
      <data key="d9">La testosterona tambi&#233;n influye en la regulaci&#243;n de la secreci&#243;n de gonadotropinas en la adenohip&#243;fisis</data>
      <data key="d10">78b093da6669fb9ed3258ed62a73260e</data>
      <data key="d11">9a5d3ab23bac473b91b79af528d334f2</data>
      <data key="d12">11096</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="SAMUEL NAMARA">
      <data key="d8">8.0</data>
      <data key="d9">Samuel Namara's testosterone levels are assessed to diagnose the type of precocious puberty</data>
      <data key="d10">9a92d2ad7423e6f4566f67259abc86b2</data>
      <data key="d11">ff8c90f9d72c4b209e7b1cdf85dd8696</data>
      <data key="d12">11097</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="HIPOGONADISMO">
      <data key="d8">17.0</data>
      <data key="d9">Testosterona, a hormone crucial for male health, is utilized as a treatment for hipogonadismo, a condition characterized by low testosterone levels. This deficiency significantly impacts male health and fertility, leading to various complications. The administration of testosterone helps to induce and maintain normal sexual function in individuals suffering from hipogonadismo, thereby addressing the adverse effects associated with this hormonal imbalance.</data>
      <data key="d10">0cf04c95a8e6bbdf9201bf3fff9103f6,7d5f6bf9cedae48d8c4054344fea60b4</data>
      <data key="d11">eb1f689608ab47b08f4af804bb658864</data>
      <data key="d12">11098</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="S&#205;NDROME DE OVARIO POLIQU&#205;STICO">
      <data key="d8">8.0</data>
      <data key="d9">El s&#237;ndrome de ovario poliqu&#237;stico se caracteriza por un aumento de los niveles de testosterona en sangre, lo que contribuye al hirsutismo.</data>
      <data key="d10">401a6af689562ae0b9d7fe627eb56d0f</data>
      <data key="d11">dd6d26ac9a24437c96d81e313787e5c2</data>
      <data key="d12">11099</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="TUMORES TESTICULARES">
      <data key="d8">6.0</data>
      <data key="d9">Los tumores testiculares pueden afectar la producci&#243;n de testosterona, alterando los niveles hormonales en el cuerpo</data>
      <data key="d10">4accb4afaddfdc671690221252ff1b99</data>
      <data key="d11">696db157ffac488dbba9b989935322ee</data>
      <data key="d12">11100</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="S&#205;NDROME DE KENNEDY">
      <data key="d8">5.0</data>
      <data key="d9">El s&#237;ndrome de Kennedy se relaciona con la insensibilidad androg&#233;nica, lo que afecta los niveles de testosterona y gonadotrofinas</data>
      <data key="d10">4accb4afaddfdc671690221252ff1b99</data>
      <data key="d11">ea46cfc250ad46a7a1dba1a3c3d64bfd</data>
      <data key="d12">11101</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="C&#201;LULAS DE LEYDIG">
      <data key="d8">8.0</data>
      <data key="d9">Las c&#233;lulas de Leydig producen testosterona en respuesta a la LH, lo que es crucial para la funci&#243;n testicular</data>
      <data key="d10">4accb4afaddfdc671690221252ff1b99</data>
      <data key="d11">70083fdf714d4ff1a8f7898f0b869db5</data>
      <data key="d12">11102</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="C&#201;LULAS DE SERTOLI">
      <data key="d8">7.0</data>
      <data key="d9">Las c&#233;lulas de Sertoli requieren un ambiente de altos niveles de testosterona para la producci&#243;n de esperma</data>
      <data key="d10">4accb4afaddfdc671690221252ff1b99</data>
      <data key="d11">dc325318c98c4d6288df0114ce5f8b3b</data>
      <data key="d12">11103</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="HIPOGONADISMO HIPOGONADOTROPO">
      <data key="d8">7.0</data>
      <data key="d9">El hipogonadismo hipogonadotropo se caracteriza por niveles bajos de testosterona en sangre debido a la disminuci&#243;n de gonadotrofinas</data>
      <data key="d10">4accb4afaddfdc671690221252ff1b99</data>
      <data key="d11">fa9b202ee668478a90e7736c4d3be491</data>
      <data key="d12">11104</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="SHBG">
      <data key="d8">8.0</data>
      <data key="d9">Testosterona levels are influenced by SHBG, which binds to testosterone and affects its availability in the body</data>
      <data key="d10">4beab004731d7baff10fd2796a523b55</data>
      <data key="d11">b942cdbd15d04f849e71093784ee9db5</data>
      <data key="d12">11105</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="HCG">
      <data key="d8">8.0</data>
      <data key="d9">hCG is used in treatments to stimulate testosterone production in males with low testosterone levels</data>
      <data key="d10">0cf04c95a8e6bbdf9201bf3fff9103f6</data>
      <data key="d11">7979cb1b2737463bbd7bac3a97b9a580</data>
      <data key="d12">11106</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="GNRH">
      <data key="d8">8.0</data>
      <data key="d9">GnRH stimulates the release of gonadotropins, which are important for testosterone production</data>
      <data key="d10">0cf04c95a8e6bbdf9201bf3fff9103f6</data>
      <data key="d11">9234cb0816b5435e8a7af812920f594a</data>
      <data key="d12">11107</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="S&#205;NDROME METAB&#211;LICO">
      <data key="d8">5.0</data>
      <data key="d9">Testosterone treatment can contribute to the development of metabolic syndrome in some patients</data>
      <data key="d10">0cf04c95a8e6bbdf9201bf3fff9103f6</data>
      <data key="d11">bafdee58b4ba4eb98921a724773ca6ff</data>
      <data key="d12">11108</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="HORMONAS">
      <data key="d8">1.0</data>
      <data key="d9">Testosterone is a key hormone that influences various bodily functions and is part of the broader category of hormones</data>
      <data key="d10">0cf04c95a8e6bbdf9201bf3fff9103f6</data>
      <data key="d11">2658e872d0a74caaa3b25090d6e8c4ea</data>
      <data key="d12">11109</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TESTOSTERONA" target="HIPOPITUITARISMO">
      <data key="d8">6.0</data>
      <data key="d9">El hipopituitarismo puede llevar a niveles bajos de testosterona, causando hipogonadismo.</data>
      <data key="d10">68c1e1d1d60cf84e8ba37450cd6dc7d3</data>
      <data key="d11">6fd8022e351c4603b979306215629eb4</data>
      <data key="d12">11110</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRAIL QUESTIONNAIRE SCREENING TOOL" target="GERIATRIC INTEGRAL ASSESSMENT">
      <data key="d8">7.0</data>
      <data key="d9">Both tools are used to assess frailty in elderly individuals, with the FRAIL Questionnaire being a screening tool and the Geriatric Integral Assessment providing a comprehensive evaluation</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">00db3e3537ca4ee1a1e4f67dc6e98ecf</data>
      <data key="d12">11111</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CARDIOVASCULAR HEALTH STUDY FRAILTY SCREENING SCALE" target="GERIATRIC INTEGRAL ASSESSMENT">
      <data key="d8">7.0</data>
      <data key="d9">Both tools are utilized to evaluate frailty in older adults, focusing on different aspects of health</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">f21a0caa945a4ebd94372ffbdf983853</data>
      <data key="d12">11112</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CLINICAL FRAILTY SCALE" target="GERIATRIC INTEGRAL ASSESSMENT">
      <data key="d8">7.0</data>
      <data key="d9">The Clinical Frailty Scale is a specific tool that can be part of the broader Geriatric Integral Assessment for evaluating frailty</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">5c3ccfd3c9d142fa9d87e55102a59e8c</data>
      <data key="d12">11113</data>
      <data key="d13">2</data>
    </edge>
    <edge source="G&#201;RONTOP&#212;LE FRAILTY SCREENING TOOL" target="GERIATRIC INTEGRAL ASSESSMENT">
      <data key="d8">7.0</data>
      <data key="d9">The G&#233;rontop&#244;le Frailty Screening Tool is used in conjunction with the Geriatric Integral Assessment to identify frailty</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">c81f8cd164754c3c96187f9971c807c7</data>
      <data key="d12">11114</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GERIATRIC INTEGRAL ASSESSMENT" target="ATTENTION PRIMARY">
      <data key="d8">7.0</data>
      <data key="d9">Attention Primary is the setting where the Geriatric Integral Assessment can be performed for frail elderly individuals</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">ef4cc721abf34415adcba15cc658bf59</data>
      <data key="d12">11115</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GERIATRIC INTEGRAL ASSESSMENT" target="SPECIALIZED CARE">
      <data key="d8">7.0</data>
      <data key="d9">Specialized Care may involve the Geriatric Integral Assessment to address complex health needs of frail elderly patients</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">4d2e806552fe40038a648e73c6ef3185</data>
      <data key="d12">11116</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ELDERLY POPULATION" target="MULTIMORBIDITY">
      <data key="d8">8.0</data>
      <data key="d9">The elderly population is often affected by multimorbidity, which increases the risk of frailty</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">a6bf484246ce464ebb49c727b5583d31</data>
      <data key="d12">11117</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ELDERLY POPULATION" target="HEART FAILURE">
      <data key="d8">8.0</data>
      <data key="d9">The elderly population is at a higher risk of developing heart failure, which can contribute to frailty</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">ac4a5e0d6d1d488f9794360eda669d83</data>
      <data key="d12">11118</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ELDERLY POPULATION" target="CHRONIC KIDNEY DISEASE">
      <data key="d8">8.0</data>
      <data key="d9">The elderly population is at increased risk for chronic kidney disease, which can contribute to frailty</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">83181ac2654547488e6d0a103c880eb7</data>
      <data key="d12">11119</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ELDERLY POPULATION" target="HIV INFECTION">
      <data key="d8">8.0</data>
      <data key="d9">The elderly population can be affected by HIV infection, which may increase the risk of frailty</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">97d7bd2ba95541c2b7797e68f850dc3f</data>
      <data key="d12">11120</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ELDERLY POPULATION" target="SURGICAL INTERVENTION">
      <data key="d8">1.0</data>
      <data key="d9">The elderly population often undergoes surgical interventions, which can impact their health and contribute to frailty</data>
      <data key="d10">97a29de0d5161aebffb702f69c6dd870</data>
      <data key="d11">4497d34cdb2643f48c9398c794ed16a7</data>
      <data key="d12">11121</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SPECIALIZED CARE" target="CLINICAL TEAM">
      <data key="d8">7.0</data>
      <data key="d9">The clinical team works with specialized care to manage complications arising from bariatric surgery</data>
      <data key="d10">db39b776f49b9fad2deb1dec7a0d3288</data>
      <data key="d11">6cabdbbe49464662b8b22fb073d20f55</data>
      <data key="d12">11122</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEART FAILURE" target="MEDITERRANEAN DIET">
      <data key="d8">20.0</data>
      <data key="d9">Research indicates that adherence to the Mediterranean diet can significantly improve outcomes in patients with heart failure. Multiple studies have shown that this dietary pattern is associated with enhanced health results for individuals suffering from this condition. The Mediterranean diet, characterized by its emphasis on fruits, vegetables, whole grains, legumes, nuts, and healthy fats, has been consistently linked to better management and overall improvement in heart failure patients.</data>
      <data key="d10">35a49a079daea350a5552c8fd96d7967,c9a02c0d93ca431827b63d51ae564670,eb275fa50517d86a71589fd318784a5b</data>
      <data key="d11">e7736a77bbaa4e4e962f4f1d5f514c42</data>
      <data key="d12">11123</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEART FAILURE" target="HEMATOCHROMATOSIS">
      <data key="d8">6.0</data>
      <data key="d9">Heart failure can be a serious complication in patients with hereditary hemochromatosis, particularly when iron overload is present.</data>
      <data key="d10">83d2bb17e643e047bb3ad2ecc88d8271</data>
      <data key="d11">4f32edfcfa4846f391e51bc0ac7d7c55</data>
      <data key="d12">11124</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CHRONIC KIDNEY DISEASE" target="OSTEOPOROSIS SOCIETY OF CANADA">
      <data key="d8">1.0</data>
      <data key="d9">The Osteoporosis Society of Canada provides guidelines that may include considerations for patients with chronic kidney disease.</data>
      <data key="d10">08bc4a83d18482b48f5bbef4fbf316f3</data>
      <data key="d11">979b58f6dae1445ba3f6743c5b11ed5f</data>
      <data key="d12">11125</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COCHRANE" target="SUPLEMENTACI&#211;N PROTEICO-CAL&#211;RICA">
      <data key="d8">1.0</data>
      <data key="d9">Cochrane ha afirmado que la suplementaci&#243;n proteico-cal&#243;rica mejora la salud en ancianos desnutridos.</data>
      <data key="d10">4913cc391a44397e2e1ea12979e1fd58</data>
      <data key="d11">90798e431650459cb6a9a77069e247b0</data>
      <data key="d12">11126</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEXA" target="BIA">
      <data key="d8">20.0</data>
      <data key="d9">DEXA and BIA are both techniques utilized in clinical practice to assess body composition and muscle mass in patients. These methods serve as valuable tools for evaluating the distribution of fat and lean mass within the body, providing important insights for health assessments and interventions.</data>
      <data key="d10">1bad878c6efa9d3f5719546bb51bccb6,76d78b3e33659e952b0d2835f5bdf595,87e62f930efe0b81911357297ccd271c</data>
      <data key="d11">342dea82049d48c7981dce0fd14cd6db</data>
      <data key="d12">11127</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEXA" target="S&#205;NDROME DE TURNER">
      <data key="d8">2.0</data>
      <data key="d9">La DEXA, o absorciometr&#237;a dual de rayos X, es una herramienta importante para evaluar la densidad &#243;sea en pacientes con s&#237;ndrome de Turner. Este s&#237;ndrome se caracteriza por un mayor riesgo de osteoporosis, lo que hace que la evaluaci&#243;n de la densidad &#243;sea sea crucial para la salud de estos pacientes. Sin embargo, es importante tener en cuenta que la DEXA puede subestimar los resultados en este grupo espec&#237;fico de pacientes.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b,7d5f6bf9cedae48d8c4054344fea60b4</data>
      <data key="d11">a16dd5dff1554dd285ac917a716c140f</data>
      <data key="d12">11128</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALBACETE" target="FRADEA STUDY">
      <data key="d8">8.0</data>
      <data key="d9">The FRADEA study is conducted in Albacete, focusing on frailty and dependence in older adults</data>
      <data key="d10">ea432f742f5cd2b4840a984ae35a9d09</data>
      <data key="d11">4d18058b77af4baaafbaeb8678bcf687</data>
      <data key="d12">11129</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN WORKING GROUP ON SARCOPENIA IN OLDER PEOPLE" target="JOURNAL OF GERONTOLOGY">
      <data key="d8">6.0</data>
      <data key="d9">The European Working Group on Sarcopenia in Older People publishes findings in the Journal of Gerontology</data>
      <data key="d10">ea432f742f5cd2b4840a984ae35a9d09</data>
      <data key="d11">3a41e850fd4042168ca33d188a732006</data>
      <data key="d12">11130</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN WORKING GROUP ON SARCOPENIA IN OLDER PEOPLE" target="CRUZ-JENTOFT AJ">
      <data key="d8">16.0</data>
      <data key="d9">Cruz-Jentoft AJ is a key contributor and member of the European Working Group on Sarcopenia in Older People. This group is dedicated to advancing research on sarcopenia, which is the loss of muscle mass and strength associated with aging. Cruz-Jentoft AJ plays a significant role in the group's efforts to define and diagnose sarcopenia, contributing to the understanding and management of this condition in older adults.</data>
      <data key="d10">066ca85c476fdb709bb2b588cb86a55a,d80f1e55925e0ce0cd958e35ad2e49ff</data>
      <data key="d11">cba7e0ff08fe4ba48b423e9f3900ecd0</data>
      <data key="d12">11131</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN WORKING GROUP ON SARCOPENIA IN OLDER PEOPLE" target="AGE AGEING">
      <data key="d8">7.0</data>
      <data key="d9">The European Working Group on Sarcopenia in Older People publishes its findings in the journal Age Ageing</data>
      <data key="d10">066ca85c476fdb709bb2b588cb86a55a</data>
      <data key="d11">7631b20a96314391ac4030dc3b1eb79c</data>
      <data key="d12">11132</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BMC GERIATRICS" target="PAN-EUROPEAN PRESSURE ULCER STUDY">
      <data key="d8">5.0</data>
      <data key="d9">Both studies address issues related to pressure ulcers, highlighting risk factors in older adults.</data>
      <data key="d10">36c1edffe986e2f70996b6e440e11213</data>
      <data key="d11">2c67faaee65b425aa6dbed8785c01686</data>
      <data key="d12">11133</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BMC GERIATRICS" target="NATIONAL MEDICARE PATIENT SAFETY MONITORING SYSTEM">
      <data key="d8">5.0</data>
      <data key="d9">The Medicare system's monitoring of pressure ulcers relates to the research published in BMC Geriatrics on risk factors.</data>
      <data key="d10">36c1edffe986e2f70996b6e440e11213</data>
      <data key="d11">dfc8d8b911cf47069e0bd9681bd759a0</data>
      <data key="d12">11134</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LANCET" target="FRAILTY IN ELDERLY PEOPLE">
      <data key="d8">7.0</data>
      <data key="d9">The Lancet publishes research articles on frailty in elderly people</data>
      <data key="d10">ea432f742f5cd2b4840a984ae35a9d09</data>
      <data key="d11">16bc964f0c074e13b855c0556ff42241</data>
      <data key="d12">11135</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LANCET" target="LUDWIG DS">
      <data key="d8">8.0</data>
      <data key="d9">Ludwig DS's research on sugar-sweetened drinks and childhood obesity was published in The Lancet</data>
      <data key="d10">428616513e9e654c21ede19bd544ffbc</data>
      <data key="d11">e692e03354d94c778260a29f2e67689e</data>
      <data key="d12">11136</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LANCET" target="DIETARY INTERVENTION STUDY">
      <data key="d8">7.0</data>
      <data key="d9">The Lancet published findings from the dietary intervention study conducted in China.</data>
      <data key="d10">e757275b1935a42dabd03a0b528649a3</data>
      <data key="d11">6da9cec04dc94ceab2f122f77446cace</data>
      <data key="d12">11137</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LANCET" target="GBD 2013">
      <data key="d8">8.0</data>
      <data key="d9">The Lancet published findings from the GBD 2013 study on mortality and causes of death</data>
      <data key="d10">35a49a079daea350a5552c8fd96d7967</data>
      <data key="d11">42aeb812b3594f2782190e39326b49d6</data>
      <data key="d12">11138</data>
      <data key="d13">2</data>
