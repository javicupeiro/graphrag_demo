      <data key="d7">ae18b9e8e4d24bb0bb5b86e46580304f</data>
    </node>
    <node id="PSEUDOMONA AERUGINOSA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Pseudomonas aeruginosa is a gram-negative bacterium known for its ability to cause serious infections, particularly in patients with compromised immune systems, such as those with catheters. This opportunistic pathogen poses a significant risk in clinical settings, where it can lead to severe health complications in vulnerable individuals.</data>
      <data key="d2">e5313f692c0a8259c93be803a704413c,fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d3">766</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15593</data>
      <data key="d7">88af95aa2f464575b29ad7c62cc2d6d2</data>
    </node>
    <node id="UROQUINASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Urokinase is a fibrinolytic agent used to treat occlusions in catheters.</data>
      <data key="d2">fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d3">766</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
