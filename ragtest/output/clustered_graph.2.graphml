      <data key="d11">9516488094ed4c41ae52fbb7bdd04c9b</data>
      <data key="d12">17239</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANOREXIA NERVOSA" target="RESTRICTIVE EATING DISORDERS">
      <data key="d8">9.0</data>
      <data key="d9">Anorexia nervosa is classified as a type of restrictive eating disorder, sharing similar characteristics and treatment approaches.</data>
      <data key="d10">341d121c4c1cc1e4fb942e4b23f6931b</data>
      <data key="d11">4a4a2d2cefc2411d84bf12335cc57f03</data>
      <data key="d12">17240</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EPILEPSY" target="KETOGENIC DIET">
      <data key="d8">8.0</data>
      <data key="d9">The ketogenic diet is studied for its effectiveness in reducing seizures in patients with epilepsy</data>
      <data key="d10">55b85a76a2c3d515bd3fe6137255abac</data>
