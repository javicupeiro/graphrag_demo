      <data key="d13">2</data>
    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="HOMBRE">
      <data key="d8">8.0</data>
      <data key="d9">El paciente var&#243;n de 66 a&#241;os experiment&#243; una p&#233;rdida de peso de 10 kg durante su tratamiento</data>
      <data key="d10">e474ebdcd3e5392e4b2bed8434293849</data>
      <data key="d11">d868cd4f17ac4ac9b745e5ee0631bc83</data>
