      <data key="d6">408</data>
      <data key="d7">669b65ac2692433e9561c94425f41c63</data>
    </node>
    <node id="BASE DE LA LENGUA">
      <data key="d0">GEO</data>
      <data key="d1">The base of the tongue is an anatomical area assessed for its function in swallowing during the VED.</data>
      <data key="d2">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d3">944</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">409</data>
      <data key="d7">492e306df3204ad7a127e1489eea357e</data>
    </node>
    <node id="PAQUIDERMIA INTERARITENOIDEA">
      <data key="d0">GEO</data>
      <data key="d1">Paquidermia interaritenoidea is an indirect sign of reflux that can affect swallowing sensitivity and is evaluated during the VED process.</data>
      <data key="d2">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d3">944</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">410</data>
      <data key="d7">c6d5a68c7ea94cfba13d338646e10d0d</data>
    </node>
    <node id="CONSTRICTORES FAR&#205;NGEOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The constrictores far&#237;ngeos are muscles involved in swallowing that are activated during the assessment process.</data>
      <data key="d2">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d3">944</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">411</data>
      <data key="d7">9076d1ff1d05455a93312cb4c50a81d8</data>
    </node>
    <node id="MANIOBRA DE VALSALVA">
      <data key="d0">EVENT</data>
      <data key="d1">The maniobra de Valsalva is a maneuver performed by the patient to assess the function of the laryngeal structures during the VED.</data>
      <data key="d2">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d3">944</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">412</data>
      <data key="d7">78293eb7078d491a8c2d29881d6a20fb</data>
    </node>
    <node id="FONEMAS VELARES OCLUSIVOS">
      <data key="d0">EVENT</data>
      <data key="d1">The fonemas velares oclusivos are specific sounds used during the assessment to evaluate the mobility of the velum.</data>
      <data key="d2">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d3">944</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">413</data>
      <data key="d7">641aa4c92b2c469490833442c41199e3</data>
    </node>
    <node id="DEGLUCIONES SECAS">
      <data key="d0">EVENT</data>
      <data key="d1">Degluciones secas refer to the dry swallows performed by the patient, which are observed during the VED to assess swallowing function.</data>
      <data key="d2">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d3">944</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">414</data>
      <data key="d7">a61b03ddc9cf4189bf5f3355fa8f9caa</data>
    </node>
    <node id="JONATHAN AVIV">
      <data key="d0">PERSON</data>
      <data key="d1">Jonathan Aviv is a researcher who published a new method for sensory evaluation in swallowing in 1998, known as FEESST.</data>
      <data key="d2">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d5">1</data>
      <data key="d6">415</data>
      <data key="d7">8e2ac2cecf1c4750bfcfd0b11b5e1bf5</data>
    </node>
    <node id="FEESST">
      <data key="d0">EVENT</data>
      <data key="d1">FEESST stands for Flexible Endoscopic Evaluation of Swallowing with Sensory Testing, a method developed to assess swallowing reflexes using air impulses.</data>
      <data key="d2">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d5">1</data>
      <data key="d6">416</data>
      <data key="d7">9758106c3e96401a91074d806277e770</data>
    </node>
    <node id="LANGMORE SCALE">
      <data key="d0">EVENT</data>
      <data key="d1">The Langmore scale is a published scale used to quantify the degree of occupation of pharyngeal areas with a patient's own secretions.</data>
      <data key="d2">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d5">1</data>
      <data key="d6">417</data>
      <data key="d7">ad0d655efafa4753a47b4899ba6ce5b7</data>
    </node>
    <node id="MURRAY SCALE">
      <data key="d0">EVENT</data>
      <data key="d1">The Murray scale is another published scale used for assessing the risk of aspiration based on secretions in the pharyngeal areas.</data>
      <data key="d2">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d5">1</data>
      <data key="d6">418</data>
      <data key="d7">b0077a9f455e4f368c33ddb74f549877</data>
    </node>
    <node id="LARYNX">
      <data key="d0">GEO</data>
      <data key="d1">The larynx is a critical area in swallowing, involved in protecting the airway and facilitating sound production.</data>
      <data key="d2">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d5">2</data>
      <data key="d6">419</data>
      <data key="d7">60880876cb4b48f5a7020ed29a9e2f30</data>
    </node>
    <node id="DEGLUTITION">
      <data key="d0">EVENT</data>
      <data key="d1">Deglutition refers to the act of swallowing, which is a complex process involving various anatomical structures.</data>
      <data key="d2">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d5">2</data>
      <data key="d6">420</data>
      <data key="d7">d5dbde95267142fca2828f2b6ee1b037</data>
    </node>
    <node id="XEROSTOMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Xerostomia is a condition characterized by dry mouth due to reduced saliva production, which can affect swallowing.</data>
      <data key="d2">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d5">1</data>
      <data key="d6">421</data>
      <data key="d7">c5d28719a87041dfb49315a9aa3d16ad</data>
    </node>
    <node id="ALHAMIA PRISON">
      <data key="d0">GEO</data>
      <data key="d1">Alhamia Prison is a facility located in Tiruzia, known for holding various individuals, including hostages and prisoners such as Samuel Namara. The prison is relevant to multiple medical contexts, including discussions surrounding hypopituitarism, malnutrition among prisoners, and the treatment of conditions like precocious puberty. It has been mentioned in relation to evaluating swallowing and related functions, as well as in the context of medical observation or treatment for complications arising from procedures like GEP. Additionally, Alhamia Prison has been inferred to have significance in discussions about hyperprolactinemia in men, particularly concerning the health and fragility of elderly inmates. Overall, the facility serves as a critical point of reference for various medical and health-related issues affecting those held within its walls.</data>
      <data key="d2">0ed0218136adceb16e9f246f3072e6dd,401299e752f19cfeb47fce9c87cdf696,592d424edaa447a54ab4489d82495db6,742d2991389effe376f335dad6fbafa1,7d1eed82db6d0ad62418f3f965316c39,89855c293083756b0ff7a0081f67e9fd,94acece2df038421a302ca1fa53d5275,9a92d2ad7423e6f4566f67259abc86b2,9ea2863d43f4c93ae3681a0faf1a0a3d,b0b96ec7b9f57581fe18f0ac902af707,c6994d09848639470e57b0ab0b7166cf,cb3d17a78ad2d9342ebe0fd2aac8e9d1,e09463a0b899f9cd54a1daefc265ca39,f7c941bced546a7d607c30a9a5e9d887</data>
      <data key="d5">0</data>
      <data key="d6">422</data>
      <data key="d7">35515d6e7d454255ac75d2776c25c949</data>
    </node>
    <node id="ENDOSCOPE">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">401299e752f19cfeb47fce9c87cdf696</data>
      <data key="d5">1</data>
      <data key="d6">423</data>
      <data key="d7">69048e319f1948ab935a428631333ee0</data>
    </node>
    <node id="MURRAY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Murray is another scale published for assessing the degree of secretion occupation in pharyngeal areas.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1535</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">424</data>
      <data key="d7">03e0c57b93ad4cee96103898be372f50</data>
    </node>
    <node id="ICE CHIP PROTOCOL">
      <data key="d0">EVENT</data>
      <data key="d1">The Ice Chip Protocol is a method recommended for patients with poor management of secretions, involving the administration of small ice fragments to stimulate swallowing.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1257</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">425</data>
      <data key="d7">b75a445d1c02430c8ff5aa253eea8066</data>
    </node>
    <node id="HYPOPHARYNX">
      <data key="d0">GEO</data>
      <data key="d1">The hypopharynx is an anatomical area that includes the piriform sinuses and retrocricoid area where secretions can also accumulate.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1257</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">426</data>
      <data key="d7">5d28f17d5b82477ea9ad587f4e4af166</data>
    </node>
    <node id="LARYNGEAL VESTIBULE">
      <data key="d0">GEO</data>
      <data key="d1">The laryngeal vestibule is an anatomical area where secretions can be present during swallowing evaluations.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1257</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">427</data>
      <data key="d7">36b93b79ddbd430aa70b368b9d2eb4df</data>
    </node>
    <node id="SWALLOWING EVALUATION">
      <data key="d0">EVENT</data>
      <data key="d1">Swallowing evaluation is a process that assesses the patient's ability to swallow safely and effectively, often involving various textures and volumes of food.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1261</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">428</data>
      <data key="d7">fcb3c90a3b1e4f4bb6daeb7c0812755d</data>
    </node>
    <node id="TEXTURE N&#201;CTAR">
      <data key="d0">EVENT</data>
      <data key="d1">Nectar is a type of food consistency used in swallowing evaluations, characterized as an intermediate consistency.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1261</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">429</data>
      <data key="d7">ec9bcfca5dc547b8bc69a8f4042a7c2f</data>
    </node>
    <node id="PUDDING">
      <data key="d0">EVENT</data>
      <data key="d1">Pudding is a type of food consistency used in swallowing evaluations, characterized as a high consistency.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1261</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">430</data>
      <data key="d7">0c8ed0f1ef064f94b1e0af807bc19395</data>
    </node>
    <node id="LIQUID">
      <data key="d0">EVENT</data>
      <data key="d1">Liquid is a type of food consistency used in swallowing evaluations, characterized as a thin consistency.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1261</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">431</data>
      <data key="d7">daedd16d54414ec89934c8ea1b662042</data>
    </node>
    <node id="SOLID FOOD">
      <data key="d0">EVENT</data>
      <data key="d1">Solid food is a type of food consistency that is evaluated during swallowing assessments, requiring competent dentition for safe consumption.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1261</data>
      <data key="d4">2</data>
