      <data key="d0">EVENT</data>
      <data key="d1">Inserci&#243;n en yeyuno de dispositivo de alimentaci&#243;n is a method for placing a feeding device into the jejunum for direct nutritional support.</data>
      <data key="d2">2a387a0f62fd64b31ecf55b1538932c2</data>
      <data key="d3">1103</data>
