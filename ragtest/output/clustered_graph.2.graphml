    <node id="ELECTROMYOGRAPHY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Electromyography is a diagnostic tool that can be useful in assessing abdominal wall function in patients with rumination syndrome.</data>
      <data key="d2">44d6374ee887ebef4cba5ec2a31f0673</data>
