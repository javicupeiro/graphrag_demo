      <data key="d6">11282</data>
      <data key="d7">e86204f13efd489f973a077e679af64a</data>
    </node>
    <node id="PROLONGACI&#211;N DEL INTERVALO QT">
      <data key="d0">EVENT</data>
      <data key="d1">Prolongaci&#243;n del intervalo QT is a cardiac rhythm disorder observed in some children on a ketogenic diet.</data>
      <data key="d2">bf7fc15e1aac41553dc6586efe68b8cb</data>
      <data key="d5">0</data>
      <data key="d6">11283</data>
