    <node id="COAGULOPAT&#205;A">
      <data key="d0">EVENT</data>
      <data key="d1">La coagulopat&#237;a es una condici&#243;n m&#233;dica que puede influir en la elecci&#243;n del acceso venoso para la nutrici&#243;n parenteral.</data>
      <data key="d2">538970e30e9d0e758546ca1a3cf5a205</data>
