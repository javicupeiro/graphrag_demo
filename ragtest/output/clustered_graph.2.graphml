      <data key="d12">143</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DISFAGIA OROFAR&#205;NGEA" target="MOVIMIENTO HIOIDEO">
      <data key="d8">7.0</data>
      <data key="d9">Hyoid movement is affected in oropharyngeal dysphagia, impacting swallowing safety</data>
