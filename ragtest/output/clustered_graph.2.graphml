    <edge source="ASOCIACI&#211;N ESPA&#209;OLA DE CEL&#205;ACOS" target="DIETA SIN GLUTEN">
      <data key="d8">7.0</data>
      <data key="d9">The Asociaci&#243;n Espa&#241;ola de Cel&#237;acos authorizes foods that are suitable for a gluten-free diet for patients with celiac disease.</data>
      <data key="d10">8a7b2d5e0440750e36603c8d3f93a68a</data>
