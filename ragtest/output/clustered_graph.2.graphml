      <data key="d8">6.0</data>
      <data key="d9">El grupo europeo sobre la orbitopat&#237;a de Graves proporciona directrices sobre el manejo de la oftalmopat&#237;a de Graves.</data>
      <data key="d10">4c18507e3d98242cdbcddd1a1997b92f</data>
      <data key="d11">05300a322f974b03b2ccb7419e0b6a7d</data>
      <data key="d12">13680</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OFTALMOPAT&#205;A DE GRAVES" target="BAHN RS">
      <data key="d8">5.0</data>
      <data key="d9">Bahn RS ha escrito sobre la oftalmopat&#237;a de Graves, contribuyendo a su comprensi&#243;n m&#233;dica.</data>
      <data key="d10">4c18507e3d98242cdbcddd1a1997b92f</data>
      <data key="d11">e3870454ab41482cba47424fbc2ef1c0</data>
      <data key="d12">13681</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OFTALMOPAT&#205;A DE GRAVES" target="KAHALY GJ">
      <data key="d8">1.0</data>
      <data key="d9">Kahaly GJ ha realizado investigaciones sobre el tratamiento de la oftalmopat&#237;a de Graves, aportando a su manejo cl&#237;nico.</data>
      <data key="d10">4c18507e3d98242cdbcddd1a1997b92f</data>
      <data key="d11">8d2cd993926d46399c7bda169b0a321c</data>
      <data key="d12">13682</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERTIROIDISMO" target="MANDEL SJ">
      <data key="d8">5.0</data>
      <data key="d9">Mandel SJ ha escrito sobre el hipertiroidismo en textos m&#233;dicos, contribuyendo a su diagn&#243;stico y tratamiento.</data>
      <data key="d10">4c18507e3d98242cdbcddd1a1997b92f</data>
      <data key="d11">5800ad7461b149a4820c7097ee564109</data>
      <data key="d12">13683</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERTIROIDISMO" target="GRAVES">
      <data key="d8">17.0</data>
      <data key="d9">Graves' disease, known as "enfermedad de Graves" in Spanish, is a prevalent cause of hyperthyroidism, characterized by autoimmune stimulation of the thyroid gland. This condition leads to the excessive production of thyroid hormones, resulting in various metabolic disturbances associated with hyperthyroidism.</data>
      <data key="d10">4c18507e3d98242cdbcddd1a1997b92f,cca243547034544596d9409f2643eac0</data>
      <data key="d11">ada7f0b5d05a4602bdc6b825160065bf</data>
      <data key="d12">13684</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERTIROIDISMO" target="TIROIDITIS DESTRUCTIVA">
      <data key="d8">7.0</data>
      <data key="d9">Tiroiditis destructiva can lead to hyperthyroidism due to the release of stored hormones rather than increased synthesis.</data>
      <data key="d10">cca243547034544596d9409f2643eac0</data>
      <data key="d11">0cf4761713374911a0dd46d99e383a92</data>
      <data key="d12">13685</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERTIROIDISMO" target="SHBG">
      <data key="d8">6.0</data>
      <data key="d9">Hipertiroidismo can increase SHBG levels, influencing testosterone availability</data>
      <data key="d10">4beab004731d7baff10fd2796a523b55</data>
      <data key="d11">d8b33cbf9d7f4bc49c7df3dcb819538b</data>
      <data key="d12">13686</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERTIROIDISMO" target="NIVOLUMAB">
      <data key="d8">6.0</data>
      <data key="d9">Nivolumab can cause hyperthyroidism as an adverse effect</data>
      <data key="d10">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d11">00389c12cd0642e9b4311eff10d93895</data>
      <data key="d12">13687</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERTIROIDISMO" target="DIARREA CR&#211;NICA">
      <data key="d8">5.0</data>
      <data key="d9">El hipertiroidismo puede ser un factor que cause diarrea cr&#243;nica</data>
      <data key="d10">449c8567a3aa59b49fbe65b7a3a26d46</data>
      <data key="d11">410874207e0d45adb9227ec68b96b34d</data>
      <data key="d12">13688</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN GROUP ON GRAVES' ORBITOPATHY" target="BARTALENA L">
      <data key="d8">7.0</data>
      <data key="d9">Bartalena L is a member of the European group on Graves' orbitopathy and has contributed to its research</data>
      <data key="d10">3c8b29df4105e84d4766d8d632de8535</data>
      <data key="d11">f3f89aab2f8c47ec990a87556a832709</data>
      <data key="d12">13689</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN GROUP ON GRAVES' ORBITOPATHY" target="PINCHERA A">
      <data key="d8">7.0</data>
      <data key="d9">Pinchera A is a member of the European group on Graves' orbitopathy and has contributed to its research</data>
      <data key="d10">3c8b29df4105e84d4766d8d632de8535</data>
      <data key="d11">9b69d27985a6464396930fc4cc671fae</data>
      <data key="d12">13690</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN GROUP ON GRAVES' ORBITOPATHY" target="MARCOCCI C">
      <data key="d8">7.0</data>
      <data key="d9">Marcocci C is a member of the European group on Graves' orbitopathy and has contributed to its research</data>
      <data key="d10">3c8b29df4105e84d4766d8d632de8535</data>
      <data key="d11">a80700a86c4b4c4a8580aa481e069177</data>
      <data key="d12">13691</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN GROUP ON GRAVES' ORBITOPATHY" target="HEGEDUS L">
      <data key="d8">7.0</data>
      <data key="d9">Hegedus L is a member of the European group on Graves' orbitopathy and has contributed to its research</data>
      <data key="d10">3c8b29df4105e84d4766d8d632de8535</data>
      <data key="d11">1a8d271b357a44438c65068da2843630</data>
      <data key="d12">13692</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN GROUP ON GRAVES' ORBITOPATHY" target="THYROID">
      <data key="d8">1.0</data>
      <data key="d9">The European group on Graves' orbitopathy publishes research in the Thyroid journal</data>
      <data key="d10">3c8b29df4105e84d4766d8d632de8535</data>
      <data key="d11">d2c917b5de604fdcbe10a9acd713e559</data>
      <data key="d12">13693</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANDEL SJ" target="AMERICAN THYROID ASSOCIATION">
      <data key="d8">14.0</data>
      <data key="d9">Mandel SJ is a significant contributor to the American Thyroid Association, having played a key role in the development of the Management Guidelines for Adult Patients with Thyroid Nodules and Differentiated Thyroid Cancer. As an author of these guidelines, Mandel SJ has helped shape the standards and recommendations for the management of these conditions, reflecting a commitment to advancing the field of thyroid health.</data>
      <data key="d10">17db9c3996d806c3332ba2796ab7736f,a4e97817eb89c3941a890d94f5359369</data>
      <data key="d11">2864e822fae74af5ad17b92dd6a342a8</data>
      <data key="d12">13694</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRAVES" target="BERTALENA L">
      <data key="d8">1.0</data>
      <data key="d9">Bertalena L has conducted research related to the management and understanding of Graves' disease and its complications.</data>
      <data key="d10">cca243547034544596d9409f2643eac0</data>
      <data key="d11">a22f49e89bff4cf4afb03b8e31a083d8</data>
      <data key="d12">13695</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRAVES" target="H&#193;BITO TAB&#193;QUICO">
      <data key="d8">8.0</data>
      <data key="d9">The habit of smoking is associated with an increased risk of developing Graves' ophthalmopathy and can worsen its severity.</data>
      <data key="d10">cca243547034544596d9409f2643eac0</data>
      <data key="d11">2329c849a3824c019c98dfa26d090294</data>
      <data key="d12">13696</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRAVES" target="RECEPTORES DE TSH">
      <data key="d8">9.0</data>
      <data key="d9">The expression of TSH receptors is involved in the autoimmune response seen in Graves' disease, leading to hyperthyroidism.</data>
      <data key="d10">cca243547034544596d9409f2643eac0</data>
      <data key="d11">337285a27ecf413899505b1c1b08271a</data>
      <data key="d12">13697</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRAVES" target="FIBROSIS DE LA MUSCULATURA OCULAR">
      <data key="d8">1.0</data>
      <data key="d9">Fibrosis de la musculatura ocular can occur as a complication of Graves' ophthalmopathy, affecting eye movement and appearance.</data>
      <data key="d10">cca243547034544596d9409f2643eac0</data>
      <data key="d11">07339d60d8964b569544957effc3fd63</data>
      <data key="d12">13698</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMIODARONE" target="THYROID DISEASE">
      <data key="d8">8.0</data>
      <data key="d9">Amiodarone can cause thyroid dysfunction, leading to conditions such as hypothyroidism and hyperthyroidism</data>
      <data key="d10">0d78e460e4fb4a82bb6e11496f7d5aed</data>
      <data key="d11">9cc853ff5006414cadafdcf4ab123dad</data>
      <data key="d12">13699</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMIODARONE" target="HYPERTIROIDISM">
      <data key="d8">15.0</data>
      <data key="d9">Amiodarone is a medication that can induce hyperthyroidism as a side effect of its use. This means that while amiodarone is primarily used for its therapeutic effects, it may also lead to an overactive thyroid condition in some patients.</data>
      <data key="d10">0d78e460e4fb4a82bb6e11496f7d5aed,45213238a7d4c834b6db62ef71dcda43</data>
      <data key="d11">c6b13629a37d48229e988c3e7fd0beeb</data>
      <data key="d12">13700</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMIODARONE" target="TIROCYTE">
      <data key="d8">9.0</data>
      <data key="d9">Amiodarone has direct cytotoxic effects on tirocytes, leading to thyroid dysfunction</data>
      <data key="d10">0d78e460e4fb4a82bb6e11496f7d5aed</data>
      <data key="d11">44c39879e59b4238b619f0635e3cec35</data>
      <data key="d12">13701</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SHBG" target="RHT">
      <data key="d8">1.0</data>
      <data key="d9">SHBG levels are used as a marker to differentiate between TSHomas and RHT in clinical evaluations.</data>
      <data key="d10">39cdf983b8de558536d2d829978daba1</data>
      <data key="d11">a621fef1fd544f208868e52f705122be</data>
      <data key="d12">13702</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SHBG" target="VIH">
      <data key="d8">7.0</data>
      <data key="d9">SHBG levels can be affected by HIV, influencing testosterone levels in infected individuals</data>
      <data key="d10">4beab004731d7baff10fd2796a523b55</data>
      <data key="d11">c1da8eec7e4f4b5aab693544f85f462a</data>
      <data key="d12">13703</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SHBG" target="ESTEROIDES ANDROG&#201;NICOS">
      <data key="d8">6.0</data>
      <data key="d9">Esteroides androg&#233;nicos can influence SHBG levels and testosterone availability</data>
      <data key="d10">4beab004731d7baff10fd2796a523b55</data>
      <data key="d11">a0b8e0a3a5dd4e2490323a6cd708fe15</data>
      <data key="d12">13704</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FERRITINA" target="ANEMIA FERROP&#201;NICA">
      <data key="d8">8.0</data>
      <data key="d9">Ferritina is crucial for diagnosing and managing anemia ferrop&#233;nica as it indicates the body's iron stores</data>
      <data key="d10">79435b6ab45648695f4a36f31b7fb458</data>
      <data key="d11">4a35b42e1c3d4e34bf6bc6ea459d3325</data>
      <data key="d12">13705</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FERRITINA" target="SOBRECARGA F&#201;RRICA">
      <data key="d8">8.0</data>
