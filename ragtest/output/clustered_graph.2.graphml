      <data key="d7">8b1e59b916074b48bbc630dbe42a1c93</data>
    </node>
    <node id="MEG3">
      <data key="d0">PERSON</data>
      <data key="d1">MEG3 es otro inhibidor de la proliferaci&#243;n implicado en la patogenia de los adenomas hipofisarios.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1323</data>
      <data key="d4">2</data>
