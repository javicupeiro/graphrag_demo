      <data key="d6">14867</data>
      <data key="d7">5639f98fdf7e4894b7c0113b9ce09201</data>
    </node>
    <node id="CAT&#201;TER DE INSERCI&#211;N CENTRAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Central insertion catheters are used for accessing the superior vena cava and have specific indications and complications.</data>
      <data key="d2">67344d72dff60fcb903b258fbca95de5</data>
      <data key="d5">0</data>
      <data key="d6">14868</data>
