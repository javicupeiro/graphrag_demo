    <node id="UVI MOVIL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Mobile Intensive Care Unit (UVI Movil) is a medical unit that provides emergency care and transport for critically ill patients.</data>
      <data key="d2">fec130428af4ee62996a9b72494212dc</data>
