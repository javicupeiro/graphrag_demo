    <node id="ACS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The American Cancer Society (ACS) is an organization focused on cancer research and prevention strategies.</data>
      <data key="d2">67d484d5c0c84fff32782bd773c0fd7a</data>
      <data key="d3">1208</data>
