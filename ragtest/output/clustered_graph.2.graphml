    <edge source="NUTRIENTES" target="VITAMINA K">
      <data key="d8">8.0</data>
      <data key="d9">Vitamin K is a critical nutrient for newborns to prevent hemorrhagic disease, as emphasized in infant nutrition recommendations.</data>
      <data key="d10">2a1b909c98067bf7fc270d6f30199f96</data>
      <data key="d11">3bf205df3fbb4582b672d057a8d984f2</data>
