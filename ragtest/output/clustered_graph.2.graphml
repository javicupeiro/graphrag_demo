      <data key="d5">3</data>
      <data key="d6">11382</data>
      <data key="d7">cca965783a7d42228108379b20621694</data>
    </node>
    <node id="ALIMENTOS INTEGRALES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Alimentos integrales are whole foods that are generally high in potassium and phosphorus, which should be avoided by patients on a restricted diet.</data>
      <data key="d2">d87b6185e9826c5338c079056e2019a9</data>
      <data key="d3">624</data>
      <data key="d4">2</data>
