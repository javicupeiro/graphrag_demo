      <data key="d11">c6b0aacb433b4acd92d1c800b051e2d7</data>
      <data key="d12">11389</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HOSPITALIZATION" target="ENHANCED RECOVERY AFTER SURGERY">
      <data key="d8">8.0</data>
