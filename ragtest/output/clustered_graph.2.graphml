    </edge>
    <edge source="C&#193;NCER DE CABEZA Y CUELLO" target="PACIENTE ONCOL&#211;GICO">
      <data key="d8">7.0</data>
      <data key="d9">Los pacientes oncol&#243;gicos con c&#225;ncer de cabeza y cuello pueden experimentar disfagia y requieren soporte nutricional</data>
      <data key="d10">40dcfaa6144c6424068ba46fdf288dd2</data>
      <data key="d11">4905616a16ef4fa48c90cbc873188042</data>
