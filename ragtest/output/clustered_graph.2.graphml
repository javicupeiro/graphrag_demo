      <data key="d6">7343</data>
      <data key="d7">43ec20f16bb3424e9227231f529a0928</data>
    </node>
    <node id="CANCER OF THE COLON">
      <data key="d0">EVENT</data>
      <data key="d1">Colon cancer is a type of cancer that affects the large intestine, and higher adherence to the Mediterranean diet has been associated with a lower incidence of this disease.</data>
      <data key="d2">c9a02c0d93ca431827b63d51ae564670</data>
      <data key="d3">1637</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">7344</data>
      <data key="d7">43d2a82bef7b4111b0bdbee439e8b602</data>
    </node>
    <node id="CANCER OF THE LUNG">
      <data key="d0">EVENT</data>
      <data key="d1">Lung cancer is a type of cancer that begins in the lungs, and studies suggest that adherence to the Mediterranean diet may lower its incidence.</data>
      <data key="d2">c9a02c0d93ca431827b63d51ae564670</data>
      <data key="d3">1637</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">7345</data>
      <data key="d7">3520f3824998400eb30dc82276de976f</data>
    </node>
    <node id="PREDIMED DIABETES">
      <data key="d0">EVENT</data>
      <data key="d1">PREDIMED Diabetes is a study that demonstrated the benefits of adherence to a Mediterranean diet in reducing the risk of type 2 diabetes in older adults with high cardiometabolic risk.</data>
      <data key="d2">72d0be9d03c79097f867a8af2e3e89e4</data>
      <data key="d3">646</data>
      <data key="d4">2</data>
