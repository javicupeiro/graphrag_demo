      <data key="d8">7.0</data>
      <data key="d9">SEMICYUC provides guidelines for the use of enteral nutrition in critically ill patients</data>
      <data key="d10">7e539a13a598e4ff2d2d4d6641a044d5</data>
      <data key="d11">68ae92d3396248f9a41d9a1feb6b8099</data>
      <data key="d12">2762</data>
      <data key="d13">2</data>
    </edge>
