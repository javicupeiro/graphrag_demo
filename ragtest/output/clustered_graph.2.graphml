    </node>
    <node id="CARBAMAZEPINA">
      <data key="d0">PERSON</data>
      <data key="d1">Carbamazepina is a medication that is known to have its metabolism influenced by alcohol, which can result in altered effects when both substances are present. To minimize gastrointestinal discomfort, it is recommended that Carbamazepina be taken with meals.</data>
      <data key="d2">04f886244ff7d736eb270f175d6b120e,4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">0</data>
      <data key="d6">14247</data>
      <data key="d7">366293b8188e480790983683ceae849f</data>
    </node>
    <node id="QUINIDINA">
      <data key="d0">PERSON</data>
      <data key="d1">Quinidina is a medication that can have its effects altered by alcohol consumption.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">0</data>
      <data key="d6">14248</data>
      <data key="d7">1855baaf375a4487b9a7474836a716aa</data>
    </node>
    <node id="MACROLIDOS">
      <data key="d0">PERSON</data>
      <data key="d1">Macrolidos are antibiotics that can have their hepatotoxic effects enhanced by alcohol.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">0</data>
      <data key="d6">14249</data>
      <data key="d7">6df2284f88e2484f8fec8794642e6d12</data>
    </node>
