    <node id="COENZYME Q 10">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Coenzyme Q 10 is an antioxidant and a vital component of the mitochondrial respiratory chain, evaluated for its effects in mitochondrial diseases.</data>
      <data key="d2">b8db8cc3349b8ac0cce45497da6244fc</data>
