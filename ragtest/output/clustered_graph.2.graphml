    </edge>
    <edge source="DIABETES MELLITUS" target="TUMOR PANCRE&#193;TICO">
      <data key="d8">8.0</data>
      <data key="d9">Pancreatic tumors can lead to diabetes mellitus due to the destruction of insulin-producing cells in the pancreas.</data>
      <data key="d10">c55f34a09dbf07224c85384f08173e27</data>
      <data key="d11">92f35c3e02cb4bfda761288efb598d74</data>
      <data key="d12">1565</data>
      <data key="d13">2</data>
    </edge>
