    </node>
    <node id="DIAMINOXIDASA">
      <data key="d0">PERSON</data>
      <data key="d1">La diaminooxidasa (DAO) es una enzima que descompone la histamina en el cuerpo y su actividad puede ser insuficiente en personas con alergias alimentarias.</data>
