      <data key="d10">c6406ac5c0c7b03d4ee61ca311fd783f</data>
      <data key="d11">050983c6cd974617b81de87251dd6812</data>
      <data key="d12">6856</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="DI&#193;LISIS">
      <data key="d8">9.0</data>
      <data key="d9">La di&#225;lisis es un tratamiento necesario para pacientes con insuficiencia renal, ayudando a eliminar toxinas del cuerpo</data>
      <data key="d10">a87e8e113488b153c5b4b2d2fca712c0</data>
      <data key="d11">67f68a031de946028505ccdfb4713132</data>
      <data key="d12">6857</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="NFK-DOQI">
      <data key="d8">1.0</data>
      <data key="d9">NFK-DOQI proporciona recomendaciones para el tratamiento y manejo de la insuficiencia renal, incluyendo aspectos nutricionales</data>
      <data key="d10">a87e8e113488b153c5b4b2d2fca712c0</data>
      <data key="d11">c37c0b274b304f47b09bdfc9811035da</data>
      <data key="d12">6858</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="MALNUTRICI&#211;N">
      <data key="d8">9.0</data>
      <data key="d9">La insuficiencia renal puede llevar a la malnutrici&#243;n debido a la ingesta inadecuada de nutrientes y otros factores</data>
      <data key="d10">a87e8e113488b153c5b4b2d2fca712c0</data>
      <data key="d11">7e7e353ae6994e5eb0078bc25a1fd3be</data>
      <data key="d12">6859</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="ACIDOSIS METAB&#211;LICA">
      <data key="d8">6.0</data>
      <data key="d9">La acidosis metab&#243;lica es una complicaci&#243;n que puede surgir en pacientes con insuficiencia renal, afectando su estado nutricional</data>
      <data key="d10">a87e8e113488b153c5b4b2d2fca712c0</data>
      <data key="d11">7a9258ff8b7c4b2f9056c811651daf87</data>
      <data key="d12">6860</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="HIPOALBUMINEMIA">
      <data key="d8">6.0</data>
      <data key="d9">La hipoalbuminemia es una condici&#243;n que puede desarrollarse en pacientes con insuficiencia renal, relacionada con la malnutrici&#243;n</data>
      <data key="d10">a87e8e113488b153c5b4b2d2fca712c0</data>
      <data key="d11">c3d11a1356b24303826b4802d453ede4</data>
      <data key="d12">6861</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="HIPERPARATIROIDISMO">
      <data key="d8">5.0</data>
      <data key="d9">El hiperparatiroidismo puede ser una complicaci&#243;n en pacientes con insuficiencia renal, afectando su nutrici&#243;n</data>
      <data key="d10">a87e8e113488b153c5b4b2d2fca712c0</data>
      <data key="d11">d421b4f620c745188eb41e5782fd9e55</data>
      <data key="d12">6862</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="DI&#193;LISIS PERITONEAL">
      <data key="d8">10.0</data>
      <data key="d9">Insuficiencia renal, a condition characterized by the kidneys' inability to effectively filter waste from the blood, can be managed through various treatment options. One such option is di&#225;lisis peritoneal, which is specifically utilized for patients suffering from this condition. Di&#225;lisis peritoneal serves to eliminate waste products from the body, providing an alternative method of treatment for those with insuficiencia renal.</data>
      <data key="d10">541c13a95526e4d68903f0901042f292,a87e8e113488b153c5b4b2d2fca712c0</data>
      <data key="d11">ff4d6c487ddf4f6c9685fbd3b272467c</data>
      <data key="d12">6863</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="HEMODI&#193;LISIS">
      <data key="d8">15.0</data>
      <data key="d9">Insuficiencia renal, or renal insufficiency, is a medical condition that affects the kidneys' ability to function properly. Hemodi&#225;lisis, or hemodialysis, is a treatment method specifically designed for patients suffering from this condition. It is particularly crucial for individuals experiencing acute renal failure, as they often require hemodialysis to manage their health. This treatment not only addresses the immediate needs of the kidneys but also significantly impacts the nutritional requirements of the patients undergoing the procedure.</data>
      <data key="d10">2cc103269ed63bac1a1b5cb76eab1916,541c13a95526e4d68903f0901042f292</data>
      <data key="d11">a69f3c075e4c4f34a1601ea882f8b802</data>
      <data key="d12">6864</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="MALNUTRICI&#211;N CAL&#211;RICO-PROTEICA">
      <data key="d8">8.0</data>
      <data key="d9">La malnutrici&#243;n cal&#243;rico-proteica es una consecuencia del fracaso de la funci&#243;n renal</data>
      <data key="d10">e321db63d9b561eb98a4f01853b141ad</data>
      <data key="d11">49f94f209a3c48fba1182c5c3451b16d</data>
      <data key="d12">6865</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="HIPERTENSI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">La hipertensi&#243;n es una condici&#243;n que puede estar presente en pacientes con insuficiencia renal</data>
      <data key="d10">e321db63d9b561eb98a4f01853b141ad</data>
      <data key="d11">2460e68d8bc1479fa90e32c22dbd1d19</data>
      <data key="d12">6866</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="RECOMENDACIONES DIET&#201;TICAS">
      <data key="d8">1.0</data>
      <data key="d9">Las recomendaciones diet&#233;ticas son cruciales para el manejo de la insuficiencia renal cr&#243;nica</data>
      <data key="d10">e321db63d9b561eb98a4f01853b141ad</data>
      <data key="d11">00cb0f75e0a4438ba6ec5ec2407f79d9</data>
      <data key="d12">6867</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="DIETA HIPOS&#211;DICA">
      <data key="d8">8.0</data>
      <data key="d9">La insuficiencia renal puede complicar el seguimiento de una dieta hipos&#243;dica, ya que estos pacientes tienen un riesgo mayor de complicaciones</data>
      <data key="d10">9de04e5aa72249acf96899ca74c17e0b</data>
      <data key="d11">e3dc8c534d074d7da3f8a569292c1b6f</data>
      <data key="d12">6868</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="HIPERURICEMIA">
      <data key="d8">9.0</data>
      <data key="d9">Hiperuricemia can lead to renal insufficiency due to the accumulation of uric acid in the kidneys.</data>
      <data key="d10">1ad59ffc3e39719e331a017fe64cd07d</data>
      <data key="d11">555ce377ebe442daa929f0d65ced0a51</data>
      <data key="d12">6869</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="ASPEN 7">
      <data key="d8">8.0</data>
      <data key="d9">ASPEN 7 outlines nutritional strategies for patients with acute renal failure</data>
      <data key="d10">2cc103269ed63bac1a1b5cb76eab1916</data>
      <data key="d11">6456a1ef4fdc46a9a38c99c19de994a2</data>
      <data key="d12">6870</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="TERAPIA DE REEMPLAZO RENAL CONTINUA">
      <data key="d8">1.0</data>
      <data key="d9">Continuous renal replacement therapy is a treatment option for patients with acute renal failure, affecting their nutritional management</data>
      <data key="d10">2cc103269ed63bac1a1b5cb76eab1916</data>
      <data key="d11">59db021d94674686870686c48f199fa3</data>
      <data key="d12">6871</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="C&#193;NCER">
      <data key="d8">1.0</data>
      <data key="d9">La insuficiencia renal afecta las recomendaciones de ingesta proteica en pacientes con c&#225;ncer</data>
      <data key="d10">f7871bbaa57d50bb5f5675cd580cb0af</data>
      <data key="d11">2c66c160a558492fbf0a252a3f1ec1bd</data>
      <data key="d12">6872</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="NECESIDADES DE LIQUIDOS">
      <data key="d8">1.0</data>
      <data key="d9">La insuficiencia renal puede influir en los requerimientos h&#237;dricos de un paciente pedi&#225;trico.</data>
      <data key="d10">79dc467f42c611bc9f285c95a6c6ff62</data>
      <data key="d11">dcc8ad3363624a93ba1150d84e987e6b</data>
      <data key="d12">6873</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="NEPRO HP">
      <data key="d8">8.0</data>
      <data key="d9">Nepro HP is specifically formulated to support patients with renal insufficiency</data>
      <data key="d10">ceea9bf255384db1726c76c13ce560c8</data>
      <data key="d11">83daaafaf86247fc9c24359b48266d23</data>
      <data key="d12">6874</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="INTESTAMIN">
      <data key="d8">4.0</data>
      <data key="d9">Intestamin is designed for immunomodulatory purposes, which can be relevant for patients with renal insufficiency</data>
      <data key="d10">ceea9bf255384db1726c76c13ce560c8</data>
      <data key="d11">4af313848da64c6a91914c29cf199857</data>
      <data key="d12">6875</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="NUTRICION">
      <data key="d8">4.0</data>
      <data key="d9">Nutrison Advanced Cubison is designed to provide dietary support, which can be relevant for patients with renal insufficiency</data>
      <data key="d10">ceea9bf255384db1726c76c13ce560c8</data>
      <data key="d11">14c0c91d4fae480ea9cad6153eeffb67</data>
      <data key="d12">6876</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="SUPPORTAN">
      <data key="d8">1.0</data>
      <data key="d9">Supportan is designed for dietary support, which can be relevant for patients with renal insufficiency</data>
      <data key="d10">ceea9bf255384db1726c76c13ce560c8</data>
      <data key="d11">9565d7861a164e5cbcda31a5b829ae41</data>
      <data key="d12">6877</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="FALLO ORG&#193;NICO PERSISTENTE">
      <data key="d8">8.0</data>
      <data key="d9">Persistent organ failure is a serious complication that can arise from pancreatitis aguda</data>
      <data key="d10">9890cc3f628030fc8c4666d15e6b0259</data>
      <data key="d11">823fd1fd1efa47428972424f025ef3fd</data>
      <data key="d12">6878</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="S&#205;NDROME DE RESPUESTA INFLAMATORIA SIST&#201;MICA">
      <data key="d8">23.0</data>
      <data key="d9">Acute pancreatitis is a condition that can lead to the development of systemic inflammatory response syndrome (SIRS). The severe inflammation of the pancreas associated with acute pancreatitis can trigger this systemic response, complicating the patient's overall condition. As a result, SIRS may arise as a consequence of severe acute pancreatitis, highlighting the interconnectedness of these two medical issues.</data>
      <data key="d10">71df6da8c96a533357f4380fd6066417,9890cc3f628030fc8c4666d15e6b0259,f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d11">b779891157d74df494ff0633785f5196</data>
      <data key="d12">6879</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="NECESIDAD DE CIRUG&#205;A DE URGENCIA">
      <data key="d8">7.0</data>
      <data key="d9">Severe cases of pancreatitis aguda may necessitate urgent surgical intervention</data>
      <data key="d10">9890cc3f628030fc8c4666d15e6b0259</data>
      <data key="d11">3587e922202f4116bf10a3a5c480c171</data>
      <data key="d12">6880</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HOSPITAL UNIVERSITARI I POLIT&#200;CNIC LA FE">
      <data key="d8">8.0</data>
      <data key="d9">The hospital provides treatment and management for patients suffering from acute pancreatitis</data>
      <data key="d10">6a12bee5b54e4c1706548bca972516e3</data>
      <data key="d11">cdab1b73327548e8870d27b4313217e0</data>
      <data key="d12">6881</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="GLUCOSA">
      <data key="d8">7.0</data>
      <data key="d9">Glucose is administered to manage hyperglycemia in patients with acute pancreatitis.</data>
      <data key="d10">57ec3d3d82d22e19c09ea2b735ef7779</data>
      <data key="d11">c0029c55579c4d8f9e23525cfb43cd8e</data>
      <data key="d12">6882</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="INSULINA">
      <data key="d8">8.0</data>
      <data key="d9">Insulin is used to control blood glucose levels in patients suffering from acute pancreatitis.</data>
      <data key="d10">57ec3d3d82d22e19c09ea2b735ef7779</data>
      <data key="d11">af1ea7a7c9114869ac0340220fb57632</data>
      <data key="d12">6883</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HOSPITAL UNIVERSITARIO DE TORREC&#193;RDENAS">
      <data key="d8">8.0</data>
      <data key="d9">The patient experienced acute pancreatitis while being treated at the Hospital Universitario de Torrec&#225;rdenas.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">e0d12833bc9c44779172889bd064cb92</data>
      <data key="d12">6884</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="NEOPLASIA INTRADUCTAL PAPILAR MUCINOSA">
      <data key="d8">6.0</data>
      <data key="d9">The patient developed neoplasia intraductal papilar mucinosa following an episode of acute pancreatitis.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">d292ee1f7006492782a8ff3804413b48</data>
      <data key="d12">6885</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="VAR&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">The 60-year-old male patient had a history of acute pancreatitis prior to his surgery.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">7d3fd600577e4e49b21860cc7b732f49</data>
      <data key="d12">6886</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="DUODENOPANCREATECTOM&#205;A SUBTOTAL">
      <data key="d8">6.0</data>
      <data key="d9">The subtotal duodenopancreatectomy was performed following the patient's acute pancreatitis episode.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">4c7af9ae800e4e76bd36c9ab9ffa72d7</data>
      <data key="d12">6887</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HEMODI&#193;LISIS">
      <data key="d8">6.0</data>
      <data key="d9">The patient required hemodialysis as a result of acute pancreatitis complications.</data>
      <data key="d10">a633c156fb0077e3f669d8eb258be944</data>
      <data key="d11">91ed3aca205543c185f16eb1a8e40899</data>
      <data key="d12">6888</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="RANSON CRITERIA">
      <data key="d8">7.0</data>
      <data key="d9">The Ranson criteria are used to evaluate the severity of acute pancreatitis</data>
      <data key="d10">57d361381e6ea4ddbc948891f9645009</data>
      <data key="d11">e6f94970d2da4ec885d7b30280e54849</data>
      <data key="d12">6889</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="APACHE SCORE">
      <data key="d8">7.0</data>
      <data key="d9">The APACHE score is utilized to assess the severity of acute pancreatitis in patients</data>
      <data key="d10">57d361381e6ea4ddbc948891f9645009</data>
      <data key="d11">7eaa6aee4dfb4d28a0500eb1da92b5fd</data>
      <data key="d12">6890</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HIPERGLUCEMIA">
      <data key="d8">7.0</data>
      <data key="d9">La hiperglucemia es una complicaci&#243;n com&#250;n en pacientes con pancreatitis aguda, afectando su tratamiento</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">9fd7187cd26a47eb8406e55224250dd1</data>
      <data key="d12">6891</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="REPOSO PANCRE&#193;TICO">
      <data key="d8">5.0</data>
      <data key="d9">El reposo pancre&#225;tico ha sido considerado como una estrategia en el tratamiento de la pancreatitis aguda, aunque su eficacia es debatida</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">a4ea1f3fca944fd292a8513ef748aac4</data>
      <data key="d12">6892</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="NUTRICI&#211;N ORAL">
      <data key="d8">1.0</data>
      <data key="d9">La nutrici&#243;n oral puede ser dif&#237;cil de implementar en pacientes con pancreatitis aguda, especialmente en casos graves</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">4300960b3e40467a870e2c7b162235f3</data>
      <data key="d12">6893</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="LITIASIS BILIAR">
      <data key="d8">17.0</data>
      <data key="d9">Acute pancreatitis is often associated with biliary lithiasis, which is recognized as a leading cause of this condition. The presence of gallstones can trigger an inflammatory response in the pancreas, leading to the development of acute pancreatitis. In fact, biliary lithiasis is one of the most common contributors to this disease, highlighting its significant role in the pathophysiology of acute pancreatitis.</data>
      <data key="d10">71df6da8c96a533357f4380fd6066417,88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">f697f6a4ea614a24bd3dd69fa8381030</data>
      <data key="d12">6894</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CONSUMO EXCESIVO DE ALCOHOL">
      <data key="d8">8.0</data>
      <data key="d9">El consumo excesivo de alcohol es una de las principales etiolog&#237;as de la pancreatitis aguda</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">ae0d069dd54e4769964635e1f2b2ddc4</data>
      <data key="d12">6895</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="FALLO ORG&#193;NICO">
      <data key="d8">18.0</data>
      <data key="d9">Pancreatitis aguda es una condici&#243;n m&#233;dica que puede dar lugar a complicaciones severas, entre las cuales se destaca el fallo org&#225;nico. Este fallo org&#225;nico se presenta como una complicaci&#243;n grave en pacientes que sufren de pancreatitis aguda, y su aparici&#243;n est&#225; asociada con un aumento en la mortalidad de estos pacientes. Por lo tanto, es crucial monitorear y manejar adecuadamente la pancreatitis aguda para prevenir el desarrollo de fallo org&#225;nico y sus consecuencias potencialmente fatales.</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e,caf14765027dbf6266841af0571a522e</data>
      <data key="d11">711dbba39f23433c96ae2fa593ab3168</data>
      <data key="d12">6896</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CITOCINAS">
      <data key="d8">7.0</data>
      <data key="d9">Las citocinas se liberan durante la pancreatitis aguda y contribuyen al da&#241;o tisular y a la respuesta inflamatoria</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">538b00adfb9e4cedb9ffee0cb1b8d6e5</data>
      <data key="d12">6897</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CATABOLISMO">
      <data key="d8">8.0</data>
      <data key="d9">El catabolismo se ve incrementado en pacientes con pancreatitis aguda, afectando su estado nutricional</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">ac2253d0dcd14d3f97d217f405b300af</data>
      <data key="d12">6898</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HIDROELECTROL&#205;TICOS">
      <data key="d8">7.0</data>
      <data key="d9">Los desequilibrios hidroelectrol&#237;ticos son comunes en pacientes con pancreatitis aguda, complicando su tratamiento</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">24ac124f31124da59b52e4e56050b13c</data>
      <data key="d12">6899</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="NECROSIS DEL PAR&#201;NQUIMA">
      <data key="d8">1.0</data>
      <data key="d9">La necrosis del par&#233;nquima pancre&#225;tico puede ocurrir en casos severos de pancreatitis aguda, complicando el tratamiento</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">2445dcb9e00247658bf5ab262d97fb32</data>
      <data key="d12">6900</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="PANCREATITIS CR&#211;NICA">
      <data key="d8">8.0</data>
      <data key="d9">Pancreatitis Aguda and Pancreatitis Cr&#243;nica are both conditions characterized by inflammation of the pancreas. Acute pancreatitis, if not properly managed, can progress to chronic pancreatitis, leading to long-term damage to the pancreas. This progression highlights the importance of effective treatment and management of acute pancreatitis to prevent the development of chronic pancreatitis.</data>
      <data key="d10">71df6da8c96a533357f4380fd6066417,dce680808e039e852dc0f2639835db32</data>
      <data key="d11">f67b720947f94972a4c8bb0f5b0e7a4f</data>
      <data key="d12">6901</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="GL&#193;NDULA PANCRE&#193;TICA">
      <data key="d8">8.0</data>
      <data key="d9">Pancreatitis aguda is a condition that affects the pancreatic gland, leading to inflammation and dysfunction</data>
      <data key="d10">71df6da8c96a533357f4380fd6066417</data>
      <data key="d11">fb4186079bb14aff89ee9a4d1d0358d9</data>
      <data key="d12">6902</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="ALCOHOL">
      <data key="d8">9.0</data>
      <data key="d9">Alcohol consumption is a significant risk factor for developing acute pancreatitis, especially in certain populations</data>
      <data key="d10">71df6da8c96a533357f4380fd6066417</data>
      <data key="d11">053262debd5e434d9ac35becef0a874f</data>
      <data key="d12">6903</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="C&#193;NCER PANCRE&#193;TICO">
      <data key="d8">6.0</data>
      <data key="d9">In patients with unexplained pancreatitis, pancreatic cancer must be ruled out as a potential underlying cause</data>
      <data key="d10">71df6da8c96a533357f4380fd6066417</data>
      <data key="d11">b455d95f1022445c9967f93ee5bb7829</data>
      <data key="d12">6904</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="ENFERMEDADES AUTOINMUNES">
      <data key="d8">5.0</data>
      <data key="d9">Autoimmune diseases are considered when diagnosing acute pancreatitis without a clear etiology</data>
      <data key="d10">71df6da8c96a533357f4380fd6066417</data>
      <data key="d11">51c90edcc26e461d8590d5272e9b5a9d</data>
      <data key="d12">6905</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="TUMOR DE PAPILA DUODENAL">
      <data key="d8">1.0</data>
      <data key="d9">Tumors of the duodenal papilla must be considered in the differential diagnosis of acute pancreatitis</data>
      <data key="d10">71df6da8c96a533357f4380fd6066417</data>
      <data key="d11">40410b86df9a4bdda1470b53f9baf9dc</data>
      <data key="d12">6906</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CRITERIOS DE ATLANTA">
      <data key="d8">8.0</data>
      <data key="d9">Los criterios de Atlanta se utilizan para clasificar la severidad de la pancreatitis aguda.</data>
      <data key="d10">caf14765027dbf6266841af0571a522e</data>
      <data key="d11">59a17b7a1ca441679ac655368d8e6707</data>
      <data key="d12">6907</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="NAUSEAS">
      <data key="d8">7.0</data>
      <data key="d9">Las n&#225;useas son un s&#237;ntoma que puede presentarse en pacientes con pancreatitis aguda.</data>
      <data key="d10">caf14765027dbf6266841af0571a522e</data>
      <data key="d11">cf70a3debf2f47cda7dbc6832a7fdfab</data>
      <data key="d12">6908</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="ATON&#205;A G&#193;STRICA">
      <data key="d8">6.0</data>
      <data key="d9">La aton&#237;a g&#225;strica puede ser una complicaci&#243;n en pacientes con pancreatitis aguda.</data>
      <data key="d10">caf14765027dbf6266841af0571a522e</data>
      <data key="d11">0388e8b776ad41468baed70f2a26dba9</data>
      <data key="d12">6909</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="OBSTRUCCI&#211;N PARCIAL DEL DUODENO">
      <data key="d8">6.0</data>
      <data key="d9">La obstrucci&#243;n parcial del duodeno puede ser una complicaci&#243;n de la pancreatitis aguda.</data>
      <data key="d10">caf14765027dbf6266841af0571a522e</data>
      <data key="d11">ebdd5f0450dc4e0ba8d2f2deb5044c65</data>
      <data key="d12">6910</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="HIDRATACI&#211;N INTRAVENOSA">
      <data key="d8">1.0</data>
      <data key="d9">La hidrataci&#243;n intravenosa es un tratamiento esencial para pacientes con pancreatitis aguda.</data>
      <data key="d10">caf14765027dbf6266841af0571a522e</data>
      <data key="d11">b3f8d2dff11b4b8487606ad992c2295c</data>
      <data key="d12">6911</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="PROTE&#205;NA C REACTIVA">
      <data key="d8">7.0</data>
      <data key="d9">Protein C reactive levels are monitored in patients with acute pancreatitis to assess inflammation</data>
      <data key="d10">f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d11">4153acab923b4a65a102f090d146b183</data>
      <data key="d12">6912</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="FALLO MULTIORG&#193;NICO">
      <data key="d8">9.0</data>
      <data key="d9">Severe acute pancreatitis can result in multiple organ failure</data>
      <data key="d10">f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d11">113e37a1d8194400962fde902a20ad26</data>
      <data key="d12">6913</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="DISFUNCI&#211;N ORG&#193;NICA M&#218;LTIPLE">
      <data key="d8">8.0</data>
      <data key="d9">Acute pancreatitis is associated with the risk of multiple organ dysfunction</data>
      <data key="d10">f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d11">55a23f8475984481affcb61555de6191</data>
      <data key="d12">6914</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CALORIMETR&#205;A INDIRECTA">
      <data key="d8">6.0</data>
      <data key="d9">Indirect calorimetry is used to assess energy expenditure in patients with acute pancreatitis</data>
      <data key="d10">f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d11">55f1a7fc28e145ceb08bad69d7ed3b85</data>
      <data key="d12">6915</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CORTISOL PLASM&#193;TICO">
      <data key="d8">7.0</data>
      <data key="d9">Plasma cortisol levels are elevated in patients with severe acute pancreatitis</data>
      <data key="d10">f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d11">4f1af60aa141418e988f23da8118c2ed</data>
      <data key="d12">6916</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="CATECOLAMINAS">
      <data key="d8">1.0</data>
      <data key="d9">Catecholamines are released in response to stress in patients with acute pancreatitis</data>
      <data key="d10">f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d11">267c86c184124978b3a504333c1c7959</data>
      <data key="d12">6917</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="ALGORITMO DEL MANEJO NUTRICIONAL">
      <data key="d8">1.0</data>
      <data key="d9">El algoritmo del manejo nutricional es una gu&#237;a para el tratamiento de la pancreatitis aguda</data>
      <data key="d10">be7eb01a6daf673db6a127f66c79c96c</data>
      <data key="d11">b1f51fcc969d4ff7a8d7f7f5ada06136</data>
      <data key="d12">6918</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="SOPORTE NUTRICIONAL">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional support is critical for patients suffering from pancreatitis aguda to improve outcomes</data>
      <data key="d10">21e6d7085f520d8a2f415746dc7eab71</data>
      <data key="d11">4bb822e4390546f99fbcfc5e80a5fd81</data>
      <data key="d12">6919</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS AGUDA" target="DIGESTIVO">
      <data key="d8">8.0</data>
      <data key="d9">Acute pancreatitis is a condition managed by the Digestive Service, which provides treatment and care for affected patients.</data>
      <data key="d10">dbfd111867924ed831f05d8fff01888b</data>
      <data key="d11">ca7b2adeebcb403abe099ec0f59b57f0</data>
      <data key="d12">6920</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOPAT&#205;AS" target="H&#205;GADO">
      <data key="d8">8.0</data>
      <data key="d9">The liver is the organ affected by hepatopathies, which can lead to various nutritional issues</data>
      <data key="d10">82adde9844cf0b1ccd052f91b304fb6e</data>
      <data key="d11">21a332d6d0104977906a37fd3bafc51a</data>
      <data key="d12">6921</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOPAT&#205;AS" target="CIRROSIS HEP&#193;TICA">
      <data key="d8">8.0</data>
      <data key="d9">Cirrhosis is one of the diseases classified under hepatopathies, impacting liver function and nutrition</data>
      <data key="d10">82adde9844cf0b1ccd052f91b304fb6e</data>
      <data key="d11">05622f478ce0435abdf07be6d4182f00</data>
      <data key="d12">6922</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOPAT&#205;AS" target="CARCINOMA HEPATOCELULAR">
      <data key="d8">8.0</data>
      <data key="d9">Hepatocellular carcinoma is a severe consequence of chronic hepatopathies, often leading to nutritional deficiencies</data>
      <data key="d10">82adde9844cf0b1ccd052f91b304fb6e</data>
      <data key="d11">c320d5af28e5406da4c8fba5e1760cb6</data>
      <data key="d12">6923</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOPAT&#205;AS" target="HEPATITIS V&#205;RICAS">
      <data key="d8">8.0</data>
      <data key="d9">Viral hepatitis is a common cause of hepatopathies, affecting liver health and nutrition</data>
      <data key="d10">82adde9844cf0b1ccd052f91b304fb6e</data>
      <data key="d11">de7d4368fc3741ae8b0ea64487f8a4fb</data>
      <data key="d12">6924</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOPAT&#205;AS" target="HEMOCROMATOSIS">
      <data key="d8">8.0</data>
      <data key="d9">Hemochromatosis is a type of hepatopathy that can lead to significant nutritional issues</data>
      <data key="d10">82adde9844cf0b1ccd052f91b304fb6e</data>
      <data key="d11">807b724015ef4aa99196623e39f72fc1</data>
      <data key="d12">6925</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HEPATOPAT&#205;AS" target="ENFERMEDAD DE WILSON">
      <data key="d8">1.0</data>
      <data key="d9">Wilson's disease is classified as a hepatopathy that affects liver function and nutrition</data>
      <data key="d10">82adde9844cf0b1ccd052f91b304fb6e</data>
      <data key="d11">15d87137421844b8962b71582fed9fec</data>
      <data key="d12">6926</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="NUTRICI&#211;N EN SINDROME DE INTESTINO CORTO">
      <data key="d8">9.0</data>
      <data key="d9">The chapter focuses on the nutritional challenges and management strategies for patients suffering from short bowel syndrome.</data>
      <data key="d10">6dfb109dac53e054fd015f6d8adf48ac</data>
      <data key="d11">bb0f7eb448e240c7a7de41bc2d9ec7d0</data>
      <data key="d12">6927</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="NEFROLITIASIS">
      <data key="d8">1.0</data>
      <data key="d9">Patients with short bowel syndrome may have an increased risk of developing kidney stones due to dietary absorption issues</data>
      <data key="d10">b3f35283251afbd3276cf40d7be382c0</data>
      <data key="d11">36cdf32557c944e6846ca6eda0dcbf5c</data>
      <data key="d12">6928</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="FALLO INTESTINAL TIPO II">
      <data key="d8">7.0</data>
      <data key="d9">El fallo intestinal tipo II puede ser una consecuencia de condiciones que tambi&#233;n causan s&#237;ndrome de intestino corto, como resecciones quir&#250;rgicas extensas.</data>
      <data key="d10">998342e0e27f4902274d51c0658d2f17</data>
      <data key="d11">3d0dc655b95c454fa7af8a3271aec1af</data>
      <data key="d12">6929</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="EUROPA">
      <data key="d8">6.0</data>
      <data key="d9">En Europa, se estima que un n&#250;mero significativo de personas con s&#237;ndrome de intestino corto recibe nutrici&#243;n parenteral, indicando la gravedad de la condici&#243;n.</data>
      <data key="d10">998342e0e27f4902274d51c0658d2f17</data>
      <data key="d11">bcad23456cac427a8e9674dfb8d250d6</data>
      <data key="d12">6930</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="ITALIA">
      <data key="d8">1.0</data>
      <data key="d9">Italia ha realizado estudios sobre la supervivencia de pacientes con s&#237;ndrome de intestino corto, contribuyendo a la comprensi&#243;n de la condici&#243;n.</data>
      <data key="d10">998342e0e27f4902274d51c0658d2f17</data>
      <data key="d11">556918bf0a9b4126a15b7c0b087b2c3c</data>
      <data key="d12">6931</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="MAGNESIO">
      <data key="d8">8.0</data>
      <data key="d9">El s&#237;ndrome de intestino corto puede causar p&#233;rdidas de magnesio, lo que lleva a la necesidad de suplementaci&#243;n en pacientes afectados.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">96ad896677914c5ba12297071aa295a9</data>
      <data key="d12">6932</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="VITAMINA B12">
      <data key="d8">8.0</data>
      <data key="d9">Los pacientes con s&#237;ndrome de intestino corto que han tenido resecciones intestinales significativas requieren suplementaci&#243;n de vitamina B12 para prevenir deficiencias.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">71f259645c92428e99f7baf275c401fc</data>
      <data key="d12">6933</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="VITAMINA A">
      <data key="d8">7.0</data>
      <data key="d9">La deficiencia de vitamina A puede ocurrir en pacientes con s&#237;ndrome de intestino corto, lo que puede llevar a problemas de visi&#243;n como la ceguera nocturna.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">e6a0688314bc4efaadfef42408b4d5d7</data>
      <data key="d12">6934</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="VITAMINA D">
      <data key="d8">7.0</data>
      <data key="d9">Los pacientes con s&#237;ndrome de intestino corto pueden necesitar suplementaci&#243;n de vitamina D para prevenir enfermedades &#243;seas debido a su deficiencia.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">2f3eede299064fae84729297c08721b4</data>
      <data key="d12">6935</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="ZINC">
      <data key="d8">8.0</data>
      <data key="d9">El s&#237;ndrome de intestino corto puede resultar en deficiencia de zinc, lo que requiere aportes adicionales en pacientes con diarrea severa.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">e5006f6935d246c8a5e0e2d95dda7883</data>
      <data key="d12">6936</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="SELENIO">
      <data key="d8">5.0</data>
      <data key="d9">La deficiencia de selenio puede ocurrir en pacientes con s&#237;ndrome de intestino corto si no se a&#241;ade a la nutrici&#243;n parenteral.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">edc4e086cbbc46d1bf7027e58df7230b</data>
      <data key="d12">6937</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="CROMO">
      <data key="d8">3.0</data>
      <data key="d9">No suele ser necesario suplementar cromo en pacientes con s&#237;ndrome de intestino corto, aunque se debe tener cuidado con la toxicidad.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">ee77531de3e5439d825b8630efccaebe</data>
      <data key="d12">6938</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="MANGANESO">
      <data key="d8">1.0</data>
      <data key="d9">La suplementaci&#243;n de manganeso no es com&#250;nmente necesaria en pacientes con s&#237;ndrome de intestino corto, pero se debe considerar el riesgo de toxicidad.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">0500953dbc3a4e638fcae90c1c44feee</data>
      <data key="d12">6939</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="CAT&#201;TER TUNELIZADO">
      <data key="d8">7.0</data>
      <data key="d9">Los pacientes con s&#237;ndrome de intestino corto que requieren nutrici&#243;n parenteral a largo plazo pueden beneficiarse del uso de un cat&#233;ter tunelizado.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">c2b5e437e7a74d73a515946d173f64e4</data>
      <data key="d12">6940</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="DISPOSITIVO IMPLANTABLE">
      <data key="d8">7.0</data>
      <data key="d9">El uso de un dispositivo implantable puede ser una opci&#243;n para pacientes con s&#237;ndrome de intestino corto que necesitan acceso venoso a largo plazo para nutrici&#243;n parenteral.</data>
      <data key="d10">c00d7a0a842e45f78f71c27adecde3f9</data>
      <data key="d11">45c83813d7f0442db32d2a6949ad95f3</data>
      <data key="d12">6941</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="TRASPLANTE INTESTINAL">
      <data key="d8">8.0</data>
      <data key="d9">El trasplante intestinal es una opci&#243;n de tratamiento para pacientes que sufren de s&#237;ndrome de intestino corto y fallo intestinal cr&#243;nico</data>
      <data key="d10">ace4abd79441a61d6688d67db2dc0747</data>
      <data key="d11">3602ae3f18394dfb881ddb19138d8ced</data>
      <data key="d12">6942</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="ENFERMEDAD HEP&#193;TICA ASOCIADA A FALLA INTESTINAL">
      <data key="d8">7.0</data>
      <data key="d9">La enfermedad hep&#225;tica asociada a fallo intestinal es una complicaci&#243;n que puede surgir en pacientes con s&#237;ndrome de intestino corto</data>
      <data key="d10">ace4abd79441a61d6688d67db2dc0747</data>
      <data key="d11">314272cfb70343e3963797d8b77feaf8</data>
      <data key="d12">6943</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="FLUIDOS INTRAVENOSOS">
      <data key="d8">5.0</data>
      <data key="d9">Los fluidos intravenosos son administrados a pacientes con s&#237;ndrome de intestino corto para tratar la deshidrataci&#243;n</data>
      <data key="d10">ace4abd79441a61d6688d67db2dc0747</data>
      <data key="d11">c9db18530f8a487eb626f0e29fae631c</data>
      <data key="d12">6944</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="ENFERMEDAD METAB&#211;LICA &#211;SEA">
      <data key="d8">6.0</data>
      <data key="d9">La enfermedad metab&#243;lica &#243;sea es una complicaci&#243;n que puede surgir en pacientes con s&#237;ndrome de intestino corto debido a la malnutrici&#243;n</data>
      <data key="d10">ace4abd79441a61d6688d67db2dc0747</data>
      <data key="d11">65fa252c0e0b4c21bf847b40fcfd4b95</data>
      <data key="d12">6945</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="DESHIDRATACI&#211;N SEVERA">
      <data key="d8">5.0</data>
      <data key="d9">La deshidrataci&#243;n severa puede ser un problema en pacientes con s&#237;ndrome de intestino corto, a pesar de la administraci&#243;n de fluidos intravenosos</data>
      <data key="d10">ace4abd79441a61d6688d67db2dc0747</data>
      <data key="d11">f5bd281bf9544d339c2055d0f3a7d651</data>
      <data key="d12">6946</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE INTESTINO CORTO" target="S&#205;NDROME DE INTESTINO ULTRACORTO">
      <data key="d8">1.0</data>
      <data key="d9">El s&#237;ndrome de intestino ultracorto es una condici&#243;n que puede desarrollarse en pacientes con s&#237;ndrome de intestino corto y puede requerir trasplante intestinal</data>
      <data key="d10">ace4abd79441a61d6688d67db2dc0747</data>
      <data key="d11">652feb7c91a6479798349d4e69b54da0</data>
      <data key="d12">6947</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="NUTRICION ARTIFICIAL">
      <data key="d8">8.0</data>
      <data key="d9">La nutrici&#243;n artificial se utiliza como tratamiento para mejorar la condici&#243;n de los pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">d66daca6ec5ffce0fc73bce55a3c0ff0</data>
      <data key="d11">76f6c135f16744f4a73e14c5bcea5889</data>
      <data key="d12">6948</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="NUTRICION ENTERAL">
      <data key="d8">9.0</data>
      <data key="d9">La nutrici&#243;n enteral es la modalidad de nutrici&#243;n artificial de elecci&#243;n en la enfermedad inflamatoria intestinal</data>
      <data key="d10">d66daca6ec5ffce0fc73bce55a3c0ff0</data>
      <data key="d11">35bf73390b934479832b449dd46a68b3</data>
      <data key="d12">6949</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="MALNUTRICI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">La malnutrici&#243;n es una consecuencia com&#250;n de la enfermedad inflamatoria intestinal, afectando la salud general del paciente</data>
      <data key="d10">d66daca6ec5ffce0fc73bce55a3c0ff0</data>
      <data key="d11">c2f34fdad50048ad8afa44e138e2bf69</data>
      <data key="d12">6950</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="ESTEROIDES">
      <data key="d8">7.0</data>
      <data key="d9">Los esteroides son utilizados para tratar la enfermedad inflamatoria intestinal, aunque pueden causar efectos secundarios</data>
      <data key="d10">d66daca6ec5ffce0fc73bce55a3c0ff0</data>
      <data key="d11">af3b3309749649638aa1bb662dfee93c</data>
      <data key="d12">6951</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="SUFICIENTE INGESTA CAL&#211;RICA">
      <data key="d8">6.0</data>
      <data key="d9">Asegurar una ingesta cal&#243;rica suficiente es crucial para el manejo de la enfermedad inflamatoria intestinal</data>
      <data key="d10">d66daca6ec5ffce0fc73bce55a3c0ff0</data>
      <data key="d11">adbf930927f94ced91f05bdafed42098</data>
      <data key="d12">6952</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="DIETA BAJA EN FIBRA">
      <data key="d8">6.0</data>
      <data key="d9">La dieta baja en fibra es recomendada para pacientes con brotes de colitis ulcerosa grave</data>
      <data key="d10">d66daca6ec5ffce0fc73bce55a3c0ff0</data>
      <data key="d11">c0d64561f428466e9ac9416cfa2f8142</data>
      <data key="d12">6953</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="DIETA BAJA EN GRASA">
      <data key="d8">1.0</data>
      <data key="d9">La dieta baja en grasa es recomendada para pacientes con enfermedad de Crohn que presentan esteatorrea</data>
      <data key="d10">d66daca6ec5ffce0fc73bce55a3c0ff0</data>
      <data key="d11">9f5d2bd518de4bababc6756668d99526</data>
      <data key="d12">6954</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="MNGIE">
      <data key="d8">4.0</data>
      <data key="d9">Enfermedad inflamatoria intestinal must be differentiated from MNGIE</data>
      <data key="d10">b8db8cc3349b8ac0cce45497da6244fc</data>
      <data key="d11">df279d38e2644606b2150c2be9c8aa47</data>
      <data key="d12">6955</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="ANEMIA FERROP&#201;NICA">
      <data key="d8">6.0</data>
      <data key="d9">Inflammatory bowel disease can cause malabsorption and bleeding, leading to iron deficiency anemia</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">73ccd79da094432883b4346e7e4b6b85</data>
      <data key="d12">6956</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="BIFIDOBACTERIUM">
      <data key="d8">6.0</data>
      <data key="d9">Bifidobacterium is being researched for its effects on ENFERMEDAD INFLAMATORIA INTESTINAL</data>
      <data key="d10">5a1ea1a4dfb1b591756a8dc60f504da2</data>
      <data key="d11">b985f77033c7455894d60315e46473ef</data>
      <data key="d12">6957</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="COLITIS ULCEROSA">
      <data key="d8">23.0</data>
      <data key="d9">La colitis ulcerosa es una forma espec&#237;fica de enfermedad inflamatoria intestinal que afecta el colon y el recto. Esta condici&#243;n se clasifica dentro de un grupo m&#225;s amplio de enfermedades inflamatorias cr&#243;nicas del intestino, conocido como enfermedad inflamatoria intestinal. La colitis ulcerosa se asocia con d&#233;ficits nutricionales, lo que puede complicar la salud general de los pacientes que la padecen.</data>
      <data key="d10">609140cabbcd0c7297a7029f5365d186,88647cc4d1748c5bb058d4aab1817d63,a519216aaee7bf8a1317f5d6b522c4b6</data>
      <data key="d11">3db6924e935e4a43862923f0e569376a</data>
      <data key="d12">6958</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="DEP">
      <data key="d8">8.0</data>
      <data key="d9">La enfermedad inflamatoria intestinal puede causar DEP en los pacientes</data>
      <data key="d10">c9790e5e47712b100fb4870d35a3edfa</data>
      <data key="d11">7b54b88fc76a484a930eec1f98b356b9</data>
      <data key="d12">6959</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="MICRONUTRIENTES">
      <data key="d8">15.0</data>
      <data key="d9">La enfermedad inflamatoria intestinal (EII) puede provocar d&#233;ficits de micronutrientes en los pacientes, lo que resulta en una deficiencia de micronutrientes que es una consecuencia cl&#237;nica significativa de esta condici&#243;n.</data>
      <data key="d10">c9790e5e47712b100fb4870d35a3edfa,eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">88e7650f68d3491cb26b246bc648c7db</data>
      <data key="d12">6960</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="VITAMINA B12">
      <data key="d8">21.0</data>
      <data key="d9">La enfermedad inflamatoria intestinal (EII) es una condici&#243;n que a menudo se asocia con deficiencias nutricionales, siendo la deficiencia de vitamina B12 un problema com&#250;n en estos pacientes. Esta deficiencia puede contribuir al desarrollo de anemia, lo que resalta la importancia de monitorear los niveles de vitamina B12 en individuos con EII. La vitamina B12 es esencial para el tratamiento de estas deficiencias, y su adecuada gesti&#243;n es crucial para la salud y el bienestar de los pacientes que padecen esta enfermedad.</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8,609140cabbcd0c7297a7029f5365d186,88647cc4d1748c5bb058d4aab1817d63</data>
      <data key="d11">be65dd1499224e258cfdb03c44b1ad0b</data>
      <data key="d12">6961</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="&#193;CIDO F&#211;LICO">
      <data key="d8">15.0</data>
      <data key="d9">La enfermedad inflamatoria intestinal (EII) es una condici&#243;n que puede llevar a deficiencias nutricionales, siendo una de las m&#225;s relevantes la deficiencia de &#225;cido f&#243;lico. Se recomienda el uso de &#225;cido f&#243;lico en pacientes con EII para prevenir estas deficiencias y sus efectos adversos, como la anemia. La relaci&#243;n entre la EII y la deficiencia de &#225;cido f&#243;lico es significativa, ya que la inflamaci&#243;n y los problemas de absorci&#243;n intestinal asociados con la enfermedad pueden contribuir a la disminuci&#243;n de los niveles de este nutriente esencial.</data>
      <data key="d10">609140cabbcd0c7297a7029f5365d186,88647cc4d1748c5bb058d4aab1817d63</data>
      <data key="d11">52c76809412e43a280eab1e71aefe811</data>
      <data key="d12">6962</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="CALCIO">
      <data key="d8">16.0</data>
      <data key="d9">The entity "ENFERMEDAD INFLAMATORIA INTESTINAL" is closely related to "CALCIO" in the context of patient care and nutritional management. Calcio, a vital mineral, requires careful monitoring in patients suffering from enfermedad inflamatoria intestinal to prevent potential complications. The absorption of calcio can be significantly impaired in these patients, which may lead to a deficiency. Such a deficiency is particularly concerning as it can result in serious bone health issues in adults with enfermedad inflamatoria intestinal. Therefore, maintaining adequate levels of calcio is crucial for the overall health and well-being of individuals affected by this condition.</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8,88647cc4d1748c5bb058d4aab1817d63,eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">8bfa85d1d34a45ff89005ad4d8f4c4eb</data>
      <data key="d12">6963</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="VITAMINA D">
      <data key="d8">7.0</data>
      <data key="d9">The relationship between "ENFERMEDAD INFLAMATORIA INTESTINAL" (inflammatory bowel disease) and "VITAMINA D" (vitamin D) highlights the impact of vitamin D deficiency on the health of individuals suffering from this condition. It has been observed that patients with inflammatory bowel disease often experience a deficiency in vitamin D. This deficiency can significantly affect their bone health, indicating a crucial link between vitamin D levels and the overall well-being of patients with inflammatory bowel disease.</data>
      <data key="d10">88647cc4d1748c5bb058d4aab1817d63,eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">a0ddbfd9631848ae8adb27d890d8108a</data>
      <data key="d12">6964</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="HIERRO">
      <data key="d8">15.0</data>
      <data key="d9">La enfermedad inflamatoria intestinal (EII) es una condici&#243;n que a menudo se asocia con deficiencia de hierro, lo que contribuye al desarrollo de anemia en los pacientes. El hierro es un mineral esencial que juega un papel crucial en el tratamiento de esta anemia. Por lo tanto, es fundamental abordar la deficiencia de hierro en pacientes que padecen enfermedad inflamatoria intestinal para mejorar su salud y bienestar.</data>
      <data key="d10">609140cabbcd0c7297a7029f5365d186,88647cc4d1748c5bb058d4aab1817d63</data>
      <data key="d11">2832de9434334b4680a47d5936c25d16</data>
      <data key="d12">6965</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="PROTE&#205;NAS">
      <data key="d8">24.0</data>
      <data key="d9">La "ENFERMEDAD INFLAMATORIA INTESTINAL" (EII) se caracteriza por una serie de complicaciones nutricionales, entre las cuales la disminuci&#243;n de prote&#237;nas juega un papel significativo en la evoluci&#243;n postoperatoria de los pacientes. La ingesta adecuada de prote&#237;nas es crucial para la recuperaci&#243;n y el mantenimiento de la salud en estos pacientes, ya que las prote&#237;nas son un componente esencial de su dieta. Adem&#225;s, es com&#250;n que los pacientes con EII experimenten una p&#233;rdida de prote&#237;nas a trav&#233;s de la mucosa intestinal inflamada, lo que puede afectar su estado nutricional. Por lo tanto, es fundamental asegurar un consumo suficiente de prote&#237;nas para abordar estas preocupaciones y promover una mejor salud en quienes padecen esta enfermedad.</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8,609140cabbcd0c7297a7029f5365d186,88647cc4d1748c5bb058d4aab1817d63,eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">8fa7d69347cd427eb92a56ed7db1a9c0</data>
      <data key="d12">6966</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="FERRITINA">
      <data key="d8">1.0</data>
      <data key="d9">Los niveles de ferritina pueden estar elevados en pacientes con enfermedad inflamatoria intestinal a pesar de la deficiencia de hierro</data>
      <data key="d10">88647cc4d1748c5bb058d4aab1817d63</data>
      <data key="d11">7fa61afe7c9a455198de88e684bcb8fd</data>
      <data key="d12">6967</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="SULFASALACINA">
      <data key="d8">6.0</data>
      <data key="d9">La sulfasalacina puede interferir con la absorci&#243;n de nutrientes en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">88647cc4d1748c5bb058d4aab1817d63</data>
      <data key="d11">6c9c0d25bd814053a7014dca0a64ee4d</data>
      <data key="d12">6968</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="METOTREXATO">
      <data key="d8">1.0</data>
      <data key="d9">El metotrexato puede contribuir a la anemia en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">88647cc4d1748c5bb058d4aab1817d63</data>
      <data key="d11">835323aa2d91476199290989c6d6f1ab</data>
      <data key="d12">6969</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="NI&#209;OS">
      <data key="d8">9.0</data>
      <data key="d9">Los ni&#241;os son los m&#225;s afectados por la desnutrici&#243;n asociada a la enfermedad inflamatoria intestinal, presentando retrasos en el crecimiento</data>
      <data key="d10">eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">b031465569e84a058703232730eb51bc</data>
      <data key="d12">6970</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="ADULTOS">
      <data key="d8">8.0</data>
      <data key="d9">Los adultos con enfermedad inflamatoria intestinal pueden desarrollar osteomalacia u osteoporosis debido a la desnutrici&#243;n</data>
      <data key="d10">eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">457567a1eb4f4b63b376a7ff1c8afc76</data>
      <data key="d12">6971</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="ESTR&#201;S PSICOSOCIAL">
      <data key="d8">1.0</data>
      <data key="d9">El estr&#233;s psicosocial, que incluye ansiedad y depresi&#243;n, se asocia con la enfermedad inflamatoria intestinal</data>
      <data key="d10">eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">1369335db58e47138a2700821cf8f827</data>
      <data key="d12">6972</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="CROMO">
      <data key="d8">4.0</data>
      <data key="d9">La deficiencia de cromo puede ser un problema en pacientes con enfermedad inflamatoria intestinal, afectando su salud</data>
      <data key="d10">eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">818036180b9d4ad3aeb266ada68d0c5c</data>
      <data key="d12">6973</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="MANGANESO">
      <data key="d8">4.0</data>
      <data key="d9">La deficiencia de manganeso puede tener implicaciones cl&#237;nicas en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">4fa7d7c277a24401b3be6c91934f3dde</data>
      <data key="d12">6974</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="MOLIBDENO">
      <data key="d8">4.0</data>
      <data key="d9">La deficiencia de molibdeno puede ser un factor en la salud de pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">00d98455201b48c9a8e57b3bf98a416c</data>
      <data key="d12">6975</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="SELENIO">
      <data key="d8">4.0</data>
      <data key="d9">La deficiencia de selenio se ha asociado con complicaciones graves en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">914988122e46427bab33858cecc1e215</data>
      <data key="d12">6976</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="ZINC">
      <data key="d8">11.0</data>
      <data key="d9">The entity "ENFERMEDAD INFLAMATORIA INTESTINAL" is associated with the mineral "ZINC" in the context of patient care. Zinc is recommended for patients suffering from inflammatory bowel disease, particularly those experiencing severe diarrhea or fistulas. Additionally, a deficiency in zinc can negatively impact the recovery and overall health of individuals with this condition. Therefore, maintaining adequate zinc levels is crucial for the well-being of patients with inflammatory bowel disease.</data>
      <data key="d10">609140cabbcd0c7297a7029f5365d186,eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">8d34b1aa19d44151a85ca82dac88cd2c</data>
      <data key="d12">6977</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="MAGNESIO">
      <data key="d8">11.0</data>
      <data key="d9">The entity "ENFERMEDAD INFLAMATORIA INTESTINAL" is associated with the mineral "MAGNESIO," which plays a crucial role in overall health. It is particularly important for patients suffering from inflammatory bowel disease (IBD), as adequate magnesium levels may be necessary for their well-being. Furthermore, a deficiency in magnesium can lead to complications in individuals with IBD, highlighting the significance of maintaining proper magnesium levels in this patient population.</data>
      <data key="d10">609140cabbcd0c7297a7029f5365d186,eaa2ba81b06f325e284b5dbdc45b5c9f</data>
      <data key="d11">928d631df31b4268be55790f2a8ffff8</data>
      <data key="d12">6978</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="DEXA">
      <data key="d8">7.0</data>
      <data key="d9">La DEXA se recomienda para evaluar el estado nutricional en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">b7594bbe21fc4b38bae623b2ff33b7e9</data>
      <data key="d12">6979</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="LACTOSA">
      <data key="d8">1.0</data>
      <data key="d9">La intolerancia a la lactosa puede ser un problema en pacientes con enfermedad inflamatoria intestinal, especialmente durante brotes</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">7f501be52e164de0998c29822cf94828</data>
      <data key="d12">6980</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="ALBUMINA">
      <data key="d8">6.0</data>
      <data key="d9">La alb&#250;mina se mide para evaluar el estado nutricional de pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">8d40be16f16a4d1cb18dd052d974cef3</data>
      <data key="d12">6981</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="PREALBUMINA">
      <data key="d8">6.0</data>
      <data key="d9">La prealb&#250;mina es un marcador importante del estado nutricional en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">74ca5e6a149944d6a6b98ed1cb7a1881</data>
      <data key="d12">6982</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="TRANSFERRINA">
      <data key="d8">6.0</data>
      <data key="d9">La transferrina se mide para evaluar el estado nutricional y la deficiencia de hierro en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">5181ecc5d926439297ac63b9519607d1</data>
      <data key="d12">6983</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="N-TELOP&#201;PTIDO DE COL&#193;GENO TIPO I">
      <data key="d8">5.0</data>
      <data key="d9">El N-telop&#233;ptido de col&#225;geno tipo I se mide en orina para evaluar la resorci&#243;n &#243;sea en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">14c44ca0e5bb43008a33783f34aa0384</data>
      <data key="d12">6984</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="SIALOPROTE&#205;NA &#211;SEA">
      <data key="d8">5.0</data>
      <data key="d9">La sialoprote&#237;na &#243;sea se utiliza como marcador de resorci&#243;n en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">2d0ef51aec704690afcdb0c6c1427893</data>
      <data key="d12">6985</data>
