      <data key="d10">a4b144210b0a4b654a260ebc394de0af</data>
      <data key="d11">fda53087e9da4359acb3d80a90ef6eae</data>
      <data key="d12">9743</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMERICAN DIABETES ASSOCIATION" target="METZGER BE">
      <data key="d8">7.0</data>
      <data key="d9">Metzger BE contributed to the recommendations provided by the American Diabetes Association regarding diabetes classification</data>
      <data key="d10">54bdd3faa067cdbb44671453ffaf4be5</data>
      <data key="d11">caa1d5c657ae492c8ec909a8d84d4bca</data>
      <data key="d12">9744</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMERICAN DIABETES ASSOCIATION" target="NATIONAL DIABETES DATA GROUP">
      <data key="d8">6.0</data>
      <data key="d9">The National Diabetes Data Group established criteria that are referenced by the American Diabetes Association</data>
      <data key="d10">54bdd3faa067cdbb44671453ffaf4be5</data>
      <data key="d11">e78c4f2c2e1d4242acbe1e3da9083ce5</data>
      <data key="d12">9745</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMERICAN DIABETES ASSOCIATION" target="CARPENTER MW">
      <data key="d8">7.0</data>
      <data key="d9">Carpenter MW established criteria for screening tests that are recognized by the American Diabetes Association</data>
      <data key="d10">54bdd3faa067cdbb44671453ffaf4be5</data>
      <data key="d11">3abb8dd6bda546bb90b09128af09e9d0</data>
      <data key="d12">9746</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANTIBI&#211;TICOS" target="MICROFLORA COL&#211;NICA">
      <data key="d8">6.0</data>
      <data key="d9">Antibi&#243;ticos can disrupt the normal colonic microflora, affecting carbohydrate fermentation and absorption</data>
      <data key="d10">8c87213151750706e4e87956bfc9cb88</data>
      <data key="d11">8072c9d1423f46dc921637e93dc80479</data>
      <data key="d12">9747</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANTIBI&#211;TICOS" target="SIC">
      <data key="d8">8.0</data>
      <data key="d9">Antibiotics are necessary for treating infections that arise in patients with SIC, particularly those with central venous catheters</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">327c4888efe54650997b31468ddadce9</data>
      <data key="d12">9748</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="F&#211;RMULA PEPT&#205;DICA HC/HP">
      <data key="d8">6.0</data>
      <data key="d9">NE was changed to a pept&#237;dica formula to improve the patient's nutritional intake</data>
      <data key="d10">bfdbf41efa08067d5ae1b1a67830affd</data>
      <data key="d11">4aa18075a54143c5aa307040f57a97d0</data>
      <data key="d12">9749</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="F&#211;RMULA POLIM&#201;RICA HC/HP">
      <data key="d8">6.0</data>
      <data key="d9">NE was adjusted to a polim&#233;rica formula to better suit the dietary needs of diabetic patients</data>
      <data key="d10">bfdbf41efa08067d5ae1b1a67830affd</data>
      <data key="d11">80def787efad459091786c7331e22067</data>
      <data key="d12">9750</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="SAMUEL">
      <data key="d8">7.0</data>
      <data key="d9">Samuel is receiving nocturnal enteral nutrition (NE) to manage his nutritional needs due to his condition</data>
      <data key="d10">dc7539b4d637d6dd09963c2564f4f084</data>
      <data key="d11">f6876c467f20411a80b952dcba923a89</data>
      <data key="d12">9751</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="GRP">
      <data key="d8">12.0</data>
      <data key="d9">The GRP feeding tube is a method designed to provide nutritional enteral feeding (NE) to patients. This approach includes the placement of a gastrostomy, which is intended to facilitate the administration of nutritional formulas directly into the stomach, ensuring that patients receive the necessary nutrients effectively.</data>
      <data key="d10">49d3f1ca700a7974db89e684f3744a40,5aa4da1a8d1e0b60ec7e801c7db1701c</data>
      <data key="d11">0026ef7cbfc6400ebe5de1d37bacb74c</data>
      <data key="d12">9752</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="SNO">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional enteral feeding (NE) and specific nutritional supplements (SNO) are both utilized to support patients' dietary needs. Within clinical settings, nutritional formulas, which fall under the category of SNO, represent a specific type of NE designed to meet the nutritional requirements of patients.</data>
      <data key="d10">49d3f1ca700a7974db89e684f3744a40,5aa4da1a8d1e0b60ec7e801c7db1701c</data>
      <data key="d11">6168421d79aa4827b48a180c4dd1a929</data>
      <data key="d12">9753</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="DM TIPO 2">
      <data key="d8">1.0</data>
      <data key="d9">The patient with Type 2 Diabetes Mellitus was on nutritional formulas for management</data>
      <data key="d10">5aa4da1a8d1e0b60ec7e801c7db1701c</data>
      <data key="d11">0246945848ef454899208068759c82b1</data>
      <data key="d12">9754</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="RT">
      <data key="d8">6.0</data>
      <data key="d9">Radiotherapy can lead to complications that necessitate the use of nutritional formulas</data>
      <data key="d10">5aa4da1a8d1e0b60ec7e801c7db1701c</data>
      <data key="d11">fec6b5a70cdb452fa92b6e26977d6455</data>
      <data key="d12">9755</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="QT">
      <data key="d8">6.0</data>
      <data key="d9">Chemotherapy can also lead to complications that require nutritional support</data>
      <data key="d10">5aa4da1a8d1e0b60ec7e801c7db1701c</data>
      <data key="d11">4553d74442e3464c8924176faf7e044b</data>
      <data key="d12">9756</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="PA">
      <data key="d8">7.0</data>
      <data key="d9">NE is recommended for patients with pancreatitis as it has advantages over NPT</data>
      <data key="d10">46bc44144e19709e2d7f9838c9c54ccf</data>
      <data key="d11">08ba72d644cd4056a8ea2980b5ab2d7b</data>
      <data key="d12">9757</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="PANCREATITIS CR&#211;NICA">
      <data key="d8">7.0</data>
      <data key="d9">Nutritional enteral feeding (NE) may be initiated for patients with pancreatitis cr&#243;nica who cannot maintain oral intake</data>
      <data key="d10">67106be274787fd7f400ce3023c33a3d</data>
      <data key="d11">8a624b1c575d467e9dda95cd317d4c5c</data>
      <data key="d12">9758</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="PACIENTES CR&#205;TICOS">
      <data key="d8">18.0</data>
      <data key="d9">NE, which refers to enteral nutrition, is a critical component of care for PACIENTES CR&#205;TICOS, or critically ill patients. It serves as a primary method of nutritional support for these patients when they are unable to eat normally. Enteral nutrition plays a vital role in their overall management and recovery, ensuring that they receive the necessary nutrients to support their health during critical times.</data>
      <data key="d10">01704aec4089b2f0f24dd0f0841b5ecf,4ce0bfcd129ba597d70d90d2120c1996</data>
      <data key="d11">3d18b95bb3464c73a8274bfa736a20ce</data>
      <data key="d12">9759</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="UCI">
      <data key="d8">8.0</data>
      <data key="d9">NE is often initiated in the UCI for patients who cannot meet their nutritional needs orally</data>
      <data key="d10">c07baf818737d704c290ca0f5eefd30f</data>
      <data key="d11">a60070f1bf0e4c099d9e8d804def19af</data>
      <data key="d12">9760</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="NP">
      <data key="d8">13.0</data>
      <data key="d9">Nutrici&#243;n enteral (NE) and nutrici&#243;n parenteral (NP) are both methods of providing nutrition to patients who are unable to eat normally. NE is generally preferred when possible, as it involves delivering nutrients directly to the gastrointestinal tract, which can be more beneficial for the patient's overall health. In contrast, NP provides nutrition intravenously, bypassing the digestive system entirely. Both methods serve the essential purpose of ensuring that patients receive the necessary nutrients when traditional eating is not feasible.</data>
      <data key="d10">500e56f18da6e8b6ed0e1eed4af927e9,c07baf818737d704c290ca0f5eefd30f</data>
      <data key="d11">bf548a79866b4f1c82dd07dcfd2a303d</data>
      <data key="d12">9761</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NE" target="SIADH">
      <data key="d8">6.0</data>
      <data key="d9">Nutrici&#243;n Enteral is adjusted in patients with SIADH</data>
      <data key="d10">fa0165b0420f4c761829a08a3ab08508</data>
      <data key="d11">08422a74ff4a4e2c869231aa5eee995c</data>
      <data key="d12">9762</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NP" target="PANCREATITIS CR&#211;NICA">
      <data key="d8">1.0</data>
      <data key="d9">Nutritional parenteral feeding (NP) may be required for patients with severe pancreatitis cr&#243;nica when enteral feeding is not tolerated</data>
      <data key="d10">67106be274787fd7f400ce3023c33a3d</data>
      <data key="d11">0dffe8c2e106447895db40e758091938</data>
      <data key="d12">9763</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NP" target="FEC">
      <data key="d8">7.0</data>
      <data key="d9">FEC may require the use of NP when enteral nutrition is not tolerated</data>
      <data key="d10">e5838e52fbc5d3d18fc0533b71148201</data>
      <data key="d11">50f57a42c60a4912925ba5fa8cc3b9fa</data>
      <data key="d12">9764</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NP" target="UCI">
      <data key="d8">1.0</data>
      <data key="d9">NP is used in the UCI for patients who cannot tolerate enteral nutrition</data>
      <data key="d10">c07baf818737d704c290ca0f5eefd30f</data>
      <data key="d11">68a7b6a0f3d0489993e9496853b132bf</data>
      <data key="d12">9765</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NP" target="PACIENTES CR&#205;TICOS">
      <data key="d8">10.0</data>
      <data key="d9">NP, or parenteral nutrition, is utilized for critically ill patients when enteral nutrition cannot adequately meet their nutritional needs. The guidelines for NP specifically emphasize the importance of addressing the nutritional requirements of patients in critical condition, making them the primary focus of these guidelines.</data>
      <data key="d10">01704aec4089b2f0f24dd0f0841b5ecf,a687eee1e8bfd2d98ce40a14628dd855</data>
      <data key="d11">20dff6d50fd1491c895ca7b3a41b18cf</data>
      <data key="d12">9766</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NP" target="VENOUS ACCESS">
      <data key="d8">9.0</data>
      <data key="d9">Parenteral nutrition (NP) is administered through venous access methods</data>
      <data key="d10">3d5e0a3ef45c7ba15063791545dc4826</data>
      <data key="d11">574c5aad46d94147ba365b590312007f</data>
      <data key="d12">9767</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NP" target="SIADH">
      <data key="d8">6.0</data>
      <data key="d9">Nutrici&#243;n Parenteral is adjusted in patients with SIADH</data>
      <data key="d10">fa0165b0420f4c761829a08a3ab08508</data>
      <data key="d11">65728ddda8f442eb831e5fb431218162</data>
      <data key="d12">9768</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ELECTROLYTES" target="FLUIDS">
      <data key="d8">7.0</data>
      <data key="d9">Fluids in the digestive system contain electrolytes, which are vital for maintaining hydration and proper physiological function</data>
      <data key="d10">4ada21f24df8df18dbc05f5619c0a368</data>
      <data key="d11">f18e56207a29449b8f7af6d630663cf7</data>
      <data key="d12">9769</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ELECTROLYTES" target="DIGESTIVE SECRETIONS">
      <data key="d8">6.0</data>
      <data key="d9">Digestive secretions include electrolytes that are important for digestion and nutrient absorption</data>
      <data key="d10">4ada21f24df8df18dbc05f5619c0a368</data>
      <data key="d11">0737daaafe354eaeb4a9186b8d74c871</data>
      <data key="d12">9770</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="INSULIN">
      <data key="d8">19.0</data>
      <data key="d9">HYPERGLYCEMIA is a condition characterized by elevated blood sugar levels, often associated with diabetes. INSULIN plays a crucial role in managing hyperglycemia by facilitating the uptake of glucose into cells, which effectively lowers blood sugar levels. It is an essential component of diabetes management, as it is specifically used to control hyperglycemia in patients with diabetes. Through its action, INSULIN helps to maintain normal blood glucose levels, making it vital for the health and well-being of individuals affected by this condition.</data>
      <data key="d10">06fe3811ad957d6841997b2a0e9be50f,7b084f7afc5f3c66a528475ae4fa76b1,eeb6e04f12698ee82912bdf775d79381</data>
      <data key="d11">90870f2ad2014e9493c2dd7172a01bcc</data>
      <data key="d12">9771</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="NUTRITION SUPPORT">
      <data key="d8">1.0</data>
      <data key="d9">Managing hyperglycemia often involves tailored nutrition support to control blood sugar levels</data>
      <data key="d10">e36c9b09870e14d19aa6eb7c82514499</data>
      <data key="d11">24638e7d58cf497295cb3d2a5d73e688</data>
      <data key="d12">9772</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="GLYCEMIC CONTROL">
      <data key="d8">9.0</data>
      <data key="d9">Managing hyperglycemia is a key aspect of achieving glycemic control in diabetes</data>
      <data key="d10">502bae6c907e900b95f5fe6aa963b0fc</data>
      <data key="d11">23f234c3fc444944bab135602784fe7b</data>
      <data key="d12">9773</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERGLYCEMIA" target="TRIGLYCERIDES">
      <data key="d8">1.0</data>
