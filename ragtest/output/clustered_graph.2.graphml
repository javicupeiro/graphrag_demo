      <data key="d6">3028</data>
      <data key="d7">e805cc74dc8843be8824171fd620a8b8</data>
    </node>
    <node id="TILBURG FRAILTY INDEX">
      <data key="d0">EVENT</data>
      <data key="d1">El Tilburg Frailty Index es un modelo que se utiliza para medir la fragilidad en la poblaci&#243;n anciana.</data>
      <data key="d2">00a918807f0c6568ea1d9f0c41f1ad49</data>
      <data key="d3">1768</data>
