    <node id="FALLO HEP&#193;TICO FULMINANTE">
      <data key="d0">EVENT</data>
      <data key="d1">Fallo hep&#225;tico fulminante is an acute liver failure condition that can occur suddenly and is critical in medical assessments.</data>
      <data key="d2">b5c30f293b197b201d278f0660640b86</data>
