    </node>
    <node id="COMPLICACIONES SECUNDARIAS">
      <data key="d0">EVENT</data>
      <data key="d1">Las complicaciones secundarias son problemas que pueden surgir en pacientes cr&#237;ticos si no se inicia la nutrici&#243;n a tiempo.</data>
      <data key="d2">422dbd193843eb5098307e57ba002ced</data>
