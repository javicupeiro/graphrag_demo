    <node id="SECCI&#211;N DE ENDOCRINOLOG&#205;A Y NUTRICI&#211;N">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Secci&#243;n de Endocrinolog&#237;a y Nutrici&#243;n is a department within the Hospital Universitario Insular de Gran Canaria focused on endocrinology and nutrition.</data>
      <data key="d2">4c4d1882f0ac14b7c55941ec1c17b650</data>
      <data key="d3">1836</data>
