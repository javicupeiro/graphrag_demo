    <node id="VIDEOENDOSCOPIO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The videoendoscope is a medical instrument used to visualize the anatomical structures during the VED process.</data>
      <data key="d2">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d3">944</data>
