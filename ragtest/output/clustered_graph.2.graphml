    </edge>
    <edge source="ENFERMEDAD CARDIOVASCULAR" target="GRASA SATURADA">
      <data key="d8">8.0</data>
      <data key="d9">La grasa saturada est&#225; correlacionada con el aumento de colesterol y el riesgo de enfermedad cardiovascular</data>
