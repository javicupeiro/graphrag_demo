    </node>
    <node id="FIBROSCOPIA">
      <data key="d0">EVENT</data>
      <data key="d1">Fibroscopy is an invasive procedure that allows direct visualization of the swallowing process and assessment of pharyngeal mobility and sensitivity.</data>
      <data key="d2">b44e720874efa74c538dd573ee936378</data>
