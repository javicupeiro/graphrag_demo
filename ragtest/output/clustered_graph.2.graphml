    </edge>
    <edge source="HIPERPROLACTINEMIA" target="VERAPAMILO">
      <data key="d8">6.0</data>
      <data key="d9">Verapamil can cause hyperprolactinemia in a percentage of users, indicating a relationship</data>
      <data key="d10">b344a34a623d4ade6b3ed6e1adae0016</data>
      <data key="d11">429a63832a4f4e259b7378069fd9ee31</data>
      <data key="d12">12705</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERPROLACTINEMIA" target="ANTIPSICOTICOS">
      <data key="d8">8.0</data>
      <data key="d9">Antipsychotics are a common cause of hyperprolactinemia due to their effect on dopamine receptors</data>
      <data key="d10">b344a34a623d4ade6b3ed6e1adae0016</data>
      <data key="d11">3f217db7fc874934a63d9ce96771c6a2</data>
      <data key="d12">12706</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERPROLACTINEMIA" target="RISPERIDONA">
      <data key="d8">7.0</data>
      <data key="d9">Risperidone is associated with significant increases in prolactin levels, contributing to hyperprolactinemia</data>
      <data key="d10">b344a34a623d4ade6b3ed6e1adae0016</data>
      <data key="d11">624227a1d2044f7ba51c9bad32029652</data>
      <data key="d12">12707</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERPROLACTINEMIA" target="AMISULPIRIDA">
      <data key="d8">7.0</data>
      <data key="d9">Amisulpride is linked to frequent increases in prolactin levels, thus causing hyperprolactinemia</data>
      <data key="d10">b344a34a623d4ade6b3ed6e1adae0016</data>
