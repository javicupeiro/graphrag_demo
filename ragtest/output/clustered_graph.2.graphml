    </node>
    <node id="SF">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">SF stands for service functional, which is responsible for patient care and related costs.</data>
      <data key="d2">f73cc4b49b42b9c9d60bc906430ffe90</data>
      <data key="d5">3</data>
      <data key="d6">15984</data>
      <data key="d7">af02d6aeeef044f38700b90f8510af34</data>
    </node>
    <node id="URV">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">URV is a weighted indicator that measures the complexity and resource consumption of units produced by GFH based on cost allocation.</data>
      <data key="d2">f73cc4b49b42b9c9d60bc906430ffe90</data>
      <data key="d5">2</data>
      <data key="d6">15985</data>
      <data key="d7">ec80a498ef5f4fdd95dbd6e54c893c83</data>
    </node>
    <node id="INTERCONSULTATIONS">
      <data key="d0">EVENT</data>
      <data key="d1">Interconsultations refer to consultations between different healthcare services to provide comprehensive patient care.</data>
      <data key="d2">f73cc4b49b42b9c9d60bc906430ffe90</data>
      <data key="d3">1244</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15986</data>
      <data key="d7">ba06dfd195c94253b56685252747455f</data>
    </node>
    <node id="COST ALLOCATION">
      <data key="d0">EVENT</data>
      <data key="d1">Cost allocation is the process of identifying and assigning costs to different services or departments within a healthcare system.</data>
      <data key="d2">f73cc4b49b42b9c9d60bc906430ffe90</data>
      <data key="d5">2</data>
      <data key="d6">15987</data>
      <data key="d7">7c7c3ab24ecb48f0a121f551ddbe31d3</data>
    </node>
    <node id="CONSEJER&#205;AS DE SANIDAD">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Health Councils are regional governmental bodies that manage health services and policies within their jurisdictions.</data>
      <data key="d2">26765fd0d663c8708d7bd6a545de3e2c</data>
      <data key="d3">749</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15988</data>
      <data key="d7">4f036d495b7448149495d72de1d3a8ea</data>
    </node>
    <node id="SERVICIOS SANITARIOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Health services refer to the various medical and healthcare services provided to patients, including hospitals and outpatient care.</data>
      <data key="d2">26765fd0d663c8708d7bd6a545de3e2c</data>
      <data key="d3">749</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15989</data>
      <data key="d7">08efd9b6621e4112ae021a4d3a415f7b</data>
    </node>
    <node id="PRESUPUESTO">
      <data key="d0">EVENT</data>
      <data key="d1">The budget is a financial plan that quantifies the economic resources allocated for healthcare activities over a defined period.</data>
      <data key="d2">26765fd0d663c8708d7bd6a545de3e2c</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
