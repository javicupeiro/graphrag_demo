      <data key="d6">9961</data>
      <data key="d7">2f58764435ea4aeb9a5ccaf13523f9ea</data>
    </node>
    <node id="SUCRASE-ISOMALTASE THERAPY">
      <data key="d0">EVENT</data>
      <data key="d1">Sucrase-isomaltase therapy is a treatment approach for individuals with congenital sucrase-isomaltase deficiency, involving enzyme replacement.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68</data>
      <data key="d5">0</data>
      <data key="d6">9962</data>
      <data key="d7">9d1aed1c32ee4b2b80fe998e076a9e29</data>
    </node>
    <node id="13C-BREATH TEST">
      <data key="d0">EVENT</data>
      <data key="d1">The 13C-breath test is a diagnostic tool used to assess carbohydrate digestion, particularly in conditions like congenital sucrase-isomaltase deficiency.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68</data>
      <data key="d5">0</data>
      <data key="d6">9963</data>
