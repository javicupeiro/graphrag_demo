    <node id="ENTEROCOLITIS NECROSANTE">
      <data key="d0">EVENT</data>
      <data key="d1">La enterocolitis necrosante es una complicaci&#243;n grave que puede afectar a los reci&#233;n nacidos prematuros, caracterizada por la inflamaci&#243;n y la muerte del tejido intestinal.</data>
      <data key="d2">724f16660e0077267b0836a0e1fb02c3</data>
      <data key="d3">659</data>
      <data key="d4">2</data>
