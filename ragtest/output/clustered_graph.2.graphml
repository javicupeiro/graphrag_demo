      <data key="d7">04b8996ad3e048798b5a46d6a2cf979b</data>
    </node>
    <node id="HYPERNATREMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hypernatremia is a medical condition characterized by elevated sodium levels in the blood. This condition can arise in various clinical scenarios, including in patients receiving nutritional support, where careful monitoring of sodium levels is essential. Additionally, hypernatremia can occur in individuals with nephrogenic diabetes insipidus, a disorder that affects the kidneys' ability to concentrate urine, leading to increased sodium levels. Overall, hypernatremia necessitates vigilant observation and management to prevent potential complications associated with high sodium concentrations.</data>
      <data key="d2">1fb4c8ba1bc908ea3a3c7717a073fa4f,814d394c907e59b29a5f0d9e82aed423</data>
      <data key="d3">1257</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6207</data>
      <data key="d7">66681b47ec2948b3ab87675d4353eb30</data>
    </node>
    <node id="CIDOFOVIR">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Cidofovir is a medication that can cause acquired nephrogenic diabetes insipidus as a side effect.</data>
