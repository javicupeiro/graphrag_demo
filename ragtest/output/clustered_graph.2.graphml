    <edge source="ANTIBIOTIC THERAPY" target="SOPORTE NUTRICIONAL AVANZADO">
      <data key="d8">7.0</data>
      <data key="d9">SOPORTE NUTRICIONAL AVANZADO includes protocols for initiating antibiotic therapy in cases of infection related to catheters</data>
      <data key="d10">be901905a9eef428a784ea179931028a</data>
