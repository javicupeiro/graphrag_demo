      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="ADRENALINA">
      <data key="d8">9.0</data>
      <data key="d9">Los pacientes con alergias severas deben tener adrenalina disponible para emergencias</data>
      <data key="d10">0f0303399f29734dede9db544e1dda9e</data>
      <data key="d11">4605722fe88543909aefccf988bc4eee</data>
      <data key="d12">617</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="PADRES">
      <data key="d8">8.0</data>
      <data key="d9">Los padres son responsables de cuidar a los pacientes con alergias alimentarias</data>
      <data key="d10">0f0303399f29734dede9db544e1dda9e</data>
      <data key="d11">2dde21204c2d46268a3ad09c2159ca8d</data>
      <data key="d12">618</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="GASTROSTOM&#205;A ENDOSC&#211;PICA PERCUT&#193;NEA">
      <data key="d8">8.0</data>
      <data key="d9">Los pacientes son quienes se someten a la gastrostom&#237;a endosc&#243;pica percut&#225;nea y pueden experimentar complicaciones relacionadas.</data>
