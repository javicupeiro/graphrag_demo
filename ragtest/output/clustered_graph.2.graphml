      <data key="d5">2</data>
      <data key="d6">2840</data>
      <data key="d7">d13f46bda9ea4a01939abefa4cae64a0</data>
    </node>
    <node id="PSEUDOMONAS">
      <data key="d0">PERSON</data>
      <data key="d1">Pseudomonas is a genus of bacteria that can cause infections, particularly in immunocompromised patients.</data>
      <data key="d2">5ad53a3f16964261ae37b64f7c3cb688</data>
      <data key="d3">767</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">2841</data>
      <data key="d7">8bf72fd53a5e455c81a137e7d7e796fe</data>
    </node>
    <node id="CANDIDA SPP.">
      <data key="d0">PERSON</data>
      <data key="d1">Candida species are fungi that can cause infections, especially in patients with prolonged neutropenia or those undergoing certain treatments.</data>
