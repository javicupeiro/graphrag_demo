    </node>
    <node id="VIRGINIA PE&#209;A CORT&#201;S">
      <data key="d0">PERSON</data>
      <data key="d1">Virginia Pe&#241;a Cort&#233;s is a medical professional specializing in endocrinology and nutrition at Hospital Virgen de la Salud in Toledo.</data>
      <data key="d2">dce680808e039e852dc0f2639835db32</data>
      <data key="d3">1676</data>
