      <data key="d13">2</data>
    </edge>
    <edge source="PROTE&#205;NAS" target="MSUD">
      <data key="d8">7.0</data>
      <data key="d9">The dietary management of Maple Syrup Urine Disease includes specific protein requirements outlined for patients</data>
