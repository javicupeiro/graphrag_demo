    <node id="OMEGA-3 FATTY ACID">
      <data key="d0">EVENT</data>
      <data key="d1">Omega-3 fatty acids are essential nutrients that have garnered attention for their potential benefits in preventing dementia and enhancing cognitive performance.</data>
      <data key="d2">488affd4bfc1b1b4b9f5b6a054c97d80,91b470ee527a45d8e81a821eeb9ce259</data>
