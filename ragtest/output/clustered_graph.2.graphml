    <node id="FARMACOS QUIMIOTERAPICOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Chemotherapeutic agents can cause various side effects, including diarrhea, due to their impact on rapidly dividing cells in the gastrointestinal tract.</data>
      <data key="d2">d3e1df90991ea82fcccbd02589473ead</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
