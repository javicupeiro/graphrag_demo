    <edge source="CAMBIOS INVOLUNTARIOS EN EL PESO CORPORAL" target="MODIFICACIONES EN EL PATR&#211;N HABITUAL DE INGESTA">
      <data key="d8">1.0</data>
      <data key="d9">Los cambios involuntarios en el peso corporal pueden estar relacionados con modificaciones en el patr&#243;n habitual de ingesta</data>
      <data key="d10">cc6ee3d7bc9bfaf4a06f3f02c4907eb0</data>
