      <data key="d7">58934e47141c4ccb961a12280d324f9f</data>
    </node>
    <node id="CIRROSIS DESCOMPENSADA">
      <data key="d0">EVENT</data>
      <data key="d1">Decompensated cirrhosis is a severe liver condition that can develop in patients with Wilson's disease, leading to complications and potential transplantation.</data>
      <data key="d2">3898563966943dbfc8a0f6e84bc627b1</data>
      <data key="d3">1131</data>
