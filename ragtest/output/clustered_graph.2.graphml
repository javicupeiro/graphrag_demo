      <data key="d10">cf034f02916ec46dcba7e0f8d8e24c0c</data>
      <data key="d11">76bb1821ce534ed6ad24dfda3d1d2e6b</data>
      <data key="d12">5918</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="COMIT&#201; DE NUTRICI&#211;N DE LA AEP">
      <data key="d8">7.0</data>
      <data key="d9">Both organizations provide guidelines and recommendations for infant nutrition and health, particularly for breastfeeding and supplementation.</data>
      <data key="d10">2a1b909c98067bf7fc270d6f30199f96</data>
      <data key="d11">f528af6ab70f48bc9fc62e87c10fc1a1</data>
      <data key="d12">5919</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="ENVEJECIMIENTO Y NUTRICI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">The OMS provides definitions and guidelines that inform the principles of healthy aging discussed in the "Envejecimiento y Nutrici&#243;n" series</data>
      <data key="d10">d6c8f8036af0c4f0b6f7938c4bab491f</data>
      <data key="d11">37b0edd758a94860b3471537c33bafd0</data>
      <data key="d12">5920</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="QUEBEC LONGITUDINAL STUDY NUAGE">
      <data key="d8">4.0</data>
