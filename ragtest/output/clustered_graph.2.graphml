    <node id="BARES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los bares son establecimientos que sirven comidas y bebidas, donde se requiere informaci&#243;n obligatoria sobre los alimentos no envasados.</data>
      <data key="d2">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
