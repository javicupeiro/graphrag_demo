    <edge source="GESTATIONAL DIABETES MELLITUS" target="NUTRITION THERAPY">
      <data key="d8">9.0</data>
      <data key="d9">Nutrition therapy is crucial for managing Gestational Diabetes Mellitus to ensure healthy outcomes for mothers and babies.</data>
      <data key="d10">cd2217af0cd2e70226661f038043911b</data>
      <data key="d11">4a4f767d586f4291a70840ec38c0b3a5</data>
