      <data key="d13">2</data>
    </edge>
    <edge source="FEES" target="PLAN DE TRATAMIENTO">
      <data key="d8">7.0</data>
      <data key="d9">FEES is used as part of the treatment plan to assess the patient's swallowing function.</data>
      <data key="d10">e14475004a93d47a14d98dd4c5b5d02b</data>
      <data key="d11">65da5209f3274af499cd4651d96b28df</data>
