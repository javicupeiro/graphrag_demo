      <data key="d7">1c7acc991e81454198f8c757bd1395da</data>
    </node>
    <node id="ALTERACIONES VISUALES">
      <data key="d0">EVENT</data>
      <data key="d1">Las alteraciones visuales son un s&#237;ntoma neurol&#243;gico que puede aparecer en pacientes con tumores de la gl&#225;ndula pineal.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">3801</data>
      <data key="d7">22545a99f6da4a6cbaf5699d08833b08</data>
    </node>
    <node id="CEFALEA">
      <data key="d0">EVENT</data>
      <data key="d1">La cefalea es un s&#237;ntoma com&#250;n que aparece en el 73% de los casos de tumores pineales.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">3802</data>
      <data key="d7">3f67b07e9c0e477ba4ddae9a96038972</data>
    </node>
    <node id="NAUSEAS Y V&#211;MITOS">
      <data key="d0">EVENT</data>
      <data key="d1">Las n&#225;useas y v&#243;mitos son s&#237;ntomas que pueden presentarse en pacientes con tumores de la gl&#225;ndula pineal, afectando su calidad de vida.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">3803</data>
      <data key="d7">56915a0653a0406fb412adb9a9c04054</data>
    </node>
    <node id="ALTERACIONES EN LA DEAMBULACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Las alteraciones en la deambulaci&#243;n son un s&#237;ntoma que puede aparecer en pacientes con tumores de la gl&#225;ndula pineal, afectando su movilidad.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
