      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15544</data>
      <data key="d7">5490b9ddf36e42c0ba499e953776a0e6</data>
    </node>
    <node id="DIURESIS OSM&#211;TICA">
      <data key="d0">EVENT</data>
      <data key="d1">Diuresis osm&#243;tica is a condition that can result from excessive glucose administration, leading to increased urine output and potential complications in patients.</data>
      <data key="d2">507eeea555c496a467930836fc4c1a39</data>
      <data key="d3">630</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15545</data>
      <data key="d7">194ddb4a0f1f4ea395cbc7d4c1942d57</data>
    </node>
    <node id="CO2">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">CO2, or carbon dioxide, is a byproduct of metabolism that can increase with excessive glucose intake, affecting respiratory function.</data>
      <data key="d2">507eeea555c496a467930836fc4c1a39</data>
      <data key="d3">630</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15546</data>
      <data key="d7">ea7a6ded0ad14bfaab1729f92e468315</data>
    </node>
    <node id="INTRALIPID">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">INTRALIPID is a lipid solution that was first marketed in the 1960s. It is composed of long-chain triglycerides derived from soybean oil and contains essential omega-3 and omega-6 fatty acids.</data>
      <data key="d2">a9268f98da988e7f94a3faf7bc7627c7,bb7584256e051f1c3d8cb13502ade155</data>
      <data key="d3">654</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">15547</data>
      <data key="d7">334e801131b24c29bd013f2dad226fa0</data>
    </node>
    <node id="OMEGAVEN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Omegaven is a lipid solution made exclusively from fish oil, designed to effectively treat specific conditions in pediatric patients. It is particularly beneficial for individuals suffering from liver disease related to parenteral nutrition, with a notable efficacy in those affected by short bowel syndrome.</data>
      <data key="d2">a9268f98da988e7f94a3faf7bc7627c7,bb7584256e051f1c3d8cb13502ade155</data>
      <data key="d3">659</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">15548</data>
      <data key="d7">295714d624334171ae8eb5f29c7c8e83</data>
    </node>
    <node id="RECI&#201;N NACIDO PRET&#201;RMINO">
      <data key="d0">PERSON</data>
      <data key="d1">"Reci&#233;n nacido pret&#233;rmino" refers to preterm newborns, which are infants born before 37 weeks of gestation. These infants often require specialized nutritional support and specific nutritional guidelines to ensure their health and development.</data>
      <data key="d2">a9268f98da988e7f94a3faf7bc7627c7,df73c75d84a055e0a67bc7f14d35e9d5</data>
      <data key="d3">630</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">15549</data>
      <data key="d7">78754e989eb244ca9870e5409476df57</data>
    </node>
    <node id="RECI&#201;N NACIDO A T&#201;RMINO">
      <data key="d0">PERSON</data>
      <data key="d1">Reci&#233;n nacido a t&#233;rmino refers to infants born between the 37th and 42nd week of pregnancy, with distinct nutritional needs.</data>
      <data key="d2">df73c75d84a055e0a67bc7f14d35e9d5</data>
      <data key="d3">630</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15550</data>
      <data key="d7">ecbe69cdb4fe4c96af76cdd945a70a83</data>
    </node>
    <node id="PRIMENE&#174;">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Primene&#174; es otra soluci&#243;n de amino&#225;cidos pedi&#225;tricos dise&#241;ada para satisfacer las necesidades nutricionales de los ni&#241;os.</data>
      <data key="d2">ee3d3ae4eef4cfe540602ad04ef172dc</data>
      <data key="d3">634</data>
      <data key="d4">2</data>
      <data key="d5">10</data>
      <data key="d6">15551</data>
      <data key="d7">ab0a6373fc064a17bce5720bf56b23b7</data>
    </node>
    <node id="AMINOPLASMAL PAED&#174;">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Aminoplasmal Paed&#174; es una f&#243;rmula de amino&#225;cidos pedi&#225;tricos que proporciona nutrientes esenciales para el crecimiento y desarrollo de los ni&#241;os.</data>
      <data key="d2">ee3d3ae4eef4cfe540602ad04ef172dc</data>
      <data key="d3">588</data>
