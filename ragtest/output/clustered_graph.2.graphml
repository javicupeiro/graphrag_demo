    <node id="DIABETES TIPO I Y II">
      <data key="d0">EVENT</data>
      <data key="d1">Diabetes tipo I y II are forms of diabetes that may have a reduced risk in individuals who were breastfed as infants.</data>
      <data key="d2">d0a687d823ff2f3d5cb0f20b01d8530e</data>
