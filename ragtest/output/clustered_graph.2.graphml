    </node>
    <node id="ENFERMEDAD CARDIOMETAB&#211;LICA">
      <data key="d0">EVENT</data>
      <data key="d1">La enfermedad cardiometab&#243;lica es un factor de riesgo modificable que se ha relacionado con la demencia y otros problemas de salud.</data>
      <data key="d2">01302d2656a8cbb49cb7505b3182cc63,035d53a7f46fdb72c0a939265667044b</data>
