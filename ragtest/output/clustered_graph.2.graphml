      <data key="d6">2081</data>
      <data key="d7">09f337006aba4d39ad2b9216429b58bf</data>
    </node>
    <node id="SURGICAL PATIENT">
      <data key="d0">PERSON</data>
      <data key="d1">Surgical patients are individuals undergoing surgery who may require nutritional assessment and support.</data>
      <data key="d2">d23c564df025cf16e37f2ef2be83ec34</data>
      <data key="d3">1249</data>
