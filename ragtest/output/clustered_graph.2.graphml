      <data key="d10">d2e2009d967ecd49af312dba4e2ed4fd</data>
      <data key="d11">0718ed1ff2714db99a26a81b42ff10b9</data>
      <data key="d12">11369</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPA" target="NUTRICIONAL INFORMACI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">Nutritional information regulations are established in Europa, ensuring food products disclose their nutrient content</data>
