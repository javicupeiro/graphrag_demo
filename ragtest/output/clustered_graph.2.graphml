      <data key="d11">17464eb8935a40c2b0c24cdfa3ca24cf</data>
      <data key="d12">7809</data>
      <data key="d13">2</data>
    </edge>
    <edge source="E. L&#211;PEZ BRIZ" target="NUTRICI&#211;N POR SONDA">
      <data key="d8">7.0</data>
      <data key="d9">E. L&#243;pez Briz contributed to the recommendations for enteral nutrition practices</data>
      <data key="d10">58e7286e0ab9d6d52b4c70dadb8b001f</data>
      <data key="d11">38fefa99ea1e48169b2ecc73d002655d</data>
