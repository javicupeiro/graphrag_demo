    </node>
    <node id="ESPACIO PLEURAL">
      <data key="d0">GEO</data>
      <data key="d1">The pleural space is the area between the lungs and the chest wall, which can be affected by conditions like pneumothorax or empyema.</data>
      <data key="d2">58e7286e0ab9d6d52b4c70dadb8b001f</data>
      <data key="d5">0</data>
      <data key="d6">1902</data>
      <data key="d7">28ffac023db542469a6eead8aebaac1c</data>
