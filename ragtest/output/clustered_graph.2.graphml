    </node>
    <node id="HIRSUTISMO">
      <data key="d0">EVENT</data>
      <data key="d1">Hirsutismo is a condition characterized by excessive or abnormal hair growth in women, particularly in areas where men typically grow hair. This condition is often associated with increased androgen levels, a phenomenon known as hyperandrogenism, and can arise from various underlying causes, including hormonal imbalances.</data>
      <data key="d2">401a6af689562ae0b9d7fe627eb56d0f,88a8ebb15abeea8eaded56ef3d2df73f,b30c94def1763c77fe1fc302cc896d6c,bcb4f7ab0760e548b520c667b305722a</data>
      <data key="d3">1289</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">3635</data>
      <data key="d7">942ac65897bb44508670542405d70c64</data>
    </node>
    <node id="TRANSEXUALES">
      <data key="d0">PERSON</data>
      <data key="d1">Transexuales refers to individuals whose gender identity differs from the sex they were assigned at birth, often undergoing medical procedures for transition.</data>
      <data key="d2">bcb4f7ab0760e548b520c667b305722a</data>
