    <node id="POSTOPERATIVE NUTRITION">
      <data key="d0">EVENT</data>
      <data key="d1">Postoperative nutrition involves protocols to ensure oral intake and may include artificial nutrition if necessary.</data>
      <data key="d2">d23c564df025cf16e37f2ef2be83ec34</data>
