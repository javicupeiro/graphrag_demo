    <node id="NRS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">El NRS (Nutritional Risk Screening) es una herramienta que se utiliza para identificar el riesgo nutricional en pacientes.</data>
      <data key="d2">cc6ee3d7bc9bfaf4a06f3f02c4907eb0</data>
