    <node id="CRITICAL CARE NUTRITION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Critical Care Nutrition is a guideline organization dedicated to providing recommendations and clinical practice guidelines for nutritional support in critically ill patients. It focuses on optimizing nutrition in critical care settings to enhance patient outcomes and improve recovery processes.</data>
      <data key="d2">21e6d7085f520d8a2f415746dc7eab71,7f3e164582a504c9fe6bdbc56e1a8e97</data>
      <data key="d3">1838</data>
