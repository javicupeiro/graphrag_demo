      <data key="d5">0</data>
      <data key="d6">16274</data>
      <data key="d7">0da684055a924e9298ec9448fc9e9a8c</data>
    </node>
    <node id="PACIENTES CON ENCEFALOPAT&#205;A HEP&#193;TICA CR&#211;NICA">
      <data key="d0">PERSON</data>
      <data key="d1">Patients with chronic hepatic encephalopathy may need enteral nutrition due to dietary protein intolerance.)&lt;|COMPLETE|&gt;</data>
