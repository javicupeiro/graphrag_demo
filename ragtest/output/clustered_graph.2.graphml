    <edge source="PARLAMENTO EUROPEO" target="EU">
      <data key="d8">5.0</data>
      <data key="d9">The Parlamento Europeo is part of the EU and is involved in legislative processes regarding food standards</data>
      <data key="d10">54a47e2936e787ab5943e2d75afc03f1</data>
      <data key="d11">b81c0ea174c0442f87a671b724097a00</data>
      <data key="d12">5155</data>
      <data key="d13">2</data>
    </edge>
    <edge source="UNI&#211;N EUROPEA" target="FAO">
      <data key="d8">12.0</data>
      <data key="d9">The FAO (Food and Agriculture Organization) and the Uni&#243;n Europea (European Union) work together to develop and implement guidelines and policies that address nutrition and food security. Their collaboration also extends to the establishment of food safety standards and regulations, ensuring that food systems are safe and effective across member states. This partnership highlights their commitment to improving food quality and accessibility while promoting health and safety in the food supply chain.</data>
      <data key="d10">3128497d6ade013c21bc21fd378528fb,a4b56b993221a7065a59bca622c02953</data>
      <data key="d11">b97e6b84449f48978afe7250bfd31d4e</data>
      <data key="d12">5156</data>
      <data key="d13">2</data>
    </edge>
    <edge source="UNI&#211;N EUROPEA" target="ESPGHAN">
      <data key="d8">6.0</data>
      <data key="d9">ESPGHAN's recommendations for infant formula composition are based on the standards set by the European Union.</data>
      <data key="d10">2a1b909c98067bf7fc270d6f30199f96</data>
      <data key="d11">c5065fbee4dc4c5eadc9a577c4563e5b</data>
      <data key="d12">5157</data>
      <data key="d13">2</data>
    </edge>
