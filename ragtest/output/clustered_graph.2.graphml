      <data key="d13">2</data>
    </edge>
    <edge source="POTASIO" target="CAD">
      <data key="d8">8.0</data>
      <data key="d9">Potassium levels can be critically high in patients with CAD, requiring careful monitoring and management</data>
      <data key="d10">8bcf09481326ab5017cc3b45317538a3</data>
      <data key="d11">afa8290ece9b4377b07d0a06e5bece21</data>
