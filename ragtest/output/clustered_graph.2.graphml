    <node id="HYPERTHYROIDISM">
      <data key="d0">EVENT</data>
      <data key="d1">A medical condition characterized by excessive thyroid hormone production, which can affect pregnancy.</data>
      <data key="d2">1dc3bddf85e4bb26e46f373169e43b14</data>
      <data key="d3">1518</data>
