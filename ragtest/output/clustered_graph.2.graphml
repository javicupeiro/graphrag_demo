      <data key="d7">751e59832fda4982a61ca848a694e3d6</data>
    </node>
    <node id="UROLITIASIS">
      <data key="d0">EVENT</data>
      <data key="d1">La urolitiasis es la formaci&#243;n de c&#225;lculos en el tracto urinario, que puede ser consecuencia de la hiperuricemia y la acumulaci&#243;n de &#225;cido &#250;rico.</data>
      <data key="d2">3ea911f4fe93a5403638aacc9085b483</data>
