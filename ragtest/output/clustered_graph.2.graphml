    <node id="CONGENITAL SUCRASE-ISOMALTASE DEFICIENCY">
      <data key="d0">EVENT</data>
      <data key="d1">Congenital sucrase-isomaltase deficiency is a genetic disorder that impairs the digestion of sucrose and maltose, leading to gastrointestinal symptoms.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68</data>
      <data key="d5">0</data>
      <data key="d6">9958</data>
