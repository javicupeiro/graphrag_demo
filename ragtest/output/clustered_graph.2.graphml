      <data key="d13">2</data>
    </edge>
    <edge source="&#205;LEO G&#193;STRICO" target="SONDA NASOENTERAL">
      <data key="d8">6.0</data>
      <data key="d9">La sonda nasoenteral se utiliza para alimentar a pacientes que presentan &#237;leo g&#225;strico en el postoperatorio inmediato.</data>
      <data key="d10">838b9736f0199a50d032077e4b74cbc6</data>
      <data key="d11">fa57b6f7a8dd48e581729031703b044f</data>
