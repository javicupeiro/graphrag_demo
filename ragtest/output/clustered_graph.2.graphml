    </node>
    <node id="MRC">
      <data key="d0">EVENT</data>
      <data key="d1">The Medical Research Council (MRC) dyspnea scale is a tool used to measure the degree of breathlessness in patients.</data>
      <data key="d2">cc406ffdbe4f62a6f2d9763ee4888fdf</data>
      <data key="d3">1040</data>
      <data key="d4">2</data>
