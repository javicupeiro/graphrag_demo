      <data key="d7">41564ce2d5864c7d8a50b14fad2c1d63</data>
    </node>
    <node id="ANXIETAD">
      <data key="d0">EVENT</data>
      <data key="d1">Anxiety is a psychological condition that may arise in patients dealing with the challenges of dysphagia.</data>
      <data key="d2">98f9ca00cf50b7e359aa41f1d58d0735</data>
