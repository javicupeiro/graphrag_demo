    <node id="HOSPITAL CL&#205;NICO UNIVERSITARIO LOZANO BLESA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The University Clinical Hospital Lozano Blesa in Zaragoza provides healthcare services and is involved in clinical nutrition and dietetics.</data>
      <data key="d2">45c3281fd6beffb0e9ac61ae5700af3d</data>
      <data key="d3">1472</data>
      <data key="d4">2</data>
