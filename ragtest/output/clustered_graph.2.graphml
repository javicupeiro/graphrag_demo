    <node id="BOT&#211;N DE GASTROSTOM&#205;A">
      <data key="d0">EVENT</data>
      <data key="d1">El bot&#243;n de gastrostom&#237;a es un dispositivo que permite la colocaci&#243;n de una v&#225;lvula unidireccional en el punto de inserci&#243;n de la gastrostom&#237;a.</data>
      <data key="d2">e569eda9506ef1e77080a8120e388963</data>
      <data key="d3">1081</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15437</data>
