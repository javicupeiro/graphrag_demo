      <data key="d12">12657</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADENOMA HIPOFISARIO" target="HORMONAS">
      <data key="d8">1.0</data>
      <data key="d9">Los adenomas hipofisarios pueden causar alteraciones en la producci&#243;n de hormonas</data>
      <data key="d10">755475a08c9b594dacee6386b782065f</data>
      <data key="d11">9deb7d1bdb2e4168b4488ffceedba9bc</data>
      <data key="d12">12658</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADENOMA HIPOFISARIO" target="HIPERPARATIROIDISMO">
      <data key="d8">6.0</data>
      <data key="d9">Hiperparatiroidismo can be associated with adenomas in the pituitary gland, affecting hormone levels</data>
