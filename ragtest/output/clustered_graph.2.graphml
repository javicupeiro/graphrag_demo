      <data key="d12">5578</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GASTROSTOM&#205;A" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">7.0</data>
      <data key="d9">GASTROSTOM&#205;A is a procedure relevant to pediatric nutrition for patients needing long-term feeding</data>
      <data key="d10">70e48774a3f732e015a59d38ba2fa5d5</data>
      <data key="d11">401c24576d0841aaba2e87670822875c</data>
      <data key="d12">5579</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GASTROSTOM&#205;A" target="ANESTESIA GENERAL">
      <data key="d8">9.0</data>
      <data key="d9">GASTROSTOM&#205;A is performed under ANESTESIA GENERAL to ensure patient comfort</data>
      <data key="d10">70e48774a3f732e015a59d38ba2fa5d5</data>
