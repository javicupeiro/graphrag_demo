      <data key="d11">0049f6a5e85b4806be21d6a1d8a5ca4d</data>
      <data key="d12">10838</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESTUDIO FRALLE" target="CLAYMAN">
