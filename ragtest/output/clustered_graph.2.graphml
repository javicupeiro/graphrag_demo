      <data key="d7">b88273a9f61942eba1104237939da031</data>
    </node>
    <node id="PATIENTS WITH DM">
      <data key="d0">PERSON</data>
      <data key="d1">Patients with Diabetes Mellitus often require tailored dietary plans to manage their condition effectively.</data>
      <data key="d2">502bae6c907e900b95f5fe6aa963b0fc</data>
      <data key="d3">1719</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">9357</data>
      <data key="d7">f42a553978d146d294c5cb03a0062d75</data>
    </node>
    <node id="NUTRITIONAL MONITORING">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional monitoring involves tracking dietary intake and its effects on health, particularly important for managing diabetes.</data>
      <data key="d2">502bae6c907e900b95f5fe6aa963b0fc</data>
