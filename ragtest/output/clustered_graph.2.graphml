      <data key="d11">2e0511d77728455db0ec90193b5122ae</data>
      <data key="d12">17057</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLLER&#205;A" target="SORBITOL">
      <data key="d8">6.0</data>
