      <data key="d8">6.0</data>
      <data key="d9">The MUST can help identify malnutrition risk in patients receiving home parenteral nutrition.</data>
      <data key="d10">8ccd7ff955c5b8a333f23f41e34c563a</data>
      <data key="d11">9cd1f15ba6664fc8b0236967cd6851db</data>
