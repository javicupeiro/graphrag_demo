    <node id="PRACTICA CL&#205;NICA">
      <data key="d0">EVENT</data>
      <data key="d1">La pr&#225;ctica cl&#237;nica es el proceso de atenci&#243;n m&#233;dica que se basa en la evidencia y la experiencia del m&#233;dico para tomar decisiones sobre el tratamiento de los pacientes.</data>
      <data key="d2">7dbb13ddc40e2f4d060338cabf9ecea7</data>
      <data key="d3">1277</data>
      <data key="d4">2</data>
