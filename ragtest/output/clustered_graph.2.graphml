    <node id="AGCL">
      <data key="d0">EVENT</data>
      <data key="d1">Los &#225;cidos grasos de cadena larga (AGCL) son un tipo de grasa que puede verse afectada en trastornos metab&#243;licos, especialmente en la &#946;-oxidaci&#243;n.</data>
      <data key="d2">2f96bbc5eafd39b659620da7282a2079</data>
