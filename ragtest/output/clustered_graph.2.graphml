      <data key="d0">PERSON</data>
      <data key="d1">Abou-Assi es un autor de un estudio que compara la nutrici&#243;n enteral y parenteral en pacientes con pancreatitis aguda.</data>
      <data key="d2">be7eb01a6daf673db6a127f66c79c96c</data>
