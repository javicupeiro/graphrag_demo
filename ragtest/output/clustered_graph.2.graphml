    <node id="TRILOSTANE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Trilostane is a medication that blocks the synthesis of adrenal steroid hormones, indicated for treating hyperadrenocorticism in dogs.</data>
      <data key="d2">4c034422eb6302c32e0d5fdce5b3046d</data>
      <data key="d3">1332</data>
      <data key="d4">2</data>
