    <node id="ARGINOSUCCINATO SINTETASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Arginosuccinato sintetasa (ASS) is an enzyme that facilitates the synthesis of argininosuccinate from citrulline and aspartate in the urea cycle.</data>
      <data key="d2">0487e1a4525547575a1d284297280f9a</data>
      <data key="d5">2</data>
      <data key="d6">10688</data>
      <data key="d7">dccaf99efb20440eb4682451c0fc376f</data>
    </node>
    <node id="ARGINOSUCCINATO LIASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Arginosuccinato liasa (ASL) is an enzyme that catalyzes the conversion of argininosuccinate to arginine and fumarate in the urea cycle.</data>
      <data key="d2">0487e1a4525547575a1d284297280f9a</data>
      <data key="d5">2</data>
      <data key="d6">10689</data>
