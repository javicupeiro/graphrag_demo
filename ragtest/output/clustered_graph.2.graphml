    </node>
    <node id="FISHER">
      <data key="d0">PERSON</data>
      <data key="d1">A researcher who has contributed to the literature on diabetes care and hyperglycemic crises.</data>
      <data key="d2">cda0904fd9d29455ee008c43bc9f7b41</data>
      <data key="d3">1852</data>
