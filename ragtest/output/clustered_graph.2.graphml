    </edge>
    <edge source="ACROMEGALY" target="HORMONAL DISORDER">
      <data key="d8">9.0</data>
      <data key="d9">Acromegaly is a type of hormonal disorder characterized by excess growth hormone</data>
      <data key="d10">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d11">c05aad7beb2142d481cbf612ef32cb28</data>
      <data key="d12">12928</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACROMEGALY" target="TUMORS">
      <data key="d8">8.0</data>
      <data key="d9">Tumors such as microadenomas and macroadenomas are often the cause of acromegaly</data>
      <data key="d10">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d11">70a1a413f91b4246b3768fdfd58cb8fd</data>
