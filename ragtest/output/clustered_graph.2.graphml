      <data key="d10">f757d4ff813fdf7b43b3382e7e1bd69c</data>
      <data key="d11">95034809706841ca99a2c896475c1cf0</data>
      <data key="d12">4714</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="VITAMINA E">
      <data key="d8">8.0</data>
      <data key="d9">Vitamin E is included in parenteral nutrition to protect cells from oxidative stress</data>
      <data key="d10">f757d4ff813fdf7b43b3382e7e1bd69c</data>
      <data key="d11">eb6c50fe3bd54dfb98a77aaf4c00b643</data>
      <data key="d12">4715</data>
