      <data key="d10">46466da830644a88f74108645c668fd5</data>
      <data key="d11">30d135cf46864cc59a8d1dd68af80790</data>
      <data key="d12">13293</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="CARCINOID SYNDROME">
      <data key="d8">1.0</data>
      <data key="d9">Carcinoid syndrome can lead to episodes of hypoglycemia due to the release of vasoactive substances</data>
      <data key="d10">46466da830644a88f74108645c668fd5</data>
      <data key="d11">2b569b3bbe1b4c72b0a3fc30abcb7dca</data>
      <data key="d12">13294</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="INSULINOMA">
      <data key="d8">9.0</data>
      <data key="d9">Insulinoma causes hypoglycemia due to excessive insulin production</data>
      <data key="d10">46466da830644a88f74108645c668fd5</data>
      <data key="d11">b72ef9a37276472f8871215c6df4a3c5</data>
      <data key="d12">13295</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="FIBROSARCOMA">
      <data key="d8">6.0</data>
      <data key="d9">Fibrosarcoma can lead to hypoglycemia through the overproduction of IGF-2</data>
      <data key="d10">46466da830644a88f74108645c668fd5</data>
      <data key="d11">775b53cb49bc459ab0e5d3548467d46d</data>
      <data key="d12">13296</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="HEMANGIOPERICITOMA">
      <data key="d8">6.0</data>
      <data key="d9">Hemangiopericytoma can cause hypoglycemia due to similar mechanisms as other tumors producing IGF-2</data>
      <data key="d10">46466da830644a88f74108645c668fd5</data>
      <data key="d11">f2cac9ecddec49f2851ab5f4bc5efe49</data>
      <data key="d12">13297</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="HEPATOCARCINOMA">
      <data key="d8">6.0</data>
      <data key="d9">Hepatocarcinoma can lead to hypoglycemia through the overproduction of IGF-2</data>
      <data key="d10">46466da830644a88f74108645c668fd5</data>
      <data key="d11">abb480c5c046417fb2461f962334a35a</data>
      <data key="d12">13298</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="GROWTH HORMONE (GH)">
      <data key="d8">1.0</data>
      <data key="d9">Growth hormone levels are suppressed during hypoglycemia, affecting glucose metabolism</data>
      <data key="d10">46466da830644a88f74108645c668fd5</data>
      <data key="d11">df94bc1e16334ea49cadb49ef1a1632e</data>
      <data key="d12">13299</data>
