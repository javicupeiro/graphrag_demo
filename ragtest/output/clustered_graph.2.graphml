      <data key="d6">1268</data>
      <data key="d7">2f21a54ba6dd485e9d6f603359a5e9b3</data>
    </node>
    <node id="DRA. HELENA BASCU&#209;ANA">
      <data key="d0">PERSON</data>
      <data key="d1">Dr. Helena Bascu&#241;ana is a medical professional who is currently leading the TRHLab project at Hospital San Pau, where she focuses on tele-rehabilitation for patients suffering from dysphagia. In addition to her work in tele-rehabilitation, Dr. Bascu&#241;ana has also created valuable video content on dysphagia, which is available on YouTube, further contributing to the awareness and understanding of this condition.</data>
      <data key="d2">ac81cd68683925828178b289759d58a9,d3fe4efde8231eb48c021e46ca13e219</data>
