    </node>
    <node id="HIPOGONADISMOS">
      <data key="d0">EVENT</data>
      <data key="d1">Hipogonadismos refers to conditions where the body doesn't produce enough sex hormones, affecting sexual development and function.</data>
      <data key="d2">bcb4f7ab0760e548b520c667b305722a</data>
