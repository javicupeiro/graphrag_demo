    </edge>
    <edge source="CALCIO" target="CITRICOS">
      <data key="d8">6.0</data>
      <data key="d9">Citrus fruits provide vitamin C, which helps in the absorption of calcium</data>
      <data key="d10">ae2bf939fd143e4d8d998722ad86ba66</data>
