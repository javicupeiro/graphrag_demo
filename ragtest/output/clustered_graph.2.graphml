    </node>
    <node id="POST-LIVER TRANSPLANTATION SARCOPENIA">
      <data key="d0">EVENT</data>
      <data key="d1">Post-liver transplantation sarcopenia is a condition characterized by loss of muscle mass and strength following liver transplantation, often evaluated in patients with liver cirrhosis.</data>
      <data key="d2">e2f9ec03a9b71e608bdd14455b0595a6</data>
      <data key="d3">1514</data>
      <data key="d4">2</data>
