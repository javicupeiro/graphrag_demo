    <node id="FRAMINGHAM HEART STUDY">
      <data key="d0">EVENT</data>
      <data key="d1">The Framingham Heart Study is a long-term, ongoing cardiovascular cohort study that has also explored the relationship between diet and cognitive health.</data>
      <data key="d2">91b470ee527a45d8e81a821eeb9ce259</data>
