    <node id="HEALTH PROFESSIONALS FOLLOW-UP STUDY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Health Professionals Follow-up Study is a long-term epidemiological study that has provided valuable information on the association between food consumption and diseases over 26 years.</data>
      <data key="d2">e1766b4a9f6cff776650a29195cee9fc</data>
      <data key="d3">1631</data>
      <data key="d4">2</data>
