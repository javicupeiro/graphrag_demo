    </edge>
    <edge source="MUSCULATURA OROFAR&#205;NGEA" target="MANIOBRAS DEGLUTORIAS">
      <data key="d8">8.0</data>
      <data key="d9">The oropharyngeal musculature is trained through swallowing maneuvers to improve swallowing function</data>
      <data key="d10">c257fcbbfdc5ac2678d371cee5c12edf</data>
      <data key="d11">bca12e40012e4d7b9cd68b7b5db296b3</data>
