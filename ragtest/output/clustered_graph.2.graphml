    </edge>
    <edge source="RESECCI&#211;N INTESTINAL" target="MALABSORCI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">Intestinal resection can lead to malabsorption due to the reduced surface area for nutrient absorption</data>
      <data key="d10">d147df5b06fa62d87b7edd3f20dcd246</data>
      <data key="d11">735a6f5585df406aa5f95b850f89439a</data>
