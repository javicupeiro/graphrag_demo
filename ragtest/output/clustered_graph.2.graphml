    <node id="FILTRADO GLOMERULAR ESTIMADO">
      <data key="d0">EVENT</data>
      <data key="d1">The estimated glomerular filtration rate is a test used to assess kidney function and is referenced in cardiovascular risk assessment.</data>
      <data key="d2">ce43a9a4cdf2497b2f984547a2787fff</data>
