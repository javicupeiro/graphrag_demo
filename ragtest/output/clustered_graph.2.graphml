    </node>
    <node id="DESMINERALIZACI&#211;N &#211;SEA">
      <data key="d0">EVENT</data>
      <data key="d1">Desmineralizaci&#243;n &#243;sea is a risk for patients on a ketogenic diet due to chronic acidosis, leading to potential osteopenia.</data>
      <data key="d2">bf7fc15e1aac41553dc6586efe68b8cb</data>
      <data key="d3">1940</data>
      <data key="d4">2</data>
