      <data key="d6">3689</data>
      <data key="d7">a4a3fca71e0b40f09fdf1f0b3bad5ffa</data>
    </node>
    <node id="CITOCINAS">
      <data key="d0" />
      <data key="d1">CITOCINAS son prote&#237;nas que desempe&#241;an un papel crucial en la comunicaci&#243;n celular. Estas mol&#233;culas son fundamentales para influir en la inflamaci&#243;n y la respuesta inmune del organismo.</data>
      <data key="d2">78b093da6669fb9ed3258ed62a73260e,884a8370915a18a005fb2fa913e4b95c,88dcf64f61e33adc3702b1ec401e2d4e</data>
