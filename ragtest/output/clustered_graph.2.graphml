    </node>
    <node id="ANTICONCEPTIVOS">
      <data key="d0">EVENT</data>
      <data key="d1">Anticonceptivos are birth control medications that may interact with fentermina and topiramato, affecting menstrual cycles.</data>
      <data key="d2">af631316aa8584710d755d8c59e851b6</data>
      <data key="d5">0</data>
      <data key="d6">8607</data>
