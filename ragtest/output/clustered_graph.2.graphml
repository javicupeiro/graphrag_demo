    <edge source="HIV" target="INSUFICIENCIA SUPRARRENAL">
      <data key="d8">6.0</data>
      <data key="d9">HIV can lead to adrenal insufficiency as a rare complication</data>
      <data key="d10">c925b6205ea7a28ba24640c28ec558da</data>
      <data key="d11">7c611ef1ad1442e19ebf822adee2f9bf</data>
