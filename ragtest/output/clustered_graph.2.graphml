    </node>
    <node id="MCCARDLE'S DISEASE">
      <data key="d0">EVENT</data>
      <data key="d1">McArdle's disease is a glycogen storage disease characterized by an inability to break down glycogen in muscles, leading to exercise intolerance.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68</data>
      <data key="d5">0</data>
      <data key="d6">9959</data>
