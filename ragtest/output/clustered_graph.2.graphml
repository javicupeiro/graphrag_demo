    </node>
    <node id="ORGANISMOS MODIFICADOS GEN&#201;TICAMENTE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los organismos modificados gen&#233;ticamente (OMG) son productos que deben ser claramente indicados en las etiquetas si su presencia supera el 0,5%.</data>
      <data key="d2">8255943be503f6709a8e63d7d33b79d1</data>
