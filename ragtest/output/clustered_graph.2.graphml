    </node>
    <node id="ENZYME REPLACEMENT THERAPY">
      <data key="d0">EVENT</data>
      <data key="d1">Enzyme replacement therapy is a treatment for certain genetic disorders, including congenital sucrase-isomaltase deficiency, to provide the missing enzyme.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68</data>
      <data key="d5">0</data>
      <data key="d6">9964</data>
