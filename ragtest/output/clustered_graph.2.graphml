      <data key="d5">2</data>
      <data key="d6">1972</data>
      <data key="d7">e10e534237024729a92c143e34afc084</data>
    </node>
    <node id="PATTERN EGG">
      <data key="d0">EVENT</data>
      <data key="d1">The pattern egg formulation serves as a standard for amino acid solutions in the hospital.</data>
      <data key="d2">cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d3">1230</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">1973</data>
      <data key="d7">f0b061ef94764601bf68509824c5cad3</data>
    </node>
    <node id="ENCEPHALOPATHY">
      <data key="d0">EVENT</data>
      <data key="d1">Encephalopathy is a condition that may require specialized amino acid formulations for treatment.</data>
      <data key="d2">cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d3">1230</data>
      <data key="d4">2</data>
