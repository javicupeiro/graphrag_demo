      <data key="d0">ORGANIZATION</data>
      <data key="d1">Nutrison Est&#225;ndar is a brand of nutritional supplements that cater to patients requiring dietary adjustments, particularly for gluten and lactose intolerance.</data>
      <data key="d2">e6153f0024d75c281071b521b08ed53a</data>
