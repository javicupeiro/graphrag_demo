      <data key="d6">15489</data>
      <data key="d7">bbffe7845ef5485f8ecc1853a69d1db2</data>
    </node>
    <node id="S&#205;NDROME POSTENTERITIS">
      <data key="d0">EVENT</data>
      <data key="d1">S&#205;NDROME POSTENTERITIS is a condition that can occur in infants after gastrointestinal infections, affecting their dietary needs.</data>
      <data key="d2">8f2e38ed25a683975b314e8e56721ad6</data>
      <data key="d3">636</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15490</data>
      <data key="d7">a85376936b4040fdac08a25a57244374</data>
    </node>
    <node id="APLV">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">APLV refers to the allergy to cow's milk protein mediated by IgE, which is a condition affecting infants and children.</data>
      <data key="d2">08d66dc8414668a3ec627a1e164cfa6c</data>
      <data key="d3">454</data>
