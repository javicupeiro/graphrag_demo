      <data key="d6">7688</data>
      <data key="d7">157cd4e5154b48bc9a4347c81f309356</data>
    </node>
    <node id="INTERNATIONAL JOURNAL OF CLINICAL PRACTICE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The International Journal of Clinical Practice is a peer-reviewed journal dedicated to publishing research on clinical practices and guidelines in the field of medicine. It focuses on various aspects of clinical research and practice, including studies related to cancer risk and dietary factors. The journal serves as a platform for disseminating important findings that can influence clinical practices and improve patient care.</data>
      <data key="d2">1d7ac56ec0eb2f724386a39de8551134,97c27548ceb554d425303875efc5f9b4,bb2e69a0ff4c25a21149882162922c8d</data>
      <data key="d3">440</data>
