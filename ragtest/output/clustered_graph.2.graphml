    <node id="PROTECCI&#211;N G&#193;STRICA">
      <data key="d0">EVENT</data>
      <data key="d1">A dietary approach aimed at minimizing mechanical and chemical stimulation of the stomach, often involving low-fiber and low-acid foods.</data>
      <data key="d2">4681d149c863ed06c99b19443f841abd</data>
      <data key="d3">1445</data>
