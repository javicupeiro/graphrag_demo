    <node id="MITOTAN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Mitotan is a medication used primarily in the treatment of adrenal carcinoma, which also inhibits steroidogenesis and has adrenolytic effects.</data>
      <data key="d2">b2ca509109e853875e707e29a98391e0</data>
      <data key="d3">1332</data>
      <data key="d4">2</data>
