      <data key="d10">473502714ce73073f93b598ca0edcc21</data>
      <data key="d11">ffdecec3f4044f85b3d814446da8a47f</data>
      <data key="d12">14648</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE BARTTER" target="BOCKENHAUER D">
      <data key="d8">7.0</data>
      <data key="d9">Bockenhauer D ha contribuido a la literatura sobre el s&#237;ndrome de Bartter</data>
      <data key="d10">473502714ce73073f93b598ca0edcc21</data>
      <data key="d11">5546b5bb33fb4c1f9615460f7507ee04</data>
      <data key="d12">14649</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHILADELPHIA" target="STEWARD PM">
      <data key="d8">1.0</data>
      <data key="d9">Steward PM's work is published in Philadelphia by Elsevier.</data>
      <data key="d10">209bcca22090a109f52e26657bf3c999</data>
      <data key="d11">ea983d97ef924e0c8bc275b3b90f7396</data>
      <data key="d12">14650</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHILADELPHIA" target="REED LARSEN P">
      <data key="d8">5.0</data>
      <data key="d9">The Williams Textbook of Endocrinology, authored by Reed Larsen P and others, is published in Philadelphia</data>
      <data key="d10">6aa8928e063b4107007dc14cc1b301bd</data>
      <data key="d11">ba125a87d0414c77ab2ed39cfa57197a</data>
      <data key="d12">14651</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHILADELPHIA" target="ELSEVIER">
      <data key="d8">1.0</data>
      <data key="d9">Philadelphia is the location of Elsevier's headquarters</data>
      <data key="d10">9944c8e8d3d7769c5297f8dfb9b6f664</data>
      <data key="d11">fc469b0bb7284258ab9f5cc28b2b8605</data>
      <data key="d12">14652</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHILADELPHIA" target="WELLS ET AL.">
      <data key="d8">4.0</data>
      <data key="d9">The guidelines revised by Wells et al. were published in a textbook by Elsevier, located in Philadelphia</data>
      <data key="d10">2415ccd829f700cbe1975f4bca87245f</data>
      <data key="d11">c5e9728b27744f769ef9e4178d235bcf</data>
      <data key="d12">14653</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHILADELPHIA" target="LIPPINCOTT-RAVEN">
      <data key="d8">8.0</data>
      <data key="d9">Lippincott-Raven is a publishing company based in Philadelphia, known for its medical texts</data>
      <data key="d10">47ba8105b81c59f81a9038446898d200</data>
      <data key="d11">a5ff7e6711b14b0494e25caecbd8d737</data>
      <data key="d12">14654</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHILADELPHIA" target="AJR">
      <data key="d8">4.0</data>
      <data key="d9">AJR publishes articles related to medical imaging, with some publications based in Philadelphia</data>
      <data key="d10">47ba8105b81c59f81a9038446898d200</data>
      <data key="d11">c2a6587894714049a3fba2975026a0d5</data>
      <data key="d12">14655</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADENOMA SUPRARRENAL" target="HYPERALDOSTERONISM">
      <data key="d8">8.0</data>
      <data key="d9">Adenoma suprarrenal can lead to hyperaldosteronism by producing excess aldosterone</data>
      <data key="d10">7f3df1437755b60344fdffd2ef3b8a9e</data>
      <data key="d11">6133df2666a74f7784bd051771c82be0</data>
      <data key="d12">14656</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM FAMILIAR TIPO 1" target="HYPERALDOSTERONISM">
      <data key="d8">9.0</data>
      <data key="d9">Familial hyperaldosteronism type 1 is a specific form of hyperaldosteronism caused by genetic factors</data>
      <data key="d10">7f3df1437755b60344fdffd2ef3b8a9e</data>
      <data key="d11">764d76df1e8b451a821058f7da1900e3</data>
      <data key="d12">14657</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM FAMILIAR TIPO 2" target="HYPERALDOSTERONISM">
      <data key="d8">8.0</data>
      <data key="d9">Familial hyperaldosteronism type 2 is another form of hyperaldosteronism that presents similarly to primary hyperaldosteronism</data>
      <data key="d10">7f3df1437755b60344fdffd2ef3b8a9e</data>
      <data key="d11">44b1bec8d2ed4e87aa6c5aec28c6f578</data>
      <data key="d12">14658</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM" target="HYPERTENSION ARTERIAL (HTA)">
      <data key="d8">8.0</data>
      <data key="d9">Hyperaldosteronism is often associated with hypertension arterial (HTA), causing elevated blood pressure levels.</data>
      <data key="d10">05edb31ec01c621a00d71bd5868784e0</data>
      <data key="d11">bc0ef21c90504af0ac48bcec42603d7d</data>
      <data key="d12">14659</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM" target="PRIMARY ALDOSTERONISM">
      <data key="d8">9.0</data>
      <data key="d9">Hyperaldosteronism is synonymous with primary aldosteronism, both referring to excessive aldosterone production.</data>
      <data key="d10">05edb31ec01c621a00d71bd5868784e0</data>
      <data key="d11">085e4e76e8a346288792266fcb2f2d76</data>
      <data key="d12">14660</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM" target="ADENOMA PRODUCTOR DE ALDOSTERONA">
      <data key="d8">8.0</data>
      <data key="d9">The aldosterone-producing adenoma is a common cause of hyperaldosteronism, leading to increased aldosterone levels and hypertension.</data>
      <data key="d10">1cdfccda20ac47427fc4c103ddd87cf3</data>
      <data key="d11">37cc95e175ad4b39a160b5a1ed774e6d</data>
      <data key="d12">14661</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM" target="ADRENALCTOMY">
      <data key="d8">9.0</data>
      <data key="d9">Adrenalectomy is a recommended surgical treatment for patients with hyperaldosteronism caused by an aldosterone-producing adenoma.</data>
      <data key="d10">1cdfccda20ac47427fc4c103ddd87cf3</data>
      <data key="d11">dadaf7d76b5c497da13286fb4e02d9ea</data>
      <data key="d12">14662</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM" target="YOUNG WF, JR.">
      <data key="d8">1.0</data>
      <data key="d9">Young WF, Jr. is a key figure in the diagnosis and treatment guidelines for primary aldosteronism.</data>
      <data key="d10">1cdfccda20ac47427fc4c103ddd87cf3</data>
      <data key="d11">7041360a7c2e43faa3780a455660114d</data>
      <data key="d12">14663</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM" target="ESPIRONOLACTONA">
      <data key="d8">7.0</data>
      <data key="d9">Spironolactone is often used in the treatment of hyperaldosteronism to help manage hypertension and prevent hypokalemia.</data>
      <data key="d10">1cdfccda20ac47427fc4c103ddd87cf3</data>
      <data key="d11">f00cbfb6737b450195cde19fe65f964c</data>
      <data key="d12">14664</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERALDOSTERONISM" target="NIVEL DE RENINA">
      <data key="d8">6.0</data>
      <data key="d9">Renin levels are crucial for diagnosing hyperaldosteronism, as they help determine the underlying cause of hypertension.</data>
      <data key="d10">1cdfccda20ac47427fc4c103ddd87cf3</data>
      <data key="d11">dceecc65378d409184e4902475b565d6</data>
      <data key="d12">14665</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO FAMILIAR TIPO 3" target="KCNJ5">
      <data key="d8">16.0</data>
      <data key="d9">Hiperaldosteronismo familiar tipo 3 es una condici&#243;n m&#233;dica que se origina a partir de mutaciones en el gen KCNJ5. Este gen codifica el canal de potasio Kir 3.4, y las alteraciones en su secuencia gen&#233;tica son responsables del desarrollo de esta forma de hiperaldosteronismo.</data>
      <data key="d10">261db9bb173f461ca4f26fd087d3da2a,bb2f48277736ce24d1ff0310a682376d</data>
      <data key="d11">1e3e025172ca4702b3c5774b643af5be</data>
      <data key="d12">14666</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO FAMILIAR TIPO 3" target="SUPRARRENALES">
      <data key="d8">5.0</data>
      <data key="d9">Las disfunciones en las gl&#225;ndulas suprarrenales pueden provocar trastornos como el hiperaldosteronismo familiar tipo 3.</data>
      <data key="d10">261db9bb173f461ca4f26fd087d3da2a</data>
      <data key="d11">4c8bab9935604163b0529720b0a23369</data>
      <data key="d12">14667</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO FAMILIAR TIPO 3" target="HIPERALDOSTERONISMO PRIMARIO">
      <data key="d8">7.0</data>
      <data key="d9">El hiperaldosteronismo familiar tipo 3 es una variante del hiperaldosteronismo primario que presenta un fenotipo agresivo</data>
      <data key="d10">bb2f48277736ce24d1ff0310a682376d</data>
      <data key="d11">9345f3462201487bbf86809447e7abee</data>
      <data key="d12">14668</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEUDOHIPOALDOSTERONISMO" target="NR3C2">
      <data key="d8">8.0</data>
      <data key="d9">El seudohipoaldosteronismo renal tipo 1 est&#225; asociado a mutaciones en el gen NR3C2 que codifica el receptor de los mineralocorticoides.</data>
      <data key="d10">261db9bb173f461ca4f26fd087d3da2a</data>
      <data key="d11">36b81a22fd874888b993f7f226df7c12</data>
      <data key="d12">14669</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEUDOHIPOALDOSTERONISMO" target="SUPRARRENALES">
      <data key="d8">1.0</data>
      <data key="d9">Las gl&#225;ndulas suprarrenales est&#225;n implicadas en la producci&#243;n de hormonas que afectan el seudohipoaldosteronismo.</data>
      <data key="d10">261db9bb173f461ca4f26fd087d3da2a</data>
      <data key="d11">1c016033773a45c78d9f35245bebddb8</data>
      <data key="d12">14670</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SUPRARRENALES" target="ENAC">
      <data key="d8">1.0</data>
      <data key="d9">Las mutaciones en los genes que codifican para las subunidades del canal de sodio sensible a amilorida (ENaC) afectan la funci&#243;n de las gl&#225;ndulas suprarrenales.</data>
      <data key="d10">261db9bb173f461ca4f26fd087d3da2a</data>
      <data key="d11">a5a8bb3a26ef4d77a0cadc5cb94d435c</data>
      <data key="d12">14671</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RENINA" target="ALDOSTERONE">
      <data key="d8">6.0</data>
      <data key="d9">Aldosterone secretion is suppressed when DOCA levels are high, which in turn affects renin levels.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">441142b79eee4d169fb1f6736b6a5ead</data>
      <data key="d12">14672</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERTENSION ARTERIAL (HTA)" target="PRIMARY ALDOSTERONISM">
      <data key="d8">8.0</data>
      <data key="d9">Primary aldosteronism is a common cause of hypertension arterial (HTA), leading to increased blood pressure.</data>
      <data key="d10">05edb31ec01c621a00d71bd5868784e0</data>
      <data key="d11">45acf07c08e74929a22af157a597978d</data>
      <data key="d12">14673</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERTENSION ARTERIAL (HTA)" target="HYPERTENSION RESISTANT">
      <data key="d8">1.0</data>
      <data key="d9">Resistant hypertension is a severe form of hypertension arterial (HTA) that does not respond to standard treatments.</data>
      <data key="d10">05edb31ec01c621a00d71bd5868784e0</data>
      <data key="d11">816a0ae30fb44fbab6dca86ca8665313</data>
      <data key="d12">14674</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERTENSION RESISTANT" target="PRIMARY ALDOSTERONISM">
      <data key="d8">8.0</data>
      <data key="d9">Primary aldosteronism can lead to resistant hypertension, where blood pressure remains high despite treatment.</data>
      <data key="d10">05edb31ec01c621a00d71bd5868784e0</data>
      <data key="d11">37970a77cc1a4b288f7df8c4a280c67e</data>
      <data key="d12">14675</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALDOSTERONE" target="RENIN">
      <data key="d8">7.0</data>
      <data key="d9">Renin is involved in the regulation of aldosterone secretion, affecting blood pressure and fluid balance.</data>
      <data key="d10">1cdfccda20ac47427fc4c103ddd87cf3</data>
      <data key="d11">6e26dc1a5921476290d4a63318fbcf59</data>
      <data key="d12">14676</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALDOSTERONE" target="ANGIOTENSIN II">
      <data key="d8">8.0</data>
      <data key="d9">Angiotensin II stimulates the release of aldosterone, which regulates blood pressure</data>
      <data key="d10">d4fb31e0ff471ed415f98bc11ca26d1d</data>
      <data key="d11">afbcdce38fb44e59a0dbc6d7efc7a061</data>
      <data key="d12">14677</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOALDOSTERONISMO" target="DIETA RICA EN SODIO">
      <data key="d8">1.0</data>
      <data key="d9">A sodium-rich diet is recommended for patients with hypoaldosteronism to help manage potassium levels and blood pressure.</data>
      <data key="d10">1cdfccda20ac47427fc4c103ddd87cf3</data>
      <data key="d11">8d98d855ab954dac860fd3499d90f1ed</data>
      <data key="d12">14678</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOALDOSTERONISMO" target="DIUR&#201;TICOS TIAZIDA">
      <data key="d8">6.0</data>
      <data key="d9">Diur&#233;ticos tiazida can exacerbate the effects of hipoaldosteronismo by further promoting sodium loss</data>
      <data key="d10">3733abb85045220c8e373e316f858791</data>
      <data key="d11">df861ca643cc4010913db6b45ae6f217</data>
      <data key="d12">14679</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOALDOSTERONISMO" target="HIPO-NATREMIA">
      <data key="d8">6.0</data>
      <data key="d9">Hypoaldosteronism can lead to hyponatremia due to sodium loss</data>
      <data key="d10">a56fad7f6dac4a75bd4748b247aa9215</data>
      <data key="d11">674cec9bf47e489aa4b1721279bdc545</data>
      <data key="d12">14680</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BORNSTEIN SR" target="HAAS CS">
      <data key="d8">3.0</data>
      <data key="d9">Haas CS's work on renal tubular acidosis relates to Bornstein SR's guidelines on adrenal insufficiency</data>
      <data key="d10">152aeb8f10c2f4548114403c05af6b55</data>
      <data key="d11">7787b6127a1d4572af4518d72ee0cd7f</data>
      <data key="d12">14681</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPOPOTASEMIA" target="PACIENTES EN DI&#193;LISIS">
      <data key="d8">5.0</data>
      <data key="d9">Patients in dialysis may require a high potassium diet to prevent hypokalemia in certain situations</data>
      <data key="d10">d87b6185e9826c5338c079056e2019a9</data>
      <data key="d11">bdc43cd0992b45d5a82dccb47e26822a</data>
      <data key="d12">14682</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPIRONOLACTONA" target="ALD/ARP">
      <data key="d8">9.0</data>
      <data key="d9">Spironolactone must be withdrawn before testing the aldosterone/renin plasma activity ratio for accurate results</data>
      <data key="d10">151237aa6e4e4aaa2d1115a10ab09be0</data>
      <data key="d11">1fc98c384b7442b294b2f7700789526c</data>
      <data key="d12">14683</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CORTEX SUPRARRENAL" target="CYP11B2">
      <data key="d8">9.0</data>
      <data key="d9">CYP11B2 is expressed in the adrenal cortex and is crucial for aldosterone synthesis</data>
      <data key="d10">41b6e4025d59564d7881f459e230639d</data>
      <data key="d11">b8f2d146f57a48f1b3a78015ae9025de</data>
      <data key="d12">14684</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CORTEX SUPRARRENAL" target="HIPERALDOSTERONISMO PRIMARIO">
      <data key="d8">8.0</data>
      <data key="d9">The adrenal cortex is the site of aldosterone production, which is elevated in primary hyperaldosteronism</data>
      <data key="d10">41b6e4025d59564d7881f459e230639d</data>
      <data key="d11">1b41351a95354b4c9e6ae4ab429a46d9</data>
      <data key="d12">14685</data>
      <data key="d13">2</data>
    </edge>
    <edge source="11-DESOXICORTICOSTERONA" target="HIPERALDOSTERONISMO PRIMARIO">
      <data key="d8">6.0</data>
      <data key="d9">11-Deoxycorticosterone can mimic the effects of aldosterone in primary hyperaldosteronism</data>
      <data key="d10">41b6e4025d59564d7881f459e230639d</data>
      <data key="d11">d35b05f9643f47208dfa2def33a55ebe</data>
      <data key="d12">14686</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DOCA" target="HIPERALDOSTERONISMO PRIMARIO">
      <data key="d8">1.0</data>
      <data key="d9">DOCA can lead to symptoms similar to those of primary hyperaldosteronism, including hypertension</data>
      <data key="d10">41b6e4025d59564d7881f459e230639d</data>
      <data key="d11">4af86d18359f40c6b3042e12a285ebc0</data>
      <data key="d12">14687</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DOCA" target="HYPOKALEMIA">
      <data key="d8">8.0</data>
      <data key="d9">High levels of DOCA can cause hypokalemia as it affects potassium balance in the body.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">8b343ef8c615471989a86652db625371</data>
      <data key="d12">14688</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DOCA" target="TUMORES SUPRARRENALES">
      <data key="d8">8.0</data>
      <data key="d9">Adrenal tumors that produce DOCA can lead to excess levels of this hormone, causing hypertension and hypokalemia.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">148282c16db4454f83e1b3cc0641c998</data>
      <data key="d12">14689</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="GEN QUIM&#201;RICO">
      <data key="d8">7.0</data>
      <data key="d9">The presence of a chimeric gene is linked to the development of primary hyperaldosteronism.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">2cf1030b94674419916a7d0a7113a6af</data>
      <data key="d12">14690</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="HISTORIA FAMILIAR">
      <data key="d8">7.0</data>
      <data key="d9">Family history is a critical factor in diagnosing primary hyperaldosteronism, particularly in young patients.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">a27b02dd64bf4a6a9b3222f74f8726f8</data>
      <data key="d12">14691</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="S&#205;NDROME FAMILIAR">
      <data key="d8">6.0</data>
      <data key="d9">Familial syndrome can lead to primary hyperaldosteronism, especially in patients with a family history of hypertension.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">0eb5489c408e4a549184c6a7b27eb352</data>
      <data key="d12">14692</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="HISTORIA FAMILIAR DE HIPERTENSI&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">A family history of hypertension can indicate a higher risk for primary hyperaldosteronism in young patients.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">b547a1ad2e404a32aafab607a1faa440</data>
      <data key="d12">14693</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="ICTUS A UNA EDAD JOVEN">
      <data key="d8">6.0</data>
      <data key="d9">Stroke at a young age can be a significant indicator of familial hyperaldosteronism risk.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">7c5bce20cedc4f97b5838a28369f8b7f</data>
      <data key="d12">14694</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="HIPERTENSI&#211;N RESISTENTE">
      <data key="d8">1.0</data>
      <data key="d9">Resistant hypertension is often associated with primary hyperaldosteronism, complicating treatment efforts.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">15ef6d31adb94d3a966b800326558d3b</data>
      <data key="d12">14695</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="HIPERALDOSTERONISMO FAMILIAR TIPO 2">
      <data key="d8">7.0</data>
      <data key="d9">El hiperaldosteronismo familiar tipo 2 es una forma de hiperaldosteronismo primario que no responde a la dexametasona</data>
      <data key="d10">bb2f48277736ce24d1ff0310a682376d</data>
      <data key="d11">425d86918cbd4a2982ec180389f1e81c</data>
      <data key="d12">14696</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="CYP11B2">
      <data key="d8">6.0</data>
      <data key="d9">El gen CYP11B2 est&#225; implicado en la producci&#243;n de aldosterona, relevante en el contexto del hiperaldosteronismo primario</data>
      <data key="d10">bb2f48277736ce24d1ff0310a682376d</data>
      <data key="d11">bd220851263e422e961502fc8bd03792</data>
      <data key="d12">14697</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="CYP11B1">
      <data key="d8">6.0</data>
      <data key="d9">El gen CYP11B1 tambi&#233;n est&#225; relacionado con la producci&#243;n de aldosterona, lo que lo hace relevante para el hiperaldosteronismo primario</data>
      <data key="d10">bb2f48277736ce24d1ff0310a682376d</data>
      <data key="d11">3f026447f51b41e8a5021b20271c1311</data>
      <data key="d12">14698</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIPERALDOSTERONISMO PRIMARIO" target="MART&#205;N CUESTA HERN&#193;NDEZ">
      <data key="d8">1.0</data>
      <data key="d9">Mart&#237;n Cuesta Hern&#225;ndez's research focuses on hiperaldosteronismo primario</data>
      <data key="d10">75a4b2d504de480eaef247aa682bfd05</data>
      <data key="d11">c51fc295e67c4c2e960e4968ad63bc5b</data>
      <data key="d12">14699</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CYP11B2" target="CYP11B1">
      <data key="d8">1.0</data>
      <data key="d9">El intercambio de material gen&#233;tico entre los genes CYP11B2 y CYP11B1 da lugar a un gen quim&#233;rico en el hiperaldosteronismo familiar tipo 1</data>
      <data key="d10">bb2f48277736ce24d1ff0310a682376d</data>
      <data key="d11">261850a652704c85afbbe02c696b2373</data>
      <data key="d12">14700</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CYP11B" target="CYP17">
      <data key="d8">7.0</data>
      <data key="d9">CYP11B and CYP17 are both genes involved in the biosynthesis of steroid hormones, including aldosterone and cortisol.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">f8e71ba87988437c9d0f82b4690eb68c</data>
      <data key="d12">14701</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HISTORIA FAMILIAR" target="ENFERMEDAD CELIACA">
      <data key="d8">6.0</data>
      <data key="d9">Una historia familiar de diabetes tipo 1 y otros s&#237;ntomas puede aumentar el riesgo de desarrollar enfermedad cel&#237;aca.</data>
      <data key="d10">41babae4bb4b80271c9bfd9da1528392</data>
      <data key="d11">0a307c144a4d42dd9fa74cb32d6d1524</data>
      <data key="d12">14702</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HISTORIA FAMILIAR" target="ALERGIAS E INTOLERANCIAS ALIMENTARIAS">
      <data key="d8">7.0</data>
      <data key="d9">La historia familiar puede ser un factor importante en el diagn&#243;stico de alergias e intolerancias alimentarias.</data>
      <data key="d10">bc394d70461777b6300d5449185a7859</data>
      <data key="d11">42ea5c93f75d437da8508be48d6570a1</data>
      <data key="d12">14703</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRUEBAS CL&#193;SICAS INDIRECTAS" target="ESTUDIO GEN&#201;TICO DIRECTO">
      <data key="d8">5.0</data>
      <data key="d9">Classic indirect tests are being replaced by direct genetic testing for diagnosing familial hyperaldosteronism.</data>
      <data key="d10">dcbf695abeb609e2cdbff56c1bde675c</data>
      <data key="d11">cb2d9343597144c9add39a03c22ad63c</data>
      <data key="d12">14704</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TUMORES SECRETORES DE CATECOLAMINAS" target="CROMAFINES">
      <data key="d8">8.0</data>
      <data key="d9">Chromaffin cells are the origin of catecholamine-secreting tumors like pheochromocytomas</data>
      <data key="d10">8f5500c9a9e74d855b17365c80375df3</data>
      <data key="d11">1ad26c8b45054ad8b63c07706cc5e5fc</data>
      <data key="d12">14705</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TUMORES SECRETORES DE CATECOLAMINAS" target="MUTACIONES EN L&#205;NEA GERMINAL">
      <data key="d8">1.0</data>
      <data key="d9">Germline mutations can be associated with the development of catecholamine-secreting tumors</data>
      <data key="d10">8f5500c9a9e74d855b17365c80375df3</data>
      <data key="d11">9e25f5b8705342efac0785222bc96fb7</data>
      <data key="d12">14706</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PARAGANGLIOMA" target="SDHB">
      <data key="d8">9.0</data>
      <data key="d9">Mutations in the SDHB gene are associated with an increased risk of paragangliomas</data>
      <data key="d10">4433d2fdc6ba080efa0cf63e8603172a</data>
      <data key="d11">a18dac5f1a1340c4901dd4c27aa30b4c</data>
      <data key="d12">14707</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PARAGANGLIOMA" target="VON HIPPEL-LINDAU">
      <data key="d8">8.0</data>
      <data key="d9">Paraganglioma is another tumor type associated with Von Hippel-Lindau syndrome</data>
      <data key="d10">973f9100fbfeb9ef31038f51312620a9</data>
      <data key="d11">5b4d3069e3394129add25c51f8f57896</data>
      <data key="d12">14708</data>
