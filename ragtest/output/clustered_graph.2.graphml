    </node>
    <node id="ENFERMEDAD VENOCLOSIVA HEP&#193;TICA">
      <data key="d0">EVENT</data>
      <data key="d1">Complicaci&#243;n que puede aparecer en trasplantes aut&#243;logos y alog&#233;nicos, con una incidencia del 20% de los pacientes, que puede llevar a fallo m&#250;ltiple.</data>
