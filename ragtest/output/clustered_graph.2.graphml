      <data key="d11">366dd529e3494018832dd5c2c38fbacf</data>
      <data key="d12">3703</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="B. BALERDI P&#201;REZ">
      <data key="d8">6.0</data>
      <data key="d9">B. Balerdi P&#233;rez discusses the importance of nutritional support in the context of burn patients</data>
      <data key="d10">36cffc3e7c3a6fe82e50787e939f7537</data>
