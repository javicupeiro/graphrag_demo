    <node id="NATIONAL PATIENT SAFETY AGENCY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The National Patient Safety Agency is an organization that focuses on improving patient safety, including guidelines for dysphagia diet descriptors.</data>
      <data key="d2">90aa696a6e48637e06acfcd7213699da</data>
      <data key="d3">1221</data>
