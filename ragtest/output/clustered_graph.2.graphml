      <data key="d0">PERSON</data>
      <data key="d1">&#193;lvarez San Mart&#237;n RM is an author of a manual on endocrinology and nutrition.</data>
      <data key="d2">b11e575be155e186717a992a9d641577</data>
      <data key="d3">1457</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">3930</data>
      <data key="d7">15d64f0926df4f9e8a6bed287daf6d5a</data>
    </node>
    <node id="URIOSTE FONDO A">
      <data key="d0">PERSON</data>
      <data key="d1">Urioste Fondo A is an author of a manual on endocrinology and nutrition.</data>
      <data key="d2">b11e575be155e186717a992a9d641577</data>
      <data key="d3">1457</data>
      <data key="d4">2</data>
