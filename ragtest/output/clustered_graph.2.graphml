      <data key="d10">a2675f78609440ca1162c24997360929</data>
      <data key="d11">6ad2edf56e804cdeafc14d5167596ca4</data>
      <data key="d12">5944</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="DIETOTERAPIA">
      <data key="d8">8.0</data>
      <data key="d9">The OMS (World Health Organization) provides essential guidelines on sugar intake that are highly relevant to dietotherapy and its impact on health. These guidelines serve to inform and shape dietotherapy practices, ensuring that they align with the latest health recommendations from the WHO.</data>
