      <data key="d6">8166</data>
      <data key="d7">da025dc09e3b4aeaa3823fa7a0a8eeac</data>
    </node>
    <node id="FORO ACT&#218;A">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Foro Act&#250;a is a web resource that provides information and tools for modifying dietary habits, particularly for patients with overweight and obesity.</data>
      <data key="d2">87cb06eed8a8c92c589d25ea2d5cfaec</data>
