      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Journal of Clinical Nursing is a publication where Perry's work on swallowing assessments was published.</data>
      <data key="d2">db12fd42641d2de0cee5f33601bfb6dc</data>
