    <node id="PIRUVATO DESHIDROGENASA">
      <data key="d0">PERSON</data>
      <data key="d1">La deficiencia de piruvato deshidrogenasa es un trastorno metab&#243;lico que afecta la capacidad del cuerpo para utilizar la glucosa como fuente de energ&#237;a.</data>
      <data key="d2">a8929d6c031b44205ed738ec0a0cd435</data>
