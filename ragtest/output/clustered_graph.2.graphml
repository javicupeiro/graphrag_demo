    <node id="RECHAZO A LOS ALIMENTOS AZUCARADOS">
      <data key="d0">EVENT</data>
      <data key="d1">Rejection of sugary foods is a behavioral response in children with congenital deficit of saccharase-isomaltase due to the associated symptoms.</data>
      <data key="d2">a079902e52676a05df746098c930a0e7</data>
