      <data key="d5">1</data>
      <data key="d6">2032</data>
      <data key="d7">4658ce6a39b54a519f07f2c130558561</data>
    </node>
    <node id="CONTROL F&#205;SICO">
      <data key="d0">EVENT</data>
      <data key="d1">El control f&#237;sico implica detectar carencias nutricionales y evaluar el estado de hidrataci&#243;n del paciente durante la nutrici&#243;n parenteral.</data>
      <data key="d2">5cf1703fd601b27dd0ebda9f20cb3259</data>
