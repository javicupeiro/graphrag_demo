    </node>
    <node id="GERIATRIC NUTRITIONAL RISK INDEX (GNRI)">
      <data key="d0">EVENT</data>
      <data key="d1">A specific index designed to predict morbidity and mortality in elderly patients receiving nutritional support.</data>
      <data key="d2">d0061877457bb078516d0e43dd6d8131</data>
      <data key="d3">710</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
