    </edge>
    <edge source="DIRECT SWALLOWING TEST" target="PATIENT">
      <data key="d8">8.0</data>
      <data key="d9">The patient undergoes the Direct Swallowing Test as part of the GUSS to evaluate their swallowing skills</data>
