    <node id="GALLETAS MARIA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Galletas Maria es un producto alimenticio que contiene varios ingredientes, incluyendo harina de trigo y grasas vegetales.</data>
      <data key="d2">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
