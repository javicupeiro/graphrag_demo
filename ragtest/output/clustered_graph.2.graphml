    <node id="NEW YORK">
      <data key="d0">GEO</data>
      <data key="d1">New York is a city where a study was conducted observing the dietary habits of older populations and their correlation with cognitive health.</data>
      <data key="d2">c4f12f866dc714cdbb2323a920f524c2</data>
