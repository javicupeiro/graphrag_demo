    <node id="F&#205;STULAS GASTROINTESTINALES">
      <data key="d0">EVENT</data>
      <data key="d1">Las f&#237;stulas gastrointestinales con alto d&#233;bito son condiciones que pueden impedir la nutrici&#243;n enteral, requiriendo nutrici&#243;n parenteral.</data>
      <data key="d2">538970e30e9d0e758546ca1a3cf5a205</data>
