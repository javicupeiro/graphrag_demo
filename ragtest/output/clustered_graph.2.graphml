    <node id="GASTROENTERITIS">
      <data key="d0">EVENT</data>
      <data key="d1">Gastroenteritis is an inflammation of the stomach and intestines, often resulting in vomiting and diarrhea, which can be reduced by breastfeeding.</data>
      <data key="d2">d0a687d823ff2f3d5cb0f20b01d8530e</data>
