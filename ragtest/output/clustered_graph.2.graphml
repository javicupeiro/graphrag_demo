      <data key="d10">3f3896c039ea7ef78de8bf5fb6e09a48</data>
      <data key="d11">6deb478cdbc849bfbd43bad238594d2e</data>
      <data key="d12">8741</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICIONES PARENTERALES ADULTOS PROTOCOLIZADAS EN EL HOSPITAL" target="STANDARDS FOR NUTRITION SUPPORT">
      <data key="d8">1.0</data>
