    </node>
    <node id="ACUTE STROKE">
      <data key="d0">EVENT</data>
      <data key="d1">Acute stroke is a medical condition that requires immediate attention and is the focus of multiple studies regarding nutritional status and management.</data>
      <data key="d2">499132ff7f7da81d7effbadf776c5b54</data>
      <data key="d3">794</data>
