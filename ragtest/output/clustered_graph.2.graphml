      <data key="d5">1</data>
      <data key="d6">12258</data>
      <data key="d7">0d71ff6073b64556a5ca05ac08c4f9d9</data>
    </node>
    <node id="PANCREATIC DISEASES">
      <data key="d0">EVENT</data>
      <data key="d1">Pancreatic diseases refer to conditions affecting the pancreas, which may require nutritional support and management strategies.</data>
      <data key="d2">fb24bf4c9fcf60bbc1dd56cd60ba0a47</data>
      <data key="d3">1233</data>
      <data key="d4">2</data>
      <data key="d5">9</data>
      <data key="d6">12259</data>
      <data key="d7">c6a0eb3e33dd41a28feea1f5e657d3ed</data>
    </node>
    <node id="GANG ZHAO">
      <data key="d0">PERSON</data>
      <data key="d1">Gang Zhao is a researcher who conducted a study on the effects of glutamine supplementation in patients with severe pancreatic diseases.</data>
      <data key="d2">fb24bf4c9fcf60bbc1dd56cd60ba0a47</data>
