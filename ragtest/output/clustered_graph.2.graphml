    <node id="KEYS A">
      <data key="d0">PERSON</data>
      <data key="d1">Keys A is an author known for his work on coronary heart disease, particularly in the context of dietary influences, as published in the journal Circulation.</data>
      <data key="d2">f2b8b21255397ebbaf2b5d66ff6bde88</data>
      <data key="d3">1495</data>
      <data key="d4">2</data>
