    </edge>
    <edge source="DIABETES" target="MALNUTRICI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">Diabetes is a significant risk factor for malnutrition, particularly in elderly patients who may have dietary restrictions or complications</data>
      <data key="d10">1ba0aa1d1330351a62eb6319ffdd30db</data>
      <data key="d11">96e0a9181dc147a7965b7cc9f4e0173a</data>
