      <data key="d12">882</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUIMIOTERAPIA" target="HOMBRE">
      <data key="d8">1.0</data>
      <data key="d9">El paciente var&#243;n de 66 a&#241;os puede recibir quimioterapia como parte de su tratamiento oncol&#243;gico</data>
      <data key="d10">e474ebdcd3e5392e4b2bed8434293849</data>
      <data key="d11">6aecbad524594750b595448f3a69c659</data>
      <data key="d12">883</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUIMIOTERAPIA" target="COMIT&#201; DE TUMORES">
