    <edge source="FIBRA DIET&#201;TICA" target="FALLO INTESTINAL">
      <data key="d8">6.0</data>
      <data key="d9">The presence of dietary fiber can influence the management and outcomes of patients with intestinal failure</data>
      <data key="d10">9f3f6014b1a9e68b22c02862a9143a33</data>
