    </node>
    <node id="YEYUNITIS ULCERATIVA">
      <data key="d0">EVENT</data>
      <data key="d1">Ulcerative jejunitis is a condition that can be associated with severe malabsorption and may occur in patients with refractory celiac disease.</data>
      <data key="d2">e6153f0024d75c281071b521b08ed53a</data>
      <data key="d3">807</data>
      <data key="d4">2</data>
