    <node id="SUBPROGRAMA ESTATAL DE FORTALECIMIENTO INSTITUCIONAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">This subprogram aims to incorporate new thematic areas and groups into the CIBER consortium to enhance its research capabilities.</data>
      <data key="d2">f91257e7ffb4b7202ece2853953bd62f</data>
