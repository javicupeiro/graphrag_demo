    </node>
    <node id="SISTEMA NERVIOSO SIMPATICO">
      <data key="d0">EVENT</data>
      <data key="d1">The sympathetic nervous system is activated in obesity, leading to increased renal sodium retention and fluid volume expansion.</data>
      <data key="d2">c575e742f54d5f3f674a8e52ad041221</data>
      <data key="d3">1390</data>
      <data key="d4">2</data>
