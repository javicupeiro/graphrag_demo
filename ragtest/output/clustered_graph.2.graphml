    <node id="TOMOGRAF&#205;A AXIAL COMPUTERIZADA">
      <data key="d0">EVENT</data>
      <data key="d1">La tomograf&#237;a axial computerizada fue realizada para confirmar la existencia de un trayecto fistuloso en la sutura gastroyeyunal tras la cirug&#237;a.</data>
      <data key="d2">67f96f3e5c366f82de31f1bf189aa71f</data>
