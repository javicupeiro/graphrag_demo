      <data key="d12">5735</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES" target="PANCREATITIS">
      <data key="d8">5.0</data>
      <data key="d9">Diabetes can complicate the management of patients with pancreatitis, affecting their nutritional needs</data>
      <data key="d10">178140d0d29364593546d7d21393f2c6</data>
      <data key="d11">00823cc0c0234f9a8096391def37cb01</data>
      <data key="d12">5736</data>
