    <edge source="BARIATRIC SURGERY" target="NUTRITIONAL CONTROL">
      <data key="d8">9.0</data>
      <data key="d9">Nutritional control is essential for patients after bariatric surgery to ensure proper recovery and health</data>
      <data key="d10">5236affa95aaf73b0f2d08e839e4db54</data>
