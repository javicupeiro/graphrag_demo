    </node>
    <node id="CRITERIOS DE RANSON">
      <data key="d0">EVENT</data>
      <data key="d1">Los criterios de Ranson son un conjunto de par&#225;metros cl&#237;nicos utilizados para predecir la gravedad y el pron&#243;stico de la pancreatitis aguda.</data>
      <data key="d2">5d4476c2c40af44f9d54628af0ac463d</data>
      <data key="d3">1178</data>
