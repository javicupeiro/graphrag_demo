    </edge>
    <edge source="C&#193;NCER DE ES&#211;FAGO" target="SARCOCENIA">
      <data key="d8">7.0</data>
      <data key="d9">Los pacientes con c&#225;ncer de es&#243;fago tienen una alta incidencia de sarcopenia, lo que aumenta el riesgo de complicaciones.</data>
      <data key="d10">a7baff5fb024c516ea6ae8c236dc945d</data>
      <data key="d11">542127b425304740b8478d42c9e53631</data>
      <data key="d12">16398</data>
