    </node>
    <node id="TBG">
      <data key="d0">EVENT</data>
      <data key="d1">TBG (thyroxine-binding globulin) is a protein that transports thyroid hormones in the bloodstream and is influenced by various factors including estrogen levels.</data>
      <data key="d2">bbe700b5b290ea119e511c94a6f0c67f</data>
      <data key="d3">1299</data>
      <data key="d4">2</data>
