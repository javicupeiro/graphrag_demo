    </edge>
    <edge source="DIN" target="OFLOXACINO">
      <data key="d8">5.0</data>
      <data key="d9">Ofloxacin can cause nephrogenic diabetes insipidus as a side effect.</data>
      <data key="d10">1fb4c8ba1bc908ea3a3c7717a073fa4f</data>
      <data key="d11">5265ed7a6b124edbbd496c85695a71b5</data>
