      <data key="d0">EVENT</data>
      <data key="d1">L-DOPA es un medicamento utilizado en el tratamiento de la enfermedad de Parkinson que requiere una absorci&#243;n adecuada para ser efectivo.</data>
      <data key="d2">0482404f71667592ce2b0f771153ece8</data>
      <data key="d3">1163</data>
