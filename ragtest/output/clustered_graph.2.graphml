    <edge source="PHOSPHORUS" target="CALCIUM">
      <data key="d8">16.0</data>
      <data key="d9">Calcium and phosphorus are both essential minerals that play a crucial role in the health and development of premature infants. Their intake is closely monitored to ensure adequate levels, as they work together to support bone mineralization, which is particularly important for preterm infants. The metabolism of phosphorus and calcium is intricately linked, making both minerals critical for maintaining bone health.</data>
      <data key="d10">08d66dc8414668a3ec627a1e164cfa6c,1f8cd198519be7b535a3f5be8181931c,919ff63f7f48a238e717f60361d8dbd1</data>
      <data key="d11">3df8d43c95054c2c94328879b12ac924</data>
      <data key="d12">10451</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHOSPHORUS" target="NUTRITIONAL CONTROL">
      <data key="d8">8.0</data>
      <data key="d9">Phosphorus limitation is part of the nutritional control for patients with chronic kidney disease</data>
      <data key="d10">5236affa95aaf73b0f2d08e839e4db54</data>
      <data key="d11">5b072a66767340f3a87299aa6ee3d048</data>
      <data key="d12">10452</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHOSPHORUS" target="HEMODIALYSIS">
      <data key="d8">5.0</data>
      <data key="d9">Phosphorus intake is monitored for patients undergoing hemodialysis to prevent complications</data>
      <data key="d10">9da930839072b524410f2345ab1df8b1</data>
      <data key="d11">39a872053ec7493484b00220869e38fe</data>
      <data key="d12">10453</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHOSPHORUS" target="DIALYSIS PERITONEAL">
      <data key="d8">5.0</data>
