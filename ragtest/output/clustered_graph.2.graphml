    </node>
    <node id="IMPEDANCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Impedance is a diagnostic technique that can be combined with high resolution manometry to evaluate esophageal conditions.</data>
      <data key="d2">44d6374ee887ebef4cba5ec2a31f0673</data>
