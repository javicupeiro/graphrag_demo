    </node>
    <node id="BALLY ET AL.">
      <data key="d0">PERSON</data>
      <data key="d1">Bally et al. conducted a systematic review and meta-analysis on nutritional support and outcomes in malnourished medical inpatients.</data>
      <data key="d2">c940d6c62fa57d30867f7a8533492471</data>
      <data key="d3">1234</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6400</data>
      <data key="d7">5178884f5a604397a529061b17fd51d3</data>
    </node>
    <node id="MALNOURISHED PATIENTS">
      <data key="d0">PERSON</data>
      <data key="d1">Malnourished patients are individuals who are hospitalized and at risk of complications due to inadequate nutritional intake. They are characterized by not receiving sufficient nutrition, which often necessitates specialized nutritional support. This support may include interventions such as parenteral nutrition to address their nutritional deficiencies and mitigate the risks associated with malnutrition.</data>
      <data key="d2">29cd22ec41c1cb5160d9987958d6ae16,4b0d0238a19e23ffee592c9d0817e226,c940d6c62fa57d30867f7a8533492471</data>
