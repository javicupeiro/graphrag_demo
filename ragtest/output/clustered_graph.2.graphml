    <node id="DETSKEY ET AL">
      <data key="d0">PERSON</data>
      <data key="d1">Detsky et al. es un autor que ha contribuido a la metodolog&#237;a de la Valoraci&#243;n Global Subjetiva.</data>
      <data key="d2">e12655d89e99e57ce1f6d87563adf674</data>
      <data key="d3">1126</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
