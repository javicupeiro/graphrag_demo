    </node>
    <node id="HARRIS AND BENEDICT FORMULA">
      <data key="d0">EVENT</data>
      <data key="d1">The Harris and Benedict formula is used to calculate the energy requirements of patients.</data>
      <data key="d2">d23c564df025cf16e37f2ef2be83ec34</data>
      <data key="d3">1249</data>
      <data key="d4">2</data>
