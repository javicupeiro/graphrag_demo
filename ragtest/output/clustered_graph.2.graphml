    </edge>
    <edge source="HYPERGLYCEMIA" target="LIN LY">
      <data key="d8">7.0</data>
      <data key="d9">Lin LY's research correlates hyperglycemia with outcomes in patients receiving total parenteral nutrition.</data>
      <data key="d10">64378df2be6b08b39bd652c0a2d3789c</data>
