      <data key="d5">3</data>
      <data key="d6">3735</data>
      <data key="d7">b34928f386184916a4a7e4a6bd24290c</data>
    </node>
    <node id="HISTIOCITOSIS">
      <data key="d0">EVENT</data>
      <data key="d1">Histiocitosis is a group of disorders that can involve the pituitary gland and result in hormonal deficiencies, including hypopituitarism.</data>
