      <data key="d10">aacaabd084b7839bdedf5fbebfd7dcf4</data>
      <data key="d11">8b3d909ae10940b6ab1feb22de026687</data>
      <data key="d12">10416</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N ENTERAL" target="RECI&#201;N NACIDOS PREMATUROS">
      <data key="d8">8.0</data>
      <data key="d9">Reci&#233;n nacidos prematuros often require enteral feeding to meet their nutritional needs</data>
      <data key="d10">aacaabd084b7839bdedf5fbebfd7dcf4</data>
      <data key="d11">d1933dcef93749c6a2abbb56fc585d4d</data>
      <data key="d12">10417</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTACI&#211;N ENTERAL" target="DISTENSI&#211;N ABDOMINAL">
      <data key="d8">6.0</data>
      <data key="d9">Distensi&#243;n abdominal may signal issues with enteral feeding tolerance</data>
