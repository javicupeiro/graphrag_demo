    <edge source="DIABETIC RETINOPATHY" target="DIABETES CONTROL AND COMPLICATIONS TRIAL RESEARCH GROUP">
      <data key="d8">15.0</data>
      <data key="d9">The Diabetes Control and Complications Trial Research Group conducted a comprehensive study on the impact of diabetes management on diabetic retinopathy. Their research specifically focused on the effects of glycemic control on the progression and severity of diabetic retinopathy, highlighting the importance of effective diabetes management in mitigating complications associated with the disease.</data>
      <data key="d10">4f445fb2c039daae07b71341057c9b9b,dda50550d881b4487154c85b2f279034</data>
      <data key="d11">196e5ce0e47b4bb0afea90f09671c1e3</data>
      <data key="d12">13404</data>
      <data key="d13">2</data>
    </edge>
