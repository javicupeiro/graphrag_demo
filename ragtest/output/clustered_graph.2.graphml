    </node>
    <node id="ANTIHISTAM&#205;NICO H1">
      <data key="d0">PERSON</data>
      <data key="d1">El antihistam&#237;nico H1 es un medicamento que se recomienda para el tratamiento de alergias y se sugiere su uso durante 14 d&#237;as en el inicio del tratamiento diet&#233;tico.</data>
      <data key="d2">527c3c962d22018377b32c52e984d4e1</data>
