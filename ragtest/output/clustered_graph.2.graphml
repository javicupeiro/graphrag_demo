    <edge source="VITAMINA E" target="PACIENTE ONCOL&#211;GICO">
      <data key="d8">6.0</data>
      <data key="d9">La vitamina E no se recomienda en dosis altas para pacientes oncol&#243;gicos que reciben quimioterapia o radioterapia</data>
      <data key="d10">d667e6abc204bbfa6aba210705db6d56</data>
      <data key="d11">07b2c9e5554b4d4092d6a3d9e0806632</data>
      <data key="d12">8440</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA E" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">8.0</data>
      <data key="d9">Vitamina E is included in pediatric nutrition for its antioxidant properties</data>
      <data key="d10">e742c891694171ad455b038f416b7728</data>
      <data key="d11">37f5e9e033f54446b1ff3067da646375</data>
      <data key="d12">8441</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="PLAQUETOPENIA">
      <data key="d8">6.0</data>
      <data key="d9">Vitamin K is given to patients with low platelet counts to improve coagulation</data>
      <data key="d10">20491afa9a4770e93e6cff9034f8b0f0</data>
      <data key="d11">42cbabd44f054a50852936d22230297c</data>
      <data key="d12">8442</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="COMIT&#201; DE NUTRICI&#211;N DE LA AEP">
      <data key="d8">8.0</data>
      <data key="d9">The Committee recommends administering vitamin K to newborns to prevent hemorrhagic disease.</data>
      <data key="d10">2a1b909c98067bf7fc270d6f30199f96</data>
      <data key="d11">b15a7a94a8824ecd90c321a20e517604</data>
      <data key="d12">8443</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="INFUVITE PEDI&#193;TRICO">
      <data key="d8">8.0</data>
      <data key="d9">Infuvite Pedi&#225;trico contains Vitamin K as part of its composition for pediatric nutrition</data>
      <data key="d10">49e05b04f80c53d5f20f7d97f970f5dd</data>
      <data key="d11">6948d907e3c44a49bd959dfc79f21022</data>
      <data key="d12">8444</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="ALCOHOLISMO">
      <data key="d8">7.0</data>
      <data key="d9">Alcoholism can lead to a deficiency in vitamin K, impacting blood coagulation</data>
      <data key="d10">bead99df88cb929a33cc2799a84da77e</data>
      <data key="d11">6548a52095454736be0976ba15aa4f02</data>
      <data key="d12">8445</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="HEMORRAGIAS">
      <data key="d8">8.0</data>
      <data key="d9">Hemorrhages can occur due to a deficiency in vitamin K, which is crucial for blood clotting</data>
      <data key="d10">bead99df88cb929a33cc2799a84da77e</data>
      <data key="d11">893c67175dd74eb2a013af4432026a76</data>
      <data key="d12">8446</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="ANTIBI&#211;TICOS">
      <data key="d8">7.0</data>
      <data key="d9">Long-term antibiotic use can disrupt intestinal flora, leading to vitamin K deficiency</data>
      <data key="d10">bead99df88cb929a33cc2799a84da77e</data>
      <data key="d11">723d2ee221db4c2480ab49afa658e1cd</data>
      <data key="d12">8447</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="AYUNO PROLONGADO">
      <data key="d8">6.0</data>
      <data key="d9">Prolonged fasting can result in vitamin K deficiency, impacting blood coagulation</data>
      <data key="d10">bead99df88cb929a33cc2799a84da77e</data>
      <data key="d11">069b9512311742e59b6551deaf45d40d</data>
      <data key="d12">8448</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="RECOMENDACIONES DIARIAS">
      <data key="d8">5.0</data>
      <data key="d9">Daily recommendations for vitamin K are essential for maintaining health</data>
      <data key="d10">bead99df88cb929a33cc2799a84da77e</data>
      <data key="d11">948e9b29b2ac47c1a776dc0babdec84f</data>
      <data key="d12">8449</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="COLESTIRAMINA">
      <data key="d8">6.0</data>
      <data key="d9">Cholestyramine can lead to malabsorption of fat-soluble vitamins, including vitamin K</data>
      <data key="d10">8bcd338de10fbee8f3c808cc30b69b25</data>
      <data key="d11">98d0b56599334e42beb7826a2eb3a57a</data>
      <data key="d12">8450</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="ENFERMEDAD CELIACA">
      <data key="d8">7.0</data>
      <data key="d9">La deficiencia de vitamina K puede causar problemas hemorr&#225;gicos en pacientes con enfermedad cel&#237;aca</data>
      <data key="d10">9d5e76e37794965024f4b16e7e163d30</data>
      <data key="d11">c97735161afa4df5a2347dd11815814c</data>
      <data key="d12">8451</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="DIARREA Y ESTRE&#209;IMIENTO">
      <data key="d8">3.0</data>
      <data key="d9">The topic of diarrhea and constipation is related to the role of vitamin K produced by gut bacteria in maintaining health.</data>
      <data key="d10">0d9c11c44c3cf4e1e3148949cc0a4096</data>
      <data key="d11">e462302f8db84485b41e249c8b962940</data>
      <data key="d12">8452</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="HEPATOPAT&#205;A SEVERA">
      <data key="d8">6.0</data>
      <data key="d9">Vitamin K supplementation is necessary in patients with severe liver disease due to its role in blood clotting and metabolism</data>
      <data key="d10">a4886f74d848ccd61cefcaab3103f233</data>
      <data key="d11">7a952e8a4c824b2aa03b0ac2035444d0</data>
      <data key="d12">8453</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="WARFARINA">
      <data key="d8">6.0</data>
      <data key="d9">Vitamina K can antagonize the action of warfarina when present in enteral nutrition</data>
      <data key="d10">5eb14e2cbec104d89ad73e2ac968b7fd</data>
      <data key="d11">9f8fd4b706b4434098f0319948649976</data>
      <data key="d12">8454</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">8.0</data>
      <data key="d9">Vitamina K is necessary for blood coagulation and is included in pediatric dietary guidelines</data>
      <data key="d10">e742c891694171ad455b038f416b7728</data>
      <data key="d11">4be36e7c25ee44d9a7f26bb161ec415d</data>
      <data key="d12">8455</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="FL&#218;OR">
      <data key="d8">3.0</data>
      <data key="d9">Both Vitamin K and Fluorine are essential nutrients recommended for children's health and development.</data>
      <data key="d10">3bd46addca98ca875c66aab3827bbf5f</data>
      <data key="d11">6c339a9e45a344368973df217f3cf5d1</data>
      <data key="d12">8456</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA K" target="LIMITE SUPERIOR">
      <data key="d8">5.0</data>
      <data key="d9">Vitamin K is mentioned in the context of upper limits which have not been established</data>
      <data key="d10">4d3437a0370e3fe7789ba3908d445576</data>
      <data key="d11">90a0f71abba043f2abff3b14c6bb0980</data>
      <data key="d12">8457</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B1" target="PACIENTE ONCOL&#211;GICO">
      <data key="d8">7.0</data>
      <data key="d9">Se recomienda la administraci&#243;n de vitamina B1 a pacientes oncol&#243;gicos durante el soporte nutricional</data>
      <data key="d10">e510500bd5a5f16a0bf0353cfdb79c13</data>
      <data key="d11">c6902568b92b4889a6b3f519e707a59d</data>
      <data key="d12">8458</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B1" target="VITAMINA B12">
      <data key="d8">5.0</data>
      <data key="d9">Both vitamins are part of the B-vitamin complex and are important for energy metabolism and overall health</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef</data>
      <data key="d11">44432675dfe5491a81ddd49889638312</data>
      <data key="d12">8459</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B1" target="BENERVA 100 MG/ML">
      <data key="d8">8.0</data>
      <data key="d9">Benerva 100 mg/ml is a solution that provides Vitamin B1, thus directly related to its function and benefits</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef</data>
      <data key="d11">1c28ae0bf415430d93120d6229108220</data>
      <data key="d12">8460</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B1" target="BENERVA 300 MG">
      <data key="d8">8.0</data>
      <data key="d9">Benerva 300 mg is a tablet that provides Vitamin B1, thus directly related to its function and benefits</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef</data>
      <data key="d11">93f50570858b4c28a2507896d81621d9</data>
      <data key="d12">8461</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NIACINA" target="CER-NEVIT">
      <data key="d8">1.0</data>
      <data key="d9">Niacin is one of the components included in the CER-NEVIT multivitamin composition for parenteral nutrition</data>
      <data key="d10">97270fe12224dcc1dc019b0d1026a7fd</data>
      <data key="d11">b033ae0e1d4b4461b036c427ecc40117</data>
      <data key="d12">8462</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NIACINA" target="VITAMINA B&#8323;">
      <data key="d8">10.0</data>
      <data key="d9">La vitamina B&#8323; es tambi&#233;n conocida como niacina, lo que indica que son la misma entidad en diferentes contextos</data>
      <data key="d10">26629a423810543625be19deea4cc35f</data>
      <data key="d11">4dffc1d40e7a4d12a1bee6e6b04ec8df</data>
      <data key="d12">8463</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NIACINA" target="S&#205;NDROME CARCINOIDE">
      <data key="d8">6.0</data>
      <data key="d9">La deficiencia de niacina puede causar s&#237;ntomas similares a los del s&#237;ndrome carcinoide, como lesiones cut&#225;neas.</data>
      <data key="d10">eb8099d0ade1b1539ca9f357d155574b</data>
      <data key="d11">8558dfe8c03442998302a6ed4450e850</data>
      <data key="d12">8464</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NIACINA" target="VITAMINA C">
      <data key="d8">3.0</data>
      <data key="d9">Both Niacin and Vitamin C are essential vitamins that contribute to overall health and are included in dietary recommendations.</data>
      <data key="d10">3bd46addca98ca875c66aab3827bbf5f</data>
      <data key="d11">a040f59979b44f8c9121d069b82327b7</data>
      <data key="d12">8465</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NIACINA" target="INGESTAS DIARIAS RECOMENDADAS">
      <data key="d8">7.0</data>
      <data key="d9">Niacin has specific recommended intake levels outlined in the ingestas diarias recomendadas</data>
      <data key="d10">74a9c62d0f932e27419151241f7db445</data>
      <data key="d11">f3b3980e546f4c9db7fb78e5a812c695</data>
      <data key="d12">8466</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B6" target="METOTREXATO">
      <data key="d8">6.0</data>
      <data key="d9">Methotrexate can lead to a deficiency of vitamin B6 due to its mechanism of action</data>
      <data key="d10">8bcd338de10fbee8f3c808cc30b69b25</data>
      <data key="d11">d327be3148ea431e900d1adc515f89a7</data>
      <data key="d12">8467</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B6" target="ISONIACIDA">
      <data key="d8">6.0</data>
      <data key="d9">Isoniazid can cause a deficiency of vitamin B6 due to malabsorption</data>
      <data key="d10">8bcd338de10fbee8f3c808cc30b69b25</data>
      <data key="d11">96b375b735324acf8102e4306f6beb79</data>
      <data key="d12">8468</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B6" target="HIPOMAGNESEMIA">
      <data key="d8">5.0</data>
      <data key="d9">La deficiencia de vitamina B6 puede influir en el metabolismo del magnesio, contribuyendo a la hipomagnesemia.</data>
      <data key="d10">ed9dfe1b1e334597565187840983df05</data>
      <data key="d11">bacaf4c3a56547f487258d146fb0033b</data>
      <data key="d12">8469</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B6" target="VITAMINA C">
      <data key="d8">5.0</data>
      <data key="d9">Both vitamins are important for metabolic processes and are commonly found in dietary supplements</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef</data>
      <data key="d11">be8e3ce3d4a64f9786221d992e8b0d83</data>
      <data key="d12">8470</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B6" target="BENAD&#211;N 300 MG">
      <data key="d8">8.0</data>
      <data key="d9">Benad&#243;n 300 mg is a product that provides Vitamin B6, thus directly related to its function and benefits</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef</data>
      <data key="d11">7fccc4928272402aa3e09c02390bd0d1</data>
      <data key="d12">8471</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="CER-NEVIT">
      <data key="d8">8.0</data>
      <data key="d9">Vitamin B12 is one of the components included in the CER-NEVIT multivitamin composition for parenteral nutrition</data>
      <data key="d10">97270fe12224dcc1dc019b0d1026a7fd</data>
      <data key="d11">4a17761693b9428e8d4a71ee531b58e7</data>
      <data key="d12">8472</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="SODIO">
      <data key="d8">5.0</data>
      <data key="d9">Sodio is important for the absorption of Vitamina B12 in the body</data>
      <data key="d10">9200477669cf2a6e6f67f912c729ddc6</data>
      <data key="d11">e28e084bc009433f892102a5147e87dd</data>
      <data key="d12">8473</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="HIERRO">
      <data key="d8">5.0</data>
      <data key="d9">Hierro is necessary for the proper utilization of Vitamina B12 in the body</data>
      <data key="d10">9200477669cf2a6e6f67f912c729ddc6</data>
      <data key="d11">d6619eb9a2e74cbc9072c376e2ad873d</data>
      <data key="d12">8474</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="MALNUTRICI&#211;N EN C&#193;NCER">
      <data key="d8">4.0</data>
      <data key="d9">Vitamin B12 is essential for cancer patients, particularly those experiencing malnutrition</data>
      <data key="d10">bf234f719a608fc6858d9a1749463539</data>
      <data key="d11">fcced9911640419d9d1aa9bb7cd6f502</data>
      <data key="d12">8475</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="INFUVITE PEDI&#193;TRICO">
      <data key="d8">1.0</data>
      <data key="d9">Infuvite Pedi&#225;trico contains Vitamin B12 as part of its composition for pediatric nutrition</data>
      <data key="d10">49e05b04f80c53d5f20f7d97f970f5dd</data>
      <data key="d11">25d5c15449a24ce2b9bed1385a033276</data>
      <data key="d12">8476</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="BYPASS G&#193;STRICO">
      <data key="d8">8.0</data>
      <data key="d9">El bypass g&#225;strico puede causar deficiencia de vitamina B12 debido a la exclusi&#243;n del est&#243;mago en el proceso digestivo.</data>
      <data key="d10">70b2393fa61e51fc3e772479a9792c98</data>
      <data key="d11">a2a7c7715f61489387c064bd2516f2e9</data>
      <data key="d12">8477</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="HELICOBACTER PYLORI">
      <data key="d8">6.0</data>
      <data key="d9">La infecci&#243;n cr&#243;nica por Helicobacter pylori puede causar atrofia g&#225;strica, lo que contribuye a la deficiencia de vitamina B12.</data>
      <data key="d10">70b2393fa61e51fc3e772479a9792c98</data>
      <data key="d11">534b9faa430742a78f2b3ea1db7720a4</data>
      <data key="d12">8478</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="OMEPRAZOL">
      <data key="d8">6.0</data>
      <data key="d9">El uso cr&#243;nico de omeprazol puede afectar la absorci&#243;n de vitamina B12 en pacientes que han tenido cirug&#237;a de bypass g&#225;strico.</data>
      <data key="d10">70b2393fa61e51fc3e772479a9792c98</data>
      <data key="d11">1487805887c44471a84133f66558d313</data>
      <data key="d12">8479</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="METFORMINA">
      <data key="d8">6.0</data>
      <data key="d9">La toma de metformina puede contribuir a la reducci&#243;n de las concentraciones de vitamina B12.</data>
      <data key="d10">70b2393fa61e51fc3e772479a9792c98</data>
      <data key="d11">c778b40daa3b449683316560bbd96494</data>
      <data key="d12">8480</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="&#193;CIDO CLORH&#205;DRICO">
      <data key="d8">7.0</data>
      <data key="d9">La ausencia de &#225;cido clorh&#237;drico anula la digesti&#243;n de alimentos que contienen vitamina B12, causando deficiencia.</data>
      <data key="d10">70b2393fa61e51fc3e772479a9792c98</data>
      <data key="d11">4af06a81faff49fdb51c31bfe06e1f44</data>
      <data key="d12">8481</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="FACTOR INTR&#205;NSECO">
      <data key="d8">7.0</data>
      <data key="d9">El factor intr&#237;nseco es necesario para el transporte de vitamina B12 hasta el &#237;leon distal, y su disminuci&#243;n puede causar deficiencia.</data>
      <data key="d10">70b2393fa61e51fc3e772479a9792c98</data>
      <data key="d11">9f8353064c504559b445a7dc0ec31816</data>
      <data key="d12">8482</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="&#193;CIDO F&#211;LICO">
      <data key="d8">10.0</data>
      <data key="d9">VITAMINA B12 y &#193;CIDO F&#211;LICO son nutrientes esenciales que se recomiendan especialmente para mujeres en edad f&#233;rtil, ya que pueden ser necesarios para prevenir defectos en el desarrollo. Ambos son vitaminas del grupo B que desempe&#241;an un papel crucial en la s&#237;ntesis de ADN y la divisi&#243;n celular. Adem&#225;s, el &#225;cido f&#243;lico y la vitamina B12 son fundamentales para la formaci&#243;n de gl&#243;bulos rojos, lo que resalta su importancia en la salud general y el desarrollo adecuado.</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef,3bd46addca98ca875c66aab3827bbf5f,b68dc7398a80c0b67d28b1d9f73ff885</data>
      <data key="d11">6f01c3b9a9dc496fab44c766922ccc5f</data>
      <data key="d12">8483</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="YODO">
      <data key="d8">3.0</data>
      <data key="d9">Ambos nutrientes son cr&#237;ticos para la salud, especialmente en poblaciones vulnerables como ancianos y mujeres embarazadas.</data>
      <data key="d10">b68dc7398a80c0b67d28b1d9f73ff885</data>
      <data key="d11">408f387fe3394a6a9f69b0ac55b427cf</data>
      <data key="d12">8484</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="DIETAS VEGETARIANAS">
      <data key="d8">13.0</data>
      <data key="d9">VITAMINA B12 is an essential nutrient that is often lacking in DIETAS VEGETARIANAS. Individuals who adhere to vegetarian diets may experience deficiencies in vitamin B12 due to the absence of animal products, which are the primary sources of this vitamin. To prevent such deficiencies, it is commonly recommended that those following vegetarian diets supplement their intake of vitamin B12.</data>
      <data key="d10">62afbb83c3f69bd45bf24467ac5b47b8,b68dc7398a80c0b67d28b1d9f73ff885</data>
      <data key="d11">45ae9197e7d74c48841fd597cce3b275</data>
      <data key="d12">8485</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="SUPLEMENTOS">
      <data key="d8">1.0</data>
      <data key="d9">Los suplementos de vitamina B12 son recomendados para personas con dietas que no la contienen adecuadamente, como los veganos.</data>
      <data key="d10">b68dc7398a80c0b67d28b1d9f73ff885</data>
      <data key="d11">b62ecbfa17a74a8f8a2006c882d0144c</data>
      <data key="d12">8486</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="SELENIO">
      <data key="d8">3.0</data>
      <data key="d9">Both selenium and vitamin B12 deficiencies can occur after certain surgeries, highlighting their importance in post-operative care.</data>
      <data key="d10">91f7ece6ed9226a98b3f59f46000ebf6</data>
      <data key="d11">413198b714ce432ba29608d66360e969</data>
      <data key="d12">8487</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="CB">
      <data key="d8">5.0</data>
      <data key="d9">CB surgery is known to result in vitamin B12 deficiency, indicating a strong relationship.</data>
      <data key="d10">91f7ece6ed9226a98b3f59f46000ebf6</data>
      <data key="d11">132a3a08cdb9416ea7988b88c788a77e</data>
      <data key="d12">8488</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="INSUFICIENCIA RENAL AGUDA">
      <data key="d8">7.0</data>
      <data key="d9">La vitamina B12 es necesaria para los pacientes en di&#225;lisis, que pueden experimentar deficiencia</data>
      <data key="d10">9f77fc213da2123b013166c181a60323</data>
      <data key="d11">2c738abcc76c42cabb50c915548700b5</data>
      <data key="d12">8489</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="FEC">
      <data key="d8">1.0</data>
      <data key="d9">Patients with FEC may require supplementation of Vitamin B12</data>
      <data key="d10">e5838e52fbc5d3d18fc0533b71148201</data>
      <data key="d11">eaa4713d9d0143f5b060452f1e1b5087</data>
      <data key="d12">8490</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="INGESTAS DIARIAS RECOMENDADAS">
      <data key="d8">7.0</data>
      <data key="d9">Vitamin B12 has specific recommended intake levels outlined in the ingestas diarias recomendadas</data>
      <data key="d10">74a9c62d0f932e27419151241f7db445</data>
      <data key="d11">d98597cec6544a62b7727f4b63215ac1</data>
      <data key="d12">8491</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="LIMITE SUPERIOR">
      <data key="d8">5.0</data>
      <data key="d9">Vitamin B12 is mentioned in the context of upper limits which have not been established</data>
      <data key="d10">4d3437a0370e3fe7789ba3908d445576</data>
      <data key="d11">0e95e6ed2eb24388a6d4ff64910d4eda</data>
      <data key="d12">8492</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="CROMATONBIC B12 1000">
      <data key="d8">8.0</data>
      <data key="d9">Cromatonbic B12 1000 is a product that contains Vitamin B12, thus directly related to its function and benefits</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef</data>
      <data key="d11">cd4395233aa64ce4940740bcb1b67baf</data>
      <data key="d12">8493</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="OPTOVITE B12">
      <data key="d8">8.0</data>
      <data key="d9">Optovite B12 is a product that contains Vitamin B12, thus directly related to its function and benefits</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef</data>
      <data key="d11">c92df350a7f64cf4b2707100b425a03a</data>
      <data key="d12">8494</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINA B12" target="MEGAMILBEDOCE 10000">
      <data key="d8">8.0</data>
      <data key="d9">Megamilbedoce 10000 is a product that contains Vitamin B12, thus directly related to its function and benefits</data>
      <data key="d10">3202b451a4ece0fc376bd2899a412bef</data>
      <data key="d11">b8da342000994fd28f83f3df1abc9a3d</data>
      <data key="d12">8495</data>
