      <data key="d13">2</data>
    </edge>
    <edge source="SLC37A4" target="GSDIB">
      <data key="d8">9.0</data>
      <data key="d9">Mutations in the SLC37A4 gene are associated with Glycogen Storage Disease Type Ib, affecting glucose metabolism.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
