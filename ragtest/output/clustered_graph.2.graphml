    <node id="TRAUMATISMO ABDOMINAL">
      <data key="d0">EVENT</data>
      <data key="d1">El traumatismo abdominal es una condici&#243;n m&#233;dica que puede llevar a la necesidad de nutrici&#243;n parenteral en pacientes gravemente heridos.</data>
      <data key="d2">44346a4b1b9a6d3ae2bc161314ff9efd</data>
