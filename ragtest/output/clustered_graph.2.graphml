    </node>
    <node id="CD4+ CELLS">
      <data key="d0">PERSON</data>
      <data key="d1">A type of immune cell that plays a crucial role in the immune response, often monitored in patients post-transplant.</data>
      <data key="d2">408288a47065e62d79bbc9b19df87c61</data>
      <data key="d3">503</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">13766</data>
      <data key="d7">308bae1f2f174636bc07a71fd6b72a09</data>
    </node>
    <node id="NK CELLS">
      <data key="d0">PERSON</data>
      <data key="d1">Natural Killer cells that are part of the immune system and can be affected during the post-transplant recovery phase.</data>
      <data key="d2">408288a47065e62d79bbc9b19df87c61</data>
      <data key="d3">503</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">13767</data>
      <data key="d7">87cd2ca59e9040f3b6aaf8e8c1c735d0</data>
    </node>
    <node id="CD8+ CELLS">
      <data key="d0">PERSON</data>
      <data key="d1">A type of T cell that is important for the immune response, particularly in recognizing and destroying infected or cancerous cells.</data>
      <data key="d2">408288a47065e62d79bbc9b19df87c61</data>
      <data key="d3">503</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">13768</data>
      <data key="d7">709a10eaf19d44eca2aa6055eaceaa7a</data>
    </node>
    <node id="TRANSPLANT CANDIDATE">
      <data key="d0">PERSON</data>
      <data key="d1">A patient who is being considered for a hematopoietic stem cell transplant, often undergoing various preparatory treatments.</data>
      <data key="d2">408288a47065e62d79bbc9b19df87c61</data>
      <data key="d3">503</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">13769</data>
      <data key="d7">668ccaa9a4774be6a5c9b08d87fba7bd</data>
    </node>
    <node id="SOLID TUMORS">
      <data key="d0">EVENT</data>
      <data key="d1">A type of cancer that forms in solid organs or tissues, which may also be treated with hematopoietic stem cell transplants.</data>
      <data key="d2">408288a47065e62d79bbc9b19df87c61</data>
      <data key="d3">503</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">13770</data>
      <data key="d7">2fe1ef8db2254ff5a489d6f6f4d01e12</data>
    </node>
    <node id="IMMUNE RECONSTITUTION">
      <data key="d0">EVENT</data>
      <data key="d1">The process by which the immune system recovers after a hematopoietic stem cell transplant, involving the re-establishment of immune cell populations.</data>
      <data key="d2">408288a47065e62d79bbc9b19df87c61</data>
      <data key="d3">503</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">13771</data>
      <data key="d7">978df0c09ac84af39820ed56c260033c</data>
    </node>
    <node id="HEMATOLOGICAL MALIGNANCIES">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">408288a47065e62d79bbc9b19df87c61</data>
