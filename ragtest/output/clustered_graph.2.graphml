    <node id="CANDELA C. G.">
      <data key="d0">PERSON</data>
      <data key="d1">Candela C. G. is a researcher involved in algorithms for nutritional assessment and treatment in adult cancer patients.</data>
      <data key="d2">ce6821fbd8f78047e06917383f25f037</data>
