      <data key="d6">15932</data>
      <data key="d7">10aabec2587540578fbe1b67ca74eecf</data>
    </node>
    <node id="COSTES SANITARIOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Costes sanitarios refers to the various costs associated with health services, including structural costs and costs of resources used in therapeutic interventions.</data>
      <data key="d2">f70e5dee3fad44cd9576113c0bb941d5</data>
      <data key="d3">1272</data>
      <data key="d4">2</data>
