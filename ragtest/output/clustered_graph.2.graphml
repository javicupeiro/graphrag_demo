    <node id="CONSENSO MULTIDISCIPLINAR">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Consenso Multidisciplinar sobre el Abordaje de la Desnutrici&#243;n Hospitalaria en Espa&#241;a is a guideline aimed at addressing hospital malnutrition through a multidisciplinary approach.</data>
      <data key="d2">28cd3f60e1ccd9129a7d4d386e241a93</data>
