      <data key="d7">d37afeb062e74f1d9401356dbcfa3587</data>
    </node>
    <node id="&#193;CIDOS &#937;-3">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">&#193;cidos &#969;-3 are essential fatty acids important for heart and brain health, derived from fish and other sources.</data>
      <data key="d2">e1766b4a9f6cff776650a29195cee9fc</data>
      <data key="d5">0</data>
      <data key="d6">10831</data>
