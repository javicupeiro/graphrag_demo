      <data key="d13">2</data>
    </edge>
    <edge source="GLUCOGENOSIS" target="CALCIO Y VITAMINA D">
      <data key="d8">3.0</data>
      <data key="d9">Calcium and vitamin D are recommended as supplements in the treatment of patients with glucogenosis to support overall health.</data>
      <data key="d10">76287e9b94faab94755c56fead3541d7</data>
      <data key="d11">b355c5cc4ed34182a5e0343eb6cba02b</data>
      <data key="d12">18339</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUCOGENOSIS" target="IECA">
      <data key="d8">3.0</data>
      <data key="d9">IECA medications are advised for patients with glucogenosis who present with microalbuminuria to manage kidney health.</data>
      <data key="d10">76287e9b94faab94755c56fead3541d7</data>
      <data key="d11">e7bc444d79bb4f9fb0e8757d06a5f287</data>
