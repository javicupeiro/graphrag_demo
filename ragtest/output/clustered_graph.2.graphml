    </edge>
    <edge source="NUTRICI&#211;N ENTERAL" target="NUTRICI&#211;N INTERMITENTE">
      <data key="d8">7.0</data>
      <data key="d9">Intermittent nutrition is a form of enteral nutrition that alternates between feeding and digestive rest</data>
      <data key="d10">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d11">337827aa8e814ceba7b69a34b99a61ea</data>
      <data key="d12">2844</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N ENTERAL" target="NUTRICI&#211;N CON JERINGA">
      <data key="d8">6.0</data>
      <data key="d9">Syringe feeding is a method of administering enteral nutrition</data>
      <data key="d10">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d11">74caf4b2bb8642fcbed056271759be24</data>
      <data key="d12">2845</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N ENTERAL" target="NUTRICI&#211;N POR GRAVEDAD">
      <data key="d8">6.0</data>
      <data key="d9">Gravity feeding is another method of administering enteral nutrition</data>
      <data key="d10">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d11">847a41def7194cb68f17fd0c2c319eb1</data>
      <data key="d12">2846</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N ENTERAL" target="PRESCRIPCI&#211;N DE NUTRICI&#211;N ENTERAL">
      <data key="d8">8.0</data>
      <data key="d9">The prescription process is essential for the administration of enteral nutrition</data>
      <data key="d10">b3dfcfd0255d51aaff0c01a236bce881</data>
      <data key="d11">10a54f3015fd4518a709bb7624d03b08</data>
      <data key="d12">2847</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N ENTERAL" target="MONITORIZACI&#211;N DE NUTRICI&#211;N ENTERAL">
      <data key="d8">8.0</data>
      <data key="d9">Monitoring is a critical component of managing enteral nutrition</data>
