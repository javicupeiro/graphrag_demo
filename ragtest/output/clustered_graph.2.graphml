      <data key="d11">af81ea2bf4884466927d97f5eeb9245f</data>
      <data key="d12">12689</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERPROLACTINEMIA" target="MACROPROLACTINOMA">
      <data key="d8">6.0</data>
      <data key="d9">Macroprolactinoma is a condition that can result from hyperprolactinemia due to excess prolactin production.</data>
