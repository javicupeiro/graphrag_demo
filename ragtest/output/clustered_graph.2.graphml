    <node id="SCLEROSIS">
      <data key="d0">EVENT</data>
      <data key="d1">Sclerosis refers to the hardening of tissue, which can affect various parts of the body and may complicate venous access procedures.</data>
      <data key="d2">3d5e0a3ef45c7ba15063791545dc4826</data>
      <data key="d3">763</data>
      <data key="d4">2</data>
