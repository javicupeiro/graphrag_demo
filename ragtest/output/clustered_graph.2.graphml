    <node id="NUTRICI&#211;N POR SONDA">
      <data key="d0">EVENT</data>
      <data key="d1">Enteral nutrition is a common practice in hospitals, sometimes as the only source of food for patients.</data>
      <data key="d2">58e7286e0ab9d6d52b4c70dadb8b001f</data>
