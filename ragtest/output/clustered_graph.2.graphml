      <data key="d10">4681d149c863ed06c99b19443f841abd</data>
      <data key="d11">01a55a18690a4b9bae009ff8614bd683</data>
      <data key="d12">17127</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL CONTROL" target="YOGURT">
      <data key="d8">6.0</data>
