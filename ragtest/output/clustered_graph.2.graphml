    <node id="LIQUIDO CEFALORRAQU&#205;DEO">
      <data key="d0">EVENT</data>
      <data key="d1">El l&#237;quido cefalorraqu&#237;deo es un fluido que puede verse afectado por tumores pineales, provocando un aumento de oncoprote&#237;nas.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
