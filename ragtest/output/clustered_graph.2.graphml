    <node id="J. DALMAU">
      <data key="d0">PERSON</data>
      <data key="d1">J. Dalmau is one of the authors contributing to the chapter on pediatric parenteral nutrition.</data>
      <data key="d2">b410dfc796e4ac9178ac19ac368e2036</data>
      <data key="d3">1845</data>
      <data key="d4">2</data>
