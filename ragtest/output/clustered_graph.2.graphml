    <node id="C&#193;NCER TIROIDEO">
      <data key="d0">EVENT</data>
      <data key="d1">C&#225;ncer tiroideo is a type of thyroid cancer that has been examined for associations with fish and omega-3 fatty acid intake.</data>
      <data key="d2">11c3cb37b1a2c111ceb227aefa8d9e1a</data>
      <data key="d3">980</data>
      <data key="d4">2</data>
