    <node id="ANTICUERPOS BLOQUEANTES DEL RECEPTOR DE LA TSH">
      <data key="d0">EVENT</data>
      <data key="d1">Maternal transfer of blocking antibodies to the TSH receptor can cause transient congenital hypothyroidism.</data>
      <data key="d2">838d1ef59dfea4cab2a724bc85b02632</data>
