    <node id="ANTICUERPOS ANTI-GAD">
      <data key="d0">EVENT</data>
      <data key="d1">Anti-GAD antibodies are markers often found in patients with autoimmune diabetes, including those with stiff-person syndrome.</data>
      <data key="d2">ac89fcaa7dcce835c0d5b9ed9ce94cea</data>
      <data key="d5">1</data>
