      <data key="d6">14236</data>
      <data key="d7">d7a82d0a61af4b11bc42b5a8bfac73da</data>
    </node>
    <node id="BETA-BLOCKERS">
      <data key="d0">PERSON</data>
      <data key="d1">Beta-blockers can have their hypotensive effects potentiated by alcohol consumption.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d3">1387</data>
      <data key="d4">2</data>
