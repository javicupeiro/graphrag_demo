    <node id="IGNACIO HERN&#193;NDEZ MEDRANO">
      <data key="d0">PERSON</data>
      <data key="d1">Ignacio Hern&#225;ndez Medrano is a Spanish neurologist known for developing the Savana program, which utilizes artificial intelligence to extract data from clinical histories.</data>
      <data key="d2">b7034350b98abd27ed6af7560149691d</data>
