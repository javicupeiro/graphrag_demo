      <data key="d13">2</data>
    </edge>
    <edge source="SARCOPEMIA" target="FACTOR VIII">
      <data key="d8">6.0</data>
      <data key="d9">Elevated Factor VIII levels can indicate inflammation, which is related to the development of sarcopenia in the elderly.</data>
      <data key="d10">caab2e12a2bce3c947d663cf8b71cb67</data>
      <data key="d11">35adebf86201438eb95b38f7b270dd2a</data>
      <data key="d12">11050</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SARCOPEMIA" target="D&#205;MERO D">
      <data key="d8">6.0</data>
