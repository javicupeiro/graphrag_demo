      <data key="d6">1921</data>
      <data key="d7">c4d340dde5a849a4a793d3fe5ba99de5</data>
    </node>
    <node id="M. P&#201;REZ">
      <data key="d0">PERSON</data>
      <data key="d1">M. P&#233;rez is a co-author of the algorithm for managing diarrhea in enteral nutrition and has also contributed to the recommendations for managing this condition within the context of enteral nutrition.</data>
      <data key="d2">0f426d03e5adabc2a16b5c9a9df1c32c,52a0434694f8face489cdb4c8d206a9e</data>
      <data key="d3">902</data>
