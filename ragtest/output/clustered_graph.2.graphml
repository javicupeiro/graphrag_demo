    </node>
    <node id="KREON 10000">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Kreon 10000 is a pancreatic enzyme preparation available in Spain, containing 10,000 units of lipase per dose, used for patients with pancreatic insufficiency.</data>
