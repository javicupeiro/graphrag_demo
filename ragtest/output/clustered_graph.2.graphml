    </edge>
    <edge source="HIERRO" target="LECHE HUMANA">
      <data key="d8">7.0</data>
      <data key="d9">Human milk is noted for its high bioavailability of iron despite low content</data>
      <data key="d10">62bb1dedc96b7530649f4c9762faab9d</data>
