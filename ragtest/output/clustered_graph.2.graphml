      <data key="d12">16751</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EJERCICIO" target="SISTEMAS ENERG&#201;TICOS">
      <data key="d8">7.0</data>
      <data key="d9">Los sistemas energ&#233;ticos son activados durante el ejercicio para proporcionar la energ&#237;a necesaria para la actividad f&#237;sica.</data>
