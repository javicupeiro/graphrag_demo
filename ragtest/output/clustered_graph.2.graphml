      <data key="d6">4634</data>
      <data key="d7">b0e165c3f33442b6a7ef736ed6442421</data>
    </node>
    <node id="MICROCALCIFICATIONS">
      <data key="d0">EVENT</data>
      <data key="d1">Microcalcifications are small deposits of calcium in the thyroid nodules that are associated with a higher risk of malignancy.</data>
      <data key="d2">673c86b4e90c81d1c4bc78cdd08e9be0</data>
      <data key="d3">1211</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">4635</data>
      <data key="d7">a61dafe55f2947a1a24a234f961441fd</data>
    </node>
    <node id="MARGINS IRREGULARES">
      <data key="d0">EVENT</data>
      <data key="d1">Irregular margins of thyroid nodules are a characteristic that indicates a higher risk of malignancy.</data>
      <data key="d2">673c86b4e90c81d1c4bc78cdd08e9be0</data>
      <data key="d3">1211</data>
      <data key="d4">2</data>
