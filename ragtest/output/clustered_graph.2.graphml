    </node>
    <node id="OTORRINOLARING&#211;LOGO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">An otolaryngologist is a medical specialist responsible for diagnosing and treating conditions related to the ear, nose, and throat, including dysphagia.</data>
      <data key="d2">dae3d2cddf63b2af4067a27d8b9d7ab5</data>
