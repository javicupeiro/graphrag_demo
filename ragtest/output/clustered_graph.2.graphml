      <data key="d6">13009</data>
      <data key="d7">31dde4081f47411b96874846ea000540</data>
    </node>
    <node id="BODE INDEX">
      <data key="d0">EVENT</data>
      <data key="d1">The BODE index is a multidimensional grading system used to assess the severity of EPOC, incorporating factors such as BMI, airway obstruction, dyspnea, and exercise capacity.</data>
      <data key="d2">cc406ffdbe4f62a6f2d9763ee4888fdf</data>
