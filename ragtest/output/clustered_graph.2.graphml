      <data key="d10">dcb97f7ffdb0aea3051bdf53e04bcc29</data>
      <data key="d11">bf752ac8b5b2443b9e19aa19a8b4ffa2</data>
      <data key="d12">13276</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#218;SCULO" target="AMINO&#193;CIDOS">
      <data key="d8">1.0</data>
      <data key="d9">Amino acids are essential for the creation and repair of muscle tissue</data>
      <data key="d10">dcb97f7ffdb0aea3051bdf53e04bcc29</data>
      <data key="d11">75d395a2896440b984efbfc3b6cfe4ec</data>
      <data key="d12">13277</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RI&#209;&#211;N" target="VON GIERKE TYPE IA">
      <data key="d8">1.0</data>
      <data key="d9">The kidney may be involved in the management of Von Gierke Type Ia, especially in cases requiring combined organ transplantation.</data>
      <data key="d10">76287e9b94faab94755c56fead3541d7</data>
      <data key="d11">1f2c231eda30406b9e42b885d38f4952</data>
      <data key="d12">13278</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#201;LULAS &#914;" target="PROINSULINA">
      <data key="d8">9.0</data>
      <data key="d9">Beta cells produce proinsulin, which is then processed to form insulin</data>
      <data key="d10">9baa05f21f51764ac1d0537294bdc7db</data>
      <data key="d11">770faf197c8a47d28c421e935c1e5163</data>
      <data key="d12">13279</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#201;LULAS &#914;" target="GLP-1">
      <data key="d8">9.0</data>
      <data key="d9">GLP-1 stimulates insulin secretion from beta cells in the pancreas</data>
      <data key="d10">50fafa000d5f2830cbf66f3201657396</data>
      <data key="d11">f8a44fbe4ecf4d1bb2f26a8e738382ee</data>
      <data key="d12">13280</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NADH" target="KREBS CYCLE">
      <data key="d8">8.0</data>
      <data key="d9">NADH is produced during the Krebs cycle and is essential for the electron transport chain</data>
      <data key="d10">9baa05f21f51764ac1d0537294bdc7db</data>
      <data key="d11">ab67a9c692494a6dbe842c5e9c8ab6ab</data>
      <data key="d12">13281</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FADH" target="KREBS CYCLE">
      <data key="d8">8.0</data>
      <data key="d9">FADH is generated in the Krebs cycle and plays a crucial role in ATP synthesis</data>
      <data key="d10">9baa05f21f51764ac1d0537294bdc7db</data>
      <data key="d11">f9668c200c344ffc956e82ae46190adc</data>
      <data key="d12">13282</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACCORD" target="DIABETES TYPE 2">
      <data key="d8">8.0</data>
      <data key="d9">The ACCORD study specifically addresses treatment strategies for individuals with type 2 diabetes, examining the effects of intensive glucose control</data>
      <data key="d10">7b084f7afc5f3c66a528475ae4fa76b1</data>
      <data key="d11">51785e962f774b4bb1c38c5ccba77f43</data>
      <data key="d12">13283</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GLUT4" target="DIABETES TYPE 2">
      <data key="d8">1.0</data>
      <data key="d9">GLUT4 is essential for glucose uptake in tissues, and its regulation is particularly important in the context of diabetes type 2 management</data>
      <data key="d10">7b084f7afc5f3c66a528475ae4fa76b1</data>
      <data key="d11">dd7b4180340f46e7ba0d5268e46ff16f</data>
      <data key="d12">13284</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES TYPE 2" target="CARVEDILOL">
      <data key="d8">7.0</data>
      <data key="d9">Carvedilol is used in the treatment of patients with diabetes type 2 to improve insulin sensitivity</data>
      <data key="d10">06dcefb711cbd9fdb958145cca571b83</data>
      <data key="d11">3667d1ab7918410290a8966bda89a3f6</data>
      <data key="d12">13285</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES TYPE 2" target="GLIFLOZINAS">
      <data key="d8">6.0</data>
      <data key="d9">Gliflozinas are used in the management of diabetes type 2 and influence glucagon levels</data>
      <data key="d10">06dcefb711cbd9fdb958145cca571b83</data>
      <data key="d11">020119a890c7480db03d9b4345bed996</data>
      <data key="d12">13286</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES TYPE 2" target="DIETOTERAPIA">
      <data key="d8">8.0</data>
      <data key="d9">Dietotherapy is often used to manage type 2 diabetes through dietary changes, particularly in sugar consumption.</data>
      <data key="d10">018644ab78da6f804c57546f08ff6a65</data>
      <data key="d11">ceb9429e4f4e4d32aa41b2330a472c13</data>
      <data key="d12">13287</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="NORADRENALINE">
      <data key="d8">8.0</data>
      <data key="d9">Noradrenaline is released during hypoglycemic episodes to help raise blood glucose levels</data>
      <data key="d10">5b487245068b8e8b87ffcc04970aaff4</data>
      <data key="d11">6c91a3bddb4545eb84de6c68e965e60f</data>
      <data key="d12">13288</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="PANCREATIC TUMORS">
      <data key="d8">7.0</data>
      <data key="d9">Pancreatic tumors can cause hyperinsulinism, leading to episodes of hypoglycemia</data>
      <data key="d10">5b487245068b8e8b87ffcc04970aaff4</data>
      <data key="d11">e3c5d99c6c31429398f40ec991ec0278</data>
      <data key="d12">13289</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="AUTOIMMUNE DISEASES">
      <data key="d8">1.0</data>
      <data key="d9">Autoimmune diseases can lead to the production of antibodies that affect insulin function, contributing to hypoglycemia</data>
      <data key="d10">5b487245068b8e8b87ffcc04970aaff4</data>
      <data key="d11">b95d134f4c364607823a78467325aa16</data>
      <data key="d12">13290</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="GLYCEMIC CONTROL">
      <data key="d8">8.0</data>
      <data key="d9">Hypoglycemia is a potential risk associated with poor glycemic control in diabetes patients</data>
      <data key="d10">dda50550d881b4487154c85b2f279034</data>
      <data key="d11">32b3d02e4c3c496abfef9ba9b7072752</data>
      <data key="d12">13291</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOGLYCEMIA" target="INSUFICIENCIA SUPRARRENAL AGUDA">
