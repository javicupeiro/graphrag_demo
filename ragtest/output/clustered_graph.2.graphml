    <edge source="SARCOPEMIA" target="IGF-I">
      <data key="d8">7.0</data>
      <data key="d9">Low levels of IGF-I are associated with increased risk of sarcopenia in older adults, indicating a relationship between growth factors and muscle health.</data>
      <data key="d10">caab2e12a2bce3c947d663cf8b71cb67</data>
      <data key="d11">0cbf2edaf3c04bf7adeab512421e276d</data>
      <data key="d12">11052</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SARCOPEMIA" target="ANDR&#211;GENOS">
      <data key="d8">7.0</data>
      <data key="d9">Declining androgen levels with age are associated with loss of muscle mass and strength, contributing to sarcopenia.</data>
      <data key="d10">caab2e12a2bce3c947d663cf8b71cb67</data>
      <data key="d11">b9ceec5c77994ce3a1219d16c23a07bc</data>
      <data key="d12">11053</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SARCOPEMIA" target="HORMONA DEL CRECIMIENTO">
      <data key="d8">7.0</data>
      <data key="d9">The decline in growth hormone levels with aging is linked to the development of sarcopenia and muscle loss.</data>
      <data key="d10">caab2e12a2bce3c947d663cf8b71cb67</data>
      <data key="d11">b8f5275d04394784bdcb28c269f3b53e</data>
      <data key="d12">11054</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SARCOPEMIA" target="MUSCLE MASS">
      <data key="d8">10.0</data>
      <data key="d9">Sarcopenia is directly related to the loss of muscle mass</data>
      <data key="d10">76d78b3e33659e952b0d2835f5bdf595</data>
      <data key="d11">4f2d5b27dbe04a0cba26973ccb994e4c</data>
      <data key="d12">11055</data>
      <data key="d13">2</data>
    </edge>
