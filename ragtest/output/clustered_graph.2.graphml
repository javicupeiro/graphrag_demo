    <node id="EUROPEAN SOCIETY FOR PEDIATRIC GASTROENTEROLOGY, HEPATOLOGY, AND NUTRITION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The European Society for Pediatric Gastroenterology, Hepatology, and Nutrition is a professional organization focused on the study and treatment of gastrointestinal and nutritional disorders in children.</data>
      <data key="d2">16d282094937dc2b58bfd40e13934fd2</data>
