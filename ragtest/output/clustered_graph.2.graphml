      <data key="d6">7936</data>
      <data key="d7">39a240f2757e4491ae73311cabe0de06</data>
    </node>
    <node id="NUTRICIONAL INFORMACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional information is a mandatory disclosure for food products, detailing energy value and nutrient content, which is essential for consumer awareness.</data>
      <data key="d2">0a0bea4b9792f715e9d625450c4cd25c</data>
      <data key="d3">375</data>
      <data key="d4">1</data>
