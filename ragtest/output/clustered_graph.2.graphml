      <data key="d11">ab7cbb0ee87d419b96d9c19be18a373a</data>
      <data key="d12">10869</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRAGILIDAD" target="MODELO DEL FENOTIPO">
      <data key="d8">1.0</data>
      <data key="d9">El modelo del fenotipo es otro modelo utilizado para evaluar la fragilidad</data>
      <data key="d10">00a918807f0c6568ea1d9f0c41f1ad49</data>
      <data key="d11">cc003551009a44ab9a89558a5d40abbf</data>
      <data key="d12">10870</data>
      <data key="d13">2</data>
