    <edge source="FRAGILIDAD" target="DIETA MEDITERR&#193;NEA">
      <data key="d8">12.0</data>
      <data key="d9">The Mediterranean diet, known as "DIETA MEDITERR&#193;NEA," has been associated with a lower prevalence and incidence of frailty, referred to as "FRAGILIDAD." Research indicates that adherence to this diet is linked to a reduced likelihood of developing frailty, particularly among the elderly population. This connection highlights the potential benefits of the Mediterranean diet in promoting healthier aging and mitigating the risks associated with frailty in older adults.</data>
      <data key="d10">7e1b90e2c8714b39e283be229f6d5de3,a6a4604a5fc2c91b714b6ba568bb0090</data>
      <data key="d11">ce3a3fa6dcfe4341b133d1d075c4be7a</data>
      <data key="d12">10897</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRAGILIDAD" target="SARCOPEMIA">
      <data key="d8">1.0</data>
