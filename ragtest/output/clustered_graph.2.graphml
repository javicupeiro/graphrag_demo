      <data key="d11">e1e1412646c54bc8b6ad245a295099b9</data>
      <data key="d12">9407</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACIDOSIS LACTICA" target="LACTANTE DE 6 MESES">
      <data key="d8">1.0</data>
