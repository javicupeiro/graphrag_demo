      <data key="d11">198d31ec4a184b5ab4dce21b5e0dd6f5</data>
      <data key="d12">16851</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="SUSTANCIAS QUE CAUSAN ALERGIAS">
      <data key="d8">1.0</data>
      <data key="d9">Las sustancias que causan alergias deben ser claramente informadas seg&#250;n el Reglamento 1169/2011.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">02ca9a48a8cf40768f36f15c38ab1fdf</data>
      <data key="d12">16852</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="MIEL">
      <data key="d8">6.0</data>
      <data key="d9">La miel debe cumplir con las regulaciones del Reglamento 1169/2011 en cuanto a etiquetado y presentaci&#243;n de informaci&#243;n.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">8681e3c555654e76996be0281ec4dfdc</data>
      <data key="d12">16853</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="PRODUCTOS NO ENVASADOS">
      <data key="d8">6.0</data>
      <data key="d9">Los productos no envasados deben cumplir con la normativa del Reglamento 1169/2011 sobre informaci&#243;n alimentaria.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">2f7c416b326d4a7683f61b1f77a66f4c</data>
      <data key="d12">16854</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REGLEMENTO 1169/2011" target="INGREDIENTES">
      <data key="d8">1.0</data>
      <data key="d9">Los ingredientes de los productos alimenticios deben ser listados y etiquetados conforme al Reglamento 1169/2011.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">464a93f2db664d069bc45df9725da0d8</data>
      <data key="d12">16855</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GALLETAS MARIA" target="ANTIOXIDANTES E-306, E-304">
      <data key="d8">8.0</data>
      <data key="d9">Los antioxidantes E-306 y E-304 son ingredientes utilizados en las Galletas Maria para mantener su frescura.</data>
      <data key="d10">ed7bd985e5e4a3d5642e4b401b8e3e17</data>
      <data key="d11">fb2803e1769d4d938daa7f0c1b588483</data>
      <data key="d12">16856</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORTALIZAS" target="DIETA CONTROLADA EN GLUTEN">
      <data key="d8">8.0</data>
      <data key="d9">Las hortalizas son parte de la dieta recomendada para quienes deben evitar el gluten.</data>
      <data key="d10">08edfb59071449728499ca59eb51ac84</data>
      <data key="d11">5c1e59a0c32c4c5d9fd53d82d2bbbfa5</data>
      <data key="d12">16857</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MIEL" target="NUTRICI&#211;N PEDI&#193;TRICA">
