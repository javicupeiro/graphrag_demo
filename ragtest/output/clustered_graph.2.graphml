      <data key="d6">8993</data>
      <data key="d7">caecf77a5a3a425883977bb8533049a7</data>
    </node>
    <node id="ELDERMET">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">ELDERMET is a consortium that studies the microbiota of the elderly, finding distinct characteristics compared to younger adults.</data>
      <data key="d2">b36b8846f109ee75806c6ea03015e5d5</data>
      <data key="d3">1002</data>
