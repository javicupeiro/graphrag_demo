    </node>
    <node id="PROTE&#205;NAS DE LA LECHE DE VACA">
      <data key="d0">EVENT</data>
      <data key="d1">Cow's milk protein allergy is a common allergy in infants that can impact their nutrition and growth.</data>
      <data key="d2">a562e90891c11da0293bc7de511acc8f</data>
      <data key="d3">378</data>
      <data key="d4">1</data>
