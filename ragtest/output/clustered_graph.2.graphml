    </edge>
    <edge source="HYPOGLYCEMIA" target="BARIATRIC SURGERY">
      <data key="d8">7.0</data>
      <data key="d9">Bariatric surgery can result in hypoglycemia as a complication, particularly related to dumping syndrome</data>
      <data key="d10">79afec9f55a4cb9aa31a7e4566dae279</data>
      <data key="d11">0777354c10cf4f97af3e7dd859806049</data>
      <data key="d12">13300</data>
      <data key="d13">2</data>
