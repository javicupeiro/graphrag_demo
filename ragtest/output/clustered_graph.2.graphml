    <edge source="DIETA SIN GLUTEN" target="DIETA POBRE EN PURINAS">
      <data key="d8">3.0</data>
      <data key="d9">Both diets are designed to address specific health concerns related to dietary restrictions</data>
      <data key="d10">1cdda2c6d946ce6e48baae4230be531d</data>
