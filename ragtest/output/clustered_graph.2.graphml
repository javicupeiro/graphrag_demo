      <data key="d6">4068</data>
      <data key="d7">f3f766948b28477d8c0dddfaf81c7e2e</data>
    </node>
    <node id="MICHELS AW">
      <data key="d0">PERSON</data>
      <data key="d1">Michels AW is a researcher recognized for his contributions to the field of type 1 diabetes, particularly focusing on its genetic factors and pathogenesis. He has published significant work that explores the underlying mechanisms of the disease, enhancing the understanding of its development and potential treatment avenues.</data>
      <data key="d2">d0231ac4e41b0e826d80763b5b8c61e0,ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1721</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">4069</data>
      <data key="d7">49f3cceb9b5b486f8dbab76ab3f7c498</data>
    </node>
    <node id="BARRIO CASTELLANOS R">
      <data key="d0">PERSON</data>
      <data key="d1">Barrio Castellanos R is an author who has updated knowledge on Type 1 Diabetes in pediatric age.</data>
      <data key="d2">ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">899</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">4070</data>
      <data key="d7">076ae056bdd54425b0772be98bb997cf</data>
    </node>
    <node id="DIABETES 2">
      <data key="d0">EVENT</data>
      <data key="d1">Diabetes 2, also known as Type 2 Diabetes, is a chronic condition that significantly impacts the body's ability to process blood sugar (glucose). It is characterized by high blood sugar levels resulting from insulin resistance or insufficient insulin production. This condition can lead to various metabolic complications, including diabetic ketoacidosis and hyperglycemic crises, which may necessitate medical interventions such as insulin administration and fluid therapy. Additionally, Diabetes 2 may require insulin treatment and is associated with complications related to the disease. The condition also encompasses discussions on genetic susceptibility and haplotypes that are relevant to Type 1 Diabetes, highlighting the complex interplay of genetic factors in diabetes management.</data>
      <data key="d2">50fafa000d5f2830cbf66f3201657396,9889a9000d5a82ffba9e0f6c92da918a,afe0f4f37815c175f0faff06eb24a256,bcded135629c889cb0a10ae968743582,e1f3aed8f37691759547d488b926a79f,ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">899</data>
      <data key="d4">2</data>
      <data key="d5">23</data>
      <data key="d6">4071</data>
      <data key="d7">4028d76542ae4245a6936bd1887d7221</data>
    </node>
    <node id="DRB1*1501/DQA1*0102/DQB1*0602">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">This haplotype is known to confer protection against the development of Type 1 Diabetes.</data>
      <data key="d2">ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1721</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">4072</data>
      <data key="d7">f7770a21b91349dc998d1185c324e33e</data>
    </node>
    <node id="DRB1*1401/DQA1*0101/DQB1*0503">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">This haplotype also provides protective effects against Type 1 Diabetes.</data>
      <data key="d2">ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1721</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">4073</data>
      <data key="d7">7cebd69dca934727ba60653fb101031c</data>
    </node>
    <node id="DRB1*0701/DQA1*0201/DQB1*0303">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">This haplotype is associated with a protective effect against Type 1 Diabetes.</data>
      <data key="d2">ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1721</data>
