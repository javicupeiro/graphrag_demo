      <data key="d7">fada951c87754401aad2a73a0dff4db3</data>
    </node>
    <node id="ADMINISTRACI&#211;N DE NP">
      <data key="d0">EVENT</data>
      <data key="d1">The administration of parenteral nutrition (NP) involves specific protocols to ensure patient safety and effective nutrient delivery through central venous access.</data>
      <data key="d2">12ceae17f5df9d7a1a40ebc43156a35e</data>
      <data key="d3">586</data>
      <data key="d4">2</data>
