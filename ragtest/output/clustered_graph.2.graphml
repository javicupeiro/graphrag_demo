      <data key="d0">PERSON</data>
      <data key="d1">Alto grado de estr&#233;s metab&#243;lico refers to a condition where the body's metabolic demands are significantly increased, often requiring careful nutritional management.</data>
      <data key="d2">b7fb13d01f792b754e667a3a5bcdba93</data>
