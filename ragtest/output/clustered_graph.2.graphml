    <node id="HYPERCATABOLISM">
      <data key="d0">EVENT</data>
      <data key="d1">Hypercatabolism refers to the accelerated breakdown of body tissues, often occurring in severe trauma or illness.</data>
      <data key="d2">723cbca2d5cfbf8cf05a923c52569641</data>
