      <data key="d6">9265</data>
      <data key="d7">18a21231c689480a8ad52789c9228f72</data>
    </node>
    <node id="EDULCORANTES">
      <data key="d0">EVENT</data>
      <data key="d1">Edulcorantes are sweeteners that serve as sugar substitutes in a variety of food products. They are particularly relevant in discussions surrounding dietary recommendations for diabetes management, as they provide an alternative to sugar while helping to control blood sugar levels.</data>
      <data key="d2">9d56eb0b82a3266e422a6a8ac5e63944,c958206b5546e8b46ab48b3f50e60611</data>
      <data key="d3">870</data>
