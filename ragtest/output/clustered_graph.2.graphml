      <data key="d6">14857</data>
      <data key="d7">b74cd2474b774473a1c0fa8945c59ddb</data>
    </node>
    <node id="SURGICAL UNIT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">A surgical unit is a specialized area in a hospital where surgical procedures are performed, often under sterile conditions.</data>
      <data key="d2">3d5e0a3ef45c7ba15063791545dc4826</data>
