    </node>
    <node id="DNA VARIANT">
      <data key="d0">EVENT</data>
      <data key="d1">A DNA variant is a change in the DNA sequence that can affect an individual's traits, including lactase persistence.</data>
      <data key="d2">ccd3c800d2985d4ad5e2c8d6e88b1b68</data>
      <data key="d5">0</data>
      <data key="d6">9966</data>
