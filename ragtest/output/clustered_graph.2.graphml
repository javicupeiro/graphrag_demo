      <data key="d6">124</data>
      <data key="d7">0ee6ed294a8b4168a39109226beafc31</data>
    </node>
    <node id="S&#205;NDROME DE KEARNS-SAYRE">
      <data key="d0">EVENT</data>
      <data key="d1">Kearns-Sayre syndrome is a mitochondrial disorder that can lead to muscle weakness and dysphagia.</data>
      <data key="d2">c4707350a1cb759e58f3d611445992ba</data>
      <data key="d5">0</data>
      <data key="d6">125</data>
      <data key="d7">2ff678b1cee24ed8870b3552025a4ff0</data>
    </node>
    <node id="S&#205;NDROME DE LAMBERT-EATON">
      <data key="d0">EVENT</data>
      <data key="d1">Lambert-Eaton syndrome is a condition that affects the neuromuscular junction and can lead to swallowing difficulties.</data>
      <data key="d2">c4707350a1cb759e58f3d611445992ba</data>
