      <data key="d0">EVENT</data>
      <data key="d1">S&#237;ndrome de Marfan is a genetic disorder that shares clinical manifestations with elevated levels of homociste&#237;na, such as osteoporosis and skeletal abnormalities.</data>
      <data key="d2">b1d588e0c9c4cef32da41373afbd1901</data>
      <data key="d3">1640</data>
      <data key="d4">2</data>
