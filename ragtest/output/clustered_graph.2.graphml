      <data key="d10">7e3e2024996e402fc0ab62933ab9417b</data>
      <data key="d11">13ba48558e5849a6aab24fee6db87164</data>
      <data key="d12">14349</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="INTENSIVE NUTRITIONAL SUPPORT">
      <data key="d8">8.0</data>
      <data key="d9">Intensive nutritional support is often required for patients suffering from SIC to manage their nutritional needs</data>
      <data key="d10">4ada21f24df8df18dbc05f5619c0a368</data>
      <data key="d11">a94f7d231d1c47889d242f79bce1c503</data>
      <data key="d12">14350</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="ADAPTATION">
      <data key="d8">7.0</data>
      <data key="d9">The process of adaptation occurs in response to the loss of intestine in patients with SIC, helping to improve nutrient absorption</data>
      <data key="d10">4ada21f24df8df18dbc05f5619c0a368</data>
      <data key="d11">9ea641c74ce7454db7915b1b27dca103</data>
      <data key="d12">14351</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="INTESTINE">
      <data key="d8">9.0</data>
      <data key="d9">The health and functionality of the intestine are critical in the context of SIC, as its loss leads to the syndrome</data>
      <data key="d10">4ada21f24df8df18dbc05f5619c0a368</data>
      <data key="d11">ee939853e5444629b75452e36ae980aa</data>
      <data key="d12">14352</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="ANATOMY">
      <data key="d8">1.0</data>
      <data key="d9">Understanding the anatomy of the intestine is essential for diagnosing and treating SIC</data>
      <data key="d10">4ada21f24df8df18dbc05f5619c0a368</data>
      <data key="d11">3e1282b167f84b12b870de6251321732</data>
      <data key="d12">14353</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="POIC">
      <data key="d8">13.0</data>
      <data key="d9">SIC and POIC are both disorders that affect the intestines. POIC, which stands for a rare intestinal disease, is characterized by symptoms suggesting obstruction, while SIC, or Surgical Intestinal Complication, arises as a result of surgical removal of intestinal sections. SIC primarily focuses on the diagnosis and treatment of conditions like POIC, highlighting the interconnected nature of these two intestinal disorders.</data>
      <data key="d10">3d03390859575cc2ead8aa5f917d0066,81d0f9e0238db446bd67439b8222ab32</data>
      <data key="d11">526fb0c5ba6c4d9795d4948108a67011</data>
      <data key="d12">14354</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="CITRULINA">
      <data key="d8">8.0</data>
      <data key="d9">Citrulina levels are used by SIC as a biochemical marker to assess intestinal health and the need for nutritional support</data>
      <data key="d10">3d03390859575cc2ead8aa5f917d0066</data>
      <data key="d11">537620f250094c80816049fc91fe9917</data>
      <data key="d12">14355</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="TR&#193;NSITO INTESTINAL">
      <data key="d8">8.0</data>
      <data key="d9">Tr&#225;nsito intestinal is a procedure that provides valuable information for SIC in assessing intestinal conditions</data>
      <data key="d10">3d03390859575cc2ead8aa5f917d0066</data>
      <data key="d11">8e933fbfe31f41a19fd9d2bca5084261</data>
      <data key="d12">14356</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="TOMOGRAF&#205;A COMPUTARIZADA">
      <data key="d8">8.0</data>
      <data key="d9">Tomograf&#237;a computarizada is utilized by SIC to diagnose complications related to intestinal conditions</data>
      <data key="d10">3d03390859575cc2ead8aa5f917d0066</data>
      <data key="d11">a62533b1e9ae4d5ba2c0c85becbe71f4</data>
      <data key="d12">14357</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="OSTOM&#205;AS">
      <data key="d8">1.0</data>
      <data key="d9">Ostom&#237;as may be evaluated by SIC to assess the functionality of the remaining intestine</data>
      <data key="d10">3d03390859575cc2ead8aa5f917d0066</data>
      <data key="d11">edd98bf67bd546049bfce1895f3f5f97</data>
      <data key="d12">14358</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="FALLO INTESTINAL">
      <data key="d8">15.0</data>
      <data key="d9">The SIC (S&#237;ndrome de Intestino Corto) can lead to fallo intestinal (intestinal failure) due to the loss of intestinal mass necessary for adequate absorption. This condition is characterized by a significant reduction in the functional length of the intestine, which impairs the body's ability to absorb nutrients effectively. As a result, individuals with SIC often require specialized nutritional treatment to manage their condition and ensure proper nutrient intake.</data>
      <data key="d10">a2c6ccdc966e72b4675d71b4c072e1dc,eb8fe6b54f7eab9cbe7b90c53e7007ed</data>
      <data key="d11">d20c28d5c2b740ca91119df7660dc33f</data>
      <data key="d12">14359</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="TEDUGLUTIDA">
      <data key="d8">1.0</data>
      <data key="d9">Teduglutida is indicated for the treatment of short bowel syndrome (SIC) in patients</data>
      <data key="d10">e0196a8a0ead0a27b38ddfb16a5c5772</data>
      <data key="d11">7ab223ebd74c49b9bddaead81cc44f48</data>
      <data key="d12">14360</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="EHAFI">
      <data key="d8">7.0</data>
      <data key="d9">EHAFI is a condition that can occur in patients suffering from SIC, requiring specific management strategies</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">eb55de46f41c4380aae7cc0c99e014f0</data>
      <data key="d12">14361</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="DAPTOMICINA">
      <data key="d8">6.0</data>
      <data key="d9">Daptomicina is used to treat infections that can occur in patients with SIC, particularly those related to catheters</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">04b5a74f0b1042dfb49c2d68cf54c1c5</data>
      <data key="d12">14362</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="LACTOBACILLUS">
      <data key="d8">5.0</data>
      <data key="d9">Lactobacillus can cause D-lactic acidosis in patients with SIC, leading to significant clinical symptoms</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">6f44541e1f5541d98b553eb86c387d3b</data>
      <data key="d12">14363</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="NPD">
      <data key="d8">9.0</data>
      <data key="d9">NPD is a nutritional support method used for patients with SIC to manage their condition</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">7a331084233e4dbfbea7477a5641a025</data>
      <data key="d12">14364</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="ACIDOSIS D-L&#193;CTICA">
      <data key="d8">6.0</data>
      <data key="d9">Acidosis D-l&#225;ctica is a complication that can occur in patients with SIC due to the fermentation of carbohydrates</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">7420e1be738a41fe96a5ff93008bf4fa</data>
      <data key="d12">14365</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="CAT&#201;TER VENOSO CENTRAL">
      <data key="d8">7.0</data>
      <data key="d9">Central venous catheters are often used in patients with SIC, leading to potential infections</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">46199d1667814a79985625775ee95bb2</data>
      <data key="d12">14366</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="FISTULA ARTERIOVENOSA">
      <data key="d8">1.0</data>
      <data key="d9">An arteriovenous fistula may be used for NPD administration in patients with SIC, providing a safer access method</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">63b1c91d5cdb438dbf4357cc65968aa0</data>
      <data key="d12">14367</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SIC" target="FEC">
      <data key="d8">7.0</data>
      <data key="d9">SIC and FEC are both conditions related to intestinal failure and its complications</data>
      <data key="d10">81d0f9e0238db446bd67439b8222ab32</data>
      <data key="d11">c94d67156ac6401f88fe282c335b4070</data>
      <data key="d12">14368</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MORIES &#193;LVAREZ" target="SOCIETY OF ENDOCRINOLOGY AND NUTRITION">
      <data key="d8">7.0</data>
      <data key="d9">Mories &#193;lvarez is associated with the Society of Endocrinology and Nutrition through their contributions to the Manual de Endocrinolog&#237;a y Nutrici&#243;n</data>
      <data key="d10">70e6c476cce381861896b5a6be2f39ad</data>
      <data key="d11">535ec3e13fc543d7a85b96adee210ca7</data>
      <data key="d12">14369</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DELAGADO G&#211;MEZ" target="SOCIETY OF ENDOCRINOLOGY AND NUTRITION">
      <data key="d8">7.0</data>
      <data key="d9">Delgado G&#243;mez is associated with the Society of Endocrinology and Nutrition through their contributions to the Manual de Endocrinolog&#237;a y Nutrici&#243;n</data>
      <data key="d10">70e6c476cce381861896b5a6be2f39ad</data>
      <data key="d11">ca0cfe69c5a54c8197e283ef7cea5161</data>
      <data key="d12">14370</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SOCIETY OF ENDOCRINOLOGY AND NUTRITION" target="GRUPO DE TRABAJO DE OSTEOPOROSIS Y METABOLISMO MINERAL">
      <data key="d8">9.0</data>
      <data key="d9">The Working Group on Osteoporosis and Mineral Metabolism operates under the Society of Endocrinology and Nutrition</data>
      <data key="d10">70e6c476cce381861896b5a6be2f39ad</data>
      <data key="d11">5acd6c88f82643ef929f9bdd46a0fa3e</data>
      <data key="d12">14371</data>
      <data key="d13">2</data>
    </edge>
    <edge source="REYES-GARC&#205;A" target="GRUPO DE TRABAJO DE OSTEOPOROSIS Y METABOLISMO MINERAL">
      <data key="d8">8.0</data>
      <data key="d9">Reyes-Garc&#237;a is part of the Working Group on Osteoporosis and Mineral Metabolism, contributing to updates on osteoporosis treatment</data>
      <data key="d10">70e6c476cce381861896b5a6be2f39ad</data>
      <data key="d11">f24dac89f71d4f16b47c43db042e7be2</data>
      <data key="d12">14372</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GARC&#205;A-MART&#205;N" target="GRUPO DE TRABAJO DE OSTEOPOROSIS Y METABOLISMO MINERAL">
      <data key="d8">8.0</data>
      <data key="d9">Garc&#237;a-Mart&#237;n is part of the Working Group on Osteoporosis and Mineral Metabolism, contributing to updates on osteoporosis treatment</data>
      <data key="d10">70e6c476cce381861896b5a6be2f39ad</data>
      <data key="d11">0d278525ed49471781668e8da79c080c</data>
      <data key="d12">14373</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MINISTERIO DE SANIDAD Y CONSUMO" target="GU&#205;A DE PR&#193;CTICA CL&#205;NICA SOBRE TRASTORNOS DE LA CONDUCTA ALIMENTARIA">
      <data key="d8">1.0</data>
      <data key="d9">The Ministry of Health and Consumption published the Clinical Practice Guide on Eating Disorders</data>
      <data key="d10">70e6c476cce381861896b5a6be2f39ad</data>
      <data key="d11">d03c05ca115a42b488c45b9b1b4095df</data>
      <data key="d12">14374</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MINISTERIO DE SANIDAD Y CONSUMO" target="GRUPO DE TRABAJO DE LA GU&#205;A DE PR&#193;CTICA CL&#205;NICA">
      <data key="d8">7.0</data>
      <data key="d9">The working group develops guidelines under the auspices of the Ministry of Health and Consumption, focusing on eating disorders.</data>
      <data key="d10">8029c950c540c731bb9334bd90348239</data>
      <data key="d11">277be789fd60494785c50197e72c1045</data>
      <data key="d12">14375</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MINISTERIO DE SANIDAD Y CONSUMO" target="AG&#200;NCIA D'AVALUACI&#211; DE TECNOLOGIA I RECERCA M&#200;DIQUES DE CATALUNYA">
      <data key="d8">7.0</data>
      <data key="d9">Both organizations are involved in the development and dissemination of clinical guidelines for health practices in Spain</data>
      <data key="d10">9c65bcd67b717641c8d9d94ef9cfb210</data>
      <data key="d11">1b5325b7c32245af98c48bf42407409c</data>
      <data key="d12">14376</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MINISTERIO DE SANIDAD Y CONSUMO" target="LEY 41/2002">
      <data key="d8">7.0</data>
      <data key="d9">El Ministerio de Sanidad y Consumo es responsable de la implementaci&#243;n y regulaci&#243;n de la Ley 41/2002 en Espa&#241;a</data>
      <data key="d10">9934fdd98a0d66fb3ff7ac1b56b18460</data>
      <data key="d11">6051a9b94b294d09bf499d73c7fc27c7</data>
      <data key="d12">14377</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MINISTERIO DE SANIDAD Y CONSUMO" target="REAL DECRETO 124/2007">
      <data key="d8">6.0</data>
      <data key="d9">El Real Decreto 124/2007 es regulado por el Ministerio de Sanidad y Consumo, estableciendo el Registro Nacional de Instrucciones Previas</data>
      <data key="d10">9934fdd98a0d66fb3ff7ac1b56b18460</data>
      <data key="d11">36add33aea5845c5a16011c222ca67e6</data>
      <data key="d12">14378</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MINISTERIO DE SANIDAD Y CONSUMO" target="BIBLIOTECA COCHRANE">
      <data key="d8">6.0</data>
      <data key="d9">The Ministerio de Sanidad y Consumo provides access to the Biblioteca Cochrane's systematic reviews in Spanish.</data>
      <data key="d10">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d11">23219f4d705d49889b7934cf57dd5b6a</data>
      <data key="d12">14379</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DHEA-S" target="ADRENAL INCIDENTALOMA">
      <data key="d8">7.0</data>
      <data key="d9">DHEA-S levels are measured to assess adrenal function in patients with adrenal incidentalomas</data>
      <data key="d10">b7b162b783ea688c5fe9b7f531b46aaf</data>
      <data key="d11">512fb4e8575c4e87acc8c439916937b8</data>
      <data key="d12">14380</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DHEA-S" target="HARRISON PRINCIPIOS DE MEDICINA INTERNA">
      <data key="d8">7.0</data>
      <data key="d9">DHEA-S is discussed in the context of adrenal disorders in the Harrison textbook</data>
      <data key="d10">28bca03cd2152cf2562d7aa16d7ced1d</data>
      <data key="d11">201af2d7beb6418eb1f37c74aaaaece5</data>
      <data key="d12">14381</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DHEA-S" target="SUPRARENAL GLAND">
      <data key="d8">7.0</data>
      <data key="d9">The suprarenal glands produce DHEA-S, linking the two entities through hormonal production</data>
      <data key="d10">05a6995cef9c8d0279b9f026da1ffed1</data>
      <data key="d11">d7a8bf54b8384c46b978d1b50176fcbc</data>
      <data key="d12">14382</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DHEA-S" target="HYPERANDROGENISM">
      <data key="d8">1.0</data>
      <data key="d9">DHEA-S levels are often elevated in cases of hyperandrogenism, establishing a direct relationship.</data>
      <data key="d10">dda58e50ce4bb9fa40e3c61e40e1b9c7</data>
      <data key="d11">623b777e467d47feb50bbc13da78b5c8</data>
      <data key="d12">14383</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DSM-5" target="BULIMIA NERVIOSA">
      <data key="d8">9.0</data>
      <data key="d9">The DSM-5 outlines the diagnostic criteria for bulimia nerviosa, including its symptoms and treatment approaches</data>
      <data key="d10">9c65bcd67b717641c8d9d94ef9cfb210</data>
      <data key="d11">268a366f21624ca587f8d725994ce88e</data>
      <data key="d12">14384</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DSM-5" target="TCA">
      <data key="d8">1.0</data>
      <data key="d9">The DSM-5 provides the diagnostic criteria for the classification of eating disorders, including TCA</data>
      <data key="d10">ecf27310ce7cbfc335117dafa5d4eefb</data>
      <data key="d11">075030f096c44dc3a8d12b3000c256b8</data>
      <data key="d12">14385</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DSM-5" target="ASOCIACI&#211;N AMERICANA DE PSIQUIATR&#205;A">
      <data key="d8">9.0</data>
      <data key="d9">The American Psychiatric Association publishes the DSM-5, which includes diagnostic criteria for eating disorders</data>
      <data key="d10">3bc554a0031c436483a977c2b9e57b48</data>
      <data key="d11">62528a17d577442780da94b967e8708a</data>
      <data key="d12">14386</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GRUPO DE TRABAJO DE LA GU&#205;A DE PR&#193;CTICA CL&#205;NICA" target="EDUCACI&#211;N NUTRICIONAL">
      <data key="d8">1.0</data>
      <data key="d9">The working group emphasizes the importance of nutritional education in the management and prevention of eating disorders.</data>
      <data key="d10">8029c950c540c731bb9334bd90348239</data>
      <data key="d11">7c5140b722cc49798cd6c8328000e7eb</data>
      <data key="d12">14387</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EDUCACI&#211;N NUTRICIONAL" target="DRFQ">
      <data key="d8">8.0</data>
      <data key="d9">Educaci&#243;n nutricional is essential for managing DRFQ and improving patient outcomes</data>
      <data key="d10">dc7539b4d637d6dd09963c2564f4f084</data>
      <data key="d11">f3ec51e2cfbc4760863d171354736a14</data>
      <data key="d12">14388</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BULIMIA NERVIOSA" target="TRASTORNO DEL COMPORTAMIENTO ALIMENTARIO">
      <data key="d8">9.0</data>
      <data key="d9">Bulimia Nervosa is classified as an eating disorder under the broader category of Eating Disorders (TCA)</data>
      <data key="d10">bbb0b98043e40738bce354afe3de265c</data>
      <data key="d11">2033b63729984649890710ff6803abef</data>
      <data key="d12">14389</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BULIMIA NERVIOSA" target="HOSPITAL GENERAL UNIVERSITARIO GREGORIO MARA&#209;&#211;N">
      <data key="d8">7.0</data>
      <data key="d9">The hospital offers specialized care for individuals with bulimia nervosa</data>
      <data key="d10">ecf27310ce7cbfc335117dafa5d4eefb</data>
      <data key="d11">fdea4f398a9d43debecd0d6a5f95dfdf</data>
      <data key="d12">14390</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BULIMIA NERVIOSA" target="MUJERES ADOLESCENTES">
      <data key="d8">8.0</data>
      <data key="d9">Las mujeres adolescentes presentan una prevalencia del 2-4% para la bulimia nerviosa, lo que sugiere una conexi&#243;n significativa.</data>
      <data key="d10">04221ccceb5e95933ff349645c328457</data>
      <data key="d11">e7377be3489946b1a4b7087aa1dd5a49</data>
      <data key="d12">14391</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BULIMIA NERVIOSA" target="VARONES">
      <data key="d8">4.0</data>
      <data key="d9">Los varones tienen un riesgo de desarrollar bulimia nerviosa, aunque la prevalencia es menor en comparaci&#243;n con las mujeres.</data>
      <data key="d10">04221ccceb5e95933ff349645c328457</data>
      <data key="d11">38046f5a0ea84d888f5beaf8f00b4db5</data>
      <data key="d12">14392</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BULIMIA NERVIOSA" target="ATLETAS">
      <data key="d8">6.0</data>
      <data key="d9">Los atletas pueden desarrollar bulimia nerviosa debido a la presi&#243;n para cumplir con est&#225;ndares de peso y rendimiento.</data>
      <data key="d10">04221ccceb5e95933ff349645c328457</data>
      <data key="d11">cad29e0807c74147a4b47694bac2cb3f</data>
      <data key="d12">14393</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BULIMIA NERVIOSA" target="TCA">
      <data key="d8">9.0</data>
      <data key="d9">La bulimia nerviosa es otra categor&#237;a dentro de los trastornos de la conducta alimentaria (TCA).</data>
      <data key="d10">04221ccceb5e95933ff349645c328457</data>
      <data key="d11">4ebe89d70920468091cde8d9f524161c</data>
      <data key="d12">14394</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BULIMIA NERVIOSA" target="TRASTORNO POR ATRAC&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">Bulimia nerviosa and trastorno por atrac&#243;n both involve binge eating but differ in the presence of compensatory behaviors.</data>
      <data key="d10">7cc3d3c5826ce81977ed8ad725e1ddbe</data>
      <data key="d11">d66a11509b444bd09986c289740413bf</data>
      <data key="d12">14395</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BULIMIA NERVIOSA" target="EDUCATIONAL INSTITUTION">
      <data key="d8">1.0</data>
      <data key="d9">Educational institutions may offer programs to help individuals understand and recover from Bulimia Nervosa</data>
      <data key="d10">e165a1c74230c4f9f29f883df45e4c8c</data>
      <data key="d11">09d3a0c2f2ff49f4b1c2b693ef254a6c</data>
      <data key="d12">14396</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PELEGRINA CORT&#201;S B" target="TOMOS V">
      <data key="d8">7.0</data>
      <data key="d9">Pelegrina Cort&#233;s B contributed to the chapter on nutrition in eating disorders in Tomo V</data>
      <data key="d10">8bcd338de10fbee8f3c808cc30b69b25</data>
      <data key="d11">cd91cfd444af4aad884cde558c5709ae</data>
      <data key="d12">14397</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PALMA MILLA S" target="TOMOS V">
      <data key="d8">7.0</data>
      <data key="d9">Palma Milla S contributed to the chapter on nutrition in eating disorders in Tomo V</data>
      <data key="d10">8bcd338de10fbee8f3c808cc30b69b25</data>
      <data key="d11">d79dc1458d884035a4e660fb44a52917</data>
      <data key="d12">14398</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TOPIRAMATO" target="FDA">
      <data key="d8">8.0</data>
      <data key="d9">The FDA approved topiramato for use in combination with fentermina for obesity treatment</data>
      <data key="d10">35dc97b15f3fd556acbfdb405eadda06</data>
      <data key="d11">7a44c97271934c37a2ba658f69d8b4a8</data>
      <data key="d12">14399</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TOPIRAMATO" target="FENTERMINA">
      <data key="d8">8.0</data>
      <data key="d9">Fentermina and topiramato are combined in a medication for weight loss, enhancing each other's effects</data>
      <data key="d10">af631316aa8584710d755d8c59e851b6</data>
      <data key="d11">0c1b30267b804e1b89738d9788784e4c</data>
      <data key="d12">14400</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TOPIRAMATO" target="EQUIP">
      <data key="d8">7.0</data>
      <data key="d9">The EQUIP trial studies the effects of topiramato in combination with fentermina in severely obese adults</data>
      <data key="d10">af631316aa8584710d755d8c59e851b6</data>
      <data key="d11">ab31ce8fe3e34f4094df8b34bb690531</data>
      <data key="d12">14401</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TOPIRAMATO" target="CONQUER">
      <data key="d8">7.0</data>
      <data key="d9">The CONQUER study examines the effects of topiramato in combination with fentermina on weight and comorbidities in overweight and obese adults</data>
      <data key="d10">af631316aa8584710d755d8c59e851b6</data>
      <data key="d11">67a19bc4edf94831bf2af04e0c77fb7c</data>
      <data key="d12">14402</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TOPIRAMATO" target="G&#211;MEZ ENTERR&#205;A">
      <data key="d8">7.0</data>
      <data key="d9">G&#243;mez Enterr&#237;a provides information about the effects of Topiramato on appetite</data>
      <data key="d10">04f886244ff7d736eb270f175d6b120e</data>
      <data key="d11">596f5c20ab0a48cabbeae91302e520d3</data>
      <data key="d12">14403</data>
      <data key="d13">2</data>
    </edge>
    <edge source="METOTREXATO" target="&#193;C. VALPROICO">
      <data key="d8">6.0</data>
