    </node>
    <node id="SISTEMA RETICULOENDOTELIAL">
      <data key="d0">EVENT</data>
      <data key="d1">The reticuloendothelial system is involved in immune response and may be impacted by chronic pancreatitis.</data>
      <data key="d2">803363886f385b089938bf122246dfa2</data>
      <data key="d3">198</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
