      <data key="d5">1</data>
      <data key="d6">7350</data>
      <data key="d7">ce9e9971829547e282e22898840bdd9a</data>
    </node>
    <node id="CIRCUNFERENCIA DE LA CINTURA">
      <data key="d0">EVENT</data>
      <data key="d1">Waist circumference is a measure of abdominal fat that can indicate health risks, and it can be reduced through adherence to the Mediterranean diet.</data>
      <data key="d2">72d0be9d03c79097f867a8af2e3e89e4</data>
      <data key="d3">1379</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">7351</data>
      <data key="d7">3df345ed843e4dfc8ccfecf2f0cc8cf5</data>
    </node>
    <node id="ESTUDIO PREDIMED PLUS">
      <data key="d0">EVENT</data>
      <data key="d1">El estudio PREDIMED PLUS es un ensayo multic&#233;ntrico en desarrollo que evaluar&#225; el efecto de la dieta mediterr&#225;nea sobre la p&#233;rdida de peso y la salud cardiovascular.</data>
      <data key="d2">01302d2656a8cbb49cb7505b3182cc63</data>
      <data key="d3">1379</data>
