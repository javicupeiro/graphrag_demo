      <data key="d6">4636</data>
      <data key="d7">7790f0fdb5114bc6a6744457559f343f</data>
    </node>
    <node id="HIPOECOGENICIDAD">
      <data key="d0">EVENT</data>
      <data key="d1">Hypoechogenicity refers to the appearance of thyroid nodules on ultrasound, which can be associated with malignancy.</data>
      <data key="d2">673c86b4e90c81d1c4bc78cdd08e9be0</data>
      <data key="d3">1211</data>
      <data key="d4">2</data>
