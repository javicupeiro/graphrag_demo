      <data key="d7">86b421995fd848a986ace7d9fdb7326f</data>
    </node>
    <node id="HORMONE SYNTHESIS">
      <data key="d0">EVENT</data>
      <data key="d1">Hormone synthesis, particularly thyroid iodine metabolism, is a critical process in endocrinology, discussed in medical texts.</data>
      <data key="d2">47ba8105b81c59f81a9038446898d200</data>
      <data key="d5">0</data>
      <data key="d6">14194</data>
      <data key="d7">949b24f20c584d36a93d281b3a7166c7</data>
    </node>
    <node id="BOWEL PREPARATION">
      <data key="d0">EVENT</data>
      <data key="d1">Bowel preparation is a medical procedure necessary before colonoscopy, involving dietary restrictions and cleansing protocols.</data>
      <data key="d2">47ba8105b81c59f81a9038446898d200</data>
      <data key="d3">1029</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">14195</data>
      <data key="d7">c1bbf419d5844a5ab252f4f8832b5d8b</data>
    </node>
    <node id="ENHANCED RECOVERY AFTER SURGERY (ERAS)">
      <data key="d0">EVENT</data>
      <data key="d1">ERAS is a set of guidelines aimed at improving recovery after surgical procedures, particularly in colonic and pancreatic surgeries.</data>
      <data key="d2">47ba8105b81c59f81a9038446898d200</data>
      <data key="d3">1029</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14196</data>
      <data key="d7">417978caab87414498569f058e7a9faa</data>
    </node>
    <node id="COMPLEJO ASISTENCIAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Complejo Asistencial in Le&#243;n is a healthcare institution where various medical professionals work, including those specializing in endocrinology and nutrition.</data>
      <data key="d2">fa5c0208b983c59b247a65e6bb166f2a</data>
      <data key="d3">1455</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">14197</data>
      <data key="d7">d81c0c17f5ea417db76b86a943dbdc6c</data>
    </node>
    <node id="JOINT COMMISSION ON ACCREDITATION OF HEALTHCARE ORGANIZATIONS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Joint Commission on Accreditation of Healthcare Organizations (JCAHO) is an organization dedicated to establishing standards for healthcare quality and accreditation in the United States. It serves as an external agent that verifies whether healthcare organizations comply with specific quality standards, ensuring that they provide safe and effective care to patients.</data>
      <data key="d2">0e4628d74bee9cdd38f544f119527748,fa5c0208b983c59b247a65e6bb166f2a</data>
      <data key="d3">1455</data>
