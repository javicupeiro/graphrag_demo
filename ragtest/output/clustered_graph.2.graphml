    <node id="FACTORES SOLUBLES DE CRECIMIENTO">
      <data key="d0">EVENT</data>
      <data key="d1">Los factores solubles de crecimiento son prote&#237;nas que pueden influir en la regulaci&#243;n de la secreci&#243;n de hormonas en la adenohip&#243;fisis.</data>
