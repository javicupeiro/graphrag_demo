      <data key="d10">d77e49d1dba3a67fbc9cf58911dc2478</data>
      <data key="d11">50b53ab7d0754d1085cf67364b58017c</data>
      <data key="d12">5445</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE CABEZA Y CUELLO" target="ORNITINA ALFA-CETOGLUTARATO">
      <data key="d8">4.0</data>
      <data key="d9">La ornitina alfa-cetoglutarato se investiga para su uso en pacientes quemados, que pueden incluir aquellos con c&#225;ncer</data>
      <data key="d10">d77e49d1dba3a67fbc9cf58911dc2478</data>
      <data key="d11">baf4614a31f44d93bf8333632ea20940</data>
      <data key="d12">5446</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE CABEZA Y CUELLO" target="ZINC">
      <data key="d8">5.0</data>
      <data key="d9">El zinc es un oligoelemento que puede ser beneficioso para pacientes con c&#225;ncer al mejorar la respuesta inmune</data>
      <data key="d10">d77e49d1dba3a67fbc9cf58911dc2478</data>
      <data key="d11">ac29267a194f4a3ca0d06e5efeb54bf5</data>
      <data key="d12">5447</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C&#193;NCER DE CABEZA Y CUELLO" target="POLIFENOLES">
      <data key="d8">6.0</data>
      <data key="d9">Los polifenoles est&#225;n siendo evaluados por su potencial para prevenir el crecimiento tumoral en pacientes con c&#225;ncer</data>
      <data key="d10">d77e49d1dba3a67fbc9cf58911dc2478</data>
      <data key="d11">0284ee6ed1eb47c6a8ebe29a9012bf02</data>
