    <edge source="HIPOMAGNESEMIA" target="HIPOCALCEMIA">
      <data key="d8">8.0</data>
      <data key="d9">Hipomagnesemia is often associated with symptomatic hypocalcemia due to low magnesium levels affecting calcium metabolism</data>
      <data key="d10">85ee651c191c3b0c5fe786fe2e0718a4</data>
      <data key="d11">18fbb92023fe4bd5bdf3e443e3dbf3f1</data>
