    <edge source="DR. P. CLAV&#201; CIVIT" target="M&#201;TODO DE EXPLORACI&#211;N CL&#205;NICA VOLUMEN-VISCOSIDAD">
      <data key="d8">8.0</data>
      <data key="d9">Dr. P. Clav&#233; Civit developed the clinical exploration method for volume-viscosity to assess swallowing disorders</data>
      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">bbe09c1961314309959ad412a1d5e92e</data>
      <data key="d12">2248</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#201;TODO DE EXPLORACI&#211;N CL&#205;NICA VOLUMEN-VISCOSIDAD" target="BOLUS">
      <data key="d8">7.0</data>
      <data key="d9">The clinical exploration method involves administering boluses of varying volumes and viscosities to assess swallowing</data>
      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">5008826fc34b4eb3ad6b1ebc3e03985d</data>
      <data key="d12">2249</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#201;TODO DE EXPLORACI&#211;N CL&#205;NICA VOLUMEN-VISCOSIDAD" target="PULSOX&#205;METRO">
      <data key="d8">1.0</data>
      <data key="d9">A pulse oximeter is used during the volume-viscosity method to monitor the patient's oxygen levels for safety during swallowing tests</data>
      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">e25d8fdbee554c8fa02a52f547f26e35</data>
      <data key="d12">2250</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#201;TODO DE EXPLORACI&#211;N CL&#205;NICA VOLUMEN-VISCOSIDAD" target="ALIMENTOS">
      <data key="d8">8.0</data>
      <data key="d9">The MECV-V method uses different food volumes and viscosities to assess swallowing</data>
      <data key="d10">42cc35e2edb450d48bb31f7c51b7a02f</data>
      <data key="d11">fc4d239fd891444caf6e7c93fd4afd8a</data>
      <data key="d12">2251</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLUS" target="VIDEOENDOSCOPIC EXPLORATION">
      <data key="d8">8.0</data>
      <data key="d9">The bolus is evaluated during the videoendoscopic exploration to assess swallowing</data>
      <data key="d10">a76f6268d6065b1baabb9e13ef7f098c</data>
      <data key="d11">71750332deff4bd39ec07e8bc88fc0ca</data>
      <data key="d12">2252</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLUS" target="PHARYNGEAL PHASE">
      <data key="d8">8.0</data>
      <data key="d9">The pharyngeal phase is initiated once the bolus is propelled into the pharynx</data>
      <data key="d10">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d11">c902763a1ceb4a50988ede0668b44ca3</data>
      <data key="d12">2253</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BOLUS" target="ORAL PHASE">
      <data key="d8">8.0</data>
      <data key="d9">The oral phase involves the preparation and transportation of the bolus towards the pharynx</data>
      <data key="d10">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d11">09613097a0cf47dbaa397fa7de932ee2</data>
      <data key="d12">2254</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MOVILIDAD DE LA MAND&#205;BULA" target="MASTICACI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">Masticaci&#243;n requires proper jaw mobility to effectively chew food</data>
      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">be2f1818185244a887077d5e7cbb123e</data>
      <data key="d12">2255</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SENSIBILIDAD OROFAR&#205;NGEA" target="RETARDO DEL DISPARO DEGLUTORIO">
      <data key="d8">7.0</data>
      <data key="d9">Oropharyngeal sensitivity is crucial for triggering the swallowing reflex, which can be delayed</data>
      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">cd310f128a914ad2ac7393af21a30d64</data>
      <data key="d12">2256</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CAPACIDAD DE LIMPIEZA DE LOS SURCOS GINGIVOLABIALES" target="MASTICACI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">The ability to clean the gingivolabial sulcus is important for effective masticaci&#243;n and preventing swallowing issues</data>
      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">806ca60d5af84b2f9dd030c10af21b46</data>
      <data key="d12">2257</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CALIDAD VOCAL" target="SIGNOS DE SEGURIDAD">
      <data key="d8">5.0</data>
      <data key="d9">Vocal quality can indicate safety during swallowing, as changes may suggest potential aspiration risks</data>
      <data key="d10">89b6a28e230890818d938efa74cd1268</data>
      <data key="d11">b515aba091d34184a0772fd3216afabb</data>
      <data key="d12">2258</data>
      <data key="d13">2</data>
    </edge>
