    <edge source="DCCT" target="EDIC">
      <data key="d8">9.0</data>
      <data key="d9">The DCCT (Diabetes Control and Complications Trial) study was succeeded by the EDIC (Epidemiology of Diabetes Interventions and Complications) study, which aimed to evaluate the long-term effects of diabetes management on complications. The EDIC study serves as a follow-up to the DCCT study, tracking the long-term outcomes of the same patient cohort that participated in the initial trial. Together, these studies provide valuable insights into the management of diabetes and its implications for patient health over time.</data>
      <data key="d10">dfe972dc8a4eabfc8948770fe113c833,fe8c41d0de4d4e277554bb9256255f30</data>
      <data key="d11">d7de28002324419399a117fa19d02f6a</data>
      <data key="d12">13425</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EDIC" target="GUBITOSI-KLUG RA">
      <data key="d8">7.0</data>
      <data key="d9">Gubitosi-Klug RA is a researcher involved in the EDIC study, contributing to its findings</data>
      <data key="d10">dfe972dc8a4eabfc8948770fe113c833</data>
      <data key="d11">f2b6cb10909e44cca1cbb3386eede02d</data>
      <data key="d12">13426</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EDIC" target="LACHIN JM">
      <data key="d8">7.0</data>
