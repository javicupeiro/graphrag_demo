      <data key="d11">d490df8e3c024e07a3fdbdff897fbbbb</data>
      <data key="d12">5923</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="ADENOMA HIPOFISARIO">
      <data key="d8">8.0</data>
      <data key="d9">La OMS ha actualizado la clasificaci&#243;n de los adenomas hipofisarios, reconociendo diferentes tipos y caracter&#237;sticas cl&#237;nicas</data>
      <data key="d10">8ceedaeea54ca164b32a166116187b29</data>
      <data key="d11">97df7cc9c7724f92bf1456d206e93565</data>
      <data key="d12">5924</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OMS" target="CRANEOPARINGIOMAS">
      <data key="d8">8.0</data>
