      <data key="d5">2</data>
      <data key="d6">8518</data>
      <data key="d7">ae481f5d450940ac97eedd568e391ac7</data>
    </node>
    <node id="HELADO ITALIANO">
      <data key="d0">EVENT</data>
      <data key="d1">Helado italiano refers to Italian ice cream, which has a glycemic index of 114, indicating its impact on blood sugar levels.</data>
      <data key="d2">5116416429465894c102d9fb93d6a8fc</data>
      <data key="d3">1892</data>
      <data key="d4">2</data>
