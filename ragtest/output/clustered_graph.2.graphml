      <data key="d11">455a2457b7d04f8db99cc8454bcc05fc</data>
      <data key="d12">5040</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA CARRAGENINA" target="GOMA LOCUSTE">
      <data key="d8">7.0</data>
      <data key="d9">Ambas gomas son utilizadas como espesantes y estabilizantes en la industria alimentaria</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">486bfc7028384cdd958571e98de8f7a5</data>
      <data key="d12">5041</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA LOCUSTE" target="GOMA GHATTI">
      <data key="d8">6.0</data>
      <data key="d9">Ambas gomas son polisac&#225;ridos utilizados en la industria alimentaria para mejorar la textura de los productos</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">188aeffc3c4a4f82949dda065ca220b9</data>
      <data key="d12">5042</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA LOCUSTE" target="CERATONIA SILIQUA">
      <data key="d8">9.0</data>
      <data key="d9">La goma locuste se extrae de las semillas del &#225;rbol Ceratonia siliqua</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">b4fb01b020164aaabe13ce181b28acc7</data>
      <data key="d12">5043</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA GHATTI" target="GOMA KARAYA">
      <data key="d8">5.0</data>
      <data key="d9">Ambas gomas son polisac&#225;ridos complejos utilizados en la industria alimentaria</data>
