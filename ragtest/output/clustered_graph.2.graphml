      <data key="d6">1696</data>
      <data key="d7">ec1696b73bbe4925a385c1700ae2467d</data>
    </node>
    <node id="DESNUTRICI&#211;N GRAVE">
      <data key="d0">EVENT</data>
      <data key="d1">A classification of malnutrition characterized by a Body Mass Index (BMI) less than 16.</data>
      <data key="d2">4734ce2075bc72c352950c018bab7185</data>
      <data key="d3">1099</data>
      <data key="d4">2</data>
