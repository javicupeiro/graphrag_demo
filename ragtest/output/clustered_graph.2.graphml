    <edge source="HOMOCYSTEINE" target="CYSTATHIONINE">
      <data key="d8">9.0</data>
      <data key="d9">Cystathionine is synthesized from homocysteine, linking these two metabolic processes</data>
      <data key="d10">7754f367b453475179218cac4bc24de1</data>
      <data key="d11">897d284fcd844b75b59f4db19ad46cc6</data>
