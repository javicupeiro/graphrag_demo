    </edge>
    <edge source="VITAMIN D" target="DIALYSIS PERITONEAL">
      <data key="d8">5.0</data>
      <data key="d9">Vitamin D is recommended for patients undergoing peritoneal dialysis to maintain appropriate levels</data>
      <data key="d10">9da930839072b524410f2345ab1df8b1</data>
      <data key="d11">5ad38171dc8b4b0d8a84cd2bfba7d754</data>
      <data key="d12">10475</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMIN D" target="ECHA">
      <data key="d8">6.0</data>
      <data key="d9">Vitamin D deficiency is common in patients with ECHA, necessitating monitoring and supplementation</data>
      <data key="d10">ea1d430dfc773b669eec18759441b31a</data>
      <data key="d11">fc337eeb378a40d388e09d5c4e12a710</data>
      <data key="d12">10476</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMIN D" target="OSTEOPOROSIS">
      <data key="d8">9.0</data>
      <data key="d9">Vitamin D is essential for calcium absorption, which is vital for preventing osteoporosis</data>
      <data key="d10">65ba063e1a9e43a87dbfe9cf627674b1</data>
      <data key="d11">0cb5eb5a55234a428014befd99a9f8e3</data>
      <data key="d12">10477</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMIN D" target="SIC">
      <data key="d8">8.0</data>
      <data key="d9">Optimizing Vitamin D is necessary to prevent metabolic bone disease in patients with SIC</data>
      <data key="d10">6b49a9a43dc167f62a772b262afe2bee</data>
      <data key="d11">ec6e0ac834a740e7ada2c5358a76ff79</data>
      <data key="d12">10478</data>
      <data key="d13">2</data>
    </edge>
