    <edge source="VITAMINAS" target="NUTRICION">
      <data key="d8">1.0</data>
      <data key="d9">Vitamins are a crucial part of the nutritional management for patients with respiratory conditions</data>
      <data key="d10">3bfd2ce2b4408f718fd35e43c03965c7</data>
      <data key="d11">50999c25755848d7aef6b0e9386bdd05</data>
