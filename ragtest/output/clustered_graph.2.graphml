      <data key="d7">22d0882d091545dea5f41ddcd955e18c</data>
    </node>
    <node id="NM ABDOMINAL">
      <data key="d0">EVENT</data>
      <data key="d1">NM abdominal is a medical procedure reserved for difficult cases, cystic neoplasms, and evaluation of bile ducts.</data>
