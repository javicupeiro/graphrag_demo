    <node id="MAILLARD REACTION">
      <data key="d0">EVENT</data>
      <data key="d1">The Maillard reaction is a chemical reaction between amino acids and reducing sugars that gives browned food its distinctive flavor, which can affect the quality of clinical nutrition products.</data>
      <data key="d2">62f527b38024e8807d3e63a0cf488046</data>
      <data key="d3">1443</data>
