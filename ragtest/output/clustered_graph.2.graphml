      <data key="d6">479</data>
      <data key="d7">c0ce39c163c54286bd4f9bcd4bf7f62c</data>
    </node>
    <node id="VALORACI&#211;N DE SENSIBILIDAD Y SECRECIONES">
      <data key="d0">EVENT</data>
      <data key="d1">An assessment method discussed in the manual that evaluates sensitivity and secretions related to swallowing.</data>
