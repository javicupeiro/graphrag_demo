      <data key="d11">2b9359a31a5446868d36674e6548c760</data>
      <data key="d12">11629</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AMERICAN HEART ASSOCIATION" target="WORLD HEALTH ORGANIZATION">
      <data key="d8">13.0</data>
      <data key="d9">The American Heart Association (AHA) and the World Health Organization (WHO) are two prominent organizations dedicated to promoting health guidelines and conducting research on heart disease. They collaborate on global health initiatives specifically related to heart disease and stroke, working together to enhance awareness and improve health outcomes worldwide.</data>
      <data key="d10">844d065cac5f5304fffed35b5da90416,e173daca5490a19b057aecb1ee4edca2</data>
      <data key="d11">37225d16ccc847ec8d47c34974b0783c</data>
      <data key="d12">11630</data>
      <data key="d13">2</data>
    </edge>
