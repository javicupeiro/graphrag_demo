      <data key="d11">a73dcd5ef7ca41af8e6650ec80fc1324</data>
      <data key="d12">8200</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINAS" target="DIETA MEDITERR&#193;NEA">
      <data key="d8">7.0</data>
      <data key="d9">La dieta mediterr&#225;nea incrementa la ingesta de vitaminas, contribuyendo a la salud general</data>
      <data key="d10">01302d2656a8cbb49cb7505b3182cc63</data>
      <data key="d11">b16f9e9286c04657ac248d4c72c1d62e</data>
      <data key="d12">8201</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINAS" target="TABLA 1">
      <data key="d8">5.0</data>
      <data key="d9">Vitamins can be included in the optional nutritional information as per Tabla 1.</data>
