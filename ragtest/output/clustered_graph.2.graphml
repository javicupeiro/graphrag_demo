      <data key="d7">4f385988b45b4bd4b5f1e9c56c73e499</data>
    </node>
    <node id="MALNUTRICI&#211;N EN PACIENTES CON C&#193;NCER">
      <data key="d0">EVENT</data>
      <data key="d1">La malnutrici&#243;n en pacientes con c&#225;ncer se asocia con un pron&#243;stico desfavorable y puede afectar la eficacia del tratamiento.</data>
      <data key="d2">9c3716c3860855ce045a1e5d9d30b9d1</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
