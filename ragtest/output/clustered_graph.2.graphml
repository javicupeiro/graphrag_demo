    <node id="CAMBIOS INVOLUNTARIOS EN EL PESO CORPORAL">
      <data key="d0">EVENT</data>
      <data key="d1">Los cambios involuntarios en el peso corporal son indicadores de riesgo de desnutrici&#243;n en pacientes.</data>
      <data key="d2">cc6ee3d7bc9bfaf4a06f3f02c4907eb0</data>
