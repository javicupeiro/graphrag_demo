      <data key="d10">032fc2148da74e586c8fd91e073c2be6</data>
      <data key="d11">ce5be689642f4e2ba9c1b29f4b276463</data>
      <data key="d12">7236</data>
      <data key="d13">2</data>
    </edge>
    <edge source="WEIGHT LOSS" target="SUBJECTS">
      <data key="d8">8.0</data>
