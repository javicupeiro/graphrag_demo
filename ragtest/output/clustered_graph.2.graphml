    </edge>
    <edge source="SONDA NASOG&#193;STRICA" target="DIETA ENTERAL">
      <data key="d8">8.0</data>
      <data key="d9">La dieta enteral se administra a trav&#233;s de sondas nasog&#225;stricas, siendo un m&#233;todo com&#250;n para proporcionar nutrici&#243;n a pacientes con necesidades especiales.</data>
      <data key="d10">aa99de2530170165c9ac9333021210e3</data>
      <data key="d11">c8265c95fe3040a3a06ac98b4ffa6c76</data>
      <data key="d12">1974</data>
