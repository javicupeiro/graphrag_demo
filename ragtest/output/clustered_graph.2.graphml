      <data key="d7">a77b3f771dda4e9bb2bdac0a6604c0c1</data>
    </node>
    <node id="GASTROYEYUNOSTOM&#205;A">
      <data key="d0">EVENT</data>
      <data key="d1">La gastroyeyunostom&#237;a es un procedimiento quir&#250;rgico que conecta el est&#243;mago con el yeyuno, utilizado en el contexto de la cirug&#237;a pancre&#225;tica.</data>
      <data key="d2">3ee948dc4ddfdc75daa8fe7db9bb471e</data>
