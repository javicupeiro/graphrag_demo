      <data key="d0">ORGANIZATION</data>
      <data key="d1">Nasogastric tubes used for enteral feeding, which can increase infection risk in immunosuppressed patients</data>
      <data key="d2">beaa66c30582232126ce2c762a9c6bdb</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
