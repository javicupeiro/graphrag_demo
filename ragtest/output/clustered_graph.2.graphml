    <edge source="NUTRICI&#211;N" target="DIETA">
      <data key="d8">1.0</data>
      <data key="d9">Nutrition is the foundation for creating a diet that meets the needs of individuals with specific health conditions</data>
      <data key="d10">21dc8cb1a5078e23dae18b9c62b05625</data>
      <data key="d11">7cf7ee5bc99a43d4950a662a0e39fcf6</data>
      <data key="d12">754</data>
