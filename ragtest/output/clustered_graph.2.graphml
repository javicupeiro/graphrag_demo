    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="FOSFATASA ALCALINA &#211;SEA">
      <data key="d8">5.0</data>
      <data key="d9">La fosfatasa alcalina &#243;sea se mide para evaluar la salud &#243;sea en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">3029c420b2ce48e49908f72ab6b0f702</data>
      <data key="d12">6986</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA INTESTINAL" target="OSTEOCALCINA">
      <data key="d8">1.0</data>
      <data key="d9">La osteocalcina se mide para evaluar la salud &#243;sea en pacientes con enfermedad inflamatoria intestinal</data>
      <data key="d10">45ae0837b0632b026fac1053b7d9d4e8</data>
      <data key="d11">98efde953e40409586220c33ba27de5a</data>
      <data key="d12">6987</data>
