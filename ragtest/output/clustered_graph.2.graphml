      <data key="d11">ab9cd2125b994cd2adb9217fd4196f7e</data>
      <data key="d12">13000</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TOLVAPT&#193;N" target="HIPONATREMIA EUVOL&#201;MICA">
      <data key="d8">1.0</data>
      <data key="d9">El tolvapt&#225;n se utiliza en el tratamiento de la hiponatremia euvol&#233;mica al antagonizar la acci&#243;n de la ADH.</data>
      <data key="d10">d8ad55d79ba614f2c8906babacf0e9f6</data>
      <data key="d11">599aea3c74c24c5c97c40c55df7dd3eb</data>
      <data key="d12">13001</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TOLVAPT&#193;N" target="F&#193;RMACO">
