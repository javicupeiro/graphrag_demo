    <node id="FISIOPATOLOG&#205;A DE LA HIPONATREMIA">
      <data key="d0">EVENT</data>
      <data key="d1">The pathophysiology of hyponatremia, discussed in the context of patients receiving artificial nutrition</data>
      <data key="d2">8ff1cad741bacfef19d53bb8941b5ca9</data>
