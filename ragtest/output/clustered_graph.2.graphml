    </node>
    <node id="AFECTACI&#211;N SUPRASELAR">
      <data key="d0">EVENT</data>
      <data key="d1">La afectaci&#243;n supraselar se refiere a la invasi&#243;n de estructuras por tumores, lo que puede causar endocrinopat&#237;as en pacientes.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
