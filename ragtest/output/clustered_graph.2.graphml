    <node id="O'NEILL, R">
      <data key="d0">PERSON</data>
      <data key="d1">O'Neill, R is a co-author of a study on the effects of vitamin E supplementation on hepatic fibrogenesis.</data>
      <data key="d2">4216916ebab948061d2dca4afe7e1e84</data>
      <data key="d3">1682</data>
