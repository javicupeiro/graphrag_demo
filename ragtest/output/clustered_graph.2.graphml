      <data key="d7">fae74dab46d047429187469f15abfd99</data>
    </node>
    <node id="SUSTRATOS">
      <data key="d0">EVENT</data>
      <data key="d1">Substrates refer to the sugars that are restricted or eliminated from the diet of patients with glucose-galactose malabsorption.</data>
      <data key="d2">e329b5d4c64709889680df357bd1cc09</data>
      <data key="d3">846</data>
      <data key="d4">2</data>
