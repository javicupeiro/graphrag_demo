    <edge source="LACTANCIA" target="PACIENTE GESTANTE">
      <data key="d8">7.0</data>
      <data key="d9">The pregnant patient is considering breastfeeding, which is impacted by her diagnosis of microprolactinoma</data>
      <data key="d10">a1403e657780088123382f4725789e67</data>
      <data key="d11">d1699e7c93f74e078c243e44b79a15c9</data>
      <data key="d12">12733</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LACTANCIA" target="TIAMAZOL">
      <data key="d8">6.0</data>
      <data key="d9">Tiamazol can be detected in breast milk, which raises concerns about its use during lactation</data>
      <data key="d10">92e235fe76b5046c18c1cb2c782e1ac2</data>
      <data key="d11">b0e926cbd1bc4b1e825864b3f87b2836</data>
      <data key="d12">12734</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LACTANCIA" target="PROPYLTHIOURACIL (PTU)">
      <data key="d8">1.0</data>
      <data key="d9">PTU is considered relatively safe during lactation, as it is excreted in small amounts in breast milk</data>
      <data key="d10">92e235fe76b5046c18c1cb2c782e1ac2</data>
      <data key="d11">d82c1463974d45d6bc24dec45d15cff4</data>
      <data key="d12">12735</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LACTANCIA" target="NUTRICI&#211;N DURANTE LA GESTACI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">Las recomendaciones nutricionales durante la gestaci&#243;n son importantes para la salud de la madre y el beb&#233; durante la lactancia</data>
      <data key="d10">135d72a9407315b8bbf5b1ac13d72abf</data>
      <data key="d11">03583653fd354d6cab2c9de47a4da242</data>
      <data key="d12">12736</data>
