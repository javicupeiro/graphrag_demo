      <data key="d7">e0bd349c3ccd4f2ba680035396122da1</data>
    </node>
    <node id="EDICIONES DOYMA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ediciones Doyma is a publishing company based in Barcelona, known for its medical and clinical literature.</data>
      <data key="d2">47ba8105b81c59f81a9038446898d200</data>
