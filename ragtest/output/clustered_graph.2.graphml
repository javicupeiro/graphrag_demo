    <node id="AMINOACIDOS">
      <data key="d0" />
      <data key="d1">Amino acids are essential nutrients that play a crucial role in protein synthesis and growth, particularly in infants who are receiving parenteral nutrition.</data>
      <data key="d2">a0b6196d53d4eb1c8ca5b1a3a78e8fc7,a6e7937ce59bfc2b38e9ed2acf3e991c</data>
