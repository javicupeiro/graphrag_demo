    </edge>
    <edge source="NUTRITIONAL SUPPORT" target="ASPEN">
      <data key="d8">15.0</data>
      <data key="d9">ASPEN, the American Society for Parenteral and Enteral Nutrition, provides comprehensive guidelines for nutritional support in surgical patients, highlighting its critical importance in their care. These guidelines aim to enhance the management of nutritional support, with a particular focus on the roles of trace elements and vitamins in patient recovery and overall health.</data>
      <data key="d10">58ae94a34f90df368b032f1618c7bcec,814d394c907e59b29a5f0d9e82aed423</data>
      <data key="d11">14ab4b4543b3434e86d0539dad732a3c</data>
      <data key="d12">3760</data>
      <data key="d13">2</data>
    </edge>
