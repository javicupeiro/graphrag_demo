    </node>
    <node id="INDUSTRIAL SCALE">
      <data key="d0">EVENT</data>
      <data key="d1">Industrial scale is the final phase of production where the product is manufactured at full capacity based on successful laboratory and semi-industrial results.</data>
      <data key="d2">067a2eec3da66594167147aca615fa03</data>
      <data key="d5">1</data>
      <data key="d6">16129</data>
      <data key="d7">9937fdb09dab482293d2d0a07eb60c02</data>
