      <data key="d13">2</data>
    </edge>
    <edge source="CASOS" target="SESGO">
      <data key="d8">6.0</data>
      <data key="d9">Sesgo can affect the selection and reporting of casos in studies, leading to potential inaccuracies</data>
      <data key="d10">6799d5deb7130f888605e5e2d58c9de5</data>
      <data key="d11">e2a1c57931eb4629bff233ed34f3f5d7</data>
      <data key="d12">20567</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CASOS" target="MEMORIA">
      <data key="d8">5.0</data>
      <data key="d9">Memoria is crucial for casos when recalling past exposures related to the enfermedad</data>
      <data key="d10">6799d5deb7130f888605e5e2d58c9de5</data>
      <data key="d11">ce6cd9ec66be4e0980a989bbf74f1c03</data>
      <data key="d12">20568</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CONTROLES" target="SESGO">
      <data key="d8">6.0</data>
