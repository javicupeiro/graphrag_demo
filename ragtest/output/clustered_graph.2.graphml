      <data key="d1">Techniques used to enhance sensory feedback during swallowing assessments and rehabilitation.</data>
      <data key="d2">b2fcedcb1399bd22a82d188227aa9fad</data>
      <data key="d3">935</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">441</data>
      <data key="d7">9471d832be894d508879cc47f2365c05</data>
    </node>
