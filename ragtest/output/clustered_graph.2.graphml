      <data key="d5">1</data>
      <data key="d6">16121</data>
      <data key="d7">5fc25f28a9dc4374bd76aedc3b8f3c5e</data>
    </node>
    <node id="ICIDCA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">ICIDCA is an organization involved in the scientific and industrial development of products, particularly in the context of scaling processes from laboratory to industrial production.</data>
      <data key="d2">067a2eec3da66594167147aca615fa03</data>
