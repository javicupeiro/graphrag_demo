    <node id="CAT&#201;TERES TUNELIZADOS">
      <data key="d0">EVENT</data>
      <data key="d1">CAT&#201;TERES TUNELIZADOS are central venous catheters that traverse a subcutaneous tunnel, designed to reduce the risk of infection. This method is utilized in 46.3% of patients receiving Nutritional Parenteral Diet (NPD).</data>
      <data key="d2">efc0b55f4e91f02e4708b7cc43c64608,ff844169c2b512733f5bde26e6f1ed32</data>
