      <data key="d6">12094</data>
      <data key="d7">d0f3abc768da4b23a8afd850a168b491</data>
    </node>
    <node id="POUCHITIS">
      <data key="d0">EVENT</data>
      <data key="d1">POUCHITIS is an inflammatory condition that can occur after surgery and is being studied for probiotic treatment options.</data>
      <data key="d2">5a1ea1a4dfb1b591756a8dc60f504da2</data>
      <data key="d3">1025</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12095</data>
      <data key="d7">df8c2cef5b984483b0aecede813cedc0</data>
    </node>
    <node id="PREB&#211;TICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Prebiotics are ingredients that resist digestion and stimulate the growth of beneficial bacteria in the gut.</data>
      <data key="d2">5a1ea1a4dfb1b591756a8dc60f504da2</data>
      <data key="d3">1003</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">12096</data>
      <data key="d7">6999d1301d434361ba9c2ef53c0acac2</data>
    </node>
    <node id="DIARREA AGUDA DE ORIGEN VIRAL">
      <data key="d0">EVENT</data>
      <data key="d1">DIARREA AGUDA DE ORIGEN VIRAL (Acute Diarrhea of Viral Origin) is a condition that probiotics have shown potential benefits in treating.</data>
      <data key="d2">5a1ea1a4dfb1b591756a8dc60f504da2</data>
      <data key="d3">1024</data>
      <data key="d4">2</data>
