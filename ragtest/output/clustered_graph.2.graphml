    <node id="DESHIDRATACI&#211;N HIPEROSMOLAR">
      <data key="d0">EVENT</data>
      <data key="d1">Hyperosmolar dehydration is a serious condition that can occur in infants suffering from glucose-galactose malabsorption due to severe diarrhea.</data>
      <data key="d2">e329b5d4c64709889680df357bd1cc09</data>
      <data key="d3">846</data>
      <data key="d4">2</data>
