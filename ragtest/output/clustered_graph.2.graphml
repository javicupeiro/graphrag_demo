      <data key="d6">4743</data>
      <data key="d7">3bdac703012a41498f42f5bdf3796242</data>
    </node>
    <node id="TIROGLOBULINA">
      <data key="d0">EVENT</data>
      <data key="d1">Tiroglobulina is a protein used as a tumor marker in the follow-up of patients with differentiated thyroid cancer.</data>
      <data key="d2">2c745fa0855caf0a3316554b5a46752c</data>
      <data key="d3">181</data>
      <data key="d4">1</data>
