    </node>
    <node id="DRENES">
      <data key="d0">EVENT</data>
      <data key="d1">Los drenajes son dispositivos utilizados para eliminar fluidos del cuerpo despu&#233;s de una cirug&#237;a, en este caso, tras la duodenopancreatectom&#237;a.</data>
      <data key="d2">3ee948dc4ddfdc75daa8fe7db9bb471e</data>
