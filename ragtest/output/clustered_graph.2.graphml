      <data key="d10">aae3f23f674724518bcb311a99d764d6</data>
      <data key="d11">f0470e1d702341668cd19a2e70c9d29b</data>
      <data key="d12">3830</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL RISK SCREENING 2002" target="GASTRIC CANCER">
      <data key="d8">7.0</data>
