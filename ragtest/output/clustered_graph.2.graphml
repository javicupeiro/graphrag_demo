    <edge source="NUTRICI&#211;N" target="FRAGILIDAD COGNITIVA">
      <data key="d8">6.0</data>
      <data key="d9">Nutrition is suggested to have a beneficial effect on cognitive frailty, potentially preventing its progression</data>
      <data key="d10">b5f705e0ba650f5ad1f558446be0191e</data>
      <data key="d11">95b5241424794df0afbee8ceb279b548</data>
      <data key="d12">700</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N" target="PACIENTES DE ALZHEIMER">
      <data key="d8">9.0</data>
      <data key="d9">Nutrition plays a critical role in the health and management of Alzheimer's patients</data>
      <data key="d10">7427cd5c0088cf9c6ea0134ccf5f7e4f</data>
      <data key="d11">0f970df5034b490cb572484f6964fbf5</data>
