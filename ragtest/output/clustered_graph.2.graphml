      <data key="d6">432</data>
      <data key="d7">f7c8c1dbb41b4d7bbd75ade8e3830762</data>
    </node>
    <node id="ALBONDIGA EN SALSA">
      <data key="d0">EVENT</data>
      <data key="d1">Alb&#243;ndiga en salsa is an example of solid food that can be evaluated for swallowing, which can be mashed with a fork and served with sauce.</data>
      <data key="d2">071141fe8f0a45f56522de2f52ddcb46</data>
      <data key="d3">1261</data>
      <data key="d4">2</data>
