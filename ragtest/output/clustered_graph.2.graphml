      <data key="d7">c6b623c10dd14101b57d75479144b713</data>
    </node>
    <node id="SUERO FISIOLOGICO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Saline solution is used in the treatment of patients in shock due to acute adrenal insufficiency to restore fluid balance.</data>
      <data key="d2">fec130428af4ee62996a9b72494212dc</data>
      <data key="d3">1425</data>
      <data key="d4">2</data>
