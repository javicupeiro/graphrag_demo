    <node id="PRESENCIA DE ANTICUERPOS">
      <data key="d0">EVENT</data>
      <data key="d1">La presencia de anticuerpos antihormonas tiroideas puede interferir con la determinaci&#243;n anal&#237;tica de las hormonas tiroideas, aunque no est&#225; relacionada con la etiopatogenia de la enfermedad de Graves.</data>
      <data key="d2">1263bbcd20f6e54800e1c9361466bc63</data>
      <data key="d3">1353</data>
      <data key="d4">2</data>
