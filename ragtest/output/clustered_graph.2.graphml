      <data key="d8">1.0</data>
      <data key="d9">Analytical parameters are critical for evaluating the biochemical status of patients receiving parenteral nutrition</data>
      <data key="d10">2bd5549759c6a0d8393bb93fdccb747b</data>
      <data key="d11">7e36b741e4834276b95982d54ed03bad</data>
