    <node id="HISTORIA PREVIA DE ENFERMEDAD CARDIOVASCULAR">
      <data key="d0">EVENT</data>
      <data key="d1">A history of cardiovascular disease is a recognized risk factor for developing Diabetes Mellitus Type 2.</data>
      <data key="d2">34d62296f09da1a452febcc9ab8c18ad</data>
      <data key="d3">1602</data>
      <data key="d4">2</data>
