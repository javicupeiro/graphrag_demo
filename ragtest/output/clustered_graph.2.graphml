      <data key="d8">6.0</data>
      <data key="d9">Hospitals conduct microbiological analyses to monitor food safety and hygiene</data>
      <data key="d10">31f8f2c83d12928b56228d8b3f9d081c</data>
      <data key="d11">ffcc2ac87896404b886cbfe322f6249d</data>
      <data key="d12">1047</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HOSPITAL" target="SEGURIDAD ALIMENTARIA">
      <data key="d8">7.0</data>
      <data key="d9">Food safety is a critical concern in hospitals to protect patients from foodborne illnesses</data>
