      <data key="d11">173e460595cd492c9eed2da7dac05ca8</data>
      <data key="d12">11379</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL INTERVENTION" target="WORLD HEALTH ORGANIZATION">
      <data key="d8">6.0</data>
      <data key="d9">Nutritional interventions are supported by the WHO to improve health outcomes</data>
      <data key="d10">e33729f8eea62e59507c132b7c2437df</data>
      <data key="d11">e6ed624c89db4c2fbc8c886b93c249cc</data>
      <data key="d12">11380</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL INTERVENTION" target="AMERICAN COLLEGE OF CARDIOLOGY">
      <data key="d8">6.0</data>
      <data key="d9">Nutritional interventions are part of the guidelines provided by the American College of Cardiology to reduce cardiovascular risk</data>
      <data key="d10">e33729f8eea62e59507c132b7c2437df</data>
      <data key="d11">59293742362140e9a7130ba1e8db9209</data>
      <data key="d12">11381</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL INTERVENTION" target="CANCER SOCIETY">
      <data key="d8">1.0</data>
      <data key="d9">Nutritional interventions are part of the American Cancer Society's recommendations for cancer prevention</data>
      <data key="d10">e33729f8eea62e59507c132b7c2437df</data>
      <data key="d11">1230061ed0bf43189a69230e47a1ed16</data>
      <data key="d12">11382</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL INTERVENTION" target="ANOREXIA NERVOSA">
      <data key="d8">8.0</data>
      <data key="d9">Nutritional intervention is essential in the treatment of Anorexia Nervosa to restore health</data>
      <data key="d10">770e8796aac9c96d967ef99d1f307e06</data>
      <data key="d11">3deb9cb7241349c492e5ab079a06045a</data>
      <data key="d12">11383</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL INTERVENTION" target="CYSTIC FIBROSIS">
      <data key="d8">9.0</data>
      <data key="d9">Nutritional intervention is a key aspect of managing cystic fibrosis, playing a crucial role in improving health outcomes for patients with this condition. It is essential for effectively addressing the unique nutritional needs associated with cystic fibrosis, thereby enhancing the overall well-being of those affected.</data>
      <data key="d10">c3e74ddf9529482684f4b62e713df49b,ea8be3e3b3d7195ddc85512be460b6f8</data>
      <data key="d11">b640adc03aec47139a7739b6e2614c30</data>
      <data key="d12">11384</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL INTERVENTION" target="ELA">
      <data key="d8">9.0</data>
      <data key="d9">Nutritional intervention is crucial for managing ELA patients to slow disease progression and prevent complications</data>
      <data key="d10">cea5f90ebf49c4157cab16ee26b9d97c</data>
      <data key="d11">52c33085d9d54740abf194a3173e18a7</data>
      <data key="d12">11385</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL INTERVENTION" target="ONCOLOGICAL PATIENT">
      <data key="d8">18.0</data>
      <data key="d9">Nutritional intervention is essential for oncological patients as it plays a critical role in combating the effects of cancer and its treatment. These interventions are crucial for managing the dietary needs of oncological patients, ultimately aiming to improve their health outcomes. By addressing the specific nutritional requirements of individuals undergoing cancer treatment, nutritional interventions can significantly enhance their overall well-being and support their recovery process.</data>
      <data key="d10">11cbdce47eee11a80ab609f3b786bcc1,fb7b0d121f195e2a472f3d47e28ccff9</data>
      <data key="d11">ca4d3f15b6f34cebb82b03c8a6940ad3</data>
      <data key="d12">11386</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL INTERVENTION" target="NUTRITIONAL COUNSELING">
      <data key="d8">7.0</data>
      <data key="d9">Nutritional counseling is a key component of nutritional intervention for patients undergoing cancer treatment</data>
      <data key="d10">11cbdce47eee11a80ab609f3b786bcc1</data>
      <data key="d11">09598c3208404b4fb678f169e88fc0f8</data>
      <data key="d12">11387</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HOSPITALIZATION" target="ANCIANOS">
      <data key="d8">6.0</data>
