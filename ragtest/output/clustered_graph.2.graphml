    <node id="BIOMARKER-BASED RISK STRATIFICATION">
      <data key="d0">EVENT</data>
      <data key="d1">Biomarker-based risk stratification is a method used to assess the risk of medullary thyroid cancer in patients based on specific biomarkers.</data>
      <data key="d2">e775708e66a97968834f7476479a21b2</data>
      <data key="d3">427</data>
