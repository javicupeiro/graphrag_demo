    </edge>
    <edge source="COSTE EFECTIVIDAD" target="COSTE UTILIDAD">
      <data key="d8">7.0</data>
      <data key="d9">Coste efectividad and coste utilidad are both analysis methods that assess the economic aspects of healthcare interventions</data>
