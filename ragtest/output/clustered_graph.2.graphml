      <data key="d13">2</data>
    </edge>
    <edge source="CONVENIO DE BIO&#201;TICA DE OVIEDO" target="TRASTORNO MENTAL">
      <data key="d8">1.0</data>
      <data key="d9">El Convenio de Bio&#233;tica de Oviedo se refiere a la protecci&#243;n de personas con trastornos mentales.</data>
      <data key="d10">eaa675a346becd53a4fcfacbb99def88</data>
      <data key="d11">dd44c609a39c4216ba9c1743aaa43b32</data>
      <data key="d12">20272</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LEY 1/2000" target="AUTORIDAD JUDICIAL">
      <data key="d8">9.0</data>
      <data key="d9">La Ley 1/2000 requiere la intervenci&#243;n de la autoridad judicial para el internamiento no voluntario de un paciente.</data>
      <data key="d10">eaa675a346becd53a4fcfacbb99def88</data>
      <data key="d11">b8e945fbb0d34cd98c29e807acebb699</data>
      <data key="d12">20273</data>
