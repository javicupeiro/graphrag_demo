    <node id="F&#205;STULAS ENTERO-CUT&#193;NEAS">
      <data key="d0">EVENT</data>
      <data key="d1">Las f&#237;stulas entero-cut&#225;neas son complicaciones que pueden surgir en pacientes con problemas digestivos, afectando la nutrici&#243;n y el tratamiento.</data>
      <data key="d2">44346a4b1b9a6d3ae2bc161314ff9efd</data>
