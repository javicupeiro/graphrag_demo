    <node id="PETROSAL SINUS CATHETERIZATION">
      <data key="d0">EVENT</data>
      <data key="d1">Petrosal sinus catheterization is a diagnostic procedure used to determine the source of ACTH in patients suspected of having Cushing's syndrome.</data>
      <data key="d2">9ff14a3c49bd56b2fb12b3fd8ed246de</data>
