    <node id="TRASTORNOS DE LA DIFERENCIACI&#211;N SEXUAL">
      <data key="d0">EVENT</data>
      <data key="d1">Trastornos de la diferenciaci&#243;n sexual are conditions that affect the development of sexual characteristics, leading to atypical sexual development.</data>
      <data key="d2">bcb4f7ab0760e548b520c667b305722a</data>
      <data key="d3">1365</data>
      <data key="d4">2</data>
