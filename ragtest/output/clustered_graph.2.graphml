    <node id="RGE">
      <data key="d0">EVENT</data>
      <data key="d1">RGE stands for Reflux Gastroesophageal, a condition where stomach contents flow back into the esophagus, causing symptoms and potential complications.</data>
      <data key="d2">b58b0258891d9207b27237bab6a03946</data>
      <data key="d3">770</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
