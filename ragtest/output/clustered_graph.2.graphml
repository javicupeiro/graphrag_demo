      <data key="d8">8.0</data>
      <data key="d9">Infecci&#243;n moderada is a condition that is part of the Factor de Estr&#233;s, affecting metabolic demands</data>
      <data key="d10">056067ecde43f31b356fc39e056221ee</data>
      <data key="d11">1b315241be0842b087a5a5250452c341</data>
      <data key="d12">7641</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FACTOR DE ESTR&#201;S" target="PESO IDEAL">
      <data key="d8">5.0</data>
      <data key="d9">Peso ideal calculations are influenced by the Factor de Estr&#233;s, as metabolic stress can alter weight requirements</data>
      <data key="d10">056067ecde43f31b356fc39e056221ee</data>
      <data key="d11">f9cb49d1678f4694ad3ca40667511dd2</data>
      <data key="d12">7642</data>
      <data key="d13">2</data>
    </edge>
