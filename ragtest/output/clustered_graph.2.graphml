    </edge>
    <edge source="GALACTOSEMIA" target="ALIMENTOS PROHIBIDOS">
      <data key="d8">9.0</data>
      <data key="d9">Individuals with galactosemia must avoid foods that are classified as prohibited due to high galactose content.</data>
      <data key="d10">743649231e27012822c870ff5878263c</data>
      <data key="d11">65e04db958374b13b90e482a980a8860</data>
      <data key="d12">10285</data>
