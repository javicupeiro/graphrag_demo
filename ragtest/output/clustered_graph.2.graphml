    </edge>
    <edge source="CVC" target="ALTEPLASA">
      <data key="d8">14.0</data>
      <data key="d9">Alteplase is a medication administered to restore functionality in central venous catheters (CVCs) when thrombus obstruction occurs. It is specifically used to treat occlusions in CVCs, effectively addressing blockages that impede their proper function.</data>
      <data key="d10">1c3eeb30a49c70f750b79e7bc1dfef52,fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d11">70a2f72b4ac64e90bcd2cec485e86223</data>
      <data key="d12">10104</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CVC" target="TROMBOSIS INTRALUMINAL">
      <data key="d8">7.0</data>
      <data key="d9">Trombosis intraluminal is a complication that affects the functionality of the CVC</data>
      <data key="d10">1c3eeb30a49c70f750b79e7bc1dfef52</data>
      <data key="d11">866215b07f614410a6d93708b32057ec</data>
      <data key="d12">10105</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CVC" target="TROMBOSIS EXTRALUMINAL">
