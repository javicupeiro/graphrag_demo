      <data key="d9">Enterococcus species can be involved in catheter-related infections</data>
      <data key="d10">fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d11">480d40d1e1d44530a7e8ae34ce09b81d</data>
