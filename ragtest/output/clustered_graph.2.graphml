      <data key="d11">0f75915e46c74c5d84b5afcdd318ab9f</data>
      <data key="d12">6270</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BMC PUBLIC HEALTH" target="J AM MED DIR ASSOC">
      <data key="d8">4.0</data>
      <data key="d9">Both journals publish research related to the health and management of older adults</data>
      <data key="d10">e155d9b2d1858daab734fd68a45d0c0a</data>
      <data key="d11">bb6b11341f6f4fbdb1a62712c1c1a405</data>
      <data key="d12">6271</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIGIENE BUCODENTAL" target="PACIENTE CON BAJO NIVEL DE CONSCIENCIA">
      <data key="d8">5.0</data>
      <data key="d9">The procedure for patients with low consciousness includes specific oral hygiene practices</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">4b9afc363a0e41a988288802830dc799</data>
      <data key="d12">6272</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIGIENE BUCODENTAL" target="PACIENTE CON RESPIRACI&#211;N MEC&#193;NICA ASISTIDA">
      <data key="d8">1.0</data>
      <data key="d9">The procedure for mechanically ventilated patients includes oral hygiene steps to maintain health</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">e8a5baf9943b49deb5d44ae789ef1bec</data>
      <data key="d12">6273</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="TCAE">
      <data key="d8">6.0</data>
      <data key="d9">The TCAE assists the enfermera in providing oral care to the paciente</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">f3fce1893b4643769935ed635c04a7b7</data>
      <data key="d12">6274</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="CAVIDAD BUCAL">
      <data key="d8">7.0</data>
      <data key="d9">The enfermera assesses and cares for the cavidad bucal of the paciente</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">185941325853446d89437554f5112a44</data>
      <data key="d12">6275</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="MUCOSA">
      <data key="d8">7.0</data>
      <data key="d9">The enfermera evaluates the state of the mucosa during oral hygiene practices</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">b3fcdeb64aef4a0abe77f50c149f90e9</data>
      <data key="d12">6276</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="SUERO FISIOL&#211;GICO">
      <data key="d8">5.0</data>
      <data key="d9">The enfermera may use suero fisiol&#243;gico during oral care procedures</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">004387ba3a8e448cae8122a781b85189</data>
      <data key="d12">6277</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="GASAS NO EST&#201;RILES">
      <data key="d8">5.0</data>
      <data key="d9">The enfermera utilizes gasas no est&#233;riles for cleaning during oral hygiene</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">f6f53249cdb845ff849e2cd99388302b</data>
      <data key="d12">6278</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="DEPRESOR LINGUAL">
      <data key="d8">5.0</data>
      <data key="d9">The enfermera uses a depresor lingual to facilitate oral examinations</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">672e3699020a48d78c191fa0ab36a8e9</data>
      <data key="d12">6279</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="VASELINA">
      <data key="d8">5.0</data>
      <data key="d9">The enfermera applies vaselina to the patient's lips to prevent dryness</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">a580a3c4c80c4572a1df827e3aaeb2e5</data>
      <data key="d12">6280</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="ASPIRADOR">
      <data key="d8">6.0</data>
      <data key="d9">The enfermera uses an aspirador to clear secretions from the patient's mouth</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">ec34aa1d817b4794ba3bcc61cdd85789</data>
      <data key="d12">6281</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="SONDAS DE ASPIRACI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">The enfermera employs sondas de aspiraci&#243;n to manage oral secretions</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">3ed6a4c50fea417489fe362b55a913ca</data>
      <data key="d12">6282</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="GUANTES NO EST&#201;RILES">
      <data key="d8">7.0</data>
      <data key="d9">The enfermera wears guantes no est&#233;riles while performing oral care</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">6facb51e270d4a9898080602e906c022</data>
      <data key="d12">6283</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="BATEA">
      <data key="d8">5.0</data>
      <data key="d9">The enfermera uses a batea to collect fluids during oral hygiene procedures</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">07935e0baa644c7a8065e0aaa8e03775</data>
      <data key="d12">6284</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="TOALLA">
      <data key="d8">5.0</data>
      <data key="d9">The enfermera uses a toalla to keep the area clean during oral care</data>
      <data key="d10">bfc7f52d9f15519c092dee53ea9dcc33</data>
      <data key="d11">dac89373a300484686f44e126be8cf72</data>
      <data key="d12">6285</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMERA" target="EMPAPADOR">
      <data key="d8">1.0</data>
      <data key="d9">The enfermera places an empapador under the patient's head during oral hygiene</data>
