    </node>
    <node id="GOLD STANDARD">
      <data key="d0">EVENT</data>
      <data key="d1">Videofluoroscopic swallowing studies (VFSS) are considered the gold standard for evaluating swallowing.</data>
      <data key="d2">da965f79110bd8915deff461d0d91187</data>
