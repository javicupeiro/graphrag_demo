    </edge>
    <edge source="CUSHING'S SYNDROME" target="ADENOMA">
      <data key="d8">9.0</data>
      <data key="d9">Adenomas in the pituitary gland can lead to the development of Cushing's syndrome through excessive ACTH secretion</data>
      <data key="d10">7082a5d31b18dd81d4c4a0e8ed02623b</data>
      <data key="d11">29aedc56f87d48b3a9c02f06fd07b65e</data>
      <data key="d12">12534</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="SUPRARENAL GLANDS">
      <data key="d8">8.0</data>
      <data key="d9">Cushing's syndrome is characterized by hyperplasia or lesions in the adrenal glands, affecting cortisol production</data>
      <data key="d10">7082a5d31b18dd81d4c4a0e8ed02623b</data>
      <data key="d11">485f88eca800451ab4d12971a53970ea</data>
      <data key="d12">12535</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="MICROADENOMAS">
      <data key="d8">7.0</data>
      <data key="d9">Microadenomas are commonly observed in patients with Cushing's syndrome, contributing to the disorder</data>
      <data key="d10">7082a5d31b18dd81d4c4a0e8ed02623b</data>
      <data key="d11">df186e617aaf4744b40744fe8a991d58</data>
      <data key="d12">12536</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="GADOLINIUM">
      <data key="d8">6.0</data>
      <data key="d9">Gadolinium is used in MRI scans to help diagnose Cushing's syndrome by enhancing the visibility of pituitary adenomas</data>
      <data key="d10">7082a5d31b18dd81d4c4a0e8ed02623b</data>
      <data key="d11">fc1ac7ead08b47f7aaaaf624569309d8</data>
      <data key="d12">12537</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="ETOMIDATE">
      <data key="d8">8.0</data>
      <data key="d9">Etomidate is used to urgently lower cortisol levels in patients with Cushing's syndrome</data>
      <data key="d10">4c034422eb6302c32e0d5fdce5b3046d</data>
      <data key="d11">f7e3995c588444d4bdfc168ffa837bd0</data>
      <data key="d12">12538</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="TRILOSTANE">
      <data key="d8">1.0</data>
      <data key="d9">Trilostane is indicated for the treatment of hyperadrenocorticism, which is related to Cushing's syndrome</data>
      <data key="d10">4c034422eb6302c32e0d5fdce5b3046d</data>
      <data key="d11">47d1c61fecec45e28b0110b41d3d17d1</data>
      <data key="d12">12539</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="HYPERTIROIDISM">
      <data key="d8">1.0</data>
      <data key="d9">Hyperthyroidism can be associated with other endocrine disorders, including Cushing's syndrome</data>
      <data key="d10">4c034422eb6302c32e0d5fdce5b3046d</data>
      <data key="d11">3511298adbc04784ad477f2d5d37dec6</data>
      <data key="d12">12540</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="TRILOSTANO">
      <data key="d8">8.0</data>
      <data key="d9">Trilostano is used to treat hyperadrenocorticism, a condition related to Cushing's syndrome.</data>
      <data key="d10">dbe034ccd694ae06cf72d347d7dbdacb</data>
      <data key="d11">6ec9dbfd740e451e89bef5fee9aa9bbf</data>
      <data key="d12">12541</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="MIFEPRISTONA">
      <data key="d8">7.0</data>
      <data key="d9">Mifepristone can be used in the treatment of Cushing's syndrome due to its ability to block glucocorticoid receptors.</data>
      <data key="d10">dbe034ccd694ae06cf72d347d7dbdacb</data>
      <data key="d11">df8ee335aa5e4e9f9e9c4ee9722d9abd</data>
      <data key="d12">12542</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="MITOTANO">
      <data key="d8">1.0</data>
      <data key="d9">Mitotane is used in the treatment of Cushing's syndrome, particularly in cases of adrenal carcinoma.</data>
      <data key="d10">dbe034ccd694ae06cf72d347d7dbdacb</data>
      <data key="d11">17dd00e4e0714c559a43da8f9a227d71</data>
      <data key="d12">12543</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="DEXAMETHASONE">
      <data key="d8">9.0</data>
      <data key="d9">Dexamethasone is used to treat Cushing's syndrome by suppressing ACTH levels</data>
      <data key="d10">bcbca87f5ebf2c5d260810cf83a70257</data>
      <data key="d11">f75a1aae356e40d6a59a5f91f33476b5</data>
      <data key="d12">12544</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="GLUCOCORTICOIDS">
      <data key="d8">6.0</data>
      <data key="d9">Resistance to glucocorticoids can lead to clinical manifestations similar to those seen in Cushing's syndrome</data>
      <data key="d10">bcbca87f5ebf2c5d260810cf83a70257</data>
      <data key="d11">d2de13ea830a4dd28086cd012bc73bcc</data>
      <data key="d12">12545</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="HYPERALDOSTERONISM">
      <data key="d8">7.0</data>
      <data key="d9">Hyperaldosteronism can be a condition associated with Cushing's syndrome due to the overproduction of adrenal hormones</data>
      <data key="d10">7f3df1437755b60344fdffd2ef3b8a9e</data>
      <data key="d11">b00d38b5ee2e43b4bdb9dcdc80da6c5f</data>
      <data key="d12">12546</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="SUPRARENAL GLAND">
      <data key="d8">6.0</data>
      <data key="d9">Cushing's syndrome is often related to dysfunction of the suprarenal glands, indicating a relationship based on hormonal imbalance</data>
      <data key="d10">05a6995cef9c8d0279b9f026da1ffed1</data>
      <data key="d11">e31a65a5a89345febffa08c06a93bc61</data>
      <data key="d12">12547</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="TAC">
      <data key="d8">5.0</data>
      <data key="d9">TAC is used to diagnose Cushing's syndrome by visualizing adrenal tumors or abnormalities</data>
      <data key="d10">05a6995cef9c8d0279b9f026da1ffed1</data>
      <data key="d11">785c2452651146e086c16d33386632f3</data>
      <data key="d12">12548</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="MRI">
      <data key="d8">5.0</data>
      <data key="d9">MRI is another imaging technique used to identify the causes of Cushing's syndrome, such as pituitary or adrenal tumors</data>
      <data key="d10">05a6995cef9c8d0279b9f026da1ffed1</data>
      <data key="d11">8f8a566477e74f5faba1856520e193dd</data>
      <data key="d12">12549</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CORTICOTROPINOMA" target="MACROADENOMA">
      <data key="d8">6.0</data>
      <data key="d9">A macroadenoma can be a type of corticotropinoma if it produces ACTH</data>
      <data key="d10">172da539e648a8f72cc1576d16e35f46</data>
      <data key="d11">e26ca05071cf4508957e191cd58061e7</data>
      <data key="d12">12550</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CORTICOTROPINOMA" target="HYPOPITUITARISM">
      <data key="d8">7.0</data>
      <data key="d9">Corticotropinomas can lead to hypopituitarism if they affect the normal function of the pituitary gland</data>
      <data key="d10">172da539e648a8f72cc1576d16e35f46</data>
      <data key="d11">a9969f111c0c4ae18c82ef20c3066f45</data>
      <data key="d12">12551</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MACROADENOMA" target="HIPERPROLACTINEMIA">
      <data key="d8">6.0</data>
      <data key="d9">El macroadenoma es un tipo de adenoma hipofisario que puede causar hiperprolactinemia.</data>
      <data key="d10">2b6e6d589cd4e83086e44c77205b3740</data>
      <data key="d11">89f6e6df8d924c4983c253cf1a1d9678</data>
      <data key="d12">12552</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MACROADENOMA" target="ACROMEGALY">
      <data key="d8">6.0</data>
      <data key="d9">Macroadenomas can lead to the development of acromegaly due to excess growth hormone production</data>
      <data key="d10">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d11">8f9a71ba606645458d85d5b419a9112b</data>
      <data key="d12">12553</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MACROADENOMA" target="D">
      <data key="d8">7.0</data>
      <data key="d9">D may have a macroadenoma based on her elevated prolactin levels</data>
      <data key="d10">fbba0b43850ff5e50b710069959c2416</data>
      <data key="d11">127e38d68f4646d898d30a34012a3920</data>
      <data key="d12">12554</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOTHYROIDISM" target="HYPOPITUITARISM">
      <data key="d8">7.0</data>
      <data key="d9">Hypopituitarism can lead to hypothyroidism due to insufficient production of thyroid-stimulating hormone (TSH)</data>
      <data key="d10">172da539e648a8f72cc1576d16e35f46</data>
      <data key="d11">6c1d4881fea442f9826fe2923199bb56</data>
      <data key="d12">12555</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOTHYROIDISM" target="AMIODARONE">
      <data key="d8">15.0</data>
      <data key="d9">Amiodarone is a medication that can induce hypothyroidism as a side effect of its use. Specifically, treatment with amiodarone has been associated with the development of hypothyroidism in patients. This relationship highlights the importance of monitoring thyroid function in individuals receiving amiodarone therapy.</data>
      <data key="d10">0d78e460e4fb4a82bb6e11496f7d5aed,45213238a7d4c834b6db62ef71dcda43</data>
      <data key="d11">f6799037edf3478f8e8ba067f6d4b3a1</data>
      <data key="d12">12556</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOTHYROIDISM" target="TIAMAZOL">
      <data key="d8">6.0</data>
      <data key="d9">Tiamazol can be used to treat hyperthyroidism, which can be induced by amiodarone</data>
      <data key="d10">45213238a7d4c834b6db62ef71dcda43</data>
      <data key="d11">b24b442909404e929cad012a90d21959</data>
      <data key="d12">12557</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOTHYROIDISM" target="CARBIMAZOL">
      <data key="d8">6.0</data>
      <data key="d9">Carbimazol can be used to treat hyperthyroidism, which can be induced by amiodarone</data>
      <data key="d10">45213238a7d4c834b6db62ef71dcda43</data>
      <data key="d11">37f4833a0d674dad8bd9e033f96181f5</data>
      <data key="d12">12558</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOTHYROIDISM" target="PROPILTIURACILO">
      <data key="d8">6.0</data>
      <data key="d9">Propiltiuracilo (PTU) can be used to treat hyperthyroidism, which can be induced by amiodarone</data>
      <data key="d10">45213238a7d4c834b6db62ef71dcda43</data>
      <data key="d11">a52684b592814b53bb961d2a1d1c7ba9</data>
      <data key="d12">12559</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOTHYROIDISM" target="KLINEFELTER SYNDROME">
      <data key="d8">7.0</data>
      <data key="d9">Hypothyroidism is a common endocrine disorder seen in patients with Klinefelter syndrome</data>
      <data key="d10">5509bb6959e4faa5989289c1ddbcc96b</data>
      <data key="d11">cf0bc6c1d06e46a5a00d71e575e6e08f</data>
      <data key="d12">12560</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOPITUITARISM" target="PROLACTINOMAS">
      <data key="d8">1.0</data>
      <data key="d9">Prolactinomas can cause hypopituitarism by disrupting normal pituitary function</data>
      <data key="d10">172da539e648a8f72cc1576d16e35f46</data>
      <data key="d11">0e3354b2c30c449b8d2fd8b720d06341</data>
      <data key="d12">12561</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPOPITUITARISM" target="HEMATOCHROMATOSIS">
      <data key="d8">1.0</data>
      <data key="d9">Hypopituitarism can be a consequence of hereditary hemochromatosis, affecting the production of various hormones.</data>
      <data key="d10">83d2bb17e643e047bb3ad2ecc88d8271</data>
      <data key="d11">ab0f99ea49634a38828fcf0d9a19be84</data>
      <data key="d12">12562</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PROLACTINOMAS" target="D">
      <data key="d8">1.0</data>
      <data key="d9">D's elevated prolactin levels suggest the presence of a prolactinoma, which is common in MEN1</data>
      <data key="d10">fbba0b43850ff5e50b710069959c2416</data>
      <data key="d11">6583fb52d3a24037ada3b6c7cb9f75d7</data>
      <data key="d12">12563</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CORTICOTROPINOMAS" target="ENFERMEDAD DE CUSHING">
      <data key="d8">8.0</data>
      <data key="d9">Corticotropinomas can cause Cushing's disease due to excess cortisol production</data>
      <data key="d10">4faa9b46acd7540904fc5b0772bb7c51</data>
      <data key="d11">bc93852de3724874a8624764ae2ce5d5</data>
      <data key="d12">12564</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADENOMAS" target="TYPE I GLUCOGENOSIS">
      <data key="d8">1.0</data>
      <data key="d9">Patients with type I glucogenosis may develop adenomas in the liver</data>
      <data key="d10">d1b2835d6e86f09adefd22378bb6da15</data>
      <data key="d11">e3aeb795d5244488849563635811faa1</data>
