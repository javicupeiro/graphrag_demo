    <node id="GEMELOS HOMOCIG&#211;TICOS DISCORDANTES">
      <data key="d0">PERSON</data>
      <data key="d1">Gemelos homocig&#243;ticos discordantes son gemelos que tienen diferentes caracter&#237;sticas de obesidad, utilizados en estudios sobre microbiota y obesidad.</data>
