    <node id="REACCIONES ADVERSAS">
      <data key="d0">EVENT</data>
      <data key="d1">Las reacciones adversas son efectos no deseados que pueden ocurrir al exponer a un paciente sensibilizado al al&#233;rgeno nocivo.</data>
      <data key="d2">0f0303399f29734dede9db544e1dda9e</data>
      <data key="d3">52</data>
