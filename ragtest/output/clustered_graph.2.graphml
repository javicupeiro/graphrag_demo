    </node>
    <node id="VOLUMEN SISTOLICO">
      <data key="d0">EVENT</data>
      <data key="d1">Increased stroke volume is a hemodynamic change observed in obesity, affecting cardiac function.</data>
      <data key="d2">c575e742f54d5f3f674a8e52ad041221</data>
      <data key="d3">1390</data>
      <data key="d4">2</data>
