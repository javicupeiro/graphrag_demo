    </node>
    <node id="RN A T&#201;RMINO">
      <data key="d0">EVENT</data>
      <data key="d1">RN a t&#233;rmino refers to nutritional formulas for full-term newborns when breastfeeding is not possible.</data>
      <data key="d2">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d3">665</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">2495</data>
