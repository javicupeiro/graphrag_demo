      <data key="d8">1.0</data>
      <data key="d9">Reci&#233;n nacidos a t&#233;rmino may also require iron supplementation depending on their health status</data>
      <data key="d10">fa356397bc52582bdbbd1868639feec9</data>
      <data key="d11">d648a2a340574889a117421122dc8c6a</data>
      <data key="d12">8649</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIERRO" target="ACIDO FOLICO">
      <data key="d8">5.0</data>
      <data key="d9">Both are essential nutrients with specific recommended daily intakes for maintaining health in the elderly</data>
      <data key="d10">5cab61b11d03ef705141159d100ae7c5</data>
      <data key="d11">ca53cb7ea15c486b80a9ea452df6164b</data>
      <data key="d12">8650</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIERRO" target="FOSFORO">
      <data key="d8">5.0</data>
