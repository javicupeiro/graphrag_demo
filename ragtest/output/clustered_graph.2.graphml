    </edge>
    <edge source="MAGNESIO" target="ALIMENTOS DE ORIGEN VEGETAL">
      <data key="d8">6.0</data>
      <data key="d9">Plant-based foods contain more magnesium but have lower bioavailability due to other nutrients</data>
      <data key="d10">846a0cb8b0428de4dd313cf55913d6bd</data>
      <data key="d11">ec9a01861a3d476c8a3bdad2316fb8f3</data>
      <data key="d12">8329</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MAGNESIO" target="LITIASIS">
      <data key="d8">8.0</data>
      <data key="d9">MAGNESIO helps prevent the formation of kidney stones by binding to oxalate</data>
