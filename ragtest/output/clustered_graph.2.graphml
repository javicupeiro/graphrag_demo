    <node id="MALABSORCI&#211;N DE GLUCOSA-GALACTOSA">
      <data key="d0">EVENT</data>
      <data key="d1">Glucose-galactose malabsorption is a rare autosomal recessive hereditary disease characterized by severe diarrhea and dehydration upon lactose introduction in infants.</data>
      <data key="d2">e329b5d4c64709889680df357bd1cc09</data>
      <data key="d3">846</data>
      <data key="d4">2</data>
