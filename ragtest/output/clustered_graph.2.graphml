    <node id="BRASSICA">
      <data key="d0">GEO</data>
      <data key="d1">Brassica is a genus of vegetables including cabbage, cauliflower, and kale, known for their enzymatic induction properties affecting drug metabolism.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">1</data>
      <data key="d6">14228</data>
      <data key="d7">18927c37ef204a1a8611432fe412f523</data>
    </node>
    <node id="AVOCADO">
      <data key="d0">GEO</data>
      <data key="d1">Avocado is a fruit that decreases the efficacy of oral anticoagulants due to its high fat content.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d5">1</data>
      <data key="d6">14229</data>
      <data key="d7">913f5f1c298b4736bda51947e61e4b4f</data>
    </node>
    <node id="GRAPEFRUIT JUICE">
      <data key="d0">GEO</data>
      <data key="d1">Grapefruit juice contains flavonoids that inhibit the metabolism of several drugs by affecting the CYP3A4 enzyme.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d3">1644</data>
      <data key="d4">2</data>
