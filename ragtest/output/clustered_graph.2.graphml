      <data key="d7">203626bbc4c547e184c2c55a9c862c59</data>
    </node>
    <node id="DEFICITS SENSORIALES">
      <data key="d0">EVENT</data>
      <data key="d1">Sensory deficits refer to impairments in the senses that can affect cognitive function and are associated with an increased risk of dementia.</data>
      <data key="d2">53e49c7e4c8bca9063d743acb9997132</data>
      <data key="d3">1641</data>
