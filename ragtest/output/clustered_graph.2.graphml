    <node id="HIGIENE ALIMENTARIA">
      <data key="d0">EVENT</data>
      <data key="d1">Conjunto de condiciones y medidas necesarias para garantizar la salubridad e inocuidad de los alimentos durante su producci&#243;n y distribuci&#243;n.</data>
