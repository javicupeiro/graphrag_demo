      <data key="d8">8.0</data>
      <data key="d9">Pica percut&#225;nea is a procedure that involves the use of gastrostomy tubes for feeding</data>
      <data key="d10">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d11">7db77d00588440cdb679e79ef52ddddc</data>
