      <data key="d6">16332</data>
      <data key="d7">f5099c9be4b1462ba0e08ccf5276d840</data>
    </node>
    <node id="EORTC-QLQ-C30">
      <data key="d0">EVENT</data>
      <data key="d1">EORTC-QLQ-C30 is a quality of life assessment tool used in cancer patients to measure the impact of treatments on their well-being.</data>
