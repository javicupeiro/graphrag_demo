    <node id="PRECIPITACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">PRECIPITACI&#211;N is the process where proteins settle out of solution, which can occur in clinical nutrition products under certain conditions.</data>
      <data key="d2">dc38a37c30b175667931b84a9c9103bb</data>
      <data key="d3">670</data>
