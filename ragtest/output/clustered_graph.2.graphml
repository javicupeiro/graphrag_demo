    <node id="BACTEROIDES VULGATUS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Bacteroides vulgatus is a bacterium that has been implicated in gastrointestinal health and disease, particularly in relation to inflammatory bowel disease.</data>
      <data key="d2">23b65526747fa6950a347d0f0a597a40</data>
