    </node>
    <node id="SINDROME DE RABSON-MENDENHALL">
      <data key="d0">EVENT</data>
      <data key="d1">Rabson-Mendenhall syndrome is a pediatric syndrome characterized by severe insulin resistance and growth impairment, caused by mutations in the insulin receptor gene.</data>
      <data key="d2">ac89fcaa7dcce835c0d5b9ed9ce94cea</data>
      <data key="d5">3</data>
