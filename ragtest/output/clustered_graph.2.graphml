    </edge>
    <edge source="MECV-V" target="PACIENTE">
      <data key="d8">6.0</data>
      <data key="d9">The patient underwent the MECV-V test to assess swallowing difficulties</data>
      <data key="d10">4681f41ebd69a732f7a8be6c2ed0f51a</data>
      <data key="d11">ee9743e8ca7041d3ba169053039d9e13</data>
