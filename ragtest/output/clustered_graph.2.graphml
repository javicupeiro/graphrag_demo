      <data key="d7">19d1bf81e2274ac69105f356b054e7c2</data>
    </node>
    <node id="CRISIS DE ATAXIA">
      <data key="d0">EVENT</data>
      <data key="d1">Ataxia crisis is a clinical manifestation that can occur in adults with Maple Syrup Urine Disease during intercurrent processes.</data>
