      <data key="d8">8.0</data>
      <data key="d9">Bego&#241;a Rom&#225;n is a member of the Bioethics Committee of Catalonia, contributing to discussions on bioethical issues.</data>
      <data key="d10">3775bd9e3567a81cf7b7acf1e2741f6f</data>
