      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">4324</data>
      <data key="d7">c0082c4d20e2445f95cc50ff5f136f0e</data>
    </node>
    <node id="DM2">
      <data key="d0">EVENT</data>
      <data key="d1">DM2 refers to Type 2 Diabetes Mellitus, a chronic condition that affects the way the body processes blood sugar (glucose). It is a metabolic disorder characterized by insulin resistance, which leads to elevated blood sugar levels. Additionally, DM2 is associated with various lipid abnormalities, further complicating the metabolic profile of individuals affected by this condition.</data>
      <data key="d2">e0db2f1e2ec0f05e24ec079563d8952a,e83d288a4f420cdc975112d3a63bd522</data>
      <data key="d3">1072</data>
