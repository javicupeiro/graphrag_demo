      <data key="d7">5e72f180e8ec45ba871612a6bd6e8bbf</data>
    </node>
    <node id="EVALUACI&#211;N GLOBAL SUBJETIVA GLOBAL (VSG)">
      <data key="d0">EVENT</data>
      <data key="d1">The Global Subjective Assessment (VSG) is an evaluation method used to assess a patient's nutritional status based on various criteria.</data>
      <data key="d2">0bc48d0666e895b990c211acf7cbcf23</data>
      <data key="d3">598</data>
      <data key="d4">2</data>
