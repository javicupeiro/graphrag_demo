    <node id="CARCINOMATOSIS PERITONEAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Peritoneal carcinomatosis refers to the spread of cancer to the peritoneum, which can cause ascitis quilosa.</data>
