    <node id="HEPATIC INSUFFICIENCY">
      <data key="d0">EVENT</data>
      <data key="d1">A condition where the liver fails to perform its normal functions, impacting amino acid metabolism and requirements.</data>
      <data key="d2">cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d3">1266</data>
