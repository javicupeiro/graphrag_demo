    <node id="BELAFSKY">
      <data key="d0">PERSON</data>
      <data key="d1">Belafsky is a researcher who validated the Eating Assessment Tool-10 (EAT-10) in 2008.</data>
      <data key="d2">8d3134a53f89ef62070b5c3b2a7bc136</data>
      <data key="d3">959</data>
      <data key="d4">2</data>
