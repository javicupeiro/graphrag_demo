      <data key="d12">14550</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADRENOLEUCODISTROFIA" target="LOVASTATINA">
      <data key="d8">7.0</data>
      <data key="d9">Lovastatina can reduce AGCML levels in patients with adrenoleucodistrofia</data>
