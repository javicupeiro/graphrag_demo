      <data key="d6">6179</data>
      <data key="d7">1b62d060c51146498d65210cb752023b</data>
    </node>
    <node id="ACIDOSIS TUBULAR PROXIMAL">
      <data key="d0">EVENT</data>
      <data key="d1">Proximal tubular acidosis is a condition affecting the kidneys' ability to reabsorb bicarbonate, leading to metabolic acidosis.</data>
      <data key="d2">a1b16c80a55fd88d0b1efb78addf3853</data>
      <data key="d3">628</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6180</data>
      <data key="d7">2b6c763978834ad8a8af60cfdb2353ee</data>
    </node>
    <node id="ACIDOSIS TUBULAR DISTAL">
      <data key="d0">EVENT</data>
      <data key="d1">Distal tubular acidosis is a disorder where the kidneys fail to excrete acids into the urine, leading to a buildup of acid in the blood.</data>
      <data key="d2">a1b16c80a55fd88d0b1efb78addf3853</data>
      <data key="d3">628</data>
      <data key="d4">2</data>
