    <node id="HYPOPHOSPHATEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hypophosphatemia is a condition characterized by low levels of phosphate in the blood, which can occur in various clinical situations, including refeeding syndrome.</data>
      <data key="d2">b9342cecd69cdc0e9936df041657f5f5</data>
      <data key="d3">711</data>
