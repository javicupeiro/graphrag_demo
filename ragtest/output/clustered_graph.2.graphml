      <data key="d11">224d8336915e4f0c87ee287cc2809504</data>
      <data key="d12">3624</data>
      <data key="d13">2</data>
    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="C&#193;NCER">
      <data key="d8">9.0</data>
      <data key="d9">C&#225;ncer often leads to p&#233;rdida de peso as a significant symptom due to various factors including tumor presence and treatment effects.</data>
      <data key="d10">b26b998479da515c234ce46b1bfa73db</data>
      <data key="d11">df2d98e2d5db45c7823e4ced44fb8084</data>
      <data key="d12">3625</data>
