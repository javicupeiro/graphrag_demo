      <data key="d10">6d116bdd48d75e9e6c33844db5816915</data>
      <data key="d11">e6d50438acba4eb89c1cdd66bf40ef0b</data>
      <data key="d12">1131</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANUAL DE DISFAGIA OROFAR&#205;NGEA" target="PACIENTES CON DISFAGIA">
      <data key="d8">8.0</data>
      <data key="d9">The manual provides guidelines and recommendations specifically for patients with dysphagia</data>
