    <node id="INTERNET">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Internet is a global network that facilitates instant communication and access to information across vast distances. It has revolutionized the way people connect and share data, transforming various aspects of daily life, business, and social interaction.</data>
      <data key="d2">3d64634b55389cb5d01f78b185bada8d,5a0cbd0175ff61eee9b252f8ba7040ed,98b5a4ce29a4f18c4069276963d8cc19</data>
