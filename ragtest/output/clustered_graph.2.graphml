    </node>
    <node id="SUCRASE-ISOMALTASE DEFICIENCY">
      <data key="d0">EVENT</data>
      <data key="d1">Sucrase-isomaltase deficiency is a condition that affects the digestion of certain sugars, relevant in the context of infant nutrition.</data>
      <data key="d2">08d66dc8414668a3ec627a1e164cfa6c</data>
      <data key="d3">454</data>
      <data key="d4">1</data>
