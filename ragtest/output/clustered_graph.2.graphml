      <data key="d8">3.0</data>
      <data key="d9">The patient has both diabetes mellitus and dislipemia, indicating a complex metabolic condition</data>
      <data key="d10">3a1d1c4eb34995d440bd72c4b64e3c8d</data>
      <data key="d11">8489a6af4fb7480cb5612d5ac9a6aa65</data>
      <data key="d12">1562</data>
