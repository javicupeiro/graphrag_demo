    </edge>
    <edge source="LACTANTES" target="NEPHRO-TECT&#174;">
      <data key="d8">4.0</data>
      <data key="d9">Nephro-tect&#174; is indicated for renal insufficiency, which may also affect pediatric patients</data>
      <data key="d10">a6e7937ce59bfc2b38e9ed2acf3e991c</data>
      <data key="d11">37e7f60c459a4594895cc53a65be165a</data>
      <data key="d12">9998</data>
