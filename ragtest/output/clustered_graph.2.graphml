    </node>
    <node id="ALBUMINA S&#201;RICA">
      <data key="d0">PERSON</data>
      <data key="d1">Serum albumin is a protein that reflects the nutritional status and synthesis capacity of the liver.</data>
      <data key="d2">a6ed8551aad722adcaf8fced4ac8685b</data>
      <data key="d3">1163</data>
      <data key="d4">2</data>
