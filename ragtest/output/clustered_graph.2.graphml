    <edge source="NUTRICI&#211;N ENTERAL" target="GASTROSTOM&#205;A PERCUT&#193;NEA ENDOSC&#211;PICA">
      <data key="d8">9.0</data>
      <data key="d9">La gastrostom&#237;a percut&#225;nea endosc&#243;pica es un m&#233;todo para administrar nutrici&#243;n enteral a pacientes que no pueden alimentarse por v&#237;a oral.</data>
      <data key="d10">4ae09eb472a346b355bc66df2fea519f</data>
      <data key="d11">643441e4e11d4f9098aa6437effb7d72</data>
      <data key="d12">2598</data>
