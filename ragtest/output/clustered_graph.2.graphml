    </node>
    <node id="AN&#193;LISIS DE FLUJO-PRESI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">El an&#225;lisis de flujo-presi&#243;n es un m&#233;todo que combina la medici&#243;n de impedancia y manometr&#237;a para evaluar la funci&#243;n deglutoria.</data>
      <data key="d2">dbe1af2b277e06c9d447af56351e496f</data>
      <data key="d3">962</data>
