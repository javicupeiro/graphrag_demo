      <data key="d11">cfde3b65852e40709c87d6308fcf8e90</data>
      <data key="d12">900</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RADIOTERAPIA" target="PACIENTE">
      <data key="d8">8.0</data>
      <data key="d9">Radiotherapy can impact a patient's ability to maintain proper nutrition, requiring additional support</data>
      <data key="d10">36cffc3e7c3a6fe82e50787e939f7537</data>
      <data key="d11">1ecd47def31c414aab694a72f135aab2</data>
      <data key="d12">901</data>
