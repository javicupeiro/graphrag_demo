      <data key="d10">7855ffa74481ba85f44e9700279250e7</data>
      <data key="d11">3cd39e0f63e042b6855a30f01b615078</data>
      <data key="d12">7232</data>
      <data key="d13">2</data>
    </edge>
    <edge source="WEIGHT LOSS" target="LOW-FAT DIET">
      <data key="d8">7.0</data>
      <data key="d9">The low-fat diet is designed to promote weight loss by reducing fat intake</data>
      <data key="d10">7855ffa74481ba85f44e9700279250e7</data>
      <data key="d11">7feff300b1994b2a9a1da9d116e332fd</data>
      <data key="d12">7233</data>
      <data key="d13">2</data>
    </edge>
    <edge source="WEIGHT LOSS" target="LOW-CARBOHYDRATE DIET">
      <data key="d8">7.0</data>
      <data key="d9">The low-carbohydrate diet is aimed at achieving weight loss through the restriction of carbohydrates</data>
      <data key="d10">7855ffa74481ba85f44e9700279250e7</data>
      <data key="d11">69c119c5e1f24b93b50bcca360f494e9</data>
      <data key="d12">7234</data>
      <data key="d13">2</data>
    </edge>
    <edge source="WEIGHT LOSS" target="CLINICAL DATA">
      <data key="d8">8.0</data>
