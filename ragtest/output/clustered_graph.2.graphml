      <data key="d6">8578</data>
      <data key="d7">585b81bb4d3d463d91931261c135f608</data>
    </node>
    <node id="BLOOM">
      <data key="d0">EVENT</data>
      <data key="d1">The BLOOM study is a clinical trial assessing the effects of lorcaserin on overweight and obesity management, with 3182 patients over 2 years.</data>
      <data key="d2">623ef060e116bc05259d5e6d3d8c0996</data>
      <data key="d3">1414</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
