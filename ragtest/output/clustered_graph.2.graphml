      <data key="d11">579c22f49e574c399469fb749c75efd4</data>
      <data key="d12">9408</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACIDOSIS LACTICA" target="GLYCOGEN STORAGE DISEASE TYPE I">
      <data key="d8">6.0</data>
