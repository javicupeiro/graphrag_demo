      <data key="d7">025785dbdd7d49cc8c97a688882f8827</data>
    </node>
    <node id="FARRELL PM">
      <data key="d0">PERSON</data>
      <data key="d1">Farrell PM is a researcher who studied the prevalence of cystic fibrosis in the European Union.</data>
      <data key="d2">1e997b2a6bf1c926a7a17d8b5ac1e699</data>
