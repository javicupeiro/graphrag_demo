    </node>
    <node id="VENOUS ACCESS">
      <data key="d0">EVENT</data>
      <data key="d1">Venous access refers to the medical procedures used to gain access to the venous system for treatment purposes, such as administering medications or fluids.</data>
      <data key="d2">3d5e0a3ef45c7ba15063791545dc4826</data>
