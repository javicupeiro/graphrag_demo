    </node>
    <node id="FETAL AND NEONATAL HYPERTHYROIDISM">
      <data key="d0">EVENT</data>
      <data key="d1">A condition where a fetus or newborn has excessive thyroid hormone levels, which can lead to various health issues.</data>
