    <node id="ENDOTEXT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Endotext is a comprehensive online resource for endocrinology, providing information on various endocrine disorders, including hypothyroidism.</data>
      <data key="d2">4138cb85d4afff56555b4a536340ca90</data>
