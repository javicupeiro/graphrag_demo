    <node id="2000">
      <data key="d0">EVENT</data>
      <data key="d1">The year 2000 is part of the timeline for the evolution of home parenteral nutrition as recorded in the NADYA registry.</data>
      <data key="d2">efc0b55f4e91f02e4708b7cc43c64608</data>
