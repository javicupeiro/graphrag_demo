    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="NUTRITION SCREENING INITIATIVE">
      <data key="d8">5.0</data>
      <data key="d9">The Nutrition Screening Initiative promotes the use of tools like MUST for assessing nutritional risk</data>
      <data key="d10">07b1884f11a85f8feb424b7cc369f822</data>
      <data key="d11">c5779056254d46dd9c01cd2205c7e0fe</data>
      <data key="d12">3904</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="DENT E">
      <data key="d8">6.0</data>
      <data key="d9">Dent E's research includes analysis of the malnutrition universal screening tool among other screening methods.</data>
