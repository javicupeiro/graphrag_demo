    <edge source="PACIENTE ANCIANO" target="ACTIVIDAD F&#205;SICA">
      <data key="d8">1.0</data>
      <data key="d9">La actividad f&#237;sica es importante para el bienestar general del paciente anciano y ayuda en el manejo de enfermedades cr&#243;nicas.</data>
      <data key="d10">2f548ddee569586dbe82ca124f2695e9</data>
      <data key="d11">025fc380e48c411bb09ec3ed91f1d08c</data>
      <data key="d12">9914</data>
