    </node>
    <node id="POLYENDOCRINOPAT&#205;A AUTOINMUNE DE TIPO 1">
      <data key="d0">EVENT</data>
      <data key="d1">Polyendocrinopathy autoimmune type 1 (APECED) is a syndrome caused by a mutation in the AIRE gene, leading to multiple autoimmune conditions including diabetes.</data>
      <data key="d2">d0231ac4e41b0e826d80763b5b8c61e0</data>
      <data key="d3">1720</data>
      <data key="d4">2</data>
