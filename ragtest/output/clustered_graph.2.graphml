      <data key="d12">1055</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HOSPITAL" target="PACIENTE CELIACO">
      <data key="d8">8.0</data>
      <data key="d9">The hospital staff must be informed about the celiac patient's gluten-free diet to ensure proper care.</data>
