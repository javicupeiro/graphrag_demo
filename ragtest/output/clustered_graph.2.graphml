    </edge>
    <edge source="SONDA" target="COMPROBACI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">La comprobaci&#243;n es necesaria para asegurar que la sonda est&#225; correctamente colocada</data>
      <data key="d10">c78e1786c296e2b8a7ad428c0fb10c36</data>
      <data key="d11">b41dcdfb13ed46f587a1d4097db1e4d5</data>
      <data key="d12">7796</data>
