    <edge source="PROTE&#205;NAS" target="INTESTINO DELGADO">
      <data key="d8">8.0</data>
      <data key="d9">El intestino delgado es el lugar donde se absorben las prote&#237;nas en el sistema digestivo.</data>
      <data key="d10">06ffde2dc989dcf66c55a8058f4f51d9</data>
      <data key="d11">2b6824f298654bd2971efdca0a9f8957</data>
