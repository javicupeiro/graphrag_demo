    <edge source="DIETA EQUILIBRADA" target="PATOLOG&#205;AS ESPEC&#205;FICAS">
      <data key="d8">1.0</data>
      <data key="d9">A balanced diet can help manage specific health conditions, emphasizing the link between nutrition and health</data>
      <data key="d10">e0102bb655b6476ce3296726e3aceb4a</data>
