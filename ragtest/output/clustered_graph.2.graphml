    </node>
    <node id="DIETA DIAB&#201;TICA HIPERPROTEICA">
      <data key="d0">EVENT</data>
      <data key="d1">La dieta diab&#233;tica hiperproteica es el r&#233;gimen alimenticio que se implement&#243; para la paciente durante su recuperaci&#243;n postoperatoria.</data>
      <data key="d2">67f96f3e5c366f82de31f1bf189aa71f</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
