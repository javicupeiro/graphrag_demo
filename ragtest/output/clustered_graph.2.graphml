      <data key="d11">e0fd0095c4c84f04ac7944a84c15dccd</data>
      <data key="d12">7412</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALBUMINA" target="PROTE&#205;NAS PLASM&#193;TICAS">
