      <data key="d6">13005</data>
      <data key="d7">4d8f4927bab8412c8584dc92c15bbddf</data>
    </node>
    <node id="DISFUNCI&#211;N INMUNE">
      <data key="d0">EVENT</data>
      <data key="d1">Immune dysfunction refers to the impaired immune response that can occur in patients with chronic diseases, including EPOC.</data>
      <data key="d2">ddd48beea3c882bf1a651cb25283ba91</data>
