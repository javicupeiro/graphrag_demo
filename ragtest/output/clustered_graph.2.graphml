      <data key="d0">EVENT</data>
      <data key="d1">Patoolog&#237;a m&#233;dica infecciosa refers to infectious diseases that cause severe malabsorption, such as AIDS, leading to malnutrition.</data>
      <data key="d2">298e79737894aa157da136b1996578bf</data>
      <data key="d3">1207</data>
