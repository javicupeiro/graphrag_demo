      <data key="d8">7.0</data>
      <data key="d9">El yodo se utiliza en el tratamiento del c&#225;ncer de tiroides mediante radioyodo</data>
      <data key="d10">072912695b1cff9f390d4ead3b9ad742</data>
      <data key="d11">2e885d5182724c76a1ee315628bd98aa</data>
      <data key="d12">8639</data>
      <data key="d13">2</data>
    </edge>
    <edge source="YODO" target="HIPERTIROIDISMO">
      <data key="d8">7.0</data>
      <data key="d9">El yodo se utiliza en el tratamiento del hipertiroidismo mediante radioyodo</data>
      <data key="d10">072912695b1cff9f390d4ead3b9ad742</data>
      <data key="d11">d6f2cd615e684ce2aac05c30c57b536d</data>
      <data key="d12">8640</data>
      <data key="d13">2</data>
    </edge>
    <edge source="YODO" target="ALIMENTOS RICOS EN YODO">
      <data key="d8">7.0</data>
      <data key="d9">Los alimentos ricos en yodo contienen este elemento esencial para la funci&#243;n tiroidea</data>
      <data key="d10">072912695b1cff9f390d4ead3b9ad742</data>
      <data key="d11">e2f91d3c16114ace93f48c094f0d1393</data>
      <data key="d12">8641</data>
      <data key="d13">2</data>
    </edge>
    <edge source="YODO" target="HORMONA TIROIDEA">
