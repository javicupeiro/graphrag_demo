      <data key="d10">f0bfe278aa9f43f4bc9d056de67a5b96</data>
      <data key="d11">97a6e96ca7c54d3c86d7d60f43b48b4a</data>
      <data key="d12">13273</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#218;SCULO" target="DEPORTISTA">
      <data key="d8">9.0</data>
      <data key="d9">Athletes develop muscle strength and size through training and proper nutrition, which is critical for their performance.</data>
      <data key="d10">39da0855b83941d97766254aa36ed2fd</data>
      <data key="d11">1e78da63058c48408ca504172a0d9d0d</data>
      <data key="d12">13274</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#218;SCULO" target="ADAPTACI&#211;N">
      <data key="d8">1.0</data>
      <data key="d9">Muscle adaptation occurs as a result of consistent training, leading to improved performance and energy efficiency in athletes.</data>
      <data key="d10">39da0855b83941d97766254aa36ed2fd</data>
      <data key="d11">9eac1aaead2242b3aa1db10d1c4d0d66</data>
      <data key="d12">13275</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#218;SCULO" target="EJERCICIO DE FUERZA">
      <data key="d8">9.0</data>
