      <data key="d5">3</data>
      <data key="d6">9078</data>
      <data key="d7">4316402dee824275be40ef1061b25523</data>
    </node>
    <node id="PREVOTELLA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Prevotella is a genus of bacteria that has been negatively associated with obesity.</data>
