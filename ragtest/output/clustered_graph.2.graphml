    <node id="GLUTEN-FREE CERTIFICATION ORGANIZATION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Gluten-Free Certification Organization is an entity established to certify food products as gluten-free, adhering to stringent criteria. Its primary mission is to provide certification for gluten-free products, ensuring safety and reliability for individuals with celiac disease and other gluten-related disorders.</data>
      <data key="d2">17593b5969d4126aef1c56a7d32dc922,1d8aa686c6377246fee05010ef969018</data>
      <data key="d3">830</data>
