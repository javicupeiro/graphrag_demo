      <data key="d5">3</data>
      <data key="d6">15864</data>
      <data key="d7">ffa3d87fc80343e6b6e82a794fb9b0bf</data>
    </node>
    <node id="PILANESBERG">
      <data key="d0">GEO</data>
      <data key="d1">Pilanesberg es un lugar donde se revis&#243; la declaraci&#243;n de la Organizaci&#243;n M&#233;dica Mundial en 2006.</data>
      <data key="d2">3a39d5a157094736650455097e986fdd</data>
      <data key="d3">1482</data>
      <data key="d4">2</data>
