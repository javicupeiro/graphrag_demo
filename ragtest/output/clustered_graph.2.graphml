    </node>
    <node id="ASEGURADORA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Una aseguradora es una entidad que proporciona seguros de salud y juega un papel en la mesogesti&#243;n del sistema sanitario.</data>
