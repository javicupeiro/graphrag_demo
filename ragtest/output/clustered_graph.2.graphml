    </node>
    <node id="&#937;-3">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">&#969;-3 fatty acids are essential fats that the body cannot produce by itself, important for heart and brain health.</data>
      <data key="d2">e1766b4a9f6cff776650a29195cee9fc</data>
      <data key="d3">1631</data>
      <data key="d4">2</data>
