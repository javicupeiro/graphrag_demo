    </node>
    <node id="MULTIVARIATE ANALYSIS">
      <data key="d0">EVENT</data>
      <data key="d1">Multivariate analysis is a statistical method used to understand the relationship between multiple variables, such as nutritional factors and survival in liver cirrhosis patients.</data>
      <data key="d2">9ea9816b490492ba0030e6ba4bc3bb9f</data>
      <data key="d3">1513</data>
      <data key="d4">2</data>
