      <data key="d9">La EICH es una complicaci&#243;n que puede surgir en pacientes que han recibido un trasplante de c&#233;lulas hematopoy&#233;ticas.</data>
      <data key="d10">86a4647fb1fa580f7b72aa4833965ecb</data>
      <data key="d11">995fe68852ae4244b83a6d710bccf6cf</data>
      <data key="d12">9554</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EICH" target="CICLOSPORINA">
