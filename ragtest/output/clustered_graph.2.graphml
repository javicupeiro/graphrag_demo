      <data key="d1">Type 2 diabetes remission refers to the state where diabetes symptoms are no longer present, often discussed in the context of bariatric surgery outcomes.</data>
      <data key="d2">e5b6965b2fc3b73112c8bd3bdb58738f</data>
      <data key="d3">1012</data>
      <data key="d4">2</data>
