      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="ENFERMEDADES">
      <data key="d8">6.0</data>
      <data key="d9">Patients may have multiple diseases that coexist with diabetes, complicating their treatment and nutritional requirements.</data>
