      <data key="d11">4147c3cd1adf4290a3a96c5f4748cb7b</data>
      <data key="d12">1056</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HOSPITAL" target="DIETA CETOG&#201;NICA">
      <data key="d8">6.0</data>
      <data key="d9">El ingreso hospitalario es recomendado durante los primeros d&#237;as de la dieta cetog&#233;nica para un control adecuado</data>
      <data key="d10">4d84210c815fb41f2fa44f3e01aafa02</data>
      <data key="d11">4f2111a7bbea4b04846d22d1c62ecdac</data>
      <data key="d12">1057</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HOSPITAL" target="HIPOCALCEMIA">
      <data key="d8">7.0</data>
      <data key="d9">La hipocalcemia es com&#250;nmente observada en pacientes hospitalizados debido a diversas condiciones m&#233;dicas.</data>
