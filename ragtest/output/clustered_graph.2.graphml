      <data key="d7">38a3e84bf60543c0a01b4d6ace7a6bd4</data>
    </node>
    <node id="OLAH">
      <data key="d0">PERSON</data>
      <data key="d1">Olah es un autor de un estudio que ha encontrado resultados sobre el soporte nutricional en pacientes con pancreatitis aguda.</data>
      <data key="d2">be7eb01a6daf673db6a127f66c79c96c</data>
