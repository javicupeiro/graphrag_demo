    <node id="TERAPEUTICA NUTRICIONAL">
      <data key="d0">EVENT</data>
      <data key="d1">Therapeutic measures for patients with malabsorption syndrome, including fluid replenishment and specialized nutritional support to prevent malnutrition.</data>
      <data key="d2">d147df5b06fa62d87b7edd3f20dcd246</data>
