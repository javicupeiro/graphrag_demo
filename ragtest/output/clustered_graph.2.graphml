      <data key="d13">2</data>
    </edge>
    <edge source="CVC" target="TROMBO MURAL">
      <data key="d8">7.0</data>
      <data key="d9">Trombo mural can obstruct the flow through the CVC, affecting its performance</data>
      <data key="d10">1c3eeb30a49c70f750b79e7bc1dfef52</data>
      <data key="d11">c107100b41e546cab88bbf10aba70f71</data>
