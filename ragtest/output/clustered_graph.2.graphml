    <node id="CANCER PATIENT">
      <data key="d0">PERSON</data>
      <data key="d1">Cancer patients are individuals diagnosed with cancer who may require nutritional support due to the effects of the disease and its treatment.</data>
      <data key="d2">cae7bf8d7b8c9d1f34a87ef41ff39a17</data>
      <data key="d3">1210</data>
      <data key="d4">2</data>
