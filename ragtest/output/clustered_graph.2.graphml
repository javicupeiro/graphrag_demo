      <data key="d11">ef5ce76367ce43a0b200f8c96b5ed69c</data>
      <data key="d12">9558</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EICH" target="EPA">
      <data key="d8">8.0</data>
      <data key="d9">EPA is used to reduce the incidence and severity of EICH in patients undergoing transplantation</data>
