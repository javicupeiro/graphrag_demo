    </edge>
    <edge source="DIARREA" target="ANTIBI&#211;TICOS">
      <data key="d8">7.0</data>
      <data key="d9">Diarrhea can be caused by the use of antibiotics, especially after their administration</data>
      <data key="d10">0bdc356a46149def2545e7939372c20d</data>
