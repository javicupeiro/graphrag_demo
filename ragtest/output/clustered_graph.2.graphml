    <node id="C&#193;NCER GASTROINTESTINAL">
      <data key="d0">EVENT</data>
      <data key="d1">Cancer affecting the gastrointestinal tract, which has low survival rates and requires careful nutritional management.</data>
      <data key="d2">639ebafae8a95bb03a09e111172b9a4e</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">13407</data>
      <data key="d7">4ae9c9c39f6145d4b927e8b06702056b</data>
    </node>
    <node id="QUIMIO Y/O RADIOTERAPIA">
      <data key="d0">EVENT</data>
      <data key="d1">Chemotherapy and/or radiotherapy are treatments that can complicate the nutritional status of patients with gastrointestinal tumors.</data>
      <data key="d2">639ebafae8a95bb03a09e111172b9a4e</data>
      <data key="d3">1084</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13408</data>
      <data key="d7">010d710666044559a5120c4af289e8fc</data>
    </node>
    <node id="GERIATRIC FRAILTY">
      <data key="d0">EVENT</data>
      <data key="d1">A condition that, along with nutritional status, is assessed to predict postoperative mortality in gastric cancer surgery.</data>
      <data key="d2">0a742cf103e30cf0fadaf6ffabbbde2d</data>
      <data key="d3">742</data>
      <data key="d4">2</data>
