      <data key="d11">d745ab7db07f46aa84dc51c3fd34ef62</data>
      <data key="d12">4928</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="&#193;CIDO DOCOSAHEXAENOICO">
      <data key="d8">7.0</data>
      <data key="d9">DHA is often included in parenteral nutrition formulations to support brain development in infants</data>
