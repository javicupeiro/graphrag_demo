    <edge source="NUTRICI&#211;N PARENTERAL" target="RECI&#201;N NACIDOS PREMATUROS">
      <data key="d8">1.0</data>
      <data key="d9">Preterm infants are the primary beneficiaries of parenteral nutrition to prevent undernutrition</data>
      <data key="d10">61a35dc8c2c6728e1df80cb1037e6296</data>
      <data key="d11">da92602e9fb64c55893b66ed91775464</data>
      <data key="d12">4700</data>
