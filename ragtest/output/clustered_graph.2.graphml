      <data key="d7">9ce7c0ea89d3426a9e47c55983c1b376</data>
    </node>
    <node id="VIDEOFLOUROSCOPIA DE LA DEGLUCI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Videofluoroscopy of swallowing is a diagnostic imaging technique that evaluates the swallowing process in real-time.</data>
      <data key="d2">dae3d2cddf63b2af4067a27d8b9d7ab5</data>
