      <data key="d7">474119736cd64905926ec3026263eafe</data>
    </node>
    <node id="MIRTALLO J">
      <data key="d0">PERSON</data>
      <data key="d1">Mirtallo J is a contributor to the international consensus guidelines on malnutrition.</data>
      <data key="d2">b422a0b87e2f7205a53dc0a5f1c0ab39</data>
      <data key="d3">728</data>
