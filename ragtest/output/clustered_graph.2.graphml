    <node id="VALORACI&#211;N GLOBAL SUBJETIVA GENERADA POR EL PACIENTE">
      <data key="d0">EVENT</data>
      <data key="d1">The Valoraci&#243;n Global Subjetiva Generada por el Paciente (VGS-GP) is a subjective assessment tool used to evaluate nutritional status, particularly in oncology patients.</data>
      <data key="d2">8ccd7ff955c5b8a333f23f41e34c563a</data>
      <data key="d3">1922</data>
      <data key="d4">2</data>
