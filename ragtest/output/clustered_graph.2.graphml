      <data key="d8">1.0</data>
      <data key="d9">Otolaryngologists are responsible for diagnosing and treating oropharyngeal dysphagia</data>
      <data key="d10">dae3d2cddf63b2af4067a27d8b9d7ab5</data>
      <data key="d11">f050c30f952847c4b268ad5c87ab1884</data>
      <data key="d12">141</data>
      <data key="d13">2</data>
    </edge>
