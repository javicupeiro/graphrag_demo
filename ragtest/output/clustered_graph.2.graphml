    <node id="RANITIDINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ranitidina is a medication that is primarily used to reduce stomach acid and treat conditions such as gastroesophageal reflux disease (GERD). In exceptional cases, it can also be included in parenteral nutrition.</data>
      <data key="d2">1ff94f3fcc6eff16c2fdae5eb9b3aefa,20b676e149e50ddc54c40e2e1577e9ac</data>
