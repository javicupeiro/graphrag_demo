      <data key="d9">Kovacevich D.S. contributed to the standards for specialized nutrition support relevant to ESPEN</data>
      <data key="d10">477da86aa038212a1e2b555b5a854cba</data>
      <data key="d11">23579afc96b14a83a84d1d19f9b1c407</data>
      <data key="d12">2978</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="MIRTALLO J.">
      <data key="d8">1.0</data>
      <data key="d9">Mirtallo J. was involved in the task force for safe practices for parenteral nutrition under ESPEN</data>
      <data key="d10">477da86aa038212a1e2b555b5a854cba</data>
      <data key="d11">62be4cf0e381408f9244fedabb538103</data>
      <data key="d12">2979</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="COCHRANE">
      <data key="d8">7.0</data>
      <data key="d9">Cochrane reviews provide evidence that informs the guidelines set by ESPEN regarding clinical nutrition practices.</data>
      <data key="d10">61eea56f443c7bb2509edd6f42af2643</data>
      <data key="d11">a07999ae71044a6b8a62598b894a2cbb</data>
      <data key="d12">2980</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="AGREE">
      <data key="d8">5.0</data>
      <data key="d9">AGREE collaborates with organizations like ESPEN to enhance the quality of clinical practice guidelines in nutrition</data>
      <data key="d10">07a16ed299a7f8bafcaa44a54495a9c3</data>
      <data key="d11">c422b887b7cb452595113458a104e874</data>
      <data key="d12">2981</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="SOCIETY ESPA&#209;OLA DE ENDOCRINOLOG&#205;A Y NUTRICI&#211;N">
      <data key="d8">4.0</data>
      <data key="d9">The Spanish Society of Endocrinology and Nutrition aligns with ESPEN's guidelines for clinical nutrition</data>
      <data key="d10">07a16ed299a7f8bafcaa44a54495a9c3</data>
      <data key="d11">dc891d74907548bda0c3413d862d92c6</data>
      <data key="d12">2982</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="CANADIAN CRITICAL CARE PRACTICE GUIDELINES">
      <data key="d8">5.0</data>
      <data key="d9">The Canadian Critical Care Practice Guidelines have been influenced by the guidelines developed by ESPEN</data>
      <data key="d10">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d11">26302596b49740ae99fc8bdd350f82b6</data>
      <data key="d12">2983</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="NATIONAL INSTITUTE FOR CLINICAL EXCELLENCE">
      <data key="d8">4.0</data>
      <data key="d9">NICE guidelines have been compared to those of ESPEN, indicating a relationship in the context of clinical nutrition</data>
      <data key="d10">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d11">1b561d63225d469baa7699db2f623adf</data>
      <data key="d12">2984</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="GORDON JENSEN">
      <data key="d8">6.0</data>
      <data key="d9">Gordon Jensen has been involved in the development of guidelines in collaboration with ESPEN</data>
      <data key="d10">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d11">e7ab863f86bb474f9600ccdc17545866</data>
      <data key="d12">2985</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="ALASTAIR FORBES">
      <data key="d8">6.0</data>
      <data key="d9">Alastair Forbes has collaborated with ESPEN in the creation of common guidelines for nutritional management</data>
      <data key="d10">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d11">cbbecab0b3c04c3c8738ce4daf7fa7ca</data>
      <data key="d12">2986</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="GRADE">
      <data key="d8">5.0</data>
      <data key="d9">ESPEN has modified its methodology to adapt to the GRADE system for developing guidelines</data>
      <data key="d10">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d11">f3de981678244a06a5803b0476d49848</data>
      <data key="d12">2987</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="SIGN">
      <data key="d8">5.0</data>
      <data key="d9">ESPEN has employed the SIGN classification system in developing its guidelines</data>
      <data key="d10">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d11">556f19dde8534b1d8871876ee1b4dd07</data>
      <data key="d12">2988</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="GRADE WORKING GROUP">
      <data key="d8">6.0</data>
      <data key="d9">Both organizations are involved in establishing standards and guidelines for evidence-based medicine and clinical nutrition</data>
      <data key="d10">f5d0adafea7d8fe8216c624188ddad04</data>
      <data key="d11">be8bb80f4f8d4e319efcaa194b6b411f</data>
      <data key="d12">2989</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="NUTRICI&#211;N PARENTERAL DOMICILIARIA">
      <data key="d8">1.0</data>
      <data key="d9">ESPEN provides guidelines that may influence practices related to home parenteral nutrition</data>
      <data key="d10">4cf0c8d0f4e711be85d16ee71317aa4e</data>
      <data key="d11">419b6143c9aa464e919057f21f2eb2da</data>
      <data key="d12">2990</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ESPEN" target="NUTRICI&#211;N Y DIET&#201;TICA">
      <data key="d8">1.0</data>
      <data key="d9">The field of Nutrition and Dietetics is also supported by ESPEN, which focuses on clinical nutrition and metabolism.</data>
      <data key="d10">c3182f51249513a920db6b935632fead</data>
      <data key="d11">027b565478cb4287ab066ca40cb838f2</data>
      <data key="d12">2991</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VIDEOENDOSCOPIA DE LA DEGLUCI&#211;N" target="SUSAN LANGMORE">
      <data key="d8">9.0</data>
      <data key="d9">Dr. Susan Langmore first described the videoendoscopy procedure for evaluating swallowing in 1988</data>
      <data key="d10">be410757354948d16ee86e49a852101c</data>
      <data key="d11">4ac5770f17e24cca8a5f7f387a97f690</data>
      <data key="d12">2992</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VIDEOENDOSCOPIA DE LA DEGLUCI&#211;N" target="VFS">
      <data key="d8">7.0</data>
      <data key="d9">Both videoendoscopy and VFS are diagnostic tests used to evaluate swallowing function</data>
      <data key="d10">be410757354948d16ee86e49a852101c</data>
      <data key="d11">3f767982ba9e42fbbb6d7919a0aac63a</data>
      <data key="d12">2993</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VIDEOENDOSCOPIA DE LA DEGLUCI&#211;N" target="UFDOF">
      <data key="d8">8.0</data>
      <data key="d9">UFDOF conducts videoendoscopy of swallowing as part of its assessment procedures</data>
      <data key="d10">eb2f276d3dc4e4a9e53923d9d80fec1a</data>
      <data key="d11">02f13746d6b643b0af85950d17d371db</data>
      <data key="d12">2994</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRATADO DE NUTRICI&#211;N" target="EDITORIAL M&#201;DICA PANAMERICANA">
      <data key="d8">6.0</data>
      <data key="d9">Editorial M&#233;dica Panamericana published the book "Tratado de Nutrici&#243;n" in 2017</data>
      <data key="d10">dae3d2cddf63b2af4067a27d8b9d7ab5</data>
      <data key="d11">f64d0be92a574e488686ae7da6a3e6e9</data>
      <data key="d12">2995</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRATADO DE NUTRICI&#211;N" target="NUTRICI&#211;N EN EL ADULTO">
      <data key="d8">6.0</data>
      <data key="d9">The topic of adult nutrition is discussed in the comprehensive work on nutrition edited by Gil Hern&#225;ndez</data>
      <data key="d10">8778654a17a48b8ea7b1cec378d52346</data>
      <data key="d11">fce62394611d45659cce26f67a971b3a</data>
      <data key="d12">2996</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VIDEOENDOSCOPIA" target="UFDOF">
      <data key="d8">8.0</data>
      <data key="d9">Videoendoscopy is one of the instrumental techniques utilized by UFDOF to assess swallowing function.</data>
      <data key="d10">d8fa59c6af96b4ebb96f2c6b4ddb5473</data>
      <data key="d11">59472731079f437b8127eff4ab98e3a9</data>
      <data key="d12">2997</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EDITORIAL M&#201;DICA PANAMERICANA" target="DEL OLMO GARC&#205;A D.">
      <data key="d8">7.0</data>
      <data key="d9">Del Olmo Garc&#237;a D. es un autor que ha publicado obras a trav&#233;s de la Editorial M&#233;dica Panamericana</data>
      <data key="d10">2def4be9506db96f8bdfe9e3ba6f9b6f</data>
      <data key="d11">f63a7bc66afb4686838df416763be63e</data>
      <data key="d12">2998</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EDITORIAL M&#201;DICA PANAMERICANA" target="S&#193;NCHEZ DE MEDINA CONTRERAS">
      <data key="d8">8.0</data>
      <data key="d9">S&#225;nchez de Medina Contreras is the editor of the book published by Editorial M&#233;dica Panamericana.</data>
      <data key="d10">57ec3d3d82d22e19c09ea2b735ef7779</data>
      <data key="d11">a9d3b037cfc0439ab5299a82f18bc8ae</data>
      <data key="d12">2999</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EDITORIAL M&#201;DICA PANAMERICANA" target="TOMOS V">
      <data key="d8">8.0</data>
      <data key="d9">Editorial M&#233;dica Panamericana published Tomo V</data>
      <data key="d10">8bcd338de10fbee8f3c808cc30b69b25</data>
      <data key="d11">169f91b5335240aeaa11823e2c0b4613</data>
      <data key="d12">3000</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EDITORIAL M&#201;DICA PANAMERICANA" target="NUTRICI&#211;N EN PACIENTE QUIR&#218;RGICO">
      <data key="d8">9.0</data>
      <data key="d9">Editorial M&#233;dica Panamericana published the book 'Tratado de Nutrici&#243;n' which contains the chapter 'Nutrici&#243;n en paciente quir&#250;rgico'.</data>
      <data key="d10">0b02ff4978fb09a0b2a360ae8c661337</data>
      <data key="d11">69533eac69f3415ea970ca213fc67a29</data>
      <data key="d12">3001</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN SOCIETY FOR SWALLOWING DISORDERS" target="VFS">
      <data key="d8">8.0</data>
      <data key="d9">The ESSD provides guidelines for the use of VFS in the diagnosis of swallowing disorders</data>
      <data key="d10">be410757354948d16ee86e49a852101c</data>
      <data key="d11">d5a982d679da4836a4a864b6f9adf8ea</data>
      <data key="d12">3002</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN SOCIETY FOR SWALLOWING DISORDERS" target="VED">
      <data key="d8">8.0</data>
      <data key="d9">The ESSD establishes standards for the use of VED in evaluating swallowing disorders</data>
      <data key="d10">be410757354948d16ee86e49a852101c</data>
      <data key="d11">27eccdf97c8a4fbdb10b6cdad528be35</data>
      <data key="d12">3003</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EUROPEAN SOCIETY FOR SWALLOWING DISORDERS" target="INTERNATIONAL DYSPHAGIA DIET STANDARDISATION INITIATIVE">
      <data key="d8">7.0</data>
      <data key="d9">The IDDSI was initiated following a meeting held by the ESSD in 2012 to address dysphagia treatment standards</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">5a6336a4219a4385a6aeddab4e55f3ad</data>
      <data key="d12">3004</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SUSAN LANGMORE" target="VFS">
      <data key="d8">9.0</data>
      <data key="d9">Dr. Susan Langmore's work contributed to the development and standardization of VFS for diagnosing swallowing disorders</data>
      <data key="d10">be410757354948d16ee86e49a852101c</data>
      <data key="d11">165959cf105e4fed9e862c72a1c1eb04</data>
      <data key="d12">3005</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SUSAN LANGMORE" target="FIBROSCOPIOS">
      <data key="d8">1.0</data>
      <data key="d9">Dr. Susan Langmore utilized fibroscopes for her explorations in swallowing evaluation</data>
      <data key="d10">be410757354948d16ee86e49a852101c</data>
      <data key="d11">dd5c7a7915d144fbaec27f54a1ae9cd7</data>
      <data key="d12">3006</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VFS" target="VED">
      <data key="d8">6.0</data>
      <data key="d9">VFS and VED are complementary diagnostic tests used in the assessment of swallowing disorders</data>
      <data key="d10">be410757354948d16ee86e49a852101c</data>
      <data key="d11">922dd498dc394848bbe22961eb9f3312</data>
      <data key="d12">3007</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VFS" target="RADIACI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">Radiation exposure is a critical consideration during the VFS procedure, requiring adherence to safety protocols.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">7cb0de59e6e2424cb59ce27443ac2c5b</data>
      <data key="d12">3008</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VFS" target="C&#193;MARA">
      <data key="d8">9.0</data>
      <data key="d9">The camera is an essential component of the VFS, used to visualize and record the swallowing process.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">20b8b5b69afd4c9b8db5a0667a665165</data>
      <data key="d12">3009</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VFS" target="EQUIPO DE ATENCI&#211;N M&#201;DICA">
      <data key="d8">8.0</data>
      <data key="d9">The medical care team conducts the VFS and must follow safety protocols to minimize radiation exposure.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">d8414427219c4d67ad583759ba564e69</data>
      <data key="d12">3010</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VFS" target="FLUOROSCOPIA">
      <data key="d8">8.0</data>
      <data key="d9">Fluoroscopy is the imaging technique used during the VFS to visualize the swallowing process in real-time.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">2fb7e2f1d3424f52a4b5e170b6aec839</data>
      <data key="d12">3011</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VFS" target="TUBO DE RAYOS">
      <data key="d8">9.0</data>
      <data key="d9">The X-ray tube is a critical component of the VFS system, providing the necessary X-rays for imaging.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">aca81106c0d9436483538faf8c99fec4</data>
      <data key="d12">3012</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VFS" target="SILLAS ESPECIALIZADAS">
      <data key="d8">6.0</data>
      <data key="d9">Specialized chairs are utilized to accommodate patients during the VFS, ensuring proper positioning for accurate imaging.</data>
      <data key="d10">38a83c2ae0b0c378bfcaba5d18866dc0</data>
      <data key="d11">4fcba6e0634247c48f3eda1ea21f34e0</data>
      <data key="d12">3013</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VFS" target="CIPLINARES">
      <data key="d8">7.0</data>
      <data key="d9">Ciplinares utilizes VFS to analyze the oral phase of swallowing</data>
      <data key="d10">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d11">fb17c2f2ea3e4989b3cf7193d50b7348</data>
      <data key="d12">3014</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="PACIENTE">
      <data key="d8">8.0</data>
      <data key="d9">The patient is the subject undergoing the VED exploration to assess swallowing capabilities.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">e5ae90641e7a4ea194102b8193b1db70</data>
      <data key="d12">3015</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="VIDEOENDOSCOPIO">
      <data key="d8">9.0</data>
      <data key="d9">The videoendoscope is the instrument used during the VED to visualize the anatomical structures involved in swallowing.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">f38611b5fb3b49b5ae73b0e8c2f139e1</data>
      <data key="d12">3016</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="BASE DE LA LENGUA">
      <data key="d8">1.0</data>
      <data key="d9">The base of the tongue is evaluated during the VED to determine its function in swallowing.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">911dc20f624141ecbe76e88efc87af83</data>
      <data key="d12">3017</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="PAQUIDERMIA INTERARITENOIDEA">
      <data key="d8">5.0</data>
      <data key="d9">Paquidermia interaritenoidea is evaluated during the VED as an indirect sign of reflux affecting swallowing.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">21305b7994fa47658be2aea0a372f611</data>
      <data key="d12">3018</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="CONSTRICTORES FAR&#205;NGEOS">
      <data key="d8">6.0</data>
      <data key="d9">The constrictores far&#237;ngeos are assessed during the VED to evaluate their role in the swallowing process.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">833c47030841441899385ef8f041927e</data>
      <data key="d12">3019</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="MANIOBRA DE VALSALVA">
      <data key="d8">7.0</data>
      <data key="d9">The maniobra de Valsalva is performed during the VED to assess the function of the laryngeal structures.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">9f6014d9c87644a1aa76a8ea2d447924</data>
      <data key="d12">3020</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="FONEMAS VELARES OCLUSIVOS">
      <data key="d8">6.0</data>
      <data key="d9">The fonemas velares oclusivos are used during the VED to evaluate the mobility of the velum.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">976a8988a2a94f698fbdcbc0e628ee7c</data>
      <data key="d12">3021</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="DEGLUCIONES SECAS">
      <data key="d8">1.0</data>
      <data key="d9">Degluciones secas are observed during the VED to assess the patient's swallowing function.</data>
      <data key="d10">23e28a69f275d88d0a56a430dde4b568</data>
      <data key="d11">c2291d38f1694d9cb24d32c86de54b90</data>
      <data key="d12">3022</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VED" target="CIPLINARES">
      <data key="d8">1.0</data>
      <data key="d9">Ciplinares utilizes VED to evaluate the swallowing process</data>
      <data key="d10">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d11">4de76498860e46c4bdab08a0e65ccdc0</data>
      <data key="d12">3023</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LANGMORE" target="ENDOSCOPIC EVALUATION AND TREATMENT OF SWALLOWING DISORDERS">
      <data key="d8">9.0</data>
      <data key="d9">Dr. Langmore authored the book that serves as a key reference for swallowing disorders</data>
      <data key="d10">a76f6268d6065b1baabb9e13ef7f098c</data>
      <data key="d11">bf844eb3f20946ccb69dba6575aee888</data>
      <data key="d12">3024</data>
      <data key="d13">2</data>
    </edge>
    <edge source="LANGMORE" target="VIDEOENDOSCOPIC EXPLORATION">
      <data key="d8">7.0</data>
