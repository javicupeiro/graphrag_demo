      <data key="d0">PERSON</data>
      <data key="d1">Refers to elderly patients, particularly those over 70 years old, who are more susceptible to oropharyngeal dysphagia.</data>
      <data key="d2">e34366e525fb1dbc8468a7f4e6d91cb7</data>
