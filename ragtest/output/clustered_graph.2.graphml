    <edge source="NUTRITIONAL RISK" target="ALBUMIN">
      <data key="d8">8.0</data>
      <data key="d9">Low serum albumin levels are indicative of nutritional risk and complications in surgical patients</data>
      <data key="d10">58ae94a34f90df368b032f1618c7bcec</data>
      <data key="d11">d61aa3d457ea4c3fae63a55377221e47</data>
      <data key="d12">11416</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL RISK" target="PCR">
      <data key="d8">7.0</data>
      <data key="d9">PCR levels can indicate inflammation and nutritional risk in patients undergoing surgery</data>
      <data key="d10">58ae94a34f90df368b032f1618c7bcec</data>
      <data key="d11">ba8d6707d5fe479e83756635236fcaac</data>
      <data key="d12">11417</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRITIONAL RISK" target="BMI">
      <data key="d8">8.0</data>
      <data key="d9">BMI is used to assess nutritional risk and determine the appropriate nutritional support for surgical patients</data>
      <data key="d10">58ae94a34f90df368b032f1618c7bcec</data>
      <data key="d11">e160b9ed0ff440239484ac28b2ef02cc</data>
      <data key="d12">11418</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GERIATRIC NUTRITIONAL RISK INDEX" target="NUTRITION SCREENING INITIATIVE">
      <data key="d8">4.0</data>
      <data key="d9">The Nutrition Screening Initiative includes the GNRI as part of its assessment tools for elderly nutrition</data>
