    </node>
    <node id="ALTERACIONES NUTRICIONALES">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional imbalances that are common in patients with FEC, contributing to morbidity and mortality.</data>
      <data key="d2">c031cb3bc7513b4a3f8e4f264c00a675</data>
      <data key="d3">656</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
