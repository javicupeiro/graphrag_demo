    </node>
    <node id="METABOLISMO LIP&#205;DICO">
      <data key="d0">EVENT</data>
      <data key="d1">Lipid metabolism is affected by chromium, which can lower total cholesterol and triglycerides.</data>
      <data key="d2">f43e3958f11ed24b0a02f60a2993309a</data>
