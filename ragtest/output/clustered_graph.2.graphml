    <node id="DIETA ODONTOLOGICA">
      <data key="d0">EVENT</data>
      <data key="d1">A diet designed for patients with dental issues, focusing on soft foods that are easy to chew and swallow.</data>
      <data key="d2">bd22bf95ac5fc6dc95539efb99c5b11a</data>
