    <node id="PEDITRACE&#174;">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Peditrace&#174; is a nutritional supplement containing trace elements for pediatric patients.</data>
      <data key="d2">a6e7937ce59bfc2b38e9ed2acf3e991c</data>
      <data key="d3">582</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
