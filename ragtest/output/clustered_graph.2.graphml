    </edge>
    <edge source="MUST" target="FIGHT MALNUTRITION">
      <data key="d8">1.0</data>
      <data key="d9">Fight Malnutrition promotes the use of tools like MUST to assess and combat malnutrition</data>
      <data key="d10">005b22fc9dae5f9b135f0c8ba729819f</data>
      <data key="d11">52b0c48fdf384919998b62d45a1b5450</data>
      <data key="d12">5592</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MUST" target="NUTRITION 2003">
      <data key="d8">8.0</data>
      <data key="d9">The publication discusses the development and validation of the Malnutrition Universal Screening Tool (MUST)</data>
      <data key="d10">005b22fc9dae5f9b135f0c8ba729819f</data>
      <data key="d11">d5fbd9063b7f4f23ae4c9bb25ae8a571</data>
