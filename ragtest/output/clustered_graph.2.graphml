    <edge source="IPILIMUMAB" target="YERVOY">
      <data key="d8">8.0</data>
      <data key="d9">Yervoy contains ipilimumab as its active ingredient</data>
      <data key="d10">af95ffa2f3eaddc28a86d59cd2d89415</data>
      <data key="d11">aaa0217ba5b54b1398e67e441675f787</data>
      <data key="d12">12731</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VERAPAMILO" target="NIMODIPINO">
      <data key="d8">8.0</data>
      <data key="d9">Nimodipino and Verapamilo are both calcium channel blockers used to treat cardiovascular conditions.</data>
      <data key="d10">1ff94f3fcc6eff16c2fdae5eb9b3aefa</data>
      <data key="d11">7fe0bb0dd5a7490e9f1d2a66fef843f0</data>
