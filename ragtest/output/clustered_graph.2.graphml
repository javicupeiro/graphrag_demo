    <node id="RECETA">
      <data key="d0">EVENT</data>
      <data key="d1">A recipe is a detailed guide that outlines the specific ingredients and their quantities for creating a clinical nutrition product.</data>
      <data key="d2">3d73ef14929e7391e915f739189e4dfa</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
