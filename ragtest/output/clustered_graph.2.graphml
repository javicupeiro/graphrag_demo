    <node id="FRAGILIDAD COGNITIVA">
      <data key="d0">EVENT</data>
      <data key="d1">Cognitive frailty is a concept related to vulnerability to developing established dementia, often associated with preclinical stages of cognitive decline.</data>
      <data key="d2">b5f705e0ba650f5ad1f558446be0191e</data>
