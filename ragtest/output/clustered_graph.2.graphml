    </node>
    <node id="VOMITING">
      <data key="d0">EVENT</data>
      <data key="d1">Vomiting is another side effect noted in subjects taking liraglutida, occurring in a smaller proportion of participants.</data>
      <data key="d2">90c684dca4542bbe1177afd26e78581e</data>
      <data key="d3">740</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
