      <data key="d13">2</data>
    </edge>
    <edge source="SOY FORMULAS" target="SUCRASE-ISOMALTASE DEFICIENCY">
      <data key="d8">5.0</data>
      <data key="d9">Soy formulas may not be suitable for infants with sucrase-isomaltase deficiency due to their sugar content.</data>
