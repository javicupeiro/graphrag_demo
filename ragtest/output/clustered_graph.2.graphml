      <data key="d7">acc133c843cc4d6bb64470ecebf14f5a</data>
    </node>
    <node id="S&#205;NDROME DE MUERTE S&#218;BITA DEL LACTANTE">
      <data key="d0">EVENT</data>
      <data key="d1">S&#237;ndrome de muerte s&#250;bita del lactante (SIDS) is the sudden unexplained death of an infant, which has been associated with breastfeeding practices.</data>
