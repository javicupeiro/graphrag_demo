    </node>
    <node id="NUTRIENTES ANTIINFLAMATORIOS">
      <data key="d0">EVENT</data>
      <data key="d1">Anti-inflammatory nutrients include fiber, vitamins, minerals, and antioxidants that contribute to reducing inflammation in the body.</data>
      <data key="d2">72d0be9d03c79097f867a8af2e3e89e4</data>
      <data key="d3">1379</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">7348</data>
      <data key="d7">94203d72ecba44e08aca5c429609e4aa</data>
    </node>
    <node id="NUTRIENTES PROINFLAMATORIOS">
      <data key="d0">EVENT</data>
      <data key="d1">Pro-inflammatory nutrients include refined sugars, starches, trans fats, and high-calorie density foods that can exacerbate inflammation.</data>
      <data key="d2">72d0be9d03c79097f867a8af2e3e89e4</data>
      <data key="d3">1379</data>
      <data key="d4">2</data>
