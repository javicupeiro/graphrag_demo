    </node>
    <node id="EMERGENCIA">
      <data key="d0">EVENT</data>
      <data key="d1">La inserci&#243;n de cat&#233;teres venosos centrales en situaciones de emergencia puede aumentar el riesgo de complicaciones, incluyendo infecciones</data>
