      <data key="d8">8.0</data>
      <data key="d9">FESNAD 2010 provides dietary intake recommendations specifically for older adults aged 60-69 years.</data>
      <data key="d10">8ebb2b77b6f63f52544326a7ea94df61</data>
      <data key="d11">ff35c610a6f34b53b71bff30ecf21c13</data>
      <data key="d12">18764</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FESNAD 2010" target="70 A&#209;OS">
      <data key="d8">1.0</data>
      <data key="d9">FESNAD 2010 provides dietary intake recommendations specifically for older adults aged 70 years and above.</data>
      <data key="d10">8ebb2b77b6f63f52544326a7ea94df61</data>
      <data key="d11">e6cc8be2ecd443869375fd1001900316</data>
      <data key="d12">18765</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GARBANZOS" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">7.0</data>
      <data key="d9">Garbanzos are recommended as a source of iron in pediatric nutrition</data>
      <data key="d10">e742c891694171ad455b038f416b7728</data>
      <data key="d11">03af6a4e218a4895bc612d05f0499e68</data>
      <data key="d12">18766</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CANADA" target="BANS">
      <data key="d8">3.0</data>
      <data key="d9">Canada and the United Kingdom both have registries that report on NPD prevalence</data>
      <data key="d10">efc0b55f4e91f02e4708b7cc43c64608</data>
      <data key="d11">4b38579d79fd4a16a828ed38aeb2045a</data>
      <data key="d12">18767</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BRYANT RJ" target="PHILLIPS SM">
      <data key="d8">5.0</data>
      <data key="d9">Both Phillips SM and Bryant RJ are researchers who have published studies related to nutrition and exercise</data>
      <data key="d10">34f5f2681b28d568aea92e2633ebae56</data>
      <data key="d11">e7d56f760b154b5a8a901cb52c8d12ab</data>
      <data key="d12">18768</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BRYANT RJ" target="TAKANAMI Y">
      <data key="d8">5.0</data>
      <data key="d9">Both Bryant RJ and Takanami Y have studied the effects of vitamin supplementation on exercise performance</data>
      <data key="d10">34f5f2681b28d568aea92e2633ebae56</data>
      <data key="d11">6604aec39b48476786bb1547812b2ecf</data>
      <data key="d12">18769</data>
      <data key="d13">2</data>
    </edge>
    <edge source="BRYANT RJ" target="STRENGTH &amp; CONDITIONING RESEARCH">
      <data key="d8">5.0</data>
      <data key="d9">Bryant RJ's research on vitamin supplementation has been featured in Strength &amp; Conditioning Research</data>
      <data key="d10">34f5f2681b28d568aea92e2633ebae56</data>
      <data key="d11">7ca0477ce6c7422a86aee7242d96e270</data>
      <data key="d12">18770</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="SANGRADO UTERINO">
      <data key="d8">8.0</data>
      <data key="d9">Uterine bleeding is a significant cause of iron deficiency anemia, particularly in women</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">6b6fe29a86064ad8acb36c3a23e0e22a</data>
      <data key="d12">18771</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="ULCUS GASTRODUODENAL">
      <data key="d8">7.0</data>
      <data key="d9">Gastro-duodenal ulcers can lead to bleeding, contributing to iron deficiency anemia</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">5408ca9e973843d3bf89713c5033eea6</data>
      <data key="d12">18772</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="HEMORROIDES">
      <data key="d8">6.0</data>
      <data key="d9">Hemorrhoids can cause bleeding, which is a contributing factor to iron deficiency anemia</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">e7b39edea45a4f78a40f870326a10476</data>
      <data key="d12">18773</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="GASTRECTOM&#205;A">
      <data key="d8">5.0</data>
      <data key="d9">Gastrectomy can lead to malabsorption of iron, contributing to iron deficiency anemia</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">9fc448569f7046a69aea65a759f953e3</data>
      <data key="d12">18774</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="ACLORHIDRIA">
      <data key="d8">6.0</data>
      <data key="d9">Aclorhidria can lead to malabsorption of iron, contributing to iron deficiency anemia</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">1109f0c1a397426aa838ff7183e96eed</data>
      <data key="d12">18775</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="DIVERTICULOSIS">
      <data key="d8">6.0</data>
      <data key="d9">Diverticulosis can cause gastrointestinal bleeding, which is a contributing factor to iron deficiency anemia</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">045c773cb81c498d84381bd184b0451f</data>
      <data key="d12">18776</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="ANGIODISPLASIA">
      <data key="d8">6.0</data>
      <data key="d9">Angiodysplasia can lead to gastrointestinal bleeding, contributing to iron deficiency anemia</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">38be4048ac8848b3bebff3bf5ec0c222</data>
      <data key="d12">18777</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="POLIPOSIS">
      <data key="d8">1.0</data>
      <data key="d9">Polyposis can lead to bleeding in the gastrointestinal tract, contributing to iron deficiency anemia</data>
      <data key="d10">6595cec039fe5a2c290eea9ab7e3b2fc</data>
      <data key="d11">9a2f76276f2f4441bbd8a78a5c03f37c</data>
      <data key="d12">18778</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="PLUMMER-VINSON SYNDROME">
      <data key="d8">7.0</data>
      <data key="d9">Anemia ferrop&#233;nica can lead to the development of Plummer-Vinson syndrome in severe cases</data>
      <data key="d10">b65e3955444a7fb402ab92a8ae46311b</data>
      <data key="d11">4493b030b98e46369ee69e3bb00c3141</data>
      <data key="d12">18779</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="HEMOGLOBINA">
      <data key="d8">1.0</data>
      <data key="d9">The diagnosis of anemia ferrop&#233;nica is often based on low hemoglobin levels</data>
      <data key="d10">b65e3955444a7fb402ab92a8ae46311b</data>
      <data key="d11">d00581987f2d4a3692b1a1fdeeb0f779</data>
      <data key="d12">18780</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="MUCOSAS">
      <data key="d8">6.0</data>
      <data key="d9">Iron deficiency can lead to alterations in the mucosas, such as glossitis and angular cheilitis</data>
      <data key="d10">b65e3955444a7fb402ab92a8ae46311b</data>
      <data key="d11">5abb0ee814194bf1af0179dc23ae4e0b</data>
      <data key="d12">18781</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="GLANDULAS">
      <data key="d8">1.0</data>
      <data key="d9">Glandular functions can be affected by iron deficiency, contributing to the symptoms of anemia ferrop&#233;nica</data>
      <data key="d10">b65e3955444a7fb402ab92a8ae46311b</data>
      <data key="d11">116d553294c04f6182305dca8d3b1b8c</data>
      <data key="d12">18782</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="SULFATO FERROSO">
      <data key="d8">9.0</data>
      <data key="d9">Sulfato ferroso is commonly prescribed to treat anemia ferrop&#233;nica by replenishing iron levels</data>
      <data key="d10">79435b6ab45648695f4a36f31b7fb458</data>
      <data key="d11">f1e638bf9423470399a38aaaa6d1f515</data>
      <data key="d12">18783</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="COLONOSCOPIA">
      <data key="d8">5.0</data>
      <data key="d9">Colonoscopy may be used to identify gastrointestinal bleeding or other issues related to anemia ferrop&#233;nica</data>
      <data key="d10">79435b6ab45648695f4a36f31b7fb458</data>
      <data key="d11">36508b24cb424c2c9c6258c13ebc8a30</data>
      <data key="d12">18784</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="TOMOGRAF&#205;A COMPUTARIZADA">
      <data key="d8">1.0</data>
      <data key="d9">Tomograf&#237;a computarizada can help diagnose underlying conditions that may contribute to anemia ferrop&#233;nica</data>
      <data key="d10">79435b6ab45648695f4a36f31b7fb458</data>
      <data key="d11">c42dfb1de92449c8bfbf74a73cdc48d7</data>
      <data key="d12">18785</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="TROMBOCITOSIS">
      <data key="d8">5.0</data>
      <data key="d9">Trombocitosis can occur as a response to anemia ferrop&#233;nica, particularly in cases of active bleeding</data>
      <data key="d10">79435b6ab45648695f4a36f31b7fb458</data>
      <data key="d11">12b542f7bca84980aa19b58cc4c6575c</data>
      <data key="d12">18786</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="FIBROCOLONOSCOPIA">
      <data key="d8">1.0</data>
      <data key="d9">Fibrocolonoscopia may be indicated to investigate causes of anemia ferrop&#233;nica related to gastrointestinal bleeding</data>
      <data key="d10">79435b6ab45648695f4a36f31b7fb458</data>
      <data key="d11">4cfe4ec6f2654f50975527ca7835faa0</data>
      <data key="d12">18787</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="ALERGIA">
      <data key="d8">1.0</data>
      <data key="d9">La anemia ferrop&#233;nica puede ser consecuencia de la p&#233;rdida de sangre en heces debido a reacciones al&#233;rgicas.</data>
      <data key="d10">693b5721c7fc52c8165c48b580777840</data>
      <data key="d11">2ee0e09f954743238fe2e16be50ec7b4</data>
      <data key="d12">18788</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="DEPORTISTAS">
      <data key="d8">8.0</data>
      <data key="d9">Los deportistas son propensos a la anemia ferrop&#233;nica debido a la deficiencia de hierro, lo que afecta su rendimiento f&#237;sico.</data>
      <data key="d10">700a4472a23342b891a5685b622437d2</data>
      <data key="d11">db37fa86ab8c45a38aefa017f71f8c56</data>
      <data key="d12">18789</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA FERROP&#201;NICA" target="FORMULAS PARA LACTANTES">
      <data key="d8">7.0</data>
      <data key="d9">La sustituci&#243;n de la leche materna por leche de vaca puede llevar al desarrollo de anemia ferrop&#233;nica en los lactantes.</data>
      <data key="d10">056e169253fe046c2922537bb79ba187</data>
      <data key="d11">7eb6515b4ef84af78a89949eabf25be4</data>
      <data key="d12">18790</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ACLORHIDRIA" target="MALABSORCION DE HIERRO">
      <data key="d8">7.0</data>
      <data key="d9">Aclorhidria can lead to malabsorption of iron, affecting overall iron levels</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">c6373211b6fe4b2a99f1c1395e1ebf24</data>
      <data key="d12">18791</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TOMOGRAF&#205;A COMPUTARIZADA" target="EPOC">
      <data key="d8">1.0</data>
      <data key="d9">High-resolution computed tomography is used to diagnose EPOC and evaluate the extent of lung damage</data>
      <data key="d10">b62146237c90c7a018b9a3d2c060c722</data>
      <data key="d11">5a773beed7b94ff296ec2237b8f8f83b</data>
      <data key="d12">18792</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMEA" target="HIERRO CARBOXIMALTOSA">
      <data key="d8">7.0</data>
      <data key="d9">Iron carboxymaltose is approved by EMEA for use in treating iron deficiency</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">f3de5dcd7f2d4d1182ef3b32e1c54683</data>
      <data key="d12">18793</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMEA" target="HIERRO SACA-ROSA">
      <data key="d8">6.0</data>
      <data key="d9">Iron saccharate is one of the intravenous iron preparations evaluated by EMEA</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">6af6c2b3f32647a5bdbb9a75d6bb5dfc</data>
      <data key="d12">18794</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMEA" target="TEDUGLUTIDA">
      <data key="d8">9.0</data>
      <data key="d9">The EMEA approved teduglutida for use in Europe in December 2012</data>
      <data key="d10">e0196a8a0ead0a27b38ddfb16a5c5772</data>
      <data key="d11">8e854bc829d5490f81423b11cec0ea7c</data>
      <data key="d12">18795</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALABSORCION DE HIERRO" target="NI&#209;OS LACTANTES">
      <data key="d8">6.0</data>
      <data key="d9">Infants may experience iron malabsorption, necessitating careful dietary management</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">79f0bc74054d4588bfe6c482c3564f81</data>
      <data key="d12">18796</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALABSORCION DE HIERRO" target="ENFERMEDAD DE RENDU-OSLER">
      <data key="d8">5.0</data>
      <data key="d9">Rendu-Osler disease can lead to complications that may result in iron malabsorption</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">beb0af6ef819406a88ec30a07ba8d1ab</data>
      <data key="d12">18797</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALABSORCION DE HIERRO" target="RESECCIONES INTESTINALES">
      <data key="d8">8.0</data>
      <data key="d9">Intestinal resections can cause malabsorption of iron, leading to potential anemia</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">b3b42cee637a4765a3e697741d506d87</data>
      <data key="d12">18798</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NI&#209;OS LACTANTES" target="CARNES Y PESCADOS">
      <data key="d8">7.0</data>
      <data key="d9">Introducing meat and fish to infants after six months is important for iron intake</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">f48b5a2c85b24ab3a295d48ed5788acd</data>
      <data key="d12">18799</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NI&#209;OS LACTANTES" target="FORMULAS INFANTILES">
      <data key="d8">8.0</data>
      <data key="d9">Infant formulas fortified with iron are recommended for infants who do not receive breast milk</data>
      <data key="d10">7db70a783ce99dcbd067aa16de5d8059</data>
      <data key="d11">23c9340119d441f1af0f1bc6cc7d0261</data>
      <data key="d12">18800</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA MATERNA" target="DEFICIT DE HIERRO">
      <data key="d8">8.0</data>
      <data key="d9">Iron deficiency is a leading cause of maternal anemia, affecting the health of pregnant women and their newborns</data>
      <data key="d10">868defec6ca59b677cc97ac9a6b777bd</data>
      <data key="d11">6921238d185c483ba0bcffca5af1fb2c</data>
      <data key="d12">18801</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ANEMIA MATERNA" target="TRATAMIENTO CON HIERRO">
      <data key="d8">9.0</data>
      <data key="d9">Iron treatment is essential for managing maternal anemia and improving health outcomes for pregnant women</data>
      <data key="d10">868defec6ca59b677cc97ac9a6b777bd</data>
      <data key="d11">e0e2c5b6dc2b471689bd35375cdfaa94</data>
      <data key="d12">18802</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GEN HFE" target="MUTACI&#211;N C282Y">
      <data key="d8">7.0</data>
      <data key="d9">C282Y is a specific mutation found in the HFE gene associated with hemochromatosis</data>
      <data key="d10">2eeab2238556165bbea897f24c5b1c7a</data>
      <data key="d11">c80068e1fb77449f8f731987c1588a61</data>
      <data key="d12">18803</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MUTACI&#211;N C282Y" target="SOBRECARGA F&#201;RRICA">
      <data key="d8">7.0</data>
      <data key="d9">La mutaci&#243;n C282Y est&#225; asociada con la hemocromatosis, que causa sobrecarga f&#233;rrica.</data>
      <data key="d10">68c1e1d1d60cf84e8ba37450cd6dc7d3</data>
      <data key="d11">7c7235535e7f4df1b36e115e8a2ec5c7</data>
      <data key="d12">18804</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MUTACI&#211;N H63D" target="SOBRECARGA F&#201;RRICA">
      <data key="d8">1.0</data>
      <data key="d9">La mutaci&#243;n H63D puede contribuir a la hemocromatosis y, por ende, a la sobrecarga f&#233;rrica.</data>
      <data key="d10">68c1e1d1d60cf84e8ba37450cd6dc7d3</data>
      <data key="d11">4c6c304d6c1c496d8463c77b39e8c8b5</data>
      <data key="d12">18805</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HIERRO NO HEMO" target="&#193;CIDO ASC&#211;RBICO">
      <data key="d8">6.0</data>
      <data key="d9">El &#225;cido asc&#243;rbico aumenta la absorci&#243;n del hierro no hemo en la dieta</data>
      <data key="d10">49058309baf3bb1fadf8956dd9ed0e89</data>
      <data key="d11">5367d0db4dad49b68992f159e3bf9b08</data>
      <data key="d12">18806</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HFE" target="HEMOCHROMATOSIS">
      <data key="d8">9.0</data>
      <data key="d9">The HFE gene is directly related to the pathogenesis of hereditary hemochromatosis, as mutations in this gene lead to the disease</data>
      <data key="d10">e376d9f50b7608f5b6d1f88877fde59e</data>
      <data key="d11">3b6dd56530224a7b84115ef0e208e4e9</data>
      <data key="d12">18807</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MACR&#211;FAGOS" target="ENFERMEDADES INFLAMATORIAS INTESTINALES">
      <data key="d8">1.0</data>
      <data key="d9">Los macr&#243;fagos son estimulados en el contexto de enfermedades inflamatorias intestinales, lo que sugiere su papel en la respuesta inmune.</data>
      <data key="d10">df0e6695be23c07606ca5b9accc62df2</data>
      <data key="d11">49ae466b459c4374aa2edf264440be42</data>
      <data key="d12">18808</data>
      <data key="d13">2</data>
    </edge>
    <edge source="C282Y" target="HH">
      <data key="d8">9.0</data>
      <data key="d9">C282Y mutation is a key genetic factor in the development of hereditary hemochromatosis</data>
      <data key="d10">a3d834f1d854ecde12e808ae924b8eb0</data>
      <data key="d11">19e130b98c074ee99d8b2b9cf1241d09</data>
      <data key="d12">18809</data>
      <data key="d13">2</data>
    </edge>
