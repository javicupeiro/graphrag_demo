      <data key="d11">cb8cd0a7bd69497fb810348dbdaee7b8</data>
      <data key="d12">15079</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERPARATHYROIDISM" target="WORKSHOP">
