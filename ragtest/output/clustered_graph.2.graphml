    </node>
    <node id="CODIGO ALIMENTARIO">
      <data key="d0">EVENT</data>
      <data key="d1">The Codex Alimentarius is a collection of internationally recognized standards, guidelines, and codes of practice to ensure food safety and quality.</data>
      <data key="d2">1d8aa686c6377246fee05010ef969018</data>
