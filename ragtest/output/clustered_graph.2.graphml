      <data key="d6">1183</data>
      <data key="d7">f9b4234bc865447abab0e00c5efb4755</data>
    </node>
    <node id="SERVICIO DE REHABILITACI&#211;N">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Rehabilitation Service at HUPA provides therapeutic interventions for patients recovering from various conditions, including swallowing difficulties.</data>
      <data key="d2">eb2f276d3dc4e4a9e53923d9d80fec1a</data>
