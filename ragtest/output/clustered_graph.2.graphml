    </node>
    <node id="INT J OBESITY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The International Journal of Obesity published a meta-analysis on weight management using meal replacement strategies.</data>
      <data key="d2">0381a11415dca4cfeda74f1de745d6ae</data>
      <data key="d3">1580</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
