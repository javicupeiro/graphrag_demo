      <data key="d12">16750</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NAS" target="SODIUM INTAKE">
      <data key="d8">7.0</data>
      <data key="d9">NAS provides guidelines on sodium intake that are referenced in dietary recommendations</data>
      <data key="d10">7ff62e1dc423be2f4b2fe08546751d0d</data>
