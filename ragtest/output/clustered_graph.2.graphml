      <data key="d5">1</data>
      <data key="d6">4006</data>
      <data key="d7">45684c6485d441cfaa24450fb1eafe51</data>
    </node>
    <node id="DENSIDAD URINARIA">
      <data key="d0">EVENT</data>
      <data key="d1">Urinary density is a measure of urine concentration, which is relevant in the assessment of diabetes ins&#237;pida.)&lt;|COMPLETE|&gt;</data>
