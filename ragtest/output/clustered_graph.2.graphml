    <node id="AMERICAN ASSOCIATION FOR PARENTERAL AND ENTERAL NUTRITION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The American Association for Parenteral and Enteral Nutrition (ASPEN) is an organization that focuses on improving patient care by advancing the science and practice of nutrition support therapy.</data>
      <data key="d2">73fd366244763cef4b13c058330147b1</data>
      <data key="d3">911</data>
