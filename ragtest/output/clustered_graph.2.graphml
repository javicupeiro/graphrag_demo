    <node id="NAT REV ENDOCRINOL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Nature Reviews Endocrinology is a journal that published a consensus statement on caring for individuals with differences of sex development.</data>
      <data key="d2">bc241ef500af250c0f0e0253bf5ae0f2</data>
