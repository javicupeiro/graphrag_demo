    </edge>
    <edge source="GLUCOGENOSIS" target="VON GIERKE TYPE IA">
      <data key="d8">5.0</data>
      <data key="d9">Von Gierke Type Ia is a specific type of glucogenosis characterized by severe metabolic complications due to enzyme deficiency.</data>
      <data key="d10">76287e9b94faab94755c56fead3541d7</data>
      <data key="d11">c31da4e3f5e34ccf9fe8c853af4a9ba2</data>
