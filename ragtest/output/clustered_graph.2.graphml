    <node id="APNEA OBSTRUCTIVA DEL SUE&#209;O">
      <data key="d0">EVENT</data>
      <data key="d1">Obstructive sleep apnea is a potentially serious sleep disorder in which breathing repeatedly stops and starts during sleep.</data>
