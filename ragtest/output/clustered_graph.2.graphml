    <node id="GRAVES DISEASE">
      <data key="d0">EVENT</data>
      <data key="d1">Graves disease is the most common cause of hyperthyroidism during pregnancy, affecting thyroid function.</data>
      <data key="d2">45213238a7d4c834b6db62ef71dcda43</data>
