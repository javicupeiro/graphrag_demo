      <data key="d10">306519cca8810e0ff1c973128a75200a</data>
      <data key="d11">b9dd3d36c0c244d3b9aabb423b9195e0</data>
      <data key="d12">6820</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N ARTIFICIAL" target="TOLVAPT&#193;N">
      <data key="d8">8.0</data>
      <data key="d9">Tolvapt&#225;n is used as a treatment for hyponatremia in patients receiving artificial nutrition</data>
      <data key="d10">306519cca8810e0ff1c973128a75200a</data>
      <data key="d11">a60b574a7d4d4c368e7a8587220434bf</data>
      <data key="d12">6821</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N ARTIFICIAL" target="HIPO-NATREMIA">
      <data key="d8">5.0</data>
