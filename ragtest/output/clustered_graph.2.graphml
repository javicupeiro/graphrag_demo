      <data key="d7">29029b73abe942a7a072e7bb9266d61f</data>
    </node>
    <node id="HIDRATACI&#211;N INTRAVENOSA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">La hidrataci&#243;n intravenosa es un tratamiento utilizado en pacientes con pancreatitis aguda para mantener el equilibrio de l&#237;quidos y electrolitos.</data>
      <data key="d2">caf14765027dbf6266841af0571a522e</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12249</data>
      <data key="d7">5ee740c2867344c68e06ea3587c27127</data>
    </node>
    <node id="DISFUNCI&#211;N ORG&#193;NICA M&#218;LTIPLE">
      <data key="d0">EVENT</data>
      <data key="d1">A condition where multiple organs do not function properly, often seen in severe cases of acute pancreatitis</data>
      <data key="d2">f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12250</data>
      <data key="d7">1192a21356b544b4be10b91ede15aa8c</data>
    </node>
    <node id="CORTISOL PLASM&#193;TICO">
      <data key="d0">EVENT</data>
      <data key="d1">A hormone that increases in response to stress, often elevated in patients with severe acute pancreatitis</data>
      <data key="d2">f5ac70db902f1361fd681d1d109828c0</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">12251</data>
      <data key="d7">d1221d4843b24b5ea0698b34ae242db8</data>
    </node>
    <node id="HEPATIC STEATOSIS">
      <data key="d0">EVENT</data>
      <data key="d1">Hepatic steatosis, or fatty liver, can develop in patients with pancreatitis due to excessive glucose administration.</data>
      <data key="d2">46bc44144e19709e2d7f9838c9c54ccf</data>
      <data key="d3">1717</data>
      <data key="d4">2</data>
