    <node id="GH TRAS GLUCAG&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">GH tras glucag&#243;n refers to a specific test used to evaluate growth hormone levels in patients, particularly after administration of glucagon.</data>
      <data key="d2">593ae586183f02d2611966f8a1603e5d</data>
      <data key="d3">1080</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
