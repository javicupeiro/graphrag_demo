      <data key="d8">8.0</data>
      <data key="d9">The Manual de Endocrinolog&#237;a y Nutrici&#243;n provides essential guidelines and recommendations for nutrition during pregnancy.</data>
      <data key="d10">03b7a89c9bb1dfd115acef377b491808</data>
      <data key="d11">0b12903c293d4d4aa754779871bdb1b8</data>
      <data key="d12">717</data>
