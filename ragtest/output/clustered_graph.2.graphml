    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="EUROPEAN SOCIETY OF PARENTERAL AND ENTERAL NUTRITION">
      <data key="d8">9.0</data>
      <data key="d9">The MUST tool is recommended by ESPEN for screening malnutrition in clinical practice</data>
      <data key="d10">628cd3e2664561301cbe6679f48c4bd3</data>
      <data key="d11">6dbdfa3876d54108913dd5bb4965b322</data>
      <data key="d12">3907</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="BRITISH ASSOCIATION OF PARENTERAL AND ENTERAL NUTRITION">
      <data key="d8">1.0</data>
