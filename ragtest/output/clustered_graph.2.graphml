    <edge source="DISFAGIA OROFAR&#205;NGEA" target="MONTSE MART&#205;NEZ LIEBANA">
      <data key="d8">8.0</data>
      <data key="d9">Montserrat Mart&#237;nez Liebana is a co-author contributing to the nutritional treatment of oropharyngeal dysphagia</data>
