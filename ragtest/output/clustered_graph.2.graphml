    <node id="NEUMON&#205;AS POR ASPIRACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Aspiration pneumonia is a serious complication that can arise from oropharyngeal dysphagia, leading to high mortality rates.</data>
      <data key="d2">ea0b88195d04b227bedf7fa3cb3b6513</data>
