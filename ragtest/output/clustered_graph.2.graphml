      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES" target="FUGAS A PERITONEO">
      <data key="d8">8.0</data>
      <data key="d9">Leaks into the peritoneum are serious complications associated with gastrostomy</data>
      <data key="d10">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d11">83387c6a86b04fc69a08e60124bcd949</data>
      <data key="d12">7799</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES" target="F&#205;STULAS GASTROC&#211;LICAS">
      <data key="d8">8.0</data>
      <data key="d9">Gastrocolic fistulas are complications that can develop as a result of gastrostomy procedures</data>
      <data key="d10">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d11">8d966026816d46bca486680a747b45fc</data>
      <data key="d12">7800</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES" target="DESCOLOCACI&#211;N INADVERTIDA DE LA SONDA">
      <data key="d8">8.0</data>
      <data key="d9">Inadvertent dislocation of the tube is a complication that can occur during gastrostomy</data>
      <data key="d10">c3d9237f72732f1f51141fa79be271c9</data>
      <data key="d11">0511a6717f9348b4ba840148b4f58fd4</data>
      <data key="d12">7801</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES" target="CIRUG&#205;A BARI&#193;TRICA">
      <data key="d8">8.0</data>
      <data key="d9">Las complicaciones son un riesgo asociado a la cirug&#237;a bari&#225;trica que se deben prevenir y tratar en el postoperatorio</data>
      <data key="d10">de5f304890ba39f7c9e3d5c0201bc247</data>
      <data key="d11">1c52cc98da6842f28be218f12863069a</data>
      <data key="d12">7802</data>
      <data key="d13">2</data>
    </edge>
    <edge source="COMPLICACIONES" target="ESTANCIA HOSPITALARIA">
      <data key="d8">8.0</data>
