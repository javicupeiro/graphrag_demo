    <node id="SLC5A1">
      <data key="d0">PERSON</data>
      <data key="d1">SLC5A1 is the gene that encodes the SGLT1 transporter, mutations in which cause glucose-galactose malabsorption.</data>
      <data key="d2">e329b5d4c64709889680df357bd1cc09</data>
