      <data key="d8">7.0</data>
      <data key="d9">The weight maintenance exercise is included in the exercises for enhancing lip muscle tone.</data>
      <data key="d10">1a8fb91a0e8102c906a3cb5c9cb35d41</data>
      <data key="d11">278dcab7346f4acaa94e0f66fc863701</data>
