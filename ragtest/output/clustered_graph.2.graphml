      <data key="d8">8.0</data>
      <data key="d9">Rafael L&#243;pez Urdiales is affiliated with Hospital Universitari de Bellvitge, contributing to the Unit of Nutrition and Dietetics</data>
      <data key="d10">ba4a819ecea2015fc907ed907767f6c5</data>
      <data key="d11">13418fef22584ea3b4361504f56ae6bf</data>
      <data key="d12">18615</data>
      <data key="d13">2</data>
    </edge>
