    <node id="FRAILIDAD">
      <data key="d0">EVENT</data>
      <data key="d1">Frailidad refers to the condition of being frail, which is often discussed in the context of aging and health.</data>
      <data key="d2">c10cd7b5fa3f7e4428da8371caba4087</data>
      <data key="d3">1428</data>
      <data key="d4">2</data>
