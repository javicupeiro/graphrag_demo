      <data key="d9">Manganese is monitored in the nutritional supplementation of preterm infants</data>
      <data key="d10">fa356397bc52582bdbbd1868639feec9</data>
      <data key="d11">636cbb24a4db4f44abc1acc2d8d2038c</data>
      <data key="d12">10384</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PRETERM INFANTS" target="IRON">
      <data key="d8">1.0</data>
      <data key="d9">Iron supplementation is considered for preterm infants, especially if they are on parenteral nutrition for extended periods</data>
      <data key="d10">fa356397bc52582bdbbd1868639feec9</data>
      <data key="d11">60d93e24695740e3bba4e9e3334afa90</data>
      <data key="d12">10385</data>
