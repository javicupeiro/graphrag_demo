      <data key="d0">PERSON</data>
      <data key="d1">Author of a review and consensus on nutritional therapy in inflammatory bowel disease, contributing to the field of clinical nutrition.</data>
      <data key="d2">bf234f719a608fc6858d9a1749463539</data>
