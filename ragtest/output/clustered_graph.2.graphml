      <data key="d7">655ef8ed50004072ab0fbe109768c7a6</data>
    </node>
    <node id="EPLERENONA">
      <data key="d0">EVENT</data>
      <data key="d1">Eplerenone is another aldosterone antagonist similar to spironolactone, which also requires withdrawal before testing for accurate interpretation.</data>
      <data key="d2">151237aa6e4e4aaa2d1115a10ab09be0</data>
      <data key="d3">1340</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">5200</data>
      <data key="d7">7964706f9a5b4447b4409e4ee5922411</data>
    </node>
    <node id="SECRECI&#211;N DE HORMONAS SEXUALES">
      <data key="d0">EVENT</data>
      <data key="d1">The secretion of sex hormones by adrenal tumors is rare, typically associated with malignant conditions.</data>
      <data key="d2">151237aa6e4e4aaa2d1115a10ab09be0</data>
      <data key="d3">1333</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">5201</data>
      <data key="d7">28376cd1d3d744d39fbac7843e3ff155</data>
    </node>
    <node id="GUIAS">
      <data key="d0">EVENT</data>
      <data key="d1">Guidelines refer to the recommendations for the management and follow-up of adrenal incidentalomas, which may vary based on initial imaging characteristics.</data>
      <data key="d2">151237aa6e4e4aaa2d1115a10ab09be0</data>
      <data key="d3">1333</data>
      <data key="d4">2</data>
