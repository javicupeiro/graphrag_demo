    <node id="SPEECH AND LANGUAGE THERAPIST">
      <data key="d0">PERSON</data>
      <data key="d1">A Speech and Language Therapist (SLT) is a professional who assesses and treats communication and swallowing disorders.</data>
      <data key="d2">4e83f9d1f09d1d6b2eb82c16a15f1928</data>
      <data key="d3">1222</data>
