    <edge source="HYPERTIROIDISM" target="FIBRILLATION AURICULAR">
      <data key="d8">1.0</data>
      <data key="d9">Atrial fibrillation can occur in older adults with untreated subclinical hyperthyroidism</data>
      <data key="d10">f979a07da5d7c814ccf957629ab91cc5</data>
