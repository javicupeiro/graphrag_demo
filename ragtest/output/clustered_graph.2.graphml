    <node id="CISTINOSIS">
      <data key="d0">EVENT</data>
      <data key="d1">Cystinosis is a rare autosomal recessive lysosomal storage disease characterized by the accumulation of cystine crystals, primarily affecting the kidneys and thyroid.</data>
      <data key="d2">be2de576112f22070e8ef8a5cb9e1017</data>
