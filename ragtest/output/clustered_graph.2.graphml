    <node id="NECESIDAD DE CIRUG&#205;A">
      <data key="d0">EVENT</data>
      <data key="d1">La necesidad de cirug&#237;a puede surgir en pacientes con pancreatitis aguda debido a complicaciones, lo que puede influir en el tipo de soporte nutricional requerido.</data>
      <data key="d2">5d4476c2c40af44f9d54628af0ac463d</data>
