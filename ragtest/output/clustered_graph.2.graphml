      <data key="d11">6224387c58de494ca91e2f6329a0cea1</data>
      <data key="d12">15038</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SAPROPTERINA" target="FDA">
      <data key="d8">1.0</data>
      <data key="d9">The FDA categorizes sapropterin as a treatment for phenylketonuria, indicating its approved use in patients</data>
      <data key="d10">cc9543ac7abe58ae289e1fbd5353e219</data>
      <data key="d11">a643cee7ccbc46ccb18763431db604eb</data>
      <data key="d12">15039</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SAPROPTERINA" target="PHENYLKETONURIA">
      <data key="d8">7.0</data>
      <data key="d9">Sapropterina is used in the treatment of Phenylketonuria to increase tolerance to phenylalanine.</data>
      <data key="d10">8c74843de8cb570c0601b11d59744427</data>
      <data key="d11">50c76cf2d00847a5abf51f49ca473940</data>
      <data key="d12">15040</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="LORCASERINA">
      <data key="d8">8.0</data>
      <data key="d9">The FDA approved lorcaserina for obesity treatment in the United States</data>
      <data key="d10">35dc97b15f3fd556acbfdb405eadda06</data>
      <data key="d11">64a0609d9373402b91950e6370c7be3e</data>
      <data key="d12">15041</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="FENTERMINE">
      <data key="d8">16.0</data>
      <data key="d9">The FDA approved fentermina for appetite reduction in obesity and for use in obesity treatment. This approval indicates that fentermina is recognized as a viable option for managing obesity by helping to reduce appetite, thereby assisting individuals in their weight loss efforts.</data>
      <data key="d10">35dc97b15f3fd556acbfdb405eadda06,623ef060e116bc05259d5e6d3d8c0996</data>
      <data key="d11">53d6af1b4b524e7c9504cbbd6099a93d</data>
      <data key="d12">15042</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="BLOSSOM">
      <data key="d8">8.0</data>
      <data key="d9">The FDA approved the lorcaserin used in the BLOSSOM study for obesity management</data>
      <data key="d10">623ef060e116bc05259d5e6d3d8c0996</data>
      <data key="d11">76bfc0eac35d4759a33ea2d6539e747d</data>
      <data key="d12">15043</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="BLOOM">
      <data key="d8">8.0</data>
      <data key="d9">The FDA approved the lorcaserin used in the BLOOM study for obesity management</data>
      <data key="d10">623ef060e116bc05259d5e6d3d8c0996</data>
      <data key="d11">81f9b250d5444f42849d24b18aa1cbe0</data>
      <data key="d12">15044</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="BLOOM-DM">
      <data key="d8">8.0</data>
      <data key="d9">The FDA approved the lorcaserin used in the BLOOM-DM study for obesity management in diabetes</data>
      <data key="d10">623ef060e116bc05259d5e6d3d8c0996</data>
      <data key="d11">022bec903bef4c77a69564528650f63a</data>
      <data key="d12">15045</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="LORCASERIN">
      <data key="d8">9.0</data>
      <data key="d9">The FDA approved lorcaserin for weight management in 2012</data>
      <data key="d10">623ef060e116bc05259d5e6d3d8c0996</data>
      <data key="d11">a9aaf741c60e41cea2eeb6a2a0e9fe66</data>
      <data key="d12">15046</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="TOPIRAMATE">
      <data key="d8">8.0</data>
      <data key="d9">The FDA approved topiramate for seizures and migraines, which is used in obesity treatment</data>
      <data key="d10">623ef060e116bc05259d5e6d3d8c0996</data>
      <data key="d11">c767eb56ee054a4da16f3674d1e4164d</data>
      <data key="d12">15047</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="QSYMIAR">
      <data key="d8">1.0</data>
      <data key="d9">The FDA approved Qsymia, a combination of fentermina and topiramate, for obesity treatment</data>
      <data key="d10">623ef060e116bc05259d5e6d3d8c0996</data>
      <data key="d11">a8813a4ff06d433683fa8ae47910a96e</data>
      <data key="d12">15048</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="BN">
      <data key="d8">8.0</data>
      <data key="d9">The FDA oversees the approval and safety studies of BN, ensuring it meets health standards</data>
      <data key="d10">f44811ae5b3e9dab0f295efe8842767a</data>
      <data key="d11">fa3719644ef141359cd54a17113246bc</data>
      <data key="d12">15049</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="BIFOSFONATOS">
      <data key="d8">6.0</data>
      <data key="d9">The FDA approves bisphosphonates for the treatment of osteoporosis</data>
      <data key="d10">94afd4bf40b661992e66cf7963ef236c</data>
      <data key="d11">81395bdb586e4b4a83fce07905db4f13</data>
      <data key="d12">15050</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FDA" target="TEDUGLUTIDA">
      <data key="d8">9.0</data>
      <data key="d9">The FDA approved teduglutida for the treatment of short bowel syndrome in December 2012</data>
      <data key="d10">e0196a8a0ead0a27b38ddfb16a5c5772</data>
      <data key="d11">4181466cce6c492fb64e92add6076fd9</data>
      <data key="d12">15051</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="HYPERPARATHYROIDISM">
      <data key="d8">26.0</data>
      <data key="d9">Hyperparathyroidism is a condition characterized by the excessive production or secretion of parathyroid hormone (PTH), which plays a crucial role in regulating calcium levels in the body. This overproduction of PTH often results in hypercalcemia, a condition marked by elevated calcium levels in the blood. The relationship between hyperparathyroidism and hypercalcemia is well-established, as the increased levels of parathyroid hormone directly contribute to the rise in calcium levels, leading to various health complications associated with hypercalcemia.</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783,ae9d1fec31d651598e2db7436382c906,ba0a1fee09e488cf2628102b72a52435</data>
      <data key="d11">8bd8eada32004c81b8c98c0d0f9ca5c4</data>
      <data key="d12">15052</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="HYPERCALCEMIA MALIGNA">
      <data key="d8">8.0</data>
      <data key="d9">La hipercalcemia maligna es una forma de hipercalcemia que ocurre en pacientes con c&#225;ncer, a menudo debido a secreciones tumorales.</data>
      <data key="d10">ba0a1fee09e488cf2628102b72a52435</data>
      <data key="d11">23787b97a3524d60bce78f01a086494d</data>
      <data key="d12">15053</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="HODGKIN'S LYMPHOMA">
      <data key="d8">8.0</data>
      <data key="d9">Hodgkin's lymphoma can cause hypercalcemia due to tumor production of 1,25-dihydroxyvitamin D.</data>
      <data key="d10">ae9d1fec31d651598e2db7436382c906</data>
      <data key="d11">f56ca5f9aa1943d39fc2253b567ccdc2</data>
      <data key="d12">15054</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="NON-HODGKIN'S LYMPHOMA">
      <data key="d8">8.0</data>
      <data key="d9">Non-Hodgkin's lymphoma is associated with hypercalcemia in a third of cases due to similar mechanisms as Hodgkin's lymphoma.</data>
      <data key="d10">ae9d1fec31d651598e2db7436382c906</data>
      <data key="d11">1a892ed884c74811a8c51f074ed55934</data>
      <data key="d12">15055</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="PARATHYROID HORMONE (PTH)">
      <data key="d8">7.0</data>
      <data key="d9">Ectopic secretion of PTH can lead to hypercalcemia, particularly in certain carcinomas.</data>
      <data key="d10">ae9d1fec31d651598e2db7436382c906</data>
      <data key="d11">552116ab0603480493239e0ca3c350b7</data>
      <data key="d12">15056</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="CARCINOMA">
      <data key="d8">7.0</data>
      <data key="d9">Certain carcinomas can cause hypercalcemia through ectopic PTH secretion.</data>
      <data key="d10">ae9d1fec31d651598e2db7436382c906</data>
      <data key="d11">6049a6c1041d462e90327e1ff161c1cb</data>
      <data key="d12">15057</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="PRIMARY HYPERPARATHYROIDISM">
      <data key="d8">9.0</data>
      <data key="d9">Primary hyperparathyroidism is a common cause of hypercalcemia due to the overproduction of parathyroid hormone.</data>
      <data key="d10">ae9d1fec31d651598e2db7436382c906</data>
      <data key="d11">72e6b1c833ae4084b46838acf38a71e8</data>
      <data key="d12">15058</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="NEPHROCALCINOSIS">
      <data key="d8">7.0</data>
      <data key="d9">Nephrocalcinosis can occur as a result of chronic hypercalcemia, leading to calcium deposits in the kidneys.</data>
      <data key="d10">ae9d1fec31d651598e2db7436382c906</data>
      <data key="d11">a298901b935847a39a799ee01c9f812b</data>
      <data key="d12">15059</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="HIPERCALCEMIA HIPOCALCI&#218;RICA FAMILIAR">
      <data key="d8">1.0</data>
      <data key="d9">La hipercalcemia es un s&#237;ntoma asociado a la hipercalcemia hipocalci&#250;rica familiar</data>
      <data key="d10">6ba1a5e8454a503171991c13d33cf5e2</data>
      <data key="d11">44965ca8f7c446c88ed6dc54e4832d41</data>
      <data key="d12">15060</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="PTHRP">
      <data key="d8">8.0</data>
      <data key="d9">PTHrP is associated with hypercalcemia as it acts to increase calcium levels in the blood, particularly in malignancies</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">485cab4088ea4b4a8f49d79839af1e8d</data>
      <data key="d12">15061</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="C&#193;NCER EPIDERMICO PULMONAR">
      <data key="d8">7.0</data>
      <data key="d9">C&#225;ncer epid&#233;rmico pulmonar is associated with hypercalcemia, particularly in advanced stages of the disease</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">32e7d529f3a74a4e9564f5fedf71e266</data>
      <data key="d12">15062</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="C&#193;NCER ESOF&#193;GICO">
      <data key="d8">7.0</data>
      <data key="d9">C&#225;ncer esof&#225;gico is associated with hypercalcemia</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">e54b323589294eb3960fe234448481e5</data>
      <data key="d12">15063</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="C&#193;NCER DE CUELLO UTERINO BULBAR">
      <data key="d8">7.0</data>
      <data key="d9">C&#225;ncer de cuello uterino bulbar can cause hypercalcemia</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">2c39ef38593e486c8c76ba4a46cf7885</data>
      <data key="d12">15064</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="C&#193;NCER RENAL">
      <data key="d8">7.0</data>
      <data key="d9">C&#225;ncer renal can lead to hypercalcemia</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">af0a146c75534b8aaddf7b83de8e0636</data>
      <data key="d12">15065</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="C&#193;NCER VESICAL">
      <data key="d8">7.0</data>
      <data key="d9">C&#225;ncer vesical is associated with hypercalcemia</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">79d4cd5ee61b4d59a642a8b93a5c1b11</data>
      <data key="d12">15066</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="TUMORES DE C&#201;LULAS DE LOS ISLOTES">
      <data key="d8">6.0</data>
      <data key="d9">Tumores de c&#233;lulas de los islotes can also produce excess PTHrP, contributing to hypercalcemia</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">c0d749dd18c74e1382789c7c58e90c50</data>
      <data key="d12">15067</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="CARCINOIDES">
      <data key="d8">6.0</data>
      <data key="d9">Carcinoides may lead to hypercalcemia through the production of PTHrP</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">023d960bb0e84df6897cd8973c7642a7</data>
      <data key="d12">15068</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="LINFOMA DE LINFOCITOS T AGRESIVO">
      <data key="d8">1.0</data>
      <data key="d9">Linfoma de linfocitos T agresivo is associated with excessive PTHrP production and hypercalcemia</data>
      <data key="d10">74c9662af46dca03f3941e133df2e783</data>
      <data key="d11">9e5a920b3e844a5b9ce053b6bfc5e631</data>
      <data key="d12">15069</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="HPP">
      <data key="d8">1.0</data>
      <data key="d9">HPP is often associated with hypercalcemia due to excessive parathyroid hormone production</data>
      <data key="d10">de7d109afad1dbd144cb8e76c49ed638</data>
      <data key="d11">546797782e6c4f5b911804c28d78636b</data>
      <data key="d12">15070</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="BISPHOSPHONATES">
      <data key="d8">8.0</data>
      <data key="d9">Bisphosphonates are used to treat hypercalcemia by inhibiting bone resorption</data>
      <data key="d10">de7d109afad1dbd144cb8e76c49ed638</data>
      <data key="d11">e098b17f9e8c4b63a6a33cb1e44700b5</data>
      <data key="d12">15071</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="FUROSEMIDE">
      <data key="d8">6.0</data>
      <data key="d9">Furosemide may be used in the management of hypercalcemia to promote calcium excretion</data>
      <data key="d10">de7d109afad1dbd144cb8e76c49ed638</data>
      <data key="d11">ee3f909f52bc4a15a5688e4e52350fa6</data>
      <data key="d12">15072</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="SERUM PHYSIOLOGICAL">
      <data key="d8">7.0</data>
      <data key="d9">Serum physiological is used for rehydration in the treatment of hypercalcemia</data>
      <data key="d10">de7d109afad1dbd144cb8e76c49ed638</data>
      <data key="d11">43147fb91e9d466aa1a365c279113e0e</data>
      <data key="d12">15073</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="HYPERPLASIA PARATIROIDEA">
      <data key="d8">8.0</data>
      <data key="d9">Hyperplasia paratiroidea can lead to hypercalcemia due to increased parathyroid hormone secretion</data>
      <data key="d10">de7d109afad1dbd144cb8e76c49ed638</data>
      <data key="d11">c626e5689fa94daeadcb92eaec933583</data>
      <data key="d12">15074</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="D">
      <data key="d8">7.0</data>
      <data key="d9">D's hypercalcemia is a significant finding that may indicate parathyroid involvement in MEN1</data>
      <data key="d10">fbba0b43850ff5e50b710069959c2416</data>
      <data key="d11">218148d9603d4eb9a6f9d4d840b66d05</data>
      <data key="d12">15075</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERCALCEMIA" target="HYPO-MAGNESEMIA">
      <data key="d8">1.0</data>
      <data key="d9">Hypomagnesemia can be associated with hypercalcemia due to metabolic interactions</data>
      <data key="d10">b9342cecd69cdc0e9936df041657f5f5</data>
      <data key="d11">fd4db29631714f0fb7f301a19541fe49</data>
      <data key="d12">15076</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HYPERPARATHYROIDISM" target="HYPERPARATHYROIDISM SECUNDARY">
      <data key="d8">6.0</data>
