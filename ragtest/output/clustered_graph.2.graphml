      <data key="d5">7</data>
      <data key="d6">4773</data>
      <data key="d7">5e5634de3447451693311a15456abfcc</data>
    </node>
    <node id="PROTOONCOG&#201;N RET">
      <data key="d0">PERSON</data>
      <data key="d1">El protooncog&#233;n RET es un gen que, cuando presenta mutaciones, puede dar origen a carcinomas medulares familiares.</data>
      <data key="d2">8ef1954ebfc3ede96038ff1db145e140</data>
      <data key="d3">971</data>
      <data key="d4">2</data>
