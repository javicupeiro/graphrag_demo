    <node id="HEPATOBILIARY COMPLICATIONS">
      <data key="d0">EVENT</data>
      <data key="d1">Complications that arise in the liver and bile ducts, often related to prolonged parenteral nutrition, including steatosis and cholestasis.</data>
      <data key="d2">036e8182deab774d39f06cd811738c9b</data>
      <data key="d3">588</data>
