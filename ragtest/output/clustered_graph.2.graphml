      <data key="d7">b6a366797a0f4b18ba9b0668ad8a0bd0</data>
    </node>
    <node id="SAHS">
      <data key="d0">EVENT</data>
      <data key="d1">SAHS refers to the syndrome of sleep apnea-hypopneas, a condition studied in relation to liraglutida's effects on weight loss.</data>
      <data key="d2">90c684dca4542bbe1177afd26e78581e</data>
