      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N CL&#205;NICA" target="TEMPERATURA">
      <data key="d8">8.0</data>
      <data key="d9">NUTRICI&#211;N CL&#205;NICA is an essential field that closely monitors temperature to ensure the stability of proteins during processing. Temperature plays a critical role in clinical nutrition, as it significantly influences both the solubility of ingredients and the growth of microorganisms. By maintaining appropriate temperature levels, NUTRICI&#211;N CL&#205;NICA aims to optimize the quality and safety of nutritional products.</data>
      <data key="d10">d9e4179f945ec9152199511522d70159,dc38a37c30b175667931b84a9c9103bb</data>
      <data key="d11">e9c5c4fb53b345f39158a477f84b20bd</data>
      <data key="d12">2586</data>
      <data key="d13">2</data>
    </edge>
