    </node>
    <node id="SORBITE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Sorbitol is a sugar alcohol used as a sweetener that can cause digestive issues for some people.</data>
      <data key="d2">f713611b23199b8a9eb9c28377b9f128</data>
      <data key="d5">0</data>
      <data key="d6">9798</data>
