      <data key="d8">9.0</data>
      <data key="d9">Gelification is the process that allows the creation of gelatins from liquid foods</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">7717f11de2f54addb0f0d2e86f354695</data>
      <data key="d12">5021</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GELIFICATION" target="ALGINATES">
      <data key="d8">8.0</data>
      <data key="d9">Alginates are known for their ability to gelify in cold water, which is a key aspect of the gelification process</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">2dac71ffd37a49d1b76b367534a9b55f</data>
      <data key="d12">5022</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GELIFICATION" target="GUM AGAR">
      <data key="d8">1.0</data>
      <data key="d9">Gum agar is a significant agent in the gelification process, providing strong gel properties</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">6420c7bd9667485ca97637122688d693</data>
      <data key="d12">5023</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GELIFICATION" target="AGENTS GELIFICANTES">
      <data key="d8">8.0</data>
      <data key="d9">Agents gelificantes are essential in the gelification process, as they help to thicken and stabilize liquid foods</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">390af29fa8bb4fc28bcc6c6d28cf8383</data>
      <data key="d12">5024</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GELIFICATION" target="HIDROCOLOIDE">
      <data key="d8">8.0</data>
      <data key="d9">Hidrocoloides play a significant role in gelification, providing texture and stability to food products</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">48dd60c6e50046dbbce118c18ea1c32a</data>
      <data key="d12">5025</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GELIFICATION" target="GOMAS">
      <data key="d8">8.0</data>
      <data key="d9">Gomas are used in the gelification process to create gels in various food applications</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">608a71fc863d41e0a6609297106e1595</data>
      <data key="d12">5026</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMAS" target="ESPESANTES">
      <data key="d8">9.0</data>
      <data key="d9">GOMAS and ESPESANTES are essential components in the formulation of thickeners, particularly for managing dysphagia, a condition that affects swallowing. GOMAS, which refers to gums, serve as a key ingredient in these thickeners, providing the necessary viscosity to liquids. Additionally, GOMAS can be utilized alongside starch to further modify the viscosity of various liquids, enhancing their suitability for individuals with swallowing difficulties. Together, GOMAS and ESPESANTES play a crucial role in creating safe and effective thickening agents for those in need.</data>
      <data key="d10">4aeca0ee5f2663f449cfd017d3e3bbfb,c1fcea6b2c2290b4c90ae1a511ca05d4</data>
      <data key="d11">f6313b4139e0485baa0fc2a463d17668</data>
      <data key="d12">5027</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PECTINA" target="AGENTS GELIFICANTES">
      <data key="d8">7.0</data>
      <data key="d9">Pectina is a type of agent gelificante commonly used in making jellies and jams</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">6991f24f9ba24c65ae9b91bf78a56be5</data>
      <data key="d12">5028</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PECTINA" target="GOMA CARRAGENINA">
      <data key="d8">8.0</data>
      <data key="d9">Ambas son utilizadas en la industria alimentaria como agentes espesantes y estabilizantes</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">014e307c5af14a879a8678d73b546c99</data>
      <data key="d12">5029</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PECTINA" target="GOMA TRAGACANTO">
      <data key="d8">1.0</data>
      <data key="d9">Ambas gomas son utilizadas en la elaboraci&#243;n de productos alimentarios como gelatinas y mermeladas</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">f08a3c8f680c4557a2a535ca7aa88617</data>
      <data key="d12">5030</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PECTINA" target="MANZANAS">
      <data key="d8">8.0</data>
      <data key="d9">La pectina se encuentra en las manzanas, siendo un componente clave en la elaboraci&#243;n de gelatinas y mermeladas</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">2149e7a09d064b24a0cb5a573c7d7e81</data>
      <data key="d12">5031</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PECTINA" target="MEMBRILLOS">
      <data key="d8">8.0</data>
      <data key="d9">La pectina se encuentra en los membrillos, utilizada como agente espesante en la industria alimentaria</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">47dc4dd1aa9d48b38db5e46b8b86cbc2</data>
      <data key="d12">5032</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PECTINA" target="NARANJAS">
      <data key="d8">1.0</data>
      <data key="d9">La pectina se encuentra en las naranjas, utilizada en la elaboraci&#243;n de productos alimentarios como gelatinas y salsas</data>
      <data key="d10">16da5930da05ae4c3744357a7d6e67cd</data>
      <data key="d11">b4e72c12bc3149d8b51fc36631a7e8a9</data>
      <data key="d12">5033</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CARRAGENINA" target="AGENTS GELIFICANTES">
      <data key="d8">1.0</data>
      <data key="d9">Carragenina is another type of agent gelificante used for thickening and stabilizing food products</data>
      <data key="d10">c77a5a4f92d7d5509acc676d31f68412</data>
      <data key="d11">52385d4243d544db8365b4bf24406ab4</data>
      <data key="d12">5034</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA AR&#193;BIGA" target="GOMA GAROF&#205;N">
      <data key="d8">5.0</data>
      <data key="d9">Ambas gomas son utilizadas en la industria alimentaria para estabilizar emulsiones y mejorar la textura de los productos.</data>
      <data key="d10">767c2489bbb49e4b253ae54565c7a4f1</data>
      <data key="d11">12eafebef8bb4bbf8450bcccdbf35647</data>
      <data key="d12">5035</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA AR&#193;BIGA" target="ACACIA SENEGAL">
      <data key="d8">8.0</data>
      <data key="d9">La goma ar&#225;biga se extrae de la resina del &#225;rbol Acacia Senegal, que es su fuente natural.</data>
      <data key="d10">767c2489bbb49e4b253ae54565c7a4f1</data>
      <data key="d11">3924f8e624e14856a3d945fad97fda60</data>
      <data key="d12">5036</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GOMA AR&#193;BIGA" target="NUTRICIA">
      <data key="d8">7.0</data>
      <data key="d9">Nutricia employs goma ar&#225;biga as a stabilizer in its dietary formulations</data>
