      <data key="d5">2</data>
      <data key="d6">9800</data>
      <data key="d7">c1dd4efcd6114837b728f66b16e34c15</data>
    </node>
    <node id="MIJO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Millet is a gluten-free grain that is often included in diets for those with gluten intolerance.</data>
      <data key="d2">f713611b23199b8a9eb9c28377b9f128</data>
      <data key="d5">0</data>
      <data key="d6">9801</data>
      <data key="d7">7f4a0e442c0144ab886dfdd3fd041cfe</data>
    </node>
    <node id="POLENTA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Polenta is a dish made from cornmeal that is gluten-free and suitable for those with gluten sensitivity.</data>
      <data key="d2">f713611b23199b8a9eb9c28377b9f128</data>
      <data key="d5">0</data>
      <data key="d6">9802</data>
