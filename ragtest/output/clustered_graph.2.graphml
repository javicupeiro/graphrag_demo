      <data key="d6">1754</data>
      <data key="d7">d52d6b4886b64fb885aeb9b7c8b56046</data>
    </node>
    <node id="ENFERMEDADES HEPATOP&#193;TICAS">
      <data key="d0">EVENT</data>
      <data key="d1">Hepatopathies are liver diseases that can impact nutritional assessments and immune function.</data>
      <data key="d2">30d5c2ac31f39f8177bec50f6b5e631b</data>
      <data key="d3">1102</data>
