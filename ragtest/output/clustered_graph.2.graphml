    </node>
    <node id="NUTRITIONAL SUPPORT POSTOPERATIVE">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional support in the postoperative phase focuses on ensuring adequate intake to promote recovery.</data>
      <data key="d2">d23c564df025cf16e37f2ef2be83ec34</data>
      <data key="d3">1249</data>
