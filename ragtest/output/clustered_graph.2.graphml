    </edge>
    <edge source="NUTRICI&#211;N ARTIFICIAL DOMICILIARIA" target="GRUPO NADYA-SENPE">
      <data key="d8">16.0</data>
      <data key="d9">NUTRICI&#211;N ARTIFICIAL DOMICILIARIA is a focus area for Grupo NADYA-SENPE, which documents and studies practices related to artificial nutrition at home. The group is actively involved in reporting on these practices, contributing to a better understanding of home artificial nutrition.</data>
      <data key="d10">4cf0c8d0f4e711be85d16ee71317aa4e,7e3e2024996e402fc0ab62933ab9417b</data>
      <data key="d11">daeba905bfc74c30b55aa687a78a2fff</data>
