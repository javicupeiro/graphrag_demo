      <data key="d11">670efdd6dc9d44d88e1be7de063943a7</data>
      <data key="d12">3895</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="FORBES A">
      <data key="d8">8.0</data>
