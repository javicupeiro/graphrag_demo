    </edge>
    <edge source="SAND&#205;A" target="FRESA">
      <data key="d8">5.0</data>
      <data key="d9">Both Sand&#237;a and Fresa are popular fruits often used in summer desserts and fruit salads</data>
      <data key="d10">5f60e39bc965632761d15273062b91fe</data>
      <data key="d11">e94032e1d30a433d8ad93a3cafe11c6a</data>
      <data key="d12">17079</data>
