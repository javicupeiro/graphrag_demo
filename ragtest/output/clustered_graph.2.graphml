      <data key="d5">2</data>
      <data key="d6">308</data>
      <data key="d7">4f89d7ddf80345df88e6fde1068f0608</data>
    </node>
    <node id="FOOD THICKENER">
      <data key="d0">EVENT</data>
      <data key="d1">Food thickener is a substance used to modify the consistency of liquids for patients with dysphagia during swallowing assessments.</data>
      <data key="d2">7ff388a8f346ea7b1ceece48ed64b1a2</data>
      <data key="d3">1222</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">309</data>
      <data key="d7">9c49b0b79e224765882ee95e8fb7240d</data>
    </node>
    <node id="DIRECT SWALLOWING TEST">
      <data key="d0">EVENT</data>
      <data key="d1">The Direct Swallowing Test is a part of the GUSS that evaluates a patient's ability to swallow different consistencies of food and liquids.</data>
      <data key="d2">7ff388a8f346ea7b1ceece48ed64b1a2</data>
      <data key="d3">1222</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">310</data>
      <data key="d7">4ee2e647a7204b73b9cb13f4d677234b</data>
    </node>
    <node id="INDIRECT SWALLOWING TEST">
      <data key="d0">EVENT</data>
      <data key="d1">The Indirect Swallowing Test is a preliminary assessment in the GUSS that evaluates a patient's alertness and ability to manage saliva.</data>
      <data key="d2">7ff388a8f346ea7b1ceece48ed64b1a2</data>
      <data key="d3">1257</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
