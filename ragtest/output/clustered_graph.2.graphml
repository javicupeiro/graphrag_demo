      <data key="d6">13358</data>
      <data key="d7">ad0b6fc7eb714d5180e93d0e3b36f251</data>
    </node>
    <node id="NEOPLASIAS GASTROINTESTINALES">
      <data key="d0">EVENT</data>
      <data key="d1">NEOPLASIAS GASTROINTESTINALES, or gastrointestinal neoplasms, represent a major cause of cancer mortality globally. These neoplasms are a significant health concern, highlighting the importance of nutritional intervention and support in their management. Given their impact on cancer mortality, there is a critical need for nutritional evaluation to aid in the treatment and prevention of these conditions.</data>
      <data key="d2">5e934738b2a8cb03468f4ebf4eec0cd2,639ebafae8a95bb03a09e111172b9a4e</data>
      <data key="d3">1178</data>
