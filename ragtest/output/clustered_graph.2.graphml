    </node>
    <node id="NUTRITIONAL RISK SCREENING (NRS 2002)">
      <data key="d0">EVENT</data>
      <data key="d1">A standardized tool used to assess nutritional risk in patients, particularly the elderly, based on weight loss and disease severity.</data>
