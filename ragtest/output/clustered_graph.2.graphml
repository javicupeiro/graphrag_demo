    </node>
    <node id="GLANDULA PINEAL">
      <data key="d0">GEO</data>
      <data key="d1">The pineal gland is a small endocrine gland in the brain that produces melatonin and can be affected by tumors.</data>
      <data key="d2">4faa9b46acd7540904fc5b0772bb7c51</data>
