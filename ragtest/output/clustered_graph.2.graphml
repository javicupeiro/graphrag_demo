      <data key="d7">74d620cf95ac44e69a7f83193bb4e488</data>
    </node>
    <node id="JUNTA DE ANDALUC&#205;A">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Junta de Andaluc&#237;a is the regional government of Andalusia, responsible for establishing standards for Clinical Nutrition and Dietetic Units within the region. Additionally, it oversees the ACSA (Agencia de Calidad Sanitaria de Andaluc&#237;a), ensuring the quality and effectiveness of healthcare services in the area.</data>
      <data key="d2">4de75db0e24f0f89d890287e2a3f3dcc,6d628d186db6cb708d96ec523f3e35c8</data>
      <data key="d3">1570</data>
