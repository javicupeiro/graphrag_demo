    </node>
    <node id="AMOR FERN&#193;NDEZ AJ">
      <data key="d0">PERSON</data>
      <data key="d1">Amor Fern&#225;ndez AJ is an author of the "Manual de Endocrinolog&#237;a y Nutrici&#243;n." This manual addresses various topics in the field of endocrinology and nutrition, including the treatment of dyslipidemias.</data>
      <data key="d2">c78125c02ea4d5afdf5cb5ac4baeeb27,ce43a9a4cdf2497b2f984547a2787fff</data>
