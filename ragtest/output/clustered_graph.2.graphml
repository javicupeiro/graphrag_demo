    </node>
    <node id="CARDIOVASCULAR ISSUES">
      <data key="d0">EVENT</data>
      <data key="d1">Cardiovascular issues refer to health problems related to the heart and blood vessels, often requiring dietary adjustments.</data>
      <data key="d2">49279a0184d5222e806637f084f42c50</data>
      <data key="d5">0</data>
      <data key="d6">8444</data>
