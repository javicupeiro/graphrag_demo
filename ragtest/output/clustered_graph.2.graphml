    <node id="NHS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The National Health Service (NHS) is the publicly funded healthcare system in the United Kingdom, providing healthcare services to residents.</data>
      <data key="d2">5a0cbd0175ff61eee9b252f8ba7040ed</data>
      <data key="d3">1568</data>
