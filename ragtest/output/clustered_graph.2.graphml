      <data key="d11">d071819d69f94adcbd582d262b6c0b9c</data>
      <data key="d12">16869</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FRUCTOSA" target="GLUT5">
      <data key="d8">7.0</data>
