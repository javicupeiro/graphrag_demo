    <node id="UREA CYCLE DISORDERS">
      <data key="d0">EVENT</data>
      <data key="d1">Urea cycle disorders are genetic conditions that result from deficiencies in enzymes that convert ammonia to urea, leading to toxic accumulation in the body.</data>
      <data key="d2">7754f367b453475179218cac4bc24de1</data>
      <data key="d3">1661</data>
