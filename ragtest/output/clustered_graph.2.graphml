    <node id="INSTITUTO DE INVESTIGACI&#211;N SANITARIA Y BIOM&#201;DICA DE ALICANTE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Alicante Health and Biomedical Research Institute (ISABIAL) is where &#211;scar Moreno P&#233;rez coordinates research on diabetes and associated metabolic diseases.</data>
      <data key="d2">404f3831a7bac02ee23cb4d4f4f2b0e9</data>
      <data key="d3">551</data>
      <data key="d4">1</data>
