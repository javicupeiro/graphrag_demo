      <data key="d11">90f491fb8950437d8ba05d2b3f108f8f</data>
      <data key="d12">15330</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GASTRECTOM&#205;A VERTICAL" target="BANDA G&#193;STRICA">
      <data key="d8">7.0</data>
      <data key="d9">Both Banda g&#225;strica and Gastrectom&#237;a vertical are surgical techniques used for weight loss treatment.</data>
      <data key="d10">b980df2798effe4d56b74a254734403c</data>
      <data key="d11">2895008c0d644449a3367ce48ddc449e</data>
      <data key="d12">15331</data>
