    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="TUMORES DE CABEZA Y CUELLO">
      <data key="d8">8.0</data>
      <data key="d9">Patients with head and neck tumors often experience weight loss as a symptom</data>
