      <data key="d8">1.0</data>
      <data key="d9">Pytlik realiz&#243; un estudio sobre la administraci&#243;n de glutamina en adultos sometidos a trasplante de c&#233;lulas hematol&#243;gicas.</data>
      <data key="d10">3e6ae05671fed21e332ee155332df21e</data>
