    <node id="NUTRICI&#211;N AVANZADA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Advanced Nutrition refers to specialized nutritional support strategies used in complex medical conditions</data>
      <data key="d2">fa0165b0420f4c761829a08a3ab08508</data>
      <data key="d3">1427</data>
      <data key="d4">2</data>
