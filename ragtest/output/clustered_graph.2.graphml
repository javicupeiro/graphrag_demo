      <data key="d13">2</data>
    </edge>
    <edge source="DIARREA" target="SII">
      <data key="d8">8.0</data>
      <data key="d9">Diarrea can be a symptom of SII, indicating a relationship between the two conditions</data>
      <data key="d10">6886c5b652319bea0ba2427a3fdbf701</data>
