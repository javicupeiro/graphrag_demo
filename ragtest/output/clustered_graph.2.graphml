      <data key="d7">8a4f4b73033242d7af1061d45814cf42</data>
    </node>
    <node id="S&#205;NDROME POSTFLEBITICO">
      <data key="d0">EVENT</data>
      <data key="d1">S&#237;ndrome postfleb&#237;tico is a condition that may develop as a complication of venous thrombosis, characterized by edema, pain, and skin changes.</data>
      <data key="d2">20a97c2641138578710a84f5040c86ef</data>
      <data key="d3">768</data>
