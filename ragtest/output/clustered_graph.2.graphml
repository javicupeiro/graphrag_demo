    <edge source="DUODENOPANCREATECTOM&#205;A" target="DRENES">
      <data key="d8">6.0</data>
      <data key="d9">Los drenajes se utilizan despu&#233;s de una duodenopancreatectom&#237;a para manejar el d&#233;bito de fluidos postoperatorios</data>
      <data key="d10">3ee948dc4ddfdc75daa8fe7db9bb471e</data>
      <data key="d11">818ebd562f7142a099e5b3d808df597e</data>
