    <node id="ENFERMEDAD DE CHRON">
      <data key="d0">EVENT</data>
      <data key="d1">Chron's disease is an inflammatory bowel disease that can present symptoms similar to celiac disease and may require differential diagnosis.</data>
      <data key="d2">e6153f0024d75c281071b521b08ed53a</data>
      <data key="d3">807</data>
