    <node id="VANDETANIB">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Vandetanib is a tyrosine kinase inhibitor used in the treatment of advanced medullary thyroid carcinoma.</data>
      <data key="d2">53eefebd95b547fa56967d97b31beec1</data>
