    <edge source="NUTRIENTES" target="GASTROSTOM&#205;A ENDOSC&#211;PICA PERCUT&#193;NEA">
      <data key="d8">8.0</data>
      <data key="d9">La gastrostom&#237;a endosc&#243;pica percut&#225;nea permite la administraci&#243;n de nutrientes directamente en el est&#243;mago.</data>
