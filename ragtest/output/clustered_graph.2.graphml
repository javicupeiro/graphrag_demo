      <data key="d8">6.0</data>
      <data key="d9">Las f&#243;rmulas hipercal&#243;ricas son recomendadas para pacientes quir&#250;rgicos con descompensaci&#243;n hidr&#243;pica</data>
      <data key="d10">169eceabd2bd24183f24faccb2c00088</data>
      <data key="d11">df5359f51a8e4eba928b8bfac6484b37</data>
