    </node>
    <node id="FLUOROSCOPIC EVALUATION">
      <data key="d0">EVENT</data>
      <data key="d1">A diagnostic procedure used to assess oropharyngeal dysphagia, involving real-time imaging to evaluate swallowing mechanics.</data>
