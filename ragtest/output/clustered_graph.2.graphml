    <node id="HIV-INFECTED WOMEN">
      <data key="d0">EVENT</data>
      <data key="d1">HIV-infected women experience various health issues, including amenorrhea and early menopause, as discussed in the text.</data>
      <data key="d2">4beab004731d7baff10fd2796a523b55</data>
      <data key="d3">1356</data>
      <data key="d4">2</data>
