    <node id="M. RUBIO ALMANZA">
      <data key="d0">PERSON</data>
      <data key="d1">M. Rubio Almanza is one of the authors contributing to the chapter on nutritional requirements in a medical context.</data>
      <data key="d2">bfe875ea294b9a390193b5de532ff71b</data>
