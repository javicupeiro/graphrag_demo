    <node id="BAND GASTRIC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Band gastric is a type of bariatric surgery that involves placing a band around the stomach to restrict food intake.</data>
      <data key="d2">79afec9f55a4cb9aa31a7e4566dae279</data>
