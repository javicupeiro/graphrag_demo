    <node id="CENTRO DE SALUD">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Un centro de salud es una instalaci&#243;n donde se proporciona atenci&#243;n m&#233;dica y se gestiona la mesogesti&#243;n de los servicios sanitarios.</data>
