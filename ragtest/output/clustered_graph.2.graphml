      <data key="d6">9254</data>
      <data key="d7">2ed3c3d56e204c88973c1e74f2fd5b78</data>
    </node>
    <node id="ESTILO DE VIDA">
      <data key="d0">EVENT</data>
      <data key="d1">Estilo de vida refers to lifestyle choices, including diet and physical activity, which are crucial for managing diabetes.</data>
      <data key="d2">1f2b31f5a0bba00ecee5e3a8fb2c83ea</data>
      <data key="d3">1372</data>
      <data key="d4">2</data>
