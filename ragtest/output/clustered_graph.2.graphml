    </node>
    <node id="MILES">
      <data key="d0">PERSON</data>
      <data key="d1">A researcher who has co-authored studies on hyperglycemic crises in diabetes.</data>
      <data key="d2">cda0904fd9d29455ee008c43bc9f7b41</data>
