    <edge source="NUTRICI&#211;N HIPOCAL&#211;RICA" target="CIRUG&#205;A BARI&#193;TRICA">
      <data key="d8">8.0</data>
      <data key="d9">Hypocaloric nutrition is suggested for patients undergoing bariatric surgery to avoid complications</data>
      <data key="d10">2c7998e65812140cbdda2e4d9c972315</data>
      <data key="d11">164d459a0fea48f68ed82210db1be13d</data>
      <data key="d12">7922</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N HIPOCAL&#211;RICA" target="UNIDAD DE CUIDADOS INTENSIVOS">
      <data key="d8">1.0</data>
      <data key="d9">Hypocaloric nutrition is monitored in the Intensive Care Unit to prevent adverse effects</data>
      <data key="d10">2c7998e65812140cbdda2e4d9c972315</data>
      <data key="d11">fa99494368f147db9f3c2e2477ffa4d4</data>
      <data key="d12">7923</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N HIPOCAL&#211;RICA" target="PACIENTE CR&#205;TICO">
      <data key="d8">7.0</data>
      <data key="d9">Hypocaloric nutrition may be applied in the management of critically ill patients with obesity</data>
      <data key="d10">195affa22ecd2f7b1cdce3d72fc1cba4</data>
      <data key="d11">aa769ac7494c4e4f9047f060073dfd8e</data>
      <data key="d12">7924</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N HIPERPROTEICA" target="CIRUG&#205;A BARI&#193;TRICA">
      <data key="d8">8.0</data>
      <data key="d9">Hyperproteic nutrition is recommended for patients undergoing bariatric surgery to prevent nutritional deficiencies</data>
      <data key="d10">2c7998e65812140cbdda2e4d9c972315</data>
      <data key="d11">5d68cdfb5c814c33892936c5707168c0</data>
      <data key="d12">7925</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N HIPERPROTEICA" target="UNIDAD DE CUIDADOS INTENSIVOS">
      <data key="d8">6.0</data>
      <data key="d9">In the Intensive Care Unit, hyperproteic nutrition is adjusted based on nitrogen balance</data>
      <data key="d10">2c7998e65812140cbdda2e4d9c972315</data>
      <data key="d11">a407fb22697e4126972cd74d0f2b1f19</data>
      <data key="d12">7926</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N HIPERPROTEICA" target="PACIENTE CR&#205;TICO">
      <data key="d8">8.0</data>
      <data key="d9">Hyperproteic nutrition is emphasized for critically ill patients to support healing and immune function</data>
      <data key="d10">195affa22ecd2f7b1cdce3d72fc1cba4</data>
      <data key="d11">f49ba822ed3346a0ae98c678aeae04f1</data>
      <data key="d12">7927</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TROMBOFLEBITIS" target="CVC">
      <data key="d8">6.0</data>
      <data key="d9">Tromboflebitis can occur as a complication in patients with central venous catheters</data>
      <data key="d10">f79f02438413f5accef9ac5fbd96f6df</data>
      <data key="d11">f04ae2f3719b415197f973cfdcc766b4</data>
      <data key="d12">7928</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TROMBOFLEBITIS" target="CAT&#201;TER VENOSO CENTRAL">
      <data key="d8">6.0</data>
      <data key="d9">La tromboflebitis es una complicaci&#243;n que puede ocurrir durante el mantenimiento de un cat&#233;ter venoso central.</data>
      <data key="d10">21bd0c4198fa2be0aa931387bd631728</data>
      <data key="d11">b3dffabf41e949bda7f9c51554414d7b</data>
      <data key="d12">7929</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENFERMEDAD INFLAMATORIA" target="HIPOMAGNESEMIA">
      <data key="d8">5.0</data>
      <data key="d9">Las enfermedades inflamatorias pueden causar malabsorci&#243;n intestinal, contribuyendo a la hipomagnesemia.</data>
      <data key="d10">ed9dfe1b1e334597565187840983df05</data>
      <data key="d11">9c6c93fdaa2f4b2db273f6423726e400</data>
      <data key="d12">7930</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AYUNO" target="GH">
      <data key="d8">6.0</data>
      <data key="d9">Fasting stimulates the secretion of growth hormone</data>
      <data key="d10">68be432b2dd3e64676989cd544f23d8c</data>
      <data key="d11">62a294d54c07471da0faf43b1cc79405</data>
      <data key="d12">7931</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AYUNO" target="QUILOT&#211;RAX">
      <data key="d8">6.0</data>
      <data key="d9">El ayuno puede ser un factor que agrava la condici&#243;n de quilot&#243;rax en pacientes desnutridos.</data>
      <data key="d10">8d4057f6ab3a5d00b2ae7609742cdf86</data>
      <data key="d11">ccc54e22e9ba4588b96b4d66cd35a9e5</data>
      <data key="d12">7932</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AYUNO" target="DC">
      <data key="d8">6.0</data>
      <data key="d9">Ayuno is a practice sometimes included in the classic ketogenic diet protocol to enhance its effectiveness</data>
      <data key="d10">0ebd0c517a3d578a6823dc39797e4da1</data>
      <data key="d11">d85b447d11dd4caeb42a245ac2c2ad43</data>
      <data key="d12">7933</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AYUNO" target="CIRUG&#205;A GASTROINTESTINAL">
      <data key="d8">7.0</data>
      <data key="d9">CIRUG&#205;A GASTROINTESTINAL often involves a period of AYUNO before the procedure</data>
      <data key="d10">a089d87928ddde83e1945eece488d3f5</data>
      <data key="d11">b417d7fc55c849e1aeb44c3e1e551d4f</data>
      <data key="d12">7934</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AYUNO" target="PRUEBAS DIAGN&#211;STICAS">
      <data key="d8">9.0</data>
      <data key="d9">El ayuno es una pr&#225;ctica necesaria antes de realizar pruebas diagn&#243;sticas para asegurar resultados precisos</data>
      <data key="d10">e82ce4aa73097ca70936be74cdafc12b</data>
      <data key="d11">5aebaf96b6564809a61bbb1cb008df1f</data>
      <data key="d12">7935</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AYUNO" target="AYUNO PREOPERATORIO">
      <data key="d8">1.0</data>
      <data key="d9">El ayuno preoperatorio es una forma espec&#237;fica de ayuno que se recomienda antes de procedimientos quir&#250;rgicos</data>
      <data key="d10">e82ce4aa73097ca70936be74cdafc12b</data>
      <data key="d11">88aa649b19cc480ba31133f4e91c149a</data>
      <data key="d12">7936</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AYUNO" target="FACTOR DE MULTIPLICACI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">The multiplication factor for fasting is used to adjust energy expenditure</data>
      <data key="d10">8d7280a9f9085fe677f5993b12910ea2</data>
      <data key="d11">9a8b7af99c2648029f90a8963ebb4f64</data>
      <data key="d12">7937</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="TRIGLIC&#201;RIDOS DE CADENA LARGA">
      <data key="d8">7.0</data>
      <data key="d9">Los triglic&#233;ridos de cadena larga son un tipo de grasa que se utiliza en las emulsiones lip&#237;dicas para la nutrici&#243;n.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">e4b813376ebe490298582fdc839a4ca7</data>
      <data key="d12">7938</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="&#193;CIDOS GRASOS ESENCIALES">
      <data key="d8">10.0</data>
      <data key="d9">Emulsiones lip&#237;dicas son formulaciones que contienen &#225;cidos grasos esenciales, los cuales son fundamentales para la salud. Estos &#225;cidos grasos esenciales se suministran a trav&#233;s de emulsiones lip&#237;dicas en la nutrici&#243;n parenteral, lo que ayuda a prevenir deficiencias nutricionales.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842,c70d301baddcdcdefbba9b024ad4f3c5</data>
      <data key="d11">42ac73ee95734a6aaae72b5f60187492</data>
      <data key="d12">7939</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="ALFA TOCOFEROL">
      <data key="d8">6.0</data>
      <data key="d9">El alfa tocoferol es un antioxidante que se encuentra en las emulsiones lip&#237;dicas y ayuda a prevenir la peroxidaci&#243;n.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">6243ec72bda84cafb3bcbb30ffdc315c</data>
      <data key="d12">7940</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="PANCREATITIS">
      <data key="d8">1.0</data>
      <data key="d9">Las emulsiones lip&#237;dicas pueden ser utilizadas en pacientes con pancreatitis bajo ciertas condiciones.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">a7c0c1794dfc41de873d143266b89b1d</data>
      <data key="d12">7941</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="ACEITE DE SOJA">
      <data key="d8">7.0</data>
      <data key="d9">El aceite de soja es un componente clave en la producci&#243;n de emulsiones lip&#237;dicas debido a su contenido de triglic&#233;ridos de cadena larga.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">5768f412813b4ff7a5b6488dcbc16b5d</data>
      <data key="d12">7942</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="ACEITE DE COCO">
      <data key="d8">7.0</data>
      <data key="d9">El aceite de coco se utiliza en emulsiones lip&#237;dicas como fuente de triglic&#233;ridos de cadena media.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">378d5766e99c452fb4eaa0afafe42d56</data>
      <data key="d12">7943</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="LECITINA DE HUEVO">
      <data key="d8">6.0</data>
      <data key="d9">La lecitina de huevo act&#250;a como emulgente en las emulsiones lip&#237;dicas, ayudando a estabilizarlas.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">bbf4ff66040b48219bfd81af61e69ae1</data>
      <data key="d12">7944</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="GLICEROL">
      <data key="d8">6.0</data>
      <data key="d9">El glicerol se utiliza en emulsiones lip&#237;dicas para mantener la osmolaridad adecuada y mejorar la tolerancia.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">06c3a55450304b7b9a7c40facbbda9db</data>
      <data key="d12">7945</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="OLEATO S&#211;DICO">
      <data key="d8">6.0</data>
      <data key="d9">El oleato s&#243;dico se utiliza como estabilizante en las emulsiones lip&#237;dicas para mejorar su consistencia.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">01e79aff6806469081ed8419c58b9a36</data>
      <data key="d12">7946</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="VITAMINAS K">
      <data key="d8">5.0</data>
      <data key="d9">Las vitaminas K son nutrientes que se incluyen en las emulsiones lip&#237;dicas para apoyar la salud.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">a2dceaae7b254f9697dcdfa428abd21a</data>
      <data key="d12">7947</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="VITAMINAS E">
      <data key="d8">5.0</data>
      <data key="d9">Las vitaminas E se a&#241;aden a las emulsiones lip&#237;dicas como antioxidantes para proteger contra la peroxidaci&#243;n.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">19f451b7c60049ff84d7ed8cae9f3c82</data>
      <data key="d12">7948</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="F&#211;SFORO">
      <data key="d8">1.0</data>
      <data key="d9">El f&#243;sforo es un mineral que se encuentra en las emulsiones lip&#237;dicas y es esencial para diversas funciones biol&#243;gicas.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">da78db7f4c0d42a49351de832ec69250</data>
      <data key="d12">7949</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="&#193;CIDO OLEICO">
      <data key="d8">1.0</data>
      <data key="d9">Oleic acid is a component of lipid emulsions used in nutritional support</data>
      <data key="d10">95b0d21cd06eb29e984e0882f8fac544</data>
      <data key="d11">c2eb7e0f83d3494a8fbc94397b9d73dd</data>
      <data key="d12">7950</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EMULSIONES LIP&#205;DICAS" target="NUTRICI&#211;N PARENTERAL PERIF&#201;RICA">
      <data key="d8">5.0</data>
      <data key="d9">Las emulsiones lip&#237;dicas pueden ser a&#241;adidas a la nutrici&#243;n parenteral perif&#233;rica para mejorar la tolerancia y proporcionar energ&#237;a.</data>
      <data key="d10">40fbc53467b8460d1d2d6bcd0d6dbf2a</data>
      <data key="d11">63cbef6eded44a7192183750bff2f1b1</data>
      <data key="d12">7951</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS ESENCIALES" target="&#193;CIDO LINOL&#201;ICO">
      <data key="d8">8.0</data>
      <data key="d9">El &#225;cido linoleico es un tipo de &#225;cido graso esencial que debe ser incluido en la dieta.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">b1177037a3634f82ab1e465e4ae8d0af</data>
      <data key="d12">7952</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS ESENCIALES" target="&#193;CIDO ALFA-LINOL&#201;NICO">
      <data key="d8">8.0</data>
      <data key="d9">El &#225;cido alfa-linol&#233;nico es otro &#225;cido graso esencial que debe ser aportado en la dieta.</data>
      <data key="d10">86450d0e00138163bc3427ff406aa842</data>
      <data key="d11">4d0071757272490cb813c5e8a721d58e</data>
      <data key="d12">7953</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS ESENCIALES" target="ASOCIACI&#211;N INTERNACIONAL PARA EL ESTUDIO DE LOS &#193;CIDOS GRASOS Y L&#205;PIDOS">
      <data key="d8">7.0</data>
      <data key="d9">Essential fatty acids are a primary focus of the ISSFAL's dietary guidelines</data>
      <data key="d10">60577bdc0f4979d10ba7385bf483c344</data>
      <data key="d11">41249d400ca344178514528f3854d665</data>
      <data key="d12">7954</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS ESENCIALES" target="&#193;CIDOS GRASOS POLIINSATURADOS">
      <data key="d8">1.0</data>
      <data key="d9">Polyunsaturated fatty acids are a type of essential fatty acid that must be consumed through diet</data>
      <data key="d10">0090177678aee58d08471d09d24d2842</data>
      <data key="d11">6f01dca3fbfc4058ae3775e71b4064db</data>
      <data key="d12">7955</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS ESENCIALES" target="ACEITE DE LORENZO">
      <data key="d8">7.0</data>
      <data key="d9">La disminuci&#243;n de los &#225;cidos grasos esenciales es un efecto secundario del tratamiento con aceite de Lorenzo</data>
      <data key="d10">9aa00ebb9b33b958c9956b7859eb11d8</data>
      <data key="d11">11c685f386d448b3b7377321636e7d6b</data>
      <data key="d12">7956</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS ESENCIALES" target="DHA">
      <data key="d8">7.0</data>
      <data key="d9">DHA is one type of essential fatty acid that is recommended for cystic fibrosis patients to improve their health</data>
      <data key="d10">c2211f0deb7328a77cb632140690da03</data>
      <data key="d11">b843fd948c194861bde117d1b836b04b</data>
      <data key="d12">7957</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS ESENCIALES" target="EPA">
      <data key="d8">7.0</data>
      <data key="d9">EPA is another essential fatty acid that is studied for its benefits in the dietary management of cystic fibrosis</data>
      <data key="d10">c2211f0deb7328a77cb632140690da03</data>
      <data key="d11">8b0de2df54224587bb213bc29aafc93f</data>
      <data key="d12">7958</data>
      <data key="d13">2</data>
    </edge>
    <edge source="&#193;CIDOS GRASOS ESENCIALES" target="NUTRICI&#211;N PEDI&#193;TRICA">
      <data key="d8">1.0</data>
      <data key="d9">&#193;cidos grasos esenciales are crucial for children's growth and are discussed within the context of nutrici&#243;n pedi&#225;trica</data>
      <data key="d10">ccac97d61bc412a8574fd71aa26dad79</data>
      <data key="d11">665126ed44904d069d613aec9f5dd143</data>
      <data key="d12">7959</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALFA TOCOFEROL" target="CER-NEVIT">
      <data key="d8">8.0</data>
      <data key="d9">Alfa tocopherol is one of the components included in the CER-NEVIT multivitamin composition for parenteral nutrition</data>
      <data key="d10">97270fe12224dcc1dc019b0d1026a7fd</data>
      <data key="d11">39f3120d899848e49b62f4e43af51a80</data>
      <data key="d12">7960</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="TRIGLIC&#201;RIDOS">
      <data key="d8">9.0</data>
      <data key="d9">High levels of triglycerides can lead to the development of pancreatitis</data>
      <data key="d10">75a4b2d504de480eaef247aa682bfd05</data>
      <data key="d11">54c5a142af3b4077811e9b2c9c6c4188</data>
      <data key="d12">7961</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="PLASMAF&#201;RESIS">
      <data key="d8">8.0</data>
      <data key="d9">Plasmapheresis can be used to rapidly decrease triglyceride levels in patients with pancreatitis</data>
      <data key="d10">75a4b2d504de480eaef247aa682bfd05</data>
      <data key="d11">0805f1ed372d4248964cb09b615285a8</data>
      <data key="d12">7962</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="NE">
      <data key="d8">7.0</data>
      <data key="d9">Nutritional Enteral (NE) is recommended for patients with pancreatitis to provide necessary nutrition</data>
      <data key="d10">178140d0d29364593546d7d21393f2c6</data>
      <data key="d11">2c666877f090434c8bec4281561cd4ce</data>
      <data key="d12">7963</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="NP">
      <data key="d8">7.0</data>
      <data key="d9">Nutritional Parenteral (NP) is used when enteral feeding is not possible in patients with pancreatitis</data>
      <data key="d10">178140d0d29364593546d7d21393f2c6</data>
      <data key="d11">d53713099dc04a76a699ec7c588e9e99</data>
      <data key="d12">7964</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="RANSON">
      <data key="d8">6.0</data>
      <data key="d9">Ranson criteria are used to assess the severity of pancreatitis and guide treatment decisions</data>
      <data key="d10">178140d0d29364593546d7d21393f2c6</data>
      <data key="d11">9774c49b5c7e44098483079bc363a9ed</data>
      <data key="d12">7965</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="APACHE II">
      <data key="d8">6.0</data>
      <data key="d9">APACHE II scoring helps evaluate the prognosis of patients with acute pancreatitis</data>
      <data key="d10">178140d0d29364593546d7d21393f2c6</data>
      <data key="d11">883eadae41954ae281a99f7858dd8cc4</data>
      <data key="d12">7966</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="HOSPITALIZATION">
      <data key="d8">8.0</data>
      <data key="d9">Severe pancreatitis often requires hospitalization for monitoring and treatment</data>
      <data key="d10">178140d0d29364593546d7d21393f2c6</data>
      <data key="d11">9ddced30bedf4757888a79b21d07e9bf</data>
      <data key="d12">7967</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="INFECTION">
      <data key="d8">6.0</data>
      <data key="d9">Patients with pancreatitis are at risk of developing infections, which can complicate their condition</data>
      <data key="d10">178140d0d29364593546d7d21393f2c6</data>
      <data key="d11">a6d2c51d68774c42bcc9da17ac40dcb0</data>
      <data key="d12">7968</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="SOLUCI&#211;N POLIM&#201;RICA">
      <data key="d8">7.0</data>
      <data key="d9">Polymeric solutions are used for enteral nutrition in patients with pancreatitis</data>
      <data key="d10">178140d0d29364593546d7d21393f2c6</data>
      <data key="d11">c61274fc22664672b25aee469aab1867</data>
      <data key="d12">7969</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="GSDIB">
      <data key="d8">4.0</data>
      <data key="d9">Pancreatitis may develop as a complication in patients with GSDIb due to metabolic imbalances.</data>
      <data key="d10">a81765e6d24ccef0c86801f71673de98</data>
      <data key="d11">652951a803f24b5486ccc717754c5fa5</data>
      <data key="d12">7970</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="DIETA CETOG&#201;NICA">
      <data key="d8">3.0</data>
      <data key="d9">La pancreatitis es una complicaci&#243;n rara pero grave que se ha reportado en pacientes en dieta cetog&#233;nica.</data>
      <data key="d10">bf7fc15e1aac41553dc6586efe68b8cb</data>
      <data key="d11">36b66d5961694033be4f8529b0e2551f</data>
      <data key="d12">7971</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="DR. JOHN RANSON">
      <data key="d8">8.0</data>
      <data key="d9">Dr. John Ranson's criteria are used to evaluate the severity of pancreatitis and identify high-risk patients</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">f941dd511b1a47ecaf4e842c42f749e7</data>
      <data key="d12">7972</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="ACUTE PHYSIOLOGY AND CHRONIC HEALTH EVALUATION II">
      <data key="d8">7.0</data>
      <data key="d9">APACHE II is used to assess the severity of illness in patients with pancreatitis</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">9ec7df061ab947aeb8140a356086da85</data>
      <data key="d12">7973</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="PANCREATITIS ALCOHOLICA">
      <data key="d8">6.0</data>
      <data key="d9">Pancreatitis alcoholica is a specific type of pancreatitis caused by alcohol consumption</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">66cf3480938644878a1ae1711c8a7e8d</data>
      <data key="d12">7974</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="PANCREATITIS BILIAR">
      <data key="d8">6.0</data>
      <data key="d9">Pancreatitis biliar is a specific type of pancreatitis caused by gallstones</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">3dfaa14adb514057a3f048dc69d6d44b</data>
      <data key="d12">7975</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="BALTHAZAR CLASSIFICATION">
      <data key="d8">1.0</data>
      <data key="d9">The Balthazar classification is used to assess the severity of pancreatitis based on imaging findings</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">9601357df3c249e582807655c6b883c1</data>
      <data key="d12">7976</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="LEUCOCITOSIS">
      <data key="d8">7.0</data>
      <data key="d9">Leucocytosis is commonly observed in patients with pancreatitis as part of the inflammatory response</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">b820b369e55e496390bbea9d0b62be9a</data>
      <data key="d12">7977</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="HIPOCALCEMIA">
      <data key="d8">6.0</data>
      <data key="d9">Hypocalcemia can occur in patients with pancreatitis, indicating potential complications</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">04c72a2eb9cc40b18fccf10dcdfac696</data>
      <data key="d12">7978</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="HIPERGLUCEMIA">
      <data key="d8">6.0</data>
      <data key="d9">Hyperglycemia can be a complication in patients suffering from pancreatitis</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">8d6209eb8faa415c9e45272542ad6a9b</data>
      <data key="d12">7979</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="TOMOGRAF&#205;A COMPUTARIZADA">
      <data key="d8">8.0</data>
      <data key="d9">CT scans are used to confirm the diagnosis of pancreatitis and assess its severity</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">36eba3248ea0447db65a5f20815eb50a</data>
      <data key="d12">7980</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="ECOGRAF&#205;A ABDOMINAL">
      <data key="d8">1.0</data>
      <data key="d9">Abdominal ultrasound is recommended for all patients to detect alterations related to pancreatitis</data>
      <data key="d10">86aa5f95aae53ab120c5c63eda5486bc</data>
      <data key="d11">b84038a8c97140a98a491c0d943bb8f3</data>
      <data key="d12">7981</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="SECRETINA CCK">
      <data key="d8">7.0</data>
      <data key="d9">The secretina CCK test is used to evaluate pancreatic function in patients with pancreatitis</data>
      <data key="d10">32642463df83d3626d7a9c5acf121825</data>
      <data key="d11">1d4b6ecf64af491a9d230177ee922715</data>
      <data key="d12">7982</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="COBALAMINA">
      <data key="d8">6.0</data>
      <data key="d9">Patients with pancreatitis often experience malabsorption of cobalamin, leading to nutritional deficiencies</data>
      <data key="d10">32642463df83d3626d7a9c5acf121825</data>
      <data key="d11">d9392bb075bc44a88e042c69987f3d48</data>
      <data key="d12">7983</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PANCREATITIS" target="ALCOHOLISM">
      <data key="d8">8.0</data>
      <data key="d9">Pancreatitis is a condition that can be significantly influenced by alcoholism. Chronic alcoholism is recognized as a leading cause of chronic pancreatitis, highlighting the strong link between excessive alcohol consumption and the development of this inflammatory condition of the pancreas. Furthermore, alcoholism not only increases the risk of developing pancreatitis but also exacerbates the nutritional status of individuals, potentially complicating their overall health and recovery.</data>
      <data key="d10">32642463df83d3626d7a9c5acf121825,69bfdb98603d3d8c4733cb795f4c82f3</data>
      <data key="d11">fc31d2b4da9c4d259fa21e2b901a780b</data>
      <data key="d12">7984</data>
      <data key="d13">2</data>
