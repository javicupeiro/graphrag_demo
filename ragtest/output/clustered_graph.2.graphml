    </node>
    <node id="BARTTER SYNDROME">
      <data key="d0">EVENT</data>
      <data key="d1">Bartter syndrome is a group of rare kidney disorders that result in imbalances of electrolytes, including hypomagnesemia.</data>
      <data key="d2">b9342cecd69cdc0e9936df041657f5f5</data>
      <data key="d3">711</data>
      <data key="d4">2</data>
