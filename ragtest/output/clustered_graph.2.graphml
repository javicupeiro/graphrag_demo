      <data key="d10">caf14765027dbf6266841af0571a522e</data>
      <data key="d11">06b69fc56472440184ee1537a06fe71f</data>
      <data key="d12">4194</data>
      <data key="d13">2</data>
    </edge>
    <edge source="V&#211;MITOS" target="EPOC">
      <data key="d8">5.0</data>
      <data key="d9">Vomiting can be a symptom experienced by patients with EPOC, often related to gastrointestinal issues</data>
