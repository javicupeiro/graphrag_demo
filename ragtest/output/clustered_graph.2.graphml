      <data key="d7">0b203a8b9e124e3e9cf0dcd7f53f095f</data>
    </node>
    <node id="LEUCEMIA AGUDA NO LINFOBL&#193;STICA">
      <data key="d0">EVENT</data>
      <data key="d1">Leucemia aguda no linfobl&#225;stica refers to acute non-lymphoblastic leukemia, which can also lead to weight loss.</data>
      <data key="d2">b26b998479da515c234ce46b1bfa73db</data>
      <data key="d3">1316</data>
