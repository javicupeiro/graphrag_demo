      <data key="d6">13795</data>
      <data key="d7">c8be1d49798b4192949f513296e90192</data>
    </node>
    <node id="ANTINEOPLASTIC TREATMENT">
      <data key="d0">EVENT</data>
      <data key="d1">Antineoplastic treatment refers to therapies used to treat cancer, which can impact a patient's nutritional status and dietary needs.</data>
      <data key="d2">2194de4eaed685b07d8f4c7a397de0ce</data>
      <data key="d3">812</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13796</data>
      <data key="d7">ae95ba3b393c4cea857aa22f7664daf3</data>
    </node>
    <node id="MICROORGANISMS">
      <data key="d0">EVENT</data>
      <data key="d1">Microorganisms are tiny living organisms that can be beneficial or harmful, particularly relevant in the context of food safety for immunocompromised patients.</data>
      <data key="d2">2194de4eaed685b07d8f4c7a397de0ce</data>
      <data key="d5">1</data>
      <data key="d6">13797</data>
      <data key="d7">c956af3a42834282bf7b95f100649e25</data>
    </node>
    <node id="STERILIZATION">
      <data key="d0">EVENT</data>
      <data key="d1">Sterilization is a process used to eliminate all forms of life, including microorganisms, from utensils and equipment used in healthcare settings.</data>
      <data key="d2">2194de4eaed685b07d8f4c7a397de0ce</data>
      <data key="d5">1</data>
      <data key="d6">13798</data>
      <data key="d7">f514a95ea37d40aba9178afa061037e3</data>
    </node>
    <node id="UTENSILS">
      <data key="d0">EVENT</data>
      <data key="d1">Utensils refer to tools used for eating and serving food, which must be properly sanitized for patients with weakened immune systems.</data>
      <data key="d2">2194de4eaed685b07d8f4c7a397de0ce</data>
      <data key="d3">1266</data>
      <data key="d4">2</data>
