    <node id="DPP-4">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Dipeptidyl peptidase 4 (DPP-4) is an enzyme that inactivates incretin hormones, which are important for insulin regulation.</data>
      <data key="d2">630ac8fefe27e4b893831674a67dcc82</data>
      <data key="d3">987</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">4312</data>
