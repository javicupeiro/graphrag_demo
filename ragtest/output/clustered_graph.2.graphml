      <data key="d6">3279</data>
      <data key="d7">1a6181a6fe0f4a709f196a5eade618d1</data>
    </node>
    <node id="ANCIANOS FR&#193;GILES">
      <data key="d0">PERSON</data>
      <data key="d1">Frailty in elderly individuals refers to a state of increased vulnerability resulting from age-related decline in reserve and function.</data>
      <data key="d2">ef8194ca70c613876b927087bf7554f5</data>
      <data key="d3">687</data>
      <data key="d4">2</data>
