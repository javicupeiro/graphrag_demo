    </node>
    <node id="HEPATOPAT&#205;A SEVERA">
      <data key="d0">EVENT</data>
      <data key="d1">Severe liver disease is a condition that may require careful management of vitamin supplementation, particularly Vitamin A and K.</data>
      <data key="d2">a4886f74d848ccd61cefcaab3103f233</data>
      <data key="d3">612</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13031</data>
