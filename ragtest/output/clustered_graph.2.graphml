      <data key="d7">1323dd93687b47bda1351e1ac06256dd</data>
    </node>
    <node id="ANEXO 3">
      <data key="d0">DOCUMENT</data>
      <data key="d1">ANEXO 3 is a document that provides a subjective global assessment of nutritional status. It encompasses various aspects such as the individual's medical history, weight changes, dietary intake, gastrointestinal symptoms, functional capacity, and disease-related nutritional requirements.</data>
      <data key="d2">0bc48d0666e895b990c211acf7cbcf23,45628dcc866de3617e83105d66f901ad</data>
      <data key="d3">598</data>
