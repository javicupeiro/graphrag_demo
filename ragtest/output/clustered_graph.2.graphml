      <data key="d5">1</data>
      <data key="d6">9803</data>
      <data key="d7">4dce0ede4b8b486cb4745a77a151aa25</data>
    </node>
    <node id="SORGO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">SORGO, also known as sorghum, is a gluten-free cereal that is safe for individuals with celiac disease and those with gluten intolerance. It can be utilized in a variety of food products, making it a versatile option for those seeking gluten-free alternatives in their diet.</data>
      <data key="d2">8eef8cced3d7433de267e8e624813566,f713611b23199b8a9eb9c28377b9f128</data>
      <data key="d3">829</data>
