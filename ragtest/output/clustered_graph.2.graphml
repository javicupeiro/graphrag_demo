    </node>
    <node id="RITMO CIRCADIANO">
      <data key="d0">EVENT</data>
      <data key="d1">El ritmo circadiano puede verse alterado en pacientes con tumores de la gl&#225;ndula pineal, afectando su sue&#241;o y estado de alerta.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
      <data key="d3">1342</data>
      <data key="d4">2</data>
