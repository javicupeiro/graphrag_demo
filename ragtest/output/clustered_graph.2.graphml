    <node id="MODIFICACIONES EN EL PATR&#211;N HABITUAL DE INGESTA">
      <data key="d0">EVENT</data>
      <data key="d1">Las modificaciones en el patr&#243;n habitual de ingesta de alimentos son un factor a considerar en la evaluaci&#243;n del riesgo nutricional.</data>
      <data key="d2">cc6ee3d7bc9bfaf4a06f3f02c4907eb0</data>
      <data key="d3">1132</data>
