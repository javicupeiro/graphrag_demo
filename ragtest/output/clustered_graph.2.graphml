      <data key="d11">ad67309e5d9e4bf7ba927f281446673d</data>
      <data key="d12">3849</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ALIMENTOS" target="HEREDITARY FRUCTOSE INTOLERANCE">
      <data key="d8">7.0</data>
