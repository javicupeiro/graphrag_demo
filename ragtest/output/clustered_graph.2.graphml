    </node>
    <node id="DEPLETION">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional depletion refers to the state of lacking essential nutrients, which can be assessed through various parameters</data>
      <data key="d2">d66eff5b0a0e16993c167d3a6ffef395</data>
      <data key="d5">0</data>
      <data key="d6">13648</data>
