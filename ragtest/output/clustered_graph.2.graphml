    </node>
    <node id="HIPERFOSFATEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hiperfosfatemia is a condition characterized by elevated phosphate levels in the blood, often associated with kidney dysfunction.</data>
      <data key="d2">7ba4a7e7b4c409f6d4c6979a7de6c832</data>
      <data key="d3">1153</data>
      <data key="d4">2</data>
