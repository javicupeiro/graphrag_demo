      <data key="d9">Sarcopenia is a common complication in patients with cirrhosis, affecting their overall health</data>
      <data key="d10">025274b58725397020078dea52ea012b</data>
      <data key="d11">374aa7f8ef9f4b19bf4b635ccd917de4</data>
