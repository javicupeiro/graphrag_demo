    </node>
    <node id="PLANTAGO OVATA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Plantago ovata is a natural fiber supplement used as a bulk-forming laxative, commonly recommended for chronic constipation.</data>
      <data key="d2">dc8d12d9f32208671f6067b0bb64a645</data>
      <data key="d3">1110</data>
      <data key="d4">2</data>
