    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="MCT NM&#174;">
      <data key="d8">7.0</data>
      <data key="d9">MCT NM&#174; is appropriate for inclusion in nutritional parenteral solutions</data>
