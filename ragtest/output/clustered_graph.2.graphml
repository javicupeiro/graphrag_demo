    <node id="ENFERMEDAD POR REFLUJO REFRACCTARIA">
      <data key="d0">EVENT</data>
      <data key="d1">La enfermedad por reflujo refractaria es una condici&#243;n que no responde al tratamiento est&#225;ndar y puede requerir pruebas diagn&#243;sticas adicionales.</data>
