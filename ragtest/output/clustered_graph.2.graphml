    </node>
    <node id="ENTEROBACTER SPP">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Enterobacter spp. are bacteria that can cause infections associated with catheters.</data>
      <data key="d2">fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d3">766</data>
      <data key="d4">2</data>
