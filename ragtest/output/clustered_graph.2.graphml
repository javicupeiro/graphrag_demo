      <data key="d7">6bc0fde3fe1240e09716826c7c32f41c</data>
    </node>
    <node id="AGENTES FARMACOL&#211;GICOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Los agentes farmacol&#243;gicos son tratamientos utilizados en pacientes malnutridos para estimular el apetito y mejorar la funci&#243;n intestinal.</data>
      <data key="d2">a96b8f4fe52b5b963b28242c3352aa7c</data>
      <data key="d3">1099</data>
      <data key="d4">2</data>
