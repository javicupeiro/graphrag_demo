    </edge>
    <edge source="DIETA RICA EN FRUTAS Y VERDURAS" target="C&#193;NCER G&#193;STRICO">
      <data key="d8">6.0</data>
      <data key="d9">El consumo de frutas se asocia con una reducci&#243;n del riesgo de c&#225;ncer g&#225;strico</data>
