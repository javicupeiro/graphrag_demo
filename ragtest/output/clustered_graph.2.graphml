    </edge>
    <edge source="NUTRICI&#211;N ENTERAL" target="DI&#193;LISIS PERITONEAL">
      <data key="d8">6.0</data>
      <data key="d9">Patients undergoing peritoneal dialysis may also need enteral nutrition for adequate nutrient intake.</data>
      <data key="d10">00467cf9f31ccb0046bfd36ff48c4448</data>
      <data key="d11">36f469bf7ab146faa639b91411b261ad</data>
      <data key="d12">2640</data>
