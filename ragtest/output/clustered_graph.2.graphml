      <data key="d11">6833a18e58c942d2b2cc1d5d3bfc50c5</data>
      <data key="d12">6830</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="AMINO ACIDS">
      <data key="d8">7.0</data>
      <data key="d9">Patients with sepsis may benefit from specific amino acid supplementation</data>
      <data key="d10">cf34fdea5374cdee9a8be8f93c63e830</data>
      <data key="d11">fba290acba774dc8921c71474adfb727</data>
      <data key="d12">6831</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="PACIENTES QUEMADOS">
      <data key="d8">6.0</data>
      <data key="d9">La sepsis es una posible complicaci&#243;n en pacientes quemados que puede afectar su recuperaci&#243;n</data>
      <data key="d10">b3bff0edc314389f2ac432a753fec9f7</data>
      <data key="d11">80900c2558c94643a9d97cd97d86596a</data>
      <data key="d12">6832</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="REALIMENTACI&#211;N TRAS CIRUG&#205;A">
      <data key="d8">7.0</data>
      <data key="d9">Sepsis often complicates the process of reintroducing nutrition after surgery, requiring careful management.</data>
      <data key="d10">4a251705839547c8dcd0e9ddc5bb4066</data>
      <data key="d11">216a6cb5d7ef4b03b2ede3ca3ca5f95b</data>
      <data key="d12">6833</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="CVC">
      <data key="d8">9.0</data>
      <data key="d9">Sepsis can develop as a serious complication of infections associated with central venous catheters</data>
      <data key="d10">f79f02438413f5accef9ac5fbd96f6df</data>
      <data key="d11">c66037b3f7604b2bb91b2007f50201c9</data>
      <data key="d12">6834</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="STAPHYLOCOCCUS AUREUS">
      <data key="d8">17.0</data>
      <data key="d9">Staphylococcus aureus is a common pathogen that can lead to sepsis, especially in patients who have central venous catheters or other types of catheters. This bacterium is known for its ability to cause severe infections, and its presence in the bloodstream can result in a systemic inflammatory response, ultimately leading to sepsis.</data>
      <data key="d10">9fda43c414d32c5a8a3bb7354bfb1704,be901905a9eef428a784ea179931028a</data>
      <data key="d11">79d353ca8a2e465f8007a19ab10d6604</data>
      <data key="d12">6835</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="CAT&#201;TER VENOSO CENTRAL TUNELIZADO TIPO HICKMAN">
      <data key="d8">7.0</data>
      <data key="d9">The Hickman catheter can be a source of infection leading to sepsis in patients</data>
      <data key="d10">9fda43c414d32c5a8a3bb7354bfb1704</data>
      <data key="d11">14d6eb19ba7a49c49f972b59f527a8df</data>
      <data key="d12">6836</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="PANCREATITIS AGUDA">
      <data key="d8">9.0</data>
      <data key="d9">La sepsis puede desarrollarse como una complicaci&#243;n en pacientes con pancreatitis aguda, relacionada con la inflamaci&#243;n sist&#233;mica</data>
      <data key="d10">88dcf64f61e33adc3702b1ec401e2d4e</data>
      <data key="d11">decebe4823764e6b8c18b975146747ce</data>
      <data key="d12">6837</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="MALNUTRICI&#211;N">
      <data key="d8">6.0</data>
      <data key="d9">La sepsis puede incrementar los requerimientos nutricionales, lo que puede resultar en malnutrici&#243;n si no se maneja adecuadamente</data>
      <data key="d10">417548e99612a123d61f9fd10807ce34</data>
      <data key="d11">8487792e3e7b4647875a89efdb7a46c2</data>
      <data key="d12">6838</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="S&#205;NDROME DE INTESTINO CORTO">
      <data key="d8">7.0</data>
      <data key="d9">La sepsis es una complicaci&#243;n que puede ocurrir en pacientes con s&#237;ndrome de intestino corto, especialmente aquellos que reciben nutrici&#243;n parenteral</data>
      <data key="d10">ace4abd79441a61d6688d67db2dc0747</data>
      <data key="d11">b8c787789c4b4b68a7f183d4c87e73b7</data>
      <data key="d12">6839</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="CIRUG&#205;A">
      <data key="d8">1.0</data>
      <data key="d9">La sepsis puede ser una complicaci&#243;n post-cirug&#237;a que afecta el estado nutricional.</data>
      <data key="d10">9562f39f9e78644164daeff3177a2f84</data>
      <data key="d11">b9381aa19d7c41f184e990f3b9e8a7df</data>
      <data key="d12">6840</data>
      <data key="d13">2</data>
    </edge>
    <edge source="SEPSIS" target="ONCOLOGY NUTRITION FOR CLINICAL PRACTICE">
      <data key="d8">7.0</data>
      <data key="d9">The publication discusses the impact of sepsis on nutritional needs and energy expenditure</data>
      <data key="d10">ec94449c6ffff75664588262301de0a6</data>
      <data key="d11">bccf7a4071f24b1ba49f104c7d635050</data>
      <data key="d12">6841</data>
