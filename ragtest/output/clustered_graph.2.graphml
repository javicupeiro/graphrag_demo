      <data key="d11">11ceee926e0048fbbd1f057dbce546bd</data>
      <data key="d12">3897</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="NUTRITIONAL RISK SCREENING (NRS2002)">
      <data key="d8">7.0</data>
      <data key="d9">Both NRS2002 and MUST are tools used for screening malnutrition risk in clinical settings</data>
      <data key="d10">b422a0b87e2f7205a53dc0a5f1c0ab39</data>
      <data key="d11">7677e1236be649a4b131b9bfd63078e4</data>
      <data key="d12">3898</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="NUTRITIONAL ASSESSMENT">
      <data key="d8">1.0</data>
      <data key="d9">Nutritional assessment often incorporates tools like the MUST to evaluate malnutrition</data>
      <data key="d10">b422a0b87e2f7205a53dc0a5f1c0ab39</data>
      <data key="d11">b5bc9bbb08d54463b78fa4f743658f1b</data>
      <data key="d12">3899</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="ASPEN">
      <data key="d8">1.0</data>
      <data key="d9">ASPEN endorses the use of MUST for identifying malnutrition risk.</data>
      <data key="d10">17444b83ec19bdcc65ff0722869e7b4b</data>
      <data key="d11">764aff1fd10c4942a2e390f788bc6050</data>
      <data key="d12">3900</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="GERIATRIC NUTRITIONAL RISK INDEX">
      <data key="d8">5.0</data>
      <data key="d9">Both tools are designed to assess nutritional risk and predict outcomes in elderly patients</data>
      <data key="d10">07b1884f11a85f8feb424b7cc369f822</data>
      <data key="d11">6239684ca4f5429c91496830501cf15a</data>
      <data key="d12">3901</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="ELIA AND STRATTON">
      <data key="d8">1.0</data>
