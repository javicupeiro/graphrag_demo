      <data key="d6">15990</data>
      <data key="d7">37bab1bb588746b9aad9cae122274c2d</data>
    </node>
    <node id="CASE-MIX">
      <data key="d0">EVENT</data>
      <data key="d1">Case-mix is a method and system utilized in healthcare management to synthesize clinical processes into a single parameter, allowing for the evaluation of complexity in patient care. It categorizes patients based on the complexity of their conditions and the services they require, facilitating a more organized approach to managing healthcare resources and improving patient outcomes.</data>
      <data key="d2">22dcdc62dcda2e81a8707024945a4b01,26765fd0d663c8708d7bd6a545de3e2c</data>
      <data key="d3">857</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">15991</data>
      <data key="d7">ae904cca6b9d4774b1a73a521b20646a</data>
    </node>
    <node id="CONTRATOS DE GESTI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">Management contracts are agreements that define the responsibilities and financial arrangements between healthcare providers and funders.</data>
      <data key="d2">26765fd0d663c8708d7bd6a545de3e2c</data>
      <data key="d3">1272</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">15992</data>
      <data key="d7">80981822b2964ca5a3accceb7c805162</data>
    </node>
    <node id="OBJETIVOS DE CALIDAD ASISTENCIAL">
      <data key="d0">EVENT</data>
      <data key="d1">Quality care objectives are standards set to ensure that healthcare services meet certain quality benchmarks for patient care.</data>
      <data key="d2">26765fd0d663c8708d7bd6a545de3e2c</data>
      <data key="d3">749</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15993</data>
      <data key="d7">707d85950588480f9efe64436ebd0a2d</data>
    </node>
    <node id="INCENTIVOS ECON&#211;MICOS">
      <data key="d0">EVENT</data>
      <data key="d1">Economic incentives are financial rewards provided to healthcare professionals for meeting specific activity and quality objectives.</data>
      <data key="d2">26765fd0d663c8708d7bd6a545de3e2c</data>
      <data key="d3">749</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15994</data>
      <data key="d7">753ec38c5aad47d9a5fb944dcdbb230c</data>
    </node>
    <node id="LIMITACIONES DE CONTRATOS">
      <data key="d0">EVENT</data>
      <data key="d1">Limitations of contracts refer to the legal and practical challenges associated with management contracts in the healthcare system.</data>
      <data key="d2">26765fd0d663c8708d7bd6a545de3e2c</data>
      <data key="d3">1272</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15995</data>
      <data key="d7">10f5e4f37222419682c0c15577ccddcb</data>
    </node>
    <node id="UNIDADES DE COMPLEJIDAD HOSPITALARIA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Hospital Complexity Units (UCH) quantify healthcare activity based on case-mix and resource consumption.</data>
      <data key="d2">22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d3">857</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">15996</data>
      <data key="d7">8bef9678e0f44bc18ba23974fe1e019d</data>
    </node>
    <node id="UNIDADES PONDERADAS DE ASISTENCIA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Weighted Assistance Units (UPA) aim to standardize healthcare activity into a single parameter based on hospitalization days.</data>
      <data key="d2">22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d3">857</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15997</data>
      <data key="d7">5f87acb73c5e4d4390d6670b1ef6f698</data>
    </node>
    <node id="GESTI&#211;N CL&#205;NICA">
      <data key="d0">EVENT</data>
      <data key="d1">Clinical management refers to the organization and administration of healthcare services to ensure quality and efficiency.</data>
      <data key="d2">22dcdc62dcda2e81a8707024945a4b01</data>
      <data key="d3">857</data>
      <data key="d4">2</data>
