      <data key="d12">12514</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="METIRAPONA">
      <data key="d8">7.0</data>
      <data key="d9">Metirapone is used to treat Cushing's syndrome by blocking cortisol synthesis</data>
      <data key="d10">88a8ebb15abeea8eaded56ef3d2df73f</data>
      <data key="d11">d9681a4f63554436aceb09867adbe0ae</data>
      <data key="d12">12515</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="PASIREOTIDA">
      <data key="d8">15.0</data>
      <data key="d9">Cushing's syndrome is a condition characterized by excessive cortisol levels in the body. Pasireotida, also known as pasireotide, is a medication utilized in the treatment of Cushing's syndrome. It works by normalizing cortisol levels and managing the condition by reducing the secretion of adrenocorticotropic hormone (ACTH) from the pituitary gland. This dual action helps to alleviate the symptoms associated with Cushing's syndrome and restore hormonal balance.</data>
      <data key="d10">88a8ebb15abeea8eaded56ef3d2df73f,b2ca509109e853875e707e29a98391e0</data>
      <data key="d11">fb0ff60c98814c93ac39558ddfe5c317</data>
      <data key="d12">12516</data>
      <data key="d13">2</data>
    </edge>
