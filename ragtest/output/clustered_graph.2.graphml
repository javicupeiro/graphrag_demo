      <data key="d6">6092</data>
      <data key="d7">98d6400505d6469c8d1dca986580a227</data>
    </node>
    <node id="APO B DEFECTUOSA FAMILIAR">
      <data key="d0">EVENT</data>
      <data key="d1">Apo B defectuosa familiar is an autosomal dominant disorder that mimics hypercholesterolemia familiar due to a mutation affecting LDL receptor affinity.</data>
      <data key="d2">c3a9acd26c8b8bbe2144d4fe53046439</data>
      <data key="d5">0</data>
      <data key="d6">6093</data>
      <data key="d7">33a8307d6ada4d0e8fe5ad55a6d996d9</data>
    </node>
    <node id="SITOSTEROLEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Sitosterolemia is a rare lipid metabolism disorder resulting in the accumulation of plant sterols in the blood due to defective intestinal and hepatic excretion.</data>
      <data key="d2">c3a9acd26c8b8bbe2144d4fe53046439</data>
      <data key="d3">493</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">6094</data>
      <data key="d7">6a6e90f461d94abda6a754e8ac2394b2</data>
    </node>
    <node id="HYPERCHOLESTEROLEMIA FAMILIAR">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">c3a9acd26c8b8bbe2144d4fe53046439</data>
      <data key="d3">493</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">6095</data>
      <data key="d7">b4d4d1cdda2842758389dbb73ee621c8</data>
    </node>
    <node id="QUILOMICRONES">
      <data key="d0">EVENT</data>
      <data key="d1">QUILOMICRONES are large lipoprotein particles that originate in the intestine and are primarily composed of triglycerides. They play a crucial role in the transport of dietary lipids, including triglycerides and other fats, from the intestines to various tissues throughout the body. Additionally, quilomicrones can be involved in conditions such as hyperlipidemia, which is characterized by elevated levels of lipids in the blood. Overall, quilomicrones are essential for lipid transport and metabolism within the body.</data>
      <data key="d2">0f2aa9d202fbabe2b0f310000e6987e7,3c2bb3d9d6534668e58f571710c9bb02,5f7420a865ebf111326e5fc746c66c10,8938669dda86a6eafe0882ea036408c1,a9ee55a5371c88622e278b2543fa7317,e55f521d442f8ba50012b67d7051d39f,e9734d049699822c67b55a2a56aee7b2,ed97532e0b848baf08ee24448e340f98</data>
      <data key="d3">1804</data>
      <data key="d4">2</data>
      <data key="d5">11</data>
      <data key="d6">6096</data>
      <data key="d7">d6eb20cae6e14733af7de54124990d44</data>
    </node>
    <node id="APO B-100">
      <data key="d0">PERSON</data>
      <data key="d1">Apolipoprotein B-100 (Apo B-100) is a crucial protein involved in the metabolism of low-density lipoprotein (LDL) and is recognized by LDL receptors. It serves as the primary apolipoprotein of LDL, playing a vital role in lipid metabolism and transport.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10,e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">6097</data>
      <data key="d7">abb168d360834aecb39b209c23f05b1c</data>
    </node>
    <node id="APO B-48">
      <data key="d0">PERSON</data>
      <data key="d1">Apolipoprotein B-48 is the main apolipoprotein of VLDL, crucial for the metabolism of lipoproteins.</data>
      <data key="d2">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6098</data>
      <data key="d7">281d752cf9b7462fa669895525165f04</data>
    </node>
    <node id="LIPOPROTEINA LIPASA (LPL)">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Lipoprotein lipase (LPL) is an enzyme that hydrolyzes triglycerides in lipoproteins, facilitating the release of free fatty acids to tissues.</data>
      <data key="d2">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1804</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">6099</data>
      <data key="d7">6441ee0a960245789326795e1c7340b5</data>
    </node>
    <node id="TEJIDO ADIPOSO">
      <data key="d0">GEO</data>
      <data key="d1">TEJIDO ADIPOSO, or adipose tissue, is a type of connective tissue that serves as a crucial storage site for fat, playing a significant role in energy metabolism. It is involved in the storage and metabolism of energy, with its functions being influenced by the gut microbiota and various signaling molecules. Adipose tissue receives fatty acids released from lipoproteins, further contributing to its role in lipid storage and overall energy balance in the body.</data>
      <data key="d2">9538d3f95062fd16213d9c718bb42872,e55f521d442f8ba50012b67d7051d39f,e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1804</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">6100</data>
      <data key="d7">f37d8dc8574645a3b495d8596460af2e</data>
    </node>
    <node id="MUSCULO ESQUELETICO">
      <data key="d0">GEO</data>
      <data key="d1">Skeletal muscle is a site of utilization for fatty acids released from lipoproteins.</data>
      <data key="d2">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1804</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6101</data>
      <data key="d7">a83a9d7013c74acebe7d786fca78b97f</data>
    </node>
    <node id="IDLS">
      <data key="d0">EVENT</data>
      <data key="d1">Intermediate-density lipoproteins (IDLs) are formed during the metabolism of VLDL and are involved in lipid transport.</data>
      <data key="d2">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6102</data>
      <data key="d7">50bafeb57b8143a89731946e07eb8c5f</data>
    </node>
    <node id="LDLS">
      <data key="d0">EVENT</data>
      <data key="d1">Low-density lipoproteins (LDLs) are the final product of the VLDL-IDL-LDL metabolic cascade, primarily transporting cholesterol to cells.</data>
      <data key="d2">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">6103</data>
      <data key="d7">33d74915b0794873bc66f50412dae710</data>
    </node>
    <node id="HDLS">
      <data key="d0">EVENT</data>
      <data key="d1">High-density lipoproteins (HDLs) are involved in reverse cholesterol transport and are synthesized from the catabolism of VLDL.</data>
      <data key="d2">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6104</data>
      <data key="d7">02c7fec7fd1e4f60bed4bbf19e15eb5b</data>
    </node>
    <node id="VLDL">
      <data key="d0" />
      <data key="d1">VLDL, or Very Low-Density Lipoprotein, are a type of lipoprotein produced by the liver. They play a crucial role in lipid metabolism by transporting triglycerides and cholesterol from the liver to various tissues in the body. VLDL is particularly associated with conditions such as combined familial hyperlipidemia, which is characterized by elevated levels of lipids in the blood. Overall, VLDL are essential for the distribution of lipids throughout the body, facilitating the delivery of energy and structural components to cells.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10,8938669dda86a6eafe0882ea036408c1,e55f521d442f8ba50012b67d7051d39f,e9734d049699822c67b55a2a56aee7b2,ed97532e0b848baf08ee24448e340f98</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">12</data>
      <data key="d6">6105</data>
      <data key="d7">3ef6db3c03184ffe92e0f53259983fb4</data>
    </node>
    <node id="APOLIPOPROTEINAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Apolipoproteins are proteins that bind lipids to form lipoproteins, playing critical roles in lipid metabolism.</data>
      <data key="d2">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6106</data>
      <data key="d7">90e11fc54338425db7ccda97c7ede801</data>
    </node>
    <node id="TRIGLICERIDOS">
      <data key="d0">EVENT</data>
      <data key="d1">Trigliceridos, also known as triglycerides, are a type of fat found in the blood that play a crucial role in energy storage and metabolism. They are the main type of fat in the body and serve as a significant energy source, as well as being a component of lipid solutions and lipoproteins. The levels of triglycerides are particularly important to monitor in patients receiving lipid infusions during parenteral nutrition, highlighting their relevance in clinical settings. Overall, triglycerides are essential for various bodily functions, including energy provision and the formation of important biological molecules.</data>
      <data key="d2">6289e9e0b5871fb9a2f2f691429bb4f8,bb7584256e051f1c3d8cb13502ade155,e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1804</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">6107</data>
      <data key="d7">de27bef509f04414a201ee0a74285fe8</data>
    </node>
    <node id="LIPOPROTEINAS">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">e9734d049699822c67b55a2a56aee7b2</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">6108</data>
      <data key="d7">67edd2482a794ba68e40f5d4d706f39a</data>
    </node>
    <node id="&#193;CIDO NICOT&#205;NICO">
      <data key="d0">PERSON</data>
      <data key="d1">&#193;cido nicot&#237;nico, also known as nicotinic acid, is a medication that has been utilized for over 40 years in the treatment of dyslipidemia. It primarily functions by decreasing the production and release of very low-density lipoprotein (VLDL), which is crucial for managing lipid levels in the body. Additionally, nicotinic acid can be used in conjunction with fibrates to effectively lower triglyceride levels, further supporting its role in lipid management.</data>
      <data key="d2">64476b3e50fca7a5cbcb70822bd1be63,75a4b2d504de480eaef247aa682bfd05</data>
      <data key="d3">1487</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6109</data>
      <data key="d7">e9a4397d9b8247f4951a2c2d31b0d930</data>
    </node>
    <node id="MANUAL DE NUTRICI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">The Manual de Nutrici&#243;n is a publication that includes guidelines and information on nutrition and metabolism, published by the Sociedad Espa&#241;ola de Endocrinolog&#237;a y Nutrici&#243;n.</data>
      <data key="d2">64476b3e50fca7a5cbcb70822bd1be63</data>
      <data key="d3">1457</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6110</data>
      <data key="d7">1ba7f69f465543eb8bc8ec436a04c865</data>
    </node>
    <node id="AACE/ACE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The AACE/ACE refers to the American Association of Clinical Endocrinology and the American College of Endocrinology, organizations that provide guidelines for managing dyslipidemia and cardiovascular disease.</data>
      <data key="d2">64476b3e50fca7a5cbcb70822bd1be63</data>
      <data key="d3">1487</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6111</data>
      <data key="d7">b7d062d8bd684b6fa56984a458e935a8</data>
    </node>
    <node id="HMG-COA REDUCTASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">HMG-CoA reductase is an enzyme that plays a crucial role in cholesterol biosynthesis and is the target of statin medications.</data>
      <data key="d2">746fad557197bebe72763efd23a9e0e2</data>
      <data key="d3">1488</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6112</data>
      <data key="d7">5b9d044672a348f9ba860130015f18ed</data>
    </node>
    <node id="HIPERLIPIDEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hiperlipidemia refers to elevated levels of lipids in the blood, which is a condition treated with various medications including statins and fibrates.</data>
      <data key="d2">746fad557197bebe72763efd23a9e0e2</data>
      <data key="d3">1488</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">6113</data>
      <data key="d7">79566462699841ceaf3e185174d15650</data>
    </node>
    <node id="HYPERTRIGLYCERIDEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">HYPERTRIGLYCERIDEMIA is a medical condition characterized by elevated levels of triglycerides in the blood. This condition can pose significant health risks, including an increased likelihood of pancreatitis and cardiovascular issues. Management of hypertriglyceridemia can be achieved through dietary supplementation, including the use of medium-chain triglycerides (MCTs), which may help improve triglyceride levels. Overall, hypertriglyceridemia is associated with various health complications, making its management important for maintaining overall health.</data>
      <data key="d2">6935432f69970131a6485f38e3f06003,9312fdfba5d3f79b95c5e6af38ced009,9a0227d0ea548fa46814e6403be885ce,9f5a8d86160d5d097bca174e2e2496c1,e1766b4a9f6cff776650a29195cee9fc</data>
      <data key="d3">1631</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">6114</data>
      <data key="d7">a66a657acbf8467ebb5e10f529f30206</data>
    </node>
    <node id="LIPOPROTE&#205;NA LIPASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Lipoprote&#237;na lipasa is an enzyme that plays a crucial role in lipid metabolism, specifically in the breakdown of triglycerides. It facilitates the hydrolysis of triglycerides in lipoproteins such as chylomicrons and very low-density lipoproteins (VLDL). This enzyme is essential for the metabolism of triglycerides and is involved in the processing of lipoproteins in the bloodstream, highlighting its importance in maintaining lipid homeostasis.</data>
      <data key="d2">8938669dda86a6eafe0882ea036408c1,9312fdfba5d3f79b95c5e6af38ced009</data>
      <data key="d3">1803</data>
      <data key="d4">2</data>
      <data key="d5">10</data>
      <data key="d6">6115</data>
      <data key="d7">9e9211ed501d47f7b9965863bba73d44</data>
    </node>
    <node id="CITOCROMO P450">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Cytochrome P450 is a family of enzymes that play a crucial role in the metabolism of a wide variety of drugs, including statins, which can influence their efficacy and safety. These enzymes are primarily located in the liver, where they facilitate the metabolic processes necessary for drug processing and elimination from the body.</data>
      <data key="d2">18d237ccee6cf99bff4690087156025a,9312fdfba5d3f79b95c5e6af38ced009</data>
      <data key="d3">359</data>
      <data key="d4">1</data>
      <data key="d5">5</data>
      <data key="d6">6116</data>
      <data key="d7">ffc22851383846bfae07a483e6bc8f97</data>
    </node>
    <node id="MIALGIAS">
      <data key="d0">EVENT</data>
      <data key="d1">Myalgias refer to muscle pain that can occur as a side effect of statin use, often without elevated creatine kinase levels.</data>
      <data key="d2">9312fdfba5d3f79b95c5e6af38ced009</data>
      <data key="d3">1488</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6117</data>
      <data key="d7">cb118120628445168f73bf974646d299</data>
    </node>
    <node id="MIOPAT&#205;A">
      <data key="d0">EVENT</data>
      <data key="d1">MIOPAT&#205;A refers to a condition characterized by muscle weakness and pain, which can manifest as a result of various underlying issues, including disorders related to the &#946;-oxidation of fatty acids. Additionally, myopathy can occur as a side effect of statin medications, which are commonly used to lower cholesterol levels. This condition highlights the importance of understanding the different causes and implications of muscle-related diseases.</data>
      <data key="d2">2f96bbc5eafd39b659620da7282a2079,9312fdfba5d3f79b95c5e6af38ced009</data>
      <data key="d3">1490</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">6118</data>
      <data key="d7">7fa5b0ea268747e7b10d04d3c127f2f0</data>
    </node>
    <node id="APO C-II">
      <data key="d0">PERSON</data>
      <data key="d1">Apolipoprotein C-II (Apo C-II) is a crucial cofactor that plays an essential role in the activation of lipoprotein lipase. This protein associates with lipoproteins and is vital for the metabolism of triglycerides, facilitating the breakdown and utilization of these fats in the body.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10,8938669dda86a6eafe0882ea036408c1</data>
      <data key="d3">1803</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6119</data>
      <data key="d7">b7396a241001449a9b261cc507ae7376</data>
    </node>
    <node id="HEPATOMEGALIA">
      <data key="d0">EVENT</data>
      <data key="d1">Hepatomegalia is a clinical condition characterized by the enlargement of the liver. This condition can manifest as a result of various metabolic disorders, including a deficiency in lipoprotein lipase. It is commonly associated with glycogen storage diseases (GSD), particularly GSDIII, and can be observed in children suffering from these conditions. Additionally, hepatomegalia may also be a symptom of Wilson's disease, highlighting its relevance in a range of hepatic disorders. Overall, hepatomegalia serves as an important clinical indicator of underlying metabolic issues affecting liver function.</data>
      <data key="d2">8938669dda86a6eafe0882ea036408c1,a3d834f1d854ecde12e808ae924b8eb0,b5e899a3def3da339630eb0d2bfe4af8,ea816809115cc37c571bd36191042123,eb1f89320202c337496dbad5ca168356,eb8877823f796fc9a02f5103dc4650cc</data>
      <data key="d3">1715</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">6120</data>
      <data key="d7">cc490542856a4ca68f8085646549be85</data>
    </node>
    <node id="ESPLENOMEGALIA">
      <data key="d0">EVENT</data>
      <data key="d1">Esplenomegalia, tambi&#233;n conocida como agrandamiento del bazo, es una condici&#243;n que puede estar asociada con trastornos metab&#243;licos y la acumulaci&#243;n de l&#237;pidos en el cuerpo. Esta afecci&#243;n puede desarrollarse en adultos que est&#225;n recibiendo tratamiento con factores estimulantes de colonias, lo que puede afectar su salud.</data>
      <data key="d2">76287e9b94faab94755c56fead3541d7,8938669dda86a6eafe0882ea036408c1</data>
      <data key="d3">1803</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6121</data>
      <data key="d7">284430830326482eb6c6a5a15555d6c6</data>
    </node>
    <node id="DISLIPIDEMIAS">
      <data key="d0">EVENT</data>
      <data key="d1">Las dislipidemias son trastornos que afectan los niveles de l&#237;pidos en la sangre, incluyendo hipertrigliceridemia y otros desequilibrios lip&#237;dicos.</data>
      <data key="d2">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d3">1803</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6122</data>
      <data key="d7">6fc7fd9944c544db9673aadaede88b00</data>
    </node>
    <node id="QUILOMICRONEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">La quilomicronemia es una condici&#243;n caracterizada por niveles elevados de quilomicrones en la sangre, a menudo debido a un d&#233;ficit de lipoprote&#237;na lipasa.</data>
      <data key="d2">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d3">1803</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6123</data>
      <data key="d7">84a0b98f4cf949d0a1329ea248e17ac8</data>
    </node>
    <node id="APO V">
      <data key="d0">PERSON</data>
      <data key="d1">Apolipoprote&#237;na V es una prote&#237;na que se asocia con lipoprote&#237;nas y tiene un papel en la uni&#243;n de VLDL y quilomicrones con lipoprote&#237;na lipasa.</data>
      <data key="d2">8938669dda86a6eafe0882ea036408c1</data>
      <data key="d3">1803</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6124</data>
      <data key="d7">88e6f3bde5f84411b03c611dbf1c27a4</data>
    </node>
    <node id="OREA SOLER I">
      <data key="d0">PERSON</data>
      <data key="d1">Orea Soler I is an author of the Manual de Endocrinolog&#237;a y Nutrici&#243;n, which discusses lipid metabolism in healthy individuals.</data>
      <data key="d2">e55f521d442f8ba50012b67d7051d39f</data>
      <data key="d3">1456</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6125</data>
      <data key="d7">26430ff4165d48208194203e4a4e0ed0</data>
    </node>
    <node id="ILL&#193;N G&#211;MEZ F">
      <data key="d0">PERSON</data>
      <data key="d1">Ill&#225;n G&#243;mez F is a co-author of the Manual de Endocrinolog&#237;a y Nutrici&#243;n, contributing to the chapter on lipid metabolism.</data>
      <data key="d2">e55f521d442f8ba50012b67d7051d39f</data>
      <data key="d3">1456</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6126</data>
      <data key="d7">c00157cdf99447ceb2ce1cf113342a7c</data>
    </node>
    <node id="LIPASA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">LIPASA is an enzyme that plays a vital role in lipid metabolism by catalyzing the hydrolysis of fats. It is essential for breaking down fats in the digestive system, making it particularly important for individuals with conditions such as cystic fibrosis, where it is often included in pancreatic enzyme preparations to aid digestion.</data>
      <data key="d2">028c43c3f0f3d1f8085eed8518636f97,e55f521d442f8ba50012b67d7051d39f</data>
      <data key="d3">1364</data>
      <data key="d4">2</data>
      <data key="d5">8</data>
      <data key="d6">6127</data>
      <data key="d7">0998acf5c4774493867a817d93753a86</data>
    </node>
    <node id="IDL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">IDL (Intermediate-Density Lipoprotein) are lipoproteins that are formed from the metabolism of VLDL and are involved in cholesterol transport.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">6128</data>
      <data key="d7">171317083aad4f449a454b1bf0c13788</data>
    </node>
    <node id="LDL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">LDL (Low-Density Lipoprotein) are the final product of the metabolic cascade VLDL-IDL-LDL, primarily responsible for transporting cholesterol to cells.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">6129</data>
      <data key="d7">4f10b4725bff402f9b001243bda0a067</data>
    </node>
    <node id="LPL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Lipoprotein Lipase (LPL) is an enzyme that hydrolyzes triglycerides in lipoproteins, facilitating the release of free fatty acids for tissue use and storage.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d3">1803</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6130</data>
      <data key="d7">1dd57037a83c4e8a82d6fc9b22de283d</data>
    </node>
    <node id="APO E">
      <data key="d0">PERSON</data>
      <data key="d1">Apolipoprotein E (Apo E) is a protein involved in the clearance of lipoproteins from the bloodstream, particularly in the metabolism of IDL and chylomicron remnants.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6131</data>
      <data key="d7">653542a1327240f2bf9eaf8ac5b93e46</data>
    </node>
    <node id="PCSK9">
      <data key="d0">PERSON</data>
      <data key="d1">Proprotein Convertase Subtilisin/Kexin Type 9 (PCSK9) is a protein that regulates LDL receptor levels and is involved in cholesterol metabolism.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d3">1802</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6132</data>
      <data key="d7">ba25a5ad8ba642f585c3ddda73c363ed</data>
    </node>
    <node id="DIETA DASH">
      <data key="d0">EVENT</data>
      <data key="d1">The DASH (Dietary Approaches to Stop Hypertension) diet is a dietary plan aimed at reducing hypertension and improving overall health, which may also affect lipid levels.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d3">1377</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6133</data>
      <data key="d7">b01be4bc8412445b8d837eb636efd1f0</data>
    </node>
    <node id="&#193;CIDOS GRASOS POLIINSATURADOS">
      <data key="d0">EVENT</data>
      <data key="d1">&#193;cidos grasos poliinsaturados are essential fats that play a significant role in promoting cardiovascular health. These fats, which include omega-3 and omega-6 fatty acids, are found in various food sources and are recognized for their beneficial effects on heart health. Dietary guidelines recommend the inclusion of polyunsaturated fatty acids in moderation as part of a healthy diet, highlighting their importance in maintaining overall well-being.</data>
      <data key="d2">0090177678aee58d08471d09d24d2842,5f7420a865ebf111326e5fc746c66c10,844d065cac5f5304fffed35b5da90416,c78125c02ea4d5afdf5cb5ac4baeeb27,e0227f83ebee602b6c9d7163630e495e</data>
      <data key="d3">1377</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">6134</data>
      <data key="d7">603a2bdbdce24c14b9ed8949a6312c63</data>
    </node>
    <node id="HIDROLIZADAS">
      <data key="d0">EVENT</data>
      <data key="d1">The process of hydrolysis refers to the breakdown of triglycerides in lipoproteins by enzymes such as LPL.</data>
      <data key="d2">5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d3">1804</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6135</data>
      <data key="d7">f8600f0c6a9c4a7a8d55ed241b891da1</data>
    </node>
    <node id="SOCIETAD ESPA&#209;OLA DE ARTERIOSCLEROSIS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The "Sociedad Espa&#241;ola de Arteriosclerosis" is an organization dedicated to promoting cardiovascular health through the establishment of dietary recommendations. It provides guidelines and classifications for foods, specifically focusing on their impact on lipid levels. This dual approach emphasizes the importance of nutrition in managing and preventing atherosclerosis and related cardiovascular conditions.</data>
      <data key="d2">5b88c6556b90149ce0c0cea0bead7448,5f7420a865ebf111326e5fc746c66c10</data>
      <data key="d3">1378</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">6136</data>
      <data key="d7">8d3573edc060471caec8c4c3a66b3ca5</data>
    </node>
    <node id="PREDIMED">
      <data key="d0">EVENT</data>
      <data key="d1">PREDIMED is a large-scale clinical trial conducted in Spain that investigates the effects of the Mediterranean diet, particularly one enriched with olive oil and nuts, on cardiovascular health and other health outcomes. The study involves 7,447 subjects and focuses on the impact of this diet on cardiovascular disease, diabetes, and other chronic conditions. PREDIMED evaluates adherence to the Mediterranean diet through specific questionnaires and dietary history assessments. It also observes the consumption of more than 500 mg of EPA-DHA to assess its benefits on heart attacks and mortality. Additionally, the study highlights the advantages of virgin olive oil and nut fats within the Mediterranean diet for the prevention of cardiovascular events. Overall, PREDIMED aims to demonstrate the health benefits associated with the Mediterranean diet, particularly for individuals at risk for diabetes and cardiovascular diseases.</data>
      <data key="d2">0090177678aee58d08471d09d24d2842,1388342730ee9177144f78f9e9d7816e,1ad5b4d7f49ca2d3d44adc99227f07d8,41d7db510fc74d3763959481cc15ea20,52bc63fdc8f15b328d9033bca7021363,633a3a90a82e02d05096b361ddba3ad7,a739523b87def5cdfa8fe97cdf423fe7,c78125c02ea4d5afdf5cb5ac4baeeb27,c9a02c0d93ca431827b63d51ae564670,e04e16f606e0bc5eeb59e2d5388ab061,f14ec70726a24a574ae5d437903fddb8,f41688eecb31d8e55fc70e993e99c3e9,f558c372d16630f14b614e232fc151de</data>
      <data key="d3">1376</data>
      <data key="d4">2</data>
      <data key="d5">20</data>
      <data key="d6">6137</data>
      <data key="d7">854df7eb51854e93960fbb4daa9ec9e2</data>
    </node>
    <node id="EUROPEAN SOCIETY OF CARDIOLOGY">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The European Society of Cardiology (ESC) is a professional organization dedicated to the management and reduction of cardiovascular diseases in Europe. It provides comprehensive guidelines and recommendations for the treatment of various cardiovascular conditions, including dyslipidemia. The ESC focuses on enhancing education and promoting research to address the burden of cardiovascular diseases across the continent. Through its initiatives, the organization aims to improve patient outcomes and advance the field of cardiology.</data>
      <data key="d2">14b7a8c27778bb8821d74790cd2da5ea,c78125c02ea4d5afdf5cb5ac4baeeb27,e032cf926bee7048e207a0e28604f60e</data>
      <data key="d3">1408</data>
      <data key="d4">2</data>
      <data key="d5">9</data>
      <data key="d6">6138</data>
      <data key="d7">754a933ebe0441d1a171babbcb4ba7a7</data>
    </node>
    <node id="EUROPEAN SOCIETY OF ATHEROSCLEROSIS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The European Society of Atherosclerosis is a professional organization focused on the study and treatment of atherosclerosis and related cardiovascular conditions.</data>
      <data key="d2">c78125c02ea4d5afdf5cb5ac4baeeb27</data>
      <data key="d3">1376</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6139</data>
      <data key="d7">59a1fcd2ab99484ab26daeb8d509a7fb</data>
    </node>
    <node id="HIPERLIPIDEMIA COMBINADA">
      <data key="d0">EVENT</data>
      <data key="d1">Hiperlipidemia combinada is a condition involving elevated levels of different types of lipids in the blood, often requiring treatment with medications like statins.</data>
      <data key="d2">c78125c02ea4d5afdf5cb5ac4baeeb27</data>
      <data key="d3">1488</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">6140</data>
      <data key="d7">d4cf9a5305d0409cb7e51ef1bfd95df4</data>
    </node>
    <node id="GRASAS TRANS">
      <data key="d0" />
      <data key="d1">GRASAS TRANS, or trans fats, are a type of fat that is generally avoided in the Mediterranean diet due to their harmful effects on health. These fats have been linked to an increased risk of cardiovascular diseases and other health issues. Dietary guidelines recommend avoiding trans fats because of their negative impact on heart health.</data>
      <data key="d2">01302d2656a8cbb49cb7505b3182cc63,633a3a90a82e02d05096b361ddba3ad7,c78125c02ea4d5afdf5cb5ac4baeeb27,dcb29ef57f2b65cd420e728a3e29102d</data>
      <data key="d3">1378</data>
      <data key="d4">2</data>
      <data key="d5">6</data>
      <data key="d6">6141</data>
      <data key="d7">c138c3f84c52412989dfd1ebad4ec209</data>
    </node>
    <node id="CARDIOVASCULAR SALUD">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">c78125c02ea4d5afdf5cb5ac4baeeb27</data>
      <data key="d3">1377</data>
