      <data key="d5">1</data>
      <data key="d6">469</data>
      <data key="d7">757e7eff21d14fddb3cb2bf363708aae</data>
    </node>
    <node id="CIPLINARES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ciplinare is an organization involved in the analysis and diagnosis of swallowing phases using instrumental tests.</data>
      <data key="d2">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d3">943</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">470</data>
      <data key="d7">ec38a2f7e96a40748610354f2be1ae1d</data>
    </node>
    <node id="PHARYNGEAL PHASE">
      <data key="d0">EVENT</data>
      <data key="d1">The pharyngeal phase is the stage of swallowing that follows the oral phase, involving the movement of the bolus through the pharynx.</data>
      <data key="d2">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d3">1533</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">471</data>
      <data key="d7">4a52046fdae042458d22ab60640f6ca6</data>
    </node>
    <node id="APRAKSI">
      <data key="d0">EVENT</data>
      <data key="d1">Apraxia is a condition that affects the ability to manage the bolus in the oral cavity.</data>
      <data key="d2">371e848e9da77bf71f58614d1265aff8</data>
      <data key="d3">943</data>
      <data key="d4">2</data>
