    </node>
    <node id="MANIOBRA SUPRAGL&#211;TICA">
      <data key="d0">EVENT</data>
      <data key="d1">A swallowing maneuver that requires holding one's breath while swallowing to protect the airway.</data>
      <data key="d2">c2b8f7ec7ed3d06b96620951376b640a</data>
