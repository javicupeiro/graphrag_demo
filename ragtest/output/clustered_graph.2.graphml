      <data key="d6">13409</data>
      <data key="d7">26f959d51e104c4ea9c30b2f25a1a4fa</data>
    </node>
    <node id="PREOPERATIVE IMMUNONUTRITION">
      <data key="d0">EVENT</data>
      <data key="d1">A nutritional strategy applied before surgery to improve outcomes for patients undergoing gastrointestinal surgery.</data>
      <data key="d2">0a742cf103e30cf0fadaf6ffabbbde2d</data>
      <data key="d3">742</data>
