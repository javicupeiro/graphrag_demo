      <data key="d10">439efa4d64a3de0b12975ea727c939f4</data>
      <data key="d11">e5bcc146347943c6ba4f02b2cac71bcd</data>
      <data key="d12">13272</data>
      <data key="d13">2</data>
    </edge>
    <edge source="M&#218;SCULO" target="GLUC&#211;GENO STORAGE DISEASE">
      <data key="d8">1.0</data>
