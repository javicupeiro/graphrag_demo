    <node id="LEUCEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">La leucemia es un tipo de c&#225;ncer que afecta a las c&#233;lulas sangu&#237;neas y que puede ser tratada mediante trasplante de c&#233;lulas hematol&#243;gicas.</data>
