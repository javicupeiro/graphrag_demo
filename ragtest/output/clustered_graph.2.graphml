      <data key="d10">9da930839072b524410f2345ab1df8b1</data>
      <data key="d11">a68f907d7723420bbd1a9d99edbe90b1</data>
      <data key="d12">10454</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PHOSPHORUS" target="OSTEOPOROSIS">
      <data key="d8">9.0</data>
      <data key="d9">Phosphorus plays a role in bone health, and its balance is crucial in preventing osteoporosis</data>
      <data key="d10">4a59488a9440b38afba989ca88d49ca3</data>
