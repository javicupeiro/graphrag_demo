    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="D3">
      <data key="d8">8.0</data>
      <data key="d9">D3 is included in parenteral nutrition to support calcium absorption and bone health</data>
      <data key="d10">f757d4ff813fdf7b43b3382e7e1bd69c</data>
      <data key="d11">6f005418fdc2407ea072a3f89d93ecd0</data>
      <data key="d12">4709</data>
