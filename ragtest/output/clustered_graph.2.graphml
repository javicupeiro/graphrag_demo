      <data key="d0">EVENT</data>
      <data key="d1">El algoritmo del manejo nutricional de la pancreatitis aguda es una gu&#237;a adaptada para el tratamiento nutricional de pacientes con esta condici&#243;n.</data>
      <data key="d2">be7eb01a6daf673db6a127f66c79c96c</data>
      <data key="d3">1090</data>
      <data key="d4">2</data>
