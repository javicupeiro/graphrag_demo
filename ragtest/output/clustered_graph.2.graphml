      <data key="d6">12899</data>
      <data key="d7">9ec95282dbeb4373a64356041221f4d2</data>
    </node>
    <node id="PEPTIDIC FORMULAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Peptidic formulas are specialized nutritional preparations that may be considered for patients with malabsorption or poor response to standard fiber formulas.</data>
      <data key="d2">8d9c5b85d058d0d3cde4479b5589a7d1</data>
      <data key="d3">1214</data>
      <data key="d4">2</data>
