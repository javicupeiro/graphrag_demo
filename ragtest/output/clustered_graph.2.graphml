    </edge>
    <edge source="ENFERMEDAD CARDIOVASCULAR" target="ACIDOS GRASOS TRANS">
      <data key="d8">8.0</data>
      <data key="d9">Trans fatty acids are associated with a higher risk of developing cardiovascular disease</data>
