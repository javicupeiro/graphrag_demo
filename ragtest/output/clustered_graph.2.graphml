      <data key="d8">6.0</data>
      <data key="d9">The multicenter randomized study evaluated treatments for patients with Cushing's syndrome</data>
      <data key="d10">9ff14a3c49bd56b2fb12b3fd8ed246de</data>
      <data key="d11">738fa8980c87450eab860e21a70e4ea2</data>
      <data key="d12">12530</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CUSHING'S SYNDROME" target="PETROSAL SINUS CATHETERIZATION">
      <data key="d8">9.0</data>
      <data key="d9">Petrosal sinus catheterization is a key diagnostic procedure for identifying the source of ACTH in Cushing's syndrome</data>
      <data key="d10">9ff14a3c49bd56b2fb12b3fd8ed246de</data>
