    <node id="S&#205;NDROME DE GITELMAN">
      <data key="d0">EVENT</data>
      <data key="d1">El s&#237;ndrome de Gitelman es un trastorno gen&#233;tico que afecta la reabsorci&#243;n de electrolitos en los ri&#241;ones, similar al s&#237;ndrome de Bartter.</data>
      <data key="d2">473502714ce73073f93b598ca0edcc21</data>
