      <data key="d8">6.0</data>
      <data key="d9">The American Journal of Medical Sciences includes research on hyperglycemia and its implications in medical treatment.</data>
      <data key="d10">64378df2be6b08b39bd652c0a2d3789c</data>
      <data key="d11">a060272e06cf47a886df252948935b92</data>
      <data key="d12">9780</data>
