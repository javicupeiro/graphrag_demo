    <edge source="PACIENTE" target="OBESIDAD M&#211;RBIDA">
      <data key="d8">35.0</data>
      <data key="d9">The patient is classified as suffering from morbid obesity, a significant health concern that has necessitated the consideration of surgical options. This condition led to the decision to perform bariatric surgery as an intervention to address her obesity.</data>
      <data key="d10">5a0d6adfbef59dd174ade59071dd9aa5,67f96f3e5c366f82de31f1bf189aa71f,e70fa2e099766154321f13c0112d436a,efe29025266e1689abb9b0a2783e5ea3</data>
