      <data key="d5">1</data>
      <data key="d6">3797</data>
      <data key="d7">bc8ce31e079b4745b586360e9276e5f3</data>
    </node>
    <node id="PPTG">
      <data key="d0">PERSON</data>
      <data key="d1">PPTG es una prote&#237;na que se ha relacionado con la regulaci&#243;n del ciclo celular y adenomas hipofisarios.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
