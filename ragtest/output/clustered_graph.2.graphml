      <data key="d8">7.0</data>
      <data key="d9">Reci&#233;n nacidos pret&#233;rmino may receive iron supplementation to address their specific nutritional needs</data>
      <data key="d10">fa356397bc52582bdbbd1868639feec9</data>
      <data key="d11">1f32b1a7f5f64a3d808e6bcd0b3e5261</data>
      <data key="d12">8648</data>
      <data key="d13">2</data>
    </edge>
