    </edge>
    <edge source="LACTANTES" target="DIETARY REFERENCE INTAKES">
      <data key="d8">7.0</data>
      <data key="d9">Lactantes are a specific population group for whom dietary reference intakes are provided</data>
      <data key="d10">b46fefa9f55d92c74acad101fc4f812e</data>
      <data key="d11">2e7379ed993d494ab302e0591cbec46b</data>
