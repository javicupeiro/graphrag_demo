      <data key="d10">fd661ab8e042d0fed76b34b7ceff6631</data>
      <data key="d11">d525eac62f69418d8702e1fcfe7ed6e4</data>
      <data key="d12">17864</data>
      <data key="d13">2</data>
    </edge>
    <edge source="AGCC" target="HIDR&#211;GENO">
      <data key="d8">5.0</data>
      <data key="d9">AGCC are produced during the fermentation of carbohydrates, which also generates hydrogen gas</data>
      <data key="d10">8c87213151750706e4e87956bfc9cb88</data>
      <data key="d11">c299cb9a9ba843cdacda3f05436eb2d7</data>
      <data key="d12">17865</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIGESTI&#211;N" target="ABSORCI&#211;N">
      <data key="d8">10.0</data>
      <data key="d9">Digesti&#243;n is the process that precedes absorci&#243;n, allowing nutrients to enter the bloodstream</data>
      <data key="d10">fd661ab8e042d0fed76b34b7ceff6631</data>
      <data key="d11">f0acbb6f340d4c29879525e93b6374c8</data>
      <data key="d12">17866</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ENZIMAS" target="SISTEMA LINF&#193;TICO">
      <data key="d8">5.0</data>
      <data key="d9">Las enzimas presentes en el quilo son transportadas a trav&#233;s del sistema linf&#225;tico.</data>
      <data key="d10">0f2aa9d202fbabe2b0f310000e6987e7</data>
      <data key="d11">c74d8f2033e5438fa584882ffefba621</data>
      <data key="d12">17867</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FLORA BACTERIANA" target="MICROBIOMA INTESTINAL">
      <data key="d8">1.0</data>
