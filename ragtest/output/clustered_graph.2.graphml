    <node id="ALIMENTOS RICOS EN FIBRA">
      <data key="d0">EVENT</data>
      <data key="d1">Foods high in fiber, especially fruits and vegetables, are associated with a probable decrease in the risk of several diseases.</data>
      <data key="d2">7ba4c7b49d445c147394ac626d055ef3</data>
