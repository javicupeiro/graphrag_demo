    </edge>
    <edge source="IPILIMUMAB" target="HIPOTIROIDISMO">
      <data key="d8">6.0</data>
      <data key="d9">Ipilimumab is associated with the development of hypothyroidism</data>
      <data key="d10">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d11">4386c22219974699b18f5045fdf9285e</data>
      <data key="d12">12729</data>
      <data key="d13">2</data>
    </edge>
    <edge source="IPILIMUMAB" target="INSUFICIENCIA SUPRARENAL">
      <data key="d8">6.0</data>
      <data key="d9">Ipilimumab may result in adrenal insufficiency in some patients</data>
      <data key="d10">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d11">d21a409bd3654694b9423dac4966a4e6</data>
      <data key="d12">12730</data>
