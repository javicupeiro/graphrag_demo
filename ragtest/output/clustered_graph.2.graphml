    </edge>
    <edge source="PATIENT" target="ICE CHIP PROTOCOL">
      <data key="d8">8.0</data>
      <data key="d9">The Ice Chip Protocol is applied to patients with poor secretion management to improve their swallowing function</data>
      <data key="d10">071141fe8f0a45f56522de2f52ddcb46</data>
