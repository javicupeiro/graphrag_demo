      <data key="d8">6.0</data>
      <data key="d9">MCTs are recommended in the diet post-bariatric surgery for their metabolic benefits</data>
      <data key="d10">ae99604da4e0a7da3a6e99e197205ab5</data>
      <data key="d11">333a0a7aed0e4287af9625933fb1b734</data>
      <data key="d12">15354</data>
      <data key="d13">2</data>
    </edge>
