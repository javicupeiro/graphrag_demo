    <edge source="UREA CYCLE DISORDERS" target="N-CARBAMYGLUTAMATE">
      <data key="d8">1.0</data>
      <data key="d9">N-carbamylglutamate is a treatment for N-acetylglutamate synthase deficiency, a specific urea cycle disorder</data>
      <data key="d10">7754f367b453475179218cac4bc24de1</data>
      <data key="d11">b5a94d783fb040e296b4e0b1e6b18b85</data>
