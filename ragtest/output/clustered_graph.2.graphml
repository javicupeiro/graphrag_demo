    <edge source="DIABETIC NEUROPATHY" target="HEART DISEASE">
      <data key="d8">6.0</data>
      <data key="d9">Diabetic neuropathy is associated with an increased risk of heart disease due to underlying metabolic issues</data>
      <data key="d10">fe5f390fb67fd3b1ad222db3500574b9</data>
      <data key="d11">ffdc3b37c671437db270c03ac78d3b7d</data>
