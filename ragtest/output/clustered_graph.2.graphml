    </node>
    <node id="ESTABILIDAD">
      <data key="d0">EVENT</data>
      <data key="d1">Estabilidad refers to the ability of a product to maintain its intended physical and chemical properties over time.</data>
      <data key="d2">d9e4179f945ec9152199511522d70159</data>
      <data key="d3">171</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
