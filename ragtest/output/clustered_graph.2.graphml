    </edge>
    <edge source="C&#193;NCER DE ES&#211;FAGO" target="ODINOFAGIA">
      <data key="d8">7.0</data>
      <data key="d9">La odinofagia se presenta en pacientes con c&#225;ncer de es&#243;fago, dificultando la ingesta de alimentos.</data>
      <data key="d10">5664277128c865feb0e93f9fd56a3d05</data>
      <data key="d11">31dc2591fac849a08a8ce3fce395f6d3</data>
      <data key="d12">16399</data>
