      <data key="d0">ORGANIZATION</data>
      <data key="d1">The American Diabetes and Cardiology Societies are organizations that provide guidelines and consensus on diabetes management and cardiovascular health.</data>
      <data key="d2">72d0be9d03c79097f867a8af2e3e89e4</data>
      <data key="d3">1379</data>
      <data key="d4">2</data>
