    <node id="FORMULAS POLIM&#201;RICAS">
      <data key="d0">EVENT</data>
      <data key="d1">Polymeric formulas are nutritional solutions used in enteral feeding that contain intact macronutrients.</data>
      <data key="d2">20491afa9a4770e93e6cff9034f8b0f0</data>
      <data key="d3">1178</data>
