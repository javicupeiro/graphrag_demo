    <node id="ESTOMA">
      <data key="d0">EVENT</data>
      <data key="d1">El estoma es una abertura creada quir&#250;rgicamente que permite la salida de desechos del cuerpo, y puede estar sujeto a infecciones en pacientes con nutrici&#243;n enteral.</data>
      <data key="d2">e7a9d9aa3031b4c032d724047f80ebe9</data>
