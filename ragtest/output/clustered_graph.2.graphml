      <data key="d0">ORGANIZATION</data>
      <data key="d1">The International Journal of Surgery publishes research on surgical techniques and outcomes across various specialties.</data>
      <data key="d2">c3c8c4edabc77ed1f0a834676de2939c</data>
      <data key="d3">741</data>
