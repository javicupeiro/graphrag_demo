    <node id="DIETA DUKAN">
      <data key="d0">EVENT</data>
      <data key="d1">The Dukan Diet is a high-protein diet that claims to promote rapid weight loss, categorized as a miracle diet.</data>
      <data key="d2">64347a9be918a67f786cbdf9f9db9c8a</data>
