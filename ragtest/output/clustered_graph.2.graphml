    <node id="VENAS PERIF&#201;RICAS">
      <data key="d0">GEO</data>
      <data key="d1">Las venas perif&#233;ricas son los vasos sangu&#237;neos de menor calibre que pueden ser utilizados para la nutrici&#243;n parenteral, aunque con limitaciones.</data>
      <data key="d2">538970e30e9d0e758546ca1a3cf5a205</data>
