      <data key="d11">4caaecddb2694564af541bfafa33ebd8</data>
      <data key="d12">14534</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADRENOLEUCODISTROFIA" target="CURRENT OPINION LIPIDOL">
      <data key="d8">3.0</data>
