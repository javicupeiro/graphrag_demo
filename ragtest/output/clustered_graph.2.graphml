    <node id="OASIS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">OASIS was a registry in the USA that recorded patients with NPD in 1987 before changing its name to the National Registry of Enteral and Parenteral Nutrition.</data>
      <data key="d2">efc0b55f4e91f02e4708b7cc43c64608</data>
      <data key="d3">563</data>
      <data key="d4">1</data>
