    <edge source="MICROADENOMA" target="ACROMEGALY">
      <data key="d8">6.0</data>
      <data key="d9">Microadenomas are often associated with acromegaly and are treated through surgical intervention</data>
      <data key="d10">2261671ccad439da1ed9ea5a27857dc8</data>
      <data key="d11">684eb8eb2e0a4817964e0a9808522d6d</data>
      <data key="d12">12669</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MICROADENOMA" target="MEDULLARY THYROID CARCINOMA">
      <data key="d8">6.0</data>
      <data key="d9">Microadenomas can produce TSH, complicating the diagnosis of medullary thyroid carcinoma</data>
      <data key="d10">a2303199b7587142ad661841870790ec</data>
      <data key="d11">bbe91136665445edad70191a9cdf0204</data>
      <data key="d12">12670</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RMN" target="CANCER MEDULAR DE TIROIDES">
      <data key="d8">7.0</data>
      <data key="d9">La RMN se utiliza para detectar met&#225;stasis en pacientes con c&#225;ncer medular de tiroides</data>
      <data key="d10">72b937574e8e90d19c9549a10b75057c</data>
      <data key="d11">036156d940f3417fa982cce75689ee03</data>
      <data key="d12">12671</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RMN" target="ADRENAL INCIDENTALOMA">
      <data key="d8">1.0</data>
