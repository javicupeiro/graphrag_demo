    <node id="COSTE DE ALIMENTOS">
      <data key="d0">EVENT</data>
      <data key="d1">El coste de alimentos se refiere a los gastos asociados con la rotaci&#243;n y preparaci&#243;n de alimentos en el contexto de la alimentaci&#243;n hospitalaria.</data>
      <data key="d2">4de75db0e24f0f89d890287e2a3f3dcc</data>
