    </edge>
    <edge source="WEIGHT LOSS" target="CLINICAL DETERMINANTS">
      <data key="d8">7.0</data>
      <data key="d9">Clinical determinants play a crucial role in understanding the weight loss experienced by patients with esophageal carcinoma during treatment.</data>
      <data key="d10">ce2e5f8df5ad472bb255174d496cc1d7</data>
      <data key="d11">4adbae111d814bcf883003a3227fcd17</data>
      <data key="d12">7244</data>
