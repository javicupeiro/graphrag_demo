    </node>
    <node id="AJCC CANCER STAGING MANUAL">
      <data key="d0">EVENT</data>
      <data key="d1">The AJCC Cancer Staging Manual is a publication that outlines the classification and staging of various cancers, including thyroid cancer.</data>
      <data key="d2">b1ce0d940909277d321ee55bffcc69b3</data>
      <data key="d3">1258</data>
      <data key="d4">2</data>
