      <data key="d6">10900</data>
      <data key="d7">d3fb650463d14cde93ffaff37ebb80fe</data>
    </node>
    <node id="MENSINK RP">
      <data key="d0">PERSON</data>
      <data key="d1">Mensink RP is an author who has conducted meta-analyses on the effects of dietary fatty acids on serum lipids and lipoproteins.</data>
      <data key="d2">f2b8b21255397ebbaf2b5d66ff6bde88</data>
      <data key="d3">1698</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
