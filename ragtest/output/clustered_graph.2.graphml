    <node id="SPEISER PW.">
      <data key="d0">PERSON</data>
      <data key="d1">Speiser PW. es un autor que ha escrito gu&#237;as de pr&#225;ctica sobre la hiperplasia suprarrenal cong&#233;nita debido a la deficiencia de 21-hidroxilasa.</data>
