    </node>
    <node id="TROMBOSIS S&#201;PTICA">
      <data key="d0">EVENT</data>
      <data key="d1">Septic thrombosis refers to the presence of a thrombus associated with a systemic infection, leading to complications.</data>
      <data key="d2">5ad53a3f16964261ae37b64f7c3cb688</data>
      <data key="d5">0</data>
      <data key="d6">2847</data>
