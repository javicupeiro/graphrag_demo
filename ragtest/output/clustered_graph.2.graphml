    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="SMALL BOWEL TRANSPLANTATION">
      <data key="d8">5.0</data>
      <data key="d9">Small bowel transplantation is a procedure that may be necessary for patients who cannot benefit from parenteral nutrition.</data>
