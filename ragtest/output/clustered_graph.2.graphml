    </node>
    <node id="TRANSLOCACI&#211;N BACTERIANA">
      <data key="d0">EVENT</data>
      <data key="d1">Bacterial translocation that can lead to infections, which enteral nutrition helps to prevent.</data>
      <data key="d2">89c28a4a0410d8f4cbbbc0fbdf4b1c40</data>
