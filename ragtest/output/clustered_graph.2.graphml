    </node>
    <node id="REFLUJO">
      <data key="d0">EVENT</data>
      <data key="d1">Reflujo refers to the backflow of stomach contents into the esophagus, a key aspect of conditions like ERGE.</data>
      <data key="d2">f7c941bced546a7d607c30a9a5e9d887</data>
