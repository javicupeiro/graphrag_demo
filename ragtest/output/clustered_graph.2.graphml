    </edge>
    <edge source="VLCD" target="PACIENTES ADULTOS OBESOS">
      <data key="d8">8.0</data>
      <data key="d9">Los pacientes adultos obesos son indicados para seguir dietas VLCD para la p&#233;rdida de peso</data>
      <data key="d10">3926ed628d3d5919b8a65e44fffbc3b9</data>
      <data key="d11">035a698823d343159b208a07fe9c8591</data>
