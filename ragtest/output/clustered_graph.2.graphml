      <data key="d6">3309</data>
      <data key="d7">d655ef831c5f4f348b0b7970af9bba1d</data>
    </node>
    <node id="GERIATRIC PATIENTS">
      <data key="d0">PERSON</data>
      <data key="d1">Geriatric patients are older adults who may be at risk of malnutrition and are the focus of various studies and nutritional strategies.</data>
      <data key="d2">bd8df34b86026d71089bcf062570b70f</data>
      <data key="d3">703</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">3310</data>
      <data key="d7">73d6f7f2ca5f40a2b0873ea51793753d</data>
    </node>
    <node id="NUTRITIONAL SCREENING TOOLS">
      <data key="d0">EVENT</data>
      <data key="d1">Nutritional screening tools are methods utilized to evaluate the nutritional status of patients, especially within hospital environments. These tools are specifically designed for screening malnutrition and conducting nutritional assessments, ensuring that patients receive appropriate care based on their dietary needs.</data>
      <data key="d2">594e6f43e0098791036927da2623b2f5,bd8df34b86026d71089bcf062570b70f</data>
      <data key="d3">114</data>
      <data key="d4">1</data>
      <data key="d5">10</data>
      <data key="d6">3311</data>
      <data key="d7">58c58e19428e49338e91892aba5865e4</data>
    </node>
    <node id="WOMEN'S HEALTH AND AGING STUDIES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Women's Health and Aging Studies (WHAS) are research studies focused on the health and aging of women, particularly examining factors related to frailty and nutrition.</data>
      <data key="d2">6d6fc66abf6c858e5c5e9e47eb1ff6d2</data>
      <data key="d3">1762</data>
      <data key="d4">2</data>
