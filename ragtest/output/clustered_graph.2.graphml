    </node>
    <node id="LOW-FAT DIET">
      <data key="d0">EVENT</data>
      <data key="d1">A low-fat diet is a dietary plan that restricts fat intake, often used for weight loss and health improvement.</data>
      <data key="d2">7855ffa74481ba85f44e9700279250e7</data>
