      <data key="d0">ORGANIZATION</data>
      <data key="d1">NHANES es una encuesta que proporciona datos sobre la prevalencia de litiasis renal y otras condiciones de salud en la poblaci&#243;n de EE.UU.</data>
      <data key="d2">b703f173982cf68d36653cc0d9cc1fcb</data>
