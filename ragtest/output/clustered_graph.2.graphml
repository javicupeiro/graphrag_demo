    <edge source="HIPOMAGNESEMIA" target="PROTE&#205;NA">
      <data key="d8">1.0</data>
      <data key="d9">El exceso de prote&#237;na en la dieta puede afectar el equilibrio de electrolitos, contribuyendo a la hipomagnesemia.</data>
      <data key="d10">ed9dfe1b1e334597565187840983df05</data>
      <data key="d11">aea636c541a64ac98efff5f1d83939c3</data>
      <data key="d12">9605</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PEG" target="MELAS SYNDROME">
      <data key="d8">7.0</data>
