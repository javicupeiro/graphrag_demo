      <data key="d7">b00bc52cdf1e46f0952fc3ce43d6b14e</data>
    </node>
    <node id="TABELA 2">
      <data key="d0">EVENT</data>
      <data key="d1">Table 2 provides recommendations for fluid and electrolyte intake for infants in their first month of life.</data>
      <data key="d2">a0b6196d53d4eb1c8ca5b1a3a78e8fc7</data>
