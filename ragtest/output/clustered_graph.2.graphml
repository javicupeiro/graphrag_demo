    </node>
    <node id="NEPRILISINA">
      <data key="d0">PERSON</data>
      <data key="d1">Neprilysin is an endopeptidase that degrades natriuretic peptides and is overexpressed in adipose tissue, potentially due to hyperinsulinemia and insulin resistance.</data>
      <data key="d2">c575e742f54d5f3f674a8e52ad041221</data>
      <data key="d3">1390</data>
      <data key="d4">2</data>
