    <node id="CIRROSIS CON ASCITIS">
      <data key="d0">EVENT</data>
      <data key="d1">Cirrhosis con ascitis refers to cirrhosis with ascites, which can lead to hypervolemic hyponatremia.</data>
      <data key="d2">e4b62c2ae5857a5dd11f609286271bb4</data>
      <data key="d5">0</data>
      <data key="d6">15071</data>
