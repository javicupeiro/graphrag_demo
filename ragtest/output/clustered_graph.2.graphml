      <data key="d7">d3eaffd757494b2c9a9ec986d197fe09</data>
    </node>
    <node id="LACERACI&#211;N DE UN VASO">
      <data key="d0">EVENT</data>
      <data key="d1">Laceration of a vessel refers to the tearing of a blood vessel, which can occur as a complication during catheter insertion.</data>
      <data key="d2">fe3ebcedac0857680bcc85bb58dcb3e1</data>
      <data key="d5">0</data>
      <data key="d6">15595</data>
