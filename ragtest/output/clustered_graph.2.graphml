      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d3">1284</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">16188</data>
      <data key="d7">aa83135b159043caa892ed472ba510ae</data>
    </node>
    <node id="INFORETRIEVER">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">InfoRetriever is an online tool designed to help healthcare professionals find relevant clinical information quickly.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d5">1</data>
      <data key="d6">16189</data>
      <data key="d7">4e05d7fc603145c2acc3391270e0730c</data>
    </node>
    <node id="FISTERRA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Fisterra is a medical resource providing evidence-based information and guidelines for healthcare professionals in Spanish-speaking countries.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d5">1</data>
      <data key="d6">16190</data>
      <data key="d7">67e2c1fd393b47779115d8fc19bd3320</data>
    </node>
    <node id="COCHRANE COLLABORATION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Cochrane Collaboration publishes systematic reviews and clinical trials to provide high-quality evidence for healthcare decision-making.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d3">76</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">16191</data>
      <data key="d7">e244c25cbbd645d3952ea16dab2c191c</data>
    </node>
    <node id="MEDLINE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">MEDLINE is a widely used bibliographic database of life sciences and biomedical information, accessible via the internet.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d3">77</data>
      <data key="d4">1</data>
      <data key="d5">4</data>
      <data key="d6">16192</data>
      <data key="d7">eac914b0e0f54a72952cfa9d203bbdfb</data>
    </node>
    <node id="EMBASE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Embase is a biomedical and pharmacological database of published literature, providing comprehensive coverage of drug and medical research.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d3">77</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">16193</data>
      <data key="d7">20466e9e2ec94d1ea666c07a82f08368</data>
    </node>
    <node id="WEB OF SCIENCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Web of Science is an online subscription-based scientific citation indexing service that provides comprehensive citation data for various academic disciplines.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d3">77</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">16194</data>
      <data key="d7">ae8ec87506b845df996741496eefac2a</data>
    </node>
    <node id="TRIPDATABASE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">TRIPdatabase is a clinical search engine designed to provide evidence-based information for healthcare professionals.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d5">1</data>
      <data key="d6">16195</data>
      <data key="d7">674355f1fd0b49cf969fa02f32636b2c</data>
    </node>
    <node id="GOOGLE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Google is a widely used search engine that can also be utilized to find medical information, though not always critically evaluated.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d5">1</data>
      <data key="d6">16196</data>
      <data key="d7">f42ef8165aeb47ac91563b7f130c44b4</data>
    </node>
    <node id="PIR&#193;MIDE DE FUENTES DE INFORMACI&#211;N">
      <data key="d0">EVENT</data>
      <data key="d1">The Pir&#225;mide de Fuentes de Informaci&#243;n is a model that illustrates the hierarchy of medical information sources, guiding healthcare professionals in their search for evidence-based resources.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d5">1</data>
      <data key="d6">16197</data>
      <data key="d7">2ad4a79d8d3e413daf0a708d23c72271</data>
    </node>
    <node id="BIBLIOTECA COCHRANE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Biblioteca Cochrane is a collection of systematic reviews and clinical trials published by the Cochrane Collaboration, providing high-quality evidence for healthcare decisions.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d3">76</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">16198</data>
      <data key="d7">726a153ee36c43b6bab4233f99e5a64c</data>
    </node>
    <node id="PUBMED CLINICAL QUERIES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">PubMed Clinical Queries is a tool that allows users to search for systematic reviews and clinical studies within the PubMed database.</data>
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d3">77</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">16199</data>
      <data key="d7">0f991990ad784d6fab9585c14b4a244a</data>
    </node>
    <node id="HAYNES">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">14ad20b4ac1105ca21faf20e4978fb5a</data>
      <data key="d5">1</data>
      <data key="d6">16200</data>
      <data key="d7">0d721a8badf54319aea4363caaf9f342</data>
    </node>
    <node id="AMERICAN DIETETICS ASSOCIATION">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The American Dietetics Association (ADA) defines the practice of evidence-based nutrition as the use of systematically reviewed scientific evidence to make practical decisions about food and nutrition.</data>
      <data key="d2">56fede71b721264441e35be77e3ed1d1</data>
      <data key="d3">275</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">16201</data>
      <data key="d7">ecd1eaa5729e4177ac34b31ed1d7f0e2</data>
    </node>
    <node id="UNIVERSITY OF TORONTO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The University of Toronto provides resources for critical appraisal and evidence-based medicine practices.</data>
      <data key="d2">56fede71b721264441e35be77e3ed1d1</data>
      <data key="d3">93</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">16202</data>
      <data key="d7">d4b94576da1642ee82ecdd0978dffee2</data>
    </node>
    <node id="CENTRE FOR EVIDENCE BASED MEDICINE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Centre for Evidence Based Medicine, located in Oxford, is dedicated to enhancing clinical practice through the provision of classifications of scientific evidence types for clinical practice guidelines. Additionally, the Centre offers various tools designed to evaluate evidence and improve clinical decision-making, thereby supporting healthcare professionals in making informed choices based on the best available evidence.</data>
      <data key="d2">56fede71b721264441e35be77e3ed1d1,faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d3">93</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">16203</data>
      <data key="d7">acb2c9cc7cca4fc5b7c28caec9f29547</data>
    </node>
    <node id="CRITICAL APPRAISAL OF THE EVIDENCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Critical Appraisal of the Evidence is a program at the University of Toronto that focuses on evaluating medical literature.</data>
      <data key="d2">56fede71b721264441e35be77e3ed1d1</data>
      <data key="d3">1484</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16204</data>
      <data key="d7">9e8497fb58a6429aac367662f3d6b3c8</data>
    </node>
    <node id="EVIDENCE BASED MEDICINE TOOL KIT">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Evidence Based Medicine Tool Kit at the University of Alberta offers resources for implementing evidence-based practices in clinical settings.</data>
      <data key="d2">56fede71b721264441e35be77e3ed1d1</data>
      <data key="d3">1484</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16205</data>
      <data key="d7">17fe8574bae842aaaac5d269e17754d7</data>
    </node>
    <node id="RED CASPE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Red CASPe is a network that provides training in critical reading skills for evaluating medical literature.</data>
      <data key="d2">56fede71b721264441e35be77e3ed1d1</data>
      <data key="d3">1484</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16206</data>
      <data key="d7">0c4ba8887789435089783dd6b84ccc74</data>
    </node>
    <node id="NUTRICI&#211;N COMUNITARIA">
      <data key="d0">EVENT</data>
      <data key="d1">NUTRICI&#211;N COMUNITARIA, or community nutrition, refers to the application of nutrition principles and practices aimed at improving the health of populations. This field encompasses efforts to enhance community health through proper dietary practices and nutritional education. It emphasizes the importance of food and nutrition in fostering better health outcomes within communities.</data>
      <data key="d2">2ab0f03a87bdf418c83a614b2183332f,56fede71b721264441e35be77e3ed1d1</data>
      <data key="d3">1614</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">16207</data>
      <data key="d7">39455b23b5c046d3bbadb91ad30bb50b</data>
    </node>
    <node id="USERS' GUIDES INTERACTIVE">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">56fede71b721264441e35be77e3ed1d1</data>
      <data key="d3">1484</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16208</data>
      <data key="d7">3c03c76656474634b53f9b5bd39130bc</data>
    </node>
    <node id="INDUSTRIA FARMAC&#201;UTICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">La industria farmac&#233;utica financia la mayor parte de la investigaci&#243;n cl&#237;nica, lo que puede introducir sesgos en los resultados de los estudios.</data>
      <data key="d2">2ab0f03a87bdf418c83a614b2183332f</data>
      <data key="d3">1614</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16209</data>
      <data key="d7">48db5b5b3b184136bc36747b23305dc1</data>
    </node>
    <node id="SUPERALIMENTOS">
      <data key="d0">EVENT</data>
      <data key="d1">Los superalimentos son alimentos que se promocionan como capaces de tratar o prevenir enfermedades, aunque su efectividad no siempre est&#225; respaldada por evidencia cient&#237;fica.</data>
      <data key="d2">2ab0f03a87bdf418c83a614b2183332f</data>
      <data key="d3">1030</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16210</data>
      <data key="d7">295df597bcc34de7ad4637226ec04a6d</data>
    </node>
    <node id="ESTUDIOS OBSERVACIONALES">
      <data key="d0">EVENT</data>
      <data key="d1">Los estudios observacionales son investigaciones que pueden proporcionar evidencia sobre el efecto de las modificaciones diet&#233;ticas en la salud, aunque a menudo se consideran de menor calidad que los EPA.</data>
      <data key="d2">2ab0f03a87bdf418c83a614b2183332f</data>
      <data key="d3">1614</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">16211</data>
      <data key="d7">915509f770414a7b8daf7400a623dc14</data>
    </node>
    <node id="CANADIAN TASK FORCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Canadian Task Force is an institution that published a classification of levels of evidence and corresponding grades of recommendation for clinical practice guidelines.</data>
      <data key="d2">faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d3">93</data>
      <data key="d4">1</data>
      <data key="d5">1</data>
      <data key="d6">16212</data>
      <data key="d7">f035aae2574148b98e060654a153b6b8</data>
    </node>
    <node id="NATIONAL INSTITUTE FOR HEALTH AND CLINICAL EXCELLENCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The National Institute for Health and Clinical Excellence (NICE) is an organization that plays a crucial role in enhancing health and social care in the UK. It provides national guidance and advice aimed at improving the quality of care and health outcomes. Additionally, NICE is responsible for developing clinical practice guidelines, which are structured with a hierarchical classification of evidence to ensure that recommendations are based on the best available data. Through its efforts, NICE seeks to promote effective and efficient healthcare practices across the nation.</data>
      <data key="d2">f5d0adafea7d8fe8216c624188ddad04,faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d3">93</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">16213</data>
      <data key="d7">bc69e6d363d441c2bbe9ecb58e385617</data>
    </node>
    <node id="GRADE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">GRADE is a system designed for grading the quality of evidence and the strength of recommendations in clinical practice guidelines. Known as the Grading of Recommendations, Assessment, Development, and Evaluations, the GRADE system aims to establish a common language for discussing the quality of evidence and the strength of recommendations within clinical practice guidelines.</data>
      <data key="d2">07a16ed299a7f8bafcaa44a54495a9c3,90fe1d34782402a1896d33ad5bb47614,faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d3">93</data>
      <data key="d4">1</data>
      <data key="d5">7</data>
      <data key="d6">16214</data>
      <data key="d7">599584b304df45ae8abb6eac6f4b8217</data>
    </node>
    <node id="EVIDENCE BASED NUTRITION GUIDELINES">
      <data key="d0">EVENT</data>
      <data key="d1">Evidence-based nutrition guidelines are documents that include recommendations to optimize patient care based on systematic reviews of evidence.</data>
      <data key="d2">faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d5">1</data>
      <data key="d6">16215</data>
      <data key="d7">cb7c872b9121481f990bf796f35a5fb2</data>
    </node>
    <node id="CLINICAL PRACTICE GUIDELINES">
      <data key="d0">EVENT</data>
      <data key="d1">Clinical practice guidelines (GPC) are informative documents that include recommendations aimed at optimizing patient care based on systematic reviews of evidence.</data>
      <data key="d2">faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d5">2</data>
      <data key="d6">16216</data>
      <data key="d7">810d64ccc1b64a6fb06b31aa395a17da</data>
    </node>
    <node id="EVIDENCE CLASSIFICATION SYSTEMS">
      <data key="d0">EVENT</data>
      <data key="d1">Evidence classification systems are frameworks used to categorize studies based on scientific rigor and reliability.</data>
      <data key="d2">faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d5">1</data>
      <data key="d6">16217</data>
      <data key="d7">7dc15d0fed3d4a138c635218a81d2c03</data>
    </node>
    <node id="EVIDENCE">
      <data key="d0">EVENT</data>
      <data key="d1">Evidence refers to the information and data collected through research that supports clinical practice guidelines and recommendations.</data>
      <data key="d2">faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d3">689</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">16218</data>
      <data key="d7">47bb771fd986455d8b2f6f0e9c694054</data>
    </node>
    <node id="RIGOR SCIENTIFIC">
      <data key="d0">EVENT</data>
      <data key="d1">Rigor scientific refers to the strictness and precision in the design of studies, which is crucial for determining the quality of evidence in clinical practice guidelines.</data>
      <data key="d2">faa6d27a781e64a98fe101236a44dc16</data>
      <data key="d3">689</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16219</data>
      <data key="d7">0d492fea75fa4986aa1e24fffc406957</data>
    </node>
    <node id="AGREE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">AGREE is a collaboration initiated in 1998 among several countries aimed at improving the quality of clinical practice guidelines through methodological evaluation and transparency.</data>
      <data key="d2">07a16ed299a7f8bafcaa44a54495a9c3</data>
      <data key="d3">686</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">16220</data>
      <data key="d7">99aff0112fef4284a7b2ab5b42e13330</data>
    </node>
    <node id="GPC">
      <data key="d0">EVENT</data>
      <data key="d1">Clinical Practice Guidelines (GPC) are structured recommendations aimed at improving patient care based on the best available evidence.</data>
      <data key="d2">07a16ed299a7f8bafcaa44a54495a9c3</data>
      <data key="d3">1434</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16221</data>
      <data key="d7">24dd10385f37416caf89366b6bfa7960</data>
    </node>
    <node id="INSTRUMENTO AGREE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The AGREE Instrument is a tool developed from the AGREE collaboration to assess the methodological rigor and transparency of clinical practice guidelines.</data>
      <data key="d2">07a16ed299a7f8bafcaa44a54495a9c3</data>
      <data key="d3">686</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16222</data>
      <data key="d7">ad12fe5953be422489909b2bb49e0471</data>
    </node>
    <node id="CANADIAN CRITICAL CARE PRACTICE GUIDELINES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Canadian Critical Care Practice Guidelines focus on nutritional support for critically ill patients and have been updated frequently since their first publication in 2003.</data>
      <data key="d2">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d3">685</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16223</data>
      <data key="d7">604909881e8f49f1a8e38cf6929bb47d</data>
    </node>
    <node id="NATIONAL INSTITUTE FOR CLINICAL EXCELLENCE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The National Institute for Clinical Excellence (NICE) provides guidelines for clinical practice in the UK, including those related to nutrition, with a history dating back to 2006.</data>
      <data key="d2">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d3">685</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16224</data>
      <data key="d7">5af5355debb2428f818156863b278412</data>
    </node>
    <node id="GORDON JENSEN">
      <data key="d0">PERSON</data>
      <data key="d1">Gordon Jensen is a key figure involved in the development of common guidelines for nutritional management, collaborating with ESPEN and ASPEN.</data>
      <data key="d2">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d3">685</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16225</data>
      <data key="d7">5884e91693c24d32a1b79634975cb4f3</data>
    </node>
    <node id="ALASTAIR FORBES">
      <data key="d0">PERSON</data>
      <data key="d1">Alastair Forbes is another key figure who has worked with Gordon Jensen in the effort to create common guidelines for nutritional management.</data>
      <data key="d2">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d3">685</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16226</data>
      <data key="d7">8cede665b36748b8a94a4258b8458883</data>
    </node>
    <node id="SIGN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">SIGN is an organization that provides a classification system for evidence, which has been used in the development of clinical practice guidelines.</data>
      <data key="d2">90fe1d34782402a1896d33ad5bb47614</data>
      <data key="d3">685</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">16227</data>
