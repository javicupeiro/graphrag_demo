      <data key="d6">13266</data>
      <data key="d7">dfcfe3e0f9c84250b83bdfc5b51c8c39</data>
    </node>
    <node id="EATING BEHAVIOR SCALE">
      <data key="d0">EVENT</data>
      <data key="d1">The Eating Behavior Scale is a tool used to assess the ability of individuals, particularly those with cognitive impairments, to eat independently.</data>
      <data key="d2">b3760fcb9c0421b66d37c20b1dc68577</data>
      <data key="d3">1214</data>
