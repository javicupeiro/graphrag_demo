    <node id="OFTALMOPAT&#205;A DE GRAVES">
      <data key="d0">EVENT</data>
      <data key="d1">La oftalmopat&#237;a de Graves es una enfermedad inflamatoria ocular asociada con enfermedad tiroidea autoinmune, principalmente la enfermedad de Graves.</data>
      <data key="d2">4c18507e3d98242cdbcddd1a1997b92f</data>
      <data key="d3">1352</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
