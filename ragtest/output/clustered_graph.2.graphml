      <data key="d5">6</data>
      <data key="d6">4734</data>
      <data key="d7">8482b5c5da75478587af0684089cee74</data>
    </node>
    <node id="NANETS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The North American Neuroendocrine Tumor Society (NANETS) is an organization dedicated to the diagnosis, study, and management of neuroendocrine tumors in North America. It aims to enhance the understanding and treatment of these tumors, providing resources and support for both healthcare professionals and patients affected by this condition.</data>
      <data key="d2">2c745fa0855caf0a3316554b5a46752c,7e4e3e944e1b58b8d92e93ee4a9f33cc</data>
