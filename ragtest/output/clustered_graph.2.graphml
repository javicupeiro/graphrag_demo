    </edge>
    <edge source="SARCOPENIA" target="LIVER TRANSPLANTATION">
      <data key="d8">7.0</data>
      <data key="d9">Sarcopenia can impair the prognosis of patients undergoing liver transplantation</data>
      <data key="d10">125bf798b37a7f42c661002099924973</data>
