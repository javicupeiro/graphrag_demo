      <data key="d10">4beab004731d7baff10fd2796a523b55</data>
      <data key="d11">5a5f84dc355043bebf4004ddf5bc09c5</data>
      <data key="d12">14937</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NATURE PUBLISHING GROUP IBEROAM&#201;RICA" target="FAJARDO C">
