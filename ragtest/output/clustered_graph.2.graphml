    <node id="CONTROLES DE GLUCEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Controles de glucemia are blood glucose monitoring tests conducted to assess the patient's blood sugar levels.</data>
      <data key="d2">bfdbf41efa08067d5ae1b1a67830affd</data>
