      <data key="d9">Nieman LK is one of the contributors to the literature reviewed in Harrison's Principles of Internal Medicine, authored by Loscaso J</data>
      <data key="d10">7082a5d31b18dd81d4c4a0e8ed02623b</data>
      <data key="d11">67b1d332a9ba425190e94aad54cdaf1b</data>
      <data key="d12">12802</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NIEMAN LK" target="HARRISON PRINCIPIOS DE MEDICINA INTERNA">
      <data key="d8">1.0</data>
      <data key="d9">Nieman LK's work is referenced in Harrison Principios de Medicina Interna regarding adrenal disorders</data>
      <data key="d10">bcbca87f5ebf2c5d260810cf83a70257</data>
      <data key="d11">f5012c0d23a04dc88a43c1d651640c10</data>
      <data key="d12">12803</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NIEMAN LK" target="WILLIAMS TEXTBOOK OF ENDOCRINOLOGY">
      <data key="d8">7.0</data>
      <data key="d9">Nieman LK is referenced in the Williams Textbook of Endocrinology for his contributions to the field</data>
      <data key="d10">7f3df1437755b60344fdffd2ef3b8a9e</data>
      <data key="d11">cf2188213f3341f68dd274f4e3439089</data>
      <data key="d12">12804</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PET" target="MIBG">
      <data key="d8">1.0</data>
      <data key="d9">PET is considered more sensitive than MIBG for diagnosing metastases of malignant paragangliomas</data>
      <data key="d10">c3d752ff301355241e1420e398f0e6a4</data>
      <data key="d11">437bf23f2daa4a93ad91672a7b069a51</data>
      <data key="d12">12805</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VIDAL CASARIEGO A" target="DIETOTERAPIA">
      <data key="d8">7.0</data>
      <data key="d9">Vidal Casariego A is a contributor to the book published by Dietoterapia, focusing on dietary treatment of obesity</data>
      <data key="d10">1e60716fb6d7eb11fdf78dc47bd9a5d9</data>
      <data key="d11">30561982282943b4992efdc939992528</data>
      <data key="d12">12806</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRATAMIENTO CON GH" target="S&#205;NDROME DE TURNER">
      <data key="d8">7.0</data>
      <data key="d9">El tratamiento con GH est&#225; aprobado para el s&#237;ndrome de Turner, que es una condici&#243;n m&#233;dica espec&#237;fica</data>
      <data key="d10">b11e575be155e186717a992a9d641577</data>
      <data key="d11">6a11550a980648f5b2f7735e45a91dbe</data>
      <data key="d12">12807</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRATAMIENTO CON GH" target="S&#205;NDROME DE PRADER-WILLI">
      <data key="d8">7.0</data>
      <data key="d9">El tratamiento con GH est&#225; aprobado para el s&#237;ndrome de Prader-Willi, que afecta el crecimiento</data>
      <data key="d10">b11e575be155e186717a992a9d641577</data>
      <data key="d11">a1ca683c2bb042ba84983a7ad38ee144</data>
      <data key="d12">12808</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRATAMIENTO CON GH" target="S&#205;NDROME DE NOONAN">
      <data key="d8">4.0</data>
      <data key="d9">El s&#237;ndrome de Noonan es una condici&#243;n que puede ser tratada con GH en Estados Unidos, pero no en Espa&#241;a</data>
      <data key="d10">b11e575be155e186717a992a9d641577</data>
      <data key="d11">2a1e0a8730a44a57839c3cc02c0bc76e</data>
      <data key="d12">12809</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRATAMIENTO CON GH" target="TALLA BAJA IDIOP&#193;TICA">
      <data key="d8">4.0</data>
      <data key="d9">El tratamiento con GH se utiliza para la talla baja idiop&#225;tica en Estados Unidos, pero no est&#225; aprobado en Espa&#241;a</data>
      <data key="d10">b11e575be155e186717a992a9d641577</data>
      <data key="d11">92a10406e5224f51850e04edef3dae37</data>
      <data key="d12">12810</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TRATAMIENTO CON GH" target="GEN SHOX">
      <data key="d8">1.0</data>
      <data key="d9">El gen SHOX est&#225; relacionado con la deficiencia de crecimiento que puede ser tratada con GH</data>
      <data key="d10">b11e575be155e186717a992a9d641577</data>
      <data key="d11">4d9ec5477c8640fdbb24cdf643c21893</data>
      <data key="d12">12811</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="DEFICIT DE GH">
      <data key="d8">1.0</data>
      <data key="d9">Patients with S&#237;ndrome de Turner may require treatment for deficit de GH</data>
      <data key="d10">742d2991389effe376f335dad6fbafa1</data>
      <data key="d11">313e3c0bb2d147aab45d4684bc04325c</data>
      <data key="d12">12812</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="AMENORREA PRIMARIA">
      <data key="d8">7.0</data>
      <data key="d9">Syndrome of Turner is a known cause of primary amenorrhea due to its genetic implications</data>
      <data key="d10">31ce1e681d5daab6e4f4071ed09a0266</data>
      <data key="d11">fdd6e024d02446469d3061e149a77824</data>
      <data key="d12">12813</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="RETARDO PUBERAL">
      <data key="d8">7.0</data>
      <data key="d9">El s&#237;ndrome de Turner puede resultar en amenorrea primaria y retraso en el desarrollo puberal</data>
      <data key="d10">b972e75c5d62cc5cd76d9fc308265621</data>
      <data key="d11">01a376d30c104e16aa33fcd9127da8f9</data>
      <data key="d12">12814</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="HIPOGONADISMO">
      <data key="d8">7.0</data>
      <data key="d9">Las pacientes con s&#237;ndrome de Turner pueden presentar hipogonadismo, lo que afecta su desarrollo sexual y hormonal.</data>
      <data key="d10">7d5f6bf9cedae48d8c4054344fea60b4</data>
      <data key="d11">ee7dd97c813241e799e06bbef2ec86e3</data>
      <data key="d12">12815</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="SHOX">
      <data key="d8">15.0</data>
      <data key="d9">El s&#237;ndrome de Turner se caracteriza por la falta del gen SHOX, lo que contribuye a la estatura baja en las pacientes. Esta condici&#243;n se debe a la ausencia del material del gen SHOX en el cromosoma X, que es la causa principal de la estatura reducida observada en quienes padecen el s&#237;ndrome de Turner.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b,a2ccbbd76866c4f88a82e64c95764b04</data>
      <data key="d11">8f23ef5968e548468de1a4f8bc2714c8</data>
      <data key="d12">12816</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="CARDIOPAT&#205;A ISQU&#201;MICA">
      <data key="d8">6.0</data>
      <data key="d9">El s&#237;ndrome de Turner aumenta el riesgo de cardiopat&#237;a isqu&#233;mica debido a problemas metab&#243;licos asociados.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b</data>
      <data key="d11">b4019c118e524431a24a851700f6e7a8</data>
      <data key="d12">12817</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="ENFERMEDADES AUTOINMUNITARIAS">
      <data key="d8">1.0</data>
      <data key="d9">Las pacientes con s&#237;ndrome de Turner tienen una mayor prevalencia de enfermedades autoinmunitarias.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b</data>
      <data key="d11">297c68ff24f44edb978b776f582bfa58</data>
      <data key="d12">12818</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="FENOTIPO FEMENINO">
      <data key="d8">5.0</data>
      <data key="d9">El s&#237;ndrome de Turner se manifiesta en pacientes con fenotipo femenino, que puede variar en funci&#243;n del grado de mosaicismo.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b</data>
      <data key="d11">ba63f837133946f2afa2b6de4bac24a0</data>
      <data key="d12">12819</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="FALLO OV&#193;RICO">
      <data key="d8">7.0</data>
      <data key="d9">El fallo ov&#225;rico es una condici&#243;n frecuente en pacientes con s&#237;ndrome de Turner, que afecta su desarrollo reproductivo.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b</data>
      <data key="d11">31ebd3df72fe4381afc4295407f17e88</data>
      <data key="d12">12820</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="MENOPAUSIA PRECOZ">
      <data key="d8">6.0</data>
      <data key="d9">La menopausia precoz es una posible consecuencia del s&#237;ndrome de Turner, especialmente en pacientes que presentan fallo ov&#225;rico.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b</data>
      <data key="d11">79eee907dadd484d930531576a2ca818</data>
      <data key="d12">12821</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="ANOMAL&#205;AS CARDIOVASCULARES">
      <data key="d8">6.0</data>
      <data key="d9">Las anomal&#237;as cardiovasculares son una complicaci&#243;n com&#250;n en pacientes con s&#237;ndrome de Turner, que requieren seguimiento m&#233;dico.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b</data>
      <data key="d11">0d1464cea11641bfacdd4a6857294d4e</data>
      <data key="d12">12822</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="DISECCI&#211;N DE AORTA">
      <data key="d8">8.0</data>
      <data key="d9">La disecci&#243;n de aorta es una complicaci&#243;n grave asociada con el s&#237;ndrome de Turner, que requiere vigilancia cardiol&#243;gica.</data>
      <data key="d10">17de78bfa13b95801265f7abb14d3e2b</data>
      <data key="d11">a3dcbb482d464e54a67f87341a7edda7</data>
      <data key="d12">12823</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="GONADOBLASTOMA">
      <data key="d8">7.0</data>
      <data key="d9">El s&#237;ndrome de Turner con cromosoma Y en mosaico predispone a padecer gonadoblastoma en m&#225;s del 10% de los casos.</data>
      <data key="d10">a2ccbbd76866c4f88a82e64c95764b04</data>
      <data key="d11">1d33921b0d3344a298cf979620c93151</data>
      <data key="d12">12824</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="DENSIDAD &#211;SEA">
      <data key="d8">6.0</data>
      <data key="d9">El s&#237;ndrome de Turner puede estar asociado con alteraciones en la densidad &#243;sea, lo que puede predisponer a fracturas.</data>
      <data key="d10">a2ccbbd76866c4f88a82e64c95764b04</data>
      <data key="d11">ef50d24feb494d0e8cdc9ea5443ceab0</data>
      <data key="d12">12825</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="E2">
      <data key="d8">5.0</data>
      <data key="d9">En el s&#237;ndrome de Turner, los niveles de E2 son bajos debido a la insuficiencia gonadal.</data>
      <data key="d10">a2ccbbd76866c4f88a82e64c95764b04</data>
      <data key="d11">269d68804e424192940a85ea6d9d5bbe</data>
      <data key="d12">12826</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="GONADOTROFINAS">
      <data key="d8">6.0</data>
      <data key="d9">La insuficiencia gonadal en el s&#237;ndrome de Turner se manifiesta con un aumento de gonadotrofinas.</data>
      <data key="d10">a2ccbbd76866c4f88a82e64c95764b04</data>
      <data key="d11">c60e94bfef8744b18fd63f09376c2281</data>
      <data key="d12">12827</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="OXANDROLONA">
      <data key="d8">1.0</data>
      <data key="d9">La oxandrolona se recomienda en el tratamiento de pacientes con s&#237;ndrome de Turner que tienen un pron&#243;stico de talla final insatisfactorio.</data>
      <data key="d10">a2ccbbd76866c4f88a82e64c95764b04</data>
      <data key="d11">d85ba9eff5534b6580ae1c2105b3d27a</data>
      <data key="d12">12828</data>
      <data key="d13">2</data>
    </edge>
    <edge source="S&#205;NDROME DE TURNER" target="ENFERMEDAD CELIACA">
      <data key="d8">5.0</data>
      <data key="d9">El s&#237;ndrome de Turner es un factor de riesgo asociado a la enfermedad cel&#237;aca</data>
      <data key="d10">9d5e76e37794965024f4b16e7e163d30</data>
      <data key="d11">c93fd151b36148bc9366842c96c8c8c1</data>
      <data key="d12">12829</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONA DE CRECIMIENTO" target="MUSCULATURA">
      <data key="d8">7.0</data>
      <data key="d9">Growth hormone treatment is linked to changes in muscle mass, which is crucial for physical independence</data>
      <data key="d10">3f21321c62f3e5ee31c822e90ca6b89e</data>
      <data key="d11">cdebced2b4794323a5373d3fd1293ccd</data>
      <data key="d12">12830</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HORMONA DE CRECIMIENTO" target="NUTRICI&#211;N EN PACIENTES QUEMADOS">
      <data key="d8">5.0</data>
      <data key="d9">Growth hormone may be used in the nutritional management of pediatric burn patients</data>
      <data key="d10">125acd19edb76fa23986de56fc2517e8</data>
      <data key="d11">d23f6acc935942389c18d32521098a5a</data>
      <data key="d12">12831</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GINECOMASTIA" target="RETARDO PUBERAL">
      <data key="d8">6.0</data>
      <data key="d9">La ginecomastia puede ser un s&#237;ntoma asociado con el retraso puberal en varones</data>
      <data key="d10">b972e75c5d62cc5cd76d9fc308265621</data>
      <data key="d11">3a6482794b99450bb22e5d5caeb797c9</data>
      <data key="d12">12832</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GINECOMASTIA" target="MUSCLE FATIGUE">
      <data key="d8">6.0</data>
      <data key="d9">The patient's muscle fatigue may be related to the underlying hormonal issues contributing to his gynecomastia.</data>
      <data key="d10">592d424edaa447a54ab4489d82495db6</data>
      <data key="d11">c08c383e03204cffbcfe748931397210</data>
      <data key="d12">12833</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GINECOMASTIA" target="HIPOGONADISMO">
      <data key="d8">6.0</data>
      <data key="d9">Gynecomastia can occur as a result of hormonal imbalances associated with hypogonadism</data>
      <data key="d10">0cf04c95a8e6bbdf9201bf3fff9103f6</data>
      <data key="d11">d746cc8a166347b889bb86500a093dd1</data>
      <data key="d12">12834</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GINECOMASTIA" target="MUTACIONES DEL GEN RSPO1">
      <data key="d8">6.0</data>
      <data key="d9">Mutations in the RSPO1 gene can lead to conditions that may include gynecomastia due to hormonal disruptions</data>
      <data key="d10">0cf04c95a8e6bbdf9201bf3fff9103f6</data>
      <data key="d11">ec8e23e3e4ad4a7b8e360f924e7ac46c</data>
      <data key="d12">12835</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GINECOMASTIA" target="TESTOSTERONE THERAPY">
      <data key="d8">7.0</data>
      <data key="d9">Gynecomastia can be a side effect of testosterone therapy in men</data>
      <data key="d10">f979a07da5d7c814ccf957629ab91cc5</data>
      <data key="d11">a8935ef583904df8ba030f395cb70725</data>
      <data key="d12">12836</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GINECOMASTIA" target="EW">
      <data key="d8">1.0</data>
      <data key="d9">Gynecomastia can occur in Wilson's disease patients due to hormonal changes related to copper accumulation</data>
      <data key="d10">3898563966943dbfc8a0f6e84bc627b1</data>
      <data key="d11">c859df5886dd4e84b549ad7ac2fc0955</data>
      <data key="d12">12837</data>
      <data key="d13">2</data>
    </edge>
    <edge source="GH RECOMBINANTE" target="DEFICIT DE GH">
      <data key="d8">8.0</data>
      <data key="d9">GH recombinante is used as a treatment for patients with deficit de GH</data>
      <data key="d10">2f30de565a9a9acf7ac0930483276bbb</data>
      <data key="d11">6a554d7f27674c7190734b166ab8f39a</data>
      <data key="d12">12838</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEFICIT DE GH" target="TALLA BAJA">
      <data key="d8">6.0</data>
      <data key="d9">Talla baja can be a symptom of deficit de GH, prompting further evaluation</data>
      <data key="d10">2f30de565a9a9acf7ac0930483276bbb</data>
      <data key="d11">cd755a06971c4a88b3fc35a440d76862</data>
      <data key="d12">12839</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEFICIT DE GH" target="SOMATOTROPINA HUMANA RECOMBINANTE">
      <data key="d8">8.0</data>
      <data key="d9">Somatotropina humana recombinante is administered to treat deficit de GH</data>
      <data key="d10">2f30de565a9a9acf7ac0930483276bbb</data>
      <data key="d11">5f6b818319784f7c92d2564c098bb99e</data>
      <data key="d12">12840</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEFICIT DE GH" target="ANOMAL&#205;AS ESTRUCTURALES">
      <data key="d8">6.0</data>
      <data key="d9">Anomal&#237;as estructurales can be a consequence of severe deficit de GH in children</data>
      <data key="d10">2f30de565a9a9acf7ac0930483276bbb</data>
      <data key="d11">aebad6fe9df841b2a38476e876c670a7</data>
      <data key="d12">12841</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEFICIT DE GH" target="DENSIDAD &#211;SEA">
      <data key="d8">7.0</data>
      <data key="d9">Densidad &#243;sea can be negatively impacted by deficit de GH, leading to weaker bones</data>
      <data key="d10">2f30de565a9a9acf7ac0930483276bbb</data>
      <data key="d11">6255327875964a1e9779500e791ce635</data>
      <data key="d12">12842</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DEFICIT DE GH" target="MASA MAGRA">
      <data key="d8">1.0</data>
      <data key="d9">Masa magra can decrease in individuals with deficit de GH, affecting overall health</data>
      <data key="d10">2f30de565a9a9acf7ac0930483276bbb</data>
      <data key="d11">65f7bb2666604669a8fc030726853ad9</data>
      <data key="d12">12843</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TALLA BAJA" target="VELOCIDAD DE CRECIMIENTO">
      <data key="d8">6.0</data>
      <data key="d9">Talla baja is assessed in relation to velocidad de crecimiento to determine growth issues</data>
      <data key="d10">742d2991389effe376f335dad6fbafa1</data>
      <data key="d11">2473dcf9fef04e0ca202e59cebd9f992</data>
      <data key="d12">12844</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TALLA BAJA" target="TALLA MEDIA PARENTAL">
      <data key="d8">7.0</data>
      <data key="d9">Talla baja is evaluated against talla media parental to determine growth deficiencies</data>
      <data key="d10">742d2991389effe376f335dad6fbafa1</data>
      <data key="d11">89e85a6204334c2584763146fb170fc1</data>
      <data key="d12">12845</data>
      <data key="d13">2</data>
    </edge>
    <edge source="TALLA BAJA" target="MELAS">
      <data key="d8">4.0</data>
