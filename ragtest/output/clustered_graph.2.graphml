    <node id="CEREBRAL CORTEX">
      <data key="d0">GEO</data>
      <data key="d1">The cerebral cortex is a part of the brain responsible for muscle control, sensory organ functions, memory, and learning processes.</data>
      <data key="d2">dd8c7ee9ef48992cebb11e84fbb0fe34</data>
      <data key="d3">1626</data>
      <data key="d4">2</data>
