    </edge>
    <edge source="AHSP" target="CNAQ">
      <data key="d8">14.0</data>
      <data key="d9">AHSP and CNAQ are both questionnaires specifically designed to assess appetite and nutritional status in older adults. These tools aim to evaluate the appetite of elderly individuals, providing valuable insights into their nutritional needs and overall well-being.</data>
      <data key="d10">17f48ff2bbbb22ecd24983f41739c88b,1bad878c6efa9d3f5719546bb51bccb6</data>
      <data key="d11">f488dde050164b1b97881431bde3e9f8</data>
      <data key="d12">11466</data>
      <data key="d13">2</data>
    </edge>
    <edge source="RESIDENCIAS" target="PERSONAS MAYORES">
      <data key="d8">8.0</data>
      <data key="d9">Elderly individuals living in residences require nutritional assessments for their care</data>
      <data key="d10">17f48ff2bbbb22ecd24983f41739c88b</data>
      <data key="d11">2a43be168e1c4b2c95081f5fd322a0ba</data>
      <data key="d12">11467</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PERSONAS MAYORES" target="QUEBEC LONGITUDINAL STUDY NUAGE">
      <data key="d8">6.0</data>
      <data key="d9">The Quebec Longitudinal Study NuAge focuses on the nutritional needs of older adults</data>
