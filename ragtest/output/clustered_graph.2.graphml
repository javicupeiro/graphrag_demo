      <data key="d2">84ebd4f784ceacfe0744f6bb9cd9a5a3</data>
      <data key="d3">1307</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">5571</data>
      <data key="d7">c9e42a115add404185a466239894672b</data>
    </node>
    <node id="GH REPLACEMENT THERAPY">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">84ebd4f784ceacfe0744f6bb9cd9a5a3</data>
      <data key="d5">6</data>
      <data key="d6">5572</data>
      <data key="d7">4f92463629c4465aa03a91ab2e343b66</data>
    </node>
    <node id="CYP450">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">CYP450 is a family of enzymes that catalyze oxidation reactions and are crucial for drug metabolism in humans.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">0</data>
      <data key="d6">5573</data>
      <data key="d7">135d4b63a5784b7cb5c56eacd14ac91b</data>
    </node>
    <node id="CYP3A4">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">CYP3A4 is the most important member of the CYP450 family, responsible for the metabolism of approximately half of the drugs used in human therapy.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d3">1331</data>
      <data key="d4">2</data>
      <data key="d5">5</data>
      <data key="d6">5574</data>
      <data key="d7">dbd867893e534e3586b89acdbbb27185</data>
    </node>
    <node id="RIFAMPICINA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Rifampicina is an antibiotic that is primarily used to treat tuberculosis and other bacterial infections. In addition to its antimicrobial properties, Rifampicina can induce the enzyme CYP3A4, which plays a significant role in drug metabolism. This induction can affect the metabolism of various medications, potentially altering their effectiveness and safety profiles.</data>
      <data key="d2">1ff94f3fcc6eff16c2fdae5eb9b3aefa,40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d3">1331</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">5575</data>
      <data key="d7">5e0b4d13cec44c6d8c97bd5330af2765</data>
    </node>
    <node id="ANTIF&#218;NGICOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Antifungals are drugs that can inhibit the enzyme CYP3A4, necessitating dosage reductions of drugs metabolized by this enzyme.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d3">1331</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">5576</data>
      <data key="d7">0cc9ca7e6c3440e1a085ecfc563da0e6</data>
    </node>
    <node id="ANTIBI&#211;TICOS MACR&#211;LIDOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Macrolide antibiotics are drugs that can inhibit CYP3A4, affecting the metabolism of other medications.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d3">1331</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">5577</data>
      <data key="d7">ded7cda133b941cbb9d39579a835d28f</data>
    </node>
    <node id="NIVOLUMAB">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Nivolumab is an immune checkpoint inhibitor that targets PD-1 and is used in treating various cancers.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d3">1355</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
      <data key="d6">5578</data>
      <data key="d7">2c851033dd534f08be4335d0ca4b9a1d</data>
    </node>
    <node id="PEMBROLIZUMAB">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Pembrolizumab is an immune checkpoint inhibitor that targets PD-1, used in the treatment of melanoma and other cancers.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d3">1355</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">5579</data>
      <data key="d7">818b69fab1cc4595808d9c25694e279f</data>
    </node>
    <node id="ATEZOLIZUMAB">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Atezolizumab is an immune checkpoint inhibitor that targets PD-L1, used in treating several types of cancer.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">1</data>
      <data key="d6">5580</data>
      <data key="d7">f20eb45e7f18428494bb367dacd568b2</data>
    </node>
    <node id="AVELUMAB">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Avelumab is an immune checkpoint inhibitor that targets PD-L1, utilized in cancer therapy.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">1</data>
      <data key="d6">5581</data>
      <data key="d7">f24fe29cc42346219e335f2213570443</data>
    </node>
    <node id="DURVALUMAB">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Durvalumab is an immune checkpoint inhibitor that targets PD-L1, used in the treatment of various malignancies.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">1</data>
      <data key="d6">5582</data>
      <data key="d7">8e3fea3d33694e2d967046eb39cfc3a0</data>
    </node>
    <node id="MELANOMA">
      <data key="d0">EVENT</data>
      <data key="d1">Melanoma is a type of skin cancer that can be treated with immune checkpoint inhibitors such as ipilimumab and nivolumab. Additionally, it is noted that patients with Multiple Endocrine Neoplasia type 1 (MEN1) may develop melanoma; however, the specific connection between melanoma and the MEN1 gene has not been described.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0,7e4e3e944e1b58b8d92e93ee4a9f33cc</data>
      <data key="d3">1355</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">5583</data>
      <data key="d7">9823041b71f345e8941500f8b0b8e58d</data>
    </node>
    <node id="CARCINOMA DE C&#201;LULAS RENALES">
      <data key="d0">EVENT</data>
      <data key="d1">Renal cell carcinoma is a type of kidney cancer that can be treated with immune checkpoint inhibitors.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">2</data>
      <data key="d6">5584</data>
      <data key="d7">4a7b95acaf5c47138d4f923a713708ff</data>
    </node>
    <node id="C&#193;NCER DE PULM&#211;N DE C&#201;LULAS NO PEQUE&#209;AS">
      <data key="d0">EVENT</data>
      <data key="d1">Non-small cell lung cancer is a type of lung cancer that can be treated with immune checkpoint inhibitors.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">1</data>
      <data key="d6">5585</data>
      <data key="d7">141ad1839fdc411b9b99c463495900a4</data>
    </node>
    <node id="HORMONAL ALTERATIONS">
      <data key="d0">EVENT</data>
      <data key="d1">Hormonal alterations are changes in hormone levels that can occur as a result of immune checkpoint blockade.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">0</data>
      <data key="d6">5586</data>
      <data key="d7">2f1878906c88421c9dd663d5076e7577</data>
    </node>
    <node id="ENDOCRINOPAT&#205;AS">
      <data key="d0">EVENT</data>
      <data key="d1">Endocrinopathies are disorders related to the endocrine system that can arise from immune checkpoint inhibitors.</data>
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">1</data>
      <data key="d6">5587</data>
      <data key="d7">7b73e6b2bfb5435a8bf8f08d421dbbc3</data>
    </node>
    <node id="CHECKPOINT">
      <data key="d0" />
      <data key="d1" />
      <data key="d2">40253f8b49d61452dbc56454cd1a07e0</data>
      <data key="d5">1</data>
      <data key="d6">5588</data>
      <data key="d7">3a3cbf6a3e00472391c8fe2c71780bfe</data>
    </node>
    <node id="EMA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The European Medicines Agency (EMA) is an agency of the European Union tasked with the evaluation, supervision, and safety monitoring of medicinal products. It plays a crucial role in ensuring the safety and efficacy of medicines available in the EU. The EMA has been involved in the review of various medicinal products, including obesity treatments such as lorcaserin, which it did not approve for marketing due to safety concerns. Additionally, the agency has rejected certain obesity treatments, including fentermina and topiramato, based on risk assessments. Overall, the EMA is dedicated to maintaining high standards for medicinal products within the European Union, focusing on the health and safety of the public.</data>
      <data key="d2">35dc97b15f3fd556acbfdb405eadda06,623ef060e116bc05259d5e6d3d8c0996,af631316aa8584710d755d8c59e851b6,af95ffa2f3eaddc28a86d59cd2d89415</data>
      <data key="d3">1416</data>
      <data key="d4">2</data>
      <data key="d5">4</data>
      <data key="d6">5589</data>
      <data key="d7">bd76a3dce18c45408837c0ab970cb7a8</data>
    </node>
    <node id="LYSODREN">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Lysodren is a medication with the active ingredient mitotane, used in the treatment of adrenal cancer.</data>
      <data key="d2">af95ffa2f3eaddc28a86d59cd2d89415</data>
      <data key="d3">1416</data>
      <data key="d4">2</data>
