    </edge>
    <edge source="CALCIO" target="YEYUNO">
      <data key="d8">7.0</data>
      <data key="d9">El yeyuno tambi&#233;n es un sitio importante para la absorci&#243;n de calcio en el sistema digestivo.</data>
