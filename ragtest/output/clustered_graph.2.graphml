    <node id="SOLUCIONES TERNARIAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Ternary solutions in parenteral nutrition consist of amino acids, glucose, and lipids, and are preferred for their comprehensive nutrient delivery.</data>
      <data key="d2">222519e556047fafecd61c2964aaaeed</data>
      <data key="d3">630</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15582</data>
      <data key="d7">f3d060067d7845c99c8cbed20f7c8e56</data>
    </node>
    <node id="SOLUCIONES BINARIAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Binary solutions in parenteral nutrition consist of two components, typically amino acids and glucose, administered separately from lipids.</data>
      <data key="d2">222519e556047fafecd61c2964aaaeed</data>
      <data key="d3">630</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
