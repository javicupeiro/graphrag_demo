    <node id="ESTRATEGIAS POSTURALES">
      <data key="d0">EVENT</data>
      <data key="d1">Postural strategies that modify the dimensions of the oropharynx and digestive tract to improve swallowing safety for patients with dysphagia.</data>
      <data key="d2">7c842769e1890739769789ed10a08005</data>
