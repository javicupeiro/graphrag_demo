      <data key="d6">14234</data>
      <data key="d7">0f02d7169b9c4d44957b1716fabf1ae5</data>
    </node>
    <node id="ANTIDEPRESSANTS">
      <data key="d0">PERSON</data>
      <data key="d1">Antidepressants, particularly tricyclics, can have enhanced depressant effects on the central nervous system when combined with alcohol.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d3">1387</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14235</data>
      <data key="d7">203dbc0154a54b989f61072388306532</data>
    </node>
    <node id="CLORANFENICOL">
      <data key="d0">PERSON</data>
      <data key="d1">Chloramphenicol is a medication that can have enhanced hepatotoxic effects when taken with alcohol.</data>
      <data key="d2">4f1c852e5d25eed4db322b75624d3e2b</data>
      <data key="d3">1387</data>
      <data key="d4">2</data>
