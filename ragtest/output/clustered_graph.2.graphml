    </node>
    <node id="ESPAGUETIS">
      <data key="d0">EVENT</data>
      <data key="d1">Espaguetis refers to spaghetti, which has a glycemic index of 54 when cooked for 5 minutes and 83 when cooked for 10 minutes.</data>
      <data key="d2">5116416429465894c102d9fb93d6a8fc</data>
      <data key="d3">1894</data>
      <data key="d4">2</data>
