      <data key="d11">2ee929d4b66340c4a48eca86df1b1b34</data>
      <data key="d12">146</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DISFAGIA OROFAR&#205;NGEA" target="RGE">
      <data key="d8">7.0</data>
      <data key="d9">RGE can lead to symptoms of dysphagia oropharyngea, as reflux may cause difficulty in swallowing.</data>
      <data key="d10">b58b0258891d9207b27237bab6a03946</data>
      <data key="d11">10e4f42f04354e4dab94505f9ee15a7c</data>
      <data key="d12">147</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DISFAGIA OROFAR&#205;NGEA" target="MANOMETR&#205;A">
      <data key="d8">16.0</data>
      <data key="d9">DISFAGIA OROFAR&#205;NGEA y MANOMETR&#205;A est&#225;n interrelacionadas en el contexto del diagn&#243;stico y evaluaci&#243;n de la funci&#243;n deglutoria. La manometr&#237;a se utiliza para diagnosticar y evaluar la disfagia orofar&#237;ngea, proporcionando datos cruciales sobre la funci&#243;n deglutoria. Adem&#225;s, la manometr&#237;a es frecuentemente empleada para evaluar la motilidad esof&#225;gica en pacientes que presentan disfagia orofar&#237;ngea, lo que resalta su importancia en la comprensi&#243;n y tratamiento de esta condici&#243;n.</data>
      <data key="d10">b58b0258891d9207b27237bab6a03946,dbe1af2b277e06c9d447af56351e496f</data>
      <data key="d11">b46770136c244d3b9988fb37692f7195</data>
      <data key="d12">148</data>
      <data key="d13">2</data>
    </edge>
