    </edge>
    <edge source="INSUFICIENCIA RENAL" target="ZINC">
      <data key="d8">8.0</data>
      <data key="d9">Zinc supplementation must be reduced in cases of renal insufficiency to prevent toxicity</data>
      <data key="d10">12ceae17f5df9d7a1a40ebc43156a35e</data>
      <data key="d11">68d5f86aa6244569813f16cb583d2aea</data>
      <data key="d12">6850</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSUFICIENCIA RENAL" target="CORTISOL">
      <data key="d8">6.0</data>
      <data key="d9">In renal insufficiency, the determination of free urinary cortisol may be affected, impacting the diagnosis of conditions like Cushing's syndrome</data>
      <data key="d10">bcbca87f5ebf2c5d260810cf83a70257</data>
      <data key="d11">32edfea2646042c79fc606c5052d0ba8</data>
