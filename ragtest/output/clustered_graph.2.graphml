    <node id="LDL COLESTEROL">
      <data key="d0">EVENT</data>
      <data key="d1">LDL Colesterol refers to low-density lipoprotein cholesterol, which is a type of cholesterol that individuals with diabetes need to manage through dietary choices.</data>
      <data key="d2">f558c372d16630f14b614e232fc151de</data>
      <data key="d3">870</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
