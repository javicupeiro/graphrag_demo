    </edge>
    <edge source="POTASIO" target="NEONATOS">
      <data key="d8">9.0</data>
      <data key="d9">Potassium levels are monitored and adjusted for neonates to ensure their health during the early days of life</data>
      <data key="d10">15ffbfba2decfecb69a26bcb1e4bd898</data>
      <data key="d11">65557e9a49604947a9d804b96b8861b4</data>
