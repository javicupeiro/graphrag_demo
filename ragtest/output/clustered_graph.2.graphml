    <edge source="TABLA 1" target="COMIT&#201; DE &#201;TICA DE LOS SERVICIOS SOCIALES DE CATALU&#209;A">
      <data key="d8">6.0</data>
      <data key="d9">The checklist in Tabla 1 is used by the Ethics Committee to ensure proper deliberation in clinical decisions.</data>
      <data key="d10">3775bd9e3567a81cf7b7acf1e2741f6f</data>
      <data key="d11">379dfa7207b5416eb0792f98971bcd5f</data>
