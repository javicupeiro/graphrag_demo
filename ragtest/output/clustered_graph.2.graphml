    <node id="INSTITUTE FOR SAFE MEDICATION PRACTICES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The Institute for Safe Medication Practices (ISMP) is an organization that focuses on medication safety and includes parenteral nutrition among high-risk medications.</data>
      <data key="d2">5fb0e4d2f6efd6c6abcd9f7b7583ed7f</data>
