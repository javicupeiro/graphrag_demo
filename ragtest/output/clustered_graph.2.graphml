    </node>
    <node id="LIPEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Lipemia refers to the presence of excess lipids in the blood, which can be a concern for individuals with diabetes.</data>
      <data key="d2">1f2b31f5a0bba00ecee5e3a8fb2c83ea</data>
      <data key="d3">1372</data>
      <data key="d4">2</data>
