    <node id="IMPEDIMENTOS PARA LA INGESTA">
      <data key="d0">EVENT</data>
      <data key="d1">Impedimentos para la ingesta are factors that hinder a patient's ability to consume food.</data>
      <data key="d2">67f60ae11335cf41da4f96400b69e67b</data>
