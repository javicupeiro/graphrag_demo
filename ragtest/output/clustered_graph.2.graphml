    </node>
    <node id="DICUMARINICOS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Dicumar&#237;nicos are anticoagulant medications that can have increased absorption when food slows gastric emptying.</data>
      <data key="d2">75b625e1dd088fa7beed19a4142f726f</data>
      <data key="d3">891</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">14225</data>
      <data key="d7">eb97244425b044fba2429fece90b6aa8</data>
    </node>
    <node id="SAL DE LITIO">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Sal de litio is a medication whose renal excretion can be influenced by dietary sodium intake.</data>
