    <edge source="OSTEOPENIA" target="HYPERPARATHYROIDISM">
      <data key="d8">6.0</data>
      <data key="d9">Osteopenia can be a complication of hyperparathyroidism due to the effects of elevated parathyroid hormone on bone density.</data>
      <data key="d10">ae9d1fec31d651598e2db7436382c906</data>
      <data key="d11">eaf826c44be243bd8392339a59ecd006</data>
