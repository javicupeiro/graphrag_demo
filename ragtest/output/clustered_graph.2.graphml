    </node>
    <node id="HIDROCEFALIA">
      <data key="d0">EVENT</data>
      <data key="d1">La hidrocefalia es una condici&#243;n que puede resultar de la obstrucci&#243;n del flujo del l&#237;quido cefalorraqu&#237;deo debido a tumores pineales.</data>
      <data key="d2">309cfad754049a78b0459a3e71f496ef</data>
