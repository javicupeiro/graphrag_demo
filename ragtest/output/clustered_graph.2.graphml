      <data key="d12">16892</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FACE" target="GLUTEN-FREE CERTIFICATION ORGANIZATION">
      <data key="d8">8.0</data>
      <data key="d9">The Gluten-Free Certification Organization works with FACE to certify gluten-free products</data>
      <data key="d10">1d8aa686c6377246fee05010ef969018</data>
      <data key="d11">f5ba54288beb4a0ebeef3fe3f52a6007</data>
