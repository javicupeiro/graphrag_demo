    <node id="INSTITUCIONES SANITARIAS">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Las instituciones sanitarias son lugares donde se atienden a personas, incluyendo a aquellos en huelga de hambre.</data>
      <data key="d2">3a39d5a157094736650455097e986fdd</data>
