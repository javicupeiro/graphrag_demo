    <node id="SED">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">The SED is a professional organization that focuses on diabetes, having previously worked on optimizing diabetes management.</data>
      <data key="d2">7ba6c80b1b1919de63502e93c6b9f6fa</data>
      <data key="d3">1485</data>
