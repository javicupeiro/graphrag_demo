    </node>
    <node id="HH TIPO 2B">
      <data key="d0">EVENT</data>
      <data key="d1">HH tipo 2B is another subtype of juvenile hemochromatosis linked to mutations in the hepcidin gene.</data>
      <data key="d2">1cdec368125a3e3fd5c3c7accc5b89ec</data>
      <data key="d3">1521</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">11669</data>
      <data key="d7">6b0bb2257aab428bbcb0cde62554e223</data>
    </node>
    <node id="HH TIPO 3">
      <data key="d0">EVENT</data>
      <data key="d1">HH tipo 3 refers to hereditary hemochromatosis associated with mutations in the transferrin receptor gene.</data>
      <data key="d2">1cdec368125a3e3fd5c3c7accc5b89ec</data>
      <data key="d3">1520</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">11670</data>
      <data key="d7">b54143962ed8438c93aaa4fe3c55b95a</data>
    </node>
    <node id="HH TIPO 4">
      <data key="d0">EVENT</data>
      <data key="d1">HH tipo 4 is a form of hereditary hemochromatosis caused by mutations in the ferroportin gene.</data>
      <data key="d2">1cdec368125a3e3fd5c3c7accc5b89ec</data>
      <data key="d3">1520</data>
      <data key="d4">2</data>
