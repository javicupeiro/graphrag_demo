      <data key="d7">7f23840f087946df8146aa2dc093b63c</data>
    </node>
    <node id="HEMOFILTRACI&#211;N CONTINUA">
      <data key="d0">EVENT</data>
      <data key="d1">Continuous hemofiltration is a renal replacement therapy that requires higher protein intake due to increased losses during the process.</data>
      <data key="d2">64417661dbb019f8f4ceb9fcc2fbdaa6</data>
      <data key="d3">1153</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
