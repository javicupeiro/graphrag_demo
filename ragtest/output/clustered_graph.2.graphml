    <edge source="DESHIDRATACI&#211;N" target="PACIENCIA">
      <data key="d8">1.0</data>
      <data key="d9">Dehydration is a common problem faced by patients in palliative care, often due to difficulties in food and liquid intake.</data>
      <data key="d10">d3f53b7b7352e8ba2fd9dc8be977648c</data>
      <data key="d11">e912d76ed93f47ec9fc807cf4242e420</data>
      <data key="d12">911</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DESHIDRATACI&#211;N" target="D&#201;FICIT CONG&#201;NITO">
      <data key="d8">7.0</data>
      <data key="d9">Dehydration often results from the watery diarrhea experienced by patients with congenital deficit of saccharase-isomaltase.</data>
      <data key="d10">a079902e52676a05df746098c930a0e7</data>
      <data key="d11">d60b3897e91d485eac9ba770d12948ae</data>
      <data key="d12">912</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DESHIDRATACI&#211;N" target="DIARREA AGUDA">
