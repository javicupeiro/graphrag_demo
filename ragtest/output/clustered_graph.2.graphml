      <data key="d6">3552</data>
      <data key="d7">46f72bde68174346941c5e623da5297a</data>
    </node>
    <node id="NONVERTEBRAL FRACTURES">
      <data key="d0">EVENT</data>
      <data key="d1">Nonvertebral fractures are injuries that occur outside the vertebral column and have been studied in relation to vitamin D supplementation.</data>
