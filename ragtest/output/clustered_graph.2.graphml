      <data key="d8">1.0</data>
      <data key="d9">Patients are diagnosed with eating disorders, which include anorexia nervosa and bulimia nervosa</data>
      <data key="d10">3bc554a0031c436483a977c2b9e57b48</data>
      <data key="d11">7ce74ab777ee45d4b461238385146bc5</data>
      <data key="d12">512</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="DEPRESI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">Patients with eating disorders often experience depression as a comorbid condition</data>
      <data key="d10">3bc554a0031c436483a977c2b9e57b48</data>
      <data key="d11">d2d1d0a891004590ab97ac292bb41144</data>
      <data key="d12">513</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="ANSIEDAD">
      <data key="d8">8.0</data>
      <data key="d9">Patients with eating disorders frequently suffer from anxiety, impacting their treatment and recovery</data>
      <data key="d10">3bc554a0031c436483a977c2b9e57b48</data>
      <data key="d11">e7de1046635c4b40bf9835e578eb0b23</data>
      <data key="d12">514</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="TRAUMAS PSICOL&#211;GICOS">
      <data key="d8">7.0</data>
      <data key="d9">Psychological traumas can lead to the development of eating disorders in vulnerable patients</data>
      <data key="d10">3bc554a0031c436483a977c2b9e57b48</data>
      <data key="d11">1a6e8d9365634d078037746846c4a8d8</data>
      <data key="d12">515</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="DIN&#193;MICA FAMILIAR">
      <data key="d8">7.0</data>
      <data key="d9">Family dynamics play a crucial role in the psychological health of patients with eating disorders</data>
      <data key="d10">3bc554a0031c436483a977c2b9e57b48</data>
      <data key="d11">750c5db7990848f689b3f3d689a1aa6d</data>
      <data key="d12">516</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="PSICOTERAPIA">
      <data key="d8">9.0</data>
      <data key="d9">Psychotherapy is essential for patients with eating disorders to address their psychological challenges</data>
      <data key="d10">3bc554a0031c436483a977c2b9e57b48</data>
      <data key="d11">fbc8f1ab610d4521b7ca9cc282f48f0c</data>
      <data key="d12">517</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="PSICOF&#193;RMACOS">
      <data key="d8">1.0</data>
      <data key="d9">Psychopharmaceuticals are often prescribed to patients with eating disorders to help manage their symptoms</data>
      <data key="d10">3bc554a0031c436483a977c2b9e57b48</data>
      <data key="d11">b4e739d4a32c47ddbdc2c47710581213</data>
      <data key="d12">518</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="BULIMIA NERVIOSA">
      <data key="d8">8.0</data>
      <data key="d9">Patients with Bulimia Nervosa require a different treatment approach focused on psychotherapy and medication</data>
      <data key="d10">46912552a886d029c4aa16e3ea9a0e27</data>
      <data key="d11">affb357d4b734985a5bac2fef9a01a42</data>
      <data key="d12">519</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="MICRONUTRIENTES">
      <data key="d8">1.0</data>
      <data key="d9">Micronutrient deficiencies can worsen the conditions of patients with eating disorders, making their recovery more difficult</data>
      <data key="d10">46912552a886d029c4aa16e3ea9a0e27</data>
      <data key="d11">22b7d1c2b7cd4f93b38997347b2d817a</data>
      <data key="d12">520</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="HIERRO">
      <data key="d8">6.0</data>
      <data key="d9">Patients with eating disorders often experience iron deficiency, which can complicate their recovery</data>
      <data key="d10">46912552a886d029c4aa16e3ea9a0e27</data>
      <data key="d11">d567ee46c592465290259d460ec57f0b</data>
      <data key="d12">521</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="ZINC">
      <data key="d8">7.0</data>
      <data key="d9">Zinc deficiency is common among patients with eating disorders, and its supplementation can improve recovery outcomes</data>
      <data key="d10">46912552a886d029c4aa16e3ea9a0e27</data>
      <data key="d11">1f1fa7d5b4634ec8a150c2948c616f71</data>
      <data key="d12">522</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="MOTIVACI&#211;N">
      <data key="d8">8.0</data>
      <data key="d9">The motivation of patients is crucial for their recovery from eating disorders, as it affects their treatment adherence</data>
      <data key="d10">46912552a886d029c4aa16e3ea9a0e27</data>
      <data key="d11">686dc8ead6bc46e4b11d87f17bd21128</data>
      <data key="d12">523</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="EDUCACI&#211;N NUTRICIONAL">
      <data key="d8">1.0</data>
      <data key="d9">Nutritional education is vital for patients with eating disorders to help them develop healthy eating habits</data>
      <data key="d10">46912552a886d029c4aa16e3ea9a0e27</data>
      <data key="d11">6ca582086abe4ae28c1c029cb7a51b8e</data>
      <data key="d12">524</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="TCA">
      <data key="d8">8.0</data>
      <data key="d9">TCA represents the eating disorders that affect patients and require specific dietary interventions</data>
      <data key="d10">fb23af50b771da28e73b9545fa4f09b0</data>
      <data key="d11">fd01ee71ffa44edc988f3c9843ea7be3</data>
      <data key="d12">525</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="AN">
      <data key="d8">8.0</data>
      <data key="d9">Anorexia Nervosa is a specific type of eating disorder that affects patients' eating habits</data>
      <data key="d10">fb23af50b771da28e73b9545fa4f09b0</data>
      <data key="d11">8e952f5217b94635b96a4018070be176</data>
      <data key="d12">526</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="ALIMENTOS">
      <data key="d8">8.0</data>
      <data key="d9">Patients require specific types of foods that are either commercially sterile or very clean to minimize the risk of infections. Additionally, dietary choices and education regarding foods are essential for patients with eating disorders, highlighting the importance of tailored nutritional guidance in their care.</data>
      <data key="d10">17fc469cf1ddbb8fa68bad4446bd65e6,fb23af50b771da28e73b9545fa4f09b0</data>
      <data key="d11">33e0208115f343979261a8e312d1da82</data>
      <data key="d12">527</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="DIABETES MELLITUS TIPO 2">
      <data key="d8">1.0</data>
      <data key="d9">Pacientes are individuals diagnosed with diabetes mellitus tipo 2 who require ongoing management and education</data>
      <data key="d10">1f2b31f5a0bba00ecee5e3a8fb2c83ea</data>
      <data key="d11">2ba1713586954236926bf204229b4847</data>
      <data key="d12">528</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="ACIDOSIS LACTICA">
      <data key="d8">6.0</data>
      <data key="d9">Patients with Glycogen Storage Disease I may experience lactic acidosis as a complication of their metabolic disorder.</data>
      <data key="d10">948f7e888e5bb06b347a80a3fbf87ae7</data>
      <data key="d11">1ab69f3b7a504821bee3fd066fc873a4</data>
      <data key="d12">529</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="HIPERTRIGLICERIDEMIA">
      <data key="d8">6.0</data>
      <data key="d9">Patients with Glycogen Storage Disease I may have elevated triglyceride levels as a result of their dietary management and metabolic issues.</data>
      <data key="d10">948f7e888e5bb06b347a80a3fbf87ae7</data>
      <data key="d11">8889d2406f234201ae46660c35ac455f</data>
      <data key="d12">530</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="TRATAMIENTO NUTRICIONAL">
      <data key="d8">18.0</data>
      <data key="d9">Nutritional treatment is essential for patients, particularly those with gastrointestinal malignancies, as it plays a significant role in improving their prognosis. Additionally, patients with Glycogen Storage Disease I also require specific nutritional treatment to effectively manage their condition. This highlights the importance of tailored nutritional interventions for various patient populations to enhance health outcomes.</data>
      <data key="d10">639ebafae8a95bb03a09e111172b9a4e,948f7e888e5bb06b347a80a3fbf87ae7</data>
      <data key="d11">71aeb5e8ef2a4b8589d8de3678981ceb</data>
      <data key="d12">531</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTES" target="PERIODOS DE AYUNO">
      <data key="d8">8.0</data>
      <data key="d9">Patients must avoid fasting periods to prevent hypoglycemia and maintain stable blood glucose levels.</data>
