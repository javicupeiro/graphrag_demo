      <data key="d12">20287</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADMINISTRACI&#211;N PENITENCIARIA" target="ART&#205;CULO 36">
      <data key="d8">7.0</data>
      <data key="d9">El art&#237;culo 36 de la Ley Org&#225;nica 1/1979 regula la asistencia sanitaria que debe proporcionar la Administraci&#243;n Penitenciaria a los internos.</data>
      <data key="d10">3a39d5a157094736650455097e986fdd</data>
      <data key="d11">a4213c5b408a4a15a47cc91a3105f953</data>
      <data key="d12">20288</data>
      <data key="d13">2</data>
    </edge>
    <edge source="ADMINISTRACI&#211;N PENITENCIARIA" target="ART&#205;CULO 45">
      <data key="d8">1.0</data>
      <data key="d9">El art&#237;culo 45 establece las condiciones bajo las cuales la Administraci&#243;n Penitenciaria puede utilizar medios coercitivos en los internos.</data>
      <data key="d10">3a39d5a157094736650455097e986fdd</data>
      <data key="d11">b1eccbbb886b44ef991564a450efc955</data>
      <data key="d12">20289</data>
      <data key="d13">2</data>
    </edge>
