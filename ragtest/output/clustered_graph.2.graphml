      <data key="d7">3f31c7b09b9d4568a4e65dc5a606d62f</data>
    </node>
    <node id="HH TIPO II">
      <data key="d0">EVENT</data>
      <data key="d1">HH tipo II, or juvenile hemochromatosis, is a form of hereditary hemochromatosis that manifests in younger individuals.</data>
      <data key="d2">1cdec368125a3e3fd5c3c7accc5b89ec</data>
      <data key="d3">1521</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">11667</data>
      <data key="d7">2aadd8b47095423aaa9b834c38216b56</data>
    </node>
    <node id="HH TIPO 2A">
      <data key="d0">EVENT</data>
      <data key="d1">HH tipo 2A is a subtype of juvenile hemochromatosis associated with mutations in the hemojuvelin gene.</data>
      <data key="d2">1cdec368125a3e3fd5c3c7accc5b89ec</data>
      <data key="d3">1521</data>
      <data key="d4">2</data>
