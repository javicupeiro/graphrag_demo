      <data key="d11">8abacba043464385b8b39bdade141b83</data>
      <data key="d12">4872</data>
      <data key="d13">2</data>
    </edge>
    <edge source="NUTRICI&#211;N PARENTERAL" target="ALUMINIO">
      <data key="d8">6.0</data>
      <data key="d9">Aluminum toxicity is a concern in parenteral nutrition, impacting patient outcomes</data>
