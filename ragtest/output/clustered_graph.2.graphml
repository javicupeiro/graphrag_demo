      <data key="d6">4063</data>
      <data key="d7">9cdd9fe66bd34dbeb3700ac958caea64</data>
    </node>
    <node id="TYPE 1 DIABETES">
      <data key="d0">EVENT</data>
      <data key="d1">Type 1 Diabetes is a form of diabetes that typically develops in children and young adults. It is classified as an autoimmune condition, characterized by the destruction of insulin-producing beta cells in the pancreas. This destruction leads to high blood sugar levels, as the body is unable to produce insulin. Consequently, individuals with Type 1 Diabetes require lifelong management through insulin therapy to regulate their blood sugar levels effectively.</data>
      <data key="d2">a4b144210b0a4b654a260ebc394de0af,dda50550d881b4487154c85b2f279034,ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1721</data>
      <data key="d4">2</data>
      <data key="d5">16</data>
      <data key="d6">4064</data>
      <data key="d7">14fa7f47b43b49dda75db9135097aecc</data>
    </node>
    <node id="DR3-DQ2">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">DR3-DQ2 is a haplotype associated with increased susceptibility to Type 1 Diabetes, significantly raising the relative risk of developing the disease.</data>
      <data key="d2">ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1129</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">4065</data>
      <data key="d7">bda9638076dc4a979d59a03bb11c2f1c</data>
    </node>
    <node id="DR4-DQ8">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">DR4-DQ8 is another haplotype that confers a higher risk of developing Type 1 Diabetes, contributing to the genetic predisposition to the disease.</data>
      <data key="d2">ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1129</data>
      <data key="d4">2</data>
      <data key="d5">2</data>
      <data key="d6">4066</data>
      <data key="d7">53a7af271f8949869730efae57f0c8c5</data>
    </node>
    <node id="ATKINSON MA">
      <data key="d0">PERSON</data>
      <data key="d1">Atkinson MA is a researcher recognized for his significant contributions to the understanding of Type 1 Diabetes, particularly in relation to its genetic factors. His work has advanced the knowledge surrounding this autoimmune condition, helping to elucidate the underlying mechanisms that contribute to its development.</data>
      <data key="d2">d0231ac4e41b0e826d80763b5b8c61e0,ed9fbb82a9162d601f8370ef97810e54</data>
      <data key="d3">1720</data>
