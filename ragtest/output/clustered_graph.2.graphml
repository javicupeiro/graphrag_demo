    </node>
    <node id="PESCADO AL HORNO">
      <data key="d0">EVENT</data>
      <data key="d1">El pescado al horno es un tipo de alimento que se introduce en la dieta semiblanda, siendo una fuente de prote&#237;na magra.</data>
      <data key="d2">4d74cee5793710b781c0b83db2f27209</data>
