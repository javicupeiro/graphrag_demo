      <data key="d6">13190</data>
      <data key="d7">3d5f91393ec84e30beb2a944d5297bfb</data>
    </node>
    <node id="REDOXS">
      <data key="d0">EVENT</data>
      <data key="d1">The REDOXS study investigated the effects of glutamine (Gln) supplementation in critically ill patients, comparing enteral and parenteral administration methods.</data>
      <data key="d2">396dda5c9597828f0749f963f42142b4</data>
