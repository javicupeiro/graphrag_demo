    <node id="PESCADO BLANCO">
      <data key="d0">EVENT</data>
      <data key="d1">PESCADO BLANCO refers to white fish, which is permitted in modified diets. It is traditionally recommended due to its lower phosphorus content when compared to blue fish, making it a favorable choice for those needing to manage their phosphorus intake.</data>
      <data key="d2">26e7a15d14f527bbd2b99f7a7bc55d81,347e3d175ef7f30e3dcad731f84fb375</data>
