    <node id="VF">
      <data key="d0">EVENT</data>
      <data key="d1">Videofluoroscopy (VF) is an instrumental study that evaluates swallowing function and identifies risks to the airway in patients with dysphagia.</data>
      <data key="d2">e14475004a93d47a14d98dd4c5b5d02b</data>
      <data key="d3">1172</data>
      <data key="d4">2</data>
