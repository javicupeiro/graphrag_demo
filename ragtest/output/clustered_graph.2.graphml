      <data key="d7">43a7e209284842488a4100168ae46dfc</data>
    </node>
    <node id="GLUCEMIAS">
      <data key="d0" />
      <data key="d1">GLUCEMIAS se refiere a las mediciones de los niveles de az&#250;car en la sangre. Estas mediciones son especialmente importantes en el contexto de pacientes con Alzheimer, ya que se utilizan para ajustar el tratamiento de la enfermedad.</data>
      <data key="d2">76c4ef07f382585bf943bfaf57372c86,7c10030e29c1434df3b10b1533710486,b00c312f46e790b32fe99743480f9e47</data>
