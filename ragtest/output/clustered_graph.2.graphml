      <data key="d11">595a0b142e72469fac190e9ae21b89b4</data>
      <data key="d12">3041</data>
      <data key="d13">2</data>
    </edge>
    <edge source="PACIENTE" target="GU&#205;AS CL&#205;NICAS">
      <data key="d8">6.0</data>
      <data key="d9">Clinical guidelines inform patients about necessary dietary modifications for dysphagia</data>
