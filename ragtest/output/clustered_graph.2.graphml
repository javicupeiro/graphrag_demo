      <data key="d11">9a08509c55ec445ba0069361deed7d62</data>
      <data key="d12">14113</data>
      <data key="d13">2</data>
    </edge>
    <edge source="INSTITUTE OF MEDICINE" target="DRI">
      <data key="d8">8.0</data>
