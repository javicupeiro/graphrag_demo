      <data key="d10">15ac197b57d904b3bf72905c4d946c0d</data>
      <data key="d11">b40196a86b6544e49c9f82a37d510d4e</data>
      <data key="d12">17404</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MEMBREZ" target="H. PYLORI">
