    </node>
    <node id="BOMBAS DE INFUSI&#211;N">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Infusion pumps are devices used to deliver parenteral nutrition solutions continuously or cyclically to patients.</data>
      <data key="d2">222519e556047fafecd61c2964aaaeed</data>
      <data key="d3">630</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15584</data>
      <data key="d7">5388d9433933480f96a4f71b9931e01d</data>
    </node>
    <node id="PVC">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">PVC (polivinyl chloride) is a material used in infusion systems for parenteral nutrition, which should not contain harmful additives like DEHP.</data>
      <data key="d2">222519e556047fafecd61c2964aaaeed</data>
      <data key="d3">588</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15585</data>
      <data key="d7">e6290cbba58549ad9fd215b1172db29e</data>
    </node>
    <node id="DEHP">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">DEHP (di(2-etilhexil) ftalato) is a plasticizer that should be avoided in materials used for parenteral nutrition due to health concerns.</data>
      <data key="d2">222519e556047fafecd61c2964aaaeed</data>
      <data key="d3">588</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">15586</data>
