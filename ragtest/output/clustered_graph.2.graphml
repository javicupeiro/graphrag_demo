      <data key="d10">8d1eb00b23450a2f2cb1243ea32aa36f</data>
      <data key="d11">3586944cdec7427da9e81519b99f7c98</data>
      <data key="d12">1638</data>
      <data key="d13">2</data>
    </edge>
    <edge source="DIABETES MELLITUS" target="NUTRITIONAL SOCIETIES">
      <data key="d8">7.0</data>
