      <data key="d11">50b360ff15b247dfb730cd096c8d74b8</data>
      <data key="d12">8202</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VITAMINAS" target="DIETA CETOG&#201;NICA">
      <data key="d8">5.0</data>
      <data key="d9">Las vitaminas son nutrientes que pueden ser deficientes en la dieta cetog&#233;nica, lo que hace necesaria su suplementaci&#243;n.</data>
      <data key="d10">1592143354d1ef792f8618ec03a32a16</data>
