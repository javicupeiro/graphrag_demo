    <node id="NUTRITION AND DEMENTIA">
      <data key="d0">EVENT</data>
      <data key="d1">Nutrition and dementia is a research area that examines the relationship between dietary factors and cognitive decline.</data>
      <data key="d2">65143afbc494705be9ccc4e48bee296b</data>
      <data key="d3">1626</data>
      <data key="d4">2</data>
      <data key="d5">3</data>
