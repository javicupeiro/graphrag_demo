    </node>
    <node id="TABLE 3B">
      <data key="d0">EVENT</data>
      <data key="d1">Table 3B provides additional information on the vitamin and mineral requirements for premature infants.</data>
      <data key="d2">919ff63f7f48a238e717f60361d8dbd1</data>
