      <data key="d12">5905</data>
      <data key="d13">2</data>
    </edge>
    <edge source="OBESIDAD" target="BACTERIAS INTESTINALES">
      <data key="d8">5.0</data>
      <data key="d9">Obesidad can be influenced by the composition and balance of gut bacteria.</data>
      <data key="d10">0d9c11c44c3cf4e1e3148949cc0a4096</data>
      <data key="d11">6b64a46816a14a949f4628ff02c1fe51</data>
      <data key="d12">5906</data>
      <data key="d13">2</data>
    </edge>
