      <data key="d5">2</data>
      <data key="d6">9252</data>
      <data key="d7">5199d07632f641479e6971a6430b0be6</data>
    </node>
    <node id="PAUTAS DE INSULINIZACI&#211;N">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Pautas de Insulinizaci&#243;n are the guidelines for insulin administration that individuals with diabetes must follow to manage their condition effectively.</data>
      <data key="d2">abf638322cfb1c522bfbee1852e28a19</data>
      <data key="d3">1080</data>
