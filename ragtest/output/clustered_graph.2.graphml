      <data key="d8">5.0</data>
      <data key="d9">Alimentary reflux is a complication that affects patients with fibrosis qu&#237;stica, indicating a direct relationship</data>
      <data key="d10">d22c91140c11f7344e9aeebb21454cee</data>
      <data key="d11">c7661036d1b349a8ae389d2e94627b0e</data>
      <data key="d12">7091</data>
      <data key="d13">2</data>
    </edge>
    <edge source="FIBROSIS QU&#205;STICA" target="COLOPAT&#205;A FIBROSANTE">
      <data key="d8">5.0</data>
      <data key="d9">Colopat&#237;a fibrosante is a gastrointestinal complication that can occur in patients with fibrosis qu&#237;stica, establishing a relationship</data>
      <data key="d10">d22c91140c11f7344e9aeebb21454cee</data>
      <data key="d11">e5fd2af66adf4daeb606b9467137767a</data>
      <data key="d12">7092</data>
      <data key="d13">2</data>
    </edge>
