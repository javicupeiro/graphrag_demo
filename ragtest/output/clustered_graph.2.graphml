    <node id="SOLUCI&#211;N SALINA HIPERT&#211;NICA">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Soluci&#243;n Salina Hipert&#243;nica is a medical treatment used to correct severe hyponatremia by providing a high concentration of sodium to help reduce cerebral edema.</data>
      <data key="d2">05a2506becec805cd1374d73de9a9fec</data>
