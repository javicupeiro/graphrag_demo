      <data key="d5">2</data>
      <data key="d6">7141</data>
      <data key="d7">342fc0ae891847c48af18fda81fdf86a</data>
    </node>
    <node id="EVALUACI&#211;N AMBULATORIA">
      <data key="d0">EVENT</data>
      <data key="d1">Ambulatory evaluation refers to the patient's last outpatient assessment, which took place in November 2015.</data>
