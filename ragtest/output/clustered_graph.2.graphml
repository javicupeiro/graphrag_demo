      <data key="d5">12</data>
      <data key="d6">505</data>
      <data key="d7">e2b49facf44346f4b674405bdd0e6eaa</data>
    </node>
    <node id="S&#205;NTOMA">
      <data key="d0">EVENT</data>
      <data key="d1">S&#237;ntoma refers to the specific signs or manifestations that patients experience, which can be linked to esophageal conditions.</data>
      <data key="d2">f7c941bced546a7d607c30a9a5e9d887</data>
      <data key="d5">1</data>
      <data key="d6">506</data>
