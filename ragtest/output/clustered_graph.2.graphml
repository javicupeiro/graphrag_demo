    <node id="S&#205;NDROMES DE MALA ABSORCI&#211;N">
      <data key="d0">PERSON</data>
      <data key="d1">S&#237;ndromes de mala absorci&#243;n are conditions that prevent the body from properly absorbing nutrients from food, leading to malnutrition.</data>
      <data key="d2">b7fb13d01f792b754e667a3a5bcdba93</data>
