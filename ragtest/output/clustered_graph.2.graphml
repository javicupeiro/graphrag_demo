      <data key="d7">cf04518ae45f4838aa0c1d9107db944e</data>
    </node>
    <node id="BURNS">
      <data key="d0">EVENT</data>
      <data key="d1">Burns refer to injuries caused by heat, chemicals, electricity, or radiation, leading to damage to the skin and other tissues, often requiring specialized nutritional management for recovery.</data>
      <data key="d2">7f3e164582a504c9fe6bdbc56e1a8e97</data>
      <data key="d5">0</data>
      <data key="d6">13212</data>
