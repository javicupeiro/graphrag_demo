      <data key="d11">11741207dda5421ba81ed88e9bd58d0e</data>
      <data key="d12">3896</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MALNUTRITION UNIVERSAL SCREENING TOOL" target="FIGUEREDO GRIJALBA R">
      <data key="d8">1.0</data>
      <data key="d9">Figueredo Grijalba R contributed to the guidelines that support the use of the MUST</data>
