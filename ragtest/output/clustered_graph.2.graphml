      <data key="d10">803363886f385b089938bf122246dfa2</data>
      <data key="d11">5b680a294a6b42cca20132e3499ba1a9</data>
      <data key="d12">17876</data>
      <data key="d13">2</data>
    </edge>
    <edge source="HAPLOTYPES" target="SNP">
      <data key="d8">1.0</data>
      <data key="d9">Haplotypes are associated with specific SNPs that regulate lactase expression in different populations.</data>
      <data key="d10">19e349f627670b1a9ccfa5d10f86bbea</data>
      <data key="d11">7c8ca6825fa44bf4880d6b8f4f2c37cb</data>
