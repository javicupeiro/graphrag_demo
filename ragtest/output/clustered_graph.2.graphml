      <data key="d12">13428</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EDIC" target="CARDIOVASCULAR OUTCOMES">
      <data key="d8">1.0</data>
      <data key="d9">The EDIC study tracks cardiovascular outcomes in patients with diabetes over a long-term follow-up</data>
      <data key="d10">dfe972dc8a4eabfc8948770fe113c833</data>
