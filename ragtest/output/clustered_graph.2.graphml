    <node id="LIPODISTROFIA GENERALIZADA CONGENITA">
      <data key="d0">EVENT</data>
      <data key="d1">Lipodystrophy is a genetic disorder characterized by the absence of adipose tissue and is associated with insulin resistance and diabetes.</data>
      <data key="d2">ac89fcaa7dcce835c0d5b9ed9ce94cea</data>
