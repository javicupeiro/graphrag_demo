    <node id="SYNDROME DE REALIMENTACION">
      <data key="d0">EVENT</data>
      <data key="d1">The syndrome of realimentation occurs in severely malnourished patients undergoing intensive nutritional replenishment, leading to various metabolic complications.</data>
