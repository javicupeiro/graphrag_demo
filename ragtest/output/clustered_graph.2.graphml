      <data key="d8">8.0</data>
      <data key="d9">SDRA patients benefit from early enteral nutrition to improve outcomes</data>
      <data key="d10">7e539a13a598e4ff2d2d4d6641a044d5</data>
      <data key="d11">38abd3b0bc4742e1bc75a2ed45f2f3e3</data>
      <data key="d12">2763</data>
      <data key="d13">2</data>
    </edge>
