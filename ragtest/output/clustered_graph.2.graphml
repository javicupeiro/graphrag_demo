      <data key="d6">3931</data>
      <data key="d7">61db430407ea410f859e49a73ef70275</data>
    </node>
    <node id="VIDAL CASARIEGO A">
      <data key="d0">PERSON</data>
      <data key="d1">Vidal Casariego A is a notable contributor to the book titled 'Dietoterapia, nutrici&#243;n cl&#237;nica y metabolismo', where he focuses on the dietary treatment of obesity. Additionally, he is the author of a manual that addresses topics related to endocrinology and nutrition, further highlighting his expertise in the fields of dietetics and clinical nutrition.</data>
      <data key="d2">1e60716fb6d7eb11fdf78dc47bd9a5d9,b11e575be155e186717a992a9d641577</data>
      <data key="d3">1457</data>
