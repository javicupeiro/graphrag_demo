      <data key="d9">The DASH diet is specifically designed to help manage and reduce hypertension through dietary changes</data>
      <data key="d10">e40d5e26456fbd223dc887d7d6d0eeb7</data>
      <data key="d11">68b4b08f88f2452984d7ea99fe49959c</data>
      <data key="d12">10971</data>
      <data key="d13">2</data>
    </edge>
