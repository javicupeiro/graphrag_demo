    <node id="GASTROSTOM&#205;A RADIOLOGICA PERCUT&#193;NEA">
      <data key="d0">EVENT</data>
      <data key="d1">Gastrostom&#237;a radiol&#243;gica percut&#225;nea es un procedimiento m&#233;dico que permite la alimentaci&#243;n a trav&#233;s de un tubo insertado en el est&#243;mago, utilizado en pacientes con dificultades para tragar.</data>
      <data key="d2">e474ebdcd3e5392e4b2bed8434293849</data>
