    </edge>
    <edge source="P&#201;RDIDA DE PESO" target="EPOC">
      <data key="d8">8.0</data>
      <data key="d9">Weight loss is a significant concern in EPOC patients, often linked to malnutrition and increased metabolic demands</data>
      <data key="d10">ddd48beea3c882bf1a651cb25283ba91</data>
      <data key="d11">ccafbdcc0f9b41e69735c9a3414e55fd</data>
