      <data key="d8">7.0</data>
      <data key="d9">Home enteral nutrition is often required for patients suffering from neurological diseases due to their inability to consume food normally.</data>
      <data key="d10">651bf69cdd5aec52b456cbea567f1987</data>
      <data key="d11">d7839830d6c94e608be0ce441e63e91c</data>
      <data key="d12">879</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUIMIOTERAPIA" target="P&#201;RDIDA DE PESO">
      <data key="d8">1.0</data>
      <data key="d9">Quimioterapia can cause side effects such as nausea and loss of appetite, contributing to p&#233;rdida de peso.</data>
      <data key="d10">b26b998479da515c234ce46b1bfa73db</data>
      <data key="d11">0fae7077d2df4d45b51bfcf2fdf965ec</data>
      <data key="d12">880</data>
      <data key="d13">2</data>
    </edge>
    <edge source="QUIMIOTERAPIA" target="TPH">
      <data key="d8">8.0</data>
