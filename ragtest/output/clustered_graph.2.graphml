    </node>
    <node id="TRAUMATISMO PENETRANTE">
      <data key="d0">EVENT</data>
      <data key="d1">El traumatismo penetrante es una lesi&#243;n grave que puede requerir soporte nutricional en pacientes con un &#237;ndice de gravedad elevado.</data>
      <data key="d2">44346a4b1b9a6d3ae2bc161314ff9efd</data>
      <data key="d3">748</data>
