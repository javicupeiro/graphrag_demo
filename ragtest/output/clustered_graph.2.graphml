    <node id="DIEGO &#193;LVAREZ BALLANO">
      <data key="d0">PERSON</data>
      <data key="d1">Diego &#193;lvarez Ballano is an attending physician in Endocrinology and Nutrition at Hospital Universitario Miguel Servet in Zaragoza, specializing in diet therapy and clinical nutrition.</data>
      <data key="d2">4e8b65ec9939ccf2152e68fa7f8b12c4</data>
