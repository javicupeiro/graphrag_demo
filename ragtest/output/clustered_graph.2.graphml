    </node>
    <node id="PROTOCOLO ERAS">
      <data key="d0">EVENT</data>
      <data key="d1">Enhanced Recovery After Surgery protocol aimed at improving recovery outcomes for surgical patients, particularly in oncology.</data>
      <data key="d2">202e4fa915a698c9d9164c3fcc61534e</data>
      <data key="d3">685</data>
      <data key="d4">2</data>
