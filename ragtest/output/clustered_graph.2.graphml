    </node>
    <node id="ISQUEMIA MICROVASCULAR">
      <data key="d0">EVENT</data>
      <data key="d1">Isquemia microvascular refers to a condition where small blood vessels are obstructed, often leading to complications in patients with diabetes.</data>
      <data key="d2">aa9279dacd764b478618ae36af93ad83</data>
      <data key="d3">400</data>
      <data key="d4">1</data>
