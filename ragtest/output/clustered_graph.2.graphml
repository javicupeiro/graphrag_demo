      <data key="d10">1c3eeb30a49c70f750b79e7bc1dfef52</data>
      <data key="d11">62e9ddaf43364ef2a8cd2a0ea47fcef5</data>
      <data key="d12">10106</data>
      <data key="d13">2</data>
    </edge>
    <edge source="CVC" target="FIBRINA">
      <data key="d8">7.0</data>
      <data key="d9">Fibrin can accumulate in the CVC, leading to partial obstruction known as fibrin sheath</data>
      <data key="d10">1c3eeb30a49c70f750b79e7bc1dfef52</data>
