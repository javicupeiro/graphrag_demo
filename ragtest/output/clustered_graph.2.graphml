    <edge source="MANUAL DE DISFAGIA OROFAR&#205;NGEA" target="LECHE">
      <data key="d8">8.0</data>
      <data key="d9">Milk is discussed in the manual as a key component for enriching protein intake in diets for dysphagia patients</data>
      <data key="d10">398be32cb0a16895225a8b29c9d118df</data>
      <data key="d11">1a9890946f594d87a9f7ffcd844a1c96</data>
      <data key="d12">1140</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANUAL DE DISFAGIA OROFAR&#205;NGEA" target="CARNES">
      <data key="d8">8.0</data>
      <data key="d9">Meats are included in the manual as essential for providing protein in the diets of dysphagia patients</data>
      <data key="d10">398be32cb0a16895225a8b29c9d118df</data>
      <data key="d11">423782617fc444b695e39f33671cb7ab</data>
      <data key="d12">1141</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANUAL DE DISFAGIA OROFAR&#205;NGEA" target="PESCADOS">
      <data key="d8">8.0</data>
      <data key="d9">Fish is mentioned in the manual as a recommended protein source for dysphagia diets</data>
      <data key="d10">398be32cb0a16895225a8b29c9d118df</data>
      <data key="d11">653d22d1d8744d1b8520d6b415c098fc</data>
      <data key="d12">1142</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANUAL DE DISFAGIA OROFAR&#205;NGEA" target="HUEVOS">
      <data key="d8">8.0</data>
      <data key="d9">Eggs are highlighted in the manual for their protein content and versatility in dysphagia diets</data>
      <data key="d10">398be32cb0a16895225a8b29c9d118df</data>
      <data key="d11">84a885adfd034cc9b257a5d2a64de429</data>
      <data key="d12">1143</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANUAL DE DISFAGIA OROFAR&#205;NGEA" target="LEGUMBRES">
      <data key="d8">8.0</data>
      <data key="d9">Legumes are recommended in the manual for their nutritional value and are suggested to be consumed in pur&#233; form</data>
      <data key="d10">398be32cb0a16895225a8b29c9d118df</data>
      <data key="d11">7e9f1a704dec489e8988361aba2eb128</data>
      <data key="d12">1144</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANUAL DE DISFAGIA OROFAR&#205;NGEA" target="FRUTOS SECOS">
      <data key="d8">8.0</data>
      <data key="d9">Nuts are discussed in the manual as a way to enrich pur&#233;s and creams for dysphagia patients</data>
      <data key="d10">398be32cb0a16895225a8b29c9d118df</data>
      <data key="d11">5125c7cf385e4d5890a9e13ce96226f1</data>
      <data key="d12">1145</data>
      <data key="d13">2</data>
    </edge>
    <edge source="MANUAL DE DISFAGIA OROFAR&#205;NGEA" target="GRASAS">
      <data key="d8">8.0</data>
      <data key="d9">Fats are mentioned in the manual with recommendations for moderation in dysphagia diets</data>
