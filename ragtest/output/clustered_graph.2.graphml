    </edge>
    <edge source="EPOC" target="FERREIRA">
      <data key="d8">8.0</data>
      <data key="d9">Ferreira conducted a meta-analysis that concluded nutritional supplementation benefits patients with EPOC</data>
      <data key="d10">c2b3f93bb7fcffe1bc023ab4148e600c</data>
      <data key="d11">12cc2980db5c48c78ec8d92432e2bd9c</data>
      <data key="d12">19340</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EPOC" target="SUPLEMENTO HIPERPROTEICO">
      <data key="d8">8.0</data>
      <data key="d9">Hiperproteico supplements have been shown to improve outcomes in patients with EPOC</data>
      <data key="d10">c2b3f93bb7fcffe1bc023ab4148e600c</data>
      <data key="d11">62e750adb19f4603a5fc73b282e7d78f</data>
      <data key="d12">19341</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EPOC" target="IVACAFTOR">
      <data key="d8">4.0</data>
      <data key="d9">While primarily used for cystic fibrosis, ivacaftor's effects on lung function may have implications for patients with chronic obstructive pulmonary disease.</data>
      <data key="d10">f1f6ad756644e84b6caa8e4e3adb94da</data>
      <data key="d11">b27c207ca6d94261806376c079d65262</data>
      <data key="d12">19342</data>
      <data key="d13">2</data>
    </edge>
    <edge source="EPOC" target="MIRAVITLLES M">
      <data key="d8">1.0</data>
      <data key="d9">Miravitlles M has contributed to guidelines and research on the treatment of EPOC, impacting patient care.</data>
      <data key="d10">fea8c7e37cd76ac988e0b242cb84fe6f</data>
      <data key="d11">a84e0f8d64f845c3b0ea0dbda33b21d8</data>
