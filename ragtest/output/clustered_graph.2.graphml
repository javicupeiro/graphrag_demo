    </node>
    <node id="NEUROP&#201;PTIDO-Y">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Neuropeptide Y is a peptide that is involved in regulating energy balance, appetite, and stress response.</data>
      <data key="d2">419657aaa9492bbff3d218e00d2b0fd4</data>
      <data key="d3">997</data>
      <data key="d4">2</data>
