    <edge source="NUTRITION AND DEMENTIA" target="NUTRITIONAL INTERVENTION">
      <data key="d8">6.0</data>
      <data key="d9">Nutritional intervention strategies are implemented to address issues related to nutrition and dementia</data>
      <data key="d10">65143afbc494705be9ccc4e48bee296b</data>
      <data key="d11">b86b90ffc6f74cda90b196db357d638e</data>
      <data key="d12">11378</data>
