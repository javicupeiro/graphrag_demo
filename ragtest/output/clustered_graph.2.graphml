      <data key="d10">1ff94f3fcc6eff16c2fdae5eb9b3aefa</data>
      <data key="d11">3fe4911550e146088ccde9b4fedcef07</data>
      <data key="d12">14404</data>
      <data key="d13">2</data>
    </edge>
    <edge source="METOTREXATO" target="TAMOXIFENO">
      <data key="d8">5.0</data>
