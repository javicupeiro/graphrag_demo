      <data key="d10">f41688eecb31d8e55fc70e993e99c3e9</data>
      <data key="d11">4a7f842eaacc4c67ba3da983eb927a42</data>
      <data key="d12">16390</data>
      <data key="d13">2</data>
    </edge>
    <edge source="VERDURAS" target="DASH">
      <data key="d8">8.0</data>
      <data key="d9">The DASH diet emphasizes the consumption of vegetables to provide essential nutrients and help reduce blood pressure</data>
      <data key="d10">b5db5210dfb726bf3f6d3fae82598596</data>
