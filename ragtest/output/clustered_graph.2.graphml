    </node>
    <node id="CISPLATIN">
      <data key="d0">EVENT</data>
      <data key="d1">Cisplatin is a chemotherapy drug that can lead to various side effects, including hypomagnesemia and renal toxicity.</data>
      <data key="d2">b9342cecd69cdc0e9936df041657f5f5</data>
      <data key="d3">711</data>
