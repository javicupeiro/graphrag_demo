    </node>
    <node id="KAHALY GJ">
      <data key="d0">PERSON</data>
      <data key="d1">Kahaly GJ es un investigador que ha realizado estudios sobre el tratamiento de la oftalmopat&#237;a de Graves.</data>
      <data key="d2">4c18507e3d98242cdbcddd1a1997b92f</data>
