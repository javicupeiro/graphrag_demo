      <data key="d6">318</data>
      <data key="d7">c9a48080a9a041889809016ad7c34f93</data>
    </node>
    <node id="BARNES-JEWISH HOSPITAL">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Barnes-Jewish Hospital is a medical facility located in St. Louis, Missouri, known for its stroke care and speech pathology services.</data>
      <data key="d2">6716f78f148d9f4f2a622919eee02554</data>
      <data key="d5">2</data>
      <data key="d6">319</data>
      <data key="d7">555fc90c6e64408c82acc56024a7119d</data>
    </node>
    <node id="STROKE">
      <data key="d0">EVENT</data>
      <data key="d1">Stroke is a medical condition characterized by the interruption of blood supply to the brain, which can result in long-term disabilities. It is often included as a background condition in frailty assessments. Dietary factors, such as potassium intake and the consumption of fruits and vegetables, can influence the risk of stroke. Additionally, specialized assessments, such as the BJH Stroke Dysphagia Screen, are utilized to evaluate individuals who have experienced a stroke.</data>
      <data key="d2">1566fcfef74295869c46405aaca05b32,6716f78f148d9f4f2a622919eee02554,d99a6175f2d81fae9bf733be64a65dd4</data>
      <data key="d3">542</data>
      <data key="d4">1</data>
      <data key="d5">2</data>
      <data key="d6">320</data>
      <data key="d7">e840a178c1a641de8c75be80f888181c</data>
    </node>
    <node id="BJH STROKE DYSPHAGIA SCREEN">
      <data key="d0">EVENT</data>
      <data key="d1">The BJH Stroke Dysphagia Screen is a method developed by Barnes-Jewish Hospital for early detection of dysphagia in stroke patients.</data>
      <data key="d2">6716f78f148d9f4f2a622919eee02554</data>
      <data key="d3">542</data>
      <data key="d4">1</data>
      <data key="d5">3</data>
      <data key="d6">321</data>
      <data key="d7">e9f244d95e8a4f9f83b3eb4336af95ea</data>
    </node>
    <node id="SPEECH PATHOLOGY SERVICES">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Speech Pathology Services at Barnes-Jewish Hospital provide assessments and interventions for patients with swallowing disorders.</data>
      <data key="d2">6716f78f148d9f4f2a622919eee02554</data>
      <data key="d5">1</data>
      <data key="d6">322</data>
      <data key="d7">735e04a2be4440b29169886f252ae079</data>
    </node>
    <node id="GLASGOW COMA SCALE">
      <data key="d0">EVENT</data>
      <data key="d1">The Glasgow Coma Scale is a neurological scale used to assess a patient's level of consciousness, particularly in stroke patients.</data>
      <data key="d2">6716f78f148d9f4f2a622919eee02554</data>
