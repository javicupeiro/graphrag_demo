    </node>
    <node id="FOOD SAFETY">
      <data key="d0">EVENT</data>
      <data key="d1">Food safety refers to the practices and guidelines that ensure food is safe to eat, particularly important for immunocompromised patients.</data>
      <data key="d2">2194de4eaed685b07d8f4c7a397de0ce</data>
      <data key="d3">1116</data>
      <data key="d4">2</data>
      <data key="d5">1</data>
      <data key="d6">13794</data>
      <data key="d7">e8dea997e22248f8a38c4b369d0d0529</data>
    </node>
    <node id="HEMATOLOGICAL CELL TRANSPLANT">
      <data key="d0">EVENT</data>
      <data key="d1">Hematological cell transplant is a medical procedure used to treat certain types of cancer and blood disorders, requiring specific dietary precautions.</data>
      <data key="d2">2194de4eaed685b07d8f4c7a397de0ce</data>
      <data key="d3">1266</data>
      <data key="d4">2</data>
