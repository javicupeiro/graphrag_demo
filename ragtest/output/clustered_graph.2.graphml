    </node>
    <node id="COLLESTEROL DESMOLASE">
      <data key="d0">ORGANIZATION</data>
      <data key="d1">Cholesterol desmolase is an enzyme that catalyzes the first step of steroidogenesis, converting cholesterol into pregnenolone, and is stimulated by ACTH.</data>
      <data key="d2">85eef7ed9c9b92d86939a6687ea2acfd</data>
      <data key="d3">1327</data>
