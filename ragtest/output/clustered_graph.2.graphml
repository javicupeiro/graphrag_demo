    </node>
    <node id="REV002">
      <data key="d0">EVENT</data>
      <data key="d1">REV002 is a protocol for the diagnosis and nutritional follow-up of dysphagia, established in June 2013.</data>
      <data key="d2">42cc35e2edb450d48bb31f7c51b7a02f</data>
      <data key="d3">953</data>
