    </node>
    <node id="OMEGAD STUDY">
      <data key="d0">EVENT</data>
      <data key="d1">The OmegAD study investigates the effects of docosahexaenoic acid-rich n-3 fatty acid supplementation on cytokine release and cognitive health.</data>
      <data key="d2">91b470ee527a45d8e81a821eeb9ce259</data>
