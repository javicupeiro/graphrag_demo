      <data key="d7">81a28a91009442a0aef59a15f26e7b18</data>
    </node>
    <node id="SARCOPEMIA">
      <data key="d0">EVENT</data>
      <data key="d1">Sarcopenia is a condition characterized by the loss of muscle mass and strength, often associated with aging and frailty. This syndrome, first proposed by Irwin Rosenberg in 1989, is influenced by various factors, including hormonal changes and inflammation.</data>
      <data key="d2">76d78b3e33659e952b0d2835f5bdf595,b7465350e74a3bada96615deb0d7b031,caab2e12a2bce3c947d663cf8b71cb67</data>
